export type ReferenceColumn = opaque
export type ReferenceRows = opaque
export type ReferenceRow = opaque
export type IndirectTextColumn = opaque
export type ReadColumn = opaque
export type ListColumn = opaque
export type ColumnSet = opaque
export type ColumnGrowth = opaque
export type ColumnAllocator = opaque

export type ColumnRecord = u8[]

export type ColumnCell = {
    slot: u64,
    offset: u64,
    width: u64
}

export type ColumnRowLayout = ColumnCell[]

export enum ColumnOwnership {
    Copy,
    Borrowed,
    Owned
}

export enum ColumnStoreMode {
    transaction,
    orchestration
}

export type ColumnNames = string?[]
export type ColumnErrors = string[]?

export type LinkedSignatureColumns = {
    input_types: u32[],
    output_types: u32[],
    ownership: ColumnOwnership[],
    native_inputs: ColumnNames?[],
    native_modules: u32?[],
    native_members: string[][],
    native_exports: string?[],
    native_allocators: bool[],
    native_io: bool[],
    native_process: bool[],
    native_tuples: bool[],
    native_fallible: bool[]
}

export type FunctionRow = {
    files: string,
    input_types: u32,
    output_types: u32,
    ownership: ColumnOwnership,
    store_modes: ColumnStoreMode,
    contracts: Contracts,
    native_inputs?: ColumnNames,
    native_modules?: u32,
    native_members: string[],
    native_exports?: string,
    native_allocators: bool,
    native_io: bool,
    native_process: bool,
    native_tuples: bool,
    native_fallible: bool,
    native_errors: ColumnErrors,
    native_concurrent: bool,
    symbols: Symbols,
    expressions: Expressions,
    control: Control,
    roots?: u32,
    stores: Stores
}

export type SignatureRow = {
    files: string,
    input_types: u32,
    output_types: u32,
    ownership: ColumnOwnership,
    native_inputs?: ColumnNames,
    native_modules?: u32,
    native_members: string[],
    native_exports?: string,
    native_allocators: bool,
    native_io: bool,
    native_process: bool,
    native_tuples: bool,
    native_fallible: bool,
    native_errors: ColumnErrors,
    native_concurrent: bool,
}

export type ForwardedBody = {
    symbols: Symbols,
    expressions: Expressions,
    control: Control,
    root: u32,
    contracts: Contracts
}

export type FunctionBodyRow = {
    files: string,
    input_types: u32,
    output_types: u32,
    ownership: ColumnOwnership,
    store_modes: ColumnStoreMode,
    contracts: Contracts,
    symbols: Symbols,
    expressions: Expressions,
    control: Control,
    roots?: u32,
    stores: Stores
}

export type FunctionNativeRow = {
    native_inputs?: ColumnNames,
    native_modules?: u32,
    native_members: string[],
    native_exports?: string,
    native_allocators: bool,
    native_io: bool,
    native_process: bool,
    native_tuples: bool,
    native_fallible: bool,
    native_errors: ColumnErrors,
    native_concurrent: bool
}

export type NativeModuleRow = {
    identities?: string,
    import_names: string,
    specifiers: string,
    type_ids: u32[],
    type_names: string[],
    type_namespaces: string[]
}

export type TypeColumns = {
    kinds: u8[],
    first: u32[],
    second: u32[],
    labels: string[],
    children: u32[],
    field_types: u32[],
    field_names: string[],
    names: string[]
}

export enum StoreMode {
    transaction,
    orchestration
}

export type Complete = {
    files: string[]
    input_types: u32[]
    output_types: u32[]
    ownership: Ownership[]
    store_modes: StoreMode[]
    contracts: Contracts[]
    native_inputs: ColumnNames?[]
    native_modules: u32?[]
    native_members: string[][]
    native_exports: string?[]
    native_allocators: bool[]
    native_io: bool[]
    native_process: bool[]
    native_tuples: bool[]
    native_fallible: bool[]
    native_errors: ColumnErrors[]
    native_concurrent: bool[]
    symbols: Symbols[]
    expressions: Expressions[]
    control: Control[]
    roots: u32?[]
    stores: Stores[]
}
