export declare function writeColumnU8(
    target: WriteColumn,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function writeColumnU32(
    target: WriteColumn,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeColumnU64(
    target: WriteColumn,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function writeColumnIndex(
    target: WriteColumn,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function writeColumnBool(
    target: WriteColumn,
    index: u64,
    value: bool
): void throws { IndexOutOfBounds }

export declare function writeColumnBytes(
    target: WriteColumn,
    index: u64,
    value: u8[]
): void throws { IndexOutOfBounds }

export declare function writeColumnU32List(
    target: WriteColumn,
    index: u64,
    value: u32[]
): void throws { IndexOutOfBounds }

export declare function writeColumnU64List(
    target: WriteColumn,
    index: u64,
    value: u64[]
): void throws { IndexOutOfBounds }

export declare function writeColumnU32Lists(
    target: WriteColumn,
    index: u64,
    value: u32[][]
): void throws { IndexOutOfBounds }

export declare function writeNamedRowList(
    column: WriteColumn,
    index: u64,
    source: NamedRowBuffer
): void throws { IndexOutOfBounds }

export declare function copyColumnValue(
    target: WriteColumn,
    index: u64,
    value: u8[]
): void throws { IndexOutOfBounds }

export declare function copyColumnGroup(
    allocator: Allocator,
    groups: ColumnTransfers,
    group: u64,
    first: u64,
    count: u64
): bool

export declare function reserveColumnGroup(
    allocator: Allocator,
    groups: ColumnTransfers,
    group: u64,
    count: u64
): u64 throws { OutOfMemory }

export declare function columnGroupMatchesLength(
    groups: ColumnTransfers,
    group: u64,
    count: u64
): bool

export declare function columnGroupMinimumLength(
    groups: ColumnTransfers,
    group: u64
): u64

export declare function discardColumnGroup(
    allocator: Allocator,
    groups: ColumnTransfers,
    group: u64,
    count: u64
): void

export declare function publishColumnGroup(
    groups: ColumnTransfers,
    group: u64,
    count: u64
): void
