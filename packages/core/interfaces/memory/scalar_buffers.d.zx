export declare function readU32(
    target: U32Buffer,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU32View(
    target: U32View,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU64(
    target: U64Buffer,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readU64View(
    target: U64View,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function u64ViewSlice(source: U64View): u64[]

export declare function writeU32(
    target: U32Buffer,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function allocateFilledU32Buffer(
    resource: Allocator,
    target: U32Buffer,
    count: u64,
    value: u32
): void throws { OutOfMemory }

export declare function allocateU64Buffer(
    resource: Allocator,
    target: U64Buffer,
    count: u64
): void throws { OutOfMemory }

export declare function writeU64(
    target: U64Buffer,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function clearU64Buffer(target: U64Buffer): void

export declare function swapU64Buffers(left: U64Buffer, right: U64Buffer): void

export declare function releaseU64Buffer(resource: Allocator, target: U64Buffer): void

export declare function bindU32Range(
    source: U32Buffer,
    target: U32Buffer,
    first: u64,
    count: u64
): void throws { IndexOutOfBounds }

export declare function readU8(
    target: U8Buffer,
    index: u64
): u8 throws { IndexOutOfBounds }
