export declare function readU32(
    target: U32Buffer,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU32View(
    target: U32View,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU64(
    target: U64Buffer,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readU64View(
    target: U64View,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function u64ViewSlice(source: U64View): u64[]

export declare function writeU32(
    target: U32Buffer,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeU64(
    target: U64Buffer,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function readU8(
    target: U8Buffer,
    index: u64
): u8 throws { IndexOutOfBounds }
