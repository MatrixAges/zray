export declare function requireColumnBounds(valid: bool): void throws { IndexOutOfBounds }

export declare function selectListValue(
    allocator,
    scratch: ColumnAllocator?,
    source: ListColumn,
    row: u64
): ReadColumn throws { IndexOutOfBounds, OutOfMemory }

export declare function columnLength(source: ReadColumn): u64

export declare function readColumnU32(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readScalarKind(
    source: ReadColumn,
    index: u64
): u8 throws { IndexOutOfBounds }

export declare function readScalarMagnitude(
    source: ReadColumn,
    index: u64
): u64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarFloat(
    source: ReadColumn,
    index: u64
): f64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarBoolean(
    source: ReadColumn,
    index: u64
): bool throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarEnumeration(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarText(
    source: ReadColumn,
    index: u64
): string? throws { IndexOutOfBounds }

export declare function readListOptionalU8(
    source: ListColumn,
    index: u64,
    member: u64
): u8? throws { IndexOutOfBounds }
