export declare function allocateRows(
    allocator,
    target: RowBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function growRows(
    allocator,
    target: RowGrowth,
    used: u64
): u64 throws { OutOfMemory }

export declare function allocateRowsWithAllocator(
    resource: ColumnAllocator,
    target: RowBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function allocateRowList(
    allocator,
    column: WriteColumn,
    index: u64,
    target: RowBuffer,
    count: u64
): void throws { OutOfMemory, IndexOutOfBounds }

export declare function writeRowList(
    column: WriteColumn,
    index: u64,
    source: RowBuffer
): void throws { IndexOutOfBounds }

export declare function copyRow(
    target: RowBuffer,
    source: u64,
    destination: u64
): void throws { IndexOutOfBounds }

export declare function copyRowPrefix(
    target: RowBuffer,
    source: u8[],
    count: u64
): void throws { IndexOutOfBounds }

export declare function projectListColumns(
    target: ListProjection,
    index: u64
): void throws { IndexOutOfBounds }

export declare function columnLength(source: ReadColumn): u64

export declare function writeColumnOptionalU32(
    target: WriteColumn,
    index: u64,
    value: u32?
): void throws { IndexOutOfBounds }

export declare function writeColumnOptionalU8(
    target: WriteColumn,
    index: u64,
    value: u8?
): void throws { IndexOutOfBounds }

export declare function writeColumnBool(
    target: WriteColumn,
    index: u64,
    value: bool
): void throws { IndexOutOfBounds }

export declare function writeColumnText(
    target: WriteColumn,
    index: u64,
    value: string
): void throws { IndexOutOfBounds }

export declare function writeColumnOptionalTextList(
    target: WriteColumn,
    index: u64,
    value: string[]?
): void throws { IndexOutOfBounds }

export declare function clearOptionalRowList(
    target: WriteColumn,
    index: u64
): void throws { IndexOutOfBounds }

export declare function writeColumnOptionalText(
    target: WriteColumn,
    index: u64,
    value: string?
): void throws { IndexOutOfBounds }

export declare function writeColumnTextList(
    target: WriteColumn,
    index: u64,
    value: string[]
): void throws { IndexOutOfBounds }

export declare function writeColumnByteList(
    target: WriteColumn,
    index: u64,
    value: u8[][]
): void throws { IndexOutOfBounds }

export declare function readColumnU32(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readScalarKind(
    source: ReadColumn,
    index: u64
): u8 throws { IndexOutOfBounds }

export declare function readScalarMagnitude(
    source: ReadColumn,
    index: u64
): u64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarFloat(
    source: ReadColumn,
    index: u64
): f64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarBoolean(
    source: ReadColumn,
    index: u64
): bool throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarEnumeration(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarText(
    source: ReadColumn,
    index: u64
): string? throws { IndexOutOfBounds }
export declare function copyScalar(
    source: ReadColumn,
    target: WriteColumn,
    index: u64
): void throws { IndexOutOfBounds }

export declare function copyScalarAt(
    source: ReadColumn,
    index: u64,
    target: WriteColumn,
    destination: u64
): void throws { IndexOutOfBounds }

export declare function writeScalarText(
    target: WriteColumn,
    index: u64,
    value: string
): void throws { IndexOutOfBounds }

export declare function readListOptionalU8(
    source: ListColumn,
    index: u64,
    member: u64
): u8? throws { IndexOutOfBounds }

export declare function readReferencedOptionalBytes(
    source: ReferenceColumn,
    index: u64
): u8[]? throws { IndexOutOfBounds }

export declare function readReferencedBytes(
    source: ReferenceColumn,
    index: u64
): u8[] throws { IndexOutOfBounds }

export declare function referenceRowCount(source: ReferenceRows): u64

export declare function sameReferenceRow(
    left: ReferenceRows,
    right: ReferenceRows,
    left_row: u64,
    right_row: u64
): bool throws { IndexOutOfBounds }

export declare function readReferenceRange(
    source: ReferenceRows,
    first: u64,
    end: u64
): u8[] throws { IndexOutOfBounds }

export declare function selectReferenceRow(
    source: ReferenceRows,
    row: u64,
    shape: ReferenceRow?
): ReferenceRow throws { IndexOutOfBounds }

export declare function readNestedReferenceRows(
    source: ReferenceRows,
    row: u64,
    offset: u64
): ReferenceRows throws { IndexOutOfBounds }

export declare function readReferenceRowBytes(
    source: ReferenceRow,
    offset: u64,
    width: u64
): u8[] throws { IndexOutOfBounds }

export declare function readReferenceRowOptionalU32(
    source: ReferenceRow,
    offset: u64
): u32?[] throws { IndexOutOfBounds }

export declare function readReferenceRowText(
    source: ReferenceRow,
    offset: u64
): string[] throws { IndexOutOfBounds }

export declare function readIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string throws { IndexOutOfBounds, MissingField }

export declare function readOptionalIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string? throws { IndexOutOfBounds }
