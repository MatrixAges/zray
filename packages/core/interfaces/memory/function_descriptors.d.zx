export type StatementKindBuffer = opaque

export enum Ownership {
    Copy,
    Borrowed,
    Owned
}

export type Symbols = {
    names: string[]
    types: u32[]
    span_start: u64[]
    span_end: u64[]
    ownership: Ownership[]
}

export enum ExpressionKind {
    Integer,
    NegativeInteger,
    Float,
    String,
    Boolean,
    None,
    Unit,
    Some,
    Capture,
    Task,
    AwaitTask,
    CancelTask,
    Parallel,
    OptionalValue,
    EnumValue,
    ErrorValue,
    Reference,
    StoreGet,
    Field,
    Index,
    Length,
    List,
    Tuple,
    TupleField,
    Template,
    ListOperation,
    Transform,
    Scope,
    Iteration,
    ListUpdate,
    Call,
    Unary,
    Binary,
    Conditional,
    Match,
    Object
}

export enum CollectionKind {
    Push,
    Pop,
    Sort,
    Reverse,
    Splice,
    Concat,
    Slice
}

export enum TransformKind {
    Map,
    Filter,
    Reduce,
    Every,
    Some,
    Sort
}

export enum UnaryOperator {
    Negate,
    Not
}

export enum BinaryOperator {
    Coalesce,
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    LogicalAnd,
    LogicalOr
}

export type Expressions = {
    kinds: ExpressionKind[]
    types: u32[]
    span_start: u64[]
    span_end: u64[]
    payloads: u32[]
    integers: u64[]
    negative_integers: u64[]
    floats: f64[]
    strings: string[]
    booleans: bool[]
    some: u32[]
    captures: u32[]
    awaits: u32[]
    cancellations: u32[]
    optional_values: u32[]
    enumerations: u32[]
    errors: u32[]
    references: u32[]
    stores: u32[]
    lengths: u32[]
    sequence_first: u32[]
    sequence_count: u32[]
    sequence_items: u32[]
    projection_targets: u32[]
    projection_indices: u32[]
    index_targets: u32[]
    index_values: u32[]
    task_bodies: u32[]
    task_capture_first: u32[]
    task_capture_count: u32[]
    task_captures: u32[]
    parallel_first: u32[]
    parallel_count: u32[]
    parallel_tasks: u32[]
    parallel_fields: u32?[]
    collection_kinds: CollectionKind[]
    collection_targets: u32[]
    collection_first: u32[]
    collection_count: u32[]
    collection_arguments: u32[]
    transform_kinds: TransformKind[]
    transform_targets: u32[]
    transform_bodies: u32[]
    transform_initials: u32?[]
    transform_first: u32[]
    transform_count: u32[]
    transform_parameters: u32[]
    scope_results: u32[]
    scope_first: u32[]
    scope_count: u32[]
    scope_symbols: u32?[]
    scope_values: u32[]
    scope_borrows: bool[]
    iteration_initials: u32[]
    iteration_condition_parameters: u32[]
    iteration_parameters: u32[]
    iteration_environment_symbols: u32?[]
    iteration_conditions: u32[]
    iteration_bodies: u32[]
    iteration_postconditions: bool[]
    update_targets: u32[]
    update_indices: u32[]
    update_values: u32[]
    call_functions: u32[]
    call_arguments: u32[]
    call_store_first: u32[]
    call_store_count: u32[]
    call_stores: u32[]
    unary_operators: UnaryOperator[]
    unary_operands: u32[]
    binary_operators: BinaryOperator[]
    binary_left: u32[]
    binary_right: u32[]
    conditional_conditions: u32[]
    conditional_yes: u32[]
    conditional_no: u32[]
    match_subjects: u32?[]
    match_fallbacks: u32[]
    match_first: u32[]
    match_count: u32[]
    match_conditions: u32[]
    match_results: u32[]
    object_first: u32[]
    object_count: u32[]
    object_field_indices: u32[]
    object_field_values: u32[]
    object_evaluation_first: u32[]
    object_evaluation_count: u32[]
    object_evaluation_values: u32[]
}

export enum ContractKind {
    Requires,
    Ensures
}

export type Contracts = {
    kinds: ContractKind[],
    predicates: u32[],
    symbols: Symbols[],
    expressions: Expressions[],
    span_start: u64[],
    span_end: u64[]
}

export enum StatementKind {
    Evaluate,
    Constant,
    Parallel,
    Destructure,
    Branch,
    Switch,
    StoreSet,
    Result
}

export type Control = {
    statement_kinds: StatementKind[]
    statement_payloads: u32[]
    evaluations: u32[]
    constant_symbols: u32[]
    constant_values: u32[]
    parallel_first: u32[]
    parallel_count: u32[]
    parallel_symbols: u32?[]
    parallel_values: u32[]
    destructure_values: u32[]
    destructure_first: u32[]
    destructure_count: u32[]
    destructure_symbols: u32?[]
    branch_conditions: u32[]
    branch_yes: u32[]
    branch_no: u32[]
    selection_subjects: u32[]
    selection_first: u32[]
    selection_count: u32[]
    selection_exhaustive: bool[]
    case_values: u32?[]
    case_bodies: u32[]
    setter_slots: u32[]
    setter_values: u32[]
    results: u32?[]
    block_first: u32[]
    block_count: u32[]
}

export type Stores = {
    paths: string[],
    types: u32[],
    handles: string[],
    readable: bool[],
    writable: bool[]
}
