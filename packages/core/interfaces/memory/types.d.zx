export type AtomicRows = opaque
// This single field borrows the caller's native slice descriptor.
export type U64View = {
    values: u64[]
}

export type NamedRows = opaque

export type Allocator = opaque

export type TextColumn = opaque
export type ReadColumn = opaque
export type ListColumn = opaque
export type ListProjection = opaque
export type OptionalListColumn = opaque
export type ColumnLengths = opaque
export type TransferTarget = opaque

export type TransferColumn = {
    target: TransferTarget,
    layout: TransferLayout,
    stride: u64,
    width: u64,
    text_lists?: string[][],
    optional_text_lists?: string[]?[]
}

export type TransferGroup = {
    columns: TransferColumn[],
    lengths: ColumnLengths
}

export type ColumnTransfers = TransferGroup[]

export enum TransferLayout {
    Contiguous,
    Projected,
    Retained
}
