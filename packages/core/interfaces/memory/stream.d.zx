export declare function takeByte(
    source: StreamReader
): u8 throws { EndOfStream, ReadFailed }

export declare function takeU32Le(
    source: StreamReader
): u32 throws { EndOfStream, ReadFailed }

export declare function takeU64Le(
    source: StreamReader
): u64 throws { EndOfStream, ReadFailed }

export declare function takeText(
    allocator,
    source: StreamReader,
    count: u32
): string throws { EndOfStream, ReadFailed, OutOfMemory }

export declare function writeStreamText(
    target: StreamWriter,
    value: string
): void throws { WriteFailed }

export declare function writeStreamJsonBytes(
    target: StreamWriter,
    value: u8[]
): void throws { WriteFailed }
