export type U8Buffer = opaque
export type BoolBuffer = opaque
export type ByteWriter = opaque
export type StreamReader = opaque
export type StreamWriter = opaque
export type U32Buffer = opaque
export type U32Scratch = opaque
export type U64Buffer = opaque
export type U8Storage = opaque
export type U32Storage = opaque
export type U64Storage = opaque
export type OptionalU32Buffer = opaque
export type StringBuffer = opaque
export type OptionalStringBuffer = opaque
export type U8ListBuffer = opaque
export type U32ListBuffer = opaque
export type StringListBuffer = opaque
export type NamedRows = opaque
export type NamedColumns = opaque
export type NamedRowBuffer = opaque

export type Allocator = opaque
export type Arena = opaque
export type ScratchArena = opaque
export type ArenaScope = opaque
export type TextColumn = opaque
export type ReadColumn = opaque
export type ListColumn = opaque
export type OptionalListColumn = opaque
export type WriteColumn = opaque
export type ColumnRanges = opaque
export type ColumnLengths = opaque
export type ColumnTransfers = opaque

export type TypeRangeElements = [u8, u32, u32, string, u32, u32, string, string]
export type NominalRangeElements = [u32, u8, string, string, string]

export declare function sha256Into(target: U8Buffer, input: u8[]): u8[]

export declare function sha256IntoRange(
    target: U8Buffer,
    offset: u64,
    input: u8[]
): void throws { IndexOutOfBounds }

export declare function sha256FramedInto(
    target: U8Buffer,
    prefix: u8[],
    input: u8[],
    suffix: u8[]
): u8[]

export declare function resetArena(
    arena: Arena
): void throws { OutOfMemory }

export declare function rewindScratchArena(arena: ScratchArena): void

export declare function selectArena(scope: ArenaScope, arena: Arena): void

export declare function resetArenaRetainingCapacity(source: Arena): bool

export declare function selectAllocator(scope: ArenaScope, allocator: Allocator): void

export declare function publishColumnLengths(
    target: ColumnLengths,
    count: u64
): void

export declare function restoreColumnLengths(
    target: ColumnLengths,
    counts: u64[]
): void

export declare function captureColumnLengths(source: ColumnLengths, target: U64Buffer): void

export declare function firstColumnLength(source: ColumnLengths): u64

export declare function truncateColumnLengths(
    target: ColumnLengths,
    count: u64
): void

export declare function allocateStringViews(
    allocator,
    target: StringBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function allocateBoolViews(
    allocator,
    target: BoolBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function allocateU32Views(
    allocator,
    target: U32Buffer,
    count: u64
): void throws { OutOfMemory }

export declare function allocateU64Views(
    allocator,
    target: U64Buffer,
    count: u64
): void throws { OutOfMemory }

export declare function reserveTypeRanges(
    resource: Allocator,
    target: ColumnRanges,
    elements: TypeRangeElements?,
    limit: u64?,
    precise: bool
): void throws { OutOfMemory }

export declare function reserveNominalRanges(
    resource: Allocator,
    target: ColumnRanges,
    elements: NominalRangeElements?
): void throws { OutOfMemory }

export declare function publishTypeRanges(
    target: ColumnRanges,
    elements: TypeRangeElements?
): void

export declare function publishNominalRanges(
    target: ColumnRanges,
    elements: NominalRangeElements?
): void

export declare function setColumnRangeCount(
    target: ColumnRanges,
    index: u64,
    count: u64
): void

export declare function stringViews(source: StringBuffer): string[]

export declare function u8Views(source: U8Buffer): u8[]

export declare function u32Views(source: U32Buffer): u32[]

export declare function appendU64(
    resource: Allocator,
    target: U64Storage,
    value: u64
): void throws { OutOfMemory }

export declare function reserveU8Tail(
    resource: Allocator,
    storage: U8Storage,
    source: U8Buffer,
    tail: U8Buffer,
    count: u64,
    limit: u64
): void throws { OutOfMemory }

export declare function reserveU32Tail(
    resource: Allocator,
    storage: U32Storage,
    source: U32Buffer,
    tail: U32Buffer,
    count: u64,
    limit: u64
): void throws { OutOfMemory }

export declare function optionalU32Views(source: OptionalU32Buffer): u32?[]

export declare function refreshOptionalU32View(
    target: OptionalU32Buffer,
    source: OptionalU32Buffer
): void

export declare function borrowOptionalU32Range(
    source: u32?[],
    first: u64,
    count: u64
): u32?[] throws { IndexOutOfBounds } concurrent

export declare function u32BufferLength(source: U32Buffer): u64

export declare function clearU32Buffer(
    target: U32Buffer,
    count: u64
): void throws { IndexOutOfBounds }

export declare function fillU32Buffer(
    target: U32Buffer,
    count: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function growU32Scratch(
    scratch: U32Scratch,
    count: u64,
    precise: bool
): void throws { OutOfMemory }

export declare function borrowTextRange(
    source: string,
    first: u64,
    count: u64
): string throws { IndexOutOfBounds } concurrent

export declare function borrowU8Range(
    source: u8[],
    first: u64,
    count: u64
): u8[] throws { IndexOutOfBounds } concurrent

export declare function readU64Bytes(
    source: u8[],
    offset: u64,
    little_endian: bool
): u64 throws { IndexOutOfBounds } concurrent

export declare function readI32Bytes(
    source: u8[],
    offset: u64,
    little_endian: bool
): i32 throws { IndexOutOfBounds } concurrent

export declare function i32Bits(value: i32): u32 concurrent

export declare function copyText(allocator, value: string): string throws {
    OutOfMemory
}

export declare function borrowU32Range(
    source: u32[],
    first: u64,
    count: u64
): u32[] throws { IndexOutOfBounds } concurrent

export declare function borrowU64Range(
    source: u64[],
    first: u64,
    count: u64
): u64[] throws { IndexOutOfBounds } concurrent

export declare function borrowStringRange(
    source: string[],
    first: u64,
    count: u64
): string[] throws { IndexOutOfBounds } concurrent
