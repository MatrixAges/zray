export type U8Buffer = opaque
export type U32Buffer = opaque
export type U32Scratch = opaque
export type U64Buffer = opaque
export type OptionalU32Buffer = opaque
export type StringBuffer = opaque
export type OptionalStringBuffer = opaque
export type U32ListBuffer = opaque
export type StringListBuffer = opaque
export type NamedRows = opaque
export type NamedRowBuffer = opaque
export type Allocator = opaque
export type TextColumn = opaque
export type ReadColumn = opaque
export type ListColumn = opaque
export type WriteColumn = opaque
export type ColumnRanges = opaque
export type ColumnLengths = opaque

export type TypeRangeElements = [u8, u32, u32, string, u32, u32, string, string]
export type NominalRangeElements = [u32, u8, string, string, string]

export declare function publishColumnLengths(
    target: ColumnLengths,
    count: u64
): void

export declare function allocateStringViews(
    allocator,
    target: StringBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function allocateU32Views(
    allocator,
    target: U32Buffer,
    count: u64
): void throws { OutOfMemory }

export declare function reserveTypeRanges(
    resource: Allocator,
    target: ColumnRanges,
    elements: TypeRangeElements?,
    limit: u64?,
    precise: bool
): void throws { OutOfMemory }

export declare function reserveNominalRanges(
    resource: Allocator,
    target: ColumnRanges,
    elements: NominalRangeElements?
): void throws { OutOfMemory }

export declare function publishTypeRanges(
    target: ColumnRanges,
    elements: TypeRangeElements?
): void

export declare function publishNominalRanges(
    target: ColumnRanges,
    elements: NominalRangeElements?
): void

export declare function stringViews(source: StringBuffer): string[]

export declare function u32Views(source: U32Buffer): u32[]

export declare function optionalU32Views(source: OptionalU32Buffer): u32?[]

export declare function refreshOptionalU32View(
    target: OptionalU32Buffer,
    source: OptionalU32Buffer
): void

export declare function u32BufferLength(source: U32Buffer): u64

export declare function clearU32Buffer(
    target: U32Buffer,
    count: u64
): void throws { IndexOutOfBounds }

export declare function growU32Scratch(
    scratch: U32Scratch,
    count: u64,
    precise: bool
): void throws { OutOfMemory }

export declare function borrowU8Range(
    source: u8[],
    first: u64,
    count: u64
): u8[] throws { IndexOutOfBounds } concurrent

export declare function writeColumnU8(
    target: WriteColumn,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function writeColumnU32(
    target: WriteColumn,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeColumnU64(
    target: WriteColumn,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function writeColumnBytes(
    target: WriteColumn,
    index: u64,
    value: u8[]
): void throws { IndexOutOfBounds }

export declare function borrowU32Range(
    source: u32[],
    first: u64,
    count: u64
): u32[] throws { IndexOutOfBounds } concurrent

export declare function borrowStringRange(
    source: string[],
    first: u64,
    count: u64
): string[] throws { IndexOutOfBounds } concurrent

export declare function readTextColumn(
    source: TextColumn,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readOptionalTextColumn(
    source: ReadColumn,
    index: u64
): string? throws { IndexOutOfBounds }

export declare function readTextListColumn(
    source: ReadColumn,
    index: u64
): string[] throws { IndexOutOfBounds }

export declare function readColumnU8(
    source: ReadColumn,
    index: u64
): u8 throws { IndexOutOfBounds }

export declare function readColumnBool(
    source: ReadColumn,
    index: u64
): bool throws { IndexOutOfBounds }

export declare function readColumnI32(
    source: ReadColumn,
    index: u64
): i32 throws { IndexOutOfBounds }

export declare function readColumnU32(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function columnLength(source: ReadColumn): u64

export declare function readColumnU64(
    source: ReadColumn,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readColumnOptionalU32(
    source: ReadColumn,
    index: u64
): u32? throws { IndexOutOfBounds }

export declare function readColumnOptionalU8(
    source: ReadColumn,
    index: u64
): u8? throws { IndexOutOfBounds }

export declare function listLength(
    source: ListColumn,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readListText(
    source: ListColumn,
    index: u64,
    member: u64
): string throws { IndexOutOfBounds }

export declare function borrowListBytes(
    source: ListColumn,
    index: u64
): u8[] throws { IndexOutOfBounds }

export declare function readListOptionalU32(
    source: ListColumn,
    index: u64,
    member: u64
): u32? throws { IndexOutOfBounds }

export declare function readRowName(
    source: NamedRows,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readRowId(
    source: NamedRows,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function writeNamedRow(
    target: NamedRowBuffer,
    index: u64,
    name: string,
    id: u32
): void throws { IndexOutOfBounds }

export declare function allocateNamedRows(
    allocator,
    target: NamedRowBuffer,
    count: u64
): void throws { OutOfMemory }
