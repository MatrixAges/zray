export declare function readRowName(
    source: NamedRows,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readRowId(
    source: NamedRows,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function bindNamedRowView(
    source: ReadColumn,
    index: u64,
    target: NamedRowViewBuffer
): u64 throws { IndexOutOfBounds }

export declare function namedRowsView(
    source: NamedRowViewBuffer,
    shape: NamedRows?
): NamedRows

export declare function u8ListViews(source: U8ListBuffer): u8[][]

export declare function writeOptionalString(
    target: OptionalStringBuffer,
    index: u64,
    value: string?
): void throws { IndexOutOfBounds }

export declare function copyU32s(
    target: U32Buffer,
    source: u32[]
): void throws { IndexOutOfBounds }
