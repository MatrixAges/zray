export declare function readRowName(
    source: NamedRows,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readRowId(
    source: NamedRows,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function writeNamedRow(
    target: NamedRowBuffer,
    index: u64,
    name: string,
    id: u32
): void throws { IndexOutOfBounds }

export declare function allocateNamedRows(
    allocator,
    target: NamedRowBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function bindNamedRowView(
    source: ReadColumn,
    index: u64,
    target: NamedRows
): u64 throws { IndexOutOfBounds }

export declare function u8ListViews(source: U8ListBuffer): u8[][]

export declare function writeString(
    target: StringBuffer,
    index: u64,
    value: string
): void throws { IndexOutOfBounds }

export declare function writeOptionalString(
    target: OptionalStringBuffer,
    index: u64,
    value: string?
): void throws { IndexOutOfBounds }

export declare function initializeU32ListSlot(
    target: U32ListBuffer,
    index: u64,
    shape: U32Buffer?
): U32Buffer throws { IndexOutOfBounds }

export declare function writeU8List(
    target: U8ListBuffer,
    index: u64,
    value: u8[]
): void throws { IndexOutOfBounds }

export declare function writeBoolList(
    target: BoolListBuffer,
    index: u64,
    value: bool[]
): void throws { IndexOutOfBounds }

export declare function writeU32List(
    target: U32ListBuffer,
    index: u64,
    value: u32[]
): void throws { IndexOutOfBounds }

export declare function writeU64List(
    target: U64ListBuffer,
    index: u64,
    value: u64[]
): void throws { IndexOutOfBounds }

export declare function writeStringList(
    target: StringListBuffer,
    index: u64,
    value: string[]
): void throws { IndexOutOfBounds }

export declare function copyU8s(
    target: U8Buffer,
    source: u8[]
): void throws { IndexOutOfBounds }

export declare function copyBools(
    target: BoolBuffer,
    source: bool[]
): void throws { IndexOutOfBounds }

export declare function copyU32s(
    target: U32Buffer,
    source: u32[]
): void throws { IndexOutOfBounds }

export declare function copyU64s(
    target: U64Buffer,
    source: u64[]
): void throws { IndexOutOfBounds }

export declare function copyU32sAt(
    target: U32Buffer,
    offset: u64,
    source: u32[]
): void throws { IndexOutOfBounds }

export declare function copyU32Range(
    target: U32Buffer,
    offset: u64,
    source: u32[],
    start: u64,
    end: u64
): void throws { IndexOutOfBounds }

export declare function copyStringViews(
    target: StringBuffer,
    source: string[]
): void throws { IndexOutOfBounds }

export declare function copyStringViewsAt(
    target: StringBuffer,
    offset: u64,
    source: string[]
): void throws { IndexOutOfBounds }

export declare function appendByte(
    target: ByteWriter,
    byte: u8
): void throws { OutOfMemory }

export declare function appendBytes(
    target: ByteWriter,
    bytes: u8[]
): void throws { OutOfMemory }

export declare function appendText(
    target: ByteWriter,
    text: string
): void throws { OutOfMemory }

export declare function byteWriterLength(target: ByteWriter): u64

export declare function borrowByteWriterBytes(target: ByteWriter): u8[]

export declare function clearByteWriter(target: ByteWriter): void

