import memory from "memory"
import columns from "memory/columns"

export type Input = {
    current: u64,
    used: u64,
    additional: u64,
    base: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { current, used, additional, base } = in

    const limit = columns.rowCapacityLimit()

    memory.requireAllocation(additional <= limit - used)

    const minimum = used + additional

    if (minimum <= current) {
        return current
    }

    const increment = minimum / 2 + base

    return match {
        increment <= limit - minimum => minimum + increment,
        _ => limit
    }
}
