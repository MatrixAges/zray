import columns from "memory/columns"

import allocate from "./allocate"

import type { RowBuffer, WriteColumn } from "memory/columns"

export type Input = [
    WriteColumn,
    u64,
    RowBuffer,
    u64
]

export type Output = void

export default function (in: Input): Output {
    const [column, index, target, count] = in

    columns.clearRowStorage(target)

    allocate({
        target,
        count
    })

    columns.writeRowListCount(column, index, target, count)
}
