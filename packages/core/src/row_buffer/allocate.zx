import columns from "memory/columns"

import refreshWrites from "./refresh_writes"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Input = {
    target: RowBuffer,
    count: u64,
    owner?: ColumnAllocator
}

export type Output = void

export default function (in: Input): Output {
    const { target, count, owner } = in

    if (columns.allocateRowStorage(owner, target, count)) {
        refreshWrites([
            target,
            count
        ])
    }
}
