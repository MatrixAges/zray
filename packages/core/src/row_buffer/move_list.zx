import columns from "memory/columns"

import refreshWrites from "./refresh_writes"

import type { RowBuffer, WriteColumn } from "memory/columns"

export type Input = [
    WriteColumn,
    u64,
    RowBuffer
]

export type Output = void

export default function (in: Input): Output {
    const [column, index, source] = in

    columns.writeRowList(column, index, source)
    columns.clearRowStorage(source)

    refreshWrites([
        source,
        0
    ])
}
