import columns from "memory/columns"

import refreshWrites from "./refresh_writes"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Input = [
    RowBuffer,
    u64,
    u64,
    ColumnAllocator?
]

export type Output = void

export default function (in: Input): Output {
    const [target, used, count, owner] = in

    if (columns.reserveRowStorage(owner, target, used, count)) {
        refreshWrites([
            target,
            count
        ])
    }
}
