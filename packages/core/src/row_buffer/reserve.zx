import columns from "memory/columns"

import refreshWrites from "./refresh_writes"

import type { RowBuffer } from "memory/columns"

export type Input = [
    RowBuffer,
    u64,
    u64
]

export type Output = void

export default function (in: Input): Output {
    const [target, used, count] = in

    if (columns.reserveRowStorage(target, used, count)) {
        refreshWrites([
            target,
            count
        ])
    }
}
