import columns from "memory/columns"

import refreshReads from "./refresh_reads"
import reserveAppend from "./reserve_append"

import type { RowGrowth } from "memory/columns"

export type Input = [
    RowGrowth,
    u64
]

export type Output = u64

export default function (in: Input): Output {
    const [growth, used] = in

    const target = columns.rowGrowthBuffer(growth, null)

    const capacity = reserveAppend([
        target,
        used,
        1
    ])

    refreshReads(growth)

    return capacity
}
