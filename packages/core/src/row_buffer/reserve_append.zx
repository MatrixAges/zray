import columns from "memory/columns"

import capacityFor from "./capacity"
import reserve from "./reserve"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Input = [
    RowBuffer,
    u64,
    u64,
    ColumnAllocator?
]

export type Output = u64

export default function (in: Input): Output {
    const [target, used, additional, owner] = in

    const current = columns.rowStorageCount(target)

    const capacity = capacityFor({
        current,
        used,
        additional,
        base: columns.rowGrowthBase(target, current)
    })

    if (capacity != current) {
        reserve([
            target,
            used,
            capacity,
            owner
        ])
    }

    return capacity
}
