import columns from "memory/columns"

import type { ListProjection } from "memory/columns"

export type Input = [
    ListProjection,
    u64
]

export type Output = void

export default function (in: Input): Output {
    const [projection, row] = in

    const count = columns.listProjectionSourceCount(projection)

    columns.requireColumnBounds(
        count == columns.listProjectionTargetCount(projection)
    )

    const written = loop(0, {
        while: slot => slot < count,
        next: slot => {
            columns.projectListCell(projection, slot, row)
            slot += 1
        }
    })
}
