import columns from "memory/columns"

import type { ColumnRecord, ColumnRowLayout, ColumnSet } from "memory/columns"

export type Input = {
    storage: ColumnSet,
    row: ColumnRecord,
    layout: ColumnRowLayout,
    index?: u64
}

export type Output = void

export default function (in: Input): Output {
    const { storage, row, layout, index } = in

    const count = columns.rowCellCount(layout)

    const written = loop(0, {
        while: slot => slot < count,
        next: slot => {
            columns.writeColumnCell(storage, row, layout, slot, index)
            slot += 1
        }
    })
}
