import columns from "memory/columns"

import readCells from "./read_cells"

import type { Complete } from "memory/columns"
import type { View } from "./model"

export type Input = View & {
    shape?: Complete
}

export type Output = Complete

export default function (in: Input): Output {
    const { storage, view, shape } = in

    readCells({
        storage,
        view,
        layout: columns.functionColumnLayout(shape, null)
    })

    return columns.functionColumnView(view, shape)
}
