import columns from "memory/columns"

import writeCells from "./write_cells"

import type { ColumnSet, SignatureRow } from "memory/columns"

export type Input = {
    storage: ColumnSet,
    row: SignatureRow
}

export type Output = void

export default function (in: Input): Output {
    const { storage, row } = in

    writeCells({
        storage,
        row: columns.borrowSignatureRecord(row, null),
        layout: columns.signatureRowLayout(null, null)
    })
}
