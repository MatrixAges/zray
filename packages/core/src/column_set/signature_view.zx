import columns from "memory/columns"

import readCells from "./read_cells"

import type { LinkedSignatureColumns } from "memory/columns"
import type { View } from "./model"

export type Input = View & {
    shape?: LinkedSignatureColumns
}

export type Output = LinkedSignatureColumns

export default function (in: Input): Output {
    const { storage, view, shape } = in

    readCells({
        storage,
        view,
        layout: columns.signatureColumnLayout(shape, null)
    })

    return columns.signatureColumnView(view, shape)
}
