import columns from "memory/columns"

import readCells from "./read_cells"

import type { NativeModuleColumns } from "memory/columns"
import type { View } from "./model"

export type Input = View & {
    shape?: NativeModuleColumns
}

export type Output = NativeModuleColumns

export default function (in: Input): Output {
    const { storage, view, shape } = in

    readCells({
        storage,
        view,
        layout: columns.moduleColumnLayout(shape, null)
    })

    return columns.moduleColumnView(view, shape)
}
