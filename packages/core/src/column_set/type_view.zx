import columns from "memory/columns"

import readCells from "./read_cells"

import type { TypeColumns } from "memory/columns"
import type { View } from "./model"

export type Input = View & {
    shape?: TypeColumns
}

export type Output = TypeColumns

export default function (in: Input): Output {
    const { storage, view, shape } = in

    readCells({
        storage,
        view,
        layout: columns.typeColumnLayout(shape, null)
    })

    return columns.typeColumnView(view, shape)
}
