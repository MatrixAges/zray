import columns from "memory/columns"

import type { ColumnView, ColumnViewLayout, SliceColumns } from "memory/columns"

export type Input = {
    source: SliceColumns,
    view: ColumnView,
    layout: ColumnViewLayout,
    row: u64
}

export type Output = void

export default function (in: Input): Output {
    const { source, view, layout, row } = in

    const count = columns.sliceColumnCount(source)

    const read = loop(0, {
        while: slot => slot < count,
        next: slot => {
            columns.readSliceCell(source, view, layout, slot, row)
            slot += 1
        }
    })
}
