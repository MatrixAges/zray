import { writeCells } from "core/column_set"
import columns from "memory/columns"

import type { ColumnSet, FunctionBodyRow, FunctionNativeRow } from "memory/columns"

export type Input = {
    storage: ColumnSet,
    body: FunctionBodyRow,
    native?: FunctionNativeRow
}

export type Output = void

export default function (in: Input): Output {
    const { storage, body, native } = in

    writeCells({
        storage,
        row: columns.borrowFunctionBodyRecord(body, null),
        layout: columns.functionBodyLayout(null, null, null)
    })

    const binding = match {
        native != null => columns.borrowFunctionNativeRecord(native, null),
        _ => columns.emptyFunctionNativeRecord(null, null)
    }

    writeCells({
        storage,
        row: binding,
        layout: columns.functionNativeLayout(null, null, null)
    })
}
