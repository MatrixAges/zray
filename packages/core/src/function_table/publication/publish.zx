import columns from "memory/columns"

import publishRecords from "./publish_records"

import type { ColumnSet, FunctionBodyRow, FunctionNativeRow } from "memory/columns"

export type Input = {
    storage: ColumnSet,
    body: FunctionBodyRow,
    native?: FunctionNativeRow
}

export type Output = void

export default function (in: Input): Output {
    const { storage, body, native } = in

    const binding = match {
        native != null => columns.borrowFunctionNativeRecord(native, null),
        _ => columns.emptyFunctionNativeRecord(null, null)
    }

    publishRecords({
        storage,
        body: columns.borrowFunctionBodyRecord(body, null),
        native: binding,
        body_layout: columns.functionBodyLayout(null, null, null),
        native_layout: columns.functionNativeLayout(null, null, null)
    })
}
