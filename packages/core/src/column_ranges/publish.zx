import memory from "memory"

import type { ColumnRanges } from "memory"

export type Input = ColumnRanges

export type Output = void

export default function (in: Input): Output {
    const columns = memory.columnRangeSlotCount(in)

    const published = loop(0, {
        while: slot => slot < columns,
        next: slot => {
            memory.publishColumnRange(in, slot)
            slot += 1
        }
    })
}
