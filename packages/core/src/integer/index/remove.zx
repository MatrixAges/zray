import integers from "std:integer"
import memory from "memory"

import { max_u32 } from "../../const"
import eraseSlot from "./erase_slot"
import probe from "./probe"

import type { Mutable } from "./model"

export type Input = Mutable & {
    key: u32
}

export type Output = u64?

export default function (in: Input): Output {
    const buckets = memory.u32Views(in.buckets)
    const capacity = buckets.length

    if (capacity == 0) {
        return null
    }

    const keys = memory.u32Views(in.keys)

    const slot = probe({
        keys,
        buckets,
        key: in.key
    })

    const entry = buckets[slot]

    if (entry == max_u32) {
        return null
    }

    const position = integers.widen(entry)
    const last = in.count - 1

    if (position != last) {
        const moved = keys[last]

        const replacement = probe({
            keys,
            buckets,
            key: moved
        })

        memory.writeU32(in.keys, position, moved)
        memory.writeU32(in.buckets, replacement, entry)
    }

    eraseSlot({
        keys: in.keys,
        buckets: in.buckets,
        slot
    })

    return position
}
