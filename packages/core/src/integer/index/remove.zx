import integers from "std:integer"

import { max_u32 } from "../../const"
import eraseSlot from "./erase_slot"
import probe from "./probe"

import type { Index } from "./model"

export type Input = {
    index: Index,
    key: u32
}

export type Output = {
    index: Index,
    position?: u64
}

export default function (in: Input): Output {
    const { count, keys, buckets } = in.index

    const capacity = buckets.length

    if (capacity == 0) {
        return {
            index: in.index,
            position: null
        }
    }

    const slot = probe({
        keys,
        buckets,
        key: in.key
    })

    const entry = buckets[slot]

    if (entry == max_u32) {
        return {
            index: in.index,
            position: null
        }
    }

    const position = integers.widen(entry)
    const last = count - 1

    if (position != last) {
        const moved = keys[last]

        const replacement = probe({
            keys,
            buckets,
            key: moved
        })

        const next_keys = keys.with(position, moved)

        const next_buckets = eraseSlot({
            keys: next_keys,
            buckets: buckets.with(replacement, entry),
            slot
        })

        return {
            index: {
                count: last,
                keys: next_keys,
                buckets: next_buckets
            },
            position
        }
    }

    return {
        index: {
            count: last,
            keys,
            buckets: eraseSlot({
                keys,
                buckets,
                slot
            })
        },
        position
    }
}
