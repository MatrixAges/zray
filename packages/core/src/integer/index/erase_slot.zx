import integers from "std:integer"
import memory from "memory"

import { max_u32 } from "../../const"

import type { U32Buffer } from "memory"

export type Input = {
    keys: U32Buffer,
    buckets: U32Buffer,
    slot: u64
}

export type Output = void

export default function (in: Input): Output {
    const { keys, buckets, slot } = in

    const capacity = memory.u32Views(buckets).length

    const hole = loop({
        hole: slot,
        scan: (slot + 1) % capacity,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const item = memory.readU32(buckets, state.scan)

            if (item == max_u32) {
                state.done = true
            } else {
                const key = memory.readU32(keys, integers.widen(item))
                const home = integers.hash(integers.widen(key)) % capacity
                const hole_distance = (state.hole + capacity - home) % capacity
                const scan_distance = (state.scan + capacity - home) % capacity

                if (hole_distance < scan_distance) {
                    memory.writeU32(buckets, state.hole, item)
                    state.hole = state.scan
                }

                state.scan = (state.scan + 1) % capacity
            }
        },
        return: state => state.hole
    })

    memory.writeU32(buckets, hole, max_u32)
}
