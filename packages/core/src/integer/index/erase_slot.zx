import integers from "std:integer"

import { max_u32 } from "../../const"

export type Input = {
    keys: u32[],
    buckets: u32[],
    slot: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const capacity = in.buckets.length

    const state = loop({
        buckets: in.buckets,
        hole: in.slot,
        scan: (in.slot + 1) % capacity,
        done: false
    }, {
        while: current => !current.done,
        next: current => {
            const item = current.buckets[current.scan]

            if (item == max_u32) {
                current.done = true
            } else {
                const key = in.keys[integers.widen(item)]
                const home = integers.hash(integers.widen(key)) % capacity
                const hole_distance = (current.hole + capacity - home) % capacity
                const scan_distance = (current.scan + capacity - home) % capacity

                if (hole_distance < scan_distance) {
                    current.buckets[current.hole] = item
                    current.hole = current.scan
                }

                current.scan = (current.scan + 1) % capacity
            }
        },
        return: current => ({
            buckets: current.buckets,
            hole: current.hole
        })
    })

    return state.buckets.with(state.hole, max_u32)
}
