import integers from "std:integer"

import { max_u32 } from "../../const"
import probe from "./probe"

import type { Input } from "./probe"

export type Output = u64?

export default function (in: Input): Output {
    if (in.buckets.length == 0) {
        return null
    }

    const slot = probe(in)
    const entry = in.buckets[slot]

    if (entry == max_u32) {
        return null
    }

    return integers.widen(entry)
}
