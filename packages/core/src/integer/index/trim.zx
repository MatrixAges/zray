import eraseSlot from "./erase_slot"
import probe from "./probe"

import type { Index } from "./model"

export type Input = {
    index: Index,
    first: u64
}

export type Output = Index

export default function (in: Input): Output {
    const { keys } = in.index

    const buckets = loop({
        count: in.index.count,
        buckets: in.index.buckets
    }, {
        while: state => state.count > in.first,
        next: state => {
            state.count -= 1

            const slot = probe({
                keys,
                buckets: state.buckets,
                key: keys[state.count]
            })

            state.buckets = eraseSlot({
                keys,
                buckets: state.buckets,
                slot
            })
        },
        return: state => state.buckets
    })

    return {
        count: in.first,
        keys,
        buckets
    }
}
