import integers from "std:integer"
import memory from "memory"

import { max_u32 } from "../../const"
import probe from "./probe"

import type { Mutable as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const keys = memory.u32Views(in.keys)
    const buckets = memory.u32Views(in.buckets)

    memory.fillU32Buffer(in.buckets, buckets.length, max_u32)

    const restored = loop(0, {
        while: position => position < in.count,
        next: position => {
            const slot = probe({
                keys,
                buckets,
                key: keys[position]
            })

            memory.writeU32(in.buckets, slot, integers.narrow(position))

            position += 1
        }
    })
}
