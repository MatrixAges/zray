import memory from "memory"

import type { Extent } from "./model"

export type Input = Extent

export type Output = u64

export default function (in: Input): Output {
    const { groups, index, count } = in

    if (count == 0) {
        return 0
    }

    const group = groups[index]

    const { columns, lengths } = group

    const published = loop(0, {
        while: column => column < columns.length,
        next: column => {
            memory.advanceLengthSlot(lengths, column, count)
            column += 1
        }
    })

    return count
}
