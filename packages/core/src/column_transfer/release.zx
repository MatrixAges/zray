import memory from "memory"

import releaseTextLists from "./release_text_lists"

import type { Payload } from "./model"

export type Input = Payload

export type Output = void

export default function (in: Input): Output {
    const { allocator, group, column, count } = in

    if (memory.transferOwnsTextItems(group, column)) {
        releaseTextLists(in)

        return
    }

    const released = loop(0, {
        while: row => row < count,
        next: row => {
            memory.releaseTransferItem(allocator, group, column, row)
            row += 1
        }
    })
}
