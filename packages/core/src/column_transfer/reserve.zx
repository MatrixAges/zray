import memory from "memory"

import type { Reservation } from "./model"

export type Input = Reservation

export type Output = u64

export default function (in: Input): Output {
    const { allocator, groups, index, count } = in

    const columns = groups[index].columns
    const first = memory.reserveTransferColumn(allocator, columns[0].target, count)

    const reserved = loop(1, {
        while: column => column < columns.length,
        next: column => {
            const length =
                memory.reserveTransferColumn(
                    allocator,
                    columns[column].target,
                    count
                )

            column += 1
        }
    })

    return first
}
