import memory from "memory"

import type { TransferGroup } from "memory"
import type { Span } from "./model"

export type Input = Span & {
    group: TransferGroup,
    column: u64,
    repeated: bool
}

export type Output = void

export default function (in: Input): Output {
    const { group, column, first, count, repeated } = in

    const target = memory.transferColumn(group, column, null)
    const stride = repeated ? 0 : memory.transferColumnStride(target)
    const offset = first * stride

    const copied = loop(0, {
        while: row => row < count,
        next: row => {
            memory.copyTransferCell(target, offset + row * stride, row)
            row += 1
        }
    })
}
