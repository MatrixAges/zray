import memory from "memory"

import type { TransferColumn } from "memory"
import type { Span } from "./model"

export type Input = Span & {
    column: TransferColumn
}

export type Output = u64

export default function (in: Input): Output {
    const { column, first, count } = in
    const { target, stride } = column

    const offset = first * stride

    return loop(0, {
        while: row => row < count,
        next: row => {
            memory.copyTransferRange(target, offset + row * stride, row, 1)
            row += 1
        }
    })
}
