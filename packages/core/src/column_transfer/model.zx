import type { Allocator, ColumnTransfers, TransferGroup } from "memory"

export enum Mode {
    Owned,
    BorrowingText,
    Borrowed,
    Selected
}

export { TransferLayout as ColumnLayout } from "memory"

export type Span = {
    first: u64,
    count: u64
}

export type Group = {
    groups: ColumnTransfers,
    index: u64
}

export type Extent = Group & {
    count: u64
}

export type Reservation = Extent & {
    allocator: Allocator
}

export type Copy = Reservation & Span

export type Payload = {
    allocator: Allocator,
    group: TransferGroup,
    column: u64,
    count: u64
}

export type Retain = Payload & {
    first: u64
}
