import type { Allocator, ColumnTransfers, TransferColumn } from "memory"

export { TransferLayout as ColumnLayout } from "memory"

export type Span = {
    first: u64,
    count: u64
}

export type Extent = {
    groups: ColumnTransfers,
    index: u64,
    count: u64
}

export type Reservation = Extent & {
    allocator: Allocator
}

export type Copy = Reservation & Span

export type Retain = Span & {
    allocator: Allocator,
    column: TransferColumn
}

export type RetainCell = {
    allocator: Allocator,
    column: TransferColumn,
    source: u64,
    row: u64
}
