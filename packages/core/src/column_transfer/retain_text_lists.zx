import memory from "memory"

import release from "./release"

import type { Retain } from "./model"

export type Input = Retain

export type Output = bool

export default function (in: Input): Output {
    const { allocator, group, column, first, count } = in

    const copied = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const source =
                memory.transferTextList(group, column, first + state.row, false)
            const value: string[]? = match {
                source != null => memory.cloneTextList(allocator, source),
                _ => null
            }

            if (source == null || value != null) {
                memory.writeTransferTextList(group, column, state.row, value)
                state.row += 1
            } else {
                state.valid = false
            }
        },
        return: state => state.row
    })

    if (copied == count) {
        return true
    }

    release({
        allocator,
        group,
        column,
        count: copied
    })

    return false
}
