import memory from "memory"

import type { RetainCell } from "./model"

export type Input = RetainCell

export type Output = bool

export default function (in: Input): Output {
    const { allocator, column, source, row } = in
    const { text_lists, optional_text_lists } = column

    const values: string[]? = match {
        text_lists != null => text_lists[source],
        optional_text_lists != null => optional_text_lists[source],
        _ => null
    }

    const retained = match {
        values != null => memory.cloneTextList(allocator, values),
        _ => null
    }

    if (values != null && retained == null) {
        return false
    }

    return memory.retainTransferItem(allocator, column.target, source, row, retained)
}
