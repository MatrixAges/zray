import memory from "memory"

import copyProjected from "./copy_projected"
import discard from "./discard"
import { ColumnLayout } from "./model"
import retain from "./retain"

import type { Copy } from "./model"

export type Input = Copy

export type Output = bool

export default function (in: Input): Output {
    const { allocator, groups, index, first, count } = in

    if (count == 0) {
        return true
    }

    const columns = groups[index].columns

    const copied = loop({
        column: 0,
        valid: true
    }, {
        while: state => state.valid && state.column < columns.length,
        next: state => {
            const column = columns[state.column]

            if (column.layout == ColumnLayout.Contiguous) {
                memory.copyTransferRange(
                    column.target,
                    first * column.width,
                    0,
                    count
                )
            } else if (column.layout == ColumnLayout.Retained) {
                state.valid = retain({
                    allocator,
                    column,
                    first,
                    count
                })
            } else {
                state.valid = copyProjected({
                    column,
                    first,
                    count
                }) == count
            }

            if (state.valid) {
                state.column += 1
            }
        },
        return: state => state.column
    })

    if (copied == columns.length) {
        return true
    }

    const released = loop(copied, {
        while: cursor => cursor != 0,
        next: cursor => {
            cursor = discard({
                allocator,
                columns,
                cursor,
                count
            })
        }
    })

    return false
}
