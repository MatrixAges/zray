import memory from "memory"

import retainTextList from "./retain_text_lists"

import type { Retain } from "./model"

export type Input = Retain

export type Output = bool

export default function (in: Input): Output {
    const { allocator, column, first, count } = in

    const has_lists = column.text_lists != null || column.optional_text_lists != null

    const copied = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const row = state.row
            const source = first + row

            state.valid = match {
                has_lists => retainTextList({
                    allocator,
                    column,
                    source,
                    row
                }),
                _ =>
                    memory.retainTransferItem(
                        allocator,
                        column.target,
                        source,
                        row,
                        null
                    )
            }

            if (state.valid) {
                state.row += 1
            }
        },
        return: state => state.row
    })

    if (copied == count) {
        return true
    }

    const released = loop(0, {
        while: row => row < copied,
        next: row => {
            memory.releaseTransferItem(allocator, column.target, row)
            row += 1
        }
    })

    return false
}
