import memory from "memory"

import release from "./release"
import retainTextLists from "./retain_text_lists"

import type { Retain } from "./model"

export type Input = Retain

export type Output = bool

export default function (in: Input): Output {
    const { allocator, group, column, first, count } = in

    if (memory.transferOwnsTextItems(group, column)) {
        return retainTextLists(in)
    }

    const copied = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            state.valid =
                memory.retainTransferItem(
                    allocator,
                    group,
                    column,
                    first + state.row,
                    state.row
                )

            if (state.valid) {
                state.row += 1
            }
        },
        return: state => state.row
    })

    if (copied == count) {
        return true
    }

    release({
        allocator,
        group,
        column,
        count: copied
    })

    return false
}
