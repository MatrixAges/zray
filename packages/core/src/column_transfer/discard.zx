import memory from "memory"

import rollback from "./rollback"

import type { Reservation } from "./model"

export type Input = Reservation

export type Output = void

export default function (in: Input): Output {
    if (in.count == 0) {
        return
    }

    const group = memory.borrowTransferGroup(in.groups, in.index, null)

    rollback({
        allocator: in.allocator,
        group,
        completed: memory.transferColumnCount(group),
        count: in.count
    })
}
