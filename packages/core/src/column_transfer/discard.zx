import memory from "memory"

import { ColumnLayout } from "./model"

import type { Allocator, TransferColumn } from "memory"

export type Input = {
    allocator: Allocator,
    columns: TransferColumn[],
    cursor: u64,
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { allocator, columns, cursor, count } = in

    const previous = cursor - 1
    const column = columns[previous]

    if (column.layout == ColumnLayout.Retained) {
        const released = loop(0, {
            while: row => row < count,
            next: row => {
                memory.releaseTransferItem(allocator, column.target, row)
                row += 1
            }
        })
    }

    return previous
}
