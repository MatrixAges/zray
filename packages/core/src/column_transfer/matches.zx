import memory from "memory"

import type { Extent } from "./model"

export type Input = Extent

export type Output = bool

export default function (in: Input): Output {
    const { count, groups, index } = in

    const group = memory.borrowTransferGroup(groups, index, null)
    const columns = memory.transferColumnCount(group)

    return loop({
        column: 0,
        matches: true
    }, {
        while: state => state.matches && state.column < columns,
        next: state => {
            const length = memory.transferSourceLength(group, state.column)

            state.matches = length == null || length == count
            state.column += 1
        },
        return: state => state.matches
    })
}
