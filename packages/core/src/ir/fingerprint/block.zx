import bytes from "std:bytes"
import integers from "std:integer"
import { StatementKind } from "core/control_table/model"

import {
    statement_evaluate,
    statement_constant,
    statement_parallel,
    statement_destructure,
    statement_branch,
    statement_switch,
    statement_store_set,
    statement_result
} from "./const"
import optionalWord from "./optional_word"
import statement from "./statement"
import statementTag from "./statement_tag"
import text from "./text"

import type { Block as Input } from "./model"

export type Output = u8[]

export default function block(in: Input): Output {
    const { control, symbolic, first, count } = in

    const end = first + count

    const { parts } = loop(
        {
            index: first,
            parts: [
                bytes.encodeU64Le(count)
            ]
        },
        {
            while: state => state.index < end,
            next: state => {
                const payload =
                    integers.widen(control.statement_payloads[state.index])
                const kind = control.statement_kinds[state.index]

                const tag_bytes = match symbolic {
                    true => text(statementTag(kind)),
                    _ => bytes.encodeU64Le(
                        match kind {
                            StatementKind.Evaluate => statement_evaluate,
                            StatementKind.Constant => statement_constant,
                            StatementKind.Parallel => statement_parallel,
                            StatementKind.Destructure => statement_destructure,
                            StatementKind.Branch => statement_branch,
                            StatementKind.Switch => statement_switch,
                            StatementKind.StoreSet => statement_store_set,
                            _ => statement_result
                        }
                    )
                }

                state.parts = state.parts.push(tag_bytes)[0]

                if (kind == StatementKind.Branch) {
                    const yes = integers.widen(control.branch_yes[payload])
                    const no = integers.widen(control.branch_no[payload])

                    state.parts = state.parts
                        .push(
                            bytes.encodeU64Le(
                                integers.widen(
                                    control.branch_conditions[payload]
                                )
                            )
                        )[0]
                        .push(
                            block({
                                ...in,
                                first: integers.widen(control.block_first[yes]),
                                count: integers.widen(control.block_count[yes])
                            })
                        )[0]
                        .push(
                            block({
                                ...in,
                                first: integers.widen(control.block_first[no]),
                                count: integers.widen(control.block_count[no])
                            })
                        )[0]
                } else if (kind == StatementKind.Switch) {
                    const start = integers.widen(control.selection_first[payload])
                    const length = integers.widen(control.selection_count[payload])
                    const empty_cases: u8[][] = []

                    const { cases } = loop(
                        {
                            slot: start,
                            cases: empty_cases
                        },
                        {
                            while: inner => inner.slot < start + length,
                            next: inner => {
                                const child =
                                    integers.widen(control.case_bodies[inner.slot])

                                inner.cases = inner.cases
                                    .push(
                                        optionalWord(
                                            control.case_values[inner.slot]
                                        )
                                    )[0]
                                    .push(
                                        block({
                                            ...in,
                                            first:
                                                integers.widen(
                                                    control.block_first[child]
                                                ),
                                            count:
                                                integers.widen(
                                                    control.block_count[child]
                                                )
                                        })
                                    )[0]
                                inner.slot += 1
                            }
                        }
                    )

                    const exhaustive: u8 = control.selection_exhaustive[payload] ? 1 : 0

                    state.parts = state.parts
                        .push(
                            bytes.encodeU64sLe([
                                integers.widen(
                                    control.selection_subjects[payload]
                                ),
                                length
                            ])
                        )[0]
                        .push(bytes.join(
                            bytes.fromText(""),
                            cases
                        ))[0]
                        .push([
                            exhaustive
                        ])[0]
                } else {
                    state.parts = state.parts.push(
                        statement({
                            control,
                            kind,
                            payload
                        })
                    )[0]
                }

                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
