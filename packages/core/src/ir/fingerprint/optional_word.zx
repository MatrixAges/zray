import bytes from "std:bytes"
import integers from "std:integer"

export type Input = u32?

export type Output = u8[]

export default function (in: Input): Output {
    if (in == null) {
        return [
            0
        ]
    }

    const present: u8[] = [
        1
    ]

    return bytes.join(
        bytes.fromText(""),
        [
            present,
            bytes.encodeU64Le(integers.widen(in))
        ]
    )
}
