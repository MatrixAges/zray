import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"

import optionalWord from "./optional_word"
import optionalWords from "./optional_words"
import words from "./words"

import type { ExpressionRow as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { expressions, kind, payload } = in

    switch (kind) {
        case ExpressionKind.Scope:
            const first = integers.widen(expressions.scope_first[payload])
            const count = integers.widen(expressions.scope_count[payload])
            const end = first + count
            const borrows_init: u8[] = []

            const { borrows } = loop(
                {
                    index: first,
                    borrows: borrows_init
                },
                {
                    while: state => state.index < end,
                    next: state => {
                        state.borrows = state.borrows.push(
                            expressions.scope_borrows[state.index] ? 1 : 0
                        )[0]
                        state.index += 1
                    }
                }
            )

            return bytes.join(
                bytes.fromText(""),
                [
                    optionalWords({
                        values: expressions.scope_symbols,
                        first,
                        count
                    }),
                    words(
                        memory.borrowU32Range(
                            expressions.scope_values,
                            first,
                            count
                        )
                    ),
                    bytes.encodeU64Le(count),
                    borrows,
                    bytes.encodeU64sLe([
                        count,
                        integers.widen(
                            expressions.scope_results[payload]
                        )
                    ])
                ]
            )
        case ExpressionKind.Iteration:
            const postcondition: u8[] = [
                expressions.iteration_postconditions[payload] ? 1 : 0
            ]

            return bytes.join(
                bytes.fromText(""),
                [
                    optionalWord(
                        expressions.iteration_environment_symbols[payload]
                    ),
                    bytes.encodeU64sLe([
                        integers.widen(
                            expressions.iteration_initials[payload]
                        ),
                        integers.widen(
                            expressions.iteration_condition_parameters[payload]
                        ),
                        integers.widen(
                            expressions.iteration_parameters[payload]
                        ),
                        integers.widen(
                            expressions.iteration_conditions[payload]
                        ),
                        integers.widen(
                            expressions.iteration_bodies[payload]
                        )
                    ]),
                    postcondition
                ]
            )
        default:
            const first = integers.widen(expressions.match_first[payload])
            const count = integers.widen(expressions.match_count[payload])

            return bytes.join(
                bytes.fromText(""),
                [
                    optionalWord(expressions.match_subjects[payload]),
                    words(
                        memory.borrowU32Range(
                            expressions.match_conditions,
                            first,
                            count
                        )
                    ),
                    words(
                        memory.borrowU32Range(
                            expressions.match_results,
                            first,
                            count
                        )
                    ),
                    bytes.encodeU64sLe([
                        count,
                        integers.widen(
                            expressions.match_fallbacks[payload]
                        )
                    ])
                ]
            )
    }
}
