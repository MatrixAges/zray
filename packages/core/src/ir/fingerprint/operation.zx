import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"

import binaryOperator from "./binary_operator"
import collectionKind from "./collection_kind"
import optionalWord from "./optional_word"
import transformKind from "./transform_kind"
import unaryOperator from "./unary_operator"
import words from "./words"

import type { ExpressionRow as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { expressions, kind, payload } = in

    if (kind == ExpressionKind.Field || kind == ExpressionKind.TupleField) {
        return bytes.encodeU64sLe([
            integers.widen(
                expressions.projection_targets[payload]
            ),
            integers.widen(expressions.projection_indices[payload])
        ])
    }

    switch (kind) {
        case ExpressionKind.Index:
            return bytes.encodeU64sLe([
                integers.widen(
                    expressions.index_targets[payload]
                ),
                integers.widen(expressions.index_values[payload])
            ])
        case ExpressionKind.ListOperation:
            return bytes.join(
                bytes.fromText(""),
                [
                    bytes.encodeU64sLe([
                        collectionKind(
                            expressions.collection_kinds[payload]
                        ),
                        integers.widen(
                            expressions.collection_targets[payload]
                        )
                    ]),
                    words(
                        memory.borrowU32Range(
                            expressions.collection_arguments,
                            integers.widen(expressions.collection_first[payload]),
                            integers.widen(
                                expressions.collection_count[payload]
                            )
                        )
                    )
                ]
            )
        case ExpressionKind.Transform:
            return bytes.join(
                bytes.fromText(""),
                [
                    bytes.encodeU64sLe([
                        transformKind(
                            expressions.transform_kinds[payload]
                        ),
                        integers.widen(
                            expressions.transform_targets[payload]
                        )
                    ]),
                    words(
                        memory.borrowU32Range(
                            expressions.transform_parameters,
                            integers.widen(expressions.transform_first[payload]),
                            integers.widen(expressions.transform_count[payload])
                        )
                    ),
                    bytes.encodeU64Le(
                        integers.widen(
                            expressions.transform_bodies[payload]
                        )
                    ),
                    optionalWord(expressions.transform_initials[payload])
                ]
            )
        case ExpressionKind.ListUpdate:
            return bytes.encodeU64sLe([
                integers.widen(
                    expressions.update_targets[payload]
                ),
                integers.widen(expressions.update_indices[payload]),
                integers.widen(expressions.update_values[payload])
            ])
        case ExpressionKind.Unary:
            return bytes.encodeU64sLe([
                unaryOperator(
                    expressions.unary_operators[payload]
                ),
                integers.widen(expressions.unary_operands[payload])
            ])
        case ExpressionKind.Binary:
            return bytes.encodeU64sLe([
                binaryOperator(
                    expressions.binary_operators[payload]
                ),
                integers.widen(expressions.binary_left[payload]),
                integers.widen(expressions.binary_right[payload])
            ])
        default:
            return bytes.encodeU64sLe([
                integers.widen(
                    expressions.conditional_conditions[payload]
                ),
                integers.widen(expressions.conditional_yes[payload]),
                integers.widen(expressions.conditional_no[payload])
            ])
    }
}
