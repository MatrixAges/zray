import bytes from "std:bytes"
import floats from "std:float"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import text from "./text"

import type { ExpressionRow as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { expressions, kind, payload } = in

    if (kind == ExpressionKind.None || kind == ExpressionKind.Unit) {
        return []
    }

    return match kind {
        ExpressionKind.Integer =>
            bytes.encodeU64Le(expressions.integers[payload]),
        ExpressionKind.NegativeInteger =>
            bytes.encodeU64Le(expressions.negative_integers[payload]),
        ExpressionKind.Float =>
            bytes.encodeU64Le(floats.bits(expressions.floats[payload])),
        ExpressionKind.String => text(expressions.strings[payload]),
        ExpressionKind.Boolean => [
            expressions.booleans[payload] ? 1 : 0
        ],
        ExpressionKind.Some =>
            bytes.encodeU64Le(integers.widen(expressions.some[payload])),
        ExpressionKind.Capture =>
            bytes.encodeU64Le(integers.widen(expressions.captures[payload])),
        ExpressionKind.AwaitTask =>
            bytes.encodeU64Le(integers.widen(expressions.awaits[payload])),
        ExpressionKind.CancelTask =>
            bytes.encodeU64Le(integers.widen(expressions.cancellations[payload])),
        ExpressionKind.OptionalValue =>
            bytes.encodeU64Le(integers.widen(
                expressions.optional_values[payload]
            )),
        ExpressionKind.EnumValue =>
            bytes.encodeU64Le(integers.widen(expressions.enumerations[payload])),
        ExpressionKind.ErrorValue =>
            bytes.encodeU64Le(integers.widen(expressions.errors[payload])),
        ExpressionKind.Reference =>
            bytes.encodeU64Le(integers.widen(expressions.references[payload])),
        ExpressionKind.StoreGet =>
            bytes.encodeU64Le(integers.widen(expressions.stores[payload])),
        _ => bytes.encodeU64Le(integers.widen(expressions.lengths[payload]))
    }
}
