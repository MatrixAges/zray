import bytes from "std:bytes"

import optionalWord from "./optional_word"

export type Input = {
    values: u32?[],
    first: u64,
    count: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    const { values, first, count } = in

    const end = first + count

    const { parts } = loop(
        {
            index: first,
            parts: [
                bytes.encodeU64Le(count)
            ]
        },
        {
            while: state => state.index < end,
            next: state => {
                state.parts =
                    state.parts.push(optionalWord(values[state.index]))[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
