import bytes from "std:bytes"
import integers from "std:integer"

export type Input = u32[]

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { out } = loop(
        {
            index: start_index,
            out: [
                in.length
            ]
        },
        {
            while: state => state.index < in.length,
            next: state => {
                state.out = state.out.push(integers.widen(in[state.index]))[0]
                state.index += 1
            }
        }
    )

    return bytes.encodeU64sLe(out)
}
