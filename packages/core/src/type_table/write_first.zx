import rebase from "./rebase"

import type { Input as Rebase } from "./rebase"

export type Offsets = Rebase.Pick("children", "fields", "names")

export type Input = Rebase.Omit("children", "fields", "names") & {
    offsets?: Offsets
}

export type Output = u32[]

export default function (in: Input): Output {
    const { offsets, first, kinds } = in

    if (offsets != null) {
        const { children, fields, names } = offsets

        const shifted = children != 0 || fields != 0 || names != 0

        if (shifted) {
            return rebase({
                kinds,
                first,
                ...offsets
            })
        }
    }

    return first
}
