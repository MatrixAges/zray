import kind from "./kind"
import { Kind } from "./model"

export type Input = {
    kinds: u8[],
    first: u32[],
    children: u32,
    fields: u32,
    names: u32
}

export type Output = u32[]

export default function (in: Input): Output {
    const first: u32[] = []

    return loop({
        index: 0,
        first
    }, {
        while: state => state.index < in.kinds.length,
        next: state => {
            const index = state.index
            const offset = match kind(in.kinds[index]) {
                Kind.Object => in.fields,
                Kind.Tuple => in.children,
                Kind.ErrorSet => in.names,
                Kind.Enumeration => in.names,
                _ => 0
            }

            state.first = state.first.push(in.first[index] + offset)[0]
            state.index += 1
        },
        return: state => state.first
    })
}
