export type ReferenceColumn = opaque
export type IndirectTextColumn = opaque
export type ReadColumn = opaque
export type WriteColumn = opaque
export type ListColumn = opaque
export type ListProjection = opaque
export type RowBuffer = opaque
export type ColumnSet = opaque
export type ColumnView = opaque
export type ColumnObject = opaque
export type ColumnAllocator = opaque
export type ColumnU32s = opaque

export enum ColumnOwnership {
    Copy,
    Borrowed,
    Owned
}

export enum ColumnStoreMode {
    transaction,
    orchestration
}

export type ColumnNames = string?[]
export type ColumnErrors = string[]?

export type LinkedSignatureColumns = {
    input_types: u32[],
    output_types: u32[],
    ownership: ColumnOwnership[],
    native_inputs: ColumnNames?[],
    native_modules: u32?[],
    native_members: string[][],
    native_exports: string?[],
    native_allocators: bool[],
    native_io: bool[],
    native_process: bool[],
    native_tuples: bool[],
    native_fallible: bool[]
}

export type FunctionRow = {
    files: string,
    input_types: u32,
    output_types: u32,
    ownership: ColumnOwnership,
    store_modes: ColumnStoreMode,
    contracts: ColumnObject,
    native_inputs?: ColumnNames,
    native_modules?: u32,
    native_members: string[],
    native_exports?: string,
    native_allocators: bool,
    native_io: bool,
    native_process: bool,
    native_tuples: bool,
    native_fallible: bool,
    native_errors: ColumnErrors,
    native_concurrent: bool,
    symbols: ColumnObject,
    expressions: ColumnObject,
    control: ColumnObject,
    roots?: u32,
    stores: ColumnObject
}

export type NativeModuleRow = {
    identities?: string,
    import_names: string,
    specifiers: string,
    type_ids: u32[],
    type_names: string[],
    type_namespaces: string[]
}

export declare function reserveColumnSet(
    resource: ColumnAllocator,
    target: ColumnSet,
    shape: FunctionRow?,
    count: u64,
    limit: u64
): void throws { OutOfMemory }

export declare function readColumnSet(
    source: ColumnSet,
    buffer: ColumnView,
    shape: LinkedSignatureColumns?
): LinkedSignatureColumns

export declare function appendColumnSet(
    target: ColumnSet,
    row: FunctionRow
): void

export declare function reserveNativeColumnSet(
    resource: ColumnAllocator,
    target: ColumnSet,
    shape: NativeModuleRow?,
    count: u64,
    limit: u64
): void throws { OutOfMemory }

export declare function appendNativeColumnSet(
    target: ColumnSet,
    row: NativeModuleRow
): void

export declare function allocateColumnU32s(
    resource: ColumnAllocator,
    target: ColumnU32s,
    count: u64
): u32[] throws { OutOfMemory }

export declare function writeColumnU32s(
    target: ColumnU32s,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function copyColumnText(
    resource: ColumnAllocator,
    source: string
): string throws { OutOfMemory }

export declare function copyColumnTexts(
    resource: ColumnAllocator,
    source: string[]
): string[] throws { OutOfMemory }

export declare function copyColumnOptionalTexts(
    resource: ColumnAllocator,
    source: ColumnNames
): ColumnNames throws { OutOfMemory }

export declare function allocateRows(
    allocator,
    target: RowBuffer,
    count: u64
): void throws { OutOfMemory }

export declare function copyRowPrefix(
    target: RowBuffer,
    source: u8[],
    count: u64
): void throws { IndexOutOfBounds }

export declare function projectListColumns(
    target: ListProjection,
    index: u64
): void throws { IndexOutOfBounds }

export declare function columnLength(source: ReadColumn): u64

export declare function writeColumnOptionalU32(
    target: WriteColumn,
    index: u64,
    value: u32?
): void throws { IndexOutOfBounds }

export declare function writeColumnOptionalU8(
    target: WriteColumn,
    index: u64,
    value: u8?
): void throws { IndexOutOfBounds }

export declare function writeColumnOptionalText(
    target: WriteColumn,
    index: u64,
    value: string?
): void throws { IndexOutOfBounds }

export declare function writeColumnTextList(
    target: WriteColumn,
    index: u64,
    value: string[]
): void throws { IndexOutOfBounds }

export declare function readColumnU32(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readScalarKind(
    source: ReadColumn,
    index: u64
): u8 throws { IndexOutOfBounds }

export declare function readScalarMagnitude(
    source: ReadColumn,
    index: u64
): u64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarFloat(
    source: ReadColumn,
    index: u64
): f64 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarBoolean(
    source: ReadColumn,
    index: u64
): bool throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarEnumeration(
    source: ReadColumn,
    index: u64
): u32 throws { IndexOutOfBounds, UnexpectedScalarKind }

export declare function readScalarText(
    source: ReadColumn,
    index: u64
): string? throws { IndexOutOfBounds }
export declare function copyScalar(
    source: ReadColumn,
    target: WriteColumn,
    index: u64
): void throws { IndexOutOfBounds }

export declare function copyScalarAt(
    source: ReadColumn,
    index: u64,
    target: WriteColumn,
    destination: u64
): void throws { IndexOutOfBounds }

export declare function writeScalarText(
    target: WriteColumn,
    index: u64,
    value: string
): void throws { IndexOutOfBounds }

export declare function readListOptionalU8(
    source: ListColumn,
    index: u64,
    member: u64
): u8? throws { IndexOutOfBounds }

export declare function readReferencedOptionalBytes(
    source: ReferenceColumn,
    index: u64
): u8[]? throws { IndexOutOfBounds }

export declare function readReferencedBytes(
    source: ReferenceColumn,
    index: u64
): u8[] throws { IndexOutOfBounds }

export declare function readIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string throws { IndexOutOfBounds, MissingField }

export declare function readOptionalIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string? throws { IndexOutOfBounds }
