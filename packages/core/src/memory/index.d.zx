export type U8Buffer = opaque
export type U32Buffer = opaque
export type U64Buffer = opaque
export type OptionalU32Buffer = opaque
export type StringBuffer = opaque
export type OptionalStringBuffer = opaque
export type U32ListBuffer = opaque
export type StringListBuffer = opaque
export type NamedRows = opaque
export type NamedRowBuffer = opaque
export type TextColumn = opaque
export type IndirectTextColumn = opaque
export type ReadColumn = opaque
export type ReferenceColumn = opaque
export type ListColumn = opaque
export type WriteColumn = opaque

export declare function borrowU8Range(
    source: u8[],
    first: u64,
    count: u64
): u8[] throws { IndexOutOfBounds } concurrent

export declare function writeColumnU8(
    target: WriteColumn,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function writeColumnU32(
    target: WriteColumn,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeColumnU64(
    target: WriteColumn,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function writeColumnBytes(
    target: WriteColumn,
    index: u64,
    value: u8[]
): void throws { IndexOutOfBounds }

export declare function borrowU32Range(
    source: u32[],
    first: u64,
    count: u64
): u32[] throws { IndexOutOfBounds } concurrent

export declare function borrowStringRange(
    source: string[],
    first: u64,
    count: u64
): string[] throws { IndexOutOfBounds } concurrent

export declare function readTextColumn(
    source: TextColumn,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readOptionalTextColumn(
    source: ReadColumn,
    index: u64
): string? throws { IndexOutOfBounds }

export declare function readReferencedOptionalBytes(
    source: ReferenceColumn,
    index: u64
): u8[]? throws { IndexOutOfBounds }

export declare function readReferencedBytes(
    source: ReferenceColumn,
    index: u64
): u8[] throws { IndexOutOfBounds }

export declare function readIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string throws { IndexOutOfBounds, MissingField }

export declare function readOptionalIndirectTextColumn(
    source: IndirectTextColumn,
    index: u64
): string? throws { IndexOutOfBounds }

export declare function readColumnU8(
    source: ReadColumn,
    index: u64
): u8 throws { IndexOutOfBounds }

export declare function readColumnBool(
    source: ReadColumn,
    index: u64
): bool throws { IndexOutOfBounds }

export declare function readColumnI32(
    source: ReadColumn,
    index: u64
): i32 throws { IndexOutOfBounds }

export declare function readColumnU64(
    source: ReadColumn,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readColumnOptionalU32(
    source: ReadColumn,
    index: u64
): u32? throws { IndexOutOfBounds }

export declare function listLength(
    source: ListColumn,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function readListText(
    source: ListColumn,
    index: u64,
    member: u64
): string throws { IndexOutOfBounds }

export declare function readListOptionalU32(
    source: ListColumn,
    index: u64,
    member: u64
): u32? throws { IndexOutOfBounds }

export declare function readRowName(
    source: NamedRows,
    index: u64
): string throws { IndexOutOfBounds }

export declare function readRowId(
    source: NamedRows,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function writeNamedRow(
    target: NamedRowBuffer,
    index: u64,
    name: string,
    id: u32
): void throws { IndexOutOfBounds }

export declare function readU32(
    target: U32Buffer,
    index: u64
): u32 throws { IndexOutOfBounds }

export declare function readU64(
    target: U64Buffer,
    index: u64
): u64 throws { IndexOutOfBounds }

export declare function writeU8(
    target: U8Buffer,
    index: u64,
    value: u8
): void throws { IndexOutOfBounds }

export declare function writeU32(
    target: U32Buffer,
    index: u64,
    value: u32
): void throws { IndexOutOfBounds }

export declare function writeU64(
    target: U64Buffer,
    index: u64,
    value: u64
): void throws { IndexOutOfBounds }

export declare function copyBytes(
    target: U8Buffer,
    offset: u64,
    source: u8[],
    start: u64,
    end: u64
): u64 throws { IndexOutOfBounds }

export declare function writeUtf8Scalar(
    target: U8Buffer,
    offset: u64,
    codepoint: u64
): u64 throws { IndexOutOfBounds, InvalidUnicodeScalar }

export declare function writeOptionalU32(
    target: OptionalU32Buffer,
    index: u64,
    value: u32?
): void throws { IndexOutOfBounds }

export declare function writeString(
    target: StringBuffer,
    index: u64,
    value: string
): void throws { IndexOutOfBounds }

export declare function writeOptionalString(
    target: OptionalStringBuffer,
    index: u64,
    value: string?
): void throws { IndexOutOfBounds }

export declare function writeU32List(
    target: U32ListBuffer,
    index: u64,
    value: u32[]
): void throws { IndexOutOfBounds }

export declare function writeStringList(
    target: StringListBuffer,
    index: u64,
    value: string[]
): void throws { IndexOutOfBounds }

export declare function copyStrings(
    allocator,
    target: StringBuffer,
    source: string[]
): void throws { IndexOutOfBounds, OutOfMemory }
