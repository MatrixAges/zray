import memory from "memory"

import fill from "./fill"

import type { Allocator, StringBuffer } from "memory"

export type Input = {
    allocator: Allocator,
    target: StringBuffer,
    source: string[]
}

export type Output = void

export default function (in: Input): Output {
    const { allocator, source } = in

    const target = memory.stringViews(in.target)

    memory.checkTextSlotCount(target.length, source.length)

    memory.requireAllocation(fill({
        allocator,
        source,
        target: memory.stringBufferSlots(in.target, null)
    }))
}
