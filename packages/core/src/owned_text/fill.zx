import memory from "memory"

import freePrefix from "./free_prefix"

import type { Fill } from "./model"

export type Input = Fill

export type Output = bool

export default function (in: Input): Output {
    const { allocator, source, target } = in

    const copied = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < source.length,
        next: state => {
            const text = memory.duplicateText(allocator, source[state.row])

            if (text != null) {
                memory.writeTextSlot(target, state.row, text)
                state.row += 1
            } else {
                state.valid = false
            }
        },
        return: state => state.row
    })

    if (copied == source.length) {
        return true
    }

    freePrefix({
        allocator,
        slots: memory.borrowTextSlots(target, copied),
        count: copied
    })

    return false
}
