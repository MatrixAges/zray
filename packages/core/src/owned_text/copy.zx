import memory from "memory"

import clone from "./clone"

import type { Allocation } from "./model"

export type Input = Allocation

export type Output = string[]

export default function (in: Input): Output {
    const cloned = clone(in)

    if (cloned != null) {
        return cloned
    }

    const failed = memory.requireTextSlots(null)

    return memory.borrowTextSlots(failed, 0)
}
