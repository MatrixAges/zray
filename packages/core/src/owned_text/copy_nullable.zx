import memory from "memory"

import type { Allocator } from "memory"

export type Input = {
    allocator: Allocator,
    source: string?[]
}

export type Output = string?[]

export default function (in: Input): Output {
    const { allocator, source } = in

    const target = memory.requireOptionalTextSlots(
        memory.allocateOptionalTextSlots(
            allocator,
            source.length
        )
    )

    const copied = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < source.length,
        next: state => {
            const text = source[state.row]
            const owned: string? = match {
                text != null => memory.duplicateText(allocator, text),
                _ => null
            }

            if (text == null || owned != null) {
                memory.writeOptionalTextSlot(target, state.row, owned)
                state.row += 1
            } else {
                state.valid = false
            }
        },
        return: state => state.row
    })

    if (copied == source.length) {
        return target
    }

    const released = loop(0, {
        while: row => row < copied,
        next: row => {
            const text = target[row]

            if (text != null) {
                memory.freeOwnedText(allocator, text)
            }

            row += 1
        }
    })

    memory.freeOptionalTextSlots(allocator, target)

    return memory.requireOptionalTextSlots(null)
}
