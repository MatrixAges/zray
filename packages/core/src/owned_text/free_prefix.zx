import memory from "memory"

import type { Release } from "./model"

export type Input = Release

export type Output = void

export default function (in: Input): Output {
    const { allocator, slots, count } = in

    const released = loop(0, {
        while: row => row < count,
        next: row => {
            memory.freeOwnedText(allocator, slots[row])
            row += 1
        }
    })
}
