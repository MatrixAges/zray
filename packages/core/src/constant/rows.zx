import type { ListColumn, TextColumn } from "memory"
import type { ListColumn as ByteList, ReadColumn } from "memory/columns"

export type Rows = {
    names: TextColumn,
    types: ReadColumn,
    values: ReadColumn,
    count: u64
}

export type Lists = {
    names: ListColumn,
    types: ByteList,
    values: ByteList
}
