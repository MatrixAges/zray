import bytes from "std:bytes"
import integers from "std:integer"
import memory from "std:memory"

import type { TextColumn, U64Buffer } from "std:memory"

// The caller lends a power-of-two table with at least one vacant bucket.
export type Table = {
    keys: TextColumn,
    buckets: U64Buffer,
    capacity: u64
}

export type Input = Table & {
    key: string,
    insert?: u64
}

export type Output = u64?

export default function (in: Input): Output {
    const { keys, buckets, key, insert } = in

    const mask = in.capacity - 1
    const missing: u64? = null

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(key)), mask),
        found: missing,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = memory.readU64(buckets, state.slot)

            if (entry == 0) {
                if (insert != null) {
                    memory.writeU64(buckets, state.slot, insert + 1)
                }

                state.done = true
            } else if (memory.readTextColumn(keys, entry - 1) == key) {
                state.found = entry - 1
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => state.found
    })
}
