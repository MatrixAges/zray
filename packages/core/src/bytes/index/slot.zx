import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { ReadColumn, U64View } from "memory"

// The caller lends a power-of-two table with at least one vacant bucket.
export type Table = {
    keys: u8[][],
    buckets: U64View,
    capacity: u64
}

export type Lookup = Table & {
    key: u8[]
}

export type Input = Lookup & {
    rows?: ReadColumn
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { key, buckets, keys } = in

    const mask = in.capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(key), mask),
        entry: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const row = memory.readU64View(buckets, state.slot)

            if (row == 0) {
                state.done = true
            } else {
                const rows = in.rows
                const index = match {
                    rows == null => row - 1,
                    _ => integers.widen(memory.readColumnU32(rows, row - 1))
                }

                if (bytes.equals(keys[index], key)) {
                    state.entry = row
                    state.done = true
                } else {
                    state.slot = integers.andBits(state.slot + 1, mask)
                }
            }
        },
        return: state => ({
            slot: state.slot,
            entry: state.entry
        })
    })
}
