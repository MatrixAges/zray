import bytes from "std:bytes"
import integers from "std:integer"
import memory from "std:memory"

import readKey from "./key"

import type { U64Buffer } from "std:memory"
import type { Segments } from "./model"

// The caller lends a power-of-two table with at least one vacant bucket.
export type Input = {
    keys: Segments,
    buckets: U64Buffer,
    capacity: u64,
    key: string,
    row: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { keys, buckets, key, row } = in

    const mask = in.capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(key)), mask),
        occupied: false,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = memory.readU64(buckets, state.slot)

            if (entry == 0) {
                memory.writeU64(buckets, state.slot, row + 1)
                state.done = true
            } else if (readKey({
                keys,
                row: entry - 1
            }) == key) {
                state.occupied = true
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => state.occupied
    })
}
