import memory from "std:memory"

import probe from "./slot"

import type { Input } from "./rebuild"

export type Output = u64?

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in

    return loop({
        row: 0,
        duplicate: false
    }, {
        while: state => !state.duplicate && state.row < keys.length,
        next: state => {
            const row = state.row
            const found = probe({
                keys,
                buckets,
                capacity,
                key: keys[row]
            })

            if (found.entry == 0) {
                memory.writeU64(buckets, found.slot, row + 1)
                state.row += 1
            } else {
                state.duplicate = true
            }
        },
        return: state => state.duplicate ? state.row : null
    })
}
