import bytes from "std:bytes"
import memory from "memory"

import probe from "./slot"

import type { TextColumn, WriteColumn } from "memory"
import type { Input as Table } from "./rebuild"

export type Input = Table & {
    source: TextColumn,
    target: WriteColumn
}

export type Output = u64?

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in

    return loop({
        row: 0,
        duplicate: false
    }, {
        while: state => !state.duplicate && state.row < keys.length,
        next: state => {
            const row = state.row
            const path = memory.readTextColumn(in.source, row)
            const key = bytes.fromText(path)

            const found = probe({
                keys,
                buckets: memory.u64View(buckets, null),
                capacity,
                key
            })

            if (found.entry == 0) {
                memory.writeColumnBytes(in.target, row, key)
                memory.writeU64(buckets, found.slot, row + 1)
                state.row += 1
            } else {
                state.duplicate = true
            }
        },
        return: state => state.duplicate ? state.row : null
    })
}
