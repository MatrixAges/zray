import memory from "memory"

import slot from "./slot"

import type { Exchange as Input } from "./model"

export type Output = u32?

export default function (in: Input): Output {
    if (in.capacity == 0) {
        return null
    }

    const { keys, key, buckets, insert } = in

    const located = slot({
        keys,
        buckets: memory.u32View(buckets, null),
        capacity: in.capacity,
        key
    })

    if (located.found == null && insert != null) {
        memory.writeU32(buckets, located.slot, insert + 1)
    }

    return located.found
}
