import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { TextColumn, U64View } from "memory"
import type { Output } from "../slot"

export type Table = {
    names: TextColumn,
    buckets: U64View,
    capacity: u64
}

export type Input = Table & {
    name: string
}

export default function (in: Input): Output {
    const { names, buckets, name, capacity } = in

    const key = bytes.fromText(name)
    const mask = capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(key), mask),
        entry: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = memory.readU64View(buckets, state.slot)

            if (entry == 0) {
                state.done = true
            } else {
                const row = entry - 1
                const candidate = memory.readTextColumn(names, row)

                if (bytes.equals(bytes.fromText(candidate), key)) {
                    state.entry = entry
                    state.done = true
                } else {
                    state.slot = integers.andBits(state.slot + 1, mask)
                }
            }
        },
        return: state => ({
            slot: state.slot,
            entry: state.entry
        })
    })
}
