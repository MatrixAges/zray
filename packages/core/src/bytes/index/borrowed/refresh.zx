import integers from "std:integer"
import memory from "memory"

import capacityFor from "../../map/capacity"
import { load_denominator, load_numerator } from "../const"
import probeSlice from "./probe_slice"

import type { TextColumn } from "memory"

export type Input = {
    keys: TextColumn,
    buckets: u32[],
    count: u64,
    indexed: u64,
    required: u64
}

export type Output = {
    buckets?: u32[]
}

export default function (in: Input): Output {
    const { count, indexed, buckets, keys, required } = in

    const grow = required > buckets.length * load_numerator / load_denominator

    if (!grow && count <= indexed) {
        return {
            buckets: null
        }
    }

    const seed: u32[] = []

    const size = match {
        grow => capacityFor(integers.narrow(required)).capacity,
        _ => 0
    }

    const base = match {
        grow => loop({
            items: seed
        }, {
            while: s => s.items.length < size,
            next: s => {
                s.items = s.items.push(0)[0]
            },
            return: s => s.items
        }),
        _ => buckets
    }

    const updated = loop({
        index: grow ? 0 : indexed,
        items: base
    }, {
        while: s => s.index < count,
        next: s => {
            const location = probeSlice({
                keys,
                buckets: s.items,
                text: memory.readTextColumn(keys, s.index)
            })
            s.items = s.items.with(location.slot, integers.narrow(s.index + 1))
            s.index += 1
        },
        return: s => s.items
    })

    return {
        buckets: updated
    }
}
