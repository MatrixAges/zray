import integers from "std:integer"
import memory from "memory"

import capacityFor from "../../map/capacity"
import { load_denominator, load_numerator } from "../const"
import probe from "./probe"

import type { U32Scratch } from "memory"
import type { Table } from "./probe"

export type Input = Table & {
    scratch: U32Scratch,
    count: u64,
    indexed: u64,
    required: u64,
    capacity: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { count, capacity, indexed, buckets, keys } = in

    const grow = in.required > capacity * load_numerator / load_denominator

    if (!grow && count == indexed) {
        return capacity
    }

    const size = match {
        grow => capacityFor(integers.narrow(in.required)).capacity,
        _ => capacity
    }

    if (grow) {
        memory.growU32Scratch(in.scratch, size, true)
        memory.clearU32Buffer(buckets, size)
    }

    const first = grow ? 0 : indexed

    const position = loop(first, {
        while: i => i < count,
        next: i => {
            const location = probe({
                buckets,
                keys,
                text: memory.readTextColumn(keys, i),
                capacity: size
            })
            memory.writeU32(buckets, location.slot, integers.narrow(i + 1))
            i += 1
        }
    })

    return size
}
