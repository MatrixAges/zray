import bind from "./bind"

import type { Read, Table } from "./model"

export type Input = Table & {
    previous: Read
}

export type Output = u32

export default function (in: Input): Output {
    const { previous, current, target } = in

    const initial: u32 = 0

    return loop({
        row: 0,
        count: initial
    }, {
        while: state => state.row < previous.keys.length,
        next: state => {
            const row = state.row
            const key = previous.keys[row]

            if (key != null) {
                const inserted = bind({
                    current,
                    target,
                    key,
                    value: previous.values[row]
                })

                if (inserted) {
                    state.count += 1
                }
            }

            state.row += 1
        },
        return: state => state.count
    })
}
