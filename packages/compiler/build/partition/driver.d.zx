export type PartitionHash = opaque

export type PartitionHashPrefix = {
    prefix: PartitionHash,
    executable: string,
    arguments: string[],
    types?: u64,
    signatures?: u64
}

export type PartitionMember = {
    partition: u32,
    row: u32
}

export type PartitionMemberRange = {
    prefix: PartitionHash,
    paths: string[],
    hashes: u64[],
    members: PartitionMember[],
    first: u64,
    end: u64
}

export type PartitionStateFile = {
    path: u8[],
    previous: u8[]
}

export type PartitionCompilation = {
    zig: string,
    pending: u32[],
    arguments: string[],
    indexed: u32[]
}

export declare function startPartitionHash(
    allocator,
    io,
    in: PartitionHashPrefix
): PartitionHash throws

export declare function hashExternalInput(
    allocator,
    io,
    prefix: PartitionHash,
    path: string
): PartitionHash throws

export declare function hashPartitionMembers(
    allocator,
    in: PartitionMemberRange
): u8[] throws

export declare function loadPartitionState(
    allocator,
    io,
    objects: string,
    state_file: string
): PartitionStateFile throws

export declare function partitionObjectPresent(io, path: string): bool

export declare function compilePartitionObjects(
    allocator,
    io,
    in: PartitionCompilation
): string?[] throws
