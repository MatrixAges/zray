<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Prepare} out={Request.Prepared} />

    <Call fn="packages" in={$in.packages} />

    <Call
        fn="catalog"
        in={{
            batches: $in.documents,
            packages: $ctx.packages
        }}
    />

    <Call
        module="../../collection/interface/register"
        in={{
            host: $in.host,
            declarations: $in.interfaces,
            sources: $ctx.catalog.sources
        }}
    />

    <Call
        module="../../fingerprint/frame"
        in={{
            generator: $in.generator,
            manifest: $in.manifest,
            modules: $ctx.catalog.modules,
            interfaces: $ctx.register.sources
        }}
    />

    <Call
        module="../../fingerprint/output"
        in={{
            frame: $ctx.frame.content,
            partitions: $in.partitions,
            sources: $ctx.catalog.sources,
            templates: $ctx.catalog.templates
        }}
    />

    <Return
        value={{
            external: $ctx.register.documents,
            catalog: $ctx.catalog,
            registered: $ctx.register.registered,
            fingerprints: {
                digest: $ctx.output,
                ...$ctx.frame
            }
        }}
    />
</Module>
