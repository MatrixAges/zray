<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Observe} out={Request.Observation} />

    <If on={$in.write}>
        <Loop on={$in.row < $in.roots.length}>
            <Call
                module="observe_root"
                in={{
                    roots: $in.roots,
                    row: 0,
                    observed: []
                }}
            />
        </Loop>

        <Call
            fn="host.readGenerationSnapshot"
            in={[
                $in.host,
                $ctx.observe_root.observed
            ]}
        />

        <Return value={$ctx.readGenerationSnapshot} />
    </If>

    <Return
        value={{
            enabled: false,
            snapshot: null,
            roots: [],
            digest: null
        }}
    />
</Module>
