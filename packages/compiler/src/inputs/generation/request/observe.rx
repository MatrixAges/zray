<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Observe} out={Request.Observation} />

    <If on={$in.write}>
        <Loop on={$in.row < $in.roots.length}>
            <Call
                module="observe_root"
                in={{
                    roots: $in.roots,
                    row: 0,
                    observed: []
                }}
            />
        </Loop>

        <Call
            fn="source_facts"
            in={{
                roots: $in.roots,
                observed: $ctx.observe_root.observed
            }}
        />

        <Call
            fn="interface_facts"
            in={{
                declarations: $in.interfaces,
                source: $ctx.source_facts
            }}
        />

        <If on={$ctx.interface_facts != null && $ctx.interface_facts.length != 0}>
            <Call
                fn="../../snapshot/records/target"
                in={{
                    cache: $in.cache,
                    cwd: $in.cwd,
                    generator: $in.generator,
                    manifest: $in.manifest,
                    partitions: $in.partitions,
                    facts: $ctx.interface_facts
                }}
            />

            <Call fn="../../snapshot/records/read_file" in={$ctx.target.path} />

            <Call
                module="../../snapshot/records/read"
                in={{
                    payload: $ctx.read_file,
                    context: $ctx.target.context,
                    observed: $ctx.target.facts,
                    now: $in.now
                }}
            />

            <Return
                value={{
                    enabled: true,
                    snapshot: $ctx.target,
                    roots: $ctx.observe_root.observed,
                    digest: $ctx.read
                }}
            />
        </If>

        <Return
            value={{
                enabled: true,
                snapshot: null,
                roots: $ctx.observe_root.observed,
                digest: null
            }}
        />
    </If>

    <Return
        value={{
            enabled: false,
            snapshot: null,
            roots: [],
            digest: null
        }}
    />
</Module>
