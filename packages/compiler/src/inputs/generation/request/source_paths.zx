import type { GenerationPath } from "generation_host"
import type { Collected } from "../../collection/directory/model"

export type Input = Collected

export type Output = GenerationPath[]

export default function (in: Input): Output {
    const { levels } = in

    if (levels.length == 1 && levels[0].length == 1) {
        return levels[0][0]
    }

    const paths: GenerationPath[] = []

    const found = loop({
        level: 0,
        batch: 0,
        row: 0,
        paths
    }, {
        while: state => state.level < levels.length,
        next: state => {
            const level = levels[state.level]
            const batch = level[state.batch]

            state.paths = state.paths.push(batch[state.row])[0]
            state.row += 1

            if (state.row == batch.length) {
                state.row = 0
                state.batch += 1

                if (state.batch == level.length) {
                    state.batch = 0
                    state.level += 1
                }
            }
        },
        return: state => state.paths
    })

    return found
}
