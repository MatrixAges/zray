<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={string} />

    <If on={$in.write}>
        <Call fn="host.observeGenerationInputs" in={$in.request} />

        <Call
            module="current"
            in={{
                stamp_path: $in.stamp_path,
                digest: $ctx.observeGenerationInputs
            }}
        />

        <If on={$ctx.current}>
            <Return value={""} />
        </If>
    </If>

    <Call
        module="load"
        in={{
            request: $in.request,
            roots: $in.roots,
            observed: $in.write
        }}
    />

    <Call module="prepare" in={$in} />

    <If on={$in.write}>
        <If on={$ctx.prepare.interfaces_loaded}>
            <Call
                module="current"
                in={{
                    stamp_path: $in.stamp_path,
                    digest: $ctx.prepare.digest
                }}
            />

            <If on={$ctx.current}>
                <Call fn="host.saveGenerationSnapshot" in={$in.request} />

                <Return value={""} />
            </If>
        </If>

        <Call fn="host.invalidateGenerationStamp" in={$in.stamp_path} />
    </If>

    <Call
        module="analyze"
        in={{
            request: $in.request,
            analysis_available: $ctx.prepare.analysis_available
        }}
    />

    <If on={$in.write}>
        <Call fn="../stamp" in={$ctx.prepare.digest} />

        <Call
            fn="host.writeGenerationStamp"
            in={[
                $in.stamp_path,
                $ctx.stamp
            ]}
        />

        <Call fn="host.saveGenerationSnapshot" in={$in.request} />
    </If>

    <Return value={$ctx.analyze} />
</Module>
