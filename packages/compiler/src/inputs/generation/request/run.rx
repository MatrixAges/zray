<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={Request.Summary} />

    <Call
        module="observe"
        in={{
            host: $in.host,
            write: $in.write
        }}
    />

    <If on={$in.write}>
        <Call
            module="current"
            in={{
                stamp_path: $in.stamp_path,
                digest: $ctx.observe.digest,
                enabled: true
            }}
        />

        <If on={$ctx.current}>
            <Return
                value={{
                    text: "",
                    failure: null
                }}
            />
        </If>
    </If>

    <Call
        module="load"
        in={{
            host: $in.host,
            roots: $in.roots,
            snapshot: $ctx.observe.snapshot
        }}
    />

    <Call
        module="prepare"
        in={{
            host: $in.host,
            documents: $ctx.load,
            packages: $in.packages
        }}
    />

    <Call
        module="current"
        in={{
            stamp_path: $in.stamp_path,
            digest: $ctx.prepare.fingerprints.digest,
            enabled:
                $ctx.observe.snapshot != null && $ctx.prepare.registered.failure == null
        }}
    />

    <Call
        module="refresh"
        in={{
            host: $in.host,
            ...$ctx.prepare,
            stamp_path: $in.stamp_path,
            observed: $ctx.observe.snapshot != null,
            current: $ctx.current
        }}
    />

    <If on={$ctx.refresh.failure == null && $ctx.observe.snapshot != null}>
        <Call
            fn="host.saveGenerationSnapshot"
            in={[
                $in.host,
                $ctx.observe.snapshot,
                $ctx.prepare.fingerprints.digest
            ]}
        />
    </If>

    <Return value={$ctx.refresh} />
</Module>
