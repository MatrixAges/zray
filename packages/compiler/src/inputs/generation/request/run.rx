<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={Request.Summary} />

    <Call
        module="observe"
        in={$in.pick([
            "write",
            "roots",
            "interfaces",
            "generator",
            "manifest",
            "partitions",
            "cache",
            "cwd",
            "now"
        ])}
    />

    <If on={$in.write}>
        <Call
            module="current"
            in={{
                stamp_path: $in.stamp_path,
                digest: $ctx.observe.digest,
                enabled: true
            }}
        />

        <If on={$ctx.current}>
            <Return
                value={{
                    text: "",
                    failure: null
                }}
            />
        </If>
    </If>

    <Call
        module="load"
        in={{
            host: $in.host,
            roots: $in.roots,
            observed: $ctx.observe
        }}
    />

    <Call
        module="prepare"
        in={{
            host: $in.host,
            documents: $ctx.load,
            packages: $in.packages,
            generator: $in.generator,
            manifest: $in.manifest,
            partitions: $in.partitions,
            interfaces: $in.interfaces
        }}
    />

    <Call
        module="current"
        in={{
            stamp_path: $in.stamp_path,
            digest: $ctx.prepare.fingerprints.digest,
            enabled:
                $ctx.observe.enabled && $ctx.prepare.registered.failure == null
        }}
    />

    <Call
        module="refresh"
        in={{
            host: $in.host,
            catalog: $ctx.prepare.catalog,
            registered: $ctx.prepare.registered,
            fingerprints: $ctx.prepare.fingerprints,
            stamp_path: $in.stamp_path,
            observed: $ctx.observe.enabled,
            current: $ctx.current
        }}
    />

    <If on={$ctx.refresh.failure == null && $ctx.observe.snapshot != null}>
        <Call
            module="../../snapshot/records/publish"
            in={{
                target: $ctx.observe.snapshot,
                digest: $ctx.prepare.fingerprints.digest,
                batches: $ctx.load,
                external: $ctx.prepare.external
            }}
        />
    </If>

    <Return value={$ctx.refresh} />
</Module>
