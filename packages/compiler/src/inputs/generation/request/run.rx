<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={string} />

    <If on={$in.write}>
        <Call fn="host.observeGenerationInputs" in={$in.request} />

        <Call
            fn="current"
            in={{
                request: $in.request,
                digest: $ctx.observeGenerationInputs
            }}
        />

        <If on={$ctx.current}>
            <Return value={""} />
        </If>
    </If>

    <Call
        module="load"
        in={{
            request: $in.request,
            roots: $in.roots,
            observed: $in.write
        }}
    />

    <Call module="prepare" in={$in} />

    <If on={$in.write}>
        <If on={$ctx.prepare.interfaces_loaded}>
            <Call
                fn="current"
                in={{
                    request: $in.request,
                    digest: $ctx.prepare.digest
                }}
            />

            <If on={$ctx.current}>
                <Call fn="host.saveGenerationSnapshot" in={$in.request} />

                <Return value={""} />
            </If>
        </If>

        <Call fn="host.invalidateGenerationStamp" in={$in.request} />
    </If>

    <Call
        module="analyze"
        in={{
            request: $in.request,
            analysis_available: $ctx.prepare.analysis_available
        }}
    />

    <If on={$in.write}>
        <Call fn="host.writeGenerationStamp" in={$in.request} />
        <Call fn="host.saveGenerationSnapshot" in={$in.request} />
    </If>

    <Return value={$ctx.analyze} />
</Module>
