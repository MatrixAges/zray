<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={Request.Summary} />

    <Call
        module="observe"
        in={{
            host: $in.host,
            write: $in.write
        }}
    />

    <If on={$in.write}>
        <Call
            module="current"
            in={{
                stamp_path: $in.stamp_path,
                digest: $ctx.observe.digest
            }}
        />

        <If on={$ctx.current}>
            <Return
                value={{
                    text: "",
                    failure: null
                }}
            />
        </If>
    </If>

    <Call
        module="load"
        in={{
            host: $in.host,
            roots: $in.roots,
            snapshot: $ctx.observe.snapshot
        }}
    />

    <Call
        module="prepare"
        in={{
            host: $in.host,
            documents: $ctx.load
        }}
    />

    <If on={$ctx.observe.snapshot != null}>
        <If on={$ctx.prepare.registered.failure == null}>
            <Call
                module="current"
                in={{
                    stamp_path: $in.stamp_path,
                    digest: $ctx.prepare.fingerprints.digest
                }}
            />

            <If on={$ctx.current}>
                <Call
                    fn="host.saveGenerationSnapshot"
                    in={[
                        $in.host,
                        $ctx.observe.snapshot,
                        $ctx.prepare.fingerprints.digest
                    ]}
                />

                <Return
                    value={{
                        text: "",
                        failure: null
                    }}
                />
            </If>
        </If>

        <Call fn="host.invalidateGenerationStamp" in={$in.stamp_path} />
    </If>

    <Call
        module="analyze"
        in={{
            host: $in.host,
            ...$ctx.prepare
        }}
    />

    <If on={$ctx.analyze.failure != null}>
        <Return value={$ctx.analyze} />
    </If>

    <If on={$ctx.observe.snapshot != null}>
        <Call fn="../stamp" in={$ctx.prepare.fingerprints.digest} />

        <Call
            fn="host.writeGenerationStamp"
            in={[
                $in.stamp_path,
                $ctx.stamp
            ]}
        />

        <Call
            fn="host.saveGenerationSnapshot"
            in={[
                $in.host,
                $ctx.observe.snapshot,
                $ctx.prepare.fingerprints.digest
            ]}
        />
    </If>

    <Return value={$ctx.analyze} />
</Module>
