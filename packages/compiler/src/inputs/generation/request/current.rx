<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Current} out={bool} />

    <If on={$in.enabled && $in.digest != null}>
        <Call fn="stamp_prefix" in={$in.stamp_path} />

        <Call fn="filesystem.readFilePrefix" />

        <Call
            fn="current"
            in={{
                digest: $in.digest,
                stamp: $ctx.readFilePrefix
            }}
        />

        <Return value={$ctx.current} />
    </If>

    <Return value={false} />
</Module>
