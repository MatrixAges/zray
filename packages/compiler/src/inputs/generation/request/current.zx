import bytes from "std:bytes"
import integers from "std:integer"
import { hexadecimal_radix } from "core/const"
import { hexadecimal_digits } from "genz/const"

import { stamp_digits_per_byte, stamp_width } from "../const"

export type Input = {
    digest: u8[],
    stamp?: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    const { digest, stamp } = in

    if (stamp == null || stamp.length != stamp_width) {
        return false
    }

    const digits = bytes.fromText(hexadecimal_digits)

    return loop({
        row: 0,
        matches: true
    }, {
        while: state => state.matches && state.row < digest.length,
        next: state => {
            const value = integers.widenByte(digest[state.row])
            const offset = state.row * stamp_digits_per_byte
            const high = digits[value / hexadecimal_radix]
            const low = digits[value % hexadecimal_radix]

            state.matches = stamp[offset] == high && stamp[offset + 1] == low
            state.row += 1
        },
        return: state => state.matches
    })
}
