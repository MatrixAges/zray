import bytes from "std:bytes"
import host from "generation_host"

import { stamp_width } from "../const"

import type { GenerationRequest } from "generation_host"

export type Input = {
    request: GenerationRequest,
    digest?: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    const { request, digest } = in

    if (digest == null) {
        return false
    }

    const stamp = host.readGenerationStamp(request)

    if (stamp == null) {
        return false
    }

    return stamp.length == stamp_width && bytes.equals(
        stamp,
        host.formatGenerationStamp(request, digest)
    )
}
