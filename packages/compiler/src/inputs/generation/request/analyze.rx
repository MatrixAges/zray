<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Analyze} out={Request.Summary} />

    <If on={$in.registered.failure == null}>
        <Call
            fn="host.restoreGenerationAnalysis"
            in={[
                $in.host,
                $in.fingerprints.digest
            ]}
        />

        <If on={$ctx.restoreGenerationAnalysis != null}>
            <Return
                value={{
                    text: $ctx.restoreGenerationAnalysis,
                    failure: null
                }}
            />
        </If>
    </If>

    <Call
        fn="host.prepareGenerationTemplates"
        in={[
            $in.host,
            $in.catalog
        ]}
    />

    <Call
        fn="host.prepareGenerationModules"
        in={[
            $in.host,
            $in.catalog
        ]}
    />

    <If on={$in.registered.failure != null}>
        <Return
            value={{
                text: null,
                failure: $in.registered.failure
            }}
        />
    </If>

    <Call
        fn="host.generateFromPreparedInputs"
        in={[
            $in.host,
            $in.fingerprints,
            $in.registered,
            $ctx.prepareGenerationTemplates,
            $ctx.prepareGenerationModules
        ]}
    />

    <Return
        value={{
            text: $ctx.generateFromPreparedInputs,
            failure: null
        }}
    />
</Module>
