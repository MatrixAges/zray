<Module>
    <Type from="model" as="Request" />

    <Args in={Request.LoadStep} out={Request.LoadStep} />

    <Store from="documents" as="documents" />

    <Call module="root_paths" in={$in} />

    <Call
        module="read"
        in={[
            $in.load.host,
            {
                root: $in.load.roots[$in.row].path,
                files: $ctx.root_paths,
                optional: false
            }
        ]}
    />

    <Call
        fn="append_documents"
        in={{
            loaded: $store.documents.loaded,
            batch: $ctx.read.documents,
            row: $in.row
        }}
        setter={[$store.documents.loaded]}
    />

    <Return
        value={{
            load: $in.load,
            row: $ctx.append_documents
        }}
    />
</Module>
