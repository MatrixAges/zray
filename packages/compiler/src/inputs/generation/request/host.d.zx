export type GenerationIO = opaque
export type GenerationArtifact = opaque

export type GenerationObservation = {
    snapshot?: GenerationArtifact,
    digest?: u8[]
}

export type GenerationRegistration = {
    bindings: GenerationArtifact,
    failure?: u16
}

export type PreparedGeneration = {
    digest: u8[],
    fingerprints: GenerationArtifact,
    previous?: GenerationArtifact
}

export type DirectoryListing = {
    directories: string[][],
    files: u8[][]
}

export declare function observeGenerationInputs(
    allocator,
    io,
    host: GenerationIO
): GenerationObservation throws { GenerationRequestFailed }

export declare function loadGenerationRoot(
    io,
    host: GenerationIO,
    root: u64,
    snapshot: GenerationArtifact?
): u8[] throws { GenerationRequestFailed }

export declare function retainGenerationPackages(host: GenerationIO): GenerationArtifact
    throws { GenerationRequestFailed }

export declare function classifyGenerationDocuments(
    allocator,
    host: GenerationIO,
    documents: u8[][],
    packages: GenerationArtifact
): GenerationArtifact throws { GenerationRequestFailed }

export declare function registerGenerationInterfaces(
    allocator,
    io,
    host: GenerationIO,
    catalog: GenerationArtifact
): GenerationRegistration throws { GenerationRequestFailed }

export declare function fingerprintGenerationInputs(
    allocator,
    host: GenerationIO,
    catalog: GenerationArtifact,
    bindings: GenerationArtifact,
    interfaces_loaded: bool
): PreparedGeneration throws { GenerationRequestFailed }

export declare function readGenerationStamp(allocator, io, path: string): u8[]? throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, ConnectionResetByPeer,
    DeviceBusy, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput, IsDir,
    LockViolation, NameTooLong, NetworkNotFound, NoDevice, NoSpaceLeft, NotDir,
    NotOpenForReading, OutOfMemory, PathAlreadyExists, PermissionDenied, PipeBusy,
    ProcessFdQuotaExceeded, ReadOnlyFileSystem, SocketUnconnected, SymLinkLoop,
    SystemFdQuotaExceeded, SystemResources, Unexpected, WouldBlock
}

export declare function invalidateGenerationStamp(io, path: string): void throws {
    AccessDenied, BadPathName, Canceled, FileBusy, FileNotFound, FileSystem, IsDir,
    NameTooLong, NetworkNotFound, NotDir, PermissionDenied, ReadOnlyFileSystem, SymLinkLoop,
    SystemResources, Unexpected
}

export declare function writeGenerationStamp(io, path: string, stamp: string): void throws {
    AccessDenied, AntivirusInterference, BadPathName, BrokenPipe, Canceled, DeviceBusy,
    DiskQuota, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput, IsDir,
    LockViolation, NameTooLong, NetworkNotFound, NoDevice, NoSpaceLeft, NotDir,
    NotOpenForWriting, PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded,
    ReadOnlyFileSystem, SymLinkLoop, SystemFdQuotaExceeded, SystemResources, Unexpected,
    WouldBlock
}

export declare function restoreGenerationAnalysis(
    io,
    host: GenerationIO,
    previous: GenerationArtifact
): string throws { GenerationRequestFailed }

export declare function prepareGenerationTemplates(
    allocator,
    host: GenerationIO,
    catalog: GenerationArtifact
): GenerationArtifact throws { GenerationRequestFailed }

export declare function prepareGenerationModules(
    allocator,
    host: GenerationIO,
    catalog: GenerationArtifact,
    packages: GenerationArtifact
): GenerationArtifact throws { GenerationRequestFailed }

export declare function generateFromPreparedInputs(
    io,
    host: GenerationIO,
    fingerprints: GenerationArtifact,
    packages: GenerationArtifact,
    bindings: GenerationArtifact,
    sources: GenerationArtifact,
    modules: GenerationArtifact
): string throws { GenerationRequestFailed }

export declare function saveGenerationSnapshot(
    io,
    host: GenerationIO,
    snapshot: GenerationArtifact,
    digest: u8[]
): void throws { GenerationRequestFailed }

export declare function listGenerationLevel(
    allocator,
    io,
    reader: GenerationIO,
    parents: string[],
    copy_paths: bool
): DirectoryListing throws { GenerationRequestFailed, OutOfMemory }
