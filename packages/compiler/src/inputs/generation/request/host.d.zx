export type GenerationIO = opaque
export type GenerationArtifact = opaque

export type GenerationPackage = {
    specifier: string,
    entry: string
}

export type GenerationDigest = {
    path: string,
    digest: u8[]
}

export type GenerationVersion = {
    inode: u64,
    size: u64,
    mtime_low: u64,
    ctime_low: u64,
    read_low: u64,
    mtime_high: i32,
    ctime_high: i32,
    read_high: i32
}

export type GenerationDocument = {
    path: string,
    source: string,
    digest: u8[],
    version?: GenerationVersion
}

export type GenerationCatalog = {
    sources: GenerationDocument[],
    modules: GenerationDocument[],
    templates: GenerationDocument[],
    packages: GenerationPackage[]
}

export type GenerationRoot = {
    path: string,
    prefix: string
}

export type GenerationTime = {
    high: i32,
    low: u64
}

export type GenerationPath = {
    path: string,
    relative: string,
    retain: bool,
    inode?: u64,
    size?: u64,
    mtime_ns?: GenerationTime,
    ctime_ns?: GenerationTime
}

export type GenerationObservedRoot = {
    files: GenerationPath[]
}

export type GenerationRead = {
    root?: string,
    files: GenerationPath[],
    optional: bool
}

export type GenerationReadResult = {
    documents: GenerationDocument[],
    failure?: u16
}

export type GenerationInterface = {
    specifier?: string,
    path: string,
    module: string,
    resolve_members: bool
}

export type GenerationBinding = {
    name: string,
    path: string,
    module: string,
    source: string,
    resolve_members: bool
}

export type GenerationRegistration = {
    bindings: GenerationBinding[],
    external: u64,
    failure?: u16
}

export type PreparedGeneration = {
    digest: u8[],
    content: u8[],
    shape: u8[],
    digests: GenerationDigest[]
}

export declare function readGenerationFiles(
    allocator,
    io,
    host: GenerationIO,
    input: GenerationRead
): GenerationReadResult throws { GenerationRequestFailed }

export declare function restoreGenerationAnalysis(
    io,
    host: GenerationIO,
    digest: u8[]
): string? throws { GenerationRequestFailed }

export declare function prepareGenerationTemplates(
    allocator,
    host: GenerationIO,
    catalog: GenerationCatalog
): GenerationArtifact throws { GenerationRequestFailed }

export declare function prepareGenerationModules(
    allocator,
    host: GenerationIO,
    catalog: GenerationCatalog
): GenerationArtifact throws { GenerationRequestFailed }

export declare function generateFromPreparedInputs(
    io,
    host: GenerationIO,
    fingerprints: PreparedGeneration,
    bindings: GenerationRegistration,
    sources: GenerationArtifact,
    modules: GenerationArtifact
): string throws { GenerationRequestFailed }
