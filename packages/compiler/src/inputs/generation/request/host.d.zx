export type GenerationRequest = opaque

export type PreparedGeneration = {
    digest: u8[],
    interfaces_loaded: bool
}

export type GenerationFileCache = opaque

export type SnapshotVersions = opaque

export type SnapshotVersion = {
    inode: u64,
    size: u64,
    mtime_low: u64,
    ctime_low: u64,
    read_low: u64,
    mtime_high: i32,
    ctime_high: i32,
    read_high: i32
}

export type InterfaceLoader = opaque

export type NativeBinding = {
    index: u64,
    name: string,
    path: string,
    module: string,
    source: string,
    resolve_members: bool
}

export type DirectoryScan = opaque

export type DocumentReader = opaque

export type InterfaceObservations = opaque

export declare function observeGenerationInputs(request: GenerationRequest): u8[]?
    throws { GenerationRequestFailed }

export declare function loadGenerationRoot(
    request: GenerationRequest,
    root: u64,
    observed: bool
): void throws { GenerationRequestFailed }

export declare function retainGenerationPackages(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function classifyGenerationDocuments(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function registerGenerationInterfaces(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function fingerprintGenerationInputs(
    request: GenerationRequest
): PreparedGeneration throws { GenerationRequestFailed }

export declare function readGenerationStamp(request: GenerationRequest): u8[]?
    throws { GenerationRequestFailed }

export declare function invalidateGenerationStamp(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function lookupGenerationAnalysis(request: GenerationRequest): bool

export declare function restoreGenerationAnalysis(request: GenerationRequest): string
    throws { GenerationRequestFailed }

export declare function prepareGenerationTemplates(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function prepareGenerationModules(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function checkGenerationInterfaces(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function generateFromPreparedInputs(request: GenerationRequest): string
    throws { GenerationRequestFailed }

export declare function writeGenerationStamp(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function saveGenerationSnapshot(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function readGenerationFileDigest(
    cache: GenerationFileCache,
    key: string,
    source: string
): u8[]

export declare function readSnapshotVersion(
    cache: SnapshotVersions,
    key: string
): SnapshotVersion?

export declare function loadNativeText(loader: InterfaceLoader, path: string): string
    throws { OutOfMemory }

export declare function writeNativeBinding(loader: InterfaceLoader, input: NativeBinding): void
    throws { OutOfMemory }

export declare function listGenerationLevel(
    scan: DirectoryScan,
    directories: string[]
): bool throws { GenerationRequestFailed }

export declare function reserveGenerationFiles(scan: DirectoryScan, count: u64): void
    throws { OutOfMemory }

export declare function retireGenerationLevel(scan: DirectoryScan, frontier: u8): void

export declare function readGenerationDocument(
    reader: DocumentReader,
    relative: string,
    path: string,
    retain: bool
): string throws { GenerationRequestFailed }

export declare function recordInputInterface(
    target: InterfaceObservations,
    path: string,
    matching: u64?
): bool throws { OutOfMemory }

export declare function selectGenerationAllocator(scan: DirectoryScan, frontier: u8?): void
