export type GenerationRequest = mutable_opaque

export type PreparedGeneration = {
    digest: u8[],
    interfaces_loaded: bool,
    analysis_available: bool
}

export type DirectoryScan = mutable_opaque

export declare function observeGenerationInputs(request: GenerationRequest): u8[]?
    throws { GenerationRequestFailed }

export declare function loadGenerationRoot(
    request: GenerationRequest,
    root: u64,
    observed: bool
): void throws { GenerationRequestFailed }

export declare function retainGenerationPackages(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function classifyGenerationDocuments(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function registerGenerationInterfaces(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function fingerprintGenerationInputs(
    request: GenerationRequest
): PreparedGeneration throws { GenerationRequestFailed }

export declare function readGenerationStamp(allocator, io, path: string): u8[]? throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, ConnectionResetByPeer,
    DeviceBusy, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput, IsDir,
    LockViolation, NameTooLong, NetworkNotFound, NoDevice, NoSpaceLeft, NotDir,
    NotOpenForReading, OutOfMemory, PathAlreadyExists, PermissionDenied, PipeBusy,
    ProcessFdQuotaExceeded, ReadOnlyFileSystem, SocketUnconnected, SymLinkLoop,
    SystemFdQuotaExceeded, SystemResources, Unexpected, WouldBlock
}

export declare function invalidateGenerationStamp(io, path: string): void throws {
    AccessDenied, BadPathName, Canceled, FileBusy, FileNotFound, FileSystem, IsDir,
    NameTooLong, NetworkNotFound, NotDir, PermissionDenied, ReadOnlyFileSystem, SymLinkLoop,
    SystemResources, Unexpected
}

export declare function restoreGenerationAnalysis(request: GenerationRequest): string
    throws { GenerationRequestFailed }

export declare function prepareGenerationTemplates(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function prepareGenerationModules(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function generateFromPreparedInputs(request: GenerationRequest): string
    throws { GenerationRequestFailed }

export declare function writeGenerationStamp(io, path: string, stamp: string): void throws {
    AccessDenied, AntivirusInterference, BadPathName, BrokenPipe, Canceled, DeviceBusy,
    DiskQuota, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput, IsDir,
    LockViolation, NameTooLong, NetworkNotFound, NoDevice, NoSpaceLeft, NotDir,
    NotOpenForWriting, PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded,
    ReadOnlyFileSystem, SymLinkLoop, SystemFdQuotaExceeded, SystemResources, Unexpected,
    WouldBlock
}

export declare function saveGenerationSnapshot(request: GenerationRequest): void
    throws { GenerationRequestFailed }

export declare function listGenerationLevel(
    scan: DirectoryScan,
    directories: string[]
): bool throws { GenerationRequestFailed }

export declare function commitGenerationFiles(
    scan: DirectoryScan,
    records: u8[][],
    paths: string[],
    copy_paths: bool
): void throws { OutOfMemory }

export declare function retireGenerationLevel(scan: DirectoryScan, frontier: u8): void

export declare function selectGenerationAllocator(scan: DirectoryScan, frontier: u8?): void
