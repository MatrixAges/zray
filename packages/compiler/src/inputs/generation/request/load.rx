<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Load} out={u8[][]} />

    <Store from="documents" as="documents" />

    <Loop on={$in.row < $in.load.roots}>
        <Call
            module="load_next"
            in={{
                load: $in,
                row: 0
            }}
        />
    </Loop>

    <Call fn="read_documents" in={$store.documents.loaded} />

    <Return value={$ctx.read_documents} />
</Module>
