import strings from "std:string"
import memory from "memory"

import type { TextColumn } from "memory"

export type Fields = {
    specifiers: TextColumn,
    entries: TextColumn,
    count: u64
}

export type Package = {
    specifier: string,
    entry: string
}

export type Input = {
    fields: Fields,
    retain: bool
}

export type Output = Package[]

export default function (in: Input): Output {
    const { fields, retain } = in

    const empty: Package[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < fields.count,
        next: state => {
            const row = state.row
            const name = memory.readTextColumn(fields.specifiers, row)
            const entry = memory.readTextColumn(fields.entries, row)

            state.items = state.items.push({
                specifier: retain ? strings.copy(name) : name,
                entry: retain ? strings.copy(entry) : entry
            })[0]

            state.row += 1
        },
        return: state => state.items
    })
}
