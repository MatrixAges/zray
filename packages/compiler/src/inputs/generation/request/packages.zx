import memory from "memory"

import type { TextColumn } from "memory"

export type Fields = {
    specifiers: TextColumn,
    entries: TextColumn,
    count: u64
}

export type Package = {
    specifier: string,
    entry: string
}

export type Input = Fields

export type Output = Package[]

export default function (in: Input): Output {
    const fields = in

    const empty: Package[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < fields.count,
        next: state => {
            const row = state.row
            const specifier = memory.readTextColumn(fields.specifiers, row)
            const entry = memory.readTextColumn(fields.entries, row)

            state.items = state.items.push({
                specifier,
                entry
            })[0]

            state.row += 1
        },
        return: state => state.items
    })
}
