import type {
    GenerationCatalog,
    GenerationInterface,
    GenerationIO,
    GenerationObservedRoot,
    GenerationRoot,
    GenerationRegistration,
    PreparedGeneration
} from "generation_host"
import type { Document } from "../../fingerprint/model"
import type { Time } from "../../snapshot/age"
import type { Snapshot } from "../../snapshot/records/model"
import type { Fields as PackageFields } from "./packages"

export type Input = {
    host: GenerationIO,
    write: bool,
    stamp_path: string,
    roots: GenerationRoot[],
    interfaces: GenerationInterface[],
    packages: PackageFields,
    generator: u8[],
    manifest: string,
    partitions: u32,
    cache: string,
    cwd: string,
    now: Time
}

export type Current = {
    stamp_path: string,
    enabled: bool,
    digest?: u8[]
}

export type Root = GenerationRoot

export type Observe =
    Input.Pick(
        "write",
        "roots",
        "interfaces",
        "generator",
        "manifest",
        "partitions",
        "cache",
        "cwd",
        "now"
    )

export type ObserveStep = {
    roots: GenerationRoot[],
    row: u64,
    observed: GenerationObservedRoot[]
}

export type Observation = {
    enabled: bool,
    snapshot?: Snapshot,
    roots: GenerationObservedRoot[],
    digest?: u8[]
}

export type Summary = {
    text?: string,
    failure?: u16
}

export type Analysis = {
    catalog: GenerationCatalog,
    registered: GenerationRegistration,
    fingerprints: PreparedGeneration
}

export type Prepared = Analysis & {
    external: Document[]
}

export type Analyze = Analysis & {
    host: GenerationIO
}

export type Refresh = Analyze & {
    stamp_path: string,
    observed: bool,
    current: bool
}

export type Load = Input.Pick("host", "roots") & {
    observed: Observation
}

export type LoadStep = {
    load: Load,
    row: u64
}

export type Prepare =
    Input.Pick(
        "host",
        "packages",
        "generator",
        "manifest",
        "partitions",
        "interfaces"
    ) & {
        documents: Document[][]
    }
