import type {
    GenerationArtifact,
    GenerationIO,
    GenerationObservation,
    GenerationRegistration,
    PreparedGeneration
} from "generation_host"

export type Input = {
    host: GenerationIO,
    write: bool,
    stamp_path: string,
    roots: u64
}

export type Current = {
    stamp_path: string,
    digest?: u8[]
}

export type Observe = Input.Pick("host", "write")

export type Observation = GenerationObservation

export type Summary = {
    text?: string,
    failure?: u16
}

export type Prepared = {
    packages: GenerationArtifact,
    catalog: GenerationArtifact,
    registered: GenerationRegistration,
    fingerprints: PreparedGeneration
}

export type Analyze = Prepared & {
    host: GenerationIO
}

export type Load = Input.Pick("host", "roots") & {
    snapshot?: GenerationArtifact
}

export type LoadStep = {
    load: Load,
    row: u64
}

export type Prepare = {
    host: GenerationIO,
    documents: u8[][]
}
