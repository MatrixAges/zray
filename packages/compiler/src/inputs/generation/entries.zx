import memory from "memory"

import type { TextColumn } from "memory"

export type Row = {
    path: string,
    name: string
}

export type Input = {
    paths: TextColumn,
    names: TextColumn,
    count: u64
}

export type Output = Row[]

export default function (in: Input): Output {
    const empty: Row[] = []

    return loop({
        index: 0,
        rows: empty
    }, {
        while: state => state.index < in.count,
        next: state => {
            const path = memory.readTextColumn(in.paths, state.index)
            const name = memory.readTextColumn(in.names, state.index)

            state.rows = state.rows.push({
                path,
                name
            })[0]
            state.index += 1
        },
        return: state => state.rows
    })
}
