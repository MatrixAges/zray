import bytes from "std:bytes"
import memory from "memory"

import type { TextColumn, WriteColumn } from "memory"

export type Input = {
    paths: TextColumn,
    names: TextColumn,
    roots: WriteColumn,
    export_paths: WriteColumn,
    export_names: WriteColumn,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const written = loop(0, {
        while: index => index < in.count,
        next: index => {
            const path = bytes.fromText(memory.readTextColumn(in.paths, index))
            const name = bytes.fromText(memory.readTextColumn(in.names, index))

            memory.writeColumnBytes(in.roots, index, path)
            memory.writeColumnBytes(in.export_paths, index, path)
            memory.writeColumnBytes(in.export_names, index, name)

            index += 1
        }
    })
}
