import bytes from "std:bytes"

import { infer_prefix, emit_prefix, write_prefix, duration_suffix } from "../const"

import type { Writer } from "std:bytes"
import type { Durations } from "./model"

export type Input = {
    out: Writer,
    durations: Durations
}

export type Output = void

export default function (in: Input): Output {
    const { out, durations } = in

    bytes.write(out, bytes.fromText(infer_prefix))
    bytes.writeDecimalU64(out, durations.infer)
    bytes.write(out, bytes.fromText(emit_prefix))
    bytes.writeDecimalU64(out, durations.emit)
    bytes.write(out, bytes.fromText(write_prefix))
    bytes.writeDecimalU64(out, durations.write)
    bytes.write(out, bytes.fromText(duration_suffix))
}
