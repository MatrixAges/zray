import { bodies_only_suffix } from "../const"

import type { Counts } from "./model"

export type Input = Counts

export type Output = string

export default function (in: Input): Output {
    const { entries, analyzed, reused, files, generated, cached } = in

    const suffix = in.bodies_only ? bodies_only_suffix : ""

    return templateFile("./counts.tpl")
}
