<Module>
    <Type from="model" as="Report" />

    <Args in={Report.Report} out={string} />

    <Call fn="counts" in={$in.counts} />
    <Call fn="durations" in={$in.durations} />

    <Call
        fn="join"
        in={{
            counts: $ctx.counts,
            durations: $ctx.durations
        }}
    />

    <Return value={$ctx.join} />
</Module>
