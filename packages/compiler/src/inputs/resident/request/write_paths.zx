import bytes from "std:bytes"

import writeText from "../write_text"

import type { Paths as Input } from "../model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        writeText(in.cwd),
        writeText(in.manifest),
        writeText(in.output),
        writeText(in.cache),
        bytes.encodeU32Le(in.partitions)
    ])
}
