import memory from "memory"

import type { Identity as Output, RequestFrame } from "../model"

export type Input = RequestFrame.Pick("identity", "path")

export default function (in: Input): Output {
    const { identity, path } = in

    return {
        size: memory.readU64Bytes(identity, 0, true),
        mtime_low: memory.readU64Bytes(identity, 8, true),
        mtime_high: memory.readU64Bytes(identity, 16, true),
        path
    }
}
