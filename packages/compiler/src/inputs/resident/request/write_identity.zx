import bytes from "std:bytes"

import writeText from "../write_text"

import type { Header as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { writer, size, mtime_low, mtime_high } = in

    bytes.writeU64Le(writer, size)
    bytes.writeU64Le(writer, mtime_low)
    bytes.writeU64Le(writer, mtime_high)

    writeText({
        writer,
        value: in.path
    })
}
