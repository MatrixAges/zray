import bytes from "std:bytes"

import writeText from "../write_text"

import type { Identity as Input } from "../model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        bytes.encodeU64Le(in.size),
        bytes.encodeU64Le(in.mtime_low),
        bytes.encodeU64Le(in.mtime_high),
        writeText(in.path)
    ])
}
