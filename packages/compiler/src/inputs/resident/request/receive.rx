<Module>
    <Type from="../model" as="Protocol" />

    <Args in={Protocol.RequestFrame} out={Protocol.Request} />

    <Call
        fn="read_identity"
        in={$in.pick([
            "identity",
            "path"
        ])}
    />

    <Call
        fn="read_paths"
        in={$in.omit([
            "identity",
            "path"
        ])}
    />

    <Return
        value={{
            ...$ctx.read_identity,
            ...$ctx.read_paths
        }}
    />
</Module>
