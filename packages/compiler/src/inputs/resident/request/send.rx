<Module>
    <Type from="../model" as="Protocol" />

    <Args in={Protocol.Request} out={u8[]} />

    <Call
        fn="write_identity"
        in={$in.pick([
            "size",
            "mtime_low",
            "mtime_high",
            "path"
        ])}
    />

    <Call
        fn="write_paths"
        in={$in.pick([
            "cwd",
            "manifest",
            "output",
            "cache",
            "partitions"
        ])}
    />

    <Call
        fn="../join"
        in={{
            head: $ctx.write_identity,
            tail: $ctx.write_paths
        }}
    />

    <Return value={$ctx.join} />
</Module>
