export enum Command {
    Missing,
    Unknown,
    Incomplete,
    StandardAbi,
    Manifest,
    Partitioned,
    Serve,
    Warm
}

export type Arguments = {
    count: u64,
    command: string,
    option: string
}

export enum Status {
    Done,
    Failed,
    Stale,
    Declined
}

export type Identity = {
    size: u64,
    mtime_low: u64,
    mtime_high: u64,
    path: string
}

export type Paths = {
    cwd: string,
    manifest: string,
    output: string,
    cache: string,
    partitions: u32
}

export type Request = Identity & Paths

export type RequestFrame = Request.Omit(
    "size",
    "mtime_low",
    "mtime_high",
    "partitions"
) & {
    identity: u8[],
    options: u8[]
}

export type ReplyFrame = {
    known: bool,
    accepted: bool
}

export type Admission = {
    own: Identity,
    caller: Identity,
    cwd: string,
    here: string
}

export type Reply = {
    status: Status,
    summary: string
}

export type Parts = {
    head: u8[],
    tail: u8[]
}

export type Idle = {
    last: u64,
    now: u64
}
