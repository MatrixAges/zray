import { done_code, failed_code, stale_code, declined_code } from "../const"

import type { ReplyFrame as Output } from "../model"

export type Input = u8

export default function (in: Input): Output {
    const known = match in {
        done_code => true,
        failed_code => true,
        stale_code => true,
        declined_code => true,
        _ => false
    }

    return {
        known,
        accepted: in == done_code
    }
}
