<Module>
    <Type from="../model" as="Protocol" />

    <Args in={Protocol.Reply} out={u8[]} />

    <Call fn="write_status" in={$in.status} />
    <Call fn="../write_text" in={$in.summary} />

    <Call
        fn="../join"
        in={{
            head: $ctx.write_status,
            tail: $ctx.write_text
        }}
    />

    <Return value={$ctx.join} />
</Module>
