import bytes from "std:bytes"

import { declined_code, done_code, failed_code, stale_code } from "../const"
import { Status } from "../model"

export type Input = Status

export type Output = u8[]

export default function (in: Input): Output {
    const code = match in {
        Status.Done => done_code,
        Status.Failed => failed_code,
        Status.Stale => stale_code,
        _ => declined_code
    }

    return bytes.repeat(1, code)
}
