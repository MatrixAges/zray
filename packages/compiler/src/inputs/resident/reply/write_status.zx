import bytes from "std:bytes"

import { done_code, failed_code, stale_code, declined_code } from "../const"
import { Status } from "../model"

import type { Reply } from "../model"

export type Input = Reply.Pick("writer", "status")

export type Output = void

export default function (in: Input): Output {
    const code = match in.status {
        Status.Done => done_code,
        Status.Failed => failed_code,
        Status.Stale => stale_code,
        _ => declined_code
    }

    bytes.writeByte(in.writer, code)
}
