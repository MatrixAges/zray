import bytes from "std:bytes"
import { readGenerationFileDigest } from "generation_host"
import memory from "memory"

import type { DigestRow, ModulePair as Output } from "./model"
import type { ModuleRows as Input } from "./output_shape"

export default function (in: Input): Output {
    const { cache, rows } = in

    const frame_parts: u8[][] = []
    const shape_parts: u8[][] = []
    const digests: DigestRow[] = []

    const collected = loop({
        position: 0,
        frame_parts,
        shape_parts,
        digests
    }, {
        while: state => state.position < rows.count,
        next: state => {
            const position = state.position
            const path = memory.readTextColumn(rows.paths, position)
            const source = memory.readTextColumn(rows.sources, position)
            const digest = readGenerationFileDigest(cache, path, source)
            const path_bytes = bytes.fromText(path)
            const path_len = bytes.encodeU64Le(path_bytes.length)

            const shape_row = bytes.join(bytes.fromText(""), [
                path_len,
                path_bytes
            ])

            const frame_row = bytes.join(bytes.fromText(""), [
                shape_row,
                digest
            ])

            state.frame_parts = state.frame_parts.push(frame_row)[0]
            state.shape_parts = state.shape_parts.push(shape_row)[0]
            state.digests = state.digests.push({
                path,
                digest
            })[0]

            state.position += 1
        },
        return: state => state
    })

    return {
        frame: bytes.join(bytes.fromText(""), collected.frame_parts),
        shape: bytes.join(bytes.fromText(""), collected.shape_parts),
        digests: collected.digests
    }
}
