import bytes from "std:bytes"
import field from "core/ir/fingerprint/text"
import { readGenerationFileDigest } from "generation_host"
import memory from "memory"

import type { OutputFingerprint, SourceRows } from "./output_shape"

export type Input = OutputFingerprint.Pick("out", "cache") & {
    rows: SourceRows
}

export type Output = void

export default function (in: Input): Output {
    const { out, cache, rows } = in

    const written = loop(0, {
        while: position => position < rows.count,
        next: position => {
            const path = memory.readTextColumn(rows.paths, position)
            const source = memory.readTextColumn(rows.sources, position)

            field({
                out,
                text: path
            })

            bytes.write(out, readGenerationFileDigest(cache, path, source))

            position += 1
        }
    })
}
