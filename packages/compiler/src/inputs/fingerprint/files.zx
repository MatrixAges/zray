import bytes from "std:bytes"
import { readGenerationFileDigest } from "generation_host"
import memory from "memory"

import type { GenerationFileCache } from "generation_host"
import type { SourceRows } from "./output_shape"

export type Input = {
    cache: GenerationFileCache,
    rows: SourceRows
}

export type Output = u8[]

export default function (in: Input): Output {
    const { cache, rows } = in

    const parts: u8[][] = []

    const collected = loop({
        position: 0,
        parts
    }, {
        while: state => state.position < rows.count,
        next: state => {
            const position = state.position
            const path = memory.readTextColumn(rows.paths, position)
            const source = memory.readTextColumn(rows.sources, position)
            const path_bytes = bytes.fromText(path)

            const row = bytes.join(bytes.fromText(""), [
                bytes.encodeU64Le(path_bytes.length),
                path_bytes,
                readGenerationFileDigest(cache, path, source)
            ])

            state.parts = state.parts.push(row)[0]
            state.position += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
