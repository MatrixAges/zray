import bytes from "std:bytes"
import memory from "memory"

import type { SourceRows as Input } from "./output_shape"

export type Output = u8[]

export default function (in: Input): Output {
    const { paths, digests } = in

    const parts: u8[][] = []

    const collected = loop({
        position: 0,
        parts
    }, {
        while: state => state.position < digests.length,
        next: state => {
            const position = state.position
            const path = memory.readTextColumn(paths, position)
            const path_bytes = bytes.fromText(path)

            const row = bytes.join(bytes.fromText(""), [
                bytes.encodeU64Le(path_bytes.length),
                path_bytes,
                digests[position]
            ])

            state.parts = state.parts.push(row)[0]
            state.position += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
