import bytes from "std:bytes"
import field from "core/ir/fingerprint/text"
import memory from "memory"

import { digest_width } from "./const"

import type { Writer } from "std:bytes"
import type { Records } from "./model"

export type Input = {
    out: Writer,
    rows: Records
}

export type Output = void

export default function (in: Input): Output {
    const { out, rows } = in

    const include_digest = rows.digests.length != 0

    const written = loop(0, {
        while: position => position < rows.count,
        next: position => {
            field({
                out,
                text: memory.readTextColumn(rows.paths, position)
            })

            if (include_digest) {
                const start = rows.offset + position * rows.stride
                const digest = memory.borrowU8Range(rows.digests, start, digest_width)

                bytes.write(out, digest)
            }

            position += 1
        }
    })
}
