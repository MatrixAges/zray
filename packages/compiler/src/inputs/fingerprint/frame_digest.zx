import crypto from "std:crypto"

import type { FrameDigest as Output } from "./model"
import type { FrameParts as Input } from "./output_shape"

export default function (in: Input): Output {
    return {
        content: crypto.sha256Parts([
            in.header.frame,
            in.modules.frame,
            in.interfaces
        ]),
        shape: crypto.sha256Parts([
            in.header.shape,
            in.modules.shape,
            in.interfaces
        ])
    }
}
