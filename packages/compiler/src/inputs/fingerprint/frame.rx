<Module>
    <Type from="model" as="Fingerprint" />

    <Args in={Fingerprint.Frame} out={void} />

    <Call
        fn="frame_header"
        in={{
            writers: $in.writers,
            generator: $in.generator,
            manifest: $in.manifest
        }}
    />

    <Call
        fn="module_pair"
        in={{
            writers: $in.writers,
            rows: $in.modules
        }}
    />

    <Call
        fn="interface_pair"
        in={{
            writers: $in.writers,
            sources: $in.interfaces,
            count: $in.interface_count
        }}
    />
</Module>
