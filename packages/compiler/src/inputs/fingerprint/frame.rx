<Module>
    <Type from="model" as="Model" />
    <Type from="output_shape" as="Fingerprint" />

    <Args in={Fingerprint.Frame} out={Model.FrameDigest} />

    <Call
        fn="frame_header"
        in={{
            generator: $in.generator,
            manifest: $in.manifest
        }}
    />

    <Call fn="module_pair" in={$in.modules} />

    <Call
        fn="interface_pair"
        in={{
            sources: $in.interfaces,
            count: $in.interface_count
        }}
    />

    <Call
        fn="frame_digest"
        in={{
            header: $ctx.frame_header,
            modules: $ctx.module_pair,
            interfaces: $ctx.interface_pair
        }}
    />

    <Return value={$ctx.frame_digest} />
</Module>
