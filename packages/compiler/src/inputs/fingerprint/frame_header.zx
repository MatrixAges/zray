import bytes from "std:bytes"

import { frame_domain, shape_domain } from "./const"

import type { Pair as Output } from "./model"

export type Input = {
    generator: u8[],
    manifest: string
}

export default function (in: Input): Output {
    const frame_bytes = bytes.fromText(frame_domain)
    const shape_bytes = bytes.fromText(shape_domain)
    const manifest_bytes = bytes.fromText(in.manifest)
    const manifest_len = bytes.encodeU64Le(manifest_bytes.length)

    return {
        frame: bytes.join(bytes.fromText(""), [
            in.generator,
            bytes.encodeU64Le(frame_bytes.length),
            frame_bytes,
            manifest_len,
            manifest_bytes
        ]),
        shape: bytes.join(bytes.fromText(""), [
            in.generator,
            bytes.encodeU64Le(shape_bytes.length),
            shape_bytes,
            manifest_len,
            manifest_bytes
        ])
    }
}
