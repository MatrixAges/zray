import bytes from "std:bytes"
import field from "core/ir/fingerprint/text"

import { frame_domain, shape_domain } from "./const"
import writeText from "./text_pair"

import type { Writers } from "./model"

export type Input = {
    writers: Writers,
    generator: u8[],
    manifest: string
}

export type Output = void

export default function (in: Input): Output {
    const { frame, shape } = in.writers

    bytes.write(frame, in.generator)

    field({
        out: frame,
        text: frame_domain
    })

    bytes.write(shape, in.generator)

    field({
        out: shape,
        text: shape_domain
    })

    writeText({
        writers: in.writers,
        text: in.manifest
    })
}
