<Module>
    <Type from="output_shape" as="Fingerprint" />

    <Args in={Fingerprint.OutputFingerprint} out={u8[]} />

    <Call
        fn="output_header"
        in={{
            frame: $in.frame,
            partitions: $in.partitions
        }}
    />

    <Task name="source_files" out={$ctx.files}>
        <Call fn="files" in={$in.sources} />
    </Task>

    <Task name="template_files" out={$ctx.files}>
        <Call fn="files" in={$in.templates} />
    </Task>

    <Call
        fn="output_digest"
        in={{
            header: $ctx.output_header,
            sources: $ctx.task.source_files,
            templates: $ctx.task.template_files
        }}
    />

    <Return value={$ctx.output_digest} />
</Module>
