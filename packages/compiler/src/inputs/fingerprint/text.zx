import memory from "memory"

import field from "./field"

import type { Writer } from "std:bytes"
import type { Text } from "./model"

export type Input = {
    out: Writer,
    rows: Text
}

export type Output = void

export default function (in: Input): Output {
    const { out, rows } = in
    const { first, second, count } = rows

    const written = loop(0, {
        while: position => position < count,
        next: position => {
            field({
                out,
                text: memory.readTextColumn(first, position)
            })

            if (second != null) {
                field({
                    out,
                    text: memory.readTextColumn(second, position)
                })
            }

            position += 1
        }
    })
}
