import bytes from "std:bytes"

import type { Writers } from "./model"

export type Input = {
    writers: Writers,
    text: string
}

export type Output = void

export default function (in: Input): Output {
    const text = bytes.fromText(in.text)

    const { frame, shape } = in.writers

    bytes.writeU64Le(frame, text.length)
    bytes.write(frame, text)
    bytes.writeU64Le(shape, text.length)
    bytes.write(shape, text)
}
