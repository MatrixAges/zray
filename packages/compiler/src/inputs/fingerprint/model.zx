import type { Writer } from "std:bytes"
import type { TextColumn } from "memory"

export type Records = {
    paths: TextColumn,
    count: u64,
    digests: u8[],
    offset: u64,
    stride: u64
}

export type Text = {
    first: TextColumn,
    second?: TextColumn,
    count: u64
}

export type Writers = {
    frame: Writer,
    shape: Writer
}

export type Frame = {
    writers: Writers,
    generator: u8[],
    manifest: string,
    modules: Records,
    interfaces: TextColumn,
    interface_count: u64
}
