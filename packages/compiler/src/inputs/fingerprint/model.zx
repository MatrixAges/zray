import type { TextColumn } from "memory"
import type { Version } from "../snapshot/records/write_shape"

export type Text = {
    first: TextColumn,
    second?: TextColumn,
    count: u64
}

export type Pair = {
    frame: u8[],
    shape: u8[]
}

export type DigestRow = {
    path: string,
    digest: u8[]
}

export type Document = {
    path: string,
    source: string,
    digest: u8[],
    version?: Version
}

export type ModulePair = Pair & {
    digests: DigestRow[]
}

export type FrameDigest = {
    content: u8[],
    shape: u8[],
    digests: DigestRow[]
}
