import bytes from "std:bytes"
import crypto from "std:crypto"

export type Input = {
    generator: u8[],
    partitions: u32,
    directory: string,
    manifest: u8[]
}

export type Output = u8[]

export default function (in: Input): Output {
    const directory = bytes.fromText(in.directory)

    return crypto.sha256Parts([
        in.generator,
        bytes.encodeU32Le(in.partitions),
        bytes.encodeU64Le(directory.length),
        directory,
        in.manifest
    ])
}
