import bytes from "std:bytes"

import { output_domain } from "./const"

export type Input = {
    frame: u8[],
    partitions: u32
}

export type Output = u8[]

export default function (in: Input): Output {
    const domain = bytes.fromText(output_domain)

    return bytes.join(bytes.fromText(""), [
        bytes.encodeU64Le(domain.length),
        domain,
        in.frame,
        bytes.encodeU32Le(in.partitions)
    ])
}
