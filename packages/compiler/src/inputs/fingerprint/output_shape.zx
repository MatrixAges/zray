import type { Writer } from "std:bytes"
import type { GenerationFileCache } from "generation_host"
import type { TextColumn, WriteColumn } from "memory"
import type { Writers } from "./model"

export type SourceRows = {
    paths: TextColumn,
    sources: TextColumn,
    count: u64
}

export type OutputFingerprint = {
    out: Writer,
    frame: u8[],
    partitions: u32,
    cache: GenerationFileCache,
    sources: SourceRows,
    templates: SourceRows
}

export type DigestOutput = {
    paths: WriteColumn,
    digests: WriteColumn
}

export type ModuleRows = {
    cache: GenerationFileCache,
    rows: SourceRows,
    target: DigestOutput
}

export type Frame = {
    writers: Writers,
    generator: u8[],
    manifest: string,
    modules: ModuleRows,
    interfaces: TextColumn,
    interface_count: u64
}
