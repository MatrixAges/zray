import type { TextColumn } from "memory"
import type { Pair } from "./model"

export type SourceRows = {
    paths: TextColumn,
    digests: u8[][]
}

export type OutputFingerprint = {
    frame: u8[],
    partitions: u32,
    sources: SourceRows,
    templates: SourceRows
}

export type OutputParts = {
    header: u8[],
    sources: u8[],
    templates: u8[]
}

export type Frame = {
    generator: u8[],
    manifest: string,
    modules: SourceRows,
    interfaces: TextColumn,
    interface_count: u64
}

export type FrameParts = {
    header: Pair,
    modules: Pair,
    interfaces: u8[]
}
