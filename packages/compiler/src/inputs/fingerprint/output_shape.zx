import type { GenerationFileCache } from "generation_host"
import type { TextColumn, WriteColumn } from "memory"
import type { Pair } from "./model"

export type SourceRows = {
    paths: TextColumn,
    sources: TextColumn,
    count: u64
}

export type OutputFingerprint = {
    frame: u8[],
    partitions: u32,
    cache: GenerationFileCache,
    sources: SourceRows,
    templates: SourceRows
}

export type OutputParts = {
    header: u8[],
    sources: u8[],
    templates: u8[]
}

export type DigestOutput = {
    paths: WriteColumn,
    digests: WriteColumn
}

export type ModuleRows = {
    cache: GenerationFileCache,
    rows: SourceRows,
    target: DigestOutput
}

export type Frame = {
    generator: u8[],
    manifest: string,
    modules: ModuleRows,
    interfaces: TextColumn,
    interface_count: u64
}

export type FrameParts = {
    header: Pair,
    modules: Pair,
    interfaces: u8[]
}
