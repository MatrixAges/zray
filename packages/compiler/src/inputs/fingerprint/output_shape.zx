import type { Document, Pair } from "./model"

export type SourceRows = Document[]

export type OutputFingerprint = {
    frame: u8[],
    partitions: u32,
    sources: SourceRows,
    templates: SourceRows
}

export type OutputParts = {
    header: u8[],
    sources: u8[],
    templates: u8[]
}

export type Frame = {
    generator: u8[],
    manifest: string,
    modules: SourceRows,
    interfaces: string[]
}

export type FrameParts = {
    header: Pair,
    modules: Pair,
    interfaces: u8[]
}
