import type { TextColumn, WriteColumn } from "memory"
import type { IndirectTextColumn, RowBuffer } from "memory/columns"

export type Prior = {
    paths: IndirectTextColumn,
    texts: IndirectTextColumn,
    count: u64
}

export type Current = {
    paths: TextColumn,
    texts: TextColumn,
    count: u64
}

export type Snapshot = {
    prior: Prior,
    current: Current
}

export type Probe = Snapshot & {
    before?: u8[],
    packages: u8[]
}

export type Target = {
    buffer: RowBuffer,
    rows: WriteColumn
}

export type Input = {
    probe: Probe,
    target: Target
}

export type Output = {
    whole: bool,
    prefix: u64
}

export type Cursor = {
    prior: Prior,
    first: u64,
    path: string
}

export type Comparison = Snapshot & {
    index: u64,
    row: u64
}
