import type { TextColumn } from "memory"
import type { IndirectTextColumn } from "memory/columns"

export type Prior = {
    paths: IndirectTextColumn,
    texts: IndirectTextColumn,
    count: u64
}

export type Current = {
    paths: TextColumn,
    texts: TextColumn,
    count: u64
}

export type Snapshot = {
    prior: Prior,
    current: Current
}

export type Probe = Snapshot & {
    before?: u8[],
    packages: u8[]
}

export type Input = Probe

export type Prefix = {
    whole: bool,
    prefix: u64
}

export type Output = Prefix & {
    tail: u64[]
}

export type Cursor = {
    prior: Prior,
    first: u64,
    path: string
}

export type Comparison = Snapshot & {
    index: u64,
    row: u64
}
