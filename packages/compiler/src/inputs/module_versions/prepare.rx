<Module>
    <Type from="model" as="Batch" />

    <Args in={Batch.Input} out={Batch.Output} />

    <Call fn="prefix" in={$in} />

    <Call
        fn="suffix"
        in={{
            snapshot: $in.pick([
                "prior",
                "current"
            ]),
            prefix: $ctx.prefix.prefix,
            active: !$ctx.prefix.whole && $in.prior.count != 0
        }}
    />

    <Return
        value={{
            ...$ctx.prefix,
            tail: $ctx.suffix
        }}
    />
</Module>
