import { allocateRows } from "core/row_buffer"
import memory from "memory"

import sameRow from "./same_row"
import start from "./start"

import type { Snapshot, Target } from "./model"

export type Input = {
    snapshot: Snapshot,
    target: Target,
    prefix: u64
}

export type Output = void

export default function (in: Input): Output {
    const { prior, current } = in.snapshot
    const { prefix, target } = in

    allocateRows({
        target: target.buffer,
        count: current.count - prefix
    })

    const selected = loop({
        row: prefix,
        first: prefix == 0 ? 0 : prefix - 1
    }, {
        while: state => state.row < current.count,
        next: state => {
            const row = state.row
            const path = memory.readTextColumn(current.paths, row)

            state.first = start({
                prior,
                first: state.first,
                path
            })

            const index = state.first
            const position = match {
                index == prior.count => 0,
                sameRow({
                    prior,
                    current,
                    index,
                    row
                }) => index + 1,
                _ => 0
            }

            memory.writeColumnU64(target.rows, row - prefix, position)
            state.row += 1
        }
    })
}
