import memory from "memory"

import sameRow from "./same_row"
import start from "./start"

import type { Snapshot } from "./model"

export type Input = {
    snapshot: Snapshot,
    prefix: u64,
    active: bool
}

export type Output = u64[]

export default function (in: Input): Output {
    if (!in.active) {
        return []
    }

    const { prior, current } = in.snapshot
    const { prefix } = in

    const empty: u64[] = []

    return loop({
        row: prefix,
        first: prefix == 0 ? 0 : prefix - 1,
        tail: empty
    }, {
        while: state => state.row < current.count,
        next: state => {
            const row = state.row
            const path = memory.readTextColumn(current.paths, row)

            state.first = start({
                prior,
                first: state.first,
                path
            })

            const index = state.first
            const position = match {
                index == prior.count => 0,
                sameRow({
                    prior,
                    current,
                    index,
                    row
                }) => index + 1,
                _ => 0
            }

            state.tail = state.tail.push(position)[0]
            state.row += 1
        },
        return: state => state.tail
    })
}
