import memory from "memory"

import same from "./same"
import sameRow from "./same_row"
import start from "./start"

import type { Input, Output } from "./model"

export type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { prior, current, positions } = in

    if (positions == null) {
        return same({
            prior,
            current
        })
    }

    return loop({
        row: 0,
        first: 0
    }, {
        while: state => state.row < current.count,
        next: state => {
            const row = state.row
            const path = memory.readTextColumn(current.paths, row)

            state.first = start({
                prior,
                first: state.first,
                path
            })

            const index = state.first
            const position = match {
                index == prior.count => 0,
                sameRow({
                    prior,
                    current,
                    index,
                    row
                }) => index + 1,
                _ => 0
            }

            memory.writeU64(positions, row, position)
            state.row += 1
        },
        return: state => state.row == current.count
    })
}
