import sameRow from "./same_row"

import type { Snapshot as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { prior, current } = in

    if (prior.count != current.count) {
        return false
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < current.count,
        next: state => {
            const row = state.row
            state.valid = sameRow({
                prior,
                current,
                index: row,
                row
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
