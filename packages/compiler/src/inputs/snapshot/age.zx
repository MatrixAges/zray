import { max_u64 } from "core/const"

import { timestamp_fence } from "./const"

export type Time = {
    high: i32,
    low: u64
}

export type Input = {
    changed: Time,
    read: Time
}

export type Output = bool

export default function (in: Input): Output {
    const { changed, read } = in

    if (read.high < changed.high) {
        return false
    }

    if (read.high == changed.high) {
        if (read.low <= changed.low) {
            return false
        }

        return read.low - changed.low > timestamp_fence
    }

    if (read.high != changed.high + 1 || read.low > timestamp_fence) {
        return true
    }

    return max_u64 - changed.low >= timestamp_fence - read.low
}
