import age from "./age"

import type { Cursor as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const at = in.index
    const read_high = in.previous.read_high[at]
    const read_low = in.previous.read_low[at]

    if (read_high > in.now_high) {
        return false
    }

    if (read_high == in.now_high && read_low > in.now_low) {
        return false
    }

    return age({
        changed: {
            high: in.current.ctime_high[at],
            low: in.current.ctime_low[at]
        },
        read: {
            high: read_high,
            low: read_low
        }
    })
}
