import temporal from "./temporal"

import type { Cursor as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const at = in.index

    return temporal({
        changed: {
            high: in.current.ctime_high[at],
            low: in.current.ctime_low[at]
        },
        read: {
            high: in.previous.read_high[at],
            low: in.previous.read_low[at]
        },
        now: {
            high: in.now_high,
            low: in.now_low
        }
    })
}
