import age from "./age"

import type { Time } from "./age"

export type Input = {
    changed: Time,
    read: Time,
    now: Time
}

export type Output = bool

export default function (in: Input): Output {
    const { changed, read, now } = in

    if (read.high > now.high) {
        return false
    }

    if (read.high == now.high && read.low > now.low) {
        return false
    }

    return age({
        changed,
        read
    })
}
