import upgrade from "../file_versions/mark"
import age from "./age"

import type { Input as Borrow } from "../file_versions/mark"
import type { Time } from "./age"

export type File = {
    inode: u64,
    size: u64,
    modified: Time,
    changed: Time
}

export type Input = {
    stored: File,
    observed: File,
    read: Time,
    borrow: Borrow
}

export type Output = u64?

export default function (in: Input): Output {
    const { stored, observed } = in

    const mtime = stored.modified
    const ctime = stored.changed
    const next_mtime = observed.modified
    const next_ctime = observed.changed

    const same = (
        - stored.inode == observed.inode
        - and stored.size == observed.size
        - and mtime.high == next_mtime.high
        - and mtime.low == next_mtime.low
        - and ctime.high == next_ctime.high
        - and ctime.low == next_ctime.low
    )

    const settled = same && age({
        changed: ctime,
        read: in.read
    })

    return settled ? upgrade(in.borrow) : null
}
