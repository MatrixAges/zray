<Module>
    <Type from="write_shape" as="Records" />

    <Args in={Records.Write} out={u8[]?} />

    <Call
        fn="write_rows"
        in={{
            count: $in.count,
            paths: $in.paths,
            keys: $in.keys,
            versions: $in.versions
        }}
    />

    <If on={$ctx.write_rows == null}>
        <Return value={null} />
    </If>

    <Call
        fn="write_header"
        in={{
            context: $in.context,
            digest: $in.digest,
            count: $in.count
        }}
    />

    <Call
        fn="join"
        in={{
            header: $ctx.write_header,
            rows: $ctx.write_rows
        }}
    />

    <Return value={$ctx.join} />
</Module>
