import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import check from "./check"
import { header_width, path_length_at, row_width } from "./const"

import type { Scan as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { payload, observed, now } = in

    return loop({
        index: 0,
        offset: header_width,
        valid: true
    }, {
        while: state => state.valid && state.index < observed.count,
        next: state => {
            const fields = memory.borrowU8Range(payload, state.offset, row_width)
            const expected = memory.readTextColumn(observed.paths, state.index)
            const length = integers.widen(bytes.readU32(fields, path_length_at, true))
            const path_at = state.offset + row_width
            const path = memory.borrowU8Range(payload, path_at, length)

            state.valid = bytes.equals(path, bytes.fromText(expected)) && check({
                fields,
                observed,
                index: state.index,
                now
            })

            state.offset = path_at + length
            state.index += 1
        },
        return: state => state.valid && state.offset == payload.length
    })
}
