import type { TextColumn } from "memory"
import type { Time } from "../age"

export type Paths = {
    paths: TextColumn,
    count: u64
}

export type Observation = {
    path: string,
    key: string,
    inode?: u64,
    size?: u64,
    mtime_ns?: Time,
    ctime_ns?: Time
}

export type Snapshot = {
    path: string,
    context: string,
    facts: Observation[]
}

export type Reading = {
    payload?: u8[],
    context: string,
    observed: Observation[],
    now: Time
}

export type Header = Reading.Pick("context") & {
    payload: u8[],
    count: u64
}

export type Scan = Reading.Pick("observed", "now") & {
    payload: u8[]
}

export type Check = {
    fields: u8[],
    observed: Observation,
    now: Time
}
