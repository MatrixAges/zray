import type { ReadColumn, TextColumn } from "memory"
import type { Time } from "../age"

export type Paths = {
    paths: TextColumn,
    count: u64
}

export type Observations = Paths & {
    inodes: ReadColumn,
    sizes: ReadColumn,
    mtime_high: ReadColumn,
    mtime_low: ReadColumn,
    ctime_high: ReadColumn,
    ctime_low: ReadColumn
}

export type Reading = {
    payload: u8[],
    context: string,
    observed: Observations,
    now: Time
}

export type Header = Reading.Pick("payload", "context") & {
    count: u64
}

export type Scan = Reading.Pick("payload", "observed", "now")

export type Check = {
    fields: u8[],
    observed: Observations,
    index: u64,
    now: Time
}
