import bytes from "std:bytes"
import crypto from "std:crypto/blake3"
import fs from "std:fs"

import fits from "../envelope/fits"

export type Input = {
    path: string,
    payload: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    if (!fits(in.payload.length)) {
        return false
    }

    const state = crypto.blake3Init(in.payload)
    const checksum = crypto.blake3FinalHex(state)

    const [failure, _] = try fs.writeFileAtomic({
        path: bytes.fromText(in.path),
        data: bytes.join(bytes.fromText(""), [
            checksum,
            in.payload
        ]),
        make_path: true
    })

    return failure == null
}
