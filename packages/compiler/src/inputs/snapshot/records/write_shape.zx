import type { TextColumn } from "memory"

export type WriteHeader = {
    context: string,
    digest: u8[],
    count: u64
}

export type Version = {
    inode: u64,
    size: u64,
    mtime_low: u64,
    ctime_low: u64,
    read_low: u64,
    mtime_high: i32,
    ctime_high: i32,
    read_high: i32
}

export type WriteRows = WriteHeader.Pick("count") & {
    paths: TextColumn,
    versions: Version[]
}

export type Write = WriteHeader & WriteRows

export type Parts = {
    header: u8[],
    rows?: u8[]
}
