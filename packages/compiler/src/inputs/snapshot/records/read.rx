<Module>
    <Type from="model" as="Records" />
    <Type from="header" as="Header" />

    <Args in={Records.Reading} out={Header.Output} />

    <If on={$in.payload != null}>
        <Call
            fn="header"
            in={{
                payload: $in.payload,
                context: $in.context,
                count: $in.observed.length
            }}
        />

        <If on={$ctx.header == null}>
            <Return value={null} />
        </If>

        <Call
            fn="scan"
            in={{
                payload: $in.payload,
                observed: $in.observed,
                now: $in.now
            }}
        />

        <If on={$ctx.scan}>
            <Return value={$ctx.header} />
        </If>
    </If>

    <Return value={null} />
</Module>
