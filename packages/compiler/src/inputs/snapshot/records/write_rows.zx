import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { WriteRows as Input } from "./write_shape"

export type Output = u8[]?

export default function (in: Input): Output {
    const { count, paths, versions } = in

    if (versions.length != count) {
        return null
    }

    const parts: u8[][] = []

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < count,
        next: state => {
            const index = state.index
            const version = versions[index]
            const path = paths[index]

            const row = bytes.join(bytes.fromText(""), [
                bytes.encodeU64Le(version.inode),
                bytes.encodeU64Le(version.size),
                bytes.encodeU64Le(version.mtime_low),
                bytes.encodeU64Le(version.ctime_low),
                bytes.encodeU64Le(version.read_low),
                bytes.encodeU32Le(memory.i32Bits(
                    version.mtime_high
                )),
                bytes.encodeU32Le(memory.i32Bits(
                    version.ctime_high
                )),
                bytes.encodeU32Le(memory.i32Bits(version.read_high)),
                bytes.encodeU32Le(integers.narrow(path.length)),
                bytes.fromText(path)
            ])

            state.parts = state.parts.push(row)[0]

            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
