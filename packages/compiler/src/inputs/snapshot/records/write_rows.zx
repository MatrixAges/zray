import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { WriteRows as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { rows, writer } = in

    return loop({
        index: 0
    }, {
        while: state => state.index < rows.count,
        next: state => {
            const index = state.index
            const path = memory.readTextColumn(rows.paths, index)

            bytes.writeU64Le(writer, memory.readColumnU64(rows.inodes, index))
            bytes.writeU64Le(writer, memory.readColumnU64(rows.sizes, index))
            bytes.writeU64Le(writer, memory.readColumnU64(rows.mtime_low, index))
            bytes.writeU64Le(writer, memory.readColumnU64(rows.ctime_low, index))
            bytes.writeU64Le(writer, memory.readColumnU64(rows.read_low, index))
            bytes.writeU32Le(
                writer,
                memory.i32Bits(memory.readColumnI32(
                    rows.mtime_high,
                    index
                ))
            )
            bytes.writeU32Le(
                writer,
                memory.i32Bits(memory.readColumnI32(
                    rows.ctime_high,
                    index
                ))
            )
            bytes.writeU32Le(
                writer,
                memory.i32Bits(memory.readColumnI32(rows.read_high, index))
            )
            bytes.writeU32Le(writer, integers.narrow(path.length))
            bytes.write(writer, bytes.fromText(path))

            state.index += 1
        },
        return: state => state.index
    })
}
