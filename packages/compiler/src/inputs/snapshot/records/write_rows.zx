import bytes from "std:bytes"
import integers from "std:integer"
import { readSnapshotVersion } from "generation_host"
import memory from "memory"

import type { WriteRows as Input } from "./write_shape"

export type Output = bool

export default function (in: Input): Output {
    const { writer, count, paths, keys, versions } = in

    return loop({
        index: 0,
        complete: true
    }, {
        while: state => state.complete && state.index < count,
        next: state => {
            const index = state.index
            const key = memory.readTextColumn(keys, index)
            const version = readSnapshotVersion(versions, key)

            if (version == null) {
                state.complete = false
            } else {
                const path = memory.readTextColumn(paths, index)

                bytes.writeU64Le(writer, version.inode)
                bytes.writeU64Le(writer, version.size)
                bytes.writeU64Le(writer, version.mtime_low)
                bytes.writeU64Le(writer, version.ctime_low)
                bytes.writeU64Le(writer, version.read_low)
                bytes.writeU32Le(writer, memory.i32Bits(version.mtime_high))
                bytes.writeU32Le(writer, memory.i32Bits(version.ctime_high))
                bytes.writeU32Le(writer, memory.i32Bits(version.read_high))
                bytes.writeU32Le(writer, integers.narrow(path.length))
                bytes.write(writer, bytes.fromText(path))
            }

            state.index += 1
        },
        return: state => state.complete
    })
}
