import memory from "memory"

import temporal from "../temporal"
import {
    changed_high_at,
    changed_low_at,
    inode_at,
    modified_high_at,
    modified_low_at,
    read_high_at,
    read_low_at,
    size_at
} from "./const"

import type { Check as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { fields, observed, now } = in
    const { inode: found_inode, size: found_size, mtime_ns, ctime_ns } = observed

    if (found_inode == null || found_size == null) {
        return false
    }

    if (mtime_ns == null || ctime_ns == null) {
        return false
    }

    const inode = memory.readU64Bytes(fields, inode_at, true)
    const size = memory.readU64Bytes(fields, size_at, true)
    const modified_low = memory.readU64Bytes(fields, modified_low_at, true)
    const changed_low = memory.readU64Bytes(fields, changed_low_at, true)
    const modified_high = memory.readI32Bytes(fields, modified_high_at, true)
    const changed_high = memory.readI32Bytes(fields, changed_high_at, true)

    const same_inode = inode == found_inode
    const same_size = size == found_size
    const same_mtime_low = modified_low == mtime_ns.low
    const same_ctime_low = changed_low == ctime_ns.low
    const same_mtime_high = modified_high == mtime_ns.high
    const same_ctime_high = changed_high == ctime_ns.high

    const matches = (
        - same_inode
        - and same_size
        - and same_mtime_low
        - and same_ctime_low
        - and same_mtime_high
        - and same_ctime_high
    )

    if (!matches) {
        return false
    }

    return temporal({
        changed: {
            high: changed_high,
            low: changed_low
        },
        read: {
            high: memory.readI32Bytes(fields, read_high_at, true),
            low: memory.readU64Bytes(fields, read_low_at, true)
        },
        now
    })
}
