import bytes from "std:bytes"

import { magic } from "./const"

import type { WriteHeader as Input } from "./write_shape"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        bytes.fromText(magic),
        bytes.fromText(in.context),
        in.digest,
        bytes.encodeU64Le(in.count)
    ])
}
