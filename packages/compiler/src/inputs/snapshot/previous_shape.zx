import columns from "./columns"

import type { Files } from "./model"

export type Input = {
    previous: Files,
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { previous, count } = in

    const shape = columns(previous)
    const paths = previous.paths.length
    const read_high = previous.read_high.length
    const read_low = previous.read_low.length

    return (
        - shape
        - and paths == count
        - and read_high == count
        - and read_low == count
    )
}
