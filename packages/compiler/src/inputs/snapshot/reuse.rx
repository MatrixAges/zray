<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.Input} out={bool} />

    <Call
        fn="context"
        in={$in.pick([
            "context",
            "previous",
            "stored_checksum",
            "actual_checksum"
        ])}
    />

    <If on={!$ctx.context}>
        <Return value={false} />
    </If>

    <Call fn="shape" in={$in} />

    <If on={!$ctx.shape}>
        <Return value={false} />
    </If>

    <Call fn="files" in={$in} />

    <Return value={$ctx.files} />
</Module>
