import type { ReadColumn, TextColumn } from "memory"
import type { Time } from "../age"
import type { Identity, Files } from "../model"

export type Observations = {
    paths: TextColumn,
    inodes: ReadColumn,
    sizes: ReadColumn,
    mtime_high: ReadColumn,
    mtime_low: ReadColumn,
    ctime_high: ReadColumn,
    ctime_low: ReadColumn,
    count: u64
}

export type Input = Identity & {
    observed: Observations,
    now: Time
}

export type Scan = {
    observed: Observations,
    previous: Files,
    now: Time
}

export type Cursor = Scan & {
    index: u64
}
