<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.Input} out={bool} />

    <Call
        fn="../identity"
        in={$in.pick([
            "context",
            "previous"
        ])}
    />

    <If on={!$ctx.identity}>
        <Return value={false} />
    </If>

    <Call
        fn="../previous_shape"
        in={{
            previous: $in.previous.files,
            count: $in.observed.count
        }}
    />

    <If on={!$ctx.previous_shape}>
        <Return value={false} />
    </If>

    <Call
        fn="files"
        in={{
            observed: $in.observed,
            previous: $in.previous.files,
            now: $in.now
        }}
    />

    <Return value={$ctx.files} />
</Module>
