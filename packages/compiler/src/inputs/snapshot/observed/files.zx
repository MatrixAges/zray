import accept from "./accept"

import type { Scan as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.observed.count,
        next: state => {
            state.valid = accept({
                ...in,
                index: state.index
            })
            state.index += 1
        },
        return: state => state.valid
    })
}
