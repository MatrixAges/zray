import type { ReadColumn, TextColumn } from "memory"
import type { Clock, Retention } from "../../zx/modules/cache_retention/model"

export type Version = {
    text: u8[],
    mark: u64
}

export type Counters = {
    active: u64,
    publishable: u64,
    abortable: u64
}

export type Read = {
    previous?: Version,
    text: u8[],
    borrowable: bool,
    clock: Clock,
    counters: Counters
}

export type Update = {
    reuse: bool,
    mark: u64,
    previous?: Retention,
    counters: Counters
}

export type Pending = {
    texts: TextColumn,
    publish: ReadColumn,
    abort: ReadColumn,
    count: u64
}

export type Retire = {
    pending: Pending,
    published: bool
}

export type Retired = {
    rows: u64[],
    bytes: u64
}
