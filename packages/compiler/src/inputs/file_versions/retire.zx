import memory from "memory"

import type { Retire as Input, Retired as Output } from "./model"

export default function (in: Input): Output {
    const { pending, published } = in

    const marks = published ? pending.publish : pending.abort
    const empty: u64[] = []

    return loop({
        row: 0,
        rows: empty,
        bytes: 0
    }, {
        while: state => state.row < pending.count,
        next: state => {
            if (memory.readColumnBool(marks, state.row)) {
                const text = memory.readTextColumn(pending.texts, state.row)

                state.rows = state.rows.push(state.row)[0]
                state.bytes += text.length
            }

            state.row += 1
        },
        return: state => ({
            rows: state.rows,
            bytes: state.bytes
        })
    })
}
