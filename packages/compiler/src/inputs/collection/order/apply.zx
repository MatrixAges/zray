export type CyclePlan = {
    indices: u64[],
    ends: u64[]
}

export type Input = {
    order: u64[]
}

export type Output = CyclePlan

export default function (in: Input): Output {
    const count = in.order.length
    const empty: u64[] = []

    return loop({
        start: 0,
        order: in.order,
        indices: empty,
        ends: empty
    }, {
        while: state => state.start < count,
        next: state => {
            const start = state.start

            if (state.order[start] != start) {
                const cycle = loop({
                    row: start,
                    order: state.order,
                    indices: state.indices,
                    done: false
                }, {
                    while: inner => !inner.done,
                    next: inner => {
                        const row = inner.row
                        const next = inner.order[row]

                        inner.order[row] = row
                        inner.indices = inner.indices.push(row)[0]

                        if (next == start) {
                            inner.done = true
                        } else {
                            inner.row = next
                        }
                    },
                    return: inner => ({
                        order: inner.order,
                        indices: inner.indices
                    })
                })

                state.order = cycle.order
                state.indices = cycle.indices
                state.ends = state.ends.push(cycle.indices.length)[0]
            }

            state.start += 1
        },
        return: state => ({
            indices: state.indices,
            ends: state.ends
        })
    })
}
