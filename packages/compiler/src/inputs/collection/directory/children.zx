import qualify from "../qualify"

export type Input = {
    parents: string[],
    directories: string[][]
}

export type Output = string[]

export default function (in: Input): Output {
    const { parents, directories } = in

    const empty: string[] = []

    return loop({
        group: 0,
        next: empty
    }, {
        while: state => state.group < parents.length,
        next: state => {
            const parent = parents[state.group]
            const names = directories[state.group]

            state.next = loop({
                row: 0,
                next: state.next
            }, {
                while: item => item.row < names.length,
                next: item => {
                    const path = qualify({
                        prefix: "",
                        parent,
                        name: names[item.row]
                    })

                    item.next = item.next.push(path)[0]
                    item.row += 1
                },
                return: item => item.next
            })

            state.group += 1
        },
        return: state => state.next
    })
}
