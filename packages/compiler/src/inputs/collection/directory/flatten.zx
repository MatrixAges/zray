import type { Files } from "./model"

export type Input = {
    files: u8[][],
    width: u64,
    copy_paths: bool
}

export type Output = {
    batch: Files,
    count: u64
}

export default function (in: Input): Output {
    const { files, width, copy_paths } = in

    const count = loop({
        row: 0,
        count: 0
    }, {
        while: state => state.row < files.length,
        next: state => {
            state.count += files[state.row].length / width
            state.row += 1
        },
        return: state => state.count
    })

    return {
        batch: {
            records: files,
            copy_paths
        },
        count
    }
}
