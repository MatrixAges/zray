<Module>
    <Type from="scan_shape" as="Directory" />
    <Type from="model" as="Files" />

    <Args in={Directory.Input} out={Files.Collected} />

    <Store from="entries" as="entries" />

    <Loop on={$in.parents.length != 0}>
        <Call
            module="scan_level"
            in={{
                scan: $in,
                parents: $in.initial
            }}
        />
    </Loop>

    <Call fn="read_entries" in={$store.entries.collected} />

    <Return value={$ctx.read_entries} />
</Module>
