import type { Collected } from "./model"
import type { Level } from "./scan_shape"

export type Input = {
    collected: Collected,
    level: Level
}

export type Output = void

export default function (in: Input, {
    $store
}): Output {
    const { collected, level } = in

    if (level.files.length != 0) {
        $store.entries.collected = {
            levels: collected.levels.push(level.files)[0]
        }
    }
}
