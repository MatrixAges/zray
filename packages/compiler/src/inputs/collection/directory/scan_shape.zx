import type { DirectoryScan } from "generation_host"
import type { ListColumn, ReadColumn } from "memory"

export type Input = {
    scan: DirectoryScan,
    directories: ReadColumn,
    files: ListColumn,
    paths: ListColumn,
    width: u64,
    prefix_length: u64,
    initial: string[]
}

export type Step = {
    scan: Input,
    parents: string[],
    frontier: u8,
    running: bool
}
