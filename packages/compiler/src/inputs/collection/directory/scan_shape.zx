import type { File } from "./model"

export type Input = {
    root: string,
    prefix: string,
    initial: string[]
}

export type Step = {
    scan: Input,
    parents: string[]
}

export type Level = {
    step: Step,
    row: u64,
    children: string[],
    files: File[][]
}

export type Parent = {
    root: string,
    relative: string
}
