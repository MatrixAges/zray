import type { Step } from "./scan_shape"

export type Input = {
    step: Step,
    parents: string[]
}

export type Output = Step

export default function (in: Input): Output {
    return {
        scan: in.step.scan,
        parents: in.parents,
        frontier: 1 - in.step.frontier,
        running: in.parents.length != 0
    }
}
