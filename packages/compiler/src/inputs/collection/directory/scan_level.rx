<Module>
    <Type from="scan_shape" as="Directory" />

    <Args in={Directory.Step} out={Directory.Step} />

    <Store from="entries" as="entries" />

    <Loop on={$in.row < $in.step.parents.length}>
        <Call
            module="scan_parent"
            in={{
                step: $in,
                row: 0,
                children: [],
                files: []
            }}
        />
    </Loop>

    <Call
        fn="append_entries"
        in={{
            collected: $store.entries.collected,
            level: $ctx.scan_parent
        }}
        setter={[$store.entries.collected]}
    />

    <Return
        value={{
            scan: $in.scan,
            parents: $ctx.scan_parent.children
        }}
    />
</Module>
