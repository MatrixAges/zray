<Module>
    <Type from="scan_shape" as="Directory" />

    <Args in={Directory.Step} out={Directory.Step} />

    <Store from="entries" as="entries" />

    <Call
        fn="host.listGenerationLevel"
        in={[
            $in.scan.reader,
            $in.parents,
            $in.scan.workers > 1 && $in.parents.length > 1
        ]}
    />

    <Call
        fn="children"
        in={{
            parents: $in.parents,
            directories: $ctx.listGenerationLevel.directories
        }}
    />

    <Call
        fn="flatten"
        in={{
            files: $ctx.listGenerationLevel.files,
            width: $in.scan.width,
            copy_paths: $in.scan.workers > 1 && $in.parents.length > 1
        }}
    />

    <Call
        fn="append_entries"
        in={{
            collected: $store.entries.collected,
            batch: $ctx.flatten
        }}
        setter={[$store.entries.collected]}
    />

    <Return
        value={{
            scan: $in.scan,
            parents: $ctx.children
        }}
    />
</Module>
