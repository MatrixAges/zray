import bytes from "std:bytes"

import kind from "../kind"
import { Kind } from "../kind"

export type Input = {
    prefix: string,
    name: string,
    lookup_limit: u64
}

export type Match = {
    kind: Kind,
    path: string,
    lookup: bool,
    retain: bool
}

export type Output = Match?

export default function (in: Input): Output {
    const selected = kind(in.name)

    if (selected == Kind.Ignored) {
        return null
    }

    const path = `${in.prefix}${in.name}`

    return {
        kind: selected,
        path,
        lookup: bytes.fromText(path).length <= in.lookup_limit,
        retain: selected != Kind.RX
    }
}
