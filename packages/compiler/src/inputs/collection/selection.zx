import memory from "memory"

import type { ReadColumn } from "memory"

export type Input = {
    source: ReadColumn,
    indices: u64[],
    width: u64
}

export type Output = u8[][]

export default function (in: Input): Output {
    const empty: u8[][] = []

    return loop({
        index: 0,
        rows: empty
    }, {
        while: state => state.index < in.indices.length,
        next: state => {
            const record =
                memory.readFixedBytes(in.source, in.indices[state.index], in.width)

            state.rows = state.rows.push(record)[0]
            state.index += 1
        },
        return: state => state.rows
    })
}
