import memory from "memory"

import type { ReadColumn, TextColumn } from "memory"

export type Input = {
    paths: TextColumn,
    texts: ReadColumn,
    relatives: TextColumn,
    retained: ReadColumn,
    kinds: ReadColumn,
    count: u64
}

export type Read = {
    relative: string,
    retain: bool
}

export type Document = {
    path: string,
    text: string,
    read?: Read,
    kind: u8
}

export type Output = Document[]

export default function (in: Input): Output {
    const empty: Document[] = []

    return loop({
        row: 0,
        documents: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const cached = memory.readOptionalTextColumn(in.texts, row)

            const read: Read? = match {
                cached == null => {
                    relative: memory.readTextColumn(in.relatives, row),
                    retain: memory.readColumnBool(in.retained, row)
                },
                _ => null
            }

            state.documents = state.documents.push({
                path: memory.readTextColumn(in.paths, row),
                text: cached ?? "",
                read,
                kind: memory.readColumnU8(in.kinds, row)
            })[0]

            state.row += 1
        },
        return: state => state.documents
    })
}
