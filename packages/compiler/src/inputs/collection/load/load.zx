import { readGenerationDocument } from "generation_host"
import memory from "memory"

import type { DocumentReader } from "generation_host"
import type { ReadColumn, TextColumn } from "memory"

export type Entries = {
    paths: TextColumn,
    relatives: TextColumn,
    texts: ReadColumn,
    kinds: ReadColumn,
    retained: ReadColumn,
    count: u64
}

export type Document = {
    path: string,
    text: string,
    kind: u8
}

export type Input = {
    reader: DocumentReader,
    entries: Entries
}

export type Output = Document[]

export default function (in: Input): Output {
    const { reader, entries } = in

    const empty: Document[] = []

    return loop({
        row: 0,
        documents: empty
    }, {
        while: state => state.row < entries.count,
        next: state => {
            const row = state.row
            const path = memory.readTextColumn(entries.paths, row)
            const cached = memory.readOptionalTextColumn(entries.texts, row)
            const text = cached ?? readGenerationDocument(
                reader,
                memory.readTextColumn(entries.relatives, row),
                path,
                memory.readColumnBool(entries.retained, row)
            )

            state.documents = state.documents.push({
                path,
                text,
                kind: memory.readColumnU8(entries.kinds, row)
            })[0]

            state.row += 1
        },
        return: state => state.documents
    })
}
