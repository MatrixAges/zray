import memory from "memory"

import type { Counts as Output, Files as Input } from "./model"

export default function (in: Input): Output {
    const { kinds, count } = in

    return loop({
        next: 0,
        zx: 0,
        rx: 0
    }, {
        while: state => state.next < count,
        next: state => {
            const kind = memory.readColumnU8(kinds.rows, state.next)

            if (kind == kinds.zx) {
                state.zx += 1
            } else if (kind == kinds.rx) {
                state.rx += 1
            }

            state.next += 1
        },
        return: state => ({
            zx: state.zx,
            rx: state.rx
        })
    })
}
