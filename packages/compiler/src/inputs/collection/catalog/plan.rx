<Module>
    <Type from="../order" as="Order" />
    <Type from="model" as="Catalog" />

    <Args
        in={{
            order: Order.Input,
            kinds: Catalog.Kinds
        }}
        out={Catalog.Plan}
    />

    <Call fn="../order" in={$in.order} />

    <Call
        fn="partition"
        in={{
            kinds: $in.kinds,
            ordered: $ctx.order
        }}
    />

    <Return value={$ctx.partition} />
</Module>
