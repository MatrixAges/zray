<Module>
    <Type from="../order" as="Order" />
    <Type from="model" as="Catalog" />

    <Args
        in={{
            order: Order.Input,
            kinds: Catalog.Kinds
        }}
        out={Catalog.Plan}
    />

    <Call
        fn="count"
        in={{
            kinds: $in.kinds,
            count: $in.order.rows.length
        }}
    />

    <Call fn="../order" in={$in.order} />

    <Return
        value={{
            ordered: $ctx.order,
            counts: $ctx.count
        }}
    />
</Module>
