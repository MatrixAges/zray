import bytes from "std:bytes"
import memory from "memory"

import type { Publish as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { kinds, sources, modules, templates, shared } = in

    const published = loop({
        cursor: 0,
        zx: 0,
        rx: 0,
        template: 0
    }, {
        while: state => state.cursor < in.ordered.length,
        next: state => {
            const row = in.ordered[state.cursor]
            const path = bytes.fromText(memory.readTextColumn(in.paths, row))
            const source = bytes.fromText(memory.readTextColumn(in.bodies, row))
            const kind = memory.readColumnU8(kinds.rows, row)

            if (kind == kinds.zx) {
                memory.writeColumnBytes(sources.text.paths, state.zx, path)
                memory.writeColumnBytes(sources.text.bodies, state.zx, source)
                memory.copyColumnValue(
                    sources.templates,
                    state.zx,
                    shared.templates
                )
                memory.copyColumnValue(sources.original, state.zx, shared.original)
                memory.copyColumnValue(sources.origins, state.zx, shared.origins)
                state.zx += 1
            } else if (kind == kinds.rx) {
                memory.writeColumnBytes(modules.text.paths, state.rx, path)
                memory.writeColumnBytes(modules.text.bodies, state.rx, source)
                memory.copyColumnValue(
                    modules.packages,
                    state.rx,
                    shared.packages
                )
                state.rx += 1
            } else {
                memory.writeColumnBytes(templates.paths, state.template, path)
                memory.writeColumnBytes(templates.bodies, state.template, source)
                state.template += 1
            }

            state.cursor += 1
        }
    })
}
