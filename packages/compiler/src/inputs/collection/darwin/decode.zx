import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import {
    common_offset,
    data_length,
    directory_kind,
    directory_type,
    file_offset,
    kind_offset,
    length_offset,
    link_kind,
    link_type,
    metadata_attributes,
    object_type,
    regular_kind,
    regular_type,
    unknown_kind
} from "./const"
import metadata from "./metadata"
import name from "./name"

import type { Decoded, DecodedMetadata, DecodedRecord, Input, Record } from "./model"

export type Output = Decoded?

export default function (in: Input): Output {
    const { buffer, count, little_endian } = in

    const initial_rows: DecodedRecord[] = []

    const empty_metadata: DecodedMetadata = {
        inode: 0,
        size: 0,
        modified_seconds: 0,
        modified_nanos: 0,
        changed_seconds: 0,
        changed_nanos: 0
    }

    return loop({
        row: 0,
        offset: in.offset,
        valid: true,
        rows: initial_rows
    }, {
        while: state => state.row < count && state.valid,
        next: state => {
            const size = integers.widen(
                bytes.readU32(
                    buffer,
                    state.offset + length_offset,
                    little_endian
                )
            )
            const record = memory.borrowU8Range(buffer, state.offset, size)
            const common =
                integers.widen(bytes.readU32(
                    record,
                    common_offset,
                    little_endian
                ))
            const file =
                integers.widen(bytes.readU32(record, file_offset, little_endian))
            const entry: Record = {
                bytes: record,
                row: state.row,
                little_endian
            }
            const object = integers.andBits(common, object_type)
            const kind = match object {
                0 => unknown_kind,
                _ => match bytes.readU32(record, kind_offset, little_endian) {
                    regular_type => regular_kind,
                    directory_type => directory_kind,
                    link_type => link_kind,
                    _ => unknown_kind
                }
            }

            const complete =
                integers.andBits(common, metadata_attributes) == metadata_attributes
            const has_metadata = complete && integers.andBits(file, data_length) != 0

            const entry_name = name(entry)

            if (entry_name != null) {
                const info = has_metadata ? metadata(entry) : empty_metadata

                state.rows = state.rows.push({
                    name: entry_name,
                    kind,
                    has_metadata,
                    inode: info.inode,
                    size: info.size,
                    modified_seconds: info.modified_seconds,
                    modified_nanos: info.modified_nanos,
                    changed_seconds: info.changed_seconds,
                    changed_nanos: info.changed_nanos
                })[0]
            } else {
                state.valid = false
            }

            state.row += 1
            state.offset += size
        },
        return: state => match {
            state.valid => {
                offset: state.offset,
                rows: state.rows
            },
            _ => null
        }
    })
}
