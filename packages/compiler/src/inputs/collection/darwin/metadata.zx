import memory from "memory"

import {
    modified_seconds_offset,
    modified_nanos_offset,
    changed_seconds_offset,
    changed_nanos_offset,
    inode_offset,
    size_offset
} from "./const"

import type { DecodedMetadata, Record } from "./model"

export type Input = Record

export type Output = DecodedMetadata

export default function (in: Input): Output {
    const { bytes: record, little_endian } = in

    const inode = memory.readU64Bytes(record, inode_offset, little_endian)
    const size = memory.readU64Bytes(record, size_offset, little_endian)

    const modified_seconds =
        memory.readU64Bytes(record, modified_seconds_offset, little_endian)

    const modified_nanos =
        memory.readU64Bytes(record, modified_nanos_offset, little_endian)

    const changed_seconds =
        memory.readU64Bytes(record, changed_seconds_offset, little_endian)

    const changed_nanos =
        memory.readU64Bytes(record, changed_nanos_offset, little_endian)

    return {
        inode,
        size,
        modified_seconds,
        modified_nanos,
        changed_seconds,
        changed_nanos
    }
}
