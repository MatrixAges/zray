export const kind_offset: u64 = 32

export const modified_seconds_offset: u64 = 36

export const modified_nanos_offset: u64 = 44

export const changed_seconds_offset: u64 = 52

export const changed_nanos_offset: u64 = 60

export const inode_offset: u64 = 68

export const size_offset: u64 = 76

export const regular_type: u32 = 1

export const directory_type: u32 = 2

export const link_type: u32 = 5

export const unknown_kind: u8 = 0

export const regular_kind: u8 = 1

export const directory_kind: u8 = 2

