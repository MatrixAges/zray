import { internal_prefix } from "../const"

import type { Output as Publication } from "./publish"
import type { Binding, SourcePlan, Traversal as Output } from "./publish_shape"

export type Input = {
    plan: Publication,
    source: SourcePlan
}

export default function (in: Input): Output {
    const { index, alias, path, module, resolve_members, next } = in.plan

    const name = alias ?? `${internal_prefix}${module}`

    const binding: Binding = {
        index,
        name,
        path,
        module,
        ...in.source,
        resolve_members
    }

    return {
        ...next,
        bindings: next.bindings.push(binding)[0]
    }
}
