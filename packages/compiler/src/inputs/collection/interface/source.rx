<Module>
    <Type from="publish_shape" as="Interfaces" />

    <Args in={Interfaces.Source} out={Interfaces.SourcePlan} />

    <If on={$in.source != null}>
        <Return
            value={{
                source: $in.source,
                read_path: null
            }}
        />
    </If>

    <Return
        value={{
            source: "",
            read_path: $in.path
        }}
    />
</Module>
