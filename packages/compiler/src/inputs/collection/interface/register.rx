<Module>
    <Type from="publish_shape" as="Interfaces" />

    <Args in={Interfaces.Registration} out={Interfaces.Plan} />

    <Call fn="count" in={$in.aliases} />

    <Loop on={$in.row < $in.request.aliases.count}>
        <Call
            module="next"
            in={{
                request: $in,
                row: 0,
                external: 0,
                internal: $ctx.count,
                bindings: []
            }}
        />
    </Loop>

    <Return
        value={{
            external: $ctx.count,
            bindings: $ctx.next.bindings
        }}
    />
</Module>
