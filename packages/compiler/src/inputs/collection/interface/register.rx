<Module>
    <Type from="publish_shape" as="Interfaces" />

    <Args in={Interfaces.Registration} out={u64} />

    <Call fn="count" in={$in.aliases} />

    <Call
        fn="publish"
        in={{
            request: $in,
            first_internal: $ctx.count
        }}
    />

    <Return value={$ctx.count} />
</Module>
