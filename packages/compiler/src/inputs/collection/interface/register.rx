<Module>
    <Type from="publish" as="Plan" />
    <Type from="binding" as="Binding" />

    <Args in={Plan.Registration} out={Binding.Output} />

    <Call
        fn="publish"
        in={{
            declarations: $in.declarations,
            sources: $in.sources
        }}
    />

    <Call
        module="../../generation/request/read"
        in={[
            $in.host,
            {
                root: null,
                files: $ctx.publish.files,
                optional: true
            }
        ]}
    />

    <Call
        fn="binding"
        in={{
            rows: $ctx.publish.rows,
            ...$ctx.read
        }}
    />

    <Return value={$ctx.binding} />
</Module>
