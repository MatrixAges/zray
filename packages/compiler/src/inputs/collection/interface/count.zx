import memory from "memory"

import type { Aliases as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { specifiers, count } = in

    return loop({
        row: 0,
        external: 0
    }, {
        while: state => state.row < count,
        next: state => {
            if (memory.readOptionalTextColumn(specifiers, state.row) != null) {
                state.external += 1
            }

            state.row += 1
        },
        return: state => state.external
    })
}
