import type { ReadColumn, TextColumn } from "memory"
import type { Aliases } from "./model"

export type Sources = {
    paths: TextColumn,
    bodies: TextColumn,
    count: u64
}

export type Registration = {
    aliases: Aliases,
    paths: TextColumn,
    modules: TextColumn,
    namespaces: ReadColumn,
    sources: Sources
}

export type Binding = {
    index: u64,
    name: string,
    path: string,
    module: string,
    source: string,
    read_path?: string,
    resolve_members: bool
}

export type Traversal = {
    request: Registration,
    row: u64,
    external: u64,
    internal: u64,
    bindings: Binding[]
}

export type Plan = {
    external: u64,
    bindings: Binding[]
}

export type Source = {
    path: string,
    source?: string
}

export type SourcePlan = {
    source: string,
    read_path?: string
}
