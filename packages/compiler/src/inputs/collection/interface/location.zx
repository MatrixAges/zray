import sortedText from "core/bytes/index/sorted_text"
import { max_u64 } from "core/const"
import memory from "memory"

import discovered from "../discovered"
import kind from "../kind"
import { Kind } from "../kind"

import type { TextColumn, WriteColumn } from "memory"

export type Input = {
    paths: TextColumn,
    declarations: u64,
    candidates: TextColumn,
    count: u64,
    sorted: bool,
    output: WriteColumn
}

export type Output = void

export default function (in: Input): Output {
    const { paths, declarations, candidates, count, sorted, output } = in

    const scanned = loop(0, {
        while: index => index < declarations,
        next: index => {
            const path = memory.readTextColumn(paths, index)
            const query = {
                path,
                paths: candidates,
                count
            }

            const found: u64? = match {
                sorted => sortedText(query),
                kind(path) == Kind.ZX => discovered(query),
                _ => null
            }

            memory.writeColumnU64(output, index, found ?? max_u64)
            index += 1
        }
    })
}
