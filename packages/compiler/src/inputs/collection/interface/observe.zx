import memory from "memory"

import find from "./find"

import type { TextColumn } from "memory"

export type Input = {
    paths: TextColumn,
    count: u64,
    keys: TextColumn,
    existing: u64
}

export type Observation = {
    path: string,
    matching?: u64
}

export type Output = Observation[]

export default function (in: Input): Output {
    const { paths, count, keys, existing } = in

    const observations: Observation[] = []

    return loop({
        row: 0,
        observations
    }, {
        while: state => state.row < count,
        next: state => {
            const path = memory.readTextColumn(paths, state.row)
            const matching = find({
                path,
                paths: keys,
                count: existing,
                sorted: false
            })

            state.observations = state.observations.push({
                path,
                matching
            })[0]

            state.row += 1
        },
        return: state => state.observations
    })
}
