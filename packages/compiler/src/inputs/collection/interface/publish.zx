import memory from "memory"

import find from "./find"

import type { Traversal as Input } from "./publish_shape"

export type Output = {
    index: u64,
    alias?: string,
    path: string,
    module: string,
    resolve_members: bool,
    source?: string,
    next: Input
}

export default function (in: Input): Output {
    const { row, request } = in
    const { aliases, paths, modules, namespaces, sources } = request

    const path = memory.readTextColumn(paths, row)
    const module = memory.readTextColumn(modules, row)
    const alias = memory.readOptionalTextColumn(aliases.specifiers, row)

    const source_row = find({
        path,
        paths: sources.paths,
        count: sources.count,
        sorted: true
    })

    return {
        index: alias != null ? in.external : in.internal,
        alias,
        path,
        module,
        resolve_members: memory.readColumnOptionalBool(namespaces, row) ?? false,
        source: match {
            source_row != null => memory.readTextColumn(sources.bodies, source_row),
            _ => null
        },
        next: {
            ...in,
            row: row + 1,
            external: in.external + (alias != null ? 1 : 0),
            internal: in.internal + (alias == null ? 1 : 0)
        }
    }
}
