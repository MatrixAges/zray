import bytes from "std:bytes"

import type {
    GenerationIO,
    GenerationInterface,
    GenerationPath
} from "generation_host"
import type { Document } from "../../fingerprint/model"

export type Input = {
    declarations: GenerationInterface[],
    sources: Document[]
}

export type Registration = Input & {
    host: GenerationIO
}

export type Row = {
    declaration: GenerationInterface,
    source?: string
}

export type Output = {
    rows: Row[],
    files: GenerationPath[]
}

export default function (in: Input): Output {
    const rows: Row[] = []
    const files: GenerationPath[] = []

    return loop({
        row: 0,
        rows,
        files
    }, {
        while: state => state.row < in.declarations.length,
        next: state => {
            const declaration = in.declarations[state.row]
            const needle = bytes.fromText(declaration.path)
            const position = loop({
                first: 0,
                last: in.sources.length
            }, {
                while: state => state.first < state.last,
                next: state => {
                    const middle = state.first + (state.last - state.first) / 2
                    const previous = bytes.fromText(in.sources[middle].path)

                    if (bytes.lessThan(previous, needle)) {
                        state.first = middle + 1
                    } else {
                        state.last = middle
                    }
                },
                return: state => state.first
            })

            const source: string? = match {
                position < in.sources.length &&
                    in.sources[position].path == declaration.path =>
                    in.sources[position].source,
                _ => null
            }

            state.rows = state.rows.push({
                declaration,
                source
            })[0]

            if (source == null) {
                state.files = state.files.push({
                    path: declaration.path,
                    relative: declaration.path,
                    retain: true
                })[0]
            }

            state.row += 1
        },
        return: state => state.pick([
            "rows",
            "files"
        ])
    })
}
