<Module>
    <Type from="publish_shape" as="Interfaces" />

    <Args in={Interfaces.Traversal} out={Interfaces.Traversal} />

    <Call fn="publish" in={$in} />

    <Call
        module="source"
        in={$ctx.publish.pick([
            "path",
            "source"
        ])}
    />

    <Call
        fn="binding"
        in={{
            plan: $ctx.publish,
            source: $ctx.source
        }}
    />

    <Return value={$ctx.binding} />
</Module>
