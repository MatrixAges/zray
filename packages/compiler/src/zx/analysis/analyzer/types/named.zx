import integers from "std:integer"

import findAlias from "../../semantic/resolving/alias"
import builtin from "../../semantic/resolving/builtin"
import lookup from "../../semantic/resolving/lookup"

import type { Search } from "../../semantic/types/model"
import type { Types } from "./model"

export type Input = {
    types: Types,
    name: string
}

export type Output = Search

export default function (in: Input): Output {
    const scalar = builtin(in.name)

    if (scalar != 0) {
        return {
            found: true,
            id: integers.narrow(scalar - 1)
        }
    }

    const cached = lookup({
        cache: in.types.cache,
        name: in.name
    })

    const resolved = match {
        cached.found => cached,
        _ => lookup({
            cache: in.types.context.resolved,
            name: in.name
        })
    }

    if (resolved.found) {
        return resolved
    }

    const aliases = in.types.context.aliases

    const candidate = findAlias({
        aliases,
        name: in.name,
        end: aliases.row_count + aliases.names.length
    })

    return {
        found: candidate != null,
        id: candidate ?? 0
    }
}
