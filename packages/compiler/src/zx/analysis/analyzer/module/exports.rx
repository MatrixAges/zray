<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Analysis} out={Model.Analysis} />

    <If on={$in.state.diagnostic.message == ""}>
        <Call
            fn="../exports"
            in={{
                state: {
                    types: $in.state.types,
                    diagnostic: $in.state.diagnostic
                }
            }}
        />

        <Return
            value={{
                ...$in,
                state: {
                    ...$in.state,
                    types: $ctx.exports.state.types,
                    diagnostic: $ctx.exports.state.diagnostic
                },
                names: $ctx.exports.names,
                types: $ctx.exports.types
            }}
        />

        <Else>
            <Return value={$in} />
        </Else>
    </If>
</Module>
