import integers from "std:integer"

import findAlias from "../../../semantic/resolving/alias"
import aliasId from "../../../semantic/resolving/alias_id"
import aliasName from "../../../semantic/resolving/alias_name"
import declared from "./declared"
import { DeclarationKind } from "./model"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const { aliases } = in

    const count = aliases.row_count + aliases.names.length

    return loop({
        input: in,
        index: 0,
        valid: true
    }, {
        while: current =>
            current.valid && current.index < count,
        next: current => {
            const row = {
                aliases,
                row: current.index
            }
            const name = aliasName(row)
            const id = integers.widen(aliasId(row))

            current.valid =
                id < current.input.table.kinds.length &&
                declared({
                    source_text: current.input.source_text,
                    native: current.input.native,
                    syntax: current.input.syntax,
                    name,
                    kind: DeclarationKind.Alias
                })

            if (current.valid) {
                current.valid = findAlias({
                    aliases,
                    name,
                    end: current.index
                }) == null
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
