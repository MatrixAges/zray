import valid from "../../../constants/valid"
import findAlias from "../../../semantic/resolving/alias"
import declared from "./declared"
import { DeclarationKind } from "./model"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const constants = in.constants

    if (constants == null) {
        return true
    }

    if (!valid({
        constants,
        types: {
            base: in.table,
            delta: {
                kinds: [],
                first: [],
                second: [],
                labels: [],
                children: [],
                field_types: [],
                field_names: [],
                names: []
            }
        }
    })) {
        return false
    }

    const { aliases } = in

    const alias_count = aliases.row_count + aliases.names.length

    return loop({
        input: in,
        names: constants.names,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.names.length,
        next: current => {
            const name = current.names[current.index]

            current.valid = declared({
                source_text: current.input.source_text,
                native: current.input.native,
                syntax: current.input.syntax,
                name,
                kind: DeclarationKind.Constant
            })

            if (current.valid) {
                current.valid = findAlias({
                    aliases,
                    name,
                    end: alias_count
                }) == null
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
