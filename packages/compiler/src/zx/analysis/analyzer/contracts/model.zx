import type { Contracts } from "core/contract_table/model"
import type { Contract } from "../../../frontend/parser/header/model"
import type { Aliases } from "../../semantic/resolving/model"
import type { Source } from "../expressions/request"
import type { Prepared } from "../model"
import type { PredicateOutput } from "./predicate/model"

export type ContractWork = {
    state: Prepared,
    source: Source,
    items: Contract[],
    aliases: Aliases,
    contracts: Contracts
}

export type Output = ContractWork.Pick("state", "contracts")

export type Traversal = {
    work: ContractWork,
    index: u64,
    running: bool
}

export type Publication = {
    traversal: Traversal,
    result: PredicateOutput
}
