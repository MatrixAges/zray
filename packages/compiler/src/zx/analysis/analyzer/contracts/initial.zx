import type { Contract } from "../../../frontend/parser/header/model"
import type { Source } from "../expressions/request"
import type { Prepared } from "../model"
import type { ContractWork } from "./model"

export type Input = {
    state: Prepared,
    source: Source,
    items: Contract[],
    names: string[],
    types: u32[]
}

export type Output = ContractWork

export default function (in: Input): Output {
    const aliases = in.state.types.context.aliases

    return {
        state: in.state,
        source: in.source,
        items: in.items,
        aliases: match {
            in.items.length == 0 => aliases,
            _ => {
                ...aliases,
                names: aliases.names.concat(in.names)[0],
                ids: aliases.ids.concat(in.types)[0]
            }
        },
        contracts: {
            kinds: [],
            predicates: [],
            symbols: [],
            expressions: [],
            span_start: [],
            span_end: []
        }
    }
}
