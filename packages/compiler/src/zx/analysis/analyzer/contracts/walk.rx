<Module>
    <Type from="model" as="Contracts" />

    <Args in={Contracts.ContractWork} out={Contracts.Output} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                work: $in,
                index: 0,
                running: $in.items.length != 0 && $in.state.diagnostic.message == ""
            }}
        />
    </Loop>

    <Return
        value={$ctx.advance.work.pick([
            "state",
            "contracts"
        ])}
    />
</Module>
