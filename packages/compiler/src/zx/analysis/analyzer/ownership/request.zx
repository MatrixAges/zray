import { Ownership } from "core/symbol_table/model"

import type { FunctionColumns, Program } from "../../../ownership/ir/input_model"
import type { Functions } from "../functions"
import type { Prepared } from "../model"

export type Input = {
    state: Prepared,
    root?: u32,
    functions: Functions,
    type_only: bool
}

export type Output = Program

export default function (in: Input): Output {
    const suffix: FunctionColumns? = match {
        in.state.local.self_function == null => null,
        _ => {
            ownership: [Ownership.Borrowed],
            stores: [in.state.local.stores]
        }
    }

    return {
        types: {
            base: in.state.types.context.base,
            delta: in.state.types.delta
        },
        symbols: in.state.local.symbols,
        expressions: in.state.local.expressions,
        control: in.state.local.control,
        body: in.root,
        functions: {
            base: {
                ownership: in.functions.ownership,
                stores: in.functions.stores
            },
            suffix
        },
        type_only: in.type_only
    }
}
