<Module>
    <Type from="model" as="Statements" />

    <Args in={Statements.Body} out={Statements.Body} />

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                body: $in,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.step.body} />
</Module>
