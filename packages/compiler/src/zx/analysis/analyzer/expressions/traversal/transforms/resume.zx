
import { Phase, Action } from "../model"
import callback from "./callback"

import type { Work } from "../model"

export type Input = {
    work: Work,
    action: Action
}

export type Output = Work

export default function (in: Input): Output {
    const work = in.work
    const position = work.frames.transforms.length - 1
    const frame = work.frames.transforms[position]

    if (in.action == Action.TransformSecond) {
        return callback({
            ...work,
            frames: {
                ...work.frames,
                transforms: work.frames.transforms.splice(position, 1, [{
                    ...frame,
                    second: work.value
                }])[0]
            }
        })
    }

    return {
        ...work,
        phase: Phase.Transform
    }
}
