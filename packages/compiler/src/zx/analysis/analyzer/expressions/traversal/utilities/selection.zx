import integers from "std:integer"
import { Kind } from "core/type_table/model"
import row from "core/type_table/row"

import select from "../../selection/select"
import { object_message, type_code } from "../../utilities/const"

import type { Span } from "../../../../../frontend/lexer/token_model"
import type { Result as Output } from "../../model"
import type { Work } from "../model"

export type Input = {
    work: Work,
    node: u64,
    span: Span,
    target: u32,
    omit: bool
}

export default function (in: Input): Output {
    const { work, node, span, target, omit } = in

    const resolved = row({
        tables: {
            base: work.state.types.context.base,
            delta: work.state.types.delta
        },
        id: work.state.local.expressions.types[integers.widen(target)]
    })

    if (resolved.kind != Kind.Object) {
        return {
            state: {
                ...work.state,
                diagnostic: {
                    code: type_code,
                    message: object_message,
                    start: span.start,
                    end: span.end
                }
            },
            value: 0
        }
    }

    return select({
        state: work.state,
        source: work.source,
        node,
        target,
        offset: 1,
        omit
    })
}
