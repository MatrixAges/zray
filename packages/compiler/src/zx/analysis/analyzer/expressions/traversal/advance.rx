<Module>
    <Type from="model" as="Expressions" />

    <Args in={Expressions.Work} out={Expressions.Work} />

    <Loop on={$in.running}>
        <Call
            module="next"
            in={{
                work: $in,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.next.work} />
</Module>
