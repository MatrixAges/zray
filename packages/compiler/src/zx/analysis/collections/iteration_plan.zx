import { TransformKind } from "core/expression_table/kinds"

export enum Initial {
    Empty,
    True,
    False,
    Given,
    First
}

export enum Condition {
    Bound,
    WhileTrue,
    WhileFalse
}

export enum Update {
    Append,
    Filter,
    Replace
}

export enum Result {
    Value,
    Source,
    Unit,
    SourceAndValue,
    ValueAndUnit
}

export type Input = {
    kind: TransformKind,
    has_initial: bool,
    tuple_result: bool,
    projection?: u64
}

export type Output = {
    initial: Initial,
    condition: Condition,
    update: Update,
    accumulator: bool,
    result: Result
}

export default function (in: Input): Output {
    const accumulator = in.kind == TransformKind.Reduce
    const reduction_initial = in.has_initial ? Initial.Given : Initial.First

    const initial = match in.kind {
        TransformKind.Reduce => reduction_initial,
        TransformKind.Every => Initial.True,
        TransformKind.Some => Initial.False,
        _ => Initial.Empty
    }

    const condition = match in.kind {
        TransformKind.Every => Condition.WhileTrue,
        TransformKind.Some => Condition.WhileFalse,
        _ => Condition.Bound
    }

    const update = match in.kind {
        TransformKind.Map => Update.Append,
        TransformKind.Filter => Update.Filter,
        _ => Update.Replace
    }

    const pair = accumulator ? Result.SourceAndValue : Result.ValueAndUnit

    const result = match {
        !in.tuple_result => Result.Value,
        in.projection == null => pair,
        accumulator && in.projection == 0 => Result.Source,
        !accumulator && in.projection == 1 => Result.Unit,
        _ => Result.Value
    }

    return {
        initial,
        condition,
        update,
        accumulator,
        result
    }
}
