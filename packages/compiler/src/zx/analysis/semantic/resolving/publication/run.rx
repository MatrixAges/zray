<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Names} out={u32[]?} />

    <If on={$in.cache.names.length == 0}>
        <Return value={null} />
    </If>

    <Call fn="prepare" in={$in} />

    <Call
        fn="index_suffix"
        in={{
            ...$in,
            rebuilt: $ctx.prepare
        }}
    />

    <Return value={$ctx.index_suffix} />
</Module>
