import integers from "std:integer"
import { load_denominator, load_numerator } from "core/bytes/index/const"
import capacityFor from "core/bytes/map/capacity"
import { max_u32 } from "core/const"
import memory from "memory"

import { linear_name_limit } from "./const"

import type { Names as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const required = in.first + in.cache.names.length
    const limit = integers.widen(max_u32)

    memory.requireAllocation(required <= limit)

    const capacity = in.buckets.length

    return match {
        required <= linear_name_limit => capacity,
        required > capacity * load_numerator / load_denominator =>
            capacityFor(integers.narrow(required)).capacity,
        _ => capacity
    }
}
