import integers from "std:integer"
import refresh from "core/bytes/index/borrowed/refresh"
import { reserve } from "core/column_ranges"
import { max_u32 } from "core/const"
import memory from "memory"

import { linear_name_limit } from "./const"

import type { Names as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { destination, cache } = in
    const { first, index, scratch, resource, ranges } = destination

    const required = first + cache.names.length
    const limit = integers.widen(max_u32)

    memory.requireAllocation(required <= limit)

    if (required > linear_name_limit) {
        const capacity = memory.u32Views(index.buckets).length

        const prepared = refresh({
            ...index,
            scratch,
            count: first,
            indexed: capacity == 0 ? 0 : first,
            required,
            capacity
        })
    }

    reserve({
        resource,
        ranges,
        limit,
        precise: false,
        uniform: true
    })
}
