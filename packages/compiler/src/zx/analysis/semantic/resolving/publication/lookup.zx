import probe from "core/bytes/index/borrowed/probe_slice"

import type { Index } from "./model"

export type Input = Index & {
    names: string[],
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    const { names, keys, buckets, name } = in

    if (buckets.length == 0) {
        return loop({
            row: 0,
            found: false
        }, {
            while: state => !state.found && state.row < names.length,
            next: state => {
                state.found = names[state.row] == name
                state.row += 1
            },
            return: state => state.found ? state.row - 1 : null
        })
    }

    const result = probe({
        keys,
        buckets,
        text: name
    })

    const entry = result.entry

    return entry == 0 ? null : entry - 1
}
