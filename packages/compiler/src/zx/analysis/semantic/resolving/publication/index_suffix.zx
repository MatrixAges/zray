import integers from "std:integer"
import emptyIndex from "core/integer/wide_index/empty"
import insert from "core/integer/wide_index/insert"

import probe from "./pending_slot"

import type { Changes as Output, Names as Input } from "./model"

export default function (in: Input): Output {
    const { keys, buckets, cache, first } = in

    const entries: u32[] = []

    return loop({
        offset: 0,
        pending: emptyIndex({}),
        entries
    }, {
        while: state => state.offset < cache.names.length,
        next: state => {
            const slot = probe({
                keys,
                buckets,
                pending: state.pending,
                entries: state.entries,
                name: cache.names[state.offset]
            })

            const staged = insert({
                index: state.pending,
                key: slot
            })

            const entry = integers.narrow(first + state.offset + 1)

            state.entries = match {
                staged.found => state.entries.with(staged.position, entry),
                _ => state.entries.push(entry)[0]
            }
            state.pending = staged.index
            state.offset += 1
        },
        return: state => ({
            slots: state.pending.keys,
            entries: state.entries
        })
    })
}
