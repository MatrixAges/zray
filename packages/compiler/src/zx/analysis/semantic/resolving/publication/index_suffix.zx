import refresh from "core/bytes/index/borrowed/refresh"
import memory from "memory"

import type { Suffix as Input } from "./model"

export type Output = u32[]?

export default function (in: Input): Output {
    const { destination, cache } = in
    const { index, first } = destination

    const rebuilt = in.rebuilt

    const capacity = match {
        rebuilt != null => rebuilt.length,
        _ => memory.u32Views(index.buckets).length
    }

    if (capacity != 0) {
        const keys = memory.bindTextView(index.keys, destination.committed, null)

        const count = first + cache.names.length

        const indexed = refresh({
            keys,
            buckets: index.buckets,
            rebuilt,
            count,
            indexed: first,
            required: count,
            capacity
        })

        return indexed.buckets
    }

    return rebuilt
}
