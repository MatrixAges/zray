import type { TextColumn } from "memory"
import type { Cache } from "../model"

export type Index = {
    keys: TextColumn,
    buckets: u32[]
}

export type Names = Index & {
    cache: Cache,
    first: u64
}

export type Rebuild = {
    keys: TextColumn,
    count: u64,
    capacity: u64
}

export type Changes = {
    slots: u64[],
    entries: u32[]
}

export type Output = {
    rebuilt?: u32[],
    changes?: Changes
}
