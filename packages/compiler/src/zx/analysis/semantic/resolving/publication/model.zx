import type {
    Allocator,
    ColumnRanges,
    StringBuffer,
    TextColumnBuffer,
    U32Buffer,
    U32Scratch
} from "memory"
import type { Input as TypePublication } from "../../merging/publication/model"
import type { Cache } from "../model"

export type Index = {
    keys: TextColumnBuffer,
    buckets: U32Buffer
}

export type Destination = {
    committed: StringBuffer,
    names: StringBuffer,
    ids: U32Buffer,
    ranges: ColumnRanges,
    index: Index,
    scratch: U32Scratch,
    resource: Allocator,
    first: u64
}

export type Names = {
    cache: Cache,
    destination: Destination
}

export type Input = Names & {
    types?: TypePublication
}
