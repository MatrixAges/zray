import type { StringBuffer, TextColumnBuffer, U32Buffer } from "memory"
import type { Input as TypePublication } from "../../merging/publication/model"
import type { Cache } from "../model"

export type Index = {
    keys: TextColumnBuffer,
    buckets: U32Buffer
}

export type Destination = {
    committed: StringBuffer,
    index: Index,
    first: u64
}

export type Names = {
    cache: Cache,
    destination: Destination
}

export type Input = Names & {
    types?: TypePublication
}

export type Suffix = Names & {
    rebuilt?: u32[]
}
