import findAlias from "../alias"
import nameAt from "../alias_name"
import builtin from "../builtin"
import fail from "../fail"
import count from "../source/count"
import declaration from "../source/declaration"
import find from "../source/find"

import type { Aliases, State } from "../model"

export type Input = {
    state: State,
    index: u64,
    aliases: Aliases
}

export type Output = State

export default function (in: Input): Output {
    const { aliases } = in

    const name = nameAt({
        aliases,
        row: in.index
    })

    if (builtin(name) != 0 || name == "Array") {
        return fail({
            state: in.state,
            code: "name",
            message: "an imported type cannot replace a built-in type",
            name: {
                text: name,
                start: 0,
                end: 0
            }
        })
    }

    if (findAlias({
        aliases,
        name,
        end: in.index
    }) != null) {
        return fail({
            state: in.state,
            code: "name",
            message: "duplicate imported type name",
            name: {
                text: name,
                start: 0,
                end: 0
            }
        })
    }

    const found = find({
        source: in.state.context.source,
        name,
        limit: count(in.state.context.source)
    })

    if (found.found) {
        const selected = declaration({
            source: in.state.context.source,
            index: found.index
        })

        return fail({
            state: in.state,
            code: "name",
            message: "a local type cannot replace an imported type",
            name: selected.name
        })
    }

    return in.state
}
