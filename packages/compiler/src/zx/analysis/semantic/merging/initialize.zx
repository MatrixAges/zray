import integers from "std:integer"

export type Input = {
    kinds: u8[],
    first: u64,
    source_first: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const { kinds, first, source_first } = in

    const suffix = kinds.map(
        (kind, index) => index + source_first < first ? integers.narrow(index) : 0
    )[0]

    if (source_first == 0) {
        return suffix
    }

    const prefix: u32[] = []

    return loop({
        index: 0,
        mapping: prefix
    }, {
        while: state => state.index < source_first,
        next: state => {
            state.mapping = state.mapping.push(integers.narrow(state.index))[0]
            state.index += 1
        },
        return: state => state.mapping.concat(suffix)[0]
    })
}
