import integers from "std:integer"

import binding from "../../types/nominal/validation/binding"

import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export type Input = {
    source: Table,
    source_first: u64,
    origins: Bindings,
    names: string[]
}

export type Output = {
    valid: bool,
    indices: u64[]
}

export default function (in: Input): Output {
    const indices: u64[] = in.source.kinds.map(value => 0)[0]

    const result = loop({
        source: in.source,
        origins: in.origins,
        names: in.names,
        indices,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.origins.ids.length,
        next: current => {
            const id = integers.widen(current.origins.ids[current.index])
            const bound = binding({
                table: current.source,
                origins: current.origins,
                names: current.names,
                index: current.index,
                source_first: in.source_first
            })

            if (bound) {
                const row = id - in.source_first
                current.valid = current.indices[row] == 0
                if (current.valid) {
                    current.indices[row] = current.index + 1
                }
            } else {
                current.valid = false
            }

            current.index += 1
        }
    })

    return {
        valid: result.valid,
        indices: result.indices
    }
}
