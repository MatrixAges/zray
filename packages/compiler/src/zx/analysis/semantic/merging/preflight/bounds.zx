import type { Table } from "core/type_table/model"

export type Input = {
    source: Table,
    target: Table,
    first: u64,
    source_first: u64,
    complete: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { first, source_first, source, target, complete } = in

    const valid_start = source_first == 0 || source_first == first
    const fits_source = valid_start && first - source_first <= source.kinds.length
    const fits_target = first <= target.kinds.length
    const valid_complete = !complete || first == target.kinds.length || first == 0

    return (
        - fits_source
        - and fits_target
        - and valid_complete
    )
}
