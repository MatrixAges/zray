import type { State, Status } from "./model"

export type Input = Status

export type Output = State

export default function (in: Input): Output {
    return {
        delta: {
            kinds: [],
            first: [],
            second: [],
            labels: [],
            children: [],
            field_types: [],
            field_names: [],
            names: []
        },
        origins: {
            ids: [],
            kinds: [],
            owners: [],
            members: []
        },
        references: [],
        status: in
    }
}
