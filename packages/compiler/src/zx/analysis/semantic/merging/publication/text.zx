import { OriginText, TextMode } from "./model"

import type { Target, Text } from "./model"

export type Input = Target.Pick("text_mode", "native_owner")

export type Output = Text

export default function (in: Input): Output {
    const { text_mode, native_owner } = in

    const own_labels = text_mode == TextMode.Own ||
        text_mode == TextMode.OwnSharedOrigin

    const origin_text = match {
        !own_labels => OriginText.Borrow,
        native_owner != null => OriginText.Native,
        text_mode == TextMode.OwnSharedOrigin => OriginText.Shared,
        _ => OriginText.Own
    }

    return {
        own_labels,
        own_names: own_labels || text_mode == TextMode.OwnNames,
        origin_text,
        native_owner
    }
}
