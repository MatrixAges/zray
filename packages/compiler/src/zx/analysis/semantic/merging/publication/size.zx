import memory from "memory"

import {
    children_lane,
    field_names_lane,
    field_types_lane,
    first_lane,
    kinds_lane,
    labels_lane,
    names_lane,
    nominal_ids_lane,
    nominal_kinds_lane,
    nominal_members_lane,
    nominal_names_lane,
    nominal_owners_lane,
    second_lane
} from "./const"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("delta", "origins", "destination")

export type Output = void

export default function (in: Input): Output {
    const { delta, origins, destination } = in
    const { ranges, nominal_ranges } = destination

    memory.setColumnRangeCount(ranges, kinds_lane, delta.kinds.length)
    memory.setColumnRangeCount(ranges, first_lane, delta.first.length)
    memory.setColumnRangeCount(ranges, second_lane, delta.second.length)
    memory.setColumnRangeCount(ranges, labels_lane, delta.labels.length)
    memory.setColumnRangeCount(ranges, children_lane, delta.children.length)
    memory.setColumnRangeCount(ranges, field_types_lane, delta.field_types.length)
    memory.setColumnRangeCount(ranges, field_names_lane, delta.field_names.length)
    memory.setColumnRangeCount(ranges, names_lane, delta.names.length)

    if (nominal_ranges != null) {
        memory.setColumnRangeCount(
            nominal_ranges,
            nominal_ids_lane,
            origins.ids.length
        )

        memory.setColumnRangeCount(
            nominal_ranges,
            nominal_kinds_lane,
            origins.kinds.length
        )

        memory.setColumnRangeCount(
            nominal_ranges,
            nominal_owners_lane,
            origins.owners.length
        )

        memory.setColumnRangeCount(
            nominal_ranges,
            nominal_members_lane,
            origins.members.length
        )

        memory.setColumnRangeCount(
            nominal_ranges,
            nominal_names_lane,
            origins.ids.length
        )
    }
}
