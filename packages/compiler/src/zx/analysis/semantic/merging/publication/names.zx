import integers from "std:integer"

import bindNames from "../../../../modules/nominal_origins/bind_names"

import type { Input as Names } from "../../../../modules/nominal_origins/bind_names"

export type Input = Names & {
    own_labels: bool
}

export type Output = {
    values: string[],
    label_rows: u64?[]
}

export default function (in: Input): Output {
    const { origin_ids, base_labels, delta_labels, own_labels } = in

    const count = base_labels.length

    const values = bindNames({
        origin_ids,
        base_labels,
        delta_labels
    })

    const label_rows = match {
        own_labels => origin_ids.map(
            origin_id => {
                const id = integers.widen(origin_id)
                const row: u64? = id < count ? null : id - count

                return row
            }
        )[0],
        _ => []
    }

    return {
        values,
        label_rows
    }
}
