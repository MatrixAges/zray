import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Offsets } from "./first"

export enum TextMode {
    Own,
    Borrow,
    OwnNames,
    OwnSharedOrigin
}

export enum OriginText {
    Borrow,
    Own,
    Shared,
    Native
}

export type Target = {
    offsets?: Offsets,
    base_labels: string[],
    text_mode: TextMode,
    native_owner?: string
}

export type Input = Target & {
    delta: Table,
    origins: Bindings
}

export type Text = {
    own_labels: bool,
    own_names: bool,
    origin_text: OriginText,
    native_owner?: string
}

export type Plan = {
    delta: Table,
    origins: Bindings,
    nominal_names: string[],
    label_rows: u64?[],
    text: Text
}
