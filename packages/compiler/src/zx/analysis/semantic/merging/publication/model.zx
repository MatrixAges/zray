import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Offsets } from "core/type_table/write_first"
import type {
    Allocator,
    ColumnRanges,
    StringBuffer,
    StringViews,
    U8Buffer,
    U32Buffer,
    U64Buffer
} from "memory"

export enum TextMode {
    Own,
    Borrow,
    OwnNames,
    OwnSharedOrigin
}

export type TypeTail = {
    kinds: U8Buffer,
    first: U32Buffer,
    second: U32Buffer,
    labels: StringBuffer,
    children: U32Buffer,
    field_types: U32Buffer,
    field_names: StringBuffer,
    names: StringBuffer
}

export type NominalTail = {
    ids: U32Buffer,
    kinds: U8Buffer,
    owners: StringBuffer,
    members: StringBuffer,
    names: StringBuffer
}

export type Destination = {
    ranges: ColumnRanges,
    nominal_ranges?: ColumnRanges,
    resource: Allocator,
    precise: bool
}

export type Target = {
    target: TypeTail,
    nominal: NominalTail,
    offsets?: Offsets,
    base_labels: StringViews,
    text_mode: TextMode,
    native_owner?: string,
    progress: U64Buffer,
    destination: Destination,
    payload: Allocator
}

export type Input = Target & {
    delta: Table,
    origins: Bindings
}

export type Text = Input.Pick(
    "delta",
    "origins",
    "target",
    "nominal",
    "text_mode",
    "native_owner",
    "progress",
    "payload"
)

export type Payload = Input.Pick("delta", "origins", "target", "nominal")
