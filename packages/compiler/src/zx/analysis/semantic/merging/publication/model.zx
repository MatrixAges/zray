import type { StringBuffer, U64Buffer } from "memory"
import type { Input as Writes } from "../../../../ir/columns/write"
import type { Input as BindNames } from "../../../../modules/nominal_origins/bind_names"
import type { Input as Rebase } from "../rebase"

export type Column = {
    source: string[],
    target: StringBuffer
}

export type Text = {
    columns: Column[],
    progress: U64Buffer
}

export type Input = Text & Rebase & BindNames & Writes
