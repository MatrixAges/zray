import { publish } from "core/column_ranges"
import memory from "memory"

import { progress_slot } from "./const"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("destination", "progress")

export type Output = void

export default function (in: Input): Output {
    const { ranges, nominal_ranges } = in.destination

    publish(ranges)

    if (nominal_ranges != null) {
        publish(nominal_ranges)
    }

    memory.writeU64(in.progress, progress_slot, 0)
}
