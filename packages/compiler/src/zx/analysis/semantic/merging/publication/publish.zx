import memory from "memory"

import { progress_slot } from "./const"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("destination", "progress")

export type Output = void

export default function (in: Input): Output {
    const { ranges, nominal_ranges, elements, nominal_elements } = in.destination

    memory.publishTypeRanges(ranges, elements)

    if (nominal_ranges != null) {
        memory.publishNominalRanges(nominal_ranges, nominal_elements)
    }

    memory.writeU64(in.progress, progress_slot, 0)
}
