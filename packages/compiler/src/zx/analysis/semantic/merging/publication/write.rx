<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={void} />

    <Call
        fn="text"
        in={$in.pick([
            "columns",
            "progress"
        ])}
    />

    <Call
        fn="../rebase"
        in={$in.pick([
            "kinds",
            "first",
            "target",
            "children",
            "fields",
            "names"
        ])}
    />

    <Call
        fn="../../../../modules/nominal_origins/bind_names"
        in={$in.pick([
            "origin_ids",
            "base_labels",
            "delta_labels",
            "origin_names_out"
        ])}
    />

    <Call fn="../../../../ir/columns/write" in={$in.pick(["writes"])} />
</Module>
