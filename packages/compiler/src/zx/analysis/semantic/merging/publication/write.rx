<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={void} />

    <Call
        fn="text"
        in={$in.pick([
            "delta",
            "origins",
            "target",
            "nominal",
            "text_mode",
            "progress"
        ])}
    />

    <Call
        fn="first"
        in={{
            kinds: $in.delta.kinds,
            first: $in.delta.first,
            target: $in.target.first,
            offsets: $in.offsets
        }}
    />

    <Call
        fn="payload"
        in={$in.pick([
            "delta",
            "origins",
            "target",
            "nominal"
        ])}
    />

    <Call
        fn="../../../../modules/nominal_origins/bind_names"
        in={{
            origin_ids: $in.origins.ids,
            base_labels: $in.base_labels,
            delta_labels: $in.delta_labels,
            origin_names_out: $in.nominal.names
        }}
    />
</Module>
