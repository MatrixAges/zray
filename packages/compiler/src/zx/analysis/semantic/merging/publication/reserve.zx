import integers from "std:integer"
import { reserve } from "core/column_ranges"
import { max_u32 } from "core/const"

import type { Destination } from "./model"

export type Input = Destination

export type Output = void

export default function (in: Input): Output {
    const { resource, ranges, nominal_ranges, precise } = in

    if (nominal_ranges != null) {
        reserve({
            resource,
            ranges: nominal_ranges,
            precise: false,
            uniform: true
        })
    }

    const limit: u64? = precise ? null : integers.widen(max_u32)

    reserve({
        resource,
        ranges,
        limit,
        precise,
        uniform: false
    })
}
