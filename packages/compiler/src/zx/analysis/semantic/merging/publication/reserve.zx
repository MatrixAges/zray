import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { Destination } from "./model"

export type Input = Destination

export type Output = void

export default function (in: Input): Output {
    const { resource, ranges, nominal_ranges, elements, nominal_elements, precise } = in

    if (nominal_ranges != null) {
        memory.reserveNominalRanges(resource, nominal_ranges, nominal_elements)
    }

    const limit: u64? = precise ? null : integers.widen(max_u32)

    memory.reserveTypeRanges(resource, ranges, elements, limit, precise)
}
