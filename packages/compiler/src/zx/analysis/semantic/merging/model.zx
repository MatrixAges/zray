import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Allocator, U32Buffer } from "memory"
import type { Input as Shape } from "../types/validation/shape"

export type Request = {
    source: Table
    origins: Bindings
    origin_indices: u64[]
    base: Table
    base_origins: Bindings
    mapping: U32Buffer
    first: u64
    checked: bool
}

export enum Status {
    Ready,
    MissingOrigin,
    Conflict,
    Invalid
}

export type State = {
    delta: Table
    origins: Bindings
    references: u32[]
    status: Status
}

export type Input = {
    request: Request,
    state: State
}

export type Preparation = {
    request: Request.Omit("origin_indices"),
    names: string[],
    complete: bool,
    validation?: Shape.Pick("maximum_count", "scalar_count"),
    resource?: Allocator
}
