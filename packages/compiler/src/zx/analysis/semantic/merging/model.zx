import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Input as Shape } from "../types/validation/shape"
import type { Plan, Target as Publication } from "./publication/model"

export type Request = {
    source: Table
    origins: Bindings
    origin_indices: u64[]
    base: Table
    base_origins: Bindings
    first: u64
    source_first: u64
    checked: bool
}

export enum Status {
    Ready,
    MissingOrigin,
    Conflict,
    Invalid
}

export type State = {
    delta: Table
    origins: Bindings
    mapping: u32[],
    references: u32[]
    status: Status
}

export type Input = {
    request: Request,
    state: State
}

export type Preparation = {
    request: Request.Omit("origin_indices"),
    names: string[],
    complete: bool,
    validation?: Shape.Pick("maximum_count", "scalar_count")
}

export type Append = {
    preparation: Preparation,
    publication: Publication
}

export type Registration = {
    status: Status,
    mapping: u32[],
    publication?: Plan
}
