import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export type Input = {
    table: Table,
    origins: Bindings,
    names: string[],
    index: u64
    source_first: u64
}

export type Output = bool

export default function (in: Input): Output {
    const id = integers.widen(in.origins.ids[in.index])

    if (id < in.source_first) {
        return false
    }

    const row = id - in.source_first

    if (row >= in.table.kinds.length) {
        return false
    }

    const type_kind = kind(in.table.kinds[row])

    const condition = match type_kind {
        Kind.Enumeration => false,
        Kind.NativeReference => in.origins.kinds[in.index] != 1,
        _ => true
    }

    if (condition) {
        return false
    }

    return in.table.labels[row] == in.names[in.index]
}
