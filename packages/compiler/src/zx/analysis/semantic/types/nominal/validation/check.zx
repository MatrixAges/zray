import binding from "./binding"
import unique from "./unique"

import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"

export type Input = {
    table: Table,
    origins: Bindings,
    names: string[],
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const valid = binding({
        ...in,
        source_first: 0
    })

    return valid && unique({
        origins: in.origins,
        names: in.names,
        index: in.index
    })
}
