import integers from "std:integer"
import code from "core/type_table/code"
import { Kind } from "core/type_table/model"

import type { Table } from "core/type_table/model"
import type { Candidate, Search } from "./model"

export type Input = {
    table: Table,
    candidate: Candidate,
    offset: u64,
    previous: u32
}

export type Output = Search

export default function (in: Input): Output {
    const { table, candidate } = in

    const expected = code(candidate.kind)
    const rows = table.kinds.length
    const task = candidate.kind == Kind.Task

    const direct = match candidate.kind {
        Kind.Scalar => true,
        Kind.Optional => true,
        Kind.List => true,
        Kind.Task => true,
        _ => false
    }

    const count = match candidate.kind {
        Kind.Object => candidate.fields.names.length,
        Kind.Tuple => candidate.children.length,
        Kind.ErrorSet => candidate.names.length,
        _ => 0
    }

    const state = loop({
        index: 0,
        found: false,
        id: in.previous
    }, {
        while: current => !current.found && current.index < rows,
        next: current => {
            const index = current.index
            const same_kind = table.kinds[index] == expected
            const same_shape = match {
                !same_kind => false,
                direct => table.first[index] == candidate.first,
                _ => integers.widen(table.second[index]) == count
            }

            if (same_shape) {
                if (direct) {
                    current.found = !task || table.second[index] == candidate.second
                } else {
                    const first = integers.widen(table.first[index])
                    const matched = loop(0, {
                        while: item => {
                            const offset = first + item

                            return match {
                                item >= count => false,
                                _ => match candidate.kind {
                                    Kind.Object =>
                                        table.field_names[offset] ==
                                        candidate.fields.names[item] &&
                                        table.field_types[offset] ==
                                        candidate.fields.types[item],
                                    Kind.Tuple =>
                                        table.children[offset] ==
                                        candidate.children[item],
                                    _ => table.names[offset] == candidate.names[item]
                                }
                            }
                        },
                        next: item => {
                            item += 1
                        }
                    })

                    current.found = matched == count
                }

                current.id = integers.narrow(in.offset + index)
            }

            current.index += 1
        }
    })

    return {
        found: state.found,
        id: state.id
    }
}
