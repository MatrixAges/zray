import { Kind } from "core/type_table/model"

import scan from "./scan"

import type { Tables } from "core/type_table/model"
import type { Candidate, Search } from "./model"

export type Input = {
    tables: Tables,
    candidate: Candidate
}

export type Output = Search

export default function (in: Input): Output {
    const { tables, candidate } = in

    if (candidate.kind == Kind.Enumeration || candidate.kind == Kind.NativeReference) {
        return {
            found: false,
            id: 0
        }
    }

    const base = scan({
        table: tables.base,
        candidate,
        offset: 0,
        previous: 0
    })

    if (base.found) {
        return base
    }

    return scan({
        table: tables.delta,
        candidate,
        offset: tables.base.kinds.length,
        previous: base.id
    })
}
