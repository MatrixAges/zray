import { Kind } from "core/type_table/model"

import type { Entry } from "./model"

export type Input = {
    left: Entry,
    right: Entry
}

export type Output = bool

export default function (in: Input): Output {
    const kind = in.left.kind

    if (kind != in.right.kind) {
        return false
    }

    const first_only = match kind {
        Kind.Scalar => true,
        Kind.Optional => true,
        Kind.List => true,
        _ => false
    }

    if (first_only) {
        return in.left.first == in.right.first
    }

    if (kind == Kind.Task) {
        return in.left.first == in.right.first && in.left.second == in.right.second
    }

    if (kind == Kind.NativeReference) {
        return in.left.label == in.right.label && in.left.first == in.right.first
    }

    if (kind == Kind.Enumeration && in.left.label != in.right.label) {
        return false
    }

    const count = in.left.count

    if (count != in.right.count) {
        return false
    }

    const matched = loop(0, {
        while: index => {
            const a = in.left.offset + index
            const b = in.right.offset + index

            return match {
                index >= count => false,
                _ => match kind {
                    Kind.Object =>
                        in.left.field_names[a] == in.right.field_names[b] &&
                        in.left.field_types[a] == in.right.field_types[b],
                    Kind.Tuple => in.left.children[a] == in.right.children[b],
                    _ => in.left.names[a] == in.right.names[b]
                }
            }
        },
        next: index => {
            index += 1
        }
    })

    return matched == count
}
