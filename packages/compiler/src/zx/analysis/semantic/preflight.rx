<Module>
    <Type from="merging/origin" as="Origin" />
    <Type from="constructing/delta" as="Delta" />
    <Type from="types/validation/shape" as="Shape" />

    <Args
        in={{
            first: u64,
            source_first: u64,
            complete: bool,
            names: string[],
            origins: Origin.Output,
            source: Delta.Output,
            target: Delta.Output,
            validation?: Shape.Input.Pick("maximum_count", "scalar_count")
        }}
        out={u64[]?}
    />

    <If on={$in.validation != null}>
        <Call
            module="validate_types"
            in={{
                ...$in.validation,
                table: $in.source,
                trusted: false,
                prefix: null
            }}
        />

        <If on={!$ctx.validate_types}>
            <Return value={null} />
        </If>
    </If>

    <Call
        fn="types/nominal/shape"
        in={{
            origins: $in.origins,
            names: $in.names
        }}
    />

    <If on={$ctx.shape}>
        <Call
            fn="merging/preflight/origins"
            in={$in.pick([
                "source",
                "source_first",
                "origins",
                "names"
            ])}
        />

        <If on={$ctx.origins.valid}>
            <Call
                fn="merging/preflight/bounds"
                in={$in.pick([
                    "source",
                    "target",
                    "first",
                    "source_first",
                    "complete"
                ])}
            />

            <If on={$ctx.bounds}>
                <Return value={$ctx.origins.indices} />

                <Else>
                    <Return value={null} />
                </Else>
            </If>

            <Else>
                <Return value={null} />
            </Else>
        </If>

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
