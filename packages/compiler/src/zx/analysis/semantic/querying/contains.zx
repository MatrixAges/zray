import integers from "std:integer"
import { Kind } from "core/type_table/model"

import firstTarget from "./first_target"
import scan from "./scan"

import type { Tables } from "core/type_table/model"

export type Input = {
    tables: Tables,
    id: u32,
    native_references: bool
}

export type Output = bool

export default function (in: Input): Output {
    const index = integers.widen(in.id)
    const target = in.native_references ? Kind.NativeReference : Kind.List

    const first = firstTarget({
        base: in.tables.base.kinds,
        delta: in.tables.delta.kinds,
        id: in.id,
        target
    })

    if (first == null) {
        return false
    }

    if (first == index) {
        return true
    }

    return scan({
        tables: in.tables,
        first,
        limit: index + 1,
        native_references: in.native_references
    })
}
