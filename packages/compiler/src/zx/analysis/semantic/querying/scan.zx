import row from "./row"

import type { Tables } from "core/type_table/model"

export type Input = {
    tables: Tables,
    first: u64,
    limit: u64,
    native_references: bool
}

export type Output = bool

export default function (in: Input): Output {
    const flags: bool[] = []

    return loop({
        tables: in.tables,
        index: 0,
        first: in.first,
        limit: in.limit,
        flags,
        native_references: in.native_references
    }, {
        while: current => current.index < current.limit,
        next: current => {
            const found = current.index >= current.first && row({
                tables: current.tables,
                index: current.index,
                flags: current.flags,
                native_references: current.native_references
            })

            current.flags = current.flags.push(found)[0]
            current.index += 1
        },
        return: state => state.flags[state.limit - 1]
    })
}
