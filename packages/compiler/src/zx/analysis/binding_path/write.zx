import { ascii_dot } from "core/ascii/const"
import memory from "memory"

import { ExprKind } from "../../frontend/parser/expressions/state/model"

import type { U8Buffer } from "memory"
import type { ExprNode } from "../../frontend/parser/expressions/state/model"

export type Input = {
    source: u8[],
    nodes: ExprNode[],
    node: u64,
    length: u64,
    target: U8Buffer
}

export type Output = void

export default function (in: Input): Output {
    const written = loop({
        node: in.node,
        end: in.length,
        complete: false
    }, {
        while: state => !state.complete,
        next: state => {
            const node = in.nodes[state.node]
            const span = node.name
            const start = state.end - (span.end - span.start)
            const copied = memory.copyBytes(
                in.target,
                start,
                in.source,
                span.start,
                span.end
            )

            if (node.kind == ExprKind.Identifier) {
                state.complete = true
            } else {
                state.end = start - 1
                memory.writeU8(in.target, state.end, ascii_dot)
                state.node = node.first
            }
        }
    })
}
