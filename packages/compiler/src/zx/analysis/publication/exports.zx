import strings from "std:string"

export type Row = {
    name: string,
    type_id: u32
}

export type Input = {
    names: string[],
    ids: u32[]
}

export type Output = Row[]

export default function (in: Input): Output {
    return in.names.map((name, index) => ({
        name: strings.copy(name),
        type_id: in.ids[index]
    }))[0]
}
