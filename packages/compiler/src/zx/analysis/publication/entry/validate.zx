import integers from "std:integer"
import memory from "memory"

import { missing_initializer } from "./const"

import type { Input as Entry } from "./model"

export type Input = Entry.Pick("initializer_count", "initializers", "base_count")

export type Output = string?

export default function (in: Input): Output {
    const { initializer_count, initializers, base_count } = in

    const valid = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < initializer_count,
        next: state => {
            const target = memory.readColumnU32(initializers, state.row)

            state.valid = integers.widen(target) < base_count
            state.row += 1
        },
        return: state => state.valid
    })

    return valid ? null : missing_initializer
}
