import type { Symbols } from "core/symbol_table/model"
import type { ReadColumn } from "memory"
import type { Forwarded } from "../../../modules/entry_body/publication/model"

export type Body = Forwarded

export type Input = {
    symbols: Symbols,
    input_type: u32,
    output_type: u32,
    calls: u32[],
    base_count: u64,
    declared: bool,
    type_only: bool,
    resolved: bool,
    native_count: u64,
    check_prefix: bool,
    initializers: ReadColumn,
    initializer_count: u64
}

export type Update = {
    split?: bool,
    own_natives?: bool,
    check_prefix?: bool,
    issue?: string,
    forwarded?: Body
}
