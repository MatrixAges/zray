import host from "project_host"

import type { AnalysisEntry } from "project_host"

export type Input = {
    entry: AnalysisEntry,
    recursive?: u32,
    forward: bool
}

export type Output = u32?

export default function (in: Input): Output {
    const { recursive } = in

    if (!in.forward || recursive == null) {
        return null
    }

    host.forwardAnalysisEntry(in.entry, recursive)

    return recursive
}
