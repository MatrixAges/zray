<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={u32?} />

    <Call fn="register" in={$in} />
    <Call fn="validate" in={$in} />

    <If on={!$ctx.validate}>
        <Return value={null} />
    </If>

    <If on={!$in.resolved && $ctx.register != null}>
        <Call
            fn="../../../modules/forward_entry/recursive_request"
            in={{
                symbols: $in.symbols,
                input_type: $in.input_type,
                output_type: $in.output_type,
                function_id: $ctx.register
            }}
        />

        <Call module="../../../modules/forward_entry/build" />

        <Call fn="index.borrowForwardedBodyBytes" />

        <Call
            fn="index.writeForwardedBody"
            in={[
                $in.program,
                $ctx.borrowForwardedBodyBytes
            ]}
        />

        <Return value={$ctx.register} />
    </If>

    <Return value={null} />
</Module>
