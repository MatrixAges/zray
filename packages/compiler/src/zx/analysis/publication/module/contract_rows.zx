import host from "project_host"

import retain from "../../../modules/artifact/remapping/contracts"

import type { Contracts } from "core/contract_table/model"
import type { AnalysisPublication } from "project_host"

export type Input = {
    publication: AnalysisPublication,
    contracts: Contracts
}

export type Output = Contracts?

export default function (in: Input): Output {
    const { publication, contracts } = in

    const retained: Contracts? = match {
        contracts.kinds.length == 0 => null,
        _ => retain({
            source: contracts
        })
    }

    host.publishAnalysisConstants(publication)

    return retained
}
