<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Store from="pending" as="publication" />

    <Call
        fn="types"
        in={$in.pick([
            "mode",
            "borrow_body"
        ])}
    />

    <If on={$ctx.types != null}>
        <Call
            fn="stage"
            in={$ctx.types}
            setter={[$store.publication.state]}
        />
    </If>

    <Call
        fn="stage"
        in={Publication.Action.AppendTypes}
        setter={[$store.publication.state]}
    />

    <If on={$in.borrow_body}>
        <Return
            value={{
                body: $in.analysis.body,
                contracts: $in.analysis.contracts,
                file_name: $in.file_name
            }}
        />
    </If>

    <Call module="../body" in={$in.analysis.body} />

    <Call
        fn="stage"
        in={Publication.Action.Exports}
        setter={[$store.publication.state]}
    />

    <Call fn="description" in={$in.file_name} />
    <Call fn="contract_rows" in={$in.analysis.contracts} />

    <Call
        fn="stage"
        in={Publication.Action.Constants}
        setter={[$store.publication.state]}
    />

    <Return
        value={{
            body: $ctx.body,
            contracts: $ctx.contract_rows,
            file_name: $ctx.description
        }}
    />
</Module>
