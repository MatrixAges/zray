<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call
        fn="types"
        in={$in.pick([
            "mode",
            "borrow_body"
        ])}
    />

    <If on={$ctx.types != null}>
        <Call
            fn="host.initializeAnalysisTypes"
            in={[
                $in.publication,
                $ctx.types
            ]}
        />
    </If>

    <Call fn="host.appendAnalysisTypes" in={$in.publication} />

    <If on={$in.borrow_body}>
        <Return
            value={{
                body: $in.analysis.body,
                contracts: $in.analysis.contracts,
                file_name: $in.file_name
            }}
        />
    </If>

    <Call module="../body" in={$in.analysis.body} />

    <Call
        fn="description"
        in={$in.pick([
            "publication",
            "file_name"
        ])}
    />

    <Call
        fn="contract_rows"
        in={{
            publication: $in.publication,
            contracts: $in.analysis.contracts
        }}
    />

    <Return
        value={{
            body: $ctx.body,
            contracts: $ctx.contract_rows,
            file_name: $ctx.description
        }}
    />
</Module>
