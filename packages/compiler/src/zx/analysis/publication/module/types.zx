import { Mode } from "../../analyzer/admission/model"
import { Action } from "./model"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("mode", "borrow_body")

export type Output = Action?

export default function (in: Input): Output {
    const { mode, borrow_body } = in

    if (borrow_body || mode == Mode.Project) {
        return null
    }

    return mode == Mode.Resolved ? Action.InitializeBorrowed : Action.InitializeOwned
}
