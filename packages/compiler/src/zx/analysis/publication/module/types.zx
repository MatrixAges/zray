import { Mode } from "../../analyzer/admission/model"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("mode", "borrow_body")

export type Output = bool?

export default function (in: Input): Output {
    const { mode, borrow_body } = in

    return match {
        !borrow_body && mode != Mode.Project => mode == Mode.Resolved,
        _ => null
    }
}
