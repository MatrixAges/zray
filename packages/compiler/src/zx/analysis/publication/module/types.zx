import host from "project_host"

import { Mode } from "../../analyzer/admission/model"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("publication", "mode")

export type Output = void

export default function (in: Input): Output {
    const { mode, publication } = in

    if (mode != Mode.Project) {
        host.initializeAnalysisTypes(publication, mode == Mode.Resolved)
    }

    host.appendAnalysisTypes(publication)
}
