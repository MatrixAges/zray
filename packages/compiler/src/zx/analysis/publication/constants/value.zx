import strings from "std:string"
import { ExpressionKind } from "core/expression_table/kinds"
import columns from "memory/columns"

import type { Literal } from "core/constant/model"
import type { WriteColumn } from "memory/columns"

export type Input = {
    target: WriteColumn,
    row: u64,
    value: Literal
}

export type Output = bool

export default function (in: Input): Output {
    const { target, row, value } = in

    switch (value.kind) {
        case ExpressionKind.Integer:
            columns.writeScalarInteger(target, row, value.integer, value.negative)

            return true
        case ExpressionKind.Float:
            columns.writeScalarFloat(target, row, value.floating)

            return true
        case ExpressionKind.String:
            columns.writeScalarText(target, row, strings.copy(value.text))

            return true
        case ExpressionKind.Boolean:
            columns.writeScalarBoolean(target, row, value.boolean)

            return true
        case ExpressionKind.EnumValue:
            columns.writeScalarEnumeration(target, row, value.enumeration)

            return true
        default:
            return false
    }
}
