import strings from "std:string"
import { ExpressionKind } from "core/expression_table/kinds"

import type { Values } from "core/constant/model"

export type Row = {
    name: string,
    type_id: u32,
    kind: ExpressionKind,
    integer: u64,
    negative: bool,
    floating: f64,
    text: string,
    boolean: bool,
    enumeration: u32
}

export type Input = {
    scope?: Values,
    first: u64
}

export type Output = {
    valid: bool,
    rows: Row[]
}

export default function (in: Input): Output {
    const { scope, first } = in

    const empty: Row[] = []

    if (scope == null) {
        return {
            valid: true,
            rows: empty
        }
    }

    const count = scope.names.length - first

    return loop({
        row: 0,
        valid: true,
        rows: empty
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const index = first + state.row
            const value = scope.values[index]
            const supported = match value.kind {
                ExpressionKind.Integer => true,
                ExpressionKind.Float => true,
                ExpressionKind.String => true,
                ExpressionKind.Boolean => true,
                ExpressionKind.EnumValue => true,
                _ => false
            }

            if (supported) {
                const name = strings.copy(scope.names[index])
                const text =
                    value.kind == ExpressionKind.String ? strings.copy(value.text) : ""

                state.rows = state.rows.push({
                    name,
                    type_id: value.type_id,
                    kind: value.kind,
                    integer: value.integer,
                    negative: value.negative,
                    floating: value.floating,
                    text,
                    boolean: value.boolean,
                    enumeration: value.enumeration
                })[0]
                state.row += 1
            } else {
                state.valid = false
            }
        },
        return: state => ({
            valid: state.valid,
            rows: state.rows
        })
    })
}
