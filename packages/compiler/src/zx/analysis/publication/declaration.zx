import strings from "std:string"

import copyOptionalName from "../../modules/copy_optional_name"

export type Input = {
    name: string,
    type_id: u32,
    text?: string
}

export type Output = Input

export default function (in: Input): Output {
    const { name, type_id, text } = in

    const owned = copyOptionalName(text)

    return {
        name: strings.copy(name),
        type_id,
        text: owned
    }
}
