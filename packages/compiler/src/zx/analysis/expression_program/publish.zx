import present from "../../frontend/diagnostic/present"

import type { Analysis, Result } from "./model"

export type Input = Analysis

export type Output = Result

export default function (in: Input): Output {
    const diagnostic = present(in.state.diagnostic)

    return {
        value: in.value,
        type_delta: in.state.types.delta,
        body: {
            stores: in.state.local.stores,
            symbols: in.state.local.symbols,
            expressions: in.state.local.expressions,
            control: in.state.local.control,
            root: diagnostic == null ? in.root : null
        },
        input_type: in.state.input_type,
        output_type: in.state.local.output_type,
        output_ownership: in.ownership,
        diagnostic
    }
}
