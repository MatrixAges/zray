import floats from "std:float"
import { type_id_string, type_id_bool } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"
import { Kind } from "core/type_table/model"
import row from "core/type_table/row"

import maximum from "../../analyzer/expressions/numbers/maximum"
import target from "../../analyzer/expressions/numbers/target"

import type { Literal } from "core/constant/model"
import type { Tables } from "core/type_table/model"

export type Input = Literal.Omit("text", "boolean") & {
    types: Tables
}

export type Output = bool

export default function (in: Input): Output {
    const { type_id, negative, integer, floating, enumeration } = in

    const numeric = target({
        expected: type_id,
        floating: false,
        negative: false
    })

    const type_row = row({
        tables: in.types,
        id: type_id
    })

    const signed = !negative || numeric.signed

    return match in.kind {
        ExpressionKind.Integer => match {
            !numeric.integer => false,
            !signed => false,
            _ => integer <= maximum({
                id: type_id,
                negative
            }),
        },
        ExpressionKind.Float => match {
            !numeric.floating => false,
            !floats.isFinite(floating) => false,
            !numeric.single => true,
            _ => floats.widen(floats.narrow(floating)) == floating,
        },
        ExpressionKind.String =>
            type_row.kind == Kind.Scalar && type_id == type_id_string,
        ExpressionKind.Boolean => type_row.kind == Kind.Scalar && type_id == type_id_bool,
        ExpressionKind.EnumValue =>
            type_row.kind == Kind.Enumeration && enumeration < type_row.second,
        _ => false,
    }
}
