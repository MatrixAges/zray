<Module>
    <Type from="model" as="Surface" />

    <Args in={Surface.Extraction} out={void} />

    <Call module="own" in={$in.exported} />

    <Call
        module="own_constants"
        in={{
            source: $in.imported.constants,
            types: $in.imported.types,
            target: $in.imported.constant_target,
            storage: $in.imported.constant_storage
        }}
    />

    <Call
        module="own_exports"
        in={{
            source: $in.imported.exports,
            types: $in.imported.types,
            imported: true
        }}
    />

    <Task name="imports">
        <Loop on={$in.row < $in.source.count}>
            <Call
                module="next_binding"
                in={{
                    ...$in.function_imports,
                    row: 0,
                    member: false
                }}
            />
        </Loop>
    </Task>

    <Task name="members">
        <Loop on={$in.row < $in.source.count}>
            <Call
                module="next_binding"
                in={{
                    ...$in.members,
                    row: 0,
                    member: true
                }}
            />
        </Loop>
    </Task>
</Module>
