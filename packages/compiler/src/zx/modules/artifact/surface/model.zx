import type { Rows as Constants } from "core/constant/rows"
import type { Rows as Exports } from "../../../ir/canonical/validation/names/model"
import type { Mapping } from "../remapping/model"
import type { Rows as Bindings } from "./bindings"
import type { Input as ConstantInput, Row as ConstantRow } from "./constants"
import type { Output as ExportRow } from "./exports"

export type Input = {
    exports: Exports,
    constants: Constants,
    types: Mapping
}

export type ConstantRequest = ConstantInput & {
    imported: bool
}

export type Published = ExportRow & {
    constants?: ConstantRow[]
}

export type Extraction = {
    exported: Input,
    imported: Input,
    function_imports: Bindings,
    members: Bindings
}
