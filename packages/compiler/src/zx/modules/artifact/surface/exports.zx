import memory from "memory"

import remap from "../remapping/id"

import type { Rows } from "../../../ir/canonical/validation/names/model"
import type { Mapping } from "../remapping/model"

export type Request = {
    source: Rows,
    types: Mapping,
    imported: bool
}

export type Input = Request & {
    row: u64
}

export type Output = {
    name: string,
    id: u32,
    row: u64,
    imported: bool
}

export default function (in: Input): Output {
    const { source, types, row, imported } = in

    const id = remap({
        id: memory.readRowId(source.rows, row),
        mapping: types
    })

    return {
        name: memory.readRowName(source.rows, row),
        id,
        row,
        imported
    }
}
