<Module>
    <Type from="constants" as="Constants" />
    <Type from="allocate_rows" as="Storage" />

    <Args in={Constants.Input & Storage.Input.Pick("storage")} out={void} />

    <If on={$in.source.count != 0}>
        <Call
            fn="allocate_rows"
            in={{
                storage: $in.storage,
                count: $in.source.count
            }}
        />

        <Call fn="constants" in={$in.omit(["storage"])} />
    </If>
</Module>
