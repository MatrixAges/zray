<Module>
    <Type from="model" as="Surface" />

    <Args in={Surface.ConstantRequest} out={void} />

    <Store from="export_rows" as="rows" />

    <If on={$in.source.count != 0}>
        <Call
            fn="constants"
            in={{
                source: $in.source,
                types: $in.types
            }}
        />

        <Call
            fn="commit_export"
            in={{
                name: "",
                id: 0,
                row: 0,
                imported: $in.imported,
                constants: $ctx.constants
            }}
            setter={[$store.rows.pending]}
        />
    </If>
</Module>
