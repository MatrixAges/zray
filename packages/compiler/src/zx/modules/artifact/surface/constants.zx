import {
    scalar_integer,
    scalar_negative_integer,
    scalar_float,
    scalar_string,
    scalar_boolean,
    scalar_enumeration
} from "core/constant/const"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"
import columns from "memory/columns"

import remap from "../remapping/id"

import type { Literal } from "core/constant/model"
import type { Rows } from "core/constant/rows"
import type { Mapping } from "../remapping/model"

export type Row = {
    name: string,
    value: Literal
}

export type Input = {
    source: Rows,
    types: Mapping
}

export type Output = Row[]

export default function (in: Input): Output {
    const { source, types } = in

    const rows: Row[] = []

    return loop({
        row: 0,
        rows
    }, {
        while: state => state.row < source.count,
        next: state => {
            const row = state.row
            const values = source.values
            const kind = columns.readScalarKind(values, row)
            const integer = kind == scalar_integer || kind == scalar_negative_integer

            state.rows = state.rows.push({
                name: memory.readTextColumn(source.names, row),
                value: {
                    type_id: remap({
                        id: columns.readColumnU32(source.types, row),
                        mapping: types
                    }),
                    kind: match kind {
                        scalar_integer => ExpressionKind.Integer,
                        scalar_negative_integer => ExpressionKind.Integer,
                        scalar_float => ExpressionKind.Float,
                        scalar_string => ExpressionKind.String,
                        scalar_boolean => ExpressionKind.Boolean,
                        scalar_enumeration => ExpressionKind.EnumValue,
                        _ => ExpressionKind.None
                    },
                    integer: integer ? columns.readScalarMagnitude(values, row) : 0,
                    negative: kind == scalar_negative_integer,
                    floating: match {
                        kind == scalar_float => columns.readScalarFloat(values, row),
                        _ => 0.0
                    },
                    text: columns.readScalarText(values, row) ?? "",
                    boolean:
                        kind == scalar_boolean &&
                        columns.readScalarBoolean(values, row),
                    enumeration: match {
                        kind == scalar_enumeration =>
                            columns.readScalarEnumeration(values, row),
                        _ => 0
                    }
                }
            })[0]

            state.row += 1
        },
        return: state => state.rows
    })
}
