<Module>
    <Type from="model" as="Surface" />

    <Args in={Surface.Input} out={void} />

    <Call
        module="own_exports"
        in={{
            source: $in.exports,
            types: $in.types,
            imported: false
        }}
    />

    <Call
        module="own_constants"
        in={{
            source: $in.constants,
            types: $in.types,
            imported: false
        }}
    />
</Module>
