import memory from "memory"

import remap from "./binding"

import type { ReadColumn, TextColumn } from "memory"
import type { Mapping } from "../remapping/model"
import type { Output as Binding } from "./binding"

export type Source = {
    name: TextColumn,
    namespace: ReadColumn,
    id: ReadColumn,
    input_type: ReadColumn,
    output_type: ReadColumn,
    intrinsic: ReadColumn,
    count: u64
}

export type Rows = {
    source: Source,
    types: Mapping,
    functions: Mapping
}

export type Input = Rows & {
    row: u64,
    member: bool
}

export type Output = Binding & {
    row: u64,
    member: bool,
    intrinsic?: u8
}

export default function (in: Input): Output {
    const { source, row, types, functions } = in

    const intrinsic = memory.readColumnOptionalU8(source.intrinsic, row)

    const value = remap({
        name: memory.readTextColumn(source.name, row),
        namespace: memory.readOptionalTextColumn(source.namespace, row),
        id: memory.readColumnOptionalU32(source.id, row),
        input_type: memory.readColumnOptionalU32(source.input_type, row),
        output_type: memory.readColumnOptionalU32(source.output_type, row),
        types,
        functions
    })

    return {
        ...value,
        intrinsic,
        row,
        member: in.member
    }
}
