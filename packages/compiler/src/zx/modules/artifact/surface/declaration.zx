import copy from "../../../analysis/publication/declaration"
import remap from "../remapping/id"

import type { Output as Declaration } from "../../../analysis/publication/declaration"
import type { Mapping } from "../remapping/model"

export type Input = Declaration & {
    types: Mapping
}

export type Output = Declaration

export default function (in: Input): Output {
    const owned = copy(in.omit(["types"]))

    return {
        ...owned,
        type_id: remap({
            id: in.type_id,
            mapping: in.types
        })
    }
}
