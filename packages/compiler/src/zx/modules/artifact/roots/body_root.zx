import mark from "./mark"

import type { Body } from "./model"

export type Input = {
    body?: Body,
    roots?: bool[]
}

export type Output = bool[]?

export default function (in: Input): Output {
    const { body, roots } = in

    if (roots == null) {
        return null
    }

    if (body == null) {
        return roots
    }

    const with_ports = mark({
        roots,
        values: [
            body.input_type,
            body.output_type
        ]
    })

    if (with_ports == null) {
        return null
    }

    const with_symbols = mark({
        roots: with_ports,
        values: body.symbols.types
    })

    if (with_symbols == null) {
        return null
    }

    const with_expressions = mark({
        roots: with_symbols,
        values: body.expressions.types
    })

    if (with_expressions == null) {
        return null
    }

    const contracts = body.contracts

    const checked = loop({
        index: 0,
        valid: true,
        roots: with_expressions
    }, {
        while: state => state.valid && state.index < contracts.kinds.length,
        next: state => {
            const symbols = mark({
                roots: state.roots,
                values: contracts.symbols[state.index].types
            })

            if (symbols == null) {
                state.valid = false
            } else {
                const expressions = mark({
                    roots: symbols,
                    values: contracts.expressions[state.index].types
                })

                if (expressions == null) {
                    state.valid = false
                } else {
                    state.roots = expressions
                }
            }

            state.index += 1
        },
        return: state => ({
            valid: state.valid,
            roots: state.roots
        })
    })

    if (!checked.valid) {
        return null
    }

    return mark({
        roots: checked.roots,
        values: body.stores.types
    })
}
