import integers from "std:integer"

import mark from "./mark"

import type { PortShape } from "../../binding/model"
import type { Request } from "./model"

export type Input = {
    request: Request,
    roots: bool[],
    ports: PortShape
}

export type Output = bool[]?

export default function (in: Input): Output {
    const { functions, modules } = in.request
    const { ports } = in

    const index = integers.widen(ports.id ?? 0)

    if (index >= functions.count) {
        return null
    }

    const with_ports = mark({
        roots: in.roots,
        values: [
            ports.input_type ?? 0,
            ports.output_type ?? 0,
            functions.input_types[index],
            functions.output_types[index]
        ]
    })

    if (with_ports == null) {
        return null
    }

    const module = functions.native_modules[index]

    if (module == null) {
        return with_ports
    }

    const native = integers.widen(module)

    if (native >= modules.specifiers.length) {
        return null
    }

    return mark({
        roots: with_ports,
        values: modules.type_ids[native]
    })
}
