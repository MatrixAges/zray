import integers from "std:integer"

export type Input = {
    roots: bool[],
    values: u32[]
}

export type Output = bool[]?

export default function (in: Input): Output {
    const values = in.values
    const count = in.roots.length

    return loop({
        index: 0,
        valid: true,
        roots: in.roots
    }, {
        while: state => state.valid && state.index < values.length,
        next: state => {
            const id = integers.widen(values[state.index])

            state.valid = id < count

            if (state.valid) {
                state.roots[id] = true
            }

            state.index += 1
        },
        return: state => match {
            state.valid => state.roots,
            _ => null
        }
    })
}
