import integers from "std:integer"

import dependency from "./dependency"

import type { Table } from "core/type_table/model"

export type Input = {
    table: Table,
    needed?: bool[]
}

export type Output = bool[]?

export default function (in: Input): Output {
    const { needed } = in

    if (needed == null) {
        return null
    }

    return loop({
        table: in.table,
        needed,
        remaining: needed.length,
        edge: 0,
        valid: true
    }, {
        while: current => current.valid && current.remaining > 0,
        next: current => {
            const index = current.remaining - 1
            const child = match {
                current.needed[index] => dependency({
                    table: current.table,
                    index,
                    edge: current.edge
                }),
                _ => null
            }

            if (child == null) {
                current.remaining -= 1
                current.edge = 0
            } else {
                const child_index = integers.widen(child)

                if (child_index >= current.needed.length) {
                    current.valid = false
                } else {
                    current.needed[child_index] = true
                    current.edge += 1
                }
            }
        },
        return: current => match {
            current.valid => current.needed,
            _ => null
        }
    })
}
