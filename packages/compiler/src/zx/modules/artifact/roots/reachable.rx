<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Selection} out={bool[]?} />

    <Call fn="collect" in={$in.request} />

    <If on={$ctx.collect == null}>
        <Return value={null} />
    </If>

    <Task name="function_imports" out={$ctx.function_root}>
        <Call
            fn="function_root"
            in={{
                request: $in.request,
                roots: $ctx.collect,
                bindings: $in.request.record.function_imports
            }}
        />
    </Task>

    <If on={$ctx.task.function_imports == null}>
        <Return value={null} />
    </If>

    <Call
        fn="function_root"
        in={{
            request: $in.request,
            roots: $ctx.task.function_imports,
            bindings: $in.request.record.function_exports
        }}
    />

    <If on={$ctx.function_root == null}>
        <Return value={null} />
    </If>

    <Call
        fn="native_root"
        in={{
            request: $in.request,
            roots: $ctx.function_root
        }}
    />

    <If on={$ctx.native_root == null}>
        <Return value={null} />
    </If>

    <Call
        fn="body_root"
        in={{
            body: $in.body,
            roots: $ctx.native_root
        }}
    />

    <If on={$ctx.body_root == null}>
        <Return value={null} />
    </If>

    <Call
        fn="closure"
        in={{
            table: $in.request.table,
            needed: $ctx.body_root
        }}
    />

    <Return value={$ctx.closure} />
</Module>
