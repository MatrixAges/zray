import readPorts from "../../binding/read_ports"
import shape from "../../binding/shape"
import markFunction from "./mark_function"

import type { PortRows } from "../../binding/model"
import type { Request } from "./model"

export type Input = {
    request: Request,
    roots?: bool[],
    bindings: PortRows
}

export type Output = bool[]?

export default function (in: Input): Output {
    const { request, bindings, roots } = in

    if (roots == null) {
        return null
    }

    return loop({
        row: 0,
        valid: true,
        roots
    }, {
        while: state => state.valid && state.row < bindings.count,
        next: state => {
            const ports = readPorts({
                source: bindings,
                row: state.row
            })

            if (!shape(ports)) {
                state.valid = false
            } else if (ports.intrinsic == null) {
                const updated = markFunction({
                    request,
                    roots: state.roots,
                    ports
                })

                if (updated == null) {
                    state.valid = false
                } else {
                    state.roots = updated
                }
            }

            state.row += 1
        },
        return: state => match {
            state.valid => state.roots,
            _ => null
        }
    })
}
