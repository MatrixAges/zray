import bytes from "std:bytes"
import integers from "std:integer"

export type Ids = {
    data: u8[],
    rows: u64,
    stride: u64,
    field: u64,
    little_endian: bool
}

export type Input = {
    roots: bool[],
    constants: Ids
}

export type Output = bool[]?

export default function (in: Input): Output {
    const { constants } = in

    const count = in.roots.length

    return loop({
        row: 0,
        valid: true,
        roots: in.roots
    }, {
        while: state => state.valid && state.row < constants.rows,
        next: state => {
            const position = state.row * constants.stride + constants.field
            const id = bytes.readU32(constants.data, position, constants.little_endian)
            const index = integers.widen(id)

            state.valid = index < count

            if (state.valid) {
                state.roots[index] = true
            }

            state.row += 1
        },
        return: state => match {
            state.valid => state.roots,
            _ => null
        }
    })
}
