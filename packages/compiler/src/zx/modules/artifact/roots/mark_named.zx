import integers from "std:integer"
import memory from "memory"

import type { Rows } from "../../../ir/canonical/validation/names/model"

export type Input = {
    roots: bool[],
    declarations: Rows
}

export type Output = bool[]?

export default function (in: Input): Output {
    const count = in.roots.length

    return loop({
        row: 0,
        valid: true,
        roots: in.roots
    }, {
        while: state => state.valid && state.row < in.declarations.length,
        next: state => {
            const id = memory.readRowId(in.declarations.rows, state.row)
            const index = integers.widen(id)

            state.valid = index < count

            if (state.valid) {
                state.roots[index] = true
            }

            state.row += 1
        },
        return: state => match {
            state.valid => state.roots,
            _ => null
        }
    })
}
