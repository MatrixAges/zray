import markConstants from "./mark_constants"
import markNamed from "./mark_named"

import type { Request } from "./model"

export type Input = Request

export type Output = bool[]?

export default function (in: Input): Output {
    const { record, table } = in

    const empty_roots: bool[] = table.kinds.map(item => false)[0]

    const own = loop({
        index: record.start,
        roots: empty_roots
    }, {
        while: state => state.index < record.end,
        next: state => {
            state.roots[state.index] = true
            state.index += 1
        },
        return: state => state.roots
    })

    const with_exports = markNamed({
        roots: own,
        declarations: record.exports
    })

    if (with_exports == null) {
        return null
    }

    const with_constant_exports = markConstants({
        roots: with_exports,
        constants: record.constant_exports
    })

    if (with_constant_exports == null) {
        return null
    }

    const with_constant_imports = markConstants({
        roots: with_constant_exports,
        constants: record.constant_imports
    })

    if (with_constant_imports == null) {
        return null
    }

    return markNamed({
        roots: with_constant_imports,
        declarations: record.type_imports
    })
}
