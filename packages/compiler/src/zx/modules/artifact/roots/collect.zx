import memory from "zig:compiler_memory"

import markConstants from "./mark_constants"
import markNamed from "./mark_named"

import type { Request } from "./model"

export type Input = Request

export type Output = bool

export default function (in: Input): Output {
    const { record, roots, buffer } = in

    const initialized = loop({
        index: record.start
    }, {
        while: state => state.index < record.end,
        next: state => {
            memory.writeU8(buffer, state.index, 1)
            state.index += 1
        }
    })

    const count = roots.length

    if (!markNamed({
        buffer,
        count,
        declarations: record.exports
    })) {
        return false
    }

    if (!markConstants({
        buffer,
        count,
        constants: record.constant_exports
    })) {
        return false
    }

    if (!markConstants({
        buffer,
        count,
        constants: record.constant_imports
    })) {
        return false
    }

    return markNamed({
        buffer,
        count,
        declarations: record.type_imports
    })
}
