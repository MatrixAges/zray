<Module>
    <Type from="functions/model" as="Model" />
    <Type from="../../binding/model" as="Binding" />

    <Args
        in={Model.ImportRequest & {
            reexports: Binding.PortRows
        }}
        out={Model.Plan}
    />

    <Call
        fn="functions/validate"
        in={$in.pick([
            "signatures",
            "plan"
        ])}
    />

    <Call
        fn="../../../analysis/semantic/extracting/planning/ready"
        in={$ctx.validate.state}
    />

    <If on={!$ctx.ready}>
        <Return value={$ctx.validate} />
    </If>

    <Task name="declared" out={$ctx.imports}>
        <Call
            fn="functions/imports"
            in={{
                ...$in.omit(["reexports"]),
                plan: $ctx.validate
            }}
        />
    </Task>

    <Call
        fn="functions/imports"
        in={{
            ...$in.omit(["reexports"]),
            imports: $in.reexports,
            plan: $ctx.task.declared
        }}
    />

    <Return value={$ctx.imports} />
</Module>
