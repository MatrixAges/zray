import integers from "std:integer"
import memory from "memory"

import { Status } from "../../../../analysis/semantic/extracting/planning/model"
import dependencies from "./dependencies"
import matches from "./matches"

import type { ImportRequest, Plan } from "./model"

export type Input = ImportRequest

export type Output = Plan

export default function (in: Input): Output {
    const { request, modules, signatures, imports } = in

    return loop({
        plan: in.plan,
        row: 0
    }, {
        while: state =>
            state.plan.state.status == Status.Ready &&
            state.row < imports.count,
        next: state => {
            const row = state.row
            const function_id = memory.readColumnOptionalU32(imports.id, row)

            if (function_id != null) {
                const index = integers.widen(function_id)
                const valid = matches({
                    bindings: imports,
                    row,
                    index,
                    signatures
                })

                if (!valid) {
                    state.plan.state.status = Status.Invalid
                } else if (state.plan.functions.mapping[index] == 0) {
                    state.plan = dependencies({
                        request,
                        modules,
                        signatures,
                        plan: state.plan,
                        index
                    })

                    if (state.plan.state.status == Status.Ready) {
                        const count = state.plan.functions.count

                        state.plan.functions.mapping[index] = count + 1
                        state.plan.functions.order[count] = function_id
                        state.plan.functions.count += 1
                    }
                }
            }

            state.row += 1
        },
        return: state => state.plan
    })
}
