import { Status } from "../../../../analysis/semantic/extracting/planning/model"

import type { ImportRequest, Plan } from "./model"

export type Input = ImportRequest.Pick("signatures", "plan")

export type Output = Plan

export default function (in: Input): Output {
    if (in.plan.state.status != Status.Ready) {
        return in.plan
    }

    const count = in.signatures.inputs.length
    const different_outputs = in.signatures.outputs.length != count
    const different_native_modules = in.signatures.native_modules.length != count

    if (different_outputs || different_native_modules) {
        return {
            ...in.plan,
            state: {
                ...in.plan.state,
                status: Status.Invalid
            }
        }
    }

    return in.plan
}
