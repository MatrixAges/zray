import key from "core/native_module_table/key"
import memory from "memory"

import { Status } from "../../../analysis/semantic/extracting/planning/model"
import includeNative from "./native_include"

import type { Modules } from "core/native_module_table/model"
import type {
    Request,
    State
} from "../../../analysis/semantic/extracting/planning/model"
import type { Dependencies, NativePlan } from "./model"

export type Input = {
    request: Request,
    state: State,
    modules: Modules,
    natives: NativePlan,
    dependencies: Dependencies
}

export type Output = {
    state: State,
    natives: NativePlan
}

export default function (in: Input): Output {
    const { request, modules, dependencies } = in

    const result = loop({
        plan: in.state,
        natives: in.natives,
        index: 0
    }, {
        while: current =>
            current.plan.status == Status.Ready &&
            current.index < dependencies.count,
        next: current => {
            const row = current.index
            const target = memory.readColumnU8(dependencies.target_kind, row)

            if (target == dependencies.native_kind) {
                const identity =
                    memory.readOptionalTextColumn(dependencies.identity, row)
                const name =
                    identity ?? memory.readTextColumn(dependencies.specifier, row)

                const matched = loop({
                    plan: current.plan,
                    natives: current.natives,
                    index: 0,
                    found: false
                }, {
                    while: registry =>
                        registry.plan.status == Status.Ready &&
                        registry.index < modules.specifiers.length,
                    next: registry => {
                        if (key({
                            modules,
                            index: registry.index
                        }) == name) {
                            const included = includeNative({
                                request,
                                state: registry.plan,
                                modules,
                                natives: registry.natives,
                                index: registry.index
                            })

                            registry.plan = included.state
                            registry.natives = included.natives
                            registry.found = true
                        }

                        registry.index += 1
                    }
                })

                current.plan = matched.plan
                current.natives = matched.natives

                if (!matched.found) {
                    current.plan.status = Status.Invalid
                }
            }

            current.index += 1
        }
    })

    return {
        state: result.plan,
        natives: result.natives
    }
}
