import integers from "std:integer"
import memory from "memory"

import { Status } from "../../../analysis/semantic/extracting/planning/model"
import visit from "../../../analysis/semantic/extracting/planning/visit"

import type {
    Request,
    State
} from "../../../analysis/semantic/extracting/planning/model"
import type { Rows } from "../../../ir/canonical/validation/names/model"

export type Input = {
    request: Request,
    state: State,
    aliases: Rows
}

export type Output = State

export default function (in: Input): Output {
    return loop({
        request: in.request,
        plan: in.state,
        index: 0
    }, {
        while: current =>
            current.plan.status == Status.Ready && current.index < in.aliases.length,
        next: current => {
            const id = memory.readRowId(in.aliases.rows, current.index)

            current.plan = visit({
                request: current.request,
                state: current.plan,
                index: integers.widen(id)
            })
            current.index += 1
        },
        return: state => state.plan
    })
}
