import { Kind } from "./model"

import type { Mapping } from "./model"

export type Input = u32?[]

export type Output = Mapping

export default function (in: Input): Output {
    return {
        kind: Kind.Sparse,
        dense: [],
        sparse: in,
        planned: [],
        first: 0,
        prefix: 0,
        count: 0
    }
}
