import memory from "memory"

import { Kind } from "./model"

import type { OptionalU32Buffer } from "memory"
import type { Mapping } from "./model"

export type Input = OptionalU32Buffer

export type Output = Mapping

export default function (in: Input): Output {
    return {
        kind: Kind.Sparse,
        dense: [],
        sparse: memory.optionalU32Views(in),
        planned: [],
        first: 0,
        prefix: 0,
        count: 0
    }
}
