import link from "compiler/source_function_row"
import memory from "memory"

import readAttributes from "./attributes"
import { PublicationStatus } from "./model"
import read from "./read"
import write from "./write"

import type { Input, Output } from "./source_model"

export default function (in: Input): Output {
    const { source, target, mappings, max_offset, progress, empty, workspace } = in

    const end = source.files.length

    const [failure, result] = try loop({
        row: 0,
        columns: target,
        valid: true
    }, {
        while: state => state.valid && state.row < end,
        next: state => {
            const row = state.row

            const value = link(read({
                source,
                mappings,
                row,
                workspace,
                max_offset
            }))

            state.valid = value != null

            if (value != null) {
                state.columns = write({
                    columns: state.columns,
                    function: {
                        ...value.omit([
                            "stores",
                            "recursive",
                            "control",
                            "store_table"
                        ]),
                        control: value.control ?? empty.control,
                        store_table: value.store_table ?? empty.stores
                    },
                    attributes: readAttributes({
                        source,
                        row
                    }),
                    row
                })

                state.row += 1
                memory.writeU64(progress, 0, state.row)
            }
        }
    })

    memory.publishColumnLengths(in.lengths, memory.readU64(progress, 0))

    if (failure == error.OutOfMemory) {
        return {
            columns: null,
            status: PublicationStatus.Exhausted
        }
    }

    if (result != null && result.valid) {
        return {
            columns: result.columns,
            status: PublicationStatus.Complete
        }
    }

    return {
        columns: null,
        status: PublicationStatus.Invalid
    }
}
