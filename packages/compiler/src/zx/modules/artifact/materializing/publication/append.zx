import write from "./write"

import type { Append as Input } from "./source_model"
import type { Output as Publication } from "./write"

export type Output = Publication

export default function (in: Input): Output {
    const { target, value, empty, row } = in

    return write({
        storage: target.storage,
        function: {
            ...value.omit([
                "stores",
                "recursive",
                "control",
                "store_table"
            ]),
            control: value.control ?? empty.control,
            store_table: value.store_table ?? empty.stores
        },
        row
    })
}
