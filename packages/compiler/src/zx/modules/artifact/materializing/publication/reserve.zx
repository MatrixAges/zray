import integers from "std:integer"
import { max_u32 } from "core/const"
import columns from "memory/columns"

import type {
    ColumnAllocator,
    ColumnGrowth,
    ColumnSet,
    FunctionRow
} from "memory/columns"

export type Input = {
    storage: ColumnSet,
    resource: ColumnAllocator,
    shape?: FunctionRow,
    count: u64
}

export type Output = {
    resource: ColumnAllocator,
    storage: ColumnSet,
    growth: ColumnGrowth,
    count: u64,
    limit: u64
}

export default function (in: Input): Output {
    const { resource, storage, shape, count } = in

    return {
        resource,
        storage,
        growth: columns.functionColumnGrowth(shape, null),
        count,
        limit: integers.widen(max_u32)
    }
}
