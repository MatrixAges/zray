import type { Contracts } from "core/contract_table/model"
import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Stores } from "core/store_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { ColumnLengths, U64Buffer } from "memory"
import type { Workspace } from "../../../../ir/canonical/body/workspace"
import type { Mapping } from "../../remapping/model"
import type { Output as External } from "../copy_external"
import type { Input as FunctionInput, Owned } from "../function_model"
import type { Attributes, BodyColumns, Columns, Publication, Target } from "./model"

export type Source = Columns

export type Mappings = {
    types: Mapping,
    functions: Mapping,
    natives: Mapping
}

export type Empty = {
    control: Control,
    stores: Stores
}

export type Row = FunctionInput.Omit("control") & {
    control: Control,
    workspace: Workspace
}

export type Link = Owned?

export type Input = {
    source: Source,
    target: Target,
    tables: BodyColumns,
    mappings: Mappings,
    empty: Empty,
    workspace: Workspace,
    max_offset: u64,
    progress: U64Buffer,
    lengths: ColumnLengths
}

export type Output = Publication

export type Root = {
    file: string,
    input_type: u32,
    output_type: u32,
    attributes: Attributes,
    native_module?: u32,
    external?: External,
    stores: Stores,
    symbols: Symbols,
    expressions: Expressions,
    contracts: Contracts,
    control: Control
}

export type RootRequest = Input.Omit("source") & {
    source: Root
}
