import type { Table } from "core/signature_table/model"
import type { Output as External } from "../copy_external"
import type { Flags, Signature } from "./model"

export type Input = {
    columns: Table,
    signature: Signature,
    flags: Flags,
    row: u64
}

export type Output = Table

export default function (in: Input): Output {
    const { columns, signature, flags, row } = in

    const external: External = signature.external ?? {
        members: [],
        errors: null,
        export_name: null,
        parameters: null
    }

    return {
        files: columns.files.with(row, signature.file),
        input_types: columns.input_types.with(row, signature.ports.input),
        output_types: columns.output_types.with(row, signature.ports.output),
        ownership: columns.ownership.with(row, flags.ownership),
        native_modules: columns.native_modules.with(row, signature.ports.native_module),
        native_members: columns.native_members.with(row, external.members),
        native_exports: columns.native_exports.with(row, external.export_name),
        native_inputs: columns.native_inputs.with(row, external.parameters),
        native_errors: columns.native_errors.with(row, external.errors),
        native_allocators:
            columns.native_allocators.with(row, flags.allocator_argument),
        native_io: columns.native_io.with(row, flags.io_argument),
        native_process: columns.native_process.with(row, flags.process_argument),
        native_tuples: columns.native_tuples.with(row, flags.expand_tuple),
        native_fallible: columns.native_fallible.with(row, flags.fallible),
        native_concurrent: columns.native_concurrent.with(row, flags.concurrent)
    }
}
