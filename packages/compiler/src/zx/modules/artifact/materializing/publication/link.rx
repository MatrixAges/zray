<Module>
    <Type from="source_model" as="Source" />

    <Args in={Source.Row} out={Source.Link} />

    <Call
        module="../../../../ir/canonical/control/structure"
        in={$in.pick([
            "control",
            "root",
            "workspace"
        ])}
    />

    <If on={!$ctx.structure}>
        <Return value={null} />
    </If>

    <Call
        module="../own_function"
        in={{
            admission: $in.admission,
            metadata: $in.metadata,
            control: $in.root == null ? null : $in.control
        }}
    />

    <Return value={$ctx.own_function} />
</Module>
