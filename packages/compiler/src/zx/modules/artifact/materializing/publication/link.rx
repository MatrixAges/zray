<Module>
    <Type from="source_model" as="Source" />

    <Args in={Source.Row} out={Source.Link} />

    <Call
        module="../../../../ir/canonical/control/structure"
        in={{
            control: $in.control,
            root: $in.attributes.root
        }}
    />

    <If on={!$ctx.structure}>
        <Return value={null} />
    </If>

    <Call
        module="../own_function"
        in={{
            admission: $in.admission,
            metadata: $in.metadata,
            attributes: $in.attributes,
            control: $in.attributes.root == null ? null : $in.control
        }}
    />

    <Return value={$ctx.own_function} />
</Module>
