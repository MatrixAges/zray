import { StoreMode } from "core/function_table/complete"
import { ColumnStoreMode } from "memory/columns"

import signature from "../../../link/signature/publication/signature_row"

import type { ColumnSet, FunctionRow } from "memory/columns"
import type { Payload } from "./model"

export type Input = {
    storage: ColumnSet,
    function: Payload,
    row: u64
}

export type Output = {
    storage: ColumnSet,
    row: FunctionRow,
    index?: u64
}

export default function (in: Input): Output {
    const { storage, function: value, row } = in

    const fields = signature({
        signature: value.pick([
            "file",
            "ports",
            "external"
        ]),
        flags: value.pick([
            "ownership",
            "allocator_argument",
            "io_argument",
            "process_argument",
            "expand_tuple",
            "fallible",
            "concurrent"
        ])
    })

    return {
        storage,
        row: {
            ...fields,
            store_modes: match value.store_mode {
                StoreMode.transaction => ColumnStoreMode.transaction,
                _ => ColumnStoreMode.orchestration
            },
            roots: value.root,
            symbols: value.symbols,
            expressions: value.expressions,
            contracts: value.contracts,
            control: value.control,
            stores: value.store_table
        },
        index: row
    }
}
