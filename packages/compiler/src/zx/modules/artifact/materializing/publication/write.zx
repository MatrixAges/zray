import type { Output as External } from "../copy_external"
import type { Owned } from "../function_model"
import type { Columns } from "./model"
import type { Empty } from "./source_model"

export type Input = {
    columns: Columns,
    function: Owned,
    row: u64,
    empty: Empty
}

export type Output = Columns

export default function (in: Input): Output {
    const { columns, function: value, row, empty } = in

    const external: External = value.external ?? {
        members: [],
        errors: null,
        export_name: null,
        parameters: null
    }

    return {
        files: columns.files.with(row, value.file),
        input_types: columns.input_types.with(row, value.ports.input),
        output_types: columns.output_types.with(row, value.ports.output),
        native_modules: columns.native_modules.with(row, value.ports.native_module),
        native_members: columns.native_members.with(row, external.members),
        native_exports: columns.native_exports.with(row, external.export_name),
        native_inputs: columns.native_inputs.with(row, external.parameters),
        native_errors: columns.native_errors.with(row, external.errors),
        symbols: columns.symbols.with(row, value.symbols),
        expressions: columns.expressions.with(row, value.expressions),
        contracts: columns.contracts.with(row, value.contracts),
        control: columns.control.with(row, value.control ?? empty.control),
        stores: columns.stores.with(row, value.store_table ?? empty.stores)
    }
}
