import signature from "./signature"

import type { Attributes, Columns, Payload } from "./model"

export type Input = {
    columns: Columns,
    function: Payload,
    attributes: Attributes,
    row: u64
}

export type Output = Columns

export default function (in: Input): Output {
    const { columns, function: value, attributes, row } = in

    const signed = signature({
        columns: columns.omit([
            "store_modes",
            "symbols",
            "expressions",
            "contracts",
            "control",
            "roots",
            "stores"
        ]),
        signature: value.pick([
            "file",
            "ports",
            "external"
        ]),
        flags: attributes.omit([
            "store_mode",
            "root"
        ]),
        row
    })

    return {
        ...signed,
        store_modes: columns.store_modes.with(row, attributes.store_mode),
        symbols: columns.symbols.with(row, value.symbols),
        expressions: columns.expressions.with(row, value.expressions),
        contracts: columns.contracts.with(row, value.contracts),
        control: columns.control.with(row, value.control),
        roots: columns.roots.with(row, attributes.root),
        stores: columns.stores.with(row, value.store_table)
    }
}
