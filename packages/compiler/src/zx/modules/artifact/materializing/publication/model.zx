import type { Control } from "core/control_table/model"
import type { Complete } from "core/function_table/complete"
import type { Table } from "core/signature_table/model"
import type { Stores } from "core/store_table/model"
import type { ColumnSet, FunctionRow } from "memory/columns"
import type { Owned } from "../function_model"

export type { Attributes, Flags } from "../function_model"

export enum PublicationStatus {
    Complete,
    Invalid,
    Exhausted
}

export type Columns = Complete

export type Target = {
    storage: ColumnSet,
    shape?: FunctionRow
}

export type Publication = PublicationStatus

export type FlagColumns = Table.Pick(
    "ownership",
    "native_allocators",
    "native_io",
    "native_process",
    "native_tuples",
    "native_fallible",
    "native_concurrent"
)

export type Payload = Owned.Omit("stores", "recursive", "control", "store_table") & {
    control: Control,
    store_table: Stores
}

export type Signature = Payload.Pick("file", "ports", "external")
