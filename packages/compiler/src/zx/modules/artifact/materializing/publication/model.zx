import type { Control } from "core/control_table/model"
import type { Complete, StoreMode } from "core/function_table/complete"
import type { Table } from "core/signature_table/model"
import type { Stores } from "core/store_table/model"
import type { Ownership } from "core/symbol_table/model"
import type { ColumnSet, SignatureRow } from "memory/columns"
import type { Owned } from "../function_model"

export enum PublicationStatus {
    Complete,
    Invalid,
    Exhausted
}

export type Columns = Complete

export type BodyColumns =
    Columns.Pick(
        "store_modes",
        "roots",
        "symbols",
        "expressions",
        "contracts",
        "control",
        "stores"
    )

export type Target = {
    storage: ColumnSet,
    shape?: SignatureRow
}

export type Publication = {
    status: PublicationStatus,
    tables?: BodyColumns
}

export type FlagColumns = Table.Pick(
    "ownership",
    "native_allocators",
    "native_io",
    "native_process",
    "native_tuples",
    "native_fallible",
    "native_concurrent"
)

export type Flags = {
    ownership: Ownership,
    allocator_argument: bool,
    io_argument: bool,
    process_argument: bool,
    expand_tuple: bool,
    fallible: bool,
    concurrent: bool
}

export type Attributes = Flags & {
    store_mode: StoreMode,
    root?: u32
}

export type Payload = Owned.Omit("stores", "recursive", "control", "store_table") & {
    control: Control,
    store_table: Stores
}

export type Signature = Payload.Pick("file", "ports", "external")
