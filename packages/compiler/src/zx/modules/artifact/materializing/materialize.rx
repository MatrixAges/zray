<Module>
    <Type from="model" as="Materialize" />

    <Args in={Materialize.Input} out={Materialize.Output?} />

    <Call
        module="../../../analysis/semantic/extracting/materializing/materialize"
        in={{
            table: $in.table,
            origins: $in.origins,
            plan: $in.plan.state
        }}
    />

    <Call
        fn="natives"
        in={{
            modules: $in.modules,
            plan: $in.plan.natives,
            mapping: $in.plan.state.mapping
        }}
    />

    <If on={$ctx.natives != null}>
        <Call
            fn="signatures"
            in={{
                source: $in.views.declarations,
                plan: $in.plan.functions,
                types: $in.plan.state.mapping,
                natives: $in.plan.natives.mapping
            }}
        />

        <If on={$ctx.signatures != null}>
            <Call module="content" in={$in.views.content} />

            <If on={$ctx.content.valid}>
                <Call module="../surface/extract" in={$in.views.surface} />

                <Call fn="../path" in={$in.views.path} />
                <Call fn="../dependencies/publish" in={$in.views.dependencies} />

                <Return
                    value={{
                        table: $ctx.materialize.table,
                        origins: $ctx.materialize.origins,
                        natives: $ctx.natives,
                        signatures: $ctx.signatures,
                        function: $ctx.content.function,
                        stores: $ctx.content.stores,
                        path: $ctx.path
                    }}
                />
            </If>
        </If>
    </If>

    <Return value={null} />
</Module>
