<Module>
    <Type from="content_model" as="Content" />

    <Args in={Content.Input} out={Content.Output} />

    <If on={$in.function != null}>
        <Call module="own_function" in={$in.function} />

        <If on={$ctx.own_function != null}>
            <If on={$in.copy_entry_stores}>
                <Call
                    module="stores/remap"
                    in={{
                        source: $in.entry_stores,
                        mapping: $in.type_mapping
                    }}
                />

                <Return
                    value={{
                        valid: $ctx.remap != null,
                        function: $ctx.own_function,
                        stores: $ctx.remap
                    }}
                />
            </If>

            <Return
                value={{
                    valid: true,
                    function: $ctx.own_function,
                    stores: $ctx.own_function.store_table
                }}
            />
        </If>

        <Return
            value={{
                valid: false,
                function: null,
                stores: null
            }}
        />
    </If>

    <Return
        value={{
            valid: !$in.copy_entry_stores,
            function: null,
            stores: null
        }}
    />
</Module>
