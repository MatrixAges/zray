import { refreshRowReads } from "core/row_buffer"

import type { RowGrowth } from "memory/columns"
import type { Context, Program } from "../../../ir/canonical/validation/model"

export type Views = {
    context: Context,
    constants?: RowGrowth
}

export type Request = Program.Pick("version", "exports", "constant_exports") & {
    views: Views
}

export type Input = Views

export type Output = Context

export default function (in: Input): Output {
    const { context, constants } = in

    if (constants != null) {
        refreshRowReads(constants)
    }

    return context
}
