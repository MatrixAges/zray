import memory from "memory"

import type { Header as Input } from "../../module_record/model"

export type Output = bool

export default function (in: Input): Output {
    const { target_kind, compiled_kind, count } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < count,
        next: current => {
            current.valid = memory.readColumnU8(target_kind, current.index) !=
                compiled_kind
            current.index += 1
        },
        return: state => state.valid
    })
}
