<Module>
    <Type from="publish" as="Dependency" />

    <Args in={Dependency.Input} out={Dependency.Input} />

    <Store from="rows" as="rows" />

    <Call fn="publish" in={$in} />

    <Call fn="commit" setter={[$store.rows.pending]} />

    <Return
        value={{
            ...$in,
            row: $ctx.commit
        }}
    />
</Module>
