import memory from "memory"

import type { ReadColumn, TextColumn } from "memory"
import type { Header } from "../../module_record/model"

export type Source = {
    header: Header,
    names: ReadColumn,
    source_names: ReadColumn,
    path: TextColumn
}

export type Input = {
    source: Source,
    row: u64
}

export type Output = {
    row: u64,
    specifier: string,
    identity?: string,
    names: string[],
    source_names: string[],
    path?: string
}

export default function (in: Input): Output {
    const { source, row } = in
    const { header } = source

    const kind = memory.readColumnU8(header.target_kind, row)

    const path: string? = match {
        kind == header.source_kind => memory.readTextColumn(source.path, row),
        _ => null
    }

    return {
        row,
        specifier: memory.readTextColumn(header.specifier, row),
        identity: memory.readOptionalTextColumn(header.identity, row),
        names: memory.readTextListColumn(source.names, row),
        source_names: memory.readTextListColumn(source.source_names, row),
        path
    }
}
