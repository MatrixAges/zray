import encoding from "std:encoding"
import strings from "std:string"

import type { Names } from "./model"

export type Input = {
    names: Names,
    aliased: bool,
    specifier: string,
    identity?: string
}

export type Output = {
    locals: string[],
    originals: string[],
    specifier: string,
    identity?: string
}

export default function (in: Input): Output {
    const { source, locals, originals } = in.names

    const empty_locals: string[] = []
    const empty_originals: string[] = []

    const copied = loop({
        index: 0,
        locals: empty_locals,
        originals: empty_originals
    }, {
        while: state => state.index < locals.length,
        next: state => {
            const index = state.index
            const span = locals[index]
            const local = encoding.sliceBytes(source, span.start, span.end)
            const owned = strings.copy(local)

            state.locals = state.locals.push(owned)[0]

            if (in.aliased) {
                const original = originals[index]
                const same_span = original.start == span.start && original.end == span.end

                if (same_span) {
                    state.originals = state.originals.push(owned)[0]
                } else {
                    const text =
                        encoding.sliceBytes(source, original.start, original.end)
                    const value = match {
                        text == local => owned,
                        _ => strings.copy(text)
                    }

                    state.originals = state.originals.push(value)[0]
                }
            }

            state.index += 1
        },
        return: state => state
    })

    const identity = in.identity

    return {
        locals: copied.locals,
        originals: copied.originals,
        specifier: strings.copy(in.specifier),
        identity: identity == null ? null : strings.copy(identity)
    }
}
