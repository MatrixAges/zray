import strings from "std:string"

import hasAlias from "./names/alias"
import own from "./names/own"

import type { Names } from "./names/model"

export type Target = {
    path: string,
    instance: string,
    member: string
}

export type Input = {
    names: Names,
    specifier: string,
    identity?: string,
    target: Target,
    compiled: bool
}

export type Output = Target & {
    locals: string[],
    originals: string[],
    specifier: string,
    identity?: string
}

export default function (in: Input): Output {
    const count = in.names.locals.length
    const aliased = count != 0 && hasAlias(in.names)

    const owned = own({
        names: in.names,
        aliased,
        specifier: in.specifier,
        identity: in.identity
    })

    if (in.compiled) {
        const instance = strings.copy(in.target.instance)
        const path = strings.copy(in.target.path)
        const member = strings.copy(in.target.member)

        return {
            ...owned,
            instance,
            path,
            member
        }
    }

    return {
        ...owned,
        ...in.target
    }
}
