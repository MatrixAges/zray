<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Input} out={Delivery.Output} />

    <Call
        fn="origin"
        in={{
            owner: $in.identity ?? $in.implementation.specifier,
            member: $in.implementation.member,
            export_name: $in.implementation.export_name
        }}
    />

    <Call
        module="../load"
        in={{
            ...$in.analysis,
            nominal_origin: $ctx.origin,
            expand_tuple: $in.implementation.expand_tuple,
            fallible: $in.implementation.fallible,
            errors: $in.implementation.errors
        }}
    />

    <If on={$ctx.load.publish}>
        <Call
            module="../../../analysis/semantic/merging/publication/append"
            in={{
                ...$in.types,
                delta: $ctx.load.type_delta,
                origins: $ctx.load.nominal_delta
            }}
        />
    </If>

    <If on={$ctx.load.diagnostic.message == ""}>
        <Call
            fn="prepare"
            in={{
                implementation: $in.implementation,
                members: $ctx.load.members,
                input_type: $ctx.load.input_type,
                output_type: $ctx.load.output_type,
                resource: $in.destination.text_allocator
            }}
        />

        <Call fn="../../link/signature/publication/reserve" in={$in.destination} />

        <Call
            fn="../../link/signature/publication/append"
            in={{
                ...$in.pick([
                    "destination",
                    "empty"
                ]),
                prepared: $ctx.prepare
            }}
        />
    </If>

    <Return
        value={$ctx.load.pick([
            "diagnostic",
            "input_type",
            "output_type"
        ])}
    />
</Module>
