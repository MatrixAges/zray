import encoding from "std:encoding"
import { Ownership } from "core/symbol_table/model"

import type { Prepared as Output, Record as Input } from "./model"

export type { Prepared as Output } from "./model"

export default function (in: Input): Output {
    const { implementation, members: spans } = in
    const { member, errors, export_name } = implementation

    const empty: string[] = []

    const members = loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < spans.length,
        next: state => {
            const part = spans[state.row]
            const text = encoding.sliceBytes(member, part.start, part.end)

            state.items = state.items.push(text)[0]
            state.row += 1
        },
        return: state => state.items
    })

    return {
        function: {
            file: implementation.specifier,
            ports: {
                input: in.input_type,
                output: in.output_type,
                native_module: implementation.module
            },
            external: {
                members,
                errors,
                export_name,
                parameters: null
            }
        },
        flags: {
            ...implementation.omit([
                "specifier",
                "member",
                "module",
                "export_name",
                "errors"
            ]),
            ownership: Ownership.Borrowed
        }
    }
}
