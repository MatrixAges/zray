import type { Target } from "../../../analysis/semantic/merging/publication/model"
import type { Diagnostic } from "../../../analysis/semantic/resolving/model"
import type { Span } from "../../../frontend/lexer/token_model"
import type { Flags, Signature } from "../../artifact/materializing/publication/model"
import type { ExternalInput, Result } from "../model"

export type Implementation = Flags.Omit("ownership") & {
    specifier: string,
    member: string,
    module: u32,
    export_name?: string,
    errors?: string[]
}

export type Record = {
    implementation: Implementation,
    members: Span[],
    input_type: u32,
    output_type: u32
}

export type Prepared = {
    function: Signature,
    flags: Flags
}

export type Input = {
    analysis:
        ExternalInput.Omit("nominal_origin", "expand_tuple", "fallible", "errors"),
    identity?: string,
    types: Target,
    implementation: Implementation
}

export type Output = Result.Pick("input_type", "output_type") & {
    diagnostic: Diagnostic,
    prepared?: Prepared
}
