import memory from "memory"

import type { Allocator } from "memory"

export type Input = {
    resource: Allocator,
    items: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { resource, items } = in

    if (items.length == 0) {
        return []
    }

    const slots = memory.requireTextSlots(
        memory.allocateTextSlots(
            resource,
            items.length,
            null
        )
    )

    const copied = loop(0, {
        while: row => row < items.length,
        next: row => {
            memory.writeTextSlot(
                slots,
                row,
                memory.copyColumnText(resource, items[row])
            )

            row += 1
        }
    })

    return memory.borrowTextSlots(slots, items.length)
}
