<Module>
    <Type from="prepare_model" as="Index" />

    <Args in={Index.Relocation} out={Index.Prepared} />

    <Call
        fn="rebuild"
        in={$in.pick([
            "keys",
            "capacity"
        ])}
    />

    <Call
        fn="probe"
        in={{
            keys: $in.keys,
            buckets: $ctx.rebuild,
            key: $in.key
        }}
    />

    <Return
        value={{
            slot: $ctx.probe,
            buckets: $ctx.rebuild
        }}
    />
</Module>
