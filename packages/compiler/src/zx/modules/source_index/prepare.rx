<Module>
    <Type from="prepare_model" as="Index" />

    <Args in={Index.Input} out={Index.Prepared?} />

    <Call
        fn="index.reserveColumns"
        in={{
            resource: $in.resource,
            ranges: $in.columns,
            precise: false,
            uniform: true,
            limit: null
        }}
    />

    <Call
        fn="next_capacity"
        in={{
            entries: $in.length + 1,
            capacity: $in.capacity,
            maximum: $in.maximum
        }}
    />

    <If on={$ctx.next_capacity != null}>
        <If on={$ctx.next_capacity == 0}>
            <Return
                value={{
                    slot: $in.slot,
                    buckets: null
                }}
            />
        </If>

        <Call fn="index.u8ListViews" in={$in.keys} />

        <Call
            module="relocate"
            in={{
                keys: $ctx.u8ListViews,
                key: $in.key,
                capacity: $ctx.next_capacity
            }}
        />

        <Return value={$ctx.relocate} />
    </If>

    <Return value={null} />
</Module>
