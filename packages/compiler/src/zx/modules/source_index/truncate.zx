import probe from "core/bytes/index/slot"

import type { Table } from "core/bytes/index/slot"

export type Input = Table & {
    row: u64
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { keys, buckets, capacity, row } = in

    const found = probe({
        keys,
        buckets,
        capacity,
        key: keys[row],
        rows: null
    })

    return {
        slot: found.slot,
        entry: row + 1
    }
}
