import { publish as publishLengths } from "core/column_lengths"
import memory from "memory"

import type { ColumnLengths, U64Buffer } from "memory"

export type Input = {
    buckets: U64Buffer,
    lengths: ColumnLengths,
    slot: u64
}

export type Output = void

export default function (in: Input): Output {
    const { buckets, lengths, slot } = in

    const row = memory.readLengthSlot(lengths, 0)

    memory.writeU64(buckets, slot, row + 1)

    publishLengths({
        target: lengths,
        count: 1
    })
}
