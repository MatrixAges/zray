import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import memory from "memory"

import { ImportKind } from "../../frontend/parser/imports/model"
import {
    default_export,
    enum_required,
    missing_export,
    missing_native,
    native_enum_required
} from "./const"
import exportPosition from "./export_position"
import { Target } from "./model"
import readName from "./name"
import position from "./public_position"

import type { Request, Result } from "./model"

export type Input = {
    request: Request,
    result: Result
}

export type Output = Result

export default function (in: Input): Output {
    const { request, result } = in

    const namespace = result.namespace != null
    const wildcard = !namespace && request.wildcard
    const members = request.signatures ?? request.members

    const count = match {
        namespace => members.length,
        !request.wildcard => request.names.count,
        request.kind == ImportKind.TypeOnly => request.exports.length,
        _ => request.exports.length + request.constants.length +
            members.length
    }

    return loop({
        ...result,
        index: 0
    }, {
        while: current =>
            current.message == "" && current.index < count,
        next: current => {
            const index = current.index
            current.index += 1

            const { original, local, start, end } = readName({
                request,
                index,
                namespace,
                members
            })

            if (!wildcard || original != "") {
                const name =
                    match {
                        request.kind == ImportKind.Function ||
                            original == default_export =>
                            "",
                        _ => original
                    }

                const callable: u64? =
                    match {
                        namespace => index,
                        request.kind == ImportKind.TypeOnly => null,
                        _ => position({
                            names: members,
                            name: name
                        })
                    }
                const constant: u64? =
                    match {
                        callable == null && request.kind == ImportKind.Enumeration =>
                            position({
                                names: request.constants,
                                name: original
                            }),
                        _ => null
                    }
                const alias_index: u64? = match {
                    callable == null && constant == null => exportPosition({
                        exports: request.exports,
                        name: original
                    }),
                    _ => null
                }

                const forwarding_default = request.reexport && local == default_export
                const public_name = forwarding_default ? "" : local

                if (callable != null && request.kind != ImportKind.TypeOnly) {
                    current.function_names =
                        current.function_names.push(public_name)[0]
                    current.function_indices =
                        current.function_indices.push(callable)[0]
                } else if (constant != null && request.kind == ImportKind.Enumeration) {
                    current.constant_names = current.constant_names.push(local)[0]
                    current.constant_indices =
                        current.constant_indices.push(constant)[0]
                } else if (alias_index != null) {
                    const type_id = memory.readRowId(request.exports.rows, alias_index)
                    const allowed =
                        request.reexport || request.kind == ImportKind.TypeOnly ||
                        kind(request.type_kinds[integers.widen(
                            type_id
                        )]) == Kind.Enumeration

                    if (allowed) {
                        current.alias_names = current.alias_names.push(local)[0]
                        current.alias_indices =
                            current.alias_indices.push(alias_index)[0]
                    } else {
                        current.message = match request.target {
                            Target.Native => native_enum_required,
                            _ => enum_required
                        }
                        current.start = start
                        current.end = end
                    }
                } else {
                    current.message = match request.target {
                        Target.Native => missing_native,
                        _ => missing_export
                    }
                    current.start = start
                    current.end = end
                }
            }
        },
        return: state => state.omit(["index"])
    })
}
