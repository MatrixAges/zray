import memory from "memory"

import type { BindingColumns, FunctionBinding as Output } from "./model"

export type Input = {
    columns: BindingColumns,
    row: u64
}

export default function (in: Input): Output {
    const { columns, row } = in

    return {
        namespace: memory.readOptionalTextColumn(columns.namespace, row),
        name: memory.readTextColumn(columns.name, row),
        id: memory.readColumnOptionalU32(columns.id, row),
        input_type: memory.readColumnOptionalU32(columns.input_type, row),
        output_type: memory.readColumnOptionalU32(columns.output_type, row),
        intrinsic: memory.readColumnOptionalU8(columns.intrinsic, row)
    }
}
