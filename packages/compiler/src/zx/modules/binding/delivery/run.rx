<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Input} out={Delivery.Outcome} />

    <Call module="../bind" in={$in.request} />

    <If on={$ctx.bind.message == ""}>
        <Call
            module="../publication/publish"
            in={{
                selected: $ctx.bind,
                destinations: $in.destinations
            }}
        />

        <If on={$in.reexports != null && $ctx.bind.function_names.length != 0}>
            <Call
                module="../../project/exports/signatures/publish_reexports"
                in={{
                    rows: $in.reexports,
                    names: $ctx.bind.function_names,
                    indices: $ctx.bind.function_indices
                }}
            />

            <Return
                value={{
                    ...$ctx.bind.pick([
                        "message",
                        "start",
                        "end"
                    ]),
                    ...$ctx.publish,
                    reexports: $ctx.publish_reexports
                }}
            />
        </If>

        <Return
            value={{
                ...$ctx.bind.pick([
                    "message",
                    "start",
                    "end"
                ]),
                ...$ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.bind.pick([
                "message",
                "start",
                "end"
            ]),
            aliases: [],
            constants: [],
            functions: []
        }}
    />
</Module>
