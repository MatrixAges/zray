import encoding from "std:encoding"
import memory from "memory"

import publicName from "./public_name"

import type { Name, PublicNames, Request } from "./model"

export type Input = {
    request: Request,
    index: u64,
    namespace: bool,
    members: PublicNames
}

export type Output = Name

export default function (in: Input): Output {
    const { request, index } = in

    if (in.namespace || request.wildcard) {
        const types = request.exports.length
        const constants_end = types + request.constants.length

        const name = match {
            in.namespace => publicName({
                names: in.members,
                index
            }),
            index < types => memory.readRowName(request.exports.rows, index),
            index < constants_end => publicName({
                names: request.constants,
                index: index - types
            }),
            _ => publicName({
                names: in.members,
                index: index - constants_end
            })
        }

        return {
            original: name,
            local: name,
            start: request.start,
            end: request.end
        }
    }

    const names = request.names
    const native = names.native

    if (native != null) {
        return {
            original: memory.readTextColumn(native.originals, index),
            local: memory.readTextColumn(native.locals, index),
            start: memory.readColumnIndex(native.starts, index),
            end: memory.readColumnIndex(native.ends, index)
        }
    }

    const span = names.originals[index]
    const source = names.source
    const original = encoding.sliceBytes(source, span.start, span.end)
    const local_span = names.locals[index]

    const local = match {
        local_span.start == span.start && local_span.end == span.end => original,
        _ => encoding.sliceBytes(source, local_span.start, local_span.end)
    }

    return {
        original,
        local,
        start: span.start,
        end: span.end
    }
}
