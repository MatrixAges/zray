import type { NamedRows } from "memory"
import type { Source } from "../../artifact/surface/bindings"
import type { PortShape, Result } from "../model"

export type AliasRow = {
    name: string,
    type_id: u32
}

export type ConstantRow = {
    name: string,
    index: u64
}

export type FunctionRow = PortShape & {
    name: string,
    namespace?: string
}

export type Aliases = {
    source: NamedRows
}

export type Binding = PortShape

export type FunctionColumns =
    Source.Pick("id", "input_type", "output_type", "intrinsic")

export type Members = {
    named: FunctionColumns,
    fallback?: Binding
}

export type Destinations = {
    aliases: Aliases,
    functions?: Members
}

export type Input = {
    selected: Result,
    destinations: Destinations
}

export type Outcome = {
    aliases: AliasRow[],
    constants: ConstantRow[],
    functions: FunctionRow[]
}
