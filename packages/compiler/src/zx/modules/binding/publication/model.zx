import type { Rows } from "core/constant/rows"
import type { Allocator, NamedRows, WriteColumn } from "memory"
import type { ColumnAllocator, RowBuffer } from "memory/columns"
import type { Source, Target } from "../../artifact/surface/bindings"
import type { Target as ConstantTarget } from "../../artifact/surface/constants"
import type { Bindings, PortShape, Result } from "../model"

export type RowsTarget = {
    storage: RowBuffer,
    used: u64
}

export type AliasColumns = {
    name: WriteColumn,
    id: WriteColumn
}

export type Aliases = RowsTarget & {
    source: NamedRows,
    target: AliasColumns
}

export type Constants = RowsTarget & {
    source: Rows.Pick("types", "values"),
    target: ConstantTarget
}

export type Binding = PortShape

export type FunctionColumns =
    Source.Pick("id", "input_type", "output_type", "intrinsic")

export type Members = {
    named: FunctionColumns,
    fallback?: Binding
}

export type Functions = RowsTarget & Members & {
    target: Target
}

export type Destinations = {
    aliases: Aliases,
    constants: Constants,
    functions?: Functions
}

export type Input = {
    selected: Result,
    destinations: Destinations,
    owner: Allocator,
    owner_rows: ColumnAllocator
}

export type Selected = Bindings & {
    used: u64,
    owner: Allocator
}

export type Outcome = {
    aliases: u64,
    constants: u64,
    functions: u64
}
