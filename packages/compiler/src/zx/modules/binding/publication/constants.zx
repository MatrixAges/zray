import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import type { Constants, Selected } from "./model"

export type Input = Selected & Constants.Pick("source", "target")

export type Output = u64

export default function (in: Input): Output {
    const { names, indices, source, target, used: first, owner } = in

    if (names.length == 0) {
        return first
    }

    const published = loop(0, {
        while: row => row < names.length,
        next: row => {
            const index = indices[row]
            const destination = first + row
            const name = memory.copyColumnText(owner, names[row])
            const type_id = columns.readColumnU32(source.types, index)
            const text = columns.readScalarText(source.values, index)

            if (text != null) {
                columns.writeScalarText(
                    target.values,
                    destination,
                    memory.copyColumnText(owner, text)
                )
            } else {
                columns.copyScalarAt(
                    source.values,
                    index,
                    target.values,
                    destination
                )
            }

            memory.writeColumnBytes(
                target.names,
                destination,
                bytes.fromText(name)
            )
            memory.writeColumnU32(target.types, destination, type_id)
            row += 1
        }
    })

    return first + names.length
}
