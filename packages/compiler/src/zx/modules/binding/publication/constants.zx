import type { ConstantRow as Row } from "./model"

export type { ConstantRow as Row } from "./model"

export type Input = {
    names: string[],
    indices: u64[]
}

export type Output = Row[]

export default function (in: Input): Output {
    const { names, indices } = in

    const empty: Row[] = []

    return loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < names.length,
        next: state => {
            const row = state.row

            state.rows = state.rows.push({
                name: names[row],
                index: indices[row]
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })
}
