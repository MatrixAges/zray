import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import read from "./read"

import type { Functions, Selected } from "./model"

export type Input = Selected & Functions.Pick("named", "fallback", "target") & {
    namespace?: string
}

export type Output = void

export default function (in: Input): Output {
    const { names, indices, named, fallback, target, used, owner } = in

    const members = {
        named,
        fallback
    }

    const namespace = in.namespace

    const owned: string? =
        namespace == null ? null : memory.copyColumnText(owner, namespace)

    const first = memory.readU64(used, 0)

    const published = loop(0, {
        while: row => row < names.length,
        next: row => {
            const binding = read({
                members,
                row: indices[row]
            })

            const name = memory.copyColumnText(owner, names[row])
            const destination = first + row

            memory.writeColumnBytes(
                target.name,
                destination,
                bytes.fromText(name)
            )
            columns.writeColumnOptionalText(target.namespace, destination, owned)
            columns.writeColumnOptionalU32(target.id, destination, binding.id)
            columns.writeColumnOptionalU32(
                target.input_type,
                destination,
                binding.input_type
            )
            columns.writeColumnOptionalU32(
                target.output_type,
                destination,
                binding.output_type
            )
            columns.writeColumnOptionalU8(
                target.intrinsic,
                destination,
                binding.intrinsic
            )
            row += 1
            memory.writeU64(used, 0, first + row)
        }
    })
}
