import read from "./read"

import type { FunctionRow as Row, Members } from "./model"

export type { FunctionRow as Row } from "./model"

export type Input = Members & {
    names: string[],
    indices: u64[],
    namespace?: string
}

export type Output = Row[]

export default function (in: Input): Output {
    const { names, indices, named, fallback, namespace } = in

    const empty: Row[] = []

    const members = {
        named,
        fallback
    }

    return loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < names.length,
        next: state => {
            const row = state.row
            const binding = read({
                members,
                row: indices[row]
            })

            state.rows = state.rows.push({
                ...binding,
                name: names[row],
                namespace
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })
}
