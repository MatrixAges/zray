import bytes from "std:bytes"
import strings from "std:string"
import memory from "memory"
import columns from "memory/columns"

import read from "./read"

import type { Functions as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { names, indices, named, fallback, target, written } = in

    const members = {
        named,
        fallback
    }

    const namespace = in.namespace
    const owned: string? = namespace == null ? null : strings.copy(namespace)

    const published = loop(0, {
        while: row => row < names.length,
        next: row => {
            const binding = read({
                members,
                row: indices[row]
            })

            const name = strings.copy(names[row])

            memory.writeColumnBytes(target.name, row, bytes.fromText(name))
            columns.writeColumnOptionalText(target.namespace, row, owned)
            columns.writeColumnOptionalU32(target.id, row, binding.id)
            columns.writeColumnOptionalU32(
                target.input_type,
                row,
                binding.input_type
            )
            columns.writeColumnOptionalU32(
                target.output_type,
                row,
                binding.output_type
            )
            columns.writeColumnOptionalU8(target.intrinsic, row, binding.intrinsic)
            row += 1
            memory.writeU64(written, 0, row)
        }
    })
}
