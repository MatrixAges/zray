import memory from "memory"

import type { NamedRows } from "memory"
import type { AliasRow as Row } from "./model"

export type { AliasRow as Row } from "./model"

export type Input = {
    source: NamedRows,
    names: string[],
    indices: u64[]
}

export type Output = Row[]

export default function (in: Input): Output {
    const { names, indices, source } = in

    const empty: Row[] = []

    return loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < names.length,
        next: state => {
            const row = state.row
            const id = memory.readRowId(source, indices[row])

            state.rows = state.rows.push({
                name: names[row],
                type_id: id
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })
}
