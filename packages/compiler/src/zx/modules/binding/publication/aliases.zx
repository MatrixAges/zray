import strings from "std:string"
import memory from "memory"

import type { Aliases as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { names, indices, source, target, written } = in

    const published = loop(0, {
        while: row => row < names.length,
        next: row => {
            const name = strings.copy(names[row])
            const id = memory.readRowId(source, indices[row])

            memory.writeNamedRow(target, row, name, id)
            row += 1
            memory.writeU64(written, 0, row)
        }
    })
}
