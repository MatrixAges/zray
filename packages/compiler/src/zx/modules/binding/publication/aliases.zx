import bytes from "std:bytes"
import memory from "memory"

import type { Aliases, Selected } from "./model"

export type Input = Selected & Aliases.Pick("source", "target")

export type Output = void

export default function (in: Input): Output {
    const { names, indices, source, target, used, owner } = in

    const first = memory.readU64(used, 0)

    const published = loop(0, {
        while: row => row < names.length,
        next: row => {
            const name = memory.copyColumnText(owner, names[row])
            const id = memory.readRowId(source, indices[row])

            const destination = first + row

            memory.writeColumnBytes(
                target.name,
                destination,
                bytes.fromText(name)
            )
            memory.writeColumnU32(target.id, destination, id)
            row += 1
            memory.writeU64(used, 0, first + row)
        }
    })
}
