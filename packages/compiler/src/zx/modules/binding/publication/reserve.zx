import { reserveAppend } from "core/row_buffer"
import memory from "memory"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { selected, destinations } = in
    const { aliases, constants, functions } = destinations

    if (selected.alias_names.length != 0) {
        const capacity = reserveAppend([
            aliases.storage,
            memory.readU64(aliases.used, 0),
            selected.alias_names.length,
            null
        ])
    }

    if (selected.constant_names.length != 0) {
        const capacity = reserveAppend([
            constants.storage,
            memory.readU64(constants.used, 0),
            selected.constant_names.length,
            null
        ])
    }

    if (functions != null && selected.function_names.length != 0) {
        const capacity = reserveAppend([
            functions.storage,
            memory.readU64(functions.used, 0),
            selected.function_names.length,
            null
        ])
    }
}
