import memory from "memory"

import type { PortShape } from "../model"
import type { Members } from "./model"

export type Input = {
    members: Members,
    row: u64
}

export type Output = PortShape

export default function (in: Input): Output {
    const { named, fallback } = in.members

    const row = in.row

    if (fallback != null && row == 0) {
        return fallback
    }

    const first_named: u64 = fallback == null ? 0 : 1
    const index = row - first_named

    return {
        intrinsic: memory.readColumnOptionalU8(named.intrinsic, index),
        id: memory.readColumnOptionalU32(named.id, index),
        input_type: memory.readColumnOptionalU32(named.input_type, index),
        output_type: memory.readColumnOptionalU32(named.output_type, index)
    }
}
