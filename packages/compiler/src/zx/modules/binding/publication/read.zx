import memory from "memory"

import type { PortShape } from "../model"
import type { FunctionColumns } from "./model"

export type Input = {
    source: FunctionColumns,
    row: u64
}

export type Output = PortShape

export default function (in: Input): Output {
    const { source, row } = in

    return {
        intrinsic: memory.readColumnOptionalU8(source.intrinsic, row),
        id: memory.readColumnOptionalU32(source.id, row),
        input_type: memory.readColumnOptionalU32(source.input_type, row),
        output_type: memory.readColumnOptionalU32(source.output_type, row)
    }
}
