<Module>
    <Type from="model" as="Bindings" />

    <Args in={Bindings.Input} out={Bindings.Outcome} />

    <Call
        fn="aliases"
        in={{
            ...$in.destinations.aliases,
            names: $in.selected.alias_names,
            indices: $in.selected.alias_indices
        }}
    />

    <Call
        fn="constants"
        in={{
            names: $in.selected.constant_names,
            indices: $in.selected.constant_indices
        }}
    />

    <If on={$in.destinations.functions != null}>
        <Call
            fn="functions"
            in={{
                ...$in.destinations.functions,
                names: $in.selected.function_names,
                indices: $in.selected.function_indices,
                namespace: $in.selected.namespace
            }}
        />

        <Return
            value={{
                aliases: $ctx.aliases,
                constants: $ctx.constants,
                functions: $ctx.functions
            }}
        />
    </If>

    <Return
        value={{
            aliases: $ctx.aliases,
            constants: $ctx.constants,
            functions: []
        }}
    />
</Module>
