import type { NamedRows, ReadColumn, TextColumn } from "memory"
import type { Span } from "../../frontend/lexer/token_model"
import type { ImportKind } from "../../frontend/parser/imports/model"

export enum Target {
    Source,
    Compiled,
    Native
}

export type NativeNames = {
    locals: TextColumn,
    originals: TextColumn,
    starts: ReadColumn,
    ends: ReadColumn
}

export type Names = {
    source: string,
    locals: Span[],
    originals: Span[],
    native?: NativeNames,
    count: u64
}

export type Name = {
    original: string,
    local: string,
    start: u64,
    end: u64
}

export type Exports = {
    rows: NamedRows,
    length: u64
}

export type PublicNames = {
    rows: TextColumn,
    length: u64,
    default_name?: string
}

export type Request = {
    target: Target,
    kind: ImportKind,
    reexport: bool,
    wildcard: bool,
    start: u64,
    end: u64,
    names: Names,
    type_kinds: u8[],
    exports: Exports,
    constants: PublicNames,
    members: PublicNames,
    signatures?: PublicNames
}

export type Bindings = {
    names: string[],
    indices: u64[]
}

export type FunctionBinding = {
    namespace?: string,
    name: string,
    id?: u32,
    input_type?: u32,
    output_type?: u32,
    intrinsic?: u8
}

export type PortShape = FunctionBinding.Omit("namespace", "name")

export type PortRows = {
    id: ReadColumn,
    input_type: ReadColumn,
    output_type: ReadColumn,
    intrinsic: ReadColumn,
    count: u64
}

export type BindingColumns = PortRows & {
    namespace: ReadColumn,
    name: TextColumn
}

export type Result = {
    alias_names: string[],
    alias_indices: u64[],
    constant_names: string[],
    constant_indices: u64[],
    function_names: string[],
    function_indices: u64[],
    namespace?: string,
    message: string,
    start: u64,
    end: u64
}
