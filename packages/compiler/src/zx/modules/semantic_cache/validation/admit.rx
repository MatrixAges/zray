<Module>
    <Type from="model" as="Artifact" />

    <Args in={Artifact.Request} out={bool} />

    <If on={$in.expected_path != null}>
        <Call
            fn="../state/observe"
            in={{
                path: $in.path,
                expected: $in.expected_path
            }}
        />

        <If on={!$ctx.observe}>
            <Return value={false} />
        </If>
    </If>

    <Call module="header" in={$in.header} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Task name="imports" out={$ctx.binding}>
        <Call
            fn="binding"
            in={{
                bindings: $in.imports,
                input_types: $in.header.tables.signatures.input_types,
                output_types: $in.header.tables.signatures.output_types
            }}
        />
    </Task>

    <If on={!$ctx.task.imports}>
        <Return value={false} />
    </If>

    <Call
        fn="binding"
        in={{
            bindings: $in.members,
            input_types: $in.header.tables.signatures.input_types,
            output_types: $in.header.tables.signatures.output_types
        }}
    />

    <If on={!$ctx.binding}>
        <Return value={false} />
    </If>

    <If on={$in.function_body != null}>
        <Call module="body" in={$in.function_body} />

        <Return value={$ctx.body} />
    </If>

    <Return value={true} />
</Module>
