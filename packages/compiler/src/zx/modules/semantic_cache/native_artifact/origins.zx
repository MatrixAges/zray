import integers from "std:integer"
import memory from "memory"

import type { StringBuffer } from "memory"
import type { OwnedOrigins, Artifact } from "./model"

export type Input = Artifact.Pick("origins") & {
    key: string,
    labels: StringBuffer
}

export type Output = OwnedOrigins

export default function (in: Input): Output {
    const { origins, key } = in

    const labels = memory.stringViews(in.labels)

    return {
        ids: origins.ids.map(id => id)[0],
        kinds: origins.kinds.map(kind => kind)[0],
        owners: origins.ids.map(id => key)[0],
        members: origins.ids.map(id => "")[0],
        names: origins.ids.map(id => labels[integers.widen(id)])[0]
    }
}
