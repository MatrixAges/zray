import memory from "memory"

import type { Allocator, ColumnRanges } from "memory"

export type Input = {
    resource: Allocator,
    ranges: ColumnRanges,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { resource, ranges, count } = in

    const limit = memory.columnRangeSlotCount(ranges)

    const reserved = loop(0, {
        while: slot => slot < limit,
        next: slot => {
            memory.reserveColumnRange(resource, ranges, slot, count, true)
            slot += 1
        }
    })
}
