<Module>
    <Type from="model" as="Artifact" />

    <Args in={Artifact.Publish} out={Artifact.Published} />

    <Call
        fn="index.selectAllocator"
        in={[
            $in.targets.scope,
            $in.targets.payload
        ]}
    />

    <If on={$in.types.kinds.length != 0}>
        <Call
            fn="../../../analysis/semantic/merging/publication/size"
            in={{
                delta: $in.types,
                origins: $in.origins,
                destination: $in.targets.types.destination
            }}
        />

        <Call
            module="../../../analysis/semantic/merging/publication/write"
            in={{
                ...$in.targets.types,
                delta: $in.types,
                origins: {
                    ids: [],
                    kinds: [],
                    owners: [],
                    members: []
                }
            }}
        />
    </If>

    <Call
        fn="../../artifact/surface/allocate_exports"
        in={{
            target: $in.targets.export_target,
            count: $in.exports.length
        }}
    />

    <Call
        fn="index.allocateRows"
        in={{
            target: $in.targets.binding_storage,
            count: $in.members.length
        }}
    />

    <Call
        fn="reserve_signatures"
        in={{
            resource: $in.targets.payload,
            ranges: $in.targets.signature_ranges,
            count: $in.members.length
        }}
    />

    <Call
        fn="header"
        in={{
            key: $in.key,
            path: $in.declaration.path,
            namespace: $in.declaration.namespace
        }}
    />

    <Call
        fn="surface"
        in={{
            exports: $in.exports,
            export_target: $in.targets.export_target
        }}
    />

    <Call
        fn="modules"
        in={{
            declaration: $in.declaration,
            exports: $ctx.surface,
            key: $ctx.header.key,
            namespace: $ctx.header.owner.namespace
        }}
    />

    <Call
        fn="publish_members"
        in={{
            members: $in.members,
            signature_target: $in.targets.signature_target,
            binding_target: $in.targets.binding_target,
            owner: $ctx.header.owner
        }}
    />

    <Call
        fn="origins"
        in={{
            origins: $in.origins,
            labels: $in.targets.types.target.labels,
            key: $ctx.header.key
        }}
    />

    <Return
        value={{
            path: $ctx.header.key,
            modules: $ctx.modules,
            origins: $ctx.origins
        }}
    />
</Module>
