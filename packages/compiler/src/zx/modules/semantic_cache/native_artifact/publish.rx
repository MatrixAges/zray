<Module>
    <Type from="model" as="Artifact" />

    <Args in={Artifact.Publish} out={Artifact.Published} />

    <If on={$in.types.kinds.length != 0}>
        <Call
            fn="../../../analysis/semantic/merging/publication/size"
            in={{
                delta: $in.types,
                origins: $in.origins,
                destination: $in.target.destination
            }}
        />

        <Call
            module="../../../analysis/semantic/merging/publication/write"
            in={{
                ...$in.target,
                delta: $in.types,
                origins: {
                    ids: [],
                    kinds: [],
                    owners: [],
                    members: []
                }
            }}
        />
    </If>

    <Call
        fn="header"
        in={{
            key: $in.key,
            path: $in.declaration.path,
            namespace: $in.declaration.namespace
        }}
    />

    <Call
        fn="surface"
        in={{
            exports: $in.exports
        }}
    />

    <Call
        fn="modules"
        in={{
            declaration: $in.declaration,
            exports: $ctx.surface,
            key: $ctx.header.key,
            namespace: $ctx.header.owner.namespace
        }}
    />

    <Call
        fn="publish_members"
        in={{
            members: $in.members,
            owner: $ctx.header.owner
        }}
    />

    <Call
        fn="origins"
        in={{
            origins: $in.origins,
            labels: $in.target.target.labels,
            key: $ctx.header.key
        }}
    />

    <Return
        value={{
            path: $ctx.header.key,
            modules: $ctx.modules,
            origins: $ctx.origins,
            exports: $ctx.surface,
            members: $ctx.publish_members
        }}
    />
</Module>
