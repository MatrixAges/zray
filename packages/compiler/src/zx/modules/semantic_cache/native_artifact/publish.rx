<Module>
    <Type from="model" as="Artifact" />

    <Args in={Artifact.Publish} out={Artifact.Published} />

    <Call
        fn="header"
        in={{
            key: $in.key,
            path: $in.declaration.path,
            namespace: $in.declaration.namespace
        }}
    />

    <Call
        fn="surface"
        in={{
            exports: $in.exports
        }}
    />

    <Call
        fn="modules"
        in={{
            declaration: $in.declaration,
            exports: $ctx.surface,
            key: $ctx.header.key,
            namespace: $ctx.header.owner.namespace
        }}
    />

    <Call
        fn="publish_members"
        in={{
            members: $in.members,
            owner: $ctx.header.owner
        }}
    />

    <Call
        module="../../../analysis/semantic/merging/publication/write"
        in={{
            ...$in.target,
            delta: $in.types,
            origins: $in.origins,
            native_owner: $ctx.header.key
        }}
    />

    <Return
        value={{
            path: $ctx.header.key,
            modules: $ctx.modules,
            publication: $ctx.write,
            exports: $ctx.surface,
            members: $ctx.publish_members
        }}
    />
</Module>
