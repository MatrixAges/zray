import type { Modules } from "core/native_module_table/model"
import type { Table as Types } from "core/type_table/model"
import type { Bindings as Origins } from "core/type_table/nominal"
import type {
    Target as TypeTail
} from "../../../analysis/semantic/merging/publication/model"
import type { Diagnostic } from "../../../frontend/lexer/model"
import type { Export } from "../../native/interface/exports"
import type { Member } from "../../native/interface/members"
import type { Declaration } from "../restoring/native/model"
import type { Output as PublishedMembers } from "./publish_members"

export type Request = {
    key: string
    source: u8[]
    namespace_bytes: u8[][]
    base: Types
    origins: Origins
}

export type Surface = {
    names: string[]
    ids: u32[]
}

export type Artifact = {
    types: Types
    origins: Origins
    exports: Export[]
    members: Member[]
}

export type Outcome = {
    diagnostic: Diagnostic
    artifact?: Artifact
}

export type OwnedOrigins = Origins & {
    names: string[]
}

export type Publish = Artifact & {
    declaration: Declaration,
    key: string,
    target: TypeTail
}

export type Published = {
    path: string,
    origins: OwnedOrigins,
    modules: Modules,
    exports: Surface,
    members: PublishedMembers
}
