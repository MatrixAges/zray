import memory from "memory/columns"

import signature from "../../link/signature/publication/signature_row"
import bind from "../../native/publication/binding"
import declaration from "../../native/publication/declaration"
import own from "../../native/publication/record"

import type { Owner } from "../../native/publication/model"
import type { Publish } from "./model"

export type Input = Publish.Pick("members", "signature_target", "binding_target") & {
    owner: Owner
}

export type Output = void

export default function (in: Input): Output {
    const { members, owner, binding_target, signature_target } = in

    const written = loop({
        row: 0
    }, {
        while: state => state.row < members.length,
        next: state => {
            const row = state.row
            const source = declaration(members[row])
            const record = own({
                source,
                owner
            })

            const fields = signature(record.pick([
                "signature",
                "flags"
            ]))

            memory.appendSignatureColumnSet(signature_target, fields)

            bind({
                target: binding_target,
                row,
                first: 0,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.row += 1
        }
    })
}
