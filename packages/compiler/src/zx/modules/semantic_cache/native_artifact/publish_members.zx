import signature from "../../link/signature/publication/signature_row"
import bind from "../../native/publication/binding"
import declaration from "../../native/publication/declaration"
import own from "../../native/publication/record"

import type { SignatureRow } from "memory/columns"
import type { Member } from "../../native/interface/members"
import type { Output as Binding } from "../../native/publication/binding"
import type { Owner } from "../../native/publication/model"

export type Input = {
    members: Member[],
    owner: Owner
}

export type Output = {
    signatures: SignatureRow[],
    bindings: Binding[]
}

export default function (in: Input): Output {
    const { members, owner } = in

    const signatures: SignatureRow[] = []
    const bindings: Binding[] = []

    return loop({
        row: 0,
        signatures,
        bindings
    }, {
        while: state => state.row < members.length,
        next: state => {
            const row = state.row
            const source = declaration(members[row])
            const record = own({
                source,
                owner
            })

            const fields = signature(record.pick([
                "signature",
                "flags"
            ]))

            const binding = bind({
                row,
                first: 0,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.signatures = state.signatures.push(fields)[0]
            state.bindings = state.bindings.push(binding)[0]
            state.row += 1
        },
        return: state => ({
            signatures: state.signatures,
            bindings: state.bindings
        })
    })
}
