import { appendSignature } from "core/column_set"

import signature from "../../link/signature/publication/signature_row"
import bind from "../../native/publication/binding"
import declaration from "../../native/publication/declaration"
import own from "../../native/publication/record"

import type { ColumnSet } from "memory/columns"
import type { Target as MemberRows } from "../../artifact/surface/bindings"
import type { Member } from "../../native/interface/members"
import type { Owner } from "../../native/publication/model"

export type Input = {
    members: Member[],
    signature_target: ColumnSet,
    binding_target: MemberRows,
    owner: Owner
}

export type Output = void

export default function (in: Input): Output {
    const { members, owner, binding_target, signature_target } = in

    const written = loop({
        row: 0
    }, {
        while: state => state.row < members.length,
        next: state => {
            const row = state.row
            const source = declaration(members[row])
            const record = own({
                source,
                owner
            })

            const fields = signature(record.pick([
                "signature",
                "flags"
            ]))

            appendSignature({
                storage: signature_target,
                row: fields
            })

            bind({
                target: binding_target,
                row,
                first: 0,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.row += 1
        }
    })
}
