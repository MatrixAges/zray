<Module>
    <Type from="model" as="Artifact" />

    <Args in={Artifact.Request} out={Artifact.Outcome} />

    <Call fn="../../native/origin" in={$in.key} />

    <Call
        module="../../native/load"
        in={{
            base: $in.base,
            namespace: $in.namespace_bytes,
            origin: $ctx.origin,
            origins: $in.origins,
            shared: false,
            source: $in.source
        }}
    />

    <If on={$ctx.load.diagnostic.message != ""}>
        <Return
            value={{
                diagnostic: $ctx.load.diagnostic,
                artifact: null
            }}
        />
    </If>

    <Call
        module="../../../analysis/semantic/produce"
        in={{
            kinds: $ctx.load.delta.kinds,
            first: 0,
            origin: $ctx.origin,
            bindings: $in.origins
        }}
    />

    <Return
        value={{
            diagnostic: $ctx.load.diagnostic,
            artifact: {
                types: $ctx.load.delta,
                origins: $ctx.produce,
                exports: $ctx.load.exports,
                members: $ctx.load.members
            }
        }}
    />
</Module>
