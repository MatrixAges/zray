import host from "project_host"

import type { Commit as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { slot, prepared } = in

    if (prepared.row != 0) {
        host.replaceCacheSlot(slot, prepared.row - 1)
    } else {
        host.appendCacheSlot(slot, prepared.bucket)
    }
}
