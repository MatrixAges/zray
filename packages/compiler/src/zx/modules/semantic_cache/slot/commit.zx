import host from "project_host"

import type { Commit as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { slot, bucket } = in

    const row = host.readCacheBucket(slot, bucket)

    if (row != 0) {
        host.replaceCacheSlot(slot, row - 1)
    } else {
        host.appendCacheSlot(slot, bucket)
    }
}
