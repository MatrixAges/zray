import host from "project_host"

import type { CacheProbe, CacheSlot as Input } from "project_host"

export type Output = CacheProbe

export default function (in: Input): Output {
    const found = host.probeCacheSlot(in)

    if (found.row != 0) {
        return found
    }

    const position = host.reserveCacheSlot(in, found.bucket)

    host.stageCacheSlot(in)

    return {
        bucket: position,
        row: 0
    }
}
