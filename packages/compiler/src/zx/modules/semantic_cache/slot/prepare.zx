import host from "project_host"

import type { CacheSlot as Input } from "project_host"

export type Output = u64

export default function (in: Input): Output {
    const found = host.probeCacheSlot(in)

    if (host.readCacheBucket(in, found) != 0) {
        return found
    }

    const reserved = host.reserveCacheSlot(in)

    const position = match reserved {
        true => host.probeCacheSlot(in),
        _ => found
    }

    host.stageCacheSlot(in)

    return position
}
