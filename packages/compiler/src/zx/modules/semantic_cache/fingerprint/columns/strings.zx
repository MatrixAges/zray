import bytes from "std:bytes"

import encodeValue from "./text"

export type Input = string[]

export type Output = u8[]

export default function (in: Input): Output {
    const parts: u8[][] = [bytes.encodeU64Le(in.length)]

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < in.length,
        next: state => {
            state.parts = state.parts.push(encodeValue(in[state.index]))[0]
            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
