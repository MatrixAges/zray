<Module>
    <Type from="model" as="Fingerprint" />

    <Args in={Fingerprint.Input} out={u8[]} />

    <Task name="interface" out={$ctx.fields}>
        <Call fn="fields" in={$in.fields} />
    </Task>

    <Task name="namespace" out={$ctx.fields}>
        <Call fn="fields" in={$in.namespace} />
    </Task>

    <Call
        fn="native_digest"
        in={{
            fields: $ctx.task.interface,
            namespace: $ctx.task.namespace
        }}
    />

    <Return value={$ctx.native_digest} />
</Module>
