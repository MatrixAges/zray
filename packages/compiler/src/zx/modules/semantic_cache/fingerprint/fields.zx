import bytes from "std:bytes"

export type Input = string[]

export type Output = u8[]

export default function (in: Input): Output {
    const parts: u8[][] = []

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < in.length,
        next: state => {
            const field = bytes.fromText(in[state.index])

            state.parts = state.parts.push(bytes.encodeU64Le(field.length))[0]
            state.parts = state.parts.push(field)[0]
            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
