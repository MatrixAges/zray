import bytes from "std:bytes"

import integerLists from "../columns/integer_lists"
import optionalStrings from "../columns/optional_strings"
import stringLists from "../columns/string_lists"
import strings from "../columns/strings"

import type { Modules } from "core/native_module_table/model"

export type Input = Modules

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        optionalStrings(in.identities),
        strings(in.import_names),
        strings(in.specifiers),
        integerLists(in.type_ids),
        stringLists(in.type_names),
        stringLists(in.type_namespaces)
    ])
}
