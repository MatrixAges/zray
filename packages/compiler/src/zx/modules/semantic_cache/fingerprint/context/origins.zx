import bytes from "std:bytes"

import integers from "../columns/integers"
import octets from "../columns/octets"
import strings from "../columns/strings"

import type { Origins } from "./model"

export type Input = Origins

export type Output = u8[]

export default function (in: Input): Output {
    const { bindings, names } = in

    return bytes.join(bytes.fromText(""), [
        integers(bindings.ids),
        octets(bindings.kinds),
        strings(bindings.owners),
        strings(bindings.members),
        strings(names)
    ])
}
