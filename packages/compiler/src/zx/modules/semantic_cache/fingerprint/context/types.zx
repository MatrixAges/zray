import bytes from "std:bytes"

import integers from "../columns/integers"
import octets from "../columns/octets"
import strings from "../columns/strings"

import type { Table } from "core/type_table/model"

export type Input = Table

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        octets(in.kinds),
        integers(in.first),
        integers(in.second),
        strings(in.labels),
        integers(in.children),
        integers(in.field_types),
        strings(in.field_names),
        strings(in.names)
    ])
}
