<Module>
    <Type from="model" as="Context" />

    <Args in={Context.Input} out={u8[]} />

    <Call fn="types" in={$in.types} />
    <Call fn="origins" in={$in.origins} />
    <Call fn="native_modules" in={$in.native_modules} />
    <Call fn="stores" in={$in.stores} />

    <Call
        fn="digest"
        in={{
            types: $ctx.types,
            origins: $ctx.origins,
            native_modules: $ctx.native_modules,
            stores: $ctx.stores
        }}
    />

    <Return value={$ctx.digest} />
</Module>
