import bytes from "std:bytes"

import optionalText from "../columns/optional_text"
import text from "../columns/text"

import type { Store } from "./model"

export type Input = Store

export type Output = u8[]

export default function (in: Input): Output {
    const { type_id } = in

    const encoded_id = type_id == null ? bytes.fromText("") : bytes.encodeU32Le(type_id)

    return bytes.join(bytes.fromText(""), [
        text(in.handle),
        text(in.path),
        optionalText(in.type_name),
        bytes.repeat(1, type_id == null ? 0 : 1),
        encoded_id,
        bytes.repeat(1, in.readable ? 1 : 0),
        bytes.repeat(1, in.writable ? 1 : 0)
    ])
}
