import bytes from "std:bytes"
import memory from "memory"

import encodeStore from "./store"

import type { StoreRows } from "./model"

export type Input = StoreRows

export type Output = u8[]

export default function (in: Input): Output {
    const parts: u8[][] = [bytes.encodeU64Le(in.count)]

    const collected = loop({
        row: 0,
        parts
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row

            const encoded = encodeStore({
                handle: memory.readTextColumn(in.handle, row),
                path: memory.readTextColumn(in.path, row),
                type_name: memory.readOptionalTextColumn(in.type_name, row),
                type_id: memory.readColumnOptionalU32(in.type_id, row),
                readable: memory.readColumnBool(in.readable, row),
                writable: memory.readColumnBool(in.writable, row)
            })

            state.parts = state.parts.push(encoded)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
