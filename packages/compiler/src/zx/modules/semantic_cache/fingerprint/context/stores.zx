import bytes from "std:bytes"
import memory from "memory"

import writeStore from "./store"

import type { Input as Context } from "./model"

export type Input = Context.Pick("writer", "stores")

export type Output = void

export default function (in: Input): Output {
    const { writer, stores } = in

    bytes.writeU64Le(writer, stores.count)

    const encoded = loop(0, {
        while: row => row < stores.count,
        next: row => {
            writeStore({
                writer,
                binding: {
                    handle: memory.readTextColumn(stores.handle, row),
                    path: memory.readTextColumn(stores.path, row),
                    type_name: memory.readOptionalTextColumn(stores.type_name, row),
                    type_id: memory.readColumnOptionalU32(stores.type_id, row),
                    readable: memory.readColumnBool(stores.readable, row),
                    writable: memory.readColumnBool(stores.writable, row)
                }
            })

            row += 1
        }
    })
}
