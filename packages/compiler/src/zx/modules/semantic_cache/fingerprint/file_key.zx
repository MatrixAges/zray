import strings from "std:string"

import digest from "../../../artifact_codec/digest"
import { cache_extension, native_directory } from "./const"

export type Input = {
    native: bool,
    key: string
}

export type Output = string

export default function (in: Input): Output {
    return strings.join("", [
        in.native ? native_directory : "",
        digest({
            source: in.key,
            start: 0
        }),
        cache_extension
    ])
}
