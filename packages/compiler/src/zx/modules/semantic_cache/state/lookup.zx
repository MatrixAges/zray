import version from "./version"

import type { CacheEntry } from "project_host"

export type Candidate = {
    entry: CacheEntry,
    source: u8[],
    context: u8[]
}

export type Input = {
    candidate?: Candidate,
    source: u8[],
    context: u8[]
}

export type Output = CacheEntry?

export default function (in: Input): Output {
    const { candidate, source, context } = in

    if (candidate == null) {
        return null
    }

    const valid = version({
        cached_source: candidate.source,
        source,
        cached_context: candidate.context,
        context
    })

    return valid ? candidate.entry : null
}
