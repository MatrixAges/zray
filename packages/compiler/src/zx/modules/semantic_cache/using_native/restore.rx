<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Input} out={bool} />

    <Call fn="../state/lookup" in={$in.lookup} />

    <If on={$ctx.lookup != null}>
        <Call
            fn="index.restoreCachedNative"
            in={[
                $in.frame,
                $ctx.lookup
            ]}
        />

        <Return value={$ctx.restoreCachedNative} />
    </If>

    <Return value={false} />
</Module>
