<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Input} out={Native.Output} />

    <If on={$in.lookup != null}>
        <Call fn="../state/lookup" in={$in.lookup} />

        <Return
            value={{
                candidate: $ctx.lookup
            }}
        />
    </If>

    <If on={$in.restored != null}>
        <Call fn="../state/usage_slot" in={$in.restored} />

        <Call
            fn="index.advanceLengthSlot"
            in={[
                $in.usage,
                $ctx.usage_slot,
                1
            ]}
        />
    </If>

    <If on={$in.slot != null}>
        <Call module="../slot/install" in={$in.slot} />

        <Return
            value={{
                candidate: false,
                pending: $ctx.install
            }}
        />
    </If>

    <Return
        value={{
            candidate: false
        }}
    />
</Module>
