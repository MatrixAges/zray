<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Input} out={Native.Output} />

    <Call module="restore" in={$in} />

    <Call fn="../state/usage_slot" />

    <Call
        fn="index.advanceLengthSlot"
        in={[
            $in.usage,
            $ctx.usage_slot,
            1
        ]}
    />

    <If on={!$ctx.restore}>
        <Call fn="index.buildNativeCacheEntry" in={$in.frame} />
        <Call fn="../slot/prepare" in={$in.slot} />
        <Call fn="index.validateNativeCacheEntry" in={$in.frame} />
        <Call fn="../slot/commit" in={$ctx.prepare} />

        <Return
            value={{
                admitted: false,
                pending: $ctx.commit
            }}
        />
    </If>

    <Return
        value={{
            admitted: true
        }}
    />
</Module>
