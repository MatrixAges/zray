<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Input} out={Native.Output} />

    <Call module="restore" in={$in} />

    <Call fn="../state/usage_slot" />

    <Call
        fn="index.advanceLengthSlot"
        in={[
            $in.usage,
            $ctx.usage_slot,
            1
        ]}
    />

    <If on={!$ctx.restore}>
        <Call fn="index.buildNativeCacheEntry" in={$in.frame} />

        <Call module="../slot/install" in={$in.slot} />

        <If on={$ctx.install.replacement == null}>
            <Call
                fn="index.stageNativeCacheEntry"
                in={[
                    $in.frame,
                    $ctx.install.bucket
                ]}
            />
        </If>

        <Call fn="index.validateNativeCacheEntry" in={$in.frame} />

        <Return
            value={{
                admitted: false,
                pending: $ctx.install
            }}
        />
    </If>

    <Return
        value={{
            admitted: true
        }}
    />
</Module>
