<Module>
    <Type from="model" as="Envelope" />

    <Args in={Envelope.Seal} out={u8[]} />

    <Call
        fn="../../../artifact_codec/digest"
        in={{
            source: $in.payload,
            start: 0
        }}
    />

    <Call
        fn="header"
        in={{
            compiler: $in.compiler,
            digest: $ctx.digest
        }}
    />

    <Return value={$ctx.header} />
</Module>
