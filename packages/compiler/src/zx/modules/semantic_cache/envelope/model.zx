export type Layout = {
    compiler_start: u64,
    digest_start: u64,
    payload_start: u64
}

export type Open = {
    source: string,
    compiler: u8[]
}

export type Payload = {
    start: u64,
    maximum_depth: u64
}

export type Inspect = {
    source: string,
    compiler: u8[],
    layout: Layout
}

export type Seal = {
    compiler: u8[],
    payload: string
}

export type Header = {
    compiler: u8[],
    digest: string
}
