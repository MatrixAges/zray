<Module>
    <Type from="model" as="Rebind" />

    <Args in={Rebind.Input} out={Rebind.Result} />

    <Call fn="../functions/alias" in={$in.aliases} />

    <If on={!$ctx.alias}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <Call fn="../modules" in={$in.modules} />

    <If on={$ctx.modules == null}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <Task name="imports" out={$ctx.bindings}>
        <Call module="../functions/bindings" in={$in.bindings} />
    </Task>

    <If on={$ctx.task.imports == null}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <Call
        module="../functions/bindings"
        in={{
            ...$in.members,
            mapping: $ctx.task.imports ?? []
        }}
    />

    <If on={$ctx.bindings == null}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <If on={$in.signatures.previous.files.length != 0}>
        <Call
            fn="../functions/signatures"
            in={{
                ...$in.signatures,
                functions: $ctx.bindings ?? [],
                modules: $ctx.modules ?? []
            }}
        />

        <If on={!$ctx.signatures}>
            <Return
                value={{
                    status: Rebind.Status.Invalid
                }}
            />
        </If>
    </If>

    <Call fn="entry" in={$in.entry} />

    <Return
        value={{
            ...$ctx.entry,
            functions: $ctx.bindings,
            modules: $ctx.modules
        }}
    />
</Module>
