import integers from "std:integer"
import { max_u32 } from "core/const"

import { Status } from "./model"

import type { Entry, Candidate } from "./model"

export type Input = Entry

export type Output = Candidate

export default function (in: Input): Output {
    if (!in.has_body) {
        return {
            status: Status.Ready
        }
    }

    if (in.linked_count >= integers.widen(max_u32)) {
        return {
            status: Status.Full
        }
    }

    const id = integers.narrow(in.linked_count)

    return {
        status: Status.Ready,
        entry: id
    }
}
