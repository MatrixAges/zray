import type { Input as Output, Source } from "./model"

export type Input = {
    source: Source,
    types: u32[],
    functions: u32?[]
}

export default function (in: Input): Output {
    const { source, types, functions } = in

    const current_count = source.linked_count

    return {
        aliases: {
            ...source.aliases,
            types
        },
        modules: {
            ...source.modules,
            types
        },
        bindings: {
            ...source.bindings,
            types,
            mapping: functions,
            current_count
        },
        members: {
            ...source.members,
            types,
            mapping: functions,
            current_count
        },
        signatures: {
            ...source.signatures,
            types
        },
        entry: {
            has_body: source.has_body,
            linked_count: current_count
        }
    }
}
