import type { Aliases, Bindings, Signatures } from "../functions/model"
import type { Input as Modules } from "../modules"

export enum Status {
    Invalid,
    Full,
    Ready
}

export type Candidate = {
    status: Status,
    entry?: u32
}

export type Result = Candidate & {
    functions?: u32?[],
    modules?: u32?[]
}

export type Entry = {
    has_body: bool,
    linked_count: u64
}

export type Input = {
    aliases: Aliases,
    modules: Modules,
    bindings: Bindings,
    members: Bindings,
    signatures: Signatures.Pick("previous", "current", "types"),
    entry: Entry
}

export type Source = {
    aliases: Aliases.Omit("types"),
    modules: Modules.Pick("previous", "current"),
    bindings: Bindings.Pick("previous", "current"),
    members: Bindings.Pick("previous", "current"),
    signatures: Signatures.Pick("previous", "current"),
    has_body: bool,
    linked_count: u64
}
