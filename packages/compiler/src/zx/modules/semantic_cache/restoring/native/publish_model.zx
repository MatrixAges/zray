import type { Table as Signatures } from "core/signature_table/model"
import type {
    Target as TypeTarget
} from "../../../../analysis/semantic/merging/publication/model"
import type { Rows } from "../../../../ir/canonical/validation/names/model"
import type { Output as ExportBindings } from "../../../native/delivery/exports"
import type { Batch, Cache, Staging } from "../../../native/publication/model"
import type { Status, Value } from "./result"

export type Members = Staging & {
    cached: Cache,
    module: u32
}

export type Input = Value & {
    destination: TypeTarget,
    members: Staging,
    module: u32,
    signatures: Signatures,
    exported: Rows,
    namespace: string[]
}

export type Installation = Batch & {
    namespace: string[],
    exports: ExportBindings
}

export type Output = {
    status: Status,
    installation?: Installation
}
