import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { U32Buffer } from "zig:compiler_memory"
import type { Rows } from "../../../../ir/canonical/validation/names/model"

export type Input = {
    source: Rows,
    target: U32Buffer,
    mapping: u32[]
}

export type Output = void

export default function (in: Input): Output {
    const { source, target, mapping } = in

    const written = loop({
        index: 0
    }, {
        while: state => state.index < source.length,
        next: state => {
            const id = memory.readRowId(source.rows, state.index)

            memory.writeU32(target, state.index, mapping[integers.widen(id)])

            state.index += 1
        }
    })
}
