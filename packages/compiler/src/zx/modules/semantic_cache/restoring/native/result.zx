import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Output as Mapping } from "./ports"

export enum Status {
    Ready,
    InvalidModule,
    InvalidIr,
    MissingNominalOrigin,
    ConflictingNominalType,
    Full
}

export type Value = {
    types: Table,
    origins: Bindings,
    mapping: Mapping
}

export type Result = {
    status: Status,
    value?: Value
}
