import memory from "memory"

import type { Reserve as Input } from "./restore_input"

export type Output = u32[]

export default function (in: Input): Output {
    const { storage, types, inputs, outputs, type_count, member_count } = in

    const output_start = type_count + member_count
    const capacity = output_start + member_count

    memory.allocateU32Views(storage, capacity)
    memory.bindU32Range(storage, types, 0, type_count)
    memory.bindU32Range(storage, inputs, type_count, member_count)
    memory.bindU32Range(storage, outputs, output_start, member_count)

    return memory.u32Views(types)
}
