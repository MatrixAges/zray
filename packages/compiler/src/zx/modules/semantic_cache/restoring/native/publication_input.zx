import type { Input as Publication, Members } from "./publish_model"

export type Input = Publication.Pick("members", "mapping", "signatures", "module")

export type Output = Members

export default function (in: Input): Output {
    const { members, mapping, signatures, module } = in

    return {
        ...members,
        cached: {
            signatures,
            inputs: mapping.inputs,
            outputs: mapping.outputs
        },
        module
    }
}
