<Module>
    <Type from="publish_model" as="Publish" />
    <Type from="result" as="Result" />

    <Args in={Publish.Input} out={Publish.Output} />

    <Call
        fn="publication_input"
        in={$in.pick([
            "members",
            "mapping",
            "signatures",
            "module"
        ])}
    />

    <Call module="publish_members" />

    <Call
        fn="../../../native/publication/namespace"
        in={{
            published: $ctx.publish_members.namespace,
            original: $in.namespace
        }}
    />

    <Call
        fn="../../../native/publication/bindings"
        in={{
            source: $in.exported,
            types: $in.mapping.types
        }}
    />

    <If on={!$ctx.bindings.valid}>
        <Return
            value={{
                status: Result.Status.Full
            }}
        />
    </If>

    <Call
        fn="../../../../analysis/semantic/merging/publication/size"
        in={{
            delta: $in.types,
            origins: $in.origins,
            destination: $in.destination.destination
        }}
    />

    <Call
        module="../../../../analysis/semantic/merging/publication/stage"
        in={{
            ...$in.destination,
            delta: $in.types,
            origins: $in.origins
        }}
    />

    <Return
        value={{
            status: Result.Status.Ready,
            installation: {
                ...$ctx.publish_members,
                namespace: $ctx.namespace,
                exports: $ctx.bindings.omit(["valid"])
            }
        }}
    />
</Module>
