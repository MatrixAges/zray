import integers from "std:integer"

export type Input = {
    input_types: u32[],
    output_types: u32[],
    types: u32[]
}

export type Output = {
    types: u32[],
    inputs: u32[],
    outputs: u32[]
}

export default function (in: Input): Output {
    const { input_types, output_types, types } = in

    return {
        types,
        inputs: input_types.map(id => types[integers.widen(id)])[0],
        outputs: output_types.map(id => types[integers.widen(id)])[0]
    }
}
