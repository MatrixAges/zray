import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { Rows } from "./bindings"
import type { Mapping, Target } from "./publish_model"
import type { Input as Validation } from "./validation"

export type Reserve = Mapping & {
    type_count: u64,
    member_count: u64
}

export type Preparation = {
    base: Table,
    base_origins: Bindings,
    origin_names: string[],
    mapping: Mapping,
    validation: Validation,
    admission?: Rows
}

export type Input = Preparation & {
    target: Target
}
