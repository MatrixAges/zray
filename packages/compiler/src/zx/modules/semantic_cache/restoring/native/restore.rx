<Module>
    <Type from="restore_input" as="Restore" />
    <Type from="result" as="Result" />

    <Args in={Restore.Input} out={Result.Result} />

    <If on={$in.admission != null}>
        <Call
            module="admit"
            in={{
                request: $in.validation.request,
                imports: $in.admission
            }}
        />

        <If on={!$ctx.admit}>
            <Return
                value={{
                    status: Result.Status.InvalidModule
                }}
            />
        </If>

        <Call module="validate" in={$in.validation} />

        <If on={!$ctx.validate}>
            <Return
                value={{
                    status: Result.Status.InvalidIr
                }}
            />
        </If>
    </If>

    <Call module="merge" in={$in} />

    <Return value={$ctx.merge} />
</Module>
