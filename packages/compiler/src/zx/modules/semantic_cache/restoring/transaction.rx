<Module>
    <Type from="transaction_model" as="Restore" />
    <Type from="rebind/model" as="Rebind" />

    <Args in={Restore.Input} out={Restore.Output} />

    <Call module="preflight/admit" in={$in.preflight} />

    <If on={!$ctx.admit}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <Call
        fn="rebind/reserve"
        in={{
            ...$in.buffers,
            type_count: $in.types.merge.source.kinds.length,
            function_count: $in.rebind.signatures.previous.files.length,
            module_count: $in.rebind.modules.previous.specifiers.length,
            has_body: $in.rebind.has_body
        }}
    />

    <Call
        module="types/plan"
        in={{
            ...$in.types,
            type_ids: $ctx.reserve.types
        }}
    />

    <If on={$ctx.plan == null}>
        <Return
            value={{
                status: Rebind.Status.Invalid
            }}
        />
    </If>

    <Call
        fn="rebind/input"
        in={{
            source: $in.rebind,
            buffers: $in.buffers,
            mappings: $ctx.reserve
        }}
    />

    <Call module="rebind/check" />

    <If on={$ctx.check.status != Rebind.Status.Ready}>
        <Return
            value={{
                status: $ctx.check.status
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.check,
            plan: $ctx.plan
        }}
    />
</Module>
