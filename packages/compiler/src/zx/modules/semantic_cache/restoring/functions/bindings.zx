import bind from "compiler/artifact_binding_restore"

import read from "../../../binding/read"

import type { Bindings } from "./model"

export type Input = Bindings

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, mapping, target, types, current_count } = in

    if (previous.count != current.count) {
        return false
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.count,
        next: state => {
            const row = state.row

            state.valid = bind({
                previous: read({
                    columns: previous,
                    row
                }),
                current: read({
                    columns: current,
                    row
                }),
                mapping,
                target,
                types,
                current_count
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
