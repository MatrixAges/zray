<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Bindings} out={bool} />

    <If on={$in.previous.count != $in.current.count}>
        <Return value={false} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="advance_bindings"
            in={{
                source: $in,
                row: 0,
                valid: true,
                running: $in.previous.count != 0
            }}
        />
    </Loop>

    <Return value={$ctx.advance_bindings.valid} />
</Module>
