<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Traversal} out={Cache.Traversal} />

    <Call fn="rows" in={$in} />

    <Call module="bind" />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            mapping: $ctx.bind ?? $in.mapping,
            valid: $ctx.bind != null,
            running: $ctx.bind != null && $in.row + 1 < $in.source.previous.count
        }}
    />
</Module>
