import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { Aliases } from "./model"

export type Input = Aliases

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, types } = in

    if (previous.length != current.length) {
        return false
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.length,
        next: state => {
            const row = state.row
            const id = memory.readRowId(previous.rows, row)
            const index = integers.widen(id)

            if (index >= types.length) {
                state.valid = false
            } else {
                const left = memory.readRowName(previous.rows, row)
                const right = memory.readRowName(current.rows, row)
                const current_id = memory.readRowId(current.rows, row)

                state.valid = left == right && types[index] == current_id
            }

            state.row += 1
        },
        return: state => state.valid
    })
}
