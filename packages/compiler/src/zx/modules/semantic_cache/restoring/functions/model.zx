import type { OptionalU32Buffer } from "zig:compiler_memory"
import type { Table } from "core/signature_table/model"
import type { Rows } from "../../../../ir/canonical/validation/names/model"
import type { FunctionBinding } from "../../../binding/model"

export type Binding = {
    previous: FunctionBinding,
    current: FunctionBinding,
    mapping: u32?[],
    target: OptionalU32Buffer,
    types: u32[],
    current_count: u64
}

export type Aliases = {
    previous: Rows,
    current: Rows,
    types: u32[]
}

export type Bindings = {
    previous: FunctionBinding[],
    current: FunctionBinding[],
    mapping: u32?[],
    target: OptionalU32Buffer,
    types: u32[],
    current_count: u64
}

export type Signatures = {
    previous: Table,
    current: Table,
    types: u32[],
    functions: u32?[],
    modules: u32?[]
}

export type Row = {
    signatures: Signatures,
    previous: u64,
    current: u64
}
