import type { MappingBuffers, Source as Rebind, Result } from "./rebind/model"
import type { Input as TypeRequest, Plan } from "./types/model"

export type Input = {
    types: TypeRequest.Omit("type_ids"),
    rebind: Rebind,
    buffers: MappingBuffers
}

export type Output = Result & {
    plan?: Plan
}
