import integers from "std:integer"
import binding from "core/native_module_table/binding"
import memory from "memory"

import lookup from "../../link/native/lookup"
import { Status } from "../../link/native/model"

import type { Modules } from "core/native_module_table/model"
import type { OptionalU32Buffer } from "memory"

export type Input = {
    previous: Modules,
    current: Modules,
    types: u32[],
    target: OptionalU32Buffer
}

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, types, target } = in

    const count = previous.specifiers.length

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            const index = state.index
            const result = lookup({
                table: current,
                mapping: types,
                value: binding({
                    source: previous,
                    row: index
                })
            })

            state.valid = result.status == Status.Reuse

            if (state.valid) {
                const id = integers.narrow(result.row)

                memory.writeOptionalU32(target, index, id)
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
