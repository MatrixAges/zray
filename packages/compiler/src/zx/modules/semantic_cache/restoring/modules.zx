import integers from "std:integer"
import binding from "core/native_module_table/binding"

import lookup from "../../link/native/lookup"
import { Status } from "../../link/native/model"

import type { Modules } from "core/native_module_table/model"

export type Input = {
    previous: Modules,
    current: Modules,
    types: u32[]
}

export type Output = u32?[]?

export default function (in: Input): Output {
    const { previous, current, types } = in

    const count = previous.specifiers.length

    const empty: u32?[] = []

    return loop({
        index: 0,
        mapping: empty,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            const index = state.index
            const result = lookup({
                table: current,
                mapping: types,
                value: binding({
                    source: previous,
                    row: index
                })
            })

            state.valid = result.status == Status.Reuse

            if (state.valid) {
                const id = integers.narrow(result.row)

                state.mapping = state.mapping.push(id)[0]
            }

            state.index += 1
        },
        return: state => state.valid ? state.mapping : null
    })
}
