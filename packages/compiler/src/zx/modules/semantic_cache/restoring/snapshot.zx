export type Columns = {
    types: u64[],
    origin_count: u64,
    function_count: u64
}

export type Input = Columns

export type Output = {
    function_count: u64,
    origin_count: u64,
    type_counts: u64[]
}

export default function (in: Input): Output {
    return {
        ...in.omit(["types"]),
        type_counts: in.types
    }
}
