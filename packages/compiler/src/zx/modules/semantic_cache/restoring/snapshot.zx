import memory from "memory"

import type { ColumnLengths, U64Buffer } from "memory"

export type Columns = {
    types: ColumnLengths,
    origins: ColumnLengths,
    functions: ColumnLengths
}

export type Input = Columns & {
    type_counts: U64Buffer
}

export type Output = {
    function_count: u64,
    origin_count: u64
}

export default function (in: Input): Output {
    memory.captureColumnLengths(in.types, in.type_counts)

    return {
        function_count: memory.firstColumnLength(in.functions),
        origin_count: memory.firstColumnLength(in.origins)
    }
}
