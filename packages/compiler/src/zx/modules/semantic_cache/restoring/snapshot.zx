import { capture } from "core/column_lengths"
import memory from "memory"

import type { BoolBuffer, ColumnLengths, U64Buffer } from "memory"

export type Columns = {
    types: ColumnLengths,
    origins: ColumnLengths,
    functions: ColumnLengths
}

export type Input = Columns & {
    type_counts: U64Buffer,
    function_count: U64Buffer,
    origin_count: U64Buffer,
    saved: BoolBuffer
}

export type Output = void

export default function (in: Input): Output {
    capture({
        source: in.types,
        target: in.type_counts
    })

    memory.writeU64(in.function_count, 0, memory.readLengthSlot(in.functions, 0))
    memory.writeU64(in.origin_count, 0, memory.readLengthSlot(in.origins, 0))
    memory.writeBool(in.saved, 0, true)
}
