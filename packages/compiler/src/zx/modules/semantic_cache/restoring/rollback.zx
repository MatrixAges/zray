import memory from "memory"

import type { Columns, Output as Snapshot } from "./snapshot"

export type Input = Columns & Snapshot & {
    type_counts: u64[]
}

export type Output = void

export default function (in: Input): Output {
    if (in.function_count != memory.firstColumnLength(in.functions)) {
        memory.truncateColumnLengths(in.functions, in.function_count)
    }

    memory.restoreColumnLengths(in.types, in.type_counts)
    memory.truncateColumnLengths(in.origins, in.origin_count)
}
