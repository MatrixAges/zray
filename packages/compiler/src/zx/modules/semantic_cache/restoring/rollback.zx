import type { Output as Saved } from "./snapshot"

export type Input = Saved & {
    current_function_count: u64
}

export type Output = Saved.Omit("function_count") & {
    function_count?: u64
}

export default function (in: Input): Output {
    const { function_count, current_function_count, type_counts, origin_count } = in

    return {
        function_count: function_count == current_function_count ? null : function_count,
        type_counts,
        origin_count
    }
}
