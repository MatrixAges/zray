import { restore, truncate } from "core/column_lengths"
import memory from "memory"

import type { Columns, Output as Snapshot } from "./snapshot"

export type Input = Columns & Snapshot & {
    type_counts: u64[]
}

export type Output = void

export default function (in: Input): Output {
    if (in.function_count != memory.readLengthSlot(in.functions, 0)) {
        truncate({
            target: in.functions,
            count: in.function_count
        })
    }

    restore({
        target: in.types,
        counts: in.type_counts
    })

    truncate({
        target: in.origins,
        count: in.origin_count
    })
}
