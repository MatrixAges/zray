export type Input = {
    types: u32[],
    functions: u32?[],
    modules: u32?[],
    candidate?: u32
}

export type Output = Input

export default function (in: Input): Output {
    const { candidate, functions } = in

    if (candidate == null) {
        return in
    }

    return {
        ...in,
        functions: functions.push(candidate)[0]
    }
}
