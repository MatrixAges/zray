<Module>
    <Type from="verification" as="Verification" />
    <Type from="verify_unit" as="Unit" />
    <Type from="../../../../ir/canonical/validation/prefix" as="Prefix" />

    <Args in={Verification.Request & Unit.Input} out={Prefix.Output?} />

    <Call
        fn="verification"
        in={$in.pick([
            "views",
            "scope",
            "scratch"
        ])}
    />

    <Call
        fn="verify_unit"
        in={$in.pick([
            "program",
            "empty"
        ])}
    />

    <Call
        module="../../../../ir/canonical/validation/verify"
        in={{
            version: $in.version,
            expected_version: $in.version,
            context: $ctx.verification,
            unit: $ctx.verify_unit,
            exports: $in.exports,
            constant_exports: $in.constant_exports
        }}
    />

    <Return value={$ctx.verify} />
</Module>
