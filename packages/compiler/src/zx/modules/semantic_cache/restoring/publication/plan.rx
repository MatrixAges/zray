<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Committed?} />

    <Call module="types" in={$in.types} />

    <Call fn="../../../../ir/canonical/stores/validate" in={$in.stores} />

    <If on={!$ctx.validate}>
        <Return value={null} />
    </If>

    <Call
        module="../../../artifact/remapping/optional_body"
        in={{
            source: $in.body
        }}
    />

    <Call
        module="stores"
        in={{
            source: $in.stores,
            mapping: $in.surface.types,
            body: $ctx.optional_body,
            reuse: $in.reuse_store_types
        }}
    />

    <Call module="../../../artifact/materializing/optional_control" in={$in.control} />
    <Call module="../../../artifact/surface/own" in={$in.surface} />

    <Call
        fn="entry"
        in={{
            body: $ctx.optional_body,
            control: $ctx.optional_control,
            attributes: $in.attributes
        }}
    />

    <If on={$ctx.entry.recursive != null && $ctx.entry.body != null}>
        <Call
            module="../../../link/result/publication/register"
            in={{
                destination: $in.functions,
                entry: {
                    ports: $ctx.entry.ports,
                    body: $ctx.entry.body
                },
                file: $in.path,
                stores: $ctx.stores,
                empty: $in.empty
            }}
        />
    </If>

    <Call
        module="verify"
        in={{
            ...$in.verification,
            program: {
                ...$ctx.entry,
                stores: $ctx.stores
            },
            empty: $in.empty
        }}
    />

    <Call
        fn="commit"
        in={{
            scope: $in.verification.scope,
            payload: $in.verification.payload,
            program: {
                ...$ctx.entry,
                stores: $ctx.stores
            },
            verified: $ctx.verify
        }}
    />

    <Return value={$ctx.commit} />
</Module>
