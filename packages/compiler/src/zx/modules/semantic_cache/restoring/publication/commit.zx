import memory from "memory"

import type { Output as Verified } from "../../../../ir/canonical/validation/prefix"
import type { Committed as Output, Plan } from "./model"
import type { Request } from "./verification"

export type Input = Request.Pick("scope", "payload") & {
    program: Plan,
    verified?: Verified
}

export default function (in: Input): Output {
    const { scope, payload, program, verified } = in

    memory.selectAllocator(scope, payload)

    return {
        ...program,
        verified
    }
}
