<Module>
    <Type from="model" as="Publication" />
    <Type from="../../../../analysis/semantic/merging/publication/model" as="Tail" />

    <Args in={Publication.Types} out={Tail.Plan} />

    <If on={$in.scalars != null}>
        <Call
            fn="../../../compiled/loading/type_delta"
            in={{
                base: $in.scalars,
                delta: $in.plan.delta,
                existing_count: 0
            }}
        />

        <Call
            module="../../../../analysis/semantic/merging/publication/write"
            in={{
                ...$in.target,
                delta: $ctx.type_delta,
                origins: $in.plan.origins
            }}
        />

        <Return value={$ctx.write} />
    </If>

    <Call
        module="../../../../analysis/semantic/merging/publication/write"
        in={{
            ...$in.target,
            delta: $in.plan.delta,
            origins: $in.plan.origins
        }}
    />

    <Return value={$ctx.write} />
</Module>
