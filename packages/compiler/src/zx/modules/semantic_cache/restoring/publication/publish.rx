<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Published?} />

    <Call
        module="types"
        in={{
            target: $in.views.types,
            plan: $in.plan,
            scalars: $in.views.scalars
        }}
    />

    <Call fn="../../../../ir/canonical/stores/validate" in={$in.views.stores} />

    <If on={!$ctx.validate}>
        <Return value={null} />
    </If>

    <Call
        module="../../../artifact/remapping/optional_body"
        in={{
            source: $in.views.body
        }}
    />

    <Call
        module="stores"
        in={{
            source: $in.views.stores,
            mapping: $in.views.surface.types,
            body: $ctx.optional_body,
            reuse: $in.views.reuse_store_types
        }}
    />

    <Call
        module="../../../artifact/materializing/optional_control"
        in={$in.views.control}
    />

    <Call module="../../../artifact/surface/own" in={$in.views.surface} />

    <Call
        fn="entry"
        in={{
            body: $ctx.optional_body,
            control: $ctx.optional_control,
            attributes: $in.views.attributes
        }}
    />

    <If on={$ctx.entry.recursive != null && $ctx.entry.body != null}>
        <Call
            module="../../../link/result/publication/register"
            in={{
                destination: $in.views.functions,
                entry: {
                    ports: $ctx.entry.ports,
                    body: $ctx.entry.body
                },
                file: $in.views.path,
                stores: $ctx.stores,
                empty: $in.views.empty
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.entry,
            stores: $ctx.stores,
            publication: $ctx.types
        }}
    />
</Module>
