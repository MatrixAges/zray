<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Records} out={bool} />

    <Loop on={$in.running}>
        <Call
            module="advance_check"
            in={{
                source: $in,
                row: 0,
                valid: true,
                running: $in.previous.header.count != 0
            }}
        />
    </Loop>

    <Return value={$ctx.advance_check.valid} />
</Module>
