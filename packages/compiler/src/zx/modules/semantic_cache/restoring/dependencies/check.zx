import equal from "compiler/artifact_dependency_equal"

import read from "./read"

import type { Records } from "./model"

export type Input = Records

export type Output = bool

export default function (in: Input): Output {
    const { previous, current } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < previous.header.count,
        next: state => {
            const row = state.row

            state.valid = equal({
                previous: read({
                    columns: previous,
                    row
                }),
                current: read({
                    columns: current,
                    row
                })
            })
            state.row += 1
        },
        return: state => state.valid
    })
}
