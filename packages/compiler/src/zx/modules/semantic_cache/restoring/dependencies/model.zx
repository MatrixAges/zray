import type { ReadColumn, TextColumn } from "memory"
import type { Header } from "../../../module_record/model"

export type Dependency = {
    specifier: string,
    identity: string,
    names: string[],
    source_names: string[],
    kind: u8,
    exported: bool,
    wildcard: bool,
    target: u8,
    path: string,
    instance: string,
    member: string
}

export type Pair = {
    previous: Dependency,
    current: Dependency
}

export type Columns = {
    header: Header,
    names: ReadColumn,
    source_names: ReadColumn,
    kind: ReadColumn,
    exported: ReadColumn,
    wildcard: ReadColumn,
    path: TextColumn,
    instance: TextColumn,
    member: TextColumn
}

export type Records = {
    previous: Columns,
    current: Columns
}

export type Names = {
    previous: string[],
    current: string[]
}

export type Traversal = {
    source: Records,
    row: u64,
    valid: bool,
    running: bool
}
