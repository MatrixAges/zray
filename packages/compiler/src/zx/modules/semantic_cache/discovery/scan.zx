import integers from "std:integer"

import find from "./find"
import path from "./path"

import type { Input as Request } from "./model"

export type Input = Request.Omit("eligible") & {
    eligible: u64
}

export type Output = string[]

export default function (in: Input): Output {
    const { batch, eligible, standard, scoped, internal } = in
    const { paths, first, count } = batch

    const empty: string[] = []

    const native_keys = loop({
        row: 0,
        keys: empty,
        remaining: eligible
    }, {
        while: state => state.remaining != 0,
        next: state => {
            if (integers.andBits(state.remaining, 1) != 0) {
                const name = path({
                    paths,
                    row: first + state.row
                })
                const builtin = find({
                    registry: standard,
                    name
                })
                const key = match {
                    builtin != null => builtin,
                    scoped == null => null,
                    _ => find({
                        registry: scoped,
                        name
                    })
                }

                if (key != null) {
                    state.keys = state.keys.push(key)[0]
                }
            }

            state.remaining /= 2
            state.row += 1
        },
        return: state => state.keys
    })

    if (internal.length == 0) {
        return native_keys
    }

    return loop({
        row: 0,
        keys: native_keys
    }, {
        while: state => state.row < count,
        next: state => {
            const name = path({
                paths,
                row: first + state.row
            })

            const key = find({
                registry: internal,
                name
            })

            if (key != null) {
                state.keys = state.keys.push(key)[0]
            }

            state.row += 1
        },
        return: state => state.keys
    })
}
