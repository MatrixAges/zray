import integers from "std:integer"
import memory from "memory"

import find from "./find"
import path from "./path"

import type { Input as Request } from "./model"

export type Input = Request.Omit("eligible") & {
    eligible: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { batch, eligible, standard, scoped, internal, output } = in
    const { paths, first, count } = batch

    const native_count = loop({
        row: 0,
        count: 0,
        remaining: eligible
    }, {
        while: state => state.remaining != 0,
        next: state => {
            if (integers.andBits(state.remaining, 1) != 0) {
                const name = path({
                    paths,
                    row: first + state.row
                })
                const builtin = find({
                    registry: standard,
                    name
                })
                const key = match {
                    builtin != null => builtin,
                    scoped == null => null,
                    _ => find({
                        registry: scoped,
                        name
                    })
                }

                if (key != null) {
                    memory.writeString(output, state.count, key)
                    state.count += 1
                }
            }

            state.remaining /= 2
            state.row += 1
        },
        return: state => state.count
    })

    if (internal.length == 0) {
        return native_count
    }

    return loop({
        row: 0,
        count: native_count
    }, {
        while: state => state.row < count,
        next: state => {
            const name = path({
                paths,
                row: first + state.row
            })

            const key = find({
                registry: internal,
                name
            })

            if (key != null) {
                memory.writeString(output, state.count, key)
                state.count += 1
            }

            state.row += 1
        },
        return: state => state.count
    })
}
