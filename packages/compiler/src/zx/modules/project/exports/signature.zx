import memory from "memory"
import columns from "memory/columns"

import type { DefaultSignature, Signature } from "./model"

export type Input = {
    signature: Signature,
    row: u64
}

export type Output = DefaultSignature

export default function (in: Input): Output {
    const { signature, row } = in

    const kind = memory.readColumnU8(signature.kinds, row)

    if (kind == signature.callable) {
        return {
            input_type: columns.readColumnU32(signature.inputs, row),
            output_type: columns.readColumnU32(signature.outputs, row),
            has_store: memory.readColumnBool(signature.stores, row),
            invalid: false
        }
    }

    if (kind == signature.deferred) {
        return {
            deferred: memory.readTextColumn(signature.sources, row),
            has_store: false,
            invalid: false
        }
    }

    return {
        has_store: false,
        invalid: kind != signature.intrinsic
    }
}
