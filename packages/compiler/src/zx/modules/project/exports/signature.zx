import memory from "memory"

import { Action } from "./model"

import type { Signature } from "./model"

export type Input = {
    signature: Signature,
    row: u64
}

export type Output = Action

export default function (in: Input): Output {
    const signature = in.signature
    const kind = memory.readColumnU8(signature.kinds, in.row)

    return match {
        kind == signature.callable => Action.Callable,
        kind == signature.deferred => Action.Deferred,
        kind == signature.intrinsic => Action.Intrinsic,
        _ => Action.Invalid
    }
}
