<Module>
    <Type from="model" as="Members" />

    <Args in={Members.Input} out={u64} />

    <Store from="rows" as="rows" />

    <Call fn="allocate" in={$in} />

    <If on={$in.declared}>
        <Call
            fn="write"
            in={{
                ...$in.callable,
                name: "",
                kind: $in.kinds.callable,
                row: 0,
                own_name: false
            }}
        />

        <Call fn="commit" setter={[$store.rows.pending]} />
    </If>

    <If on={$in.forwarded.length != 0}>
        <Call
            fn="forward"
            in={{
                rows: $in.forwarded,
                row: $in.declared ? 1 : 0
            }}
        />

        <Call fn="commit" setter={[$store.rows.pending]} />
    </If>

    <Loop on={$in.index < $in.bindings.count}>
        <Call
            module="next_native"
            in={{
                kinds: $in.kinds,
                bindings: $in.bindings,
                start: $ctx.allocate - $in.bindings.count,
                index: 0
            }}
        />
    </Loop>

    <Return value={$ctx.allocate} />
</Module>
