<Module>
    <Type from="model" as="Members" />

    <Args in={Members.Input} out={u64} />

    <Call fn="allocate" in={$in} />

    <If on={$in.declared}>
        <Call
            fn="write"
            in={{
                ...$in.callable,
                target: $in.target,
                name: "",
                kind: $in.kinds.callable,
                row: 0
            }}
        />
    </If>

    <If on={$in.forwarded.length != 0}>
        <Call
            fn="forward"
            in={{
                target: $in.buffer,
                rows: $in.forwarded,
                offset: $in.declared ? $in.stride : 0
            }}
        />
    </If>

    <If on={$in.bindings.count != 0}>
        <Call
            fn="native"
            in={{
                target: $in.target,
                kinds: $in.kinds,
                bindings: $in.bindings,
                start: $ctx.allocate - $in.bindings.count
            }}
        />
    </If>

    <Return value={$ctx.allocate} />
</Module>
