<Module>
    <Type from="reexports" as="Signature" />

    <Args in={Signature.Input} out={Signature.Input} />

    <Store from="rows" as="rows" />

    <Call fn="reexports" in={$in} />

    <Call fn="commit" setter={[$store.rows.pending]} />

    <Return
        value={{
            ...$in,
            offset: $ctx.commit - $in.first
        }}
    />
</Module>
