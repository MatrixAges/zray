import { ChangeKind } from "./model"

import type { Change as Output, Forwarded as Input } from "./model"

export default function (in: Input): Output {
    return {
        ...in,
        action: ChangeKind.Forwarded,
        name: "",
        kind: 0,
        input_type: 0,
        output_type: 0,
        has_store: false,
        own_name: false,
        source_row: 0
    }
}
