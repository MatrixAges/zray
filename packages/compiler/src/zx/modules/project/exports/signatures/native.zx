import memory from "memory"

import fromBinding from "./from_binding"
import write from "./write"

import type { Bindings, Change, Kinds } from "./model"

export type Input = {
    kinds: Kinds,
    bindings: Bindings,
    start: u64,
    index: u64
}

export type Output = Change?

export default function (in: Input): Output {
    const { kinds, bindings, start, index } = in

    const signature = fromBinding({
        kinds,
        facts: bindings.facts,
        index
    })

    if (signature == null) {
        return null
    }

    return write({
        ...signature,
        name: memory.readTextColumn(bindings.names, index),
        row: start + index,
        own_name: false
    })
}
