import memory from "memory"

import fromBinding from "./from_binding"
import write from "./write"

import type { Bindings, Kinds, Target } from "./model"

export type Input = {
    target: Target,
    kinds: Kinds,
    bindings: Bindings,
    start: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { target, kinds, bindings, start } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < bindings.count,
        next: state => {
            const index = state.row
            const signature = fromBinding({
                kinds,
                facts: bindings.facts,
                index
            })

            state.valid = signature != null

            if (signature != null) {
                write({
                    ...signature,
                    target,
                    name: memory.readTextColumn(bindings.names, index),
                    row: start + index
                })
            }

            state.row += 1
        },
        return: state => state.valid
    })
}
