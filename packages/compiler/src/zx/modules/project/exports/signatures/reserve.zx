import { capacityFor } from "core/row_buffer"

import reservation from "./reservation"

import type { RowsTarget } from "./model"

export type Input = RowsTarget & {
    count: u64
}

export type Output = u64

export default function (in: Input, {
    $store
}): Output {
    const { capacity, used, count, base } = in

    const next = capacityFor({
        current: capacity,
        used,
        additional: count,
        base
    })

    if (next != capacity) {
        $store.rows.pending = reservation(next)
    }

    return used
}
