import { reserveAppend } from "core/row_buffer"

import type { ColumnAllocator } from "memory/columns"
import type { RowsTarget } from "./model"

export type Input = RowsTarget & {
    backing: ColumnAllocator,
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const first = in.used

    const capacity = reserveAppend([
        in.storage,
        first,
        in.count,
        in.backing
    ])

    return first
}
