import fromBinding from "./from_binding"
import { ChangeKind } from "./model"
import write from "./write"

import type { Change, Reexports } from "./model"

export type Input = Reexports & {
    offset: u64
}

export type Output = Change?

export default function (in: Input): Output {
    const { names, indices, rows, first, offset } = in
    const { signatures, stride, kinds, facts } = rows

    const index = indices[offset]
    const row = first + offset
    const name = names[offset]

    if (signatures.length != 0) {
        if (index >= signatures.length / stride) {
            return null
        }

        return {
            action: ChangeKind.Reexport,
            row,
            name,
            rows: signatures,
            source_row: index,
            kind: 0,
            input_type: 0,
            output_type: 0,
            has_store: false,
            own_name: true
        }
    }

    const signature = fromBinding({
        kinds,
        facts,
        index
    })

    if (signature == null) {
        return null
    }

    return write({
        ...signature,
        name,
        row,
        own_name: true
    })
}
