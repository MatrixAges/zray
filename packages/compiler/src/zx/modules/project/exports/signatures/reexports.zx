import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import fromBinding from "./from_binding"
import write from "./write"

import type { Reexports as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { names, indices, rows, first, owner } = in
    const { signatures, stride, buffer, target, kinds, facts } = rows

    const valid = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < names.length,
        next: state => {
            const row = state.row
            const index = indices[row]
            const destination = first + row

            if (signatures.length != 0) {
                const name = memory.copyColumnText(owner, names[row])
                const start = stride * index
                const copied = memory.copyBytes(
                    buffer,
                    stride * destination,
                    signatures,
                    start,
                    start + stride
                )

                memory.writeColumnBytes(
                    target.name,
                    destination,
                    bytes.fromText(name)
                )
            } else {
                const signature = fromBinding({
                    kinds,
                    facts,
                    index
                })

                state.valid = signature != null

                if (signature != null) {
                    write({
                        ...signature,
                        name: memory.copyColumnText(owner, names[row]),
                        target,
                        row: destination
                    })
                }
            }

            state.row += 1
        },
        return: state => state.valid
    })

    columns.requireColumnBounds(valid)
    memory.writeU64(rows.used, 0, first + names.length)
}
