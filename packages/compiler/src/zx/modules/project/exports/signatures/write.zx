import { ChangeKind } from "./model"

import type { Change as Output, Value } from "./model"

export type Input = Value & {
    name: string,
    row: u64,
    own_name: bool
}

export default function (in: Input): Output {
    return {
        ...in,
        action: ChangeKind.Value,
        source_row: 0
    }
}
