<Module>
    <Type from="model" as="Members" />

    <Args in={Members.ReexportDelivery} out={void} />

    <Call
        fn="reserve"
        in={{
            ...$in.rows.pick([
                "storage",
                "used",
                "backing"
            ]),
            count: $in.names.length
        }}
    />

    <Call
        fn="reexports"
        in={{
            ...$in,
            first: $ctx.reserve
        }}
    />
</Module>
