<Module>
    <Type from="model" as="Members" />

    <Args in={Members.ReexportDelivery} out={void} />

    <Call
        fn="../../../binding/delivery/allocation.selectAllocator"
        in={[
            $in.scope,
            $in.rows.backing
        ]}
    />

    <Call
        fn="reserve"
        in={{
            ...$in.rows.pick([
                "storage",
                "used"
            ]),
            count: $in.names.length
        }}
    />

    <Call
        fn="../../../binding/delivery/allocation.selectAllocator"
        in={[
            $in.scope,
            $in.owner
        ]}
    />

    <Call
        fn="reexports"
        in={{
            ...$in.omit([
                "scope",
                "owner"
            ]),
            first: $ctx.reserve
        }}
    />
</Module>
