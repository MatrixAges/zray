<Module>
    <Type from="model" as="Members" />

    <Args in={Members.ReexportDelivery} out={u64} />

    <Call
        fn="reserve"
        in={{
            ...$in.rows.pick([
                "storage",
                "used",
                "backing"
            ]),
            count: $in.names.length
        }}
    />

    <Loop on={$in.offset < $in.names.length}>
        <Call
            module="next_reexport"
            in={{
                ...$in,
                first: $ctx.reserve,
                offset: 0
            }}
        />
    </Loop>

    <Return value={$ctx.reserve + $in.names.length} />
</Module>
