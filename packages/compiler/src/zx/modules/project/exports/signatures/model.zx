import type { Stores } from "core/store_table/model"
import type { Allocator, ArenaScope, TextColumn, U8Buffer, WriteColumn } from "memory"
import type { Bindings as Selected } from "../../../binding/model"
import type { Members, RowsTarget } from "../../../binding/publication/model"

export type Target = {
    name: WriteColumn,
    kind: WriteColumn,
    input_type: WriteColumn,
    output_type: WriteColumn,
    source: WriteColumn,
    has_store: WriteColumn
}

export type Ports = {
    input_type: u32,
    output_type: u32
}

export type Declaration = Ports & {
    has_store: bool
}

export type Kinds = {
    callable: u8,
    intrinsic: u8
}

export type BindingFacts = {
    members: Members,
    stores: Stores[],
    void_type: u32
}

export type Value = Declaration & {
    kind: u8
}

export type Forwarded = {
    target: U8Buffer,
    rows: u8[],
    count: u64
}

export type Bindings = {
    names: TextColumn,
    facts: BindingFacts,
    count: u64
}

export type ReexportRows = RowsTarget & {
    target: Target,
    buffer: U8Buffer,
    signatures: u8[],
    stride: u64,
    facts: BindingFacts,
    kinds: Kinds,
    backing: Allocator
}

export type Reexports = Selected & {
    rows: ReexportRows,
    first: u64
}

export type ReexportDelivery = Selected & {
    rows: ReexportRows,
    scope: ArenaScope,
    owner: Allocator
}

export type Input = {
    target: Target,
    callable: Declaration?,
    kinds: Kinds,
    forwarded: Forwarded,
    bindings: Bindings
}
