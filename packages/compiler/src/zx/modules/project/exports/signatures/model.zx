import type { Stores } from "core/store_table/model"
import type { TextColumn } from "memory"
import type { Bindings as Selected } from "../../../binding/model"
import type { Members } from "../../../binding/publication/model"
import type { Ports, Signature } from "../model"

export type RowsTarget = {
    used: u64,
    capacity: u64,
    base: u64
}

export type Declaration = Ports & {
    has_store: bool
}

export type Kinds = {
    callable: u8,
    intrinsic: u8
}

export type BindingFacts = {
    members: Members,
    stores: Stores[],
    void_type: u32
}

export type Value = Declaration & {
    kind: u8
}

export type Forwarded = {
    row: u64
}

export type Bindings = {
    names: TextColumn,
    facts: BindingFacts,
    count: u64
}

export type ReexportRows = RowsTarget & {
    signatures: u64,
    facts: BindingFacts,
    kinds: Kinds
}

export type Reexports = Selected & {
    rows: ReexportRows,
    first: u64
}

export type ReexportDelivery = Selected & {
    rows: ReexportRows
}

export type Input = {
    callable: Declaration,
    declared: bool,
    kinds: Kinds,
    forwarded: u64,
    bindings: Bindings,
    names: TextColumn,
    signature: Signature
}

export enum ChangeKind {
    Reserve,
    Value,
    Forwarded,
    Reexport
}

export type Change = {
    action: ChangeKind,
    row: u64,
    name: string,
    kind: u8,
    input_type: u32,
    output_type: u32,
    has_store: bool,
    own_name: bool,
    source_row: u64
}
