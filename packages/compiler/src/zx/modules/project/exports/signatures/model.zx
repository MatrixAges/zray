import type { Stores } from "core/store_table/model"
import type { ReadColumn, TextColumn, U8Buffer, WriteColumn } from "memory"

export type Target = {
    name: WriteColumn,
    kind: WriteColumn,
    input_type: WriteColumn,
    output_type: WriteColumn,
    source: WriteColumn,
    has_store: WriteColumn
}

export type Ports = {
    input_type: u32,
    output_type: u32
}

export type Declaration = Ports & {
    has_store: bool
}

export type Kinds = {
    callable: u8,
    intrinsic: u8
}

export type Forwarded = {
    target: U8Buffer,
    rows: u8[],
    count: u64
}

export type Bindings = {
    names: TextColumn,
    ids: ReadColumn,
    inputs: ReadColumn,
    outputs: ReadColumn,
    intrinsics: ReadColumn,
    stores: Stores[],
    void_type: u32,
    count: u64
}

export type Input = {
    target: Target,
    callable: Declaration?,
    kinds: Kinds,
    forwarded: Forwarded,
    bindings: Bindings
}
