import type { Stores } from "core/store_table/model"
import type { Allocator, TextColumn, U8Buffer, WriteColumn } from "memory"
import type { ColumnAllocator, RowBuffer, RowGrowth } from "memory/columns"
import type { Bindings as Selected } from "../../../binding/model"
import type { Members, RowsTarget } from "../../../binding/publication/model"
import type { Ports, Signature } from "../model"

export type Target = {
    name: WriteColumn,
    kind: WriteColumn,
    input_type: WriteColumn,
    output_type: WriteColumn,
    source: WriteColumn,
    has_store: WriteColumn
}

export type Declaration = Ports & {
    has_store: bool
}

export type Kinds = {
    callable: u8,
    intrinsic: u8
}

export type BindingFacts = {
    members: Members,
    stores: Stores[],
    void_type: u32
}

export type Value = Declaration & {
    kind: u8
}

export type Forwarded = {
    target: U8Buffer,
    rows: u8[],
    offset: u64
}

export type Bindings = {
    names: TextColumn,
    facts: BindingFacts,
    count: u64
}

export type ReexportRows = RowsTarget & {
    target: Target,
    buffer: U8Buffer,
    signatures: u8[],
    stride: u64,
    facts: BindingFacts,
    kinds: Kinds,
    backing: ColumnAllocator
}

export type Reexports = Selected & {
    rows: ReexportRows,
    owner: Allocator,
    first: u64
}

export type ReexportDelivery = Selected & {
    rows: ReexportRows,
    owner: Allocator
}

export type Input = {
    target: Target,
    callable: Declaration,
    declared: bool,
    kinds: Kinds,
    forwarded: u8[],
    bindings: Bindings,
    storage: RowBuffer,
    buffer: U8Buffer,
    reads: RowGrowth,
    stride: u64,
    names: TextColumn,
    signature: Signature
}
