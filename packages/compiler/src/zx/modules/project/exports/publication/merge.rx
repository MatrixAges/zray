<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Request} out={u64} />

    <Store from="rows" as="rows" />

    <Call fn="merge_rows" in={$in.rows} />

    <If on={$ctx.merge_rows.merge}>
        <Call fn="stage_merge" in={$in.kind} setter={[$store.rows.merge]} />
    </If>

    <Return value={$ctx.merge_rows.count} />
</Module>
