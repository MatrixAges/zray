<Store name="project_export_rows" version={1}>
    <Type from="model" as="Publication" />

    <Object name="merge">
        <Field name="kind" type={Publication.Kind} value={Publication.Kind.Types} />
        <Field name="own" type={u8[]} value={[]} />
        <Field name="forwarded" type={u8[]} value={[]} />
    </Object>

    <Object name="index">
        <Field name="capacity" type={u64} value={0} />
    </Object>
</Store>
