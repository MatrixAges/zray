import type { ReadColumn, TextColumn, U64Buffer } from "memory"
import type { RowBuffer } from "memory/columns"
import type { Signature } from "../model"

export enum Kind {
    Types,
    Constants,
    Members
}

export type Request = {
    rows: Merge,
    kind: Kind
}

export type Merge = {
    own: u8[],
    forwarded: u8[],
    stride: u64,
    copy_own: bool,
    storage: RowBuffer,
    names: TextColumn
}

export type Exports = {
    types: Merge,
    constants: Merge
}

export type Merged = {
    exports: u8[],
    constant_exports: u8[]
}

export type Workspace = {
    buckets: U64Buffer
}

export type Index = {
    workspace: Workspace,
    exports: Exports,
    merged: Merged,
    members: TextColumn,
    member_count: u64,
    ids: ReadColumn,
    entry?: u32,
    signature?: Signature
}
