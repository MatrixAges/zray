import type { ReadColumn, TextColumn } from "memory"
import type { Signature } from "../model"

export enum Kind {
    Types,
    Constants,
    Members
}

export type Request = {
    rows: Merge,
    kind: Kind
}

export type Merge = {
    own: u64,
    forwarded: u64,
    copy_own: bool,
    names: TextColumn
}

export type Exports = {
    types: Merge,
    constants: Merge
}

export type Merged = {
    exports: u64,
    constant_exports: u64
}

export type Index = {
    exports: Exports,
    merged: Merged,
    members: TextColumn,
    member_count: u64,
    ids: ReadColumn,
    entry?: u32,
    signature?: Signature
}
