import type { Merge as Input } from "./model"

export type Output = {
    count: u64,
    merge: bool
}

export default function (in: Input): Output {
    const { own, forwarded, copy_own } = in

    return {
        count: own + forwarded,
        merge: own != 0 && (forwarded != 0 || copy_own)
    }
}
