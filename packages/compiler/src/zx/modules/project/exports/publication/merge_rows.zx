import type { Merge as Input } from "./model"

export type Output = {
    rows: u8[],
    merge: bool
}

export default function (in: Input): Output {
    const { own, forwarded } = in

    if (own.length == 0) {
        return {
            rows: forwarded,
            merge: false
        }
    }

    return {
        rows: own,
        merge: forwarded.length != 0 || in.copy_own
    }
}
