import bytes from "std:bytes"
import integers from "std:integer"
import readKey from "core/bytes/index/segments/key"

import type { Segments } from "core/bytes/index/segments/model"

export type Input = {
    keys: Segments,
    buckets: u64[],
    key: string
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { keys, buckets, key } = in

    const mask = buckets.length - 1

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(key)), mask),
        entry: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = buckets[state.slot]

            const matches = match entry {
                0 => true,
                _ => readKey({
                    keys,
                    row: entry - 1
                }) == key
            }

            if (matches) {
                state.entry = entry
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => state.omit(["done"])
    })
}
