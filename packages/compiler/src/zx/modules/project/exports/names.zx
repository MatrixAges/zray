import capacityFor from "core/bytes/index/fixed_capacity"
import readKey from "core/bytes/index/segments/key"

import probe from "./probe"

import type { Input, Names as Output } from "./model"

export default function (in: Input): Output {
    const invalid_name: u64? = null
    const duplicate: string? = null
    const default_member: u64? = null

    const { keys, roots } = in

    const capacity = capacityFor(keys.count)
    const empty: u64[] = []

    const buckets = loop(empty, {
        while: items => items.length < capacity,
        next: items => {
            items = items.push(0)[0]
        }
    })

    return loop({
        invalid_name,
        duplicate,
        default_member,
        buckets,
        cursor: 0
    }, {
        while: state => state.invalid_name == null && state.cursor < keys.count,
        next: state => {
            const row = state.cursor
            const key = readKey({
                keys,
                row
            })

            if (roots && key.length == 0) {
                state.invalid_name = row
                state.duplicate = key
            } else {
                const found = probe({
                    keys,
                    buckets: state.buckets,
                    key
                })

                if (found.entry != 0) {
                    state.invalid_name = row
                    state.duplicate = key
                } else {
                    state.buckets = state.buckets.with(found.slot, row + 1)

                    if (row >= keys.third_start && key.length == 0) {
                        state.default_member = row - keys.third_start
                    }
                }
            }

            state.cursor += 1
        },
        return: state => {
            return {
                invalid_name: state.invalid_name,
                duplicate: state.duplicate,
                default_member: state.default_member
            }
        }
    })
}
