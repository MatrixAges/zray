<Module>
    <Type from="model" as="Exports" />

    <Args in={Exports.Input} out={Exports.Output} />

    <Call fn="names" in={$in} />

    <If on={$ctx.names.invalid_name != null}>
        <Return
            value={{
                names: $ctx.names,
                action: Exports.Action.None
            }}
        />
    </If>

    <If on={$ctx.names.default_member != null}>
        <If on={$in.signature != null}>
            <Call
                fn="signature"
                in={{
                    signature: $in.signature,
                    row: $ctx.names.default_member
                }}
            />

            <Return
                value={{
                    names: $ctx.names,
                    action: $ctx.signature
                }}
            />
        </If>

        <If on={!$in.has_function}>
            <Return
                value={{
                    names: $ctx.names,
                    action: Exports.Action.Forward
                }}
            />
        </If>
    </If>

    <Return
        value={{
            names: $ctx.names,
            action: Exports.Action.None
        }}
    />
</Module>
