<Module>
    <Type from="model" as="Exports" />

    <Args in={Exports.Input} out={Exports.Output} />

    <Call fn="names" in={$in} />

    <If on={$ctx.names.invalid_name != null}>
        <Return
            value={{
                ...$ctx.names.omit(["default_member"]),
                has_store: false,
                invalid: false
            }}
        />
    </If>

    <If on={$ctx.names.default_member != null}>
        <If on={$in.signature != null}>
            <Call
                fn="signature"
                in={{
                    signature: $in.signature,
                    row: $ctx.names.default_member
                }}
            />

            <Return
                value={{
                    ...$ctx.signature
                }}
            />
        </If>
    </If>

    <If on={$in.signature == null}>
        <Call
            fn="entry"
            in={{
                own: $in.own,
                row: $ctx.names.default_member,
                ids: $in.ids
            }}
        />

        <Return
            value={{
                entry: $ctx.entry,
                has_store: false,
                invalid: false
            }}
        />
    </If>

    <Return
        value={{
            has_store: false,
            invalid: false
        }}
    />
</Module>
