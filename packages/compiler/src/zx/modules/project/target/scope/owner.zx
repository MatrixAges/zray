import bytes from "std:bytes"
import memory from "std:memory"

import contains from "./contains"

import type { Rows } from "../select"

export type Owner = {
    index?: u64,
    width: u64
}

export type Input = {
    roots: Rows,
    path: string,
    windows: bool
}

export type Output = Owner

export default function (in: Input): Output {
    const { roots, windows } = in

    const path = bytes.fromText(in.path)
    const index: u64? = null

    return loop({
        row: 0,
        index,
        width: 0
    }, {
        while: state => state.row < roots.length,
        next: state => {
            const root = memory.readTextColumn(roots.items, state.row)
            const preferred = state.index == null || root.length > state.width

            if (preferred && contains({
                path,
                root,
                windows
            })) {
                state.index = state.row
                state.width = root.length
            }

            state.row += 1
        },
        return: state => ({
            index: state.index,
            width: state.width
        })
    })
}
