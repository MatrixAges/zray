import type { Rows } from "../select"

export enum Source {
    Standard,
    Scoped
}

export type Match = {
    source: Source,
    index: u64
}

export type Lookup = {
    standard: Rows,
    scoped: Rows,
    name: string,
    check_duplicates: bool
}

export type Result = {
    selected?: Match,
    duplicate: bool
}
