import resolve from "../file"
import select from "./select"

import type { FileProbe, FileRequest, FileSelection } from "../model"

export type Input = FileRequest & FileProbe.Omit("path")

export type Output = FileSelection

export default function (in: Input): Output {
    const target = resolve(in.pick([
        "path",
        "basename",
        "extension",
        "allow_rx",
        "from",
        "root",
        "check_direction"
    ]))

    const path = target.path

    if (path == null) {
        return {
            path: "",
            issue: target.issue
        }
    }

    const capacity = target.fallback ? in.index.capacity : 0

    if (capacity == 0 && in.roots.length == 0) {
        return {
            path
        }
    }

    return select({
        ...in.pick([
            "release",
            "owner",
            "roots",
            "windows"
        ]),
        index: {
            ...in.index,
            capacity
        },
        path
    })
}
