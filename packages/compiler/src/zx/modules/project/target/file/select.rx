<Module>
    <Type from="../model" as="Target" />

    <Args in={Target.FileProbe} out={Target.FileSelection} />

    <Call
        module="../../../path/alias/select"
        in={$in.pick([
            "path",
            "index"
        ])}
    />

    <Call
        fn="../scope/check"
        in={{
            ...$in.omit([
                "index",
                "path"
            ]),
            path: $ctx.select.row != null ? ($ctx.select.fallback ?? $in.path) : $in.path
        }}
    />

    <Return
        value={{
            ...$ctx.select,
            boundary: $ctx.check
        }}
    />
</Module>
