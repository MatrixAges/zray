<Module>
    <Type from="../model" as="Target" />

    <Args in={Target.PackageRequest} out={Target.PackageTarget} />

    <Call fn="../package" in={$in.shape} />

    <If
        on={
        $ctx.package == Target.PackageShape.InvalidSource ||
            $ctx.package == Target.PackageShape.InvalidCompiled
        }
    >
        <Return
            value={{
                kind: $ctx.package
            }}
        />
    </If>

    <If on={$in.duplicate}>
        <Return
            value={{
                kind: Target.PackageShape.Duplicate
            }}
        />
    </If>

    <Call
        fn="path"
        in={{
            root: $in.root,
            path: $in.artifact ?? $in.shape.entry
        }}
    />

    <Return
        value={{
            kind: $ctx.package,
            path: $ctx.path
        }}
    />
</Module>
