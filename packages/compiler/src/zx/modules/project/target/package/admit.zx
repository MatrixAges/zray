import {
    duplicate_package,
    invalid_package_library,
    invalid_package_source,
    undeclared_package
} from "../const"
import direction from "../direction"
import { PackageShape } from "../model"
import classify from "../package"
import resolve from "./path"

import type { PackageRequest as Input, PackageTarget as Output } from "../model"

export default function (in: Input): Output {
    if (!in.present) {
        return {
            issue: undeclared_package,
            path: "",
            instance: "",
            export_name: ""
        }
    }

    const { entry, members } = in

    if (members == null) {
        const issue = direction({
            path: entry,
            allow_rx: in.allow_rx
        })

        if (issue != null) {
            return {
                issue,
                path: "",
                instance: "",
                export_name: ""
            }
        }
    }

    const kind = classify({
        entry,
        compiled: members != null,
        instance: members != null && members.instance.length != 0,
        artifact: members != null && members.artifact.length != 0,
        name: members != null && members.name.length != 0
    })

    if (kind == PackageShape.InvalidSource) {
        return {
            issue: invalid_package_source,
            path: "",
            instance: "",
            export_name: ""
        }
    }

    if (kind == PackageShape.InvalidCompiled) {
        return {
            issue: invalid_package_library,
            path: "",
            instance: "",
            export_name: ""
        }
    }

    if (in.duplicate) {
        return {
            issue: duplicate_package,
            path: "",
            instance: "",
            export_name: ""
        }
    }

    const target = match {
        members == null => entry,
        _ => members.artifact
    }

    const path = resolve({
        root: in.root,
        path: target
    })

    return {
        issue: null,
        path,
        instance: members == null ? "" : members.instance,
        export_name: members == null ? "" : members.name
    }
}
