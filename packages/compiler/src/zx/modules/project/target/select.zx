import memory from "memory"

import type { TextColumn } from "memory"

export type Rows = {
    items: TextColumn,
    length: u64
}

export type Input = {
    specifiers: Rows,
    name: string,
    check_duplicates: bool
}

export type Output = {
    first?: u64,
    duplicate: bool
}

export default function (in: Input): Output {
    const { specifiers, name } = in

    const first: u64? = null

    return loop({
        row: 0,
        first,
        duplicate: false
    }, {
        while: state => {
            const rows_left = state.row < specifiers.length
            const search = in.check_duplicates || state.first == null

            return !state.duplicate && rows_left && search
        },
        next: state => {
            if (memory.readTextColumn(specifiers.items, state.row) == name) {
                if (state.first == null) {
                    state.first = state.row
                } else {
                    state.duplicate = true
                }
            }

            state.row += 1
        },
        return: state => ({
            first: state.first,
            duplicate: state.duplicate
        })
    })
}
