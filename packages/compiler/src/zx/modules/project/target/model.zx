import type { Table } from "core/bytes/index/fixed"
import type { Output as Alias } from "../../path/alias/model"
import type { Boundary, Input as Scope } from "./scope/check"

export enum Route {
    File,
    Package,
    Intrinsic,
    Interface,
    Invalid
}

export enum PathBase {
    Relative,
    Root,
    Extension,
    Invalid
}

export type Path = {
    path: string,
    extension: bool,
    directory: bool
}

export type Base = {
    kind: PathBase,
    prefix: u64
}

export type File = {
    path: string,
    basename: string,
    extension: bool,
    allow_rx: bool
}

export type FileRequest = File & {
    from: string,
    root: string
}

export type FileTarget = {
    kind: PathBase,
    path?: string,
    fallback: bool
}

export type FileProbe = Scope & {
    index: Table
}

export type FileSelection = Alias & {
    boundary: Boundary
}

export enum PackageShape {
    Source,
    Compiled,
    InvalidSource,
    InvalidCompiled,
    Duplicate
}

export type Package = {
    entry: string,
    compiled: bool,
    instance: bool,
    artifact: bool,
    name: bool
}

export type PackageRequest = {
    shape: Package,
    duplicate: bool,
    root: string,
    artifact?: string
}

export type PackageTarget = {
    kind: PackageShape,
    path?: string
}
