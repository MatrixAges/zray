import type { Table } from "core/bytes/index/slot"
import type { Allocator } from "memory"
import type { Input as Scope } from "./scope/check"

export enum Route {
    File,
    Package,
    Intrinsic,
    Interface,
    Invalid
}

export enum PathBase {
    Relative,
    Root,
    Extension,
    Invalid
}

export type Path = {
    path: string,
    extension: bool,
    directory: bool
}

export type Base = {
    kind: PathBase,
    prefix: u64
}

export type File = {
    path: string,
    basename: string,
    extension: bool,
    allow_rx: bool
}

export type FileRequest = File & {
    from: string,
    root: string,
    check_direction: bool
}

export type FileTarget = {
    issue?: string,
    path?: string,
    fallback: bool
}

export type FileProbe = Scope & {
    index: Table,
    release: Allocator
}

export type FileSelection = {
    path: string,
    row?: u64,
    issue?: string
}

export enum PackageShape {
    Source,
    Compiled,
    InvalidSource,
    InvalidCompiled,
    Duplicate
}

export type Package = {
    entry: string,
    compiled: bool,
    instance: bool,
    artifact: bool,
    name: bool
}

export type CompiledPackage = {
    instance: string,
    artifact: string,
    name: string
}

export type PackageRequest = {
    present: bool,
    entry: string,
    members?: CompiledPackage,
    duplicate: bool,
    allow_rx: bool,
    root: string
}

export type PackageTarget = {
    issue?: string,
    path: string,
    instance: string,
    export_name: string
}
