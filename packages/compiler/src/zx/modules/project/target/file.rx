<Module>
    <Type from="model" as="Target" />

    <Args in={Target.FileRequest} out={Target.FileTarget} />

    <Call
        fn="stem"
        in={$in.omit([
            "from",
            "root"
        ])}
    />

    <Call
        fn="../../path/directory"
        in={{
            path: $ctx.stem.path,
            basename: $ctx.stem.basename
        }}
    />

    <Call
        fn="base"
        in={{
            path: $ctx.stem.path,
            directory: $ctx.directory,
            extension: $ctx.stem.extension
        }}
    />

    <If
        on={$ctx.base.kind == Target.PathBase.Extension ||
            $ctx.base.kind == Target.PathBase.Invalid}
    >
        <Return
            value={{
                kind: $ctx.base.kind,
                fallback: false
            }}
        />
    </If>

    <Call
        fn="file/resolve"
        in={{
            context: $in.pick([
                "from",
                "root"
            ]),
            stem: $ctx.stem,
            base: $ctx.base,
            directory: $ctx.directory
        }}
    />

    <Return value={$ctx.resolve} />
</Module>
