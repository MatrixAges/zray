import type { ReadColumn } from "memory"
import type { Lookup, Match } from "../target/interface/model"
import type { Rows } from "../target/select"

export enum Route {
    Native,
    Legacy,
    Duplicate,
    Conflict,
    InvalidLegacy,
    MissingLegacy
}

export type Import = {
    native: Lookup,
    external: Rows,
    function_import: bool,
    binding_count: u64
}

export type Selection = {
    route: Route,
    native?: Match,
    external?: u64
}

export type Legacy = {
    export_name?: string,
    local: string,
    duplicate: bool,
    count: u64,
    previous_default: bool
}

export type Binding = {
    valid: bool,
    default_export: bool,
    name: string,
    namespace?: string
}

export type External = {
    specifiers: Rows,
    exports: ReadColumn,
    first: u64,
    specifier: string,
    local: string
}
