export type ProjectWalk = opaque

export type ProjectBody = opaque

export type ProjectEntry = opaque

export type ProjectNative = opaque

export type NativeCacheLoad = opaque

export type CacheSlot = opaque

export type CacheReplacement = opaque

export type CompiledImport = opaque

export type ArtifactLink = opaque

export type AnalysisPublication = opaque

export type AnalysisEntry = opaque

export type SyntaxOrders = opaque

export enum LibraryResolution {
    Found,
    Missing,
    Conflict
}

export enum CacheWrite {
    Stored,
    MissingOrigin,
    Invalid
}

export declare function publishSyntaxOrder(output: SyntaxOrders, constant: u64?): void
    throws { OutOfMemory }

export declare function initializeAnalysisTypes(
    publication: AnalysisPublication,
    borrowed: bool
): void throws { OutOfMemory }

export declare function appendAnalysisTypes(publication: AnalysisPublication): void
    throws { OutOfMemory }

export declare function publishAnalysisExports(publication: AnalysisPublication): void
    throws { OutOfMemory }

export declare function publishAnalysisConstants(publication: AnalysisPublication): void
    throws { OutOfMemory }

export declare function registerAnalysisBody(entry: AnalysisEntry, split: bool): void
    throws { OutOfMemory }

export declare function ownAnalysisNatives(entry: AnalysisEntry): void
    throws { OutOfMemory }

export declare function validateAnalysisPrefix(entry: AnalysisEntry): bool
    throws { OutOfMemory }

export declare function rejectAnalysisInitializer(entry: AnalysisEntry, message: string): void

export declare function forwardAnalysisEntry(entry: AnalysisEntry, id: u32): void
    throws { OutOfMemory }

export declare function openProjectFrame(walk: ProjectWalk, row: u64): void
    throws { OutOfMemory, InvalidSource }

export declare function readProjectFrame(walk: ProjectWalk): u64

export declare function suspendedProjectImport(walk: ProjectWalk): u64

export declare function resumeProjectImport(
    walk: ProjectWalk,
    row: u64,
    child: u64
): void throws { OutOfMemory, InvalidSource }

export declare function visitProjectImport(walk: ProjectWalk, row: u64): u64?
    throws { OutOfMemory, InvalidSource }

export declare function finishProjectFrame(walk: ProjectWalk): void
    throws { OutOfMemory, InvalidSource }

export declare function closeProjectFrame(walk: ProjectWalk): u64

export declare function restoreProjectBody(body: ProjectBody): bool
    throws { OutOfMemory, InvalidSource }

export declare function recordProjectCacheUse(body: ProjectBody, restored: bool): void

export declare function analyzeProjectBody(body: ProjectBody): void
    throws { OutOfMemory, InvalidSource }

export declare function installProjectFunction(body: ProjectBody): u64?
    throws { OutOfMemory, InvalidSource }

export declare function checkProjectOwnership(body: ProjectBody, count: u64): void
    throws { OutOfMemory, InvalidSource }

export declare function publishProjectExports(body: ProjectBody): void
    throws { OutOfMemory, InvalidSource }

export declare function projectBodyCacheable(body: ProjectBody): bool

export declare function registerProjectArtifact(body: ProjectBody): void
    throws { OutOfMemory }

export declare function commitProjectModule(body: ProjectBody): void
    throws { OutOfMemory }

export declare function prepareProjectEntry(entry: ProjectEntry): u64
    throws { OutOfMemory }

export declare function validateProjectEntry(entry: ProjectEntry, prefix: u64): bool
    throws { OutOfMemory }

export declare function projectCacheRecord(entry: ProjectEntry, position: u64): u64

export declare function storeProjectRecord(
    entry: ProjectEntry,
    index: u64,
    root: bool
): CacheWrite throws { OutOfMemory }

export declare function recordMissingOrigin(entry: ProjectEntry): void

export declare function loadFreshProjectNative(frame: ProjectNative): void
    throws { OutOfMemory, InvalidSource }

export declare function loadCachedProjectNative(frame: ProjectNative): void
    throws { OutOfMemory, InvalidSource }

export declare function restoreNativeCacheHit(frame: NativeCacheLoad): bool
    throws { OutOfMemory }

export declare function acceptNativeCacheHit(frame: NativeCacheLoad): void

export declare function buildNativeCacheEntry(frame: NativeCacheLoad): void
    throws { OutOfMemory, InvalidSource }

export declare function validateNativeCacheEntry(frame: NativeCacheLoad): void
    throws { OutOfMemory, InvalidSource }

export declare function probeCacheSlot(slot: CacheSlot): CacheReplacement?

export declare function reserveCacheSlot(slot: CacheSlot): bool
    throws { OutOfMemory }

export declare function stageCacheSlot(slot: CacheSlot): void
    throws { OutOfMemory }

export declare function appendCacheSlot(slot: CacheSlot): void

export declare function replaceCacheSlot(slot: CacheSlot, existing: CacheReplacement): void

export declare function resolveCompiledImport(frame: CompiledImport): LibraryResolution
    throws { OutOfMemory }

export declare function reuseCompiledLibrary(frame: CompiledImport): bool

export declare function reserveCompiledImport(frame: CompiledImport): void
    throws { OutOfMemory }

export declare function bindCompiledImport(frame: CompiledImport): bool
    throws { OutOfMemory }

export declare function publishCompiledInitializers(frame: CompiledImport): void

export declare function rememberCompiledLibrary(frame: CompiledImport): void

export declare function selectCompiledMember(frame: CompiledImport): bool

export declare function orderArtifactLink(frame: ArtifactLink): void
    throws { OutOfMemory, InvalidModule, MissingModule, CyclicDependency }

export declare function registerArtifactTypes(frame: ArtifactLink): void
    throws { OutOfMemory, InvalidModule, MissingNominalOrigin, ConflictingNominalType }

export declare function openArtifactBinding(frame: ArtifactLink): u64
    throws { OutOfMemory }

export declare function artifactWindowCapacity(frame: ArtifactLink): u64

export declare function bindArtifactWindow(frame: ArtifactLink, first: u64, count: u64): void throws {
    OutOfMemory,
    InvalidAnalysis,
    InvalidModule,
    InvalidIr,
    MissingNominalOrigin,
    ConflictingInterface
}
