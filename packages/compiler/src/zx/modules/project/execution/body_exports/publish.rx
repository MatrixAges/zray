<Module>
    <Type from="model" as="Publication" />
    <Type from="../../exports/publication/model" as="Rows" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call module="../../exports/publication/merge_exports" in={$in.exports} />

    <Call
        module="../../exports/publication/merge"
        in={{
            rows: $in.members,
            kind: Rows.Kind.Members
        }}
    />

    <Call
        fn="prepare_validation"
        in={{
            source: $in,
            merged: $ctx.merge_exports,
            members: $ctx.merge
        }}
    />

    <If on={$ctx.prepare_validation != null}>
        <Call module="../../exports/plan" in={$ctx.prepare_validation} />

        <Return
            value={{
                entry: $ctx.plan.entry,
                duplicate: $ctx.plan.duplicate
            }}
        />
    </If>

    <Return
        value={{
            entry: $in.entry,
            duplicate: null
        }}
    />
</Module>
