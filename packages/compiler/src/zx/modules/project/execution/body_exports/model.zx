import type { ReadColumn } from "memory"
import type { Exports, Merge, Merged } from "../../exports/publication/model"

export type Input = {
    exports: Exports,
    members: Merge,
    ids: ReadColumn,
    entry?: u32
}

export type Validate = {
    source: Input,
    merged: Merged,
    members: u64
}

export type Output = {
    entry?: u32,
    duplicate?: string
}
