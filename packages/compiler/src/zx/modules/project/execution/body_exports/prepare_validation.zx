import prepareIndex from "../../exports/publication/prepare_index"

import type { Input as Plan } from "../../exports/model"
import type { Validate as Input } from "./model"

export type Output = Plan?

export default function (in: Input): Output {
    const { source, merged } = in
    const { types, constants } = source.exports
    const { members, ids, entry } = source

    const reexports = types.forwarded + constants.forwarded + members.forwarded

    if (reexports == 0) {
        return null
    }

    return prepareIndex({
        exports: source.exports,
        merged,
        members: members.names,
        member_count: in.members,
        ids,
        entry
    })
}
