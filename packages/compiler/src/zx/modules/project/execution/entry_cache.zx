import memory from "memory"
import host from "project_host"
import { CacheWrite } from "project_host"

import type { Entry } from "./model"

export type Input =
    Entry.Pick("entry", "records", "record_count", "uncacheable", "root")

export type Output = bool

export default function (in: Input): Output {
    const { entry, records, record_count, uncacheable, root } = in

    const position: u64 = 0

    return loop({
        position,
        status: CacheWrite.Stored
    }, {
        while: state => {
            const more = state.position < record_count
            const valid = state.status != CacheWrite.Invalid

            return more && valid
        },
        next: state => {
            const index = memory.readColumnIndex(records, state.position)
            const is_root = root != null && root == index
            const status = host.storeProjectRecord(entry, index, is_root)

            if (status == CacheWrite.MissingOrigin) {
                memory.advanceLengthSlot(uncacheable, 0, 1)
            }

            state.position += 1
            state.status = status
        },
        return: state => state.status != CacheWrite.Invalid
    })
}
