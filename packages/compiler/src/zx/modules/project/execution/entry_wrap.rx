<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.EntryForwarding} out={void} />

    <Store from="../../entry_body/publication/pending" as="publication" />

    <Call
        fn="entry_forward"
        in={{
            original: $in.publication.original,
            body: $in.body,
            native: $in.native,
            function_id: $in.function_id
        }}
    />

    <Call module="../../forward_entry/build" />

    <Call
        fn="../../entry_body/publication/stage"
        in={{
            forwarded: $ctx.build,
            recursive: $in.native ? null : $in.function_id
        }}
        setter={[$store.publication.state]}
    />
</Module>
