<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.EntryForwarding} out={void} />

    <Store from="entry_state" as="entry_state" />

    <Call
        fn="entry_forward"
        in={{
            original: $in.publication.original,
            body: $in.body,
            native: $in.native,
            function_id: $in.function_id
        }}
    />

    <Call module="../../forward_entry/build" />

    <Call fn="index.borrowForwardedBodyBytes" />

    <Call
        fn="index.writeForwardedBody"
        in={[
            $in.publication.program,
            $ctx.borrowForwardedBodyBytes
        ]}
    />

    <If on={!$in.native}>
        <Call
            fn="set_entry_recursive"
            in={$in.function_id}
            setter={[$store.entry_state.state]}
        />
    </If>
</Module>
