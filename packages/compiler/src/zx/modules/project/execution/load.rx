<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Load} out={Execution.LoadResult} />

    <If on={$in.frame != null}>
        <Call fn="../load/admit" in={$in.frame} />

        <Return
            value={{
                admission: $ctx.admit
            }}
        />
    </If>

    <If on={$in.walk != null}>
        <Call module="walk" in={$in.walk} />

        <Return
            value={{
                next: $ctx.walk
            }}
        />
    </If>

    <Return
        value={{
            next: null
        }}
    />
</Module>
