import host from "project_host"

import type { Body as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { body, cached } = in

    if (cached) {
        const restored = host.restoreProjectBody(body)

        host.recordProjectCacheUse(body, restored)

        if (restored) {
            return
        }
    }

    host.analyzeProjectBody(body)
}
