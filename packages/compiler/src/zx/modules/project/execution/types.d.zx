export type ProjectWalk = mutable_opaque

export type ProjectState = mutable_opaque

export type ProjectSignatures = mutable_opaque

export type ProjectBody = mutable_opaque

export type ProjectEntry = mutable_opaque

export type CompiledImport = mutable_opaque

export type CompiledUnitSize = {
    exports: u64,
    initializers: u64
}

export type ArtifactLink = mutable_opaque

export type ArtifactExtraction = mutable_opaque

export enum CacheWrite {
    Ready,
    MissingOrigin,
    Invalid
}

export type ProjectImport = mutable_opaque

export enum ProjectImportRoute {
    Native,
    Legacy,
    Intrinsic,
    Resolve,
    DuplicateBinding,
    InvalidSpecifier,
    DuplicateInterface,
    InterfaceConflict,
    InvalidLegacy,
    MissingLegacy
}

export enum ProjectSourceAction {
    Descend,
    Bind,
    DeferSignature,
    SkipSignature,
    RejectRx,
    Missing,
    Cycle,
    Depth
}

export type NativeCacheLoad = mutable_opaque

export type CacheInstall = {
    key: u8[],
    keys: u8[][],
    buckets: u64[]
}

export type CacheProbe = {
    bucket: u64,
    row: u64
}

export type SourceBody = opaque

export type ProjectSourceSelection = {
    action: ProjectSourceAction,
    row: u64
}

export type ProjectFrameHeader = {
    count: u64,
    suspended: u64
}

export type ArtifactBinding = {
    length: u64,
    capacity: u64
}
