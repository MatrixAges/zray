<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Entry} out={bool} />

    <Call
        module="entry_publish"
        in={$in.pick([
            "entry",
            "plan"
        ])}
    />

    <Call
        fn="index.validateProjectEntry"
        in={[
            $in.entry,
            $ctx.entry_publish < $in.verified ? $ctx.entry_publish : $in.verified
        ]}
    />

    <If on={!$ctx.validateProjectEntry}>
        <Return value={false} />
    </If>

    <Call
        fn="entry_cache"
        in={$in.omit([
            "verified",
            "plan"
        ])}
    />

    <Return value={$ctx.entry_cache} />
</Module>
