<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Entry} out={Execution.EntryResult} />

    <If on={$in.publication != null}>
        <Call module="entry_publish" in={$in.publication} />

        <Call
            fn="index.readLengthSlot"
            in={[
                $in.verified,
                0
            ]}
        />

        <If on={$ctx.entry_publish < $ctx.readLengthSlot}>
            <Call
                fn="index.shrinkLengthSlot"
                in={[
                    $in.verified,
                    0,
                    $ctx.entry_publish
                ]}
            />
        </If>
    </If>

    <If on={$in.cache != null}>
        <Call module="entry_cache/publish" in={$in.cache} />

        <Return
            value={{
                cache: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            cache: null
        }}
    />
</Module>
