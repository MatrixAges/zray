<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Entry} out={bool} />

    <Call module="entry_publish" in={$in.publication} />

    <Call
        fn="index.readLengthSlot"
        in={[
            $in.verified,
            0
        ]}
    />

    <If on={$ctx.entry_publish < $ctx.readLengthSlot}>
        <Call
            fn="index.shrinkLengthSlot"
            in={[
                $in.verified,
                0,
                $ctx.entry_publish
            ]}
        />
    </If>

    <Call fn="index.validateProjectEntry" in={$in.entry} />

    <If on={!$ctx.validateProjectEntry}>
        <Return value={false} />
    </If>

    <Call
        fn="entry_cache"
        in={$in.pick([
            "entry",
            "records",
            "record_count",
            "uncacheable",
            "root"
        ])}
    />

    <Return value={$ctx.entry_cache} />
</Module>
