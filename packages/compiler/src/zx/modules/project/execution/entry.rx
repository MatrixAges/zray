<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Entry} out={Execution.EntryResult} />

    <If on={$in.publication != null}>
        <Call module="entry_publish" in={$in.publication} />

        <Call
            fn="../../../../core/column_lengths/truncate"
            in={{
                count: $in.verified,
                limit: $ctx.entry_publish
            }}
        />

        <If on={$in.cache != null}>
            <Call module="entry_cache/publish" in={$in.cache} />

            <Return
                value={{
                    cache: $ctx.publish,
                    visible_count: $ctx.entry_publish,
                    verified_count: $ctx.truncate
                }}
            />
        </If>

        <Return
            value={{
                visible_count: $ctx.entry_publish,
                verified_count: $ctx.truncate
            }}
        />
    </If>

    <If on={$in.cache != null}>
        <Call module="entry_cache/publish" in={$in.cache} />

        <Return
            value={{
                cache: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            cache: null
        }}
    />
</Module>
