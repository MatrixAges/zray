import host from "project_host"

import complete from "../load/complete"
import imports from "./imports"

import type { Walk as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { walk, marks, row, depth } = in

    const completed: u64? = null

    host.openProjectFrame(walk, row)

    const finished = loop({
        row,
        depth: depth + 1,
        completed
    }, {
        while: state => state.depth > depth,
        next: state => {
            const child = imports({
                walk,
                completed: state.completed
            })

            if (child != null) {
                host.openProjectFrame(walk, child)
                state.row = child
                state.depth += 1
                state.completed = null
            } else {
                host.finishProjectFrame(walk)
                state.completed = complete({
                    marks,
                    row: state.row,
                    depth: state.depth
                })
                state.row = host.closeProjectFrame(walk)
                state.depth -= 1
            }
        },
        return: state => state.depth
    })
}
