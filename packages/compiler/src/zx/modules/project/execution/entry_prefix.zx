import host from "project_host"

import type { Entry } from "./model"

export type Input = Entry.Pick("entry", "verified")

export type Output = bool

export default function (in: Input): Output {
    const { entry, verified } = in

    const visible = host.prepareProjectEntry(entry)
    const prefix = visible < verified ? visible : verified

    return host.validateProjectEntry(entry, prefix)
}
