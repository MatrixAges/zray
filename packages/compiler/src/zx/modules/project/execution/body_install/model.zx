import type {
    ColumnAllocator,
    ColumnGrowth,
    ColumnRecord,
    ColumnRowLayout,
    ColumnSet,
    RowBuffer
} from "memory/columns"

export type Rows = {
    storage: RowBuffer,
    used: u64
}

export type Functions = {
    storage: ColumnSet,
    resource: ColumnAllocator,
    maximum_count: u64,
    growth: ColumnGrowth,
    body_layout: ColumnRowLayout,
    native_layout: ColumnRowLayout,
    empty_native: ColumnRecord
}

export type Installation = {
    functions: Functions,
    function: ColumnRecord,
    records: Rows,
    cache: Rows,
    resource: ColumnAllocator,
    backing: ColumnAllocator
}

export type Register = {
    index: u64,
    publish: bool
}
