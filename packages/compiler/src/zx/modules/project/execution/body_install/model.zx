import type { Capacity } from "core/row_buffer"
import type {
    ColumnAllocator,
    ColumnGrowth,
    ColumnRecord,
    ColumnRowLayout,
    ColumnSet
} from "memory/columns"

export type Functions = {
    storage: ColumnSet,
    resource: ColumnAllocator,
    maximum_count: u64,
    growth: ColumnGrowth,
    body_layout: ColumnRowLayout,
    native_layout: ColumnRowLayout,
    empty_native: ColumnRecord
}

export type Installation = {
    functions: Functions,
    function: ColumnRecord,
    records: Capacity,
    cache: Capacity
}

export type Register = {
    index: u64,
    publish: bool
}
