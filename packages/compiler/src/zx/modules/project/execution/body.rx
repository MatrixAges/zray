<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Body} out={Execution.BodyResult} />

    <If on={$in.cache != null}>
        <Call module="cache/restore" in={$in.cache} />

        <Call fn="../../semantic_cache/state/usage_slot" />

        <Call
            fn="index.advanceLengthSlot"
            in={[
                $in.cache.usage,
                $ctx.usage_slot,
                1
            ]}
        />

        <If on={!$ctx.restore}>
            <Call fn="index.analyzeProjectBody" in={$in.body} />
        </If>

        <Else>
            <Call fn="index.analyzeProjectBody" in={$in.body} />
        </Else>
    </If>

    <Call module="../publication/plan" in={$in.installation.request} />

    <If on={$ctx.plan.append}>
        <Call
            fn="../../../../core/column_set/reserve"
            in={{
                resource: $in.installation.functions.resource,
                storage: $in.installation.functions.storage,
                growth: $in.installation.functions.growth,
                count: 1,
                limit: $in.installation.functions.maximum_count
            }}
        />

        <Call fn="index.materializeProjectFunction" in={$in.body} />

        <Call
            fn="../../../../core/function_table/publication/publish_records"
            in={{
                storage: $in.installation.functions.storage,
                body: $in.installation.function,
                native: $in.installation.functions.empty_native,
                body_layout: $in.installation.functions.body_layout,
                native_layout: $in.installation.functions.native_layout
            }}
        />
    </If>

    <If on={$ctx.plan.ownership_count != null}>
        <Call
            fn="index.checkProjectOwnership"
            in={[
                $in.body,
                $ctx.plan.ownership_count,
                $ctx.plan.id
            ]}
        />
    </If>

    <Call
        fn="index.bindProjectBodyExports"
        in={[
            $in.body,
            $ctx.plan.id
        ]}
    />

    <Call module="body_exports/publish" in={$in.exports} />

    <If on={$ctx.publish.duplicate != null}>
        <Return
            value={{
                duplicate: $ctx.publish.duplicate
            }}
        />
    </If>

    <Call
        fn="body_install/register_cache"
        in={{
            index: $in.installation.records.used,
            publish: $ctx.plan.publish_artifact
        }}
    />

    <If on={$ctx.register_cache != null}>
        <Call
            fn="../../../../core/row_buffer/reserve_append"
            in={[
                $in.installation.cache.storage,
                $in.installation.cache.used,
                1,
                $in.installation.backing
            ]}
        />
    </If>

    <Call
        fn="../../../../core/row_buffer/reserve_append"
        in={[
            $in.installation.records.storage,
            $in.installation.records.used,
            1,
            $in.installation.resource
        ]}
    />

    <Return
        value={{
            record: {
                row: $in.installation.records.used,
                exports: $ctx.publish.exports,
                constants: $ctx.publish.constant_exports,
                members: $ctx.publish.members,
                entry: $ctx.publish.entry,
                publication: $ctx.plan.publication,
                function_id: $ctx.plan.id,
                recursive: $ctx.plan.own_function,
                retain_entry: $in.installation.request.entry
            },
            cache_root: $in.installation.request.entry ? $ctx.register_cache : null,
            cache_record: $ctx.register_cache
        }}
    />
</Module>
