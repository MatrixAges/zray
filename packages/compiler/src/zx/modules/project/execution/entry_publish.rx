<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.EntryPublication} out={u64} />

    <Store from="../../entry_body/publication/pending" as="publication" />

    <If on={$in.original.type_only && $in.original.own != null}>
        <Call
            fn="entry_selection"
            in={{
                file: $in.original.file,
                row: $in.original.own,
                functions: $in.functions
            }}
        />

        <Call
            fn="../../entry_body/publication/stage"
            in={{
                selected: $ctx.entry_selection.body
            }}
            setter={[$store.publication.state]}
        />

        <If on={$ctx.entry_selection.forward != null}>
            <Call
                module="entry_wrap"
                in={{
                    publication: $in,
                    body: $ctx.entry_selection.body,
                    native: $ctx.entry_selection.native,
                    function_id: $ctx.entry_selection.forward
                }}
            />
        </If>

        <Return value={$in.linked_count} />
    </If>

    <Call
        fn="../../forward_entry/recursive"
        in={{
            calls: $in.original.calls,
            candidate: $in.original.own
        }}
    />

    <If on={$ctx.recursive != null}>
        <Call
            module="entry_wrap"
            in={{
                publication: $in,
                body: null,
                native: false,
                function_id: $ctx.recursive
            }}
        />

        <Return value={$in.linked_count} />
    </If>

    <If on={!$in.original.type_only}>
        <Call
            fn="../../../../core/column_lengths/truncate"
            in={{
                target: $in.lengths,
                count: $in.linked_count - 1
            }}
        />

        <Return value={$in.linked_count - 1} />
    </If>

    <Return value={$in.linked_count} />
</Module>
