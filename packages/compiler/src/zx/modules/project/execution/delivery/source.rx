<Module>
    <Type from="model" as="Delivery" />
    <Type from="effect" as="Effect" />

    <Args in={Delivery.Binding} out={u64?} />

    <Store from="delivery" as="delivery" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.SelectSource
        }}
        setter={[$store.delivery.effect]}
    />

    <Call fn="read_source" in={$store.delivery.effect} />

    <Switch on={$ctx.read_source.action}>
        <Case value={Delivery.ProjectSourceAction.Descend}>
            <Return value={$ctx.read_source.row} />
        </Case>

        <Case value={Delivery.ProjectSourceAction.Bind}>
            <Call
                module="bind"
                in={{
                    ...$in,
                    target: {
                        kind: Delivery.ProjectImportKind.Source,
                        row: $ctx.read_source.row
                    }
                }}
            />
        </Case>

        <Case value={Delivery.ProjectSourceAction.DeferSignature}>
            <Call
                module="bind"
                in={{
                    ...$in,
                    target: {
                        kind: Delivery.ProjectImportKind.Deferred
                    }
                }}
            />
        </Case>

        <Case value={Delivery.ProjectSourceAction.SkipSignature}>
            <Return value={null} />
        </Case>

        <Default>
            <Call
                fn="stage"
                in={{
                    step: Effect.Step.RejectSource,
                    action: $ctx.read_source.action
                }}
                setter={[$store.delivery.effect]}
            />
        </Default>
    </Switch>

    <Return value={null} />
</Module>
