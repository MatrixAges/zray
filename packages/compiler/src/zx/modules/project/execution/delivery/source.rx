<Module>
    <Type from="model" as="Delivery" />
    <Type from="index" as="Host" />

    <Args in={Delivery.Binding} out={u64?} />

    <Call fn="index.selectProjectSource" in={$in.frame} />

    <Switch on={$ctx.selectProjectSource.action}>
        <Case value={Host.ProjectSourceAction.Descend}>
            <Return value={$ctx.selectProjectSource.row} />
        </Case>

        <Case value={Host.ProjectSourceAction.Bind}>
            <Call
                module="bind"
                in={{
                    ...$in,
                    target: {
                        kind: Host.ProjectImportKind.Source,
                        row: $ctx.selectProjectSource.row
                    }
                }}
            />
        </Case>

        <Case value={Host.ProjectSourceAction.DeferSignature}>
            <Call
                module="bind"
                in={{
                    ...$in,
                    target: {
                        kind: Host.ProjectImportKind.Deferred
                    }
                }}
            />
        </Case>

        <Case value={Host.ProjectSourceAction.SkipSignature}>
            <Return value={null} />
        </Case>

        <Default>
            <Call
                fn="index.rejectProjectSource"
                in={[
                    $in.frame,
                    $ctx.selectProjectSource.action
                ]}
            />
        </Default>
    </Switch>

    <Return value={null} />
</Module>
