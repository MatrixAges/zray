<Module>
    <Type from="model" as="Delivery" />
    <Type from="index" as="Host" />

    <Args in={Delivery.Binding} out={u64?} />

    <Call fn="index.resolveProjectImport" in={$in.frame} />

    <If on={$ctx.resolveProjectImport}>
        <Call module="source" in={$in} />

        <Return value={$ctx.source} />
    </If>

    <Call fn="index.loadProjectLibrary" in={$in.frame} />

    <Call
        module="bind"
        in={{
            ...$in,
            target: {
                kind: Host.ProjectImportKind.Compiled
            }
        }}
    />

    <Return value={null} />
</Module>
