<Module>
    <Type from="model" as="Delivery" />
    <Type from="effect" as="Effect" />

    <Args in={Delivery.Binding} out={u64?} />

    <Store from="delivery" as="delivery" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Resolve
        }}
        setter={[$store.delivery.effect]}
    />

    <Call fn="read_flag" in={$store.delivery.effect} />

    <If on={$ctx.read_flag}>
        <Call module="source" in={$in} />

        <Return value={$ctx.source} />
    </If>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.LoadLibrary
        }}
        setter={[$store.delivery.effect]}
    />

    <Call
        module="bind"
        in={{
            ...$in,
            target: {
                kind: Delivery.ProjectImportKind.Compiled
            }
        }}
    />

    <Return value={null} />
</Module>
