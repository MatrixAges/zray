<Module>
    <Type from="model" as="Delivery" />
    <Type from="effect" as="Effect" />

    <Args in={Delivery.Input} out={u64?} />

    <Store from="delivery" as="delivery" />

    <If on={$in.completed != null}>
        <Call
            module="bind"
            in={{
                ...$in.omit(["completed"]),
                target: {
                    kind: Delivery.ProjectImportKind.Source,
                    row: $in.completed
                }
            }}
        />

        <Return value={null} />
    </If>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Route
        }}
        setter={[$store.delivery.effect]}
    />

    <Call fn="read_route" in={$store.delivery.effect} />

    <If on={$ctx.read_route == Delivery.ProjectImportRoute.Resolve}>
        <Call module="target" in={$in.omit(["completed"])} />

        <Return value={$ctx.target} />
    </If>

    <Switch on={$ctx.read_route}>
        <Case value={Delivery.ProjectImportRoute.Native}>
            <Call module="native" in={$in.omit(["completed"])} />
        </Case>

        <Case value={Delivery.ProjectImportRoute.Legacy}>
            <Call
                fn="stage"
                in={{
                    step: Effect.Step.BindLegacy
                }}
                setter={[$store.delivery.effect]}
            />

            <If on={!$in.signature}>
                <Call
                    fn="stage"
                    in={{
                        step: Effect.Step.Record,
                        target: {
                            kind: Delivery.ProjectImportKind.External
                        }
                    }}
                    setter={[$store.delivery.effect]}
                />
            </If>
        </Case>

        <Case value={Delivery.ProjectImportRoute.Intrinsic}>
            <Call
                module="bind"
                in={{
                    ...$in.omit(["completed"]),
                    target: {
                        kind: Delivery.ProjectImportKind.Intrinsic
                    }
                }}
            />
        </Case>

        <Default>
            <Call fn="diagnostic" in={$ctx.read_route} />

            <Call
                fn="stage"
                in={{
                    step: Effect.Step.RejectRoute,
                    route: $ctx.read_route,
                    message: $ctx.diagnostic
                }}
                setter={[$store.delivery.effect]}
            />

            <Return value={null} />
        </Default>
    </Switch>

    <Return value={null} />
</Module>
