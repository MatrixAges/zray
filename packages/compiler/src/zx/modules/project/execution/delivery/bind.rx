<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Binding} out={void} />

    <Call
        fn="index.bindProjectImport"
        in={[
            $in.frame,
            $in.signature,
            $in.exported
        ]}
    />

    <If on={!$in.signature}>
        <Call fn="index.recordProjectImport" in={$in.frame} />
    </If>
</Module>
