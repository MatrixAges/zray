<Module>
    <Type from="model" as="Delivery" />
    <Type from="effect" as="Effect" />

    <Args in={Delivery.ResolvedBinding} out={void} />

    <Store from="delivery" as="delivery" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Bind,
            target: $in.target,
            signature: $in.signature &&
                $in.target.kind != Delivery.ProjectImportKind.Native &&
                $in.target.kind != Delivery.ProjectImportKind.Intrinsic,
            exported: $in.exported
        }}
        setter={[$store.delivery.effect]}
    />

    <If on={!$in.signature}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.Record,
                target: $in.target
            }}
            setter={[$store.delivery.effect]}
        />
    </If>
</Module>
