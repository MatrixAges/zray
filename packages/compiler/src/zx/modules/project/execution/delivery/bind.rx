<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Binding} out={void} />

    <Call
        fn="index.selectProjectBindings"
        in={[
            $in.frame,
            $in.signature
        ]}
    />

    <Call
        fn="index.publishProjectBindings"
        in={[
            $in.frame,
            $in.exported,
            !$in.signature
        ]}
    />

    <If on={$in.signature && $in.exported}>
        <Call fn="index.publishProjectReexports" in={$in.frame} />
    </If>

    <If on={!$in.signature}>
        <Call fn="index.recordProjectImport" in={$in.frame} />
    </If>
</Module>
