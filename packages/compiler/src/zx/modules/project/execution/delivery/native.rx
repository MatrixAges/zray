<Module>
    <Type from="model" as="Delivery" />
    <Type from="effect" as="Effect" />

    <Args in={Delivery.Binding} out={void} />

    <Store from="delivery" as="delivery" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ReuseNative
        }}
        setter={[$store.delivery.effect]}
    />

    <Call fn="read_flag" in={$store.delivery.effect} />

    <If on={!$ctx.read_flag}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.RegisterNative
            }}
            setter={[$store.delivery.effect]}
        />

        <Call fn="native_row" in={$store.delivery.effect} />

        <Call
            fn="stage"
            in={{
                step: Effect.Step.LoadNative,
                native_row: $ctx.native_row
            }}
            setter={[$store.delivery.effect]}
        />

        <Call
            fn="stage"
            in={{
                step: Effect.Step.RememberNative,
                native_row: $ctx.native_row
            }}
            setter={[$store.delivery.effect]}
        />
    </If>

    <Call
        module="bind"
        in={{
            ...$in,
            target: {
                kind: Delivery.ProjectImportKind.Native
            }
        }}
    />
</Module>
