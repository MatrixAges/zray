<Module>
    <Type from="../model" as="Execution" />

    <Args in={Execution.EntryCache} out={Execution.CacheStep} />

    <If on={$in.slot != null}>
        <Call module="../../../semantic_cache/slot/install" in={$in.slot} />

        <Return
            value={{
                placement: $ctx.install
            }}
        />
    </If>

    <If on={$in.missing_origin}>
        <Call
            fn="index.advanceLengthSlot"
            in={[
                $in.uncacheable,
                0,
                1
            ]}
        />
    </If>

    <If on={$in.position < $in.record_count}>
        <Call
            fn="index.readColumnIndex"
            in={[
                $in.records,
                $in.position
            ]}
        />

        <Call
            fn="digest"
            in={{
                row: $ctx.readColumnIndex,
                cache: $in
            }}
        />

        <Return
            value={{
                row: $ctx.readColumnIndex,
                digest: $ctx.digest
            }}
        />
    </If>

    <Return
        value={{
            row: null
        }}
    />
</Module>
