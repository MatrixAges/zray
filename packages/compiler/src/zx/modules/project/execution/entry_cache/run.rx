<Module>
    <Type from="../model" as="Execution" />

    <Args in={Execution.EntryCache} out={bool} />

    <Loop on={$in.position < $in.request.record_count && $in.valid}>
        <Call
            module="publish"
            in={{
                request: $in,
                position: 0,
                valid: true
            }}
        />
    </Loop>

    <Return value={$ctx.publish.valid} />
</Module>
