import type { ColumnLengths, ReadColumn, U8Buffer } from "memory"
import type { ProjectBody, ProjectEntry, ProjectWalk } from "project_host"
import type { Frame } from "../load/model"
import type { Entry as Publication } from "../publication/model"
import type { Input as BodyExports } from "./body_exports/model"
import type { Installation } from "./body_install/model"

export type Load = {
    walk: ProjectWalk,
    frame: Frame
}

export type Walk = {
    walk: ProjectWalk,
    marks: U8Buffer,
    row: u64,
    depth: u64
}

export type Imports = {
    walk: ProjectWalk,
    completed?: u64
}

export type Body = {
    body: ProjectBody,
    cached: bool,
    exports: BodyExports,
    installation: Installation
}

export type Entry = {
    entry: ProjectEntry,
    plan: Publication,
    verified: ColumnLengths,
    records: ReadColumn,
    record_count: u64,
    uncacheable: ColumnLengths,
    root?: u64
}

export type EntryPublication = Entry.Pick("entry", "plan")
