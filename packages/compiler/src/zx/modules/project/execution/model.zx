import type { U8Buffer } from "memory"
import type { ProjectBody, ProjectEntry, ProjectWalk } from "project_host"
import type { Frame } from "../load/model"

export type Load = {
    walk: ProjectWalk,
    frame: Frame
}

export type Walk = {
    walk: ProjectWalk,
    marks: U8Buffer,
    row: u64,
    depth: u64
}

export type Imports = {
    walk: ProjectWalk,
    completed?: u64
}

export type Body = {
    body: ProjectBody,
    cached: bool
}

export type Entry = {
    entry: ProjectEntry,
    verified: u64,
    records: u64,
    root?: u64
}
