import type { Symbols } from "core/symbol_table/model"
import type { ColumnLengths, ReadColumn, U8Buffer } from "memory"
import type { FunctionBodyRow } from "memory/columns"
import type { ProgramEntry, ProjectBody, ProjectEntry, ProjectWalk } from "project_host"
import type { FunctionColumns } from "../../entry_body/model"
import type { Frame } from "../load/model"
import type { Input as BodyExports } from "./body_exports/model"
import type { Installation } from "./body_install/model"
import type { Request as BodyCache } from "./cache/model"

export type Load = {
    walk: ProjectWalk,
    frame: Frame
}

export type Walk = {
    walk: ProjectWalk,
    marks: U8Buffer,
    row: u64,
    depth: u64
}

export type Imports = {
    walk: ProjectWalk,
    completed?: u64
}

export type Body = {
    body: ProjectBody,
    cache?: BodyCache,
    exports: BodyExports,
    installation: Installation
}

export type BodyResult = {
    duplicate?: string,
    cache_root?: u64,
    records_used?: u64,
    cache_used?: u64
}

export type Entry = {
    entry: ProjectEntry,
    publication: EntryPublication,
    verified: ColumnLengths,
    cache: EntryCache
}

export type EntryCache = {
    entry: ProjectEntry,
    records: ReadColumn,
    record_count: u64,
    uncacheable: ColumnLengths,
    root?: u64,
    root_digest: u8[],
    dependency_digest: u8[]
}

export type CacheTraversal = {
    request: EntryCache,
    position: u64,
    valid: bool
}

export type EntryPublication = {
    program: ProgramEntry,
    functions: LinkedFunctions,
    lengths: ColumnLengths,
    linked_count: u64,
    original: EntryBody
}

export type LinkedFunctions = FunctionColumns & {
    native_modules: u32?[]
}

export type EntryBody = {
    file: string,
    type_only: bool,
    own?: u32,
    input_type: u32,
    output_type: u32,
    symbols: Symbols,
    calls: u32[]
}

export type EntryForwarding = {
    publication: EntryPublication,
    body?: FunctionBodyRow,
    native: bool,
    function_id: u32
}
