import type { Symbols } from "core/symbol_table/model"
import type { ColumnLengths, ReadColumn } from "memory"
import type { FunctionBodyRow } from "memory/columns"
import type { CacheInstall } from "project_host"
import type { FunctionColumns } from "../../entry_body/model"
import type { Output as CacheSlot } from "../../semantic_cache/slot/commit"
import type { Admission, Frame } from "../load/model"
import type { Publication, Request } from "../publication/model"
import type { Input as BodyExports } from "./body_exports/model"
import type { Installation } from "./body_install/model"
import type { Request as BodyCache } from "./cache/model"

export type Load = {
    frame?: Frame,
    walk?: Walk
}

export type Walk = {
    row: u64,
    depth: u64,
    count: u64,
    suspended: u64,
    first: u64,
    completed?: u64,
    child?: u64
}

export enum WalkAction {
    Resume,
    Visit,
    Push,
    Close
}

export type Next = {
    action: WalkAction,
    row?: u64,
    first: u64
}

export type LoadResult = {
    admission?: Admission,
    next?: Next
}

export type Body = {
    cache?: BodyCache,
    options: BodyOptions,
    exports: BodyExports,
    installation: Installation
}

export type BodyOptions = Request.Pick("entry", "declared", "check_ownership", "cache")

export type BodyResult = {
    duplicate?: string,
    cache_root?: u64,
    record?: RecordedBody,
    cache_record?: u64
}

export type RecordedBody = {
    row: u64,
    exports: u8[],
    constants: u8[],
    members: u8[],
    entry?: u32,
    publication: Publication,
    function_id?: u32,
    recursive?: u32,
    retain_entry: bool
}

export type Entry = {
    publication?: EntryPublication,
    verified: u64,
    cache?: EntryCache
}

export type EntryResult = {
    cache?: CacheStep,
    visible_count?: u64,
    verified_count?: u64
}

export type EntryCache = {
    records: ReadColumn,
    record_count: u64,
    uncacheable: ColumnLengths,
    position: u64,
    missing_origin: bool,
    slot?: CacheInstall,
    root?: u64,
    root_digest: u8[],
    dependency_digest: u8[]
}

export type CacheStep = {
    row?: u64,
    digest?: u8[],
    placement?: CacheSlot
}

export type EntryPublication = {
    functions: LinkedFunctions,
    linked_count: u64,
    original: EntryBody
}

export type LinkedFunctions = FunctionColumns & {
    native_modules: u32?[]
}

export type EntryBody = {
    file: string,
    type_only: bool,
    own?: u32,
    input_type: u32,
    output_type: u32,
    symbols: Symbols,
    calls: u32[]
}

export type EntryForwarding = {
    publication: EntryPublication,
    body?: FunctionBodyRow,
    native: bool,
    function_id: u32
}
