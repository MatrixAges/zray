import bytes from "std:bytes"
import claim from "core/bytes/index/claim"
import memory from "memory"

import bind from "../../interface/legacy"

import type { Index } from "core/bytes/index/model"
import type { External } from "../../interface/model"

export type Input = External

export type Binding = {
    row: u64,
    name: string,
    namespace?: string
}

export type Output = {
    bindings: Binding[],
    valid: bool
}

export default function (in: Input): Output {
    const namespace: string? = null
    const bindings: Binding[] = []

    const keys: Index = {
        keys: [],
        values: [],
        buckets: []
    }

    const { specifiers, exports, specifier, local } = in

    return loop({
        index: in.first,
        keys,
        bindings,
        namespace,
        previous_default: false,
        valid: true
    }, {
        while: state => state.valid && state.index < specifiers.length,
        next: state => {
            const row = state.index

            if (memory.readTextColumn(specifiers.items, row) == specifier) {
                const export_name = memory.readOptionalTextColumn(exports, row)
                const claimed = claim({
                    index: state.keys,
                    key: bytes.fromText(export_name ?? ""),
                    value: 0
                })

                const binding = bind({
                    export_name,
                    local,
                    duplicate: claimed.previous != null,
                    count: state.bindings.length,
                    previous_default: state.previous_default
                })

                state.valid = binding.valid

                if (binding.valid) {
                    const label = binding.namespace

                    if (state.namespace == null && label != null) {
                        state.namespace = label
                    }

                    state.bindings = state.bindings.push({
                        row,
                        name: binding.name,
                        namespace: state.namespace
                    })[0]

                    state.keys = claimed.index
                    state.previous_default = binding.default_export
                }
            }

            state.index += 1
        },
        return: state => ({
            bindings: state.bindings,
            valid: state.valid
        })
    })
}
