<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Walk} out={Execution.Next} />

    <If on={$in.child != null}>
        <Return
            value={{
                action: Execution.WalkAction.Push,
                row: $in.child,
                first: $in.first
            }}
        />
    </If>

    <If on={$in.completed != null}>
        <Return
            value={{
                action: Execution.WalkAction.Resume,
                row: $in.suspended,
                first: $in.suspended + 1
            }}
        />
    </If>

    <If on={$in.first < $in.count}>
        <Return
            value={{
                action: Execution.WalkAction.Visit,
                row: $in.first,
                first: $in.first + 1
            }}
        />
    </If>

    <Call
        fn="../load/complete"
        in={$in.pick([
            "row",
            "depth"
        ])}
    />

    <Return
        value={{
            action: Execution.WalkAction.Close,
            row: $ctx.complete,
            first: $in.first
        }}
    />
</Module>
