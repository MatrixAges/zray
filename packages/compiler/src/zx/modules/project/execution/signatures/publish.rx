<Module>
    <Type from="model" as="Signatures" />

    <Args in={Signatures.Publication} out={Signatures.Output} />

    <Call module="../../exports/signatures/publish" in={$in.members} />
    <Call module="../../exports/publication/merge_exports" in={$in.exports} />

    <Call
        fn="prepare_validation"
        in={{
            publication: $in,
            merged: $ctx.merge_exports,
            member_count: $ctx.publish
        }}
    />

    <If on={$ctx.prepare_validation != null}>
        <Call module="../../exports/plan" in={$ctx.prepare_validation} />

        <Call
            fn="apply_entry"
            in={{
                declared: $in.members.declared,
                own: $in.members.callable,
                selection: $ctx.plan
            }}
        />

        <Return
            value={{
                ...$ctx.merge_exports,
                signature: $ctx.apply_entry
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.merge_exports,
            signature: {
                ...$in.members.callable,
                type_only: !$in.members.declared,
                invalid: false
            }
        }}
    />
</Module>
