import type { ReadColumn } from "memory"
import type { ProjectSignatures } from "project_host"
import type { Output as Selection } from "../../exports/model"
import type { Exports, Merged, Workspace } from "../../exports/publication/model"
import type { Declaration, Input as Members } from "../../exports/signatures/model"

export type Batch = {
    batch: ProjectSignatures,
    entries: u64,
    units: u64,
    rows?: u64[],
    paths: string[]
}

export type Validation = {
    workspace: Workspace,
    no_ids: ReadColumn
}

export type Publication = {
    members: Members,
    exports: Exports,
    validation: Validation
}

export type Validate = {
    publication: Publication,
    merged: Merged,
    member_count: u64
}

export type Entry = {
    declared: bool,
    own: Declaration,
    selection: Selection
}

export type Effective = Declaration & {
    type_only: bool,
    deferred?: string,
    duplicate?: string,
    invalid: bool
}

export type Output = Merged & {
    signature: Effective
}
