import bytes from "std:bytes"
import probe from "core/bytes/index/slot"
import memory from "memory"

import type { Batch as Input, Rows } from "./model"

export type Output = Rows

export default function (in: Input): Output {
    const { rows, paths, units, index } = in

    if (rows != null) {
        const end = loop(0, {
            while: row => row < in.entries && rows[row] < units,
            next: row => {
                row += 1
            }
        })

        return {
            items: memory.borrowU64Range(rows, 0, end),
            complete: end == in.entries
        }
    }

    const items: u64[] = []

    return loop({
        items,
        complete: true
    }, {
        while: state => state.complete && state.items.length < in.entries,
        next: state => {
            const entry = match {
                index.capacity == 0 => 0,
                _ => probe({
                    ...index,
                    key: bytes.fromText(paths[state.items.length])
                }).entry
            }

            if (entry == 0 || entry - 1 >= units) {
                state.complete = false
            } else {
                state.items = state.items.push(entry - 1)[0]
            }
        }
    })
}
