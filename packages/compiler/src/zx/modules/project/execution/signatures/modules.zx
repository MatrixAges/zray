import bytes from "std:bytes"
import probe from "core/bytes/index/slot"
import host from "project_host"

import type { Batch as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        request: in,
        slot: 0,
        valid: true
    }, {
        while: state => state.valid && state.slot < state.request.entries,
        next: state => {
            const { batch, rows, paths, units, index } = state.request
            const slot = state.slot

            const entry = match {
                rows != null || index.capacity == 0 => 0,
                _ => probe({
                    ...index,
                    key: bytes.fromText(paths[slot])
                }).entry
            }

            const row: u64? = match {
                rows != null => rows[slot],
                entry != 0 => entry - 1,
                _ => null
            }

            if (row == null || row >= units) {
                state.valid = false
            } else {
                host.loadProjectSignature(batch, row)
                host.writeProjectSignature(batch, slot, row)
                state.slot += 1
            }
        },
        return: state => state.valid
    })
}
