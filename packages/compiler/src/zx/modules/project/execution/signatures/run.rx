<Module>
    <Type from="model" as="Signatures" />

    <Args in={Signatures.Batch} out={bool} />

    <Call
        fn="index.reserveProjectSignatures"
        in={[
            $in.batch,
            $in.entries
        ]}
    />

    <Call fn="modules" in={$in} />

    <If on={!$ctx.modules}>
        <Return value={false} />
    </If>

    <Call fn="index.reserveProjectLibraries" in={$in.batch} />

    <Call
        fn="libraries"
        in={{
            batch: $in.batch,
            count: $ctx.reserveProjectLibraries
        }}
    />

    <Call fn="index.finishProjectSignatures" in={$in.batch} />

    <Return value={true} />
</Module>
