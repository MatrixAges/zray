import prepareIndex from "../../exports/publication/prepare_index"

import type { Input as Plan } from "../../exports/model"
import type { Validate as Input } from "./model"

export type Output = Plan?

export default function (in: Input): Output {
    const { publication, merged, member_count } = in
    const { types, constants } = publication.exports
    const { members, no_ids } = publication

    const own = members.declared ? 1 : 0

    if (
        types.forwarded + constants.forwarded == 0 &&
            member_count == own
    ) {
        return null
    }

    return prepareIndex({
        exports: publication.exports,
        merged,
        members: members.names,
        member_count,
        ids: no_ids,
        signature: members.signature
    })
}
