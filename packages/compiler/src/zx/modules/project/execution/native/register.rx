<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Registration} out={Native.Registered} />

    <Call
        module="../../target/interface/register"
        in={{
            modules: $in.modules,
            identity: $in.names.identity ?? $in.names.specifier,
            name: $in.names.import_name
        }}
    />

    <If on={$ctx.register.valid && !$ctx.register.existing && $ctx.register.id != null}>
        <Call fn="invalidate" in={{}} />

        <Return
            value={{
                ...$ctx.register,
                append: $in.names,
                verified: $ctx.invalidate
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.register,
            append: null,
            verified: null
        }}
    />
</Module>
