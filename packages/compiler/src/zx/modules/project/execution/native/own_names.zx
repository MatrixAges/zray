import strings from "std:string"

import type { Names } from "./model"

export type Input = Names

export type Output = Names

export default function (in: Input): Output {
    const { specifier, identity, import_name } = in

    return {
        specifier: strings.copy(specifier),
        identity: identity == null ? null : strings.copy(identity),
        import_name: strings.copy(import_name)
    }
}
