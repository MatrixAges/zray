<Module>
    <Type from="model" as="Native" />

    <Args in={Native.Import} out={void} />

    <If on={$in.cached}>
        <Call fn="publication.loadCachedProjectNative" in={$in.frame} />

        <Else>
            <Call fn="publication.loadFreshProjectNative" in={$in.frame} />
        </Else>
    </If>
</Module>
