import type { Modules } from "core/native_module_table/model"
import type { ColumnLengths, U8Buffer } from "memory"
import type { ProjectNative, ProjectNativeRegistry } from "project_host"

export type Verification = {
    functions: ColumnLengths,
    native: U8Buffer
}

export type Import = {
    frame: ProjectNative,
    cached: bool,
    verified: Verification
}

export type Names = {
    specifier: string,
    identity?: string,
    import_name: string
}

export type Registration = {
    registry: ProjectNativeRegistry,
    modules: Modules,
    names: Names,
    verified: Verification
}
