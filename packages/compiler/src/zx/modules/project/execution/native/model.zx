import type { Modules } from "core/native_module_table/model"
import type { ProjectNative, ProjectNativeRegistry } from "project_host"
import type { Output as Slot } from "../../target/interface/registry_slot"

export type Verification = {
    functions: u64,
    native: bool
}

export type Import = {
    frame: ProjectNative,
    cached: bool
}

export type Names = {
    specifier: string,
    identity?: string,
    import_name: string
}

export type Registration = {
    registry: ProjectNativeRegistry,
    modules: Modules,
    names: Names
}

export type Registered = Slot & {
    verified?: Verification
}
