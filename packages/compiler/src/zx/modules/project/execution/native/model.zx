import type { Modules } from "core/native_module_table/model"
import type { Output as Slot } from "../../target/interface/registry_slot"

export type Verification = {
    functions: u64,
    native: bool
}

export type Import = {
    cached: bool
}

export enum Loader {
    Fresh,
    Cached
}

export type Load = {
    loader: Loader,
    verified: Verification
}

export type Names = {
    specifier: string,
    identity?: string,
    import_name: string
}

export type Registration = {
    modules: Modules,
    names: Names
}

export type Registered = Slot & {
    append?: Names,
    verified?: Verification
}
