export type Project = opaque
export type Header = opaque

export declare function open(project: Project, row: u64): void throws {
    InvalidSource,
    OutOfMemory
}

export declare function snapshot(project: Project, target: Header): void

export declare function resumeImport(
    project: Project,
    row: u64,
    child: u64,
    signature: bool
): void throws { InvalidSource, OutOfMemory }

export declare function visit(
    project: Project,
    row: u64,
    signature: bool
): u64? throws { InvalidSource, OutOfMemory }

export declare function publishSignature(project: Project): void throws {
    InvalidSource,
    OutOfMemory
}

export declare function publishBody(project: Project): void throws {
    InvalidSource,
    OutOfMemory
}

export declare function close(project: Project): bool
