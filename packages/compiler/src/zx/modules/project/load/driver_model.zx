export enum Event {
    Enter,
    Advance
}

export enum Action {
    Resume,
    Visit,
    Open,
    PublishSignature,
    PublishBody
}

export type Cursor = {
    event: Event,
    row: u64,
    count: u64,
    child?: u64,
    signature: bool
}

export type Command = {
    action: Action,
    row: u64
}
