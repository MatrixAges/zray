import memory from "memory"
import frame from "project_frame"

import {
    frame_row_slot,
    frame_import_count_slot,
    frame_suspended_slot,
    frame_depth_slot
} from "./const"

import type { Step } from "./driver_model"

export type Input = Step.Pick("project", "header", "header_target", "completed")

export type Output = {
    row: u64,
    count: u64,
    suspended: u64,
    first: u64,
    depth: u64
}

export default function (in: Input): Output {
    const { project, header } = in

    frame.snapshot(project, in.header_target)

    const suspended = memory.readU64(header, frame_suspended_slot)
    const first = in.completed == null ? 0 : suspended + 1

    return {
        row: memory.readU64(header, frame_row_slot),
        count: memory.readU64(header, frame_import_count_slot),
        depth: memory.readU64(header, frame_depth_slot),
        suspended,
        first
    }
}
