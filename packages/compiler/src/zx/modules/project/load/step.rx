<Module>
    <Type from="driver_model" as="Frame" />

    <Args in={Frame.Cursor} out={Frame.Command} />

    <If on={$in.child != null}>
        <If on={$in.event == Frame.Event.Enter}>
            <Return
                value={{
                    action: Frame.Action.Resume,
                    row: $in.row
                }}
            />
        </If>

        <Return
            value={{
                action: Frame.Action.Open,
                row: $in.child
            }}
        />
    </If>

    <Call fn="scan" in={$in} />

    <Return value={$ctx.scan} />
</Module>
