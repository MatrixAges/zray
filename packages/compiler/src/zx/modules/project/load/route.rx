<Module>
    <Type from="model" as="Load" />
    <Type from="../target/model" as="Target" />

    <Args in={Load.Import} out={Load.ImportRoute} />

    <If on={$in.claim != null}>
        <Call fn="imports/claim" in={$in.claim} />

        <If on={$ctx.claim != null}>
            <Return
                value={{
                    route: Target.Route.Invalid,
                    duplicate: $ctx.claim,
                    exported: false,
                    record: false
                }}
            />
        </If>
    </If>

    <Call module="target" in={$in.target} />

    <Return
        value={{
            ...$ctx.target,
            next: $in.row + 1 < $in.count ? $in.row + 1 : null,
            exported: $in.exported,
            record: !$in.signature
        }}
    />
</Module>
