<Module>
    <Type from="model" as="Load" />
    <Type from="../target/model" as="Target" />

    <Args in={Load.Import} out={Load.ImportRoute} />

    <Call module="../target/classify" in={$in.omit(["internal"])} />

    <If on={$ctx.classify == Target.Route.Package && $in.internal.length != 0}>
        <Call
            fn="../target/select"
            in={{
                specifiers: $in.internal,
                name: $in.path,
                check_duplicates: false
            }}
        />

        <Return
            value={{
                route: $ctx.classify,
                internal: $ctx.select.first
            }}
        />
    </If>

    <Return
        value={{
            route: $ctx.classify
        }}
    />
</Module>
