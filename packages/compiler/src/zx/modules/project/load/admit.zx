import { done, max_dependency_depth, visiting } from "./const"
import { Admission } from "./model"

import type { Frame } from "./model"

export type Input = Frame

export type Output = Admission

export default function (in: Input): Output {
    const { states, row, depth } = in

    return match states[row] {
        done => Admission.Skip,
        visiting => Admission.Cycle,
        _ => depth < max_dependency_depth ? Admission.Push : Admission.Depth
    }
}
