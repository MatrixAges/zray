import bytes from "std:bytes"
import probe from "core/bytes/index/slot"

import type { Source } from "./model"

export type Input = Source

export type Output = u64?

export default function (in: Input): Output {
    const known = in.row

    if (known != null) {
        return known < in.states.length ? known : null
    }

    if (in.capacity == 0) {
        return null
    }

    const found = probe({
        keys: in.keys,
        buckets: in.buckets,
        capacity: in.capacity,
        key: bytes.fromText(in.path)
    })

    if (found.entry == 0) {
        return null
    }

    const row = found.entry - 1

    return row < in.states.length ? row : null
}
