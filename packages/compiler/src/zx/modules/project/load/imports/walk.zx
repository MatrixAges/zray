import { max_u64 } from "core/const"
import memory from "memory"
import frame from "project_frame"

import { completed_slot, import_slot } from "../const"

import type { U64Buffer } from "memory"
import type { Project } from "project_frame"

export type Input = {
    project: Project,
    cursor: U64Buffer,
    first: u64,
    count: u64,
    signature: bool
}

export type Output = u64?

export default function (in: Input): Output {
    memory.writeU64(in.cursor, import_slot, in.first)
    memory.writeU64(in.cursor, completed_slot, max_u64)

    return loop(in, {
        while: state => memory.readU64(state.cursor, import_slot) < state.count,
        next: state => {
            const { cursor, project, signature } = state
            const row = memory.readU64(cursor, import_slot)
            const child = frame.visit(project, row, signature)

            if (child != null) {
                memory.writeU64(cursor, completed_slot, child)
                memory.writeU64(cursor, import_slot, state.count)
            } else {
                memory.writeU64(cursor, import_slot, row + 1)
            }
        },
        return: state => {
            const child = memory.readU64(state.cursor, completed_slot)

            return child == max_u64 ? null : child
        }
    })
}
