import step from "compiler/project_load_frame"
import { max_u64 } from "core/const"
import memory from "memory"
import frame from "project_frame"

import { active, inactive, active_slot, completed_slot, frame_row_slot } from "./const"

import type { Walk } from "./driver_model"

export type Input = Walk

export type Output = void

export default function (in: Input): Output {
    frame.open(in.project, in.row)
    memory.writeU64(in.cursor, active_slot, active)
    memory.writeU64(in.cursor, completed_slot, max_u64)

    loop(in, {
        while: state => memory.readU64(state.cursor, active_slot) == active,
        next: state => {
            const { project, cursor, header, signature, marks } = state
            const previous = memory.readU64(cursor, completed_slot)
            const completed: u64? = previous == max_u64 ? null : previous
            const child = step({
                project,
                completed,
                signature,
                marks,
                header,
                header_target: state.header_target,
                import_cursor: cursor
            })

            if (child != null) {
                frame.open(project, child)
                memory.writeU64(cursor, completed_slot, max_u64)
            } else {
                const row = memory.readU64(header, frame_row_slot)
                const parent = frame.close(project)

                memory.writeU64(cursor, active_slot, parent ? active : inactive)
                memory.writeU64(cursor, completed_slot, row)
            }
        }
    })
}
