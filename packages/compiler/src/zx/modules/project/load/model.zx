import type { U8Buffer, U64Buffer } from "std:memory"

export enum Admission {
    Push,
    Skip,
    Cycle,
    Depth
}

export type Frame = {
    states: u8[],
    marks: U8Buffer,
    row: u64,
    depth: u64
}

export type Completed = {
    marks: U8Buffer,
    row: u64,
    depth: u64
}

export enum SourceAction {
    Descend,
    Bind,
    DeferSignature,
    SkipSignature,
    RejectRx,
    Missing,
    Cycle,
    Depth
}

export type Source = {
    path: string,
    signature: bool,
    function_import: bool,
    exported: bool,
    depth: u64,
    row?: u64,
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64,
    states: u8[],
    marks: U8Buffer
}

export type SourcePlan = {
    action: SourceAction,
    index?: u64
}
