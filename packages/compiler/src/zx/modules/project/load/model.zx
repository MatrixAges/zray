import type { U64View } from "memory"
import type { Import as Interface, Selection } from "../interface/model"
import type { Route } from "../target/model"
import type { Rows } from "../target/select"
import type { Request as Claim } from "./imports/claim"

export enum Admission {
    Push,
    Skip,
    Cycle,
    Depth
}

export type Frame = {
    states: u8[],
    row: u64,
    depth: u64
}

export type Completed = {
    row: u64,
    depth: u64
}

export enum SourceAction {
    Descend,
    Bind,
    DeferSignature,
    SkipSignature,
    RejectRx,
    Missing,
    Cycle,
    Depth
}

export type Source = {
    path: string,
    signature: bool,
    function_import: bool,
    exported: bool,
    depth: u64,
    row?: u64,
    import_row: u64,
    keys: u8[][],
    buckets: U64View,
    capacity: u64,
    states: u8[]
}

export type SourcePlan = {
    action: SourceAction,
    index?: u64,
    cursor?: u64
}

export type Target = {
    path: string,
    intrinsic: string,
    internal: Rows,
    interfaces: Interface
}

export type TargetRoute = {
    route: Route,
    internal?: u64,
    interface?: Selection
}

export type Import = {
    target: Target,
    claim?: Claim
}

export type ImportRoute = TargetRoute & {
    slots: u64[],
    duplicate?: u64
}
