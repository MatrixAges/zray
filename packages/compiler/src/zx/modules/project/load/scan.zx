import { Action, Event } from "./driver_model"

import type { Command, Cursor } from "./driver_model"

export type Input = Cursor

export type Output = Command

export default function (in: Input): Output {
    const row = in.event == Event.Enter ? 0 : in.row + 1

    const action = match {
        row < in.count => Action.Visit,
        in.signature => Action.PublishSignature,
        _ => Action.PublishBody
    }

    return {
        action,
        row
    }
}
