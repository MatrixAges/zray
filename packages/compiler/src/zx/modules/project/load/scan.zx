import { Publication } from "./model"

import type { FrameScan, Scan } from "./model"

export type Input = Scan

export type Output = FrameScan

export default function (in: Input): Output {
    const { count, suspended, signature } = in

    const first: u64 = match {
        suspended != null => suspended + 1,
        _ => 0
    }

    return {
        first: first < count ? first : null,
        previous: suspended,
        publication: signature ? Publication.Signature : Publication.Body
    }
}
