<Module>
    <Type from="model" as="State" />

    <Args in={State.Open} out={State.Admission} />

    <Call module="check" in={$in.omit(["state"])} />

    <If on={$ctx.check != State.Admission.Ready}>
        <Return value={$ctx.check} />
    </If>

    <Call fn="index.copyProjectTypes" in={$in.state} />
    <Call fn="index.copyProjectNatives" in={$in.state} />
    <Call fn="index.copyProjectOrigins" in={$in.state} />

    <Return value={State.Admission.Ready} />
</Module>
