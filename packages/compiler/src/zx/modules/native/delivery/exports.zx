import strings from "std:string"
import memory from "memory"

import type { Exports as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const written = loop(0, {
        while: row => row < in.source.length,
        next: row => {
            const item = in.source[row]
            const name = strings.copy(item.name)

            memory.writeNamedRow(in.target, row, name, item.type_id)

            row += 1
        }
    })
}
