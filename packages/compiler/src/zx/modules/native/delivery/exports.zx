import strings from "std:string"

import type { Export } from "../interface/exports"

export type Row = {
    name: string,
    type_id: u32
}

export type Output = {
    rows: Row[],
    names: string[],
    ids: u32[]
}

export type Input = {
    source: Export[]
}

export default function (in: Input): Output {
    const { source } = in

    const count = source.length
    const empty_rows: Row[] = []
    const empty_names: string[] = []
    const empty_ids: u32[] = []

    return loop({
        row: 0,
        rows: empty_rows,
        names: empty_names,
        ids: empty_ids
    }, {
        while: state => state.row < count,
        next: state => {
            const item = source[state.row]
            const name = strings.copy(item.name)

            state.rows = state.rows.push({
                name,
                type_id: item.type_id
            })[0]
            state.names = state.names.push(name)[0]
            state.ids = state.ids.push(item.type_id)[0]
            state.row += 1
        },
        return: state => ({
            rows: state.rows,
            names: state.names,
            ids: state.ids
        })
    })
}
