import type { Table as Types } from "core/type_table/model"
import type { Bindings as Origins } from "core/type_table/nominal"
import type { NamedRowBuffer } from "memory"
import type {
    Target as Publication
} from "../../../analysis/semantic/merging/publication/model"
import type { Export } from "../interface/exports"
import type { Member } from "../interface/members"
import type { Bindings, Table } from "../publication/finalize_model"
import type { Owner, Staging } from "../publication/model"
import type { Output as Diagnostic } from "../validation/model"

export type Exports = Bindings & {
    source: Export[],
    target: NamedRowBuffer
}

export type LoadInput = {
    base: Types,
    origins: Origins,
    source: u8[],
    namespace_bytes: u8[][],
    owner_key: string
}

export type LoadOutput = {
    delta: Types,
    diagnostic: Diagnostic,
    exports: Export[],
    members: Member[],
    origins: Origins
}

export type Input = {
    delta: Types,
    origins: Origins,
    exports: Export[],
    members: Member[],
    owner: Owner,
    types: Publication,
    export_target: NamedRowBuffer,
    bindings: Bindings,
    member_targets: Staging,
    native: Table
}
