<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Input} out={void} />

    <Call
        fn="../../../analysis/semantic/merging/publication/size"
        in={{
            delta: $in.delta,
            origins: $in.origins,
            destination: $in.types.destination
        }}
    />

    <Call
        module="../../../analysis/semantic/merging/publication/write"
        in={{
            ...$in.types,
            delta: $in.delta,
            origins: $in.origins
        }}
    />

    <Call
        fn="exports"
        in={{
            ...$in.bindings,
            source: $in.exports,
            target: $in.export_target
        }}
    />

    <Call
        module="members"
        in={{
            ...$in.member_targets,
            rows: {
                fresh: $in.members,
                cached: null,
                count: $in.members.length
            },
            owner: $in.owner
        }}
    />

    <Call
        fn="../publication/namespace"
        in={{
            published: $ctx.members,
            original: $in.owner.namespace
        }}
    />

    <Call
        fn="../publication/install"
        in={{
            destination: {
                ...$in.native,
                member_count: $in.members.length
            },
            namespace: $ctx.namespace,
            exports: $in.bindings
        }}
    />
</Module>
