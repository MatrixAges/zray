<Module>
    <Type from="model" as="Delivery" />

    <Args in={Delivery.Input} out={Delivery.Output} />

    <Call
        fn="../../../analysis/semantic/merging/publication/size"
        in={{
            delta: $in.delta,
            origins: $in.origins,
            destination: $in.types.destination
        }}
    />

    <Call
        module="../../../analysis/semantic/merging/publication/stage"
        in={{
            ...$in.types,
            delta: $in.delta,
            origins: $in.origins
        }}
    />

    <Call
        fn="exports"
        in={{
            source: $in.exports
        }}
    />

    <Call
        module="members"
        in={{
            ...$in.member_targets,
            rows: {
                fresh: $in.members,
                cached: null,
                count: $in.members.length
            },
            owner: $in.owner
        }}
    />

    <Call
        fn="../publication/namespace"
        in={{
            published: $ctx.members.namespace,
            original: $in.owner.namespace
        }}
    />

    <Return
        value={{
            ...$ctx.exports,
            namespace: $ctx.namespace,
            functions: $ctx.members.functions,
            members: $ctx.members.members
        }}
    />
</Module>
