<Module>
    <Type from="finalize_model" as="Native" />

    <Args in={Native.Input} out={bool} />

    <Call fn="namespace" in={$in.namespace} />
    <Call fn="bindings" in={$in.exports} />

    <If on={$ctx.bindings}>
        <Call
            fn="install"
            in={{
                destination: $in.destination,
                namespace: $ctx.namespace
            }}
        />

        <Return value={true} />
    </If>

    <Return value={false} />
</Module>
