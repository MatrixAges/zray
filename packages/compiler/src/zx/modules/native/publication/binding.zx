import integers from "std:integer"

export type Input = {
    row: u64,
    first: u64,
    name: string,
    input: u32,
    output: u32
}

export type Output = {
    name: string,
    id: u32,
    input_type: u32,
    output_type: u32
}

export default function (in: Input): Output {
    const { row, first, name, input, output } = in

    return {
        name,
        id: integers.narrow(first + row),
        input_type: input,
        output_type: output
    }
}
