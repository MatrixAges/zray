import { reserve } from "core/column_set"
import { allocateRows } from "core/row_buffer"
import memory from "memory/columns"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { resource, storage, shape, maximum_count } = in.destination
    const { count } = in.rows

    allocateRows({
        target: in.member_storage,
        count
    })

    reserve({
        resource,
        storage,
        growth: memory.functionColumnGrowth(shape, null),
        count,
        limit: maximum_count
    })
}
