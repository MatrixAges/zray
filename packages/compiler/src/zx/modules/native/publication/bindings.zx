import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import exports from "../delivery/exports"

import type { Rows } from "../../../ir/canonical/validation/names/model"
import type { Output as Bindings } from "../delivery/exports"
import type { Export } from "../interface/exports"

export type Input = {
    source: Rows,
    types: u32[]
}

export type Output = Bindings & {
    valid: bool
}

export default function (in: Input): Output {
    const { source, types } = in

    if (source.length > integers.widen(max_u32)) {
        return {
            valid: false,
            rows: [],
            names: [],
            ids: []
        }
    }

    const empty: Export[] = []

    const rows = loop(empty, {
        while: values => values.length < source.length,
        next: values => {
            const row = values.length
            const id = memory.readRowId(source.rows, row)

            values = values.push({
                name: memory.readRowName(source.rows, row),
                type_id: types[integers.widen(id)]
            })[0]
        }
    })

    const owned = exports({
        source: rows
    })

    return {
        ...owned,
        valid: true
    }
}
