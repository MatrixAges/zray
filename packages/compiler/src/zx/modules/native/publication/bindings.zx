import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { Exports } from "./finalize_model"

export type Input = Exports

export type Output = bool

export default function (in: Input): Output {
    const { source, names, ids } = in

    const count = source.length

    if (count > integers.widen(max_u32)) {
        return false
    }

    memory.allocateStringViews(names, count)
    memory.allocateU32Views(ids, count)

    return loop(0, {
        while: row => row < count,
        next: row => {
            memory.writeString(
                names,
                row,
                memory.readRowName(source.rows, row)
            )
            memory.writeU32(
                ids,
                row,
                memory.readRowId(source.rows, row)
            )
            row += 1
        },
        return: row => true
    })
}
