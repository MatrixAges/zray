import { StoreMode } from "core/function_table/complete"

import write from "../../artifact/materializing/publication/write"
import bind from "./binding"
import own from "./record"
import read from "./row"

import type { Columns } from "../../artifact/materializing/publication/model"
import type { Input } from "./model"

export type Output = Columns

export default function (in: Input): Output {
    const { rows, owner, empty, members, first } = in

    return loop({
        row: 0,
        functions: in.functions
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const row = state.row
            const source = read({
                rows,
                row
            })
            const record = own({
                source,
                owner
            })

            state.functions = write({
                columns: state.functions,
                function: {
                    ...record.signature,
                    symbols: empty.symbols,
                    expressions: empty.expressions,
                    contracts: empty.contracts,
                    control: empty.control,
                    store_table: empty.stores
                },
                attributes: {
                    ...record.flags,
                    store_mode: StoreMode.transaction,
                    root: null
                },
                row
            })

            bind({
                target: members,
                row,
                first,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.row += 1
        },
        return: state => state.functions
    })
}
