import complete from "../../link/signature/publication/function_row"
import signature from "../../link/signature/publication/signature_row"
import bind from "./binding"
import own from "./record"
import read from "./row"

import type { FunctionRow } from "memory/columns"
import type { Output as Binding } from "./binding"
import type { Batch as Output, Input } from "./model"

export default function (in: Input): Output {
    const { rows, owner, empty, first } = in

    const functions: FunctionRow[] = []
    const members: Binding[] = []

    return loop({
        row: 0,
        functions,
        members
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const row = state.row
            const source = read({
                rows,
                row
            })
            const record = own({
                source,
                owner
            })
            const fields = signature(record.pick([
                "signature",
                "flags"
            ]))
            const value = complete({
                signature: fields,
                empty
            })

            const member = bind({
                row,
                first,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.functions = state.functions.push(value)[0]
            state.members = state.members.push(member)[0]
            state.row += 1
        },
        return: state => ({
            functions: state.functions,
            members: state.members
        })
    })
}
