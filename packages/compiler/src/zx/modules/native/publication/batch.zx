import memory from "memory/columns"

import complete from "../../link/signature/publication/function_row"
import signature from "../../link/signature/publication/signature_row"
import bind from "./binding"
import own from "./record"
import read from "./row"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { rows, owner, empty, members, first, destination } = in

    const written = loop({
        row: 0
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const row = state.row
            const source = read({
                rows,
                row
            })
            const record = own({
                source,
                owner
            })
            const fields = signature(record.pick([
                "signature",
                "flags"
            ]))
            const value = complete({
                signature: fields,
                empty
            })

            memory.writeFunctionTail(destination.storage, value, row)

            bind({
                target: members,
                row,
                first,
                name: record.name,
                input: source.input,
                output: source.output
            })

            state.row += 1
        }
    })
}
