import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import write from "../../artifact/materializing/publication/write"
import own from "./record"
import read from "./row"

import type { Columns } from "../../artifact/materializing/publication/model"
import type { Input } from "./model"

export type Output = Columns

export default function (in: Input): Output {
    const { rows, owner, empty, members, first } = in

    return loop({
        row: 0,
        functions: in.functions
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const row = state.row
            const source = read({
                rows,
                row
            })
            const record = own({
                source,
                owner,
                empty
            })

            state.functions = write({
                columns: state.functions,
                function: record.function,
                attributes: record.attributes,
                row
            })

            const name = bytes.fromText(record.name)
            const id = integers.narrow(first + row)

            memory.writeColumnBytes(members.name, row, name)
            columns.writeColumnOptionalU32(members.id, row, id)
            columns.writeColumnOptionalU32(members.input_type, row, source.input)
            columns.writeColumnOptionalU32(members.output_type, row, source.output)
            columns.writeColumnOptionalText(members.namespace, row, null)
            columns.writeColumnOptionalU8(members.intrinsic, row, null)

            state.row += 1
        },
        return: state => state.functions
    })
}
