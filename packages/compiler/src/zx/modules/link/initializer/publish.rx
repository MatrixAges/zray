<Module>
    <Type from="model" as="Initializer" />
    <Type from="../../artifact/materializing/publication/model" as="Result" />
    <Type from="../../artifact/materializing/publication/source_model" as="Body" />

    <Args in={Initializer.Publication} out={Body.Output} />

    <Call fn="../../artifact/materializing/publication/root" in={$in.body} />

    <If on={$ctx.root.status == Result.PublicationStatus.Complete}>
        <Call fn="../../compiled/initializer_registry/insert" in={$in.registry} />
    </If>

    <Return value={$ctx.root} />
</Module>
