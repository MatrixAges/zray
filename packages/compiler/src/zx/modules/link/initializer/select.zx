import integers from "std:integer"
import probe from "core/bytes/index/borrowed/probe_slice"
import { max_u32 } from "core/const"
import columns from "memory/columns"

import { Status } from "./model"

import type { Selection as Output, Registry as Input } from "./model"

export default function (in: Input): Output {
    const found = probe({
        keys: in.source.identity,
        buckets: in.buckets,
        text: in.identity
    })

    if (found.entry != 0) {
        const previous = found.entry - 1
        const version = columns.readColumnU32(in.source.schema_version, previous)

        return {
            status: version == in.version ? Status.Compare : Status.Conflict,
            function: columns.readColumnU32(in.source.function, previous),
            slot: found.slot
        }
    }

    if (in.functions == integers.widen(max_u32)) {
        return {
            status: Status.Exhausted,
            function: 0,
            slot: found.slot
        }
    }

    return {
        status: Status.Append,
        function: integers.narrow(in.functions),
        slot: found.slot
    }
}
