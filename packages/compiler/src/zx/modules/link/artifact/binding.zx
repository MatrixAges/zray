import type { Input as Dependencies } from "../dependencies/traversal/model"
import type { Input as NativePlan } from "../native/plan"
import type { Input as NativePublication } from "../native/publication/model"
import type { Batch } from "../signature/model"
import type { Input as Admission } from "./admission/model"
import type { Preparation as Body } from "./body/model"

export enum Status {
    Absent,
    Append,
    Retain,
    Invalid,
    Conflict,
    Full
}

export type Native = {
    plan?: NativePlan,
    publication: NativePublication.Omit("rows")
}

export type Input = {
    admission: Admission,
    native?: Native,
    signatures?: Batch
    dependencies: Dependencies,
    body: Body.Omit("first")
}
