import type { ColumnView } from "memory/columns"
import type { Input as Dependencies } from "../dependencies/traversal/model"
import type { Input as NativePlan } from "../native/plan"
import type { Input as NativePublication } from "../native/publication/model"
import type { Batch } from "../signature/model"
import type { Input as Admission } from "./admission/model"
import type { Preparation as Body } from "./body/model"
import type { Input as PrepareBody, Output as PreparedBody } from "./body/request"

export enum Status {
    Ready,
    Invalid,
    Conflict,
    Full
}

export type Native = {
    plan: NativePlan,
    snapshot: ColumnView,
    publication: NativePublication
}

export type Input = {
    admission: Admission,
    native?: Native,
    signatures?: Batch
    dependencies: Dependencies.Omit("functions"),
    body: Body.Omit("first"),
    source?: PrepareBody.Omit("first", "append", "functions", "natives")
}

export type Output = {
    status: Status,
    body?: PreparedBody
}
