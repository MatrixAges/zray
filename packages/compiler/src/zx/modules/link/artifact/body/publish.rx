<Module>
    <Type from="publication" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output?} />

    <Call module="../../../artifact/materializing/own_function" in={$in.request.body} />

    <If on={$ctx.own_function != null}>
        <Call fn="retain" in={$ctx.own_function} />

        <If on={$in.request.append != null}>
            <Call
                fn="../../result/publication/row"
                in={{
                    ports: $ctx.retain.ports,
                    body: $ctx.retain.body,
                    file: $ctx.retain.file,
                    stores: $ctx.retain.stores,
                    empty: $in.empty
                }}
            />

            <Call
                fn="../../../../../core/function_table/publication/publish"
                in={{
                    storage: $in.storage,
                    body: $ctx.row,
                    native: null
                }}
            />

            <Call fn="slot" in={$in.request.append} />

            <Return
                value={{
                    linked: $ctx.slot
                }}
            />
        </If>

        <Return
            value={{
                entry: $ctx.retain
            }}
        />
    </If>

    <Return value={null} />
</Module>
