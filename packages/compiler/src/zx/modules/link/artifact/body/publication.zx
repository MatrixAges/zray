import type { Stores } from "core/store_table/model"
import type { ColumnLengths, OptionalU32Buffer } from "memory"
import type {
    BodyColumns,
    Target
} from "../../../artifact/materializing/publication/model"
import type { Empty } from "../../../artifact/materializing/publication/source_model"
import type { Entry } from "../../result/publication/model"
import type { Output as Prepared } from "./request"

export type Tail = Target & {
    lengths: ColumnLengths,
    linked: OptionalU32Buffer,
    module: u64,
    first: u64
}

export type Input = {
    request: Prepared,
    tables: BodyColumns,
    tail?: Tail,
    empty: Empty
}

export type Output = {
    retained?: Retained,
    tables?: BodyColumns
}

export type Retained = Entry & {
    file: string,
    recursive?: u32,
    stores?: Stores
}
