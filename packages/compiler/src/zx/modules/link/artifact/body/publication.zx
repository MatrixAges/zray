import type { Stores } from "core/store_table/model"
import type { OptionalU32Buffer } from "memory"
import type { ColumnSet } from "memory/columns"
import type { Entry } from "../../result/publication/model"
import type { OpaqueBody } from "../../signature/publication/model"
import type { Output as Prepared } from "./request"

export type Input = {
    request: Prepared,
    storage: ColumnSet,
    linked: OptionalU32Buffer,
    module: u64,
    empty: OpaqueBody
}

export type Output = {
    row?: u64,
    entry: Retained
}

export type Retained = Entry & {
    file: string,
    recursive?: u32,
    stores?: Stores
}
