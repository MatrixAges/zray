import type { Owned } from "../../../artifact/materializing/function_model"
import type { Retained as Output } from "../../result/publication/model"

export type Input = Owned

export default function (in: Input): Output {
    return {
        file: in.file,
        recursive: in.recursive,
        stores: in.store_table,
        ports: {
            input_type: in.ports.input,
            output_type: in.ports.output,
            ownership: in.ownership,
            store_mode: in.store_mode
        },
        body: {
            symbols: in.symbols,
            expressions: in.expressions,
            contracts: in.contracts,
            control: in.control,
            root: in.root
        }
    }
}
