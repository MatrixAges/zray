<Module>
    <Type from="binding" as="Binding" />
    <Type from="body/model" as="Body" />
    <Type from="../native/model" as="Native" />
    <Type from="../signature/decision" as="Signature" />
    <Type from="../dependencies/model" as="Dependencies" />

    <Args in={Binding.Input} out={Binding.Output} />

    <Call module="admission/check" in={$in.admission} />

    <If on={!$ctx.check}>
        <Return
            value={{
                status: Binding.Status.Invalid
            }}
        />
    </If>

    <Call module="bind_native" in={$in.native} />

    <If on={$ctx.bind_native.failure != null}>
        <Switch on={$ctx.bind_native.failure}>
            <Case value={Native.Status.Conflict}>
                <Return
                    value={{
                        status: Binding.Status.Conflict
                    }}
                />
            </Case>

            <Case value={Native.Status.Full}>
                <Return
                    value={{
                        status: Binding.Status.Full
                    }}
                />
            </Case>

            <Default>
                <Return
                    value={{
                        status: Binding.Status.Invalid
                    }}
                />
            </Default>
        </Switch>
    </If>

    <Call
        module="../signature/batch"
        in={{
            source: $in.signatures,
            native_ids: $ctx.bind_native.ids
        }}
    />

    <If on={$ctx.batch.status == Signature.Status.Conflict}>
        <Return
            value={{
                status: Binding.Status.Conflict
            }}
        />
    </If>

    <If on={$ctx.batch.status != Signature.Status.Reuse}>
        <Return
            value={{
                status: Binding.Status.Invalid
            }}
        />
    </If>

    <Call
        module="../dependencies/traversal/walk"
        in={{
            ...$in.dependencies,
            functions: $ctx.batch.ids
        }}
    />

    <If on={$ctx.walk == Dependencies.Status.Conflict}>
        <Return
            value={{
                status: Binding.Status.Conflict
            }}
        />
    </If>

    <If on={$ctx.walk != Dependencies.Status.Ready}>
        <Return
            value={{
                status: Binding.Status.Invalid
            }}
        />
    </If>

    <Call
        module="body/prepare"
        in={{
            ...$in.body,
            first: $in.dependencies.walk.checks.linked.files.length
        }}
    />

    <If on={$ctx.prepare == Body.Placement.Absent}>
        <Return
            value={{
                status: Binding.Status.Ready
            }}
        />
    </If>

    <If on={$in.source != null}>
        <If
            on={$ctx.prepare == Body.Placement.Append ||
                $ctx.prepare == Body.Placement.Retain}
        >
            <Call
                fn="body/request"
                in={{
                    ...$in.source,
                    functions: $ctx.batch.ids,
                    natives: $ctx.bind_native.ids,
                    first: $in.dependencies.walk.checks.linked.files.length,
                    append: $ctx.prepare == Body.Placement.Append
                }}
            />

            <Return
                value={{
                    status: Binding.Status.Ready,
                    body: $ctx.request
                }}
            />
        </If>
    </If>

    <Return
        value={{
            status: Binding.Status.Invalid
        }}
    />
</Module>
