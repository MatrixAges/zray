import bind from "compiler/artifact_bind_module"

import { Status } from "../binding"

import type { Input as Binding } from "../binding"

export type Input = Binding

export type Output = Status

export default function (in: Input): Output {
    const [failure, result] = try bind(in)

    const allocation_failed = failure == error.OutOfMemory
    const integer_overflow = failure == error.IntegerOverflow

    if (allocation_failed || integer_overflow) {
        return Status.Full
    }

    return result ?? Status.Invalid
}
