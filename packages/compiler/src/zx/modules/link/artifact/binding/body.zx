import view from "artifact_view"

import { Status } from "../binding"

import type { ModuleView } from "artifact_view"

export type Input = {
    frame: ModuleView,
    index: u64,
    append: bool,
    reject_store: bool
}

export type Output = Status

export default function (in: Input): Output {
    const [failure, _] = try view.publishArtifactBody(
        in.frame,
        in.index,
        in.append,
        in.reject_store
    )

    if (failure == null) {
        return Status.Append
    }

    return failure == error.OutOfMemory ? Status.Full : Status.Invalid
}
