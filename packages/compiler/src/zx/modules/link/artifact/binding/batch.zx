import publish from "compiler/artifact_bind_body"
import bind from "compiler/artifact_bind_row"
import memory from "memory"

import { Status } from "../binding"

import type { Retained } from "../../result/publication/model"
import type { Input, Output } from "./batch_model"

export default function (in: Input): Output {
    const { rows, scope, scratch, owned, storage, linked, empty } = in

    const entry: Retained? = null

    return loop({
        position: 0,
        status: Status.Ready,
        entry
    }, {
        while: state => state.status == Status.Ready && state.position < rows.length,
        next: state => {
            const { module, binding } = rows[state.position]

            memory.selectArena(scope, scratch)

            const bound = bind(binding)

            memory.selectArena(scope, owned)

            state.status = bound.status

            if (bound.body != null) {
                const written = publish({
                    request: bound.body,
                    module,
                    storage,
                    linked,
                    empty
                })

                if (written == null) {
                    state.status = Status.Invalid
                } else {
                    state.entry = written.entry
                }
            }

            state.position += 1

            if (state.status == Status.Ready && !binding.body.entry) {
                memory.resetArena(scratch)
            }
        },
        return: state => state.omit(["position"])
    })
}
