import view from "artifact_view"
import dependency from "compiler/artifact_dependency"
import memory from "memory"

import { Status } from "../binding"
import { position_slot, status_slot, ready, full, conflict, invalid } from "./const"

import type { Batch } from "./model"

export type Input = Batch

export type Output = Status

export default function (in: Input): Output {
    return loop(in, {
        while: state => memory.readU64(state.cursor, position_slot)
        < state.dependencies.length,
        next: state => {
            const { frame, binding, dependencies, cursor } = state
            const row = memory.readU64(cursor, position_slot)
            const index = dependencies[row]

            view.borrowArtifactBinding(frame, index)

            const status = dependency({
                frame,
                binding,
                index
            })

            if (status == Status.Append || status == Status.Absent) {
                memory.resetArena(state.scratch)
                memory.writeU64(cursor, position_slot, row + 1)
            } else {
                const code = match status {
                    Status.Conflict => conflict,
                    Status.Full => full,
                    _ => invalid
                }

                memory.writeU64(cursor, status_slot, code)
                memory.writeU64(cursor, position_slot, dependencies.length)
            }
        },
        return: state => match memory.readU64(state.cursor, status_slot) {
            ready => Status.Absent,
            conflict => Status.Conflict,
            full => Status.Full,
            _ => Status.Invalid
        }
    })
}
