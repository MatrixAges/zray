import type { ModuleView } from "artifact_view"
import type { Arena, U64Buffer } from "memory"
import type { Input as Binding } from "../binding"

export type Module = {
    frame: ModuleView,
    binding: Binding,
    index: u64
}

export type Batch = Module.Omit("index") & {
    dependencies: u64[],
    scratch: Arena,
    cursor: U64Buffer
}
