<Module>
    <Type from="batch_model" as="Batch" />
    <Type from="../binding" as="Binding" />

    <Args in={Batch.Traversal} out={Batch.Traversal} />

    <If
        on={$in.status == Binding.Status.Ready &&
            !$in.rows[$in.position].binding.body.entry}
    >
        <Call fn="arenas.resetArena" in={$in.scratch} />
    </If>

    <Return
        value={{
            ...$in,
            position: $in.position + 1,
            running:
                $in.status == Binding.Status.Ready && $in.position + 1 < $in.rows.length
        }}
    />
</Module>
