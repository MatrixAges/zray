<Module>
    <Type from="model" as="Model" />
    <Type from="../binding" as="Binding" />

    <Args in={Model.Module} out={Binding.Status} />

    <Call fn="admit" in={$in.binding} />

    <If
        on={$ctx.admit != Binding.Status.Append &&
            $ctx.admit != Binding.Status.RejectStoreDependency}
    >
        <Return value={$ctx.admit} />
    </If>

    <Call
        fn="body"
        in={{
            frame: $in.frame,
            index: $in.index,
            append: $ctx.admit == Binding.Status.Append,
            reject_store: $ctx.admit == Binding.Status.RejectStoreDependency
        }}
    />

    <Return value={$ctx.body} />
</Module>
