import type { Arena, ArenaScope, OptionalU32Buffer } from "memory"
import type { ColumnSet } from "memory/columns"
import type { Retained } from "../../result/publication/model"
import type { BodyColumns } from "../../signature/publication/model"
import type { Input as Binding, Status } from "../binding"

export type Row = {
    module: u64,
    binding: Binding
}

export type Input = {
    rows: Row[],
    scope: ArenaScope,
    scratch: Arena,
    owned: Arena,
    storage: ColumnSet,
    linked: OptionalU32Buffer,
    empty: BodyColumns
}

export type Output = {
    status: Status,
    entry?: Retained
}

export type Traversal = Input & Output & {
    position: u64,
    running: bool
}
