import type { Arena, ArenaScope, OptionalU32Buffer } from "memory"
import type { ColumnSet } from "memory/columns"
import type { OpaqueBody } from "../../signature/publication/model"
import type { Input as Binding, Status } from "../binding"
import type { Retained } from "../body/publication"

export type Row = {
    module: u64,
    binding: Binding
}

export type Input = {
    rows: Row[],
    scope: ArenaScope,
    scratch: Arena,
    owned: Arena,
    storage: ColumnSet,
    linked: OptionalU32Buffer,
    empty: OpaqueBody
}

export type Patch = {
    row: u64,
    entry: Retained
}

export type Output = {
    status: Status,
    entry?: Retained,
    bodies: Patch[]
}
