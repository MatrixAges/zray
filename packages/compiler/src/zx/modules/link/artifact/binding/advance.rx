<Module>
    <Type from="batch_model" as="Batch" />
    <Type from="../binding" as="Binding" />

    <Args in={Batch.Traversal} out={Batch.Traversal} />

    <Call
        fn="arenas.selectArena"
        in={[
            $in.scope,
            $in.scratch
        ]}
    />

    <Call module="../bind" in={$in.rows[$in.position].binding} />

    <Call
        fn="arenas.selectArena"
        in={[
            $in.scope,
            $in.owned
        ]}
    />

    <If on={$ctx.bind.body != null}>
        <Call
            module="../body/publish"
            in={{
                request: $ctx.bind.body,
                module: $in.rows[$in.position].module,
                storage: $in.storage,
                linked: $in.linked,
                empty: $in.empty
            }}
        />

        <If on={$ctx.publish != null}>
            <Call
                module="finish"
                in={{
                    ...$in,
                    status: $ctx.bind.status,
                    entry: $ctx.publish.entry
                }}
            />

            <Return value={$ctx.finish} />
        </If>

        <Return
            value={{
                ...$in,
                position: $in.position + 1,
                status: Binding.Status.Invalid,
                running: false
            }}
        />
    </If>

    <Call
        module="finish"
        in={{
            ...$in,
            status: $ctx.bind.status
        }}
    />

    <Return value={$ctx.finish} />
</Module>
