<Module>
    <Type from="batch_model" as="Batch" />
    <Type from="../binding" as="Binding" />

    <Args in={Batch.Input} out={Batch.Output} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                ...$in,
                position: 0,
                status: Binding.Status.Ready,
                entry: null,
                running: $in.rows.length != 0
            }}
        />
    </Loop>

    <Return
        value={$ctx.advance.pick([
            "status",
            "entry"
        ])}
    />
</Module>
