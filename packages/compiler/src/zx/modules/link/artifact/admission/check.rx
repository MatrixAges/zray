<Module>
    <Type from="model" as="Admission" />

    <Args in={Admission.Input} out={bool} />

    <Task name="layout" out={$ctx.admit}>
        <Call module="../../signature/admit" in={$in.layout} />
    </Task>

    <If on={!$ctx.task.layout}>
        <Return value={false} />
    </If>

    <Task name="surface" out={$ctx.admit}>
        <Call module="../../surface/admit" in={$in.surface} />
    </Task>

    <If on={!$ctx.task.surface}>
        <Return value={false} />
    </If>

    <If on={$in.constants != null}>
        <Call
            module="../../../../analysis/constants/validation/pair"
            in={$in.constants}
        />

        <If on={!$ctx.pair}>
            <Return value={false} />
        </If>
    </If>

    <Return value={true} />
</Module>
