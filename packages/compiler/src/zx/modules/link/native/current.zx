import { moduleView } from "core/column_set"

import type { Native } from "../artifact/binding"
import type { Input as Plan } from "./plan"

export type Input = Native

export type Output = Plan

export default function (in: Input): Output {
    return {
        ...in.plan,
        base: moduleView({
            storage: in.publication.destination.storage,
            view: in.snapshot
        })
    }
}
