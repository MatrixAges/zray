<Module>
    <Type from="plan" as="Plan" />
    <Type from="publication/model" as="Publication" />

    <Args
        in={{
            plan?: Plan.Input,
            publication: Publication.Input
        }}
        out={Plan.Selection}
    />

    <Call module="select" in={$in.plan} />

    <If on={$ctx.select.failure != null}>
        <Return value={$ctx.select} />
    </If>

    <Call
        module="publication/publish"
        in={{
            ...$in.publication,
            rows: $ctx.select.rows
        }}
    />

    <Return value={$ctx.select} />
</Module>
