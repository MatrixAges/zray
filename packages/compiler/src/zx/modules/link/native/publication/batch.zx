import binding from "core/native_module_table/binding"

import remap from "./ids"

import type { Binding } from "core/native_module_table/model"
import type { Input as Request } from "./model"

export type Input = Request.Omit("destination") & {
    index: u64,
    count: u64
}

export type Output = Binding & {
    index: u64
}

export default function (in: Input): Output {
    const { source, mapping, rows, index } = in

    const row = rows == null ? index : rows[index]

    const selected = binding({
        source,
        row
    })

    return {
        ...selected,
        ids: remap({
            values: selected.ids,
            mapping
        }),
        index
    }
}
