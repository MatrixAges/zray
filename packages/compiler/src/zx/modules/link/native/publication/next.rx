<Module>
    <Type from="batch" as="Batch" />

    <Args in={Batch.Input} out={Batch.Input} />

    <Store from="rows" as="rows" />

    <Call fn="batch" in={$in} />

    <Call fn="commit" setter={[$store.rows.pending]} />

    <Return
        value={{
            ...$in,
            index: $ctx.commit
        }}
    />
</Module>
