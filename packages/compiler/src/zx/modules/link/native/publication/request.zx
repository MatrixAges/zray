import binding from "core/native_module_table/binding"

import type { Row as Output, Traversal as Input } from "./model"

export default function (in: Input): Output {
    const { destination, mapping, source, rows, index } = in

    const row = rows == null ? index : rows[index]

    return {
        destination,
        source: binding({
            source,
            row
        }),
        mapping
    }
}
