<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call
        fn="reserve"
        in={$in.omit(["mapping"])}
    />

    <If on={$ctx.reserve != 0}>
        <Call
            module="batch"
            in={{
                ...$in,
                count: $ctx.reserve
            }}
        />
    </If>
</Module>
