<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call fn="reserve" in={$in} />

    <Loop on={$in.index < $in.count}>
        <Call
            module="next"
            in={{
                ...$in.omit(["destination"]),
                index: 0,
                count: $ctx.reserve
            }}
        />
    </Loop>
</Module>
