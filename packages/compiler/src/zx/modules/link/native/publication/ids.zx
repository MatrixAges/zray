import integers from "std:integer"
import memory from "memory/columns"

import type { ColumnAllocator, ColumnU32s } from "memory/columns"

export type Input = {
    values: u32[],
    mapping: u32[],
    resource: ColumnAllocator,
    target: ColumnU32s
}

export type Output = u32[]

export default function (in: Input): Output {
    const { values, mapping, resource, target } = in

    const ids = memory.allocateColumnU32s(resource, target, values.length)

    const written = loop(0, {
        while: index => index < values.length,
        next: index => {
            const id = mapping[integers.widen(values[index])]

            memory.writeColumnU32s(target, index, id)
            index += 1
        }
    })

    return ids
}
