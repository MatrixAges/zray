import { appendNative } from "core/column_set"
import { copy } from "core/owned_text"
import storage from "memory"

import type { Binding } from "core/native_module_table/model"
import type { NativeModuleRow } from "memory/columns"
import type { Destination } from "./model"

export type Input = {
    source: Binding,
    destination: Destination,
    ids: u32[]
}

export type Output = void

export default function (in: Input): Output {
    const { source, destination, ids } = in
    const { text_allocator } = destination
    const { identity } = source

    const owned_identity: string? = match {
        identity != null => storage.copyColumnText(text_allocator, identity),
        _ => null
    }

    const specifier = storage.copyColumnText(text_allocator, source.specifier)
    const import_name = storage.copyColumnText(text_allocator, source.import_name)

    const namespace = copy({
        allocator: text_allocator,
        source: source.namespace
    })

    const names = copy({
        allocator: text_allocator,
        source: source.names
    })

    const row: NativeModuleRow = {
        identities: owned_identity,
        import_names: import_name,
        specifiers: specifier,
        type_ids: ids,
        type_names: names,
        type_namespaces: namespace
    }

    appendNative({
        storage: destination.storage,
        row
    })
}
