<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Row} out={void} />

    <Call
        fn="ids"
        in={{
            values: $in.source.ids,
            mapping: $in.mapping,
            target: $in.destination.ids,
            resource: $in.destination.resource
        }}
    />

    <Call
        fn="append"
        in={{
            destination: $in.destination,
            source: $in.source,
            ids: $ctx.ids
        }}
    />
</Module>
