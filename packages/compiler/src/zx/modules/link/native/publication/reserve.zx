import integers from "std:integer"
import { reserve } from "core/column_set"
import { max_u32 } from "core/const"
import memory from "memory/columns"

import type { Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { source, rows, destination } = in

    const count = rows == null ? source.specifiers.length : rows.length

    if (count != 0) {
        reserve({
            resource: destination.resource,
            storage: destination.storage,
            growth: memory.nativeColumnGrowth(destination.shape, null),
            count,
            limit: integers.widen(max_u32)
        })
    }

    return count
}
