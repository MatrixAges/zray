import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory/columns"

import type { Input as Publication } from "./model"

export type Input = Publication.Omit("mapping")

export type Output = u64

export default function (in: Input): Output {
    const { source, rows, destination } = in

    const count = rows == null ? source.specifiers.length : rows.length

    if (count != 0) {
        memory.reserveNativeColumnSet(
            destination.resource,
            destination.storage,
            destination.shape,
            count,
            integers.widen(max_u32)
        )
    }

    return count
}
