import type { Index } from "core/bytes/index/model"
import type { OrderTarget } from "../../../../rx/dependency_graph/model"

export enum Status {
    Ready,
    Invalid,
    Missing,
    Cycle
}

export type Input = OrderTarget & {
    paths: u8[][],
    targets: u8[][],
    offsets: u64[],
    entry: u8[]
}

export type Registry = {
    index: Index,
    valid: bool
}

export type Output = {
    count: u64,
    status: Status,
    buckets: u32?[],
    targets: u64[]
}
