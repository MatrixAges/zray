import type { Index } from "core/bytes/index/model"
import type { ListColumn, U64Buffer } from "memory"
import type { OrderTarget } from "../../../../rx/dependency_graph/model"

export enum Status {
    Ready,
    Invalid,
    Missing,
    Cycle
}

export type Input = OrderTarget & {
    paths: u8[][],
    dependencies: Dependencies,
    offsets: u64[],
    offset_target: U64Buffer,
    entry: u8[]
}

export type Dependencies = {
    kinds: ListColumn,
    paths: ListColumn,
    kind_stride: u64,
    source_kind: u8
}

export type Registry = {
    index: Index,
    valid: bool
}

export type Output = {
    count: u64,
    status: Status,
    buckets: u32?[],
    targets: u64[]
}
