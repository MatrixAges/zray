import type { Index } from "core/bytes/index/model"
import type { ListColumn } from "memory"
import type { Input as Paths } from "./paths"

export enum Status {
    Ready,
    Invalid,
    Missing,
    Cycle
}

export type Input = {
    path_columns: Paths,
    dependencies: Dependencies,
    entry: u8[]
}

export type Dependencies = {
    kinds: ListColumn,
    paths: ListColumn,
    kind_stride: u64,
    source_kind: u8
}

export type Registry = {
    index: Index,
    valid: bool
}

export type Output = {
    registration: u64[],
    entry?: u64,
    dependencies: u64[],
    status: Status,
    paths: u8[][],
    buckets: u32?[],
    offsets: u64[],
    targets: u64[]
}
