<Module>
    <Type from="model" as="LinkGraph" />

    <Args in={LinkGraph.Input} out={LinkGraph.Output} />

    <Call fn="paths" in={$in.path_columns} />
    <Call fn="registry" in={$in.paths} />

    <If on={!$ctx.registry.valid}>
        <Return
            value={{
                status: LinkGraph.Status.Invalid,
                registration: [],
                entry: null,
                dependencies: [],
                buckets: [],
                targets: []
            }}
        />
    </If>

    <Call
        fn="locate"
        in={{
            index: $ctx.registry.index,
            key: $in.entry
        }}
    />

    <If on={$ctx.locate == null}>
        <Return
            value={{
                status: LinkGraph.Status.Missing,
                registration: [],
                entry: null,
                dependencies: [],
                buckets: [],
                targets: []
            }}
        />
    </If>

    <Call
        fn="edges"
        in={{
            index: $ctx.registry.index,
            dependencies: $in.dependencies,
            offsets: $in.offsets,
            offset_target: $in.offset_target,
            root: $ctx.locate ?? 0
        }}
    />

    <Call
        fn="../../../../rx/dependency_graph/walk"
        in={{
            ...$ctx.edges,
            order: $in.order,
            capacity: $in.capacity
        }}
    />

    <Call fn="status" />

    <If on={$ctx.status == LinkGraph.Status.Ready}>
        <Call
            fn="phases"
            in={{
                order: $in.order_rows,
                count: $ctx.walk.count
            }}
        />

        <Return
            value={{
                ...$ctx.phases,
                status: $ctx.status,
                entry: $ctx.locate,
                buckets: $ctx.registry.index.buckets,
                targets: $ctx.edges.targets
            }}
        />
    </If>

    <Return
        value={{
            status: $ctx.status,
            registration: [],
            entry: null,
            dependencies: [],
            buckets: $ctx.registry.index.buckets,
            targets: $ctx.edges.targets
        }}
    />
</Module>
