<Module>
    <Type from="model" as="LinkGraph" />

    <Args in={LinkGraph.Input} out={LinkGraph.Output} />

    <Call fn="registry" in={$in.paths} />

    <If on={!$ctx.registry.valid}>
        <Return
            value={{
                status: LinkGraph.Status.Invalid,
                count: 0,
                buckets: [],
                targets: []
            }}
        />
    </If>

    <Call
        fn="locate"
        in={{
            index: $ctx.registry.index,
            key: $in.entry
        }}
    />

    <If on={$ctx.locate == null}>
        <Return
            value={{
                status: LinkGraph.Status.Missing,
                count: 0,
                buckets: [],
                targets: []
            }}
        />
    </If>

    <Call
        fn="edges"
        in={{
            index: $ctx.registry.index,
            dependencies: $in.dependencies,
            offsets: $in.offsets,
            offset_target: $in.offset_target,
            root: $ctx.locate ?? 0
        }}
    />

    <Call
        fn="../../../../rx/dependency_graph/walk"
        in={{
            ...$ctx.edges,
            order: $in.order,
            capacity: $in.capacity
        }}
    />

    <Call fn="status" in={$ctx.walk} />

    <Return
        value={{
            status: $ctx.status,
            count: $ctx.walk.count,
            buckets: $ctx.registry.index.buckets,
            targets: $ctx.edges.targets
        }}
    />
</Module>
