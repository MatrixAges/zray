import { moduleView, signatureView } from "core/column_set"
import memory from "memory"

import { Status } from "./decision"

import type { Batch as Input, Traversal as Output } from "./model"

export default function (in: Input): Output {
    const modules = moduleView({
        storage: in.native.storage,
        view: in.native.snapshot,
        shape: in.native.shape
    })

    const native_ids = memory.optionalU32Views(in.native.ids)

    const linked = signatureView({
        storage: in.read_columns,
        view: in.snapshot,
        shape: in.linked_shape
    })

    return {
        source: in,
        modules,
        native_ids,
        linked,
        index: 0,
        status: Status.Reuse,
        running: in.signatures.files.length != 0
    }
}
