<Module>
    <Type from="model" as="Signature" />
    <Type from="decision" as="Decision" />

    <Args
        in={{
            source?: Signature.Batch,
            native_ids: u32?[]
        }}
        out={Signature.Linked}
    />

    <If on={$in.source != null}>
        <Call
            fn="batch_initialize"
            in={{
                source: $in.source,
                native_ids: $in.native_ids
            }}
        />

        <Loop on={$in.running}>
            <Call module="batch_next" />
        </Loop>

        <Return
            value={{
                status: $ctx.batch_next.status,
                ids: $ctx.batch_next.ids
            }}
        />
    </If>

    <Return
        value={{
            status: Decision.Status.Reuse,
            ids: []
        }}
    />
</Module>
