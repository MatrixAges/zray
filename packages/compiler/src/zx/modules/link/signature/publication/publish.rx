<Module>
    <Type from="model" as="Signature" />

    <Args in={Signature.Input} out={void} />

    <Call fn="reserve" in={$in.destination} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "source",
                "row",
                "ports"
            ]),
            resource: $in.destination.resource
        }}
    />

    <Call
        fn="../../artifact/body/slot"
        in={{
            first: $in.id,
            slot: $in.row,
            target: $in.mapping
        }}
    />

    <Call
        fn="append"
        in={{
            destination: $in.destination,
            empty: $in.empty,
            prepared: $ctx.prepare
        }}
    />
</Module>
