<Module>
    <Type from="model" as="Signature" />

    <Args in={Signature.Input} out={void} />

    <Call module="reserve_columns" in={$in.destination} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "source",
                "row",
                "ports"
            ])
        }}
    />

    <Call
        fn="append"
        in={{
            destination: $in.destination,
            empty: $in.empty,
            prepared: $ctx.prepare
        }}
    />

    <Call
        fn="../../../../../core/column_set/write_function"
        in={{
            storage: $in.destination.storage,
            row: $ctx.append
        }}
    />
</Module>
