import memory from "memory/columns"

import complete from "./function_row"
import signature from "./signature_row"

import type { BodyColumns, Destination } from "./model"
import type { Output as Prepared } from "./prepare"

export type Input = {
    destination: Destination,
    empty: BodyColumns,
    prepared: Prepared
}

export type Output = void

export default function (in: Input): Output {
    const fields = signature({
        signature: in.prepared.function,
        flags: in.prepared.flags
    })

    const row = complete({
        signature: fields,
        empty: in.empty
    })

    memory.appendColumnSet(in.destination.storage, row)
}
