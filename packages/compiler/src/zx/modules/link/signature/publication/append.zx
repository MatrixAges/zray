import { copy, copyNullable } from "core/owned_text"
import memory from "memory"

import complete from "./function_row"
import signature from "./signature_row"

import type { FunctionRow } from "memory/columns"
import type { BodyColumns, Destination } from "./model"
import type { Output as Prepared } from "./prepare"

export type Input = {
    destination: Destination,
    empty: BodyColumns,
    prepared: Prepared
}

export type Output = FunctionRow

export default function (in: Input): Output {
    const fields = signature({
        signature: in.prepared.function,
        flags: in.prepared.flags
    })

    const allocator = in.destination.text_allocator
    const export_name = fields.native_exports
    const errors = fields.native_errors
    const parameters = fields.native_inputs

    const members = copy({
        allocator,
        source: fields.native_members
    })

    const owned_errors: string[]? = match {
        errors != null => copy({
            allocator,
            source: errors
        }),
        _ => null
    }

    const owned_parameters: string?[]? = match {
        parameters != null => copyNullable({
            allocator,
            source: parameters
        }),
        _ => null
    }

    const names = copy({
        allocator,
        source: match {
            export_name == null => [fields.files],
            _ => [
                fields.files,
                export_name
            ]
        }
    })

    const file = names[0]

    const owned_export: string? = match {
        export_name == null => null,
        _ => names[1]
    }

    memory.freeTextSlots(allocator, names)

    return complete({
        signature: {
            ...fields,
            files: file,
            native_members: members,
            native_errors: owned_errors,
            native_exports: owned_export,
            native_inputs: owned_parameters
        },
        empty: in.empty
    })
}
