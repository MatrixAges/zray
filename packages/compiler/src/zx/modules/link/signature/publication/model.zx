import type { Table } from "core/signature_table/model"
import type { OptionalU32Buffer } from "memory"
import type {
    ColumnAllocator,
    ColumnObject,
    ColumnSet,
    FunctionRow
} from "memory/columns"
import type { Ports } from "../../../artifact/remapping/model"

export type OpaqueBody = {
    symbols: ColumnObject,
    expressions: ColumnObject,
    contracts: ColumnObject,
    control: ColumnObject,
    stores: ColumnObject
}

export type Record = {
    source: Table,
    row: u64,
    ports: Ports
}

export type Destination = {
    storage: ColumnSet,
    shape?: FunctionRow,
    maximum_count: u64,
    resource: ColumnAllocator
}

export type Input = Record & {
    destination: Destination,
    empty: OpaqueBody,
    mapping: OptionalU32Buffer,
    id: u64
}
