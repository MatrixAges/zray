import type { Table } from "core/signature_table/model"
import type { Allocator } from "memory"
import type {
    ColumnAllocator,
    ColumnSet,
    FunctionRow
} from "memory/columns"
import type { Ports } from "../../../artifact/remapping/model"

export type BodyColumns = FunctionRow.Pick(
    "symbols",
    "expressions",
    "contracts",
    "control",
    "stores"
)

export type Record = {
    source: Table,
    row: u64,
    ports: Ports
}

export type Destination = {
    storage: ColumnSet,
    shape?: FunctionRow,
    maximum_count: u64,
    resource: ColumnAllocator,
    text_allocator: Allocator
}

export type Input = Record & {
    destination: Destination,
    empty: BodyColumns
}
