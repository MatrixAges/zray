import { ColumnStoreMode } from "memory/columns"

import type { FunctionRow as Output, SignatureRow } from "memory/columns"
import type { BodyColumns } from "./model"

export type Input = {
    signature: SignatureRow,
    empty: BodyColumns
}

export default function (in: Input): Output {
    const { signature, empty } = in

    return {
        ...signature,
        store_modes: ColumnStoreMode.transaction,
        contracts: empty.contracts,
        symbols: empty.symbols,
        expressions: empty.expressions,
        control: empty.control,
        roots: null,
        stores: empty.stores
    }
}
