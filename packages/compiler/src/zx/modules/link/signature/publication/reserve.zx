import { reserve } from "core/column_set"
import memory from "memory/columns"

import type { Destination } from "./model"

export type Input = Destination

export type Output = void

export default function (in: Input): Output {
    reserve({
        resource: in.resource,
        storage: in.storage,
        growth: memory.functionColumnGrowth(in.shape, null),
        count: 1,
        limit: in.maximum_count
    })
}
