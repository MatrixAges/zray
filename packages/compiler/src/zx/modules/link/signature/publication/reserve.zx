import memory from "memory/columns"

import type { ColumnAllocator, ColumnGrowth, ColumnSet } from "memory/columns"
import type { Destination } from "./model"

export type Input = Destination

export type Output = {
    resource: ColumnAllocator,
    storage: ColumnSet,
    growth: ColumnGrowth,
    count: u64,
    limit: u64
}

export default function (in: Input): Output {
    return {
        resource: in.resource,
        storage: in.storage,
        growth: memory.functionColumnGrowth(in.shape, null),
        count: 1,
        limit: in.maximum_count
    }
}
