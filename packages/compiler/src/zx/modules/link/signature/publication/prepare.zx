import flags from "../../../artifact/materializing/publication/flags"

import type { Flags, Signature } from "../../../artifact/materializing/publication/model"
import type { Record } from "./model"

export type Input = Record

export type Output = {
    function: Signature,
    flags: Flags
}

export default function (in: Input): Output {
    const { source, row, ports } = in

    return {
        function: {
            file: source.files[row],
            ports,
            external: {
                members: source.native_members[row],
                errors: source.native_errors[row],
                export_name: source.native_exports[row],
                parameters: source.native_inputs[row]
            }
        },
        flags: flags({
            source: source.pick([
                "ownership",
                "native_allocators",
                "native_io",
                "native_process",
                "native_tuples",
                "native_fallible",
                "native_concurrent"
            ]),
            row
        })
    }
}
