import { copy, copyNullable } from "core/owned_text"
import memory from "memory"

import flags from "../../../artifact/materializing/publication/flags"

import type { Names } from "core/signature_table/model"
import type { Allocator } from "memory"
import type { Flags, Signature } from "../../../artifact/materializing/publication/model"
import type { Record } from "./model"

export type Input = Record & {
    allocator: Allocator
}

export type Output = {
    function: Signature,
    flags: Flags
}

export default function (in: Input): Output {
    const { source, row, ports, allocator } = in

    const members = copy({
        allocator,
        source: source.native_members[row]
    })

    const errors = source.native_errors[row]
    const export_name = source.native_exports[row]
    const parameters = source.native_inputs[row]

    const owned_errors: string[]? = match {
        errors != null => copy({
            allocator,
            source: errors
        }),
        _ => null
    }

    const owned_name: string? = match {
        export_name != null => memory.copyColumnText(allocator, export_name),
        _ => null
    }

    const owned_parameters: Names? = match {
        parameters != null => copyNullable({
            allocator,
            source: parameters
        }),
        _ => null
    }

    return {
        function: {
            file: memory.copyColumnText(allocator, source.files[row]),
            ports,
            external: {
                members,
                errors: owned_errors,
                export_name: owned_name,
                parameters: owned_parameters
            }
        },
        flags: flags({
            source: source.pick([
                "ownership",
                "native_allocators",
                "native_io",
                "native_process",
                "native_tuples",
                "native_fallible",
                "native_concurrent"
            ]),
            row
        })
    }
}
