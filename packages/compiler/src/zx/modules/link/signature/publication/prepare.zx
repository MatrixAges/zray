import memory from "memory/columns"

import flags from "../../../artifact/materializing/publication/flags"

import type { Names } from "core/signature_table/model"
import type { ColumnAllocator } from "memory/columns"
import type { Flags, Signature } from "../../../artifact/materializing/publication/model"
import type { Record } from "./model"

export type Input = Record & {
    resource: ColumnAllocator
}

export type Output = {
    function: Signature,
    flags: Flags
}

export default function (in: Input): Output {
    const { source, row, ports, resource } = in

    const members = memory.copyColumnTexts(resource, source.native_members[row])
    const errors = source.native_errors[row]
    const export_name = source.native_exports[row]
    const parameters = source.native_inputs[row]

    const owned_errors: string[]? = match {
        errors != null => memory.copyColumnTexts(resource, errors),
        _ => null
    }

    const owned_name: string? = match {
        export_name != null => memory.copyColumnText(resource, export_name),
        _ => null
    }

    const owned_parameters: Names? = match {
        parameters != null => memory.copyColumnOptionalTexts(resource, parameters),
        _ => null
    }

    return {
        function: {
            file: memory.copyColumnText(resource, source.files[row]),
            ports,
            external: {
                members,
                errors: owned_errors,
                export_name: owned_name,
                parameters: owned_parameters
            }
        },
        flags: flags({
            source: source.pick([
                "ownership",
                "native_allocators",
                "native_io",
                "native_process",
                "native_tuples",
                "native_fallible",
                "native_concurrent"
            ]),
            row
        })
    }
}
