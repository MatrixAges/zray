import type { Index } from "core/bytes/index/model"
import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/signature_table/model"
import type { OptionalU32Buffer } from "memory"
import type { ColumnSet, ColumnView, LinkedSignatureColumns } from "memory/columns"
import type { Edges } from "../dependencies/traversal/model"
import type { External } from "../native/signature/model"
import type { Providers } from "../source_signature/model"
import type { Status } from "./decision"
import type { Ports } from "./ports"
import type { Destination, OpaqueBody } from "./publication/model"

export type Request = {
    path: string,
    key: u8[],
    ports: Ports,
    external?: External,
    types: u32[],
    modules: Modules,
    native_ids: u32?[],
    linked: LinkedSignatureColumns,
    registry: Index,
    edges: Edges,
    providers: Providers,
    functions: u32?[]
}

export type Binding = {
    status: Status,
    row: u64,
    native_id?: u32,
    input_type: u32,
    output_type: u32
}

export type Batch = Request.Omit("path", "key", "ports", "external") & {
    signatures: Table,
    target: OptionalU32Buffer,
    destination: Destination,
    read_columns: ColumnSet,
    snapshot: ColumnView,
    empty: OpaqueBody
}
