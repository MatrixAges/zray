import type { Index } from "core/bytes/index/model"
import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/signature_table/model"
import type {
    ColumnSet,
    ColumnView,
    LinkedSignatureColumns,
    NativeModuleColumns
} from "memory/columns"
import type { Edges } from "../dependencies/traversal/model"
import type { External } from "../native/signature/model"
import type { Providers } from "../source_signature/model"
import type { Status } from "./decision"
import type { Ports } from "./ports"
import type { BodyColumns, Destination } from "./publication/model"

export type Request = {
    path: string,
    key: u8[],
    ports: Ports,
    external?: External,
    types: u32[],
    modules: Modules,
    native_ids: u32?[],
    linked: LinkedSignatureColumns,
    registry: Index,
    edges: Edges,
    providers: Providers,
    functions: u32?[]
}

export type Binding = {
    status: Status,
    row: u64,
    native_id?: u32,
    input_type: u32,
    output_type: u32
}

export type Native = {
    storage: ColumnSet,
    shape?: NativeModuleColumns,
    snapshot: ColumnView
}

export type Batch = Request.Omit(
    "path",
    "key",
    "ports",
    "external",
    "modules",
    "native_ids",
    "linked"
) & {
    signatures: Table,
    native: Native,
    destination: Destination,
    read_columns: ColumnSet,
    linked_shape?: LinkedSignatureColumns,
    snapshot: ColumnView,
    empty: BodyColumns
}

export type Traversal = {
    source: Batch,
    modules: Modules,
    native_ids: u32?[],
    ids: u32?[],
    linked: LinkedSignatureColumns,
    index: u64,
    status: Status,
    running: bool
}

export type Reuse = {
    ids: u32?[],
    row: u64
}

export type Start = {
    source: Batch,
    native_ids: u32?[]
}

export type Linked = {
    status: Status,
    ids: u32?[]
}
