<Module>
    <Type from="model" as="Signature" />
    <Type from="decision" as="Decision" />

    <Args in={Signature.Traversal} out={Signature.Traversal} />

    <Call fn="batch_request" in={$in} />

    <Call module="bind" />

    <If on={$ctx.bind.status == Decision.Status.Reuse}>
        <Call
            fn="reuse"
            in={{
                ids: $in.ids,
                row: $ctx.bind.row
            }}
        />

        <Return
            value={{
                ...$in,
                ids: $ctx.reuse,
                index: $in.index + 1,
                running: $in.index + 1 < $in.source.signatures.files.length
            }}
        />
    </If>

    <If on={$ctx.bind.status == Decision.Status.Insert}>
        <Call
            module="publication/publish"
            in={{
                source: $in.source.signatures,
                row: $in.index,
                ports: {
                    input: $ctx.bind.input_type,
                    output: $ctx.bind.output_type,
                    native_module: $ctx.bind.native_id
                },
                empty: $in.source.empty,
                destination: $in.source.destination
            }}
        />

        <Call
            fn="../../../../core/column_set/signature_view"
            in={{
                storage: $in.source.read_columns,
                view: $in.source.snapshot,
                shape: $in.source.linked_shape
            }}
        />

        <Call
            fn="reuse"
            in={{
                ids: $in.ids,
                row: $ctx.bind.row
            }}
        />

        <Return
            value={{
                ...$in,
                ids: $ctx.reuse,
                linked: $ctx.signature_view,
                index: $in.index + 1,
                running: $in.index + 1 < $in.source.signatures.files.length
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            status: $ctx.bind.status,
            running: false
        }}
    />
</Module>
