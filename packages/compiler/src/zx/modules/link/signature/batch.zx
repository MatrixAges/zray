import bytes from "std:bytes"
import integers from "std:integer"
import publish from "compiler/artifact_signature_publish"
import bind from "compiler/artifact_signature_row"
import memory from "memory"
import columns from "memory/columns"

import { Status } from "./decision"

import type { External } from "../native/signature/model"
import type { Batch } from "./model"

export type Input = Batch

export type Output = Status

export default function (in: Input): Output {
    const { signatures, target } = in

    const initial = {
        next: 0,
        status: Status.Reuse,
        linked: in.linked
    }

    return loop(initial, {
        while: state =>
            state.status == Status.Reuse && state.next < signatures.files.length,
        next: state => {
            const index = state.next
            const path = signatures.files[index]
            const module_id = signatures.native_modules[index]

            const external: External? = match {
                module_id == null => null,
                _ => {
                    module_id,
                    member: signatures.native_members[index],
                    export_name: signatures.native_exports[index],
                    input: signatures.native_inputs[index],
                    allocator_argument: signatures.native_allocators[index],
                    io_argument: signatures.native_io[index],
                    process_argument: signatures.native_process[index],
                    expand_tuple: signatures.native_tuples[index],
                    fallible: signatures.native_fallible[index]
                },
            }

            const found = bind({
                ...in.omit([
                    "signatures",
                    "target",
                    "destination",
                    "read_columns",
                    "snapshot",
                    "empty",
                    "linked"
                ]),
                linked: state.linked,
                path,
                key: bytes.fromText(path),
                external,
                ports: {
                    input_type: signatures.input_types[index],
                    output_type: signatures.output_types[index],
                    ownership: signatures.ownership[index]
                }
            })

            switch (found.status) {
                case Status.Reuse:
                    memory.writeOptionalU32(
                        target,
                        index,
                        integers.narrow(found.row)
                    )
                    state.next += 1
                case Status.Insert:
                    publish({
                        source: signatures,
                        row: index,
                        ports: {
                            input: found.input_type,
                            output: found.output_type,
                            native_module: found.native_id
                        },
                        empty: in.empty,
                        destination: in.destination,
                        mapping: target,
                        id: found.row
                    })
                    state.linked = columns.readColumnSet(
                        in.read_columns,
                        in.snapshot,
                        null
                    )
                    state.next += 1
                case Status.Invalid:
                    state.status = Status.Invalid
                case Status.Conflict:
                    state.status = Status.Conflict
            }
        },
        return: state => state.status
    })
}
