<Module>
    <Type from="../../../ir/canonical/validation/names/model" as="Names" />

    <Args
        in={{
            exports: Names.Rows,
            imports: Names.Rows,
            type_count: u64
        }}
        out={bool}
    />

    <Task name="exports" out={$ctx.valid}>
        <Call
            fn="../../../ir/canonical/validation/names/valid"
            in={{
                fields: {
                    borrowed: $in.exports
                },
                type_count: $in.type_count
            }}
        />
    </Task>

    <If on={!$ctx.task.exports}>
        <Return value={false} />
    </If>

    <Task name="imports" out={$ctx.valid}>
        <Call
            fn="../../../ir/canonical/validation/names/valid"
            in={{
                fields: {
                    borrowed: $in.imports
                },
                type_count: $in.type_count
            }}
        />
    </Task>

    <Return value={$ctx.task.imports} />
</Module>
