<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Cursor} out={Link.Row} />

    <If on={$in.position == $in.dependencies.length}>
        <Return
            value={{
                index: $in.entry,
                following: null
            }}
        />
    </If>

    <Return
        value={{
            index: $in.dependencies[$in.position],
            following: $in.position + 1
        }}
    />
</Module>
