import integers from "std:integer"

import valid from "./valid"

import type { Input as Facts } from "./valid"

export type Input = Facts

export type Range = {
    first: u32,
    count: u32,
    prefix: u32,
    root: u32,
    types: u32,
    native_modules: u32
}

export type Output = Range?

export default function (in: Input): Output {
    if (!valid(in)) {
        return null
    }

    const { first, count, prefix, types, native_modules } = in

    const root = first + (count - prefix)

    return {
        first: integers.narrow(first),
        count: integers.narrow(count),
        prefix: integers.narrow(prefix),
        root: integers.narrow(root),
        types: integers.narrow(types),
        native_modules: integers.narrow(native_modules)
    }
}
