import integers from "std:integer"
import { max_u32 } from "core/const"

export type Input = {
    first: u64,
    count: u64,
    prefix: u64,
    types: u64,
    native_modules: u64
}

export type Range = {
    first: u32,
    count: u32,
    prefix: u32,
    root: u32,
    types: u32,
    native_modules: u32
}

export type Output = Range?

export default function (in: Input): Output {
    const { first, count, prefix, types, native_modules } = in

    const limit = integers.widen(max_u32)
    const natives_fit = native_modules <= limit

    const valid = (
        - first <= limit
        - and count <= limit
        - and prefix <= count
        - and prefix <= first
        - and types <= limit
        - and natives_fit
    )

    if (!valid) {
        return null
    }

    const root = first + (count - prefix)

    if (root > limit) {
        return null
    }

    return {
        first: integers.narrow(first),
        count: integers.narrow(count),
        prefix: integers.narrow(prefix),
        root: integers.narrow(root),
        types: integers.narrow(types),
        native_modules: integers.narrow(native_modules)
    }
}
