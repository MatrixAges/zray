import memory from "memory"

import valid from "../../binding/shape"

import type { Bindings } from "./model"

export type Input = {
    bindings: Bindings,
    row: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { bindings, row } = in

    return valid({
        id: memory.readColumnOptionalU32(bindings.ids, row),
        input_type: memory.readColumnOptionalU32(bindings.inputs, row),
        output_type: memory.readColumnOptionalU32(bindings.outputs, row),
        intrinsic: memory.readColumnOptionalU8(bindings.intrinsics, row)
    })
}
