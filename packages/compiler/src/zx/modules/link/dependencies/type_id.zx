import memory from "memory"

import type { Aliases } from "./model"

export type Input = {
    aliases: Aliases,
    name: string
}

export type Output = u32?

export default function (in: Input): Output {
    const { aliases, name } = in

    const id: u32? = null

    return loop({
        end: aliases.count,
        id
    }, {
        while: state => state.id == null && state.end != 0,
        next: state => {
            state.end -= 1

            if (memory.readTextColumn(aliases.names, state.end) == name) {
                state.id = memory.readColumnU32(aliases.ids, state.end)
            }
        },
        return: state => state.id
    })
}
