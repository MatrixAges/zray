<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Checks} out={Link.Status} />

    <Task name="imports" out={$ctx.shape}>
        <Call
            fn="shape"
            in={{
                bindings: $in.imports,
                count: $in.count
            }}
        />
    </Task>

    <If on={!$ctx.task.imports}>
        <Return value={Link.Status.Invalid} />
    </If>

    <Task name="members" out={$ctx.shape}>
        <Call
            fn="shape"
            in={{
                bindings: $in.members,
                count: $in.count
            }}
        />
    </Task>

    <If on={!$ctx.task.members}>
        <Return value={Link.Status.Invalid} />
    </If>

    <Call
        fn="ports"
        in={$in.omit([
            "count",
            "members"
        ])}
    />

    <Return value={$ctx.ports} />
</Module>
