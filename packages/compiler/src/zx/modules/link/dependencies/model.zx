import type { Rows as Constants } from "core/constant/rows"
import type { Ownership } from "core/symbol_table/model"
import type { ReadColumn, TextColumn } from "memory"
import type { Rows } from "../../../ir/canonical/validation/names/model"

export enum Status {
    Ready,
    Invalid,
    Conflict
}

export enum Kind {
    TypeOnly,
    Function,
    Enumeration
}

export type Dependency = {
    kind: Kind,
    names: string[],
    source_names: string[],
    wildcard: bool
}

export type Bindings = {
    names: TextColumn,
    namespaces: ReadColumn,
    ids: ReadColumn,
    inputs: ReadColumn,
    outputs: ReadColumn,
    intrinsics: ReadColumn,
    count: u64
}

export type Signatures = {
    files: string[],
    input_types: u32[],
    output_types: u32[],
    ownership: Ownership[]
}

export type Checks = {
    count: u64,
    functions: u32?[],
    imports: Bindings,
    linked: Signatures,
    members: Bindings,
    types: u32[]
}

export type Provider = {
    executable: bool,
    members: Bindings,
    signatures: Signatures,
    aliases: Rows,
    kinds: u8[],
    constants: Constants,
    types: u32[]
}

export type Consumer = {
    members: Bindings,
    aliases: Rows,
    constants: Constants,
    types: u32[],
    functions: u32?[]
}

export type Request = {
    dependency: Dependency,
    provider: Provider,
    consumer: Consumer,
    linked: Signatures
}

export type Item = {
    request: Request,
    local: string,
    original: string
}

export type Member = {
    request: Request,
    local: string,
    row: u64
}
