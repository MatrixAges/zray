import type { Rows as Constants } from "core/constant/rows"
import type { Ownership } from "core/symbol_table/model"
import type { ReadColumn, TextColumn } from "memory"

export enum Status {
    Ready,
    Invalid,
    Conflict
}

export enum Kind {
    TypeOnly,
    Function,
    Enumeration
}

export type Dependency = {
    kind: Kind,
    names: string[],
    source_names: string[],
    wildcard: bool
}

export type Bindings = {
    names: TextColumn,
    namespaces: ReadColumn,
    ids: ReadColumn,
    inputs: ReadColumn,
    outputs: ReadColumn,
    intrinsics: ReadColumn,
    count: u64
}

export type Signatures = {
    files: string[],
    input_types: u32[],
    output_types: u32[],
    ownership: Ownership[]
}

export type LinkedSignatures = Signatures.Omit("ownership") & {
    ownership: u8[]
}

export type SignatureColumns = {
    files: TextColumn,
    input_types: ReadColumn,
    output_types: ReadColumn,
    ownership: ReadColumn
}

export type Aliases = {
    names: TextColumn,
    ids: ReadColumn,
    count: u64
}

export type Checks = {
    count: u64,
    functions: u32?[],
    imports: Bindings,
    linked: LinkedSignatures,
    members: Bindings,
    types: u32[]
}

export type Provider = {
    executable: bool,
    members: Bindings,
    signatures: SignatureColumns,
    aliases: Aliases,
    kinds: ReadColumn,
    constants: Constants,
    types: u32[]
}

export type Consumer = {
    members: Bindings,
    aliases: Aliases,
    constants: Constants,
    types: u32[],
    functions: u32?[]
}

export type Request = {
    dependency: Dependency,
    provider: Provider,
    consumer: Consumer,
    linked: LinkedSignatures
}

export type Item = {
    request: Request,
    local: string,
    original: string
}

export type Member = {
    request: Request,
    local: string,
    row: u64
}

export type Named = {
    request: Request,
    aliased: bool,
    status: Status,
    row: u64,
    running: bool
}
