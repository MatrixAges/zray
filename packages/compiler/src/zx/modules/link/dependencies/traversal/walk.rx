<Module>
    <Type from="../model" as="Link" />
    <Type from="model" as="Traversal" />

    <Args in={Traversal.Input} out={Link.Status} />

    <Call
        module="../bindings"
        in={{
            ...$in.walk.checks,
            functions: $in.functions
        }}
    />

    <If on={$ctx.bindings != Link.Status.Ready}>
        <Return value={$ctx.bindings} />
    </If>

    <Call
        module="advance"
        in={{
            ...$in.walk,
            checks: {
                ...$in.walk.checks,
                functions: $in.functions
            }
        }}
    />

    <Return value={$ctx.advance} />
</Module>
