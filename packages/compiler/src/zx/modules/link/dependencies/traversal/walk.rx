<Module>
    <Type from="../model" as="Link" />
    <Type from="advance" as="Advance" />

    <Args
        in={{
            checks?: Link.Checks,
            edge?: Link.Request,
            walk: Advance.Input
        }}
        out={Advance.Output}
    />

    <If on={$in.checks != null}>
        <Call module="../bindings" in={$in.checks} />

        <If on={$ctx.bindings != Link.Status.Ready}>
            <Return
                value={{
                    ...$in.walk.cursor,
                    status: $ctx.bindings,
                    target: null
                }}
            />
        </If>
    </If>

    <If on={$in.edge != null}>
        <Call module="../check" in={$in.edge} />

        <If on={$ctx.check != Link.Status.Ready}>
            <Return
                value={{
                    ...$in.walk.cursor,
                    status: $ctx.check,
                    target: null
                }}
            />
        </If>
    </If>

    <Call fn="advance" in={$in.walk} />

    <Return value={$ctx.advance} />
</Module>
