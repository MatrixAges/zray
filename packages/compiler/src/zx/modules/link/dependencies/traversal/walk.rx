<Module>
    <Type from="../model" as="Link" />
    <Type from="model" as="Traversal" />

    <Args in={Traversal.Walk} out={Link.Status} />

    <Call module="../bindings" in={$in.checks} />

    <If on={$ctx.bindings != Link.Status.Ready}>
        <Return value={$ctx.bindings} />
    </If>

    <Call fn="advance" in={$in} />

    <Return value={$ctx.advance} />
</Module>
