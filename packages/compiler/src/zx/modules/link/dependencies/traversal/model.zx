import type { Lists as ConstantLists, Rows as Constants } from "core/constant/rows"
import type { ListColumn, ReadColumn, TextColumn } from "memory"
import type { Aliases, Checks, Status } from "../model"

export type Codes = {
    source: u8,
    intrinsic: u8,
    type_only: u8,
    function: u8,
    enumeration: u8
}

export type Edges = {
    targets: u64[],
    target_kinds: ReadColumn,
    kinds: ReadColumn,
    count: u64,
    codes: Codes
}

export type Imports = {
    edges: Edges,
    specifiers: TextColumn,
    names: ReadColumn,
    source_names: ReadColumn,
    exported: ReadColumn,
    wildcard: ReadColumn
}

export type MemberLists = {
    names: ListColumn,
    namespaces: ListColumn,
    ids: ListColumn,
    inputs: ListColumn,
    outputs: ListColumn,
    intrinsics: ListColumn
}

export type SignatureLists = {
    files: ListColumn,
    input_types: ListColumn,
    output_types: ListColumn,
    ownership: ListColumn
}

export type AliasLists = {
    names: ListColumn,
    ids: ListColumn
}

export type Tables = {
    members: MemberLists,
    signatures: SignatureLists,
    aliases: AliasLists,
    constants: ConstantLists,
    kinds: ListColumn,
    types: u32[][],
    functions: u32?[]
}

export type Walk = {
    checks: Checks,
    aliases: Aliases,
    constants: Constants,
    imports: Imports,
    providers?: Tables,
    native_specifiers: string[],
    intrinsic_name: string
}

export type Input = {
    walk: Walk,
    functions: u32?[]
}

export type Traversal = {
    walk: Walk,
    row: u64,
    source: u64,
    status: Status,
    running: bool
}

export type Edge = {
    target: u8,
    kind: u8
}
