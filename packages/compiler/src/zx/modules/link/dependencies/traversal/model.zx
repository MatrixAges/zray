import type { Rows as Constants } from "core/constant/rows"
import type { ReadColumn, TextColumn } from "memory"
import type { ListProjection } from "memory/columns"
import type { Aliases, Bindings, Checks, SignatureColumns } from "../model"

export type Codes = {
    source: u8,
    intrinsic: u8,
    type_only: u8,
    function: u8,
    enumeration: u8
}

export type Edges = {
    targets: u64[],
    target_kinds: ReadColumn,
    kinds: ReadColumn,
    count: u64,
    codes: Codes
}

export type Imports = {
    edges: Edges,
    specifiers: TextColumn,
    names: ReadColumn,
    source_names: ReadColumn,
    exported: ReadColumn,
    wildcard: ReadColumn
}

export type Tables = {
    projection: ListProjection,
    members: Bindings.Omit("count"),
    signatures: SignatureColumns,
    aliases: Aliases.Omit("count"),
    constants: Constants.Omit("count"),
    kinds: ReadColumn,
    types: u32[][],
    functions: u32?[]
}

export type Walk = {
    checks: Checks,
    aliases: Aliases,
    constants: Constants,
    imports: Imports,
    providers?: Tables,
    native_specifiers: string[],
    intrinsic_name: string
}
