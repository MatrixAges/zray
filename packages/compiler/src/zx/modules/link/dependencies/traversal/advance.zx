import memory from "memory"

import external from "../external"
import { Status } from "../model"
import source from "./source"

import type { Walk } from "./model"

export type Input = Walk

export type Output = Status

export default function (in: Input): Output {
    const { imports, providers } = in
    const { edges, specifiers } = imports
    const { codes } = edges

    return loop({
        row: 0,
        source: 0,
        status: Status.Ready
    }, {
        while: state => state.status == Status.Ready && state.row < edges.count,
        next: state => {
            const { row } = state
            const target = memory.readColumnU8(edges.target_kinds, row)
            const kind = memory.readColumnU8(edges.kinds, row)

            if (target == codes.source && providers != null) {
                state.status = source({
                    ...in.pick([
                        "checks",
                        "aliases",
                        "constants",
                        "imports"
                    ]),
                    row,
                    providers,
                    target: edges.targets[state.source],
                    kind
                })

                state.source += 1
            } else if (target == codes.source) {
                state.status = Status.Invalid
            } else {
                const allowed = external({
                    intrinsic: target == codes.intrinsic,
                    type_only: kind == codes.type_only,
                    specifier: memory.readTextColumn(specifiers, row),
                    intrinsic_name: in.intrinsic_name,
                    native_specifiers: in.native_specifiers
                })

                if (!allowed) {
                    state.status = Status.Invalid
                }
            }

            state.row += 1
        },
        return: state => state.status
    })
}
