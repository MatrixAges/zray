import memory from "memory"

import external from "../external"
import { Status } from "../model"

import type { TextColumn } from "memory"
import type { Cursor, Edges } from "./model"

export type Input = {
    cursor: Cursor,
    edges: Edges,
    specifiers: TextColumn,
    native_specifiers: string[],
    intrinsic_name: string
}

export type Output = Cursor & {
    status: Status,
    target?: u64
}

export default function (in: Input): Output {
    const { edges, specifiers, native_specifiers, intrinsic_name } = in
    const { codes } = edges

    const initial: Output = {
        ...in.cursor,
        status: Status.Ready,
        target: null
    }

    return loop(initial, {
        while: state => {
            const ready = state.status == Status.Ready && state.target == null

            return ready && state.row < edges.count
        },
        next: state => {
            const { row } = state
            const target = memory.readColumnU8(edges.target_kinds, row)

            if (target == codes.source) {
                state.target = edges.targets[state.source]
                state.source += 1
            } else {
                const kind = memory.readColumnU8(edges.kinds, row)

                const allowed = external({
                    intrinsic: target == codes.intrinsic,
                    type_only: kind == codes.type_only,
                    specifier: memory.readTextColumn(specifiers, row),
                    intrinsic_name,
                    native_specifiers
                })

                if (!allowed) {
                    state.status = Status.Invalid
                }
            }

            state.row += 1
        },
        return: state => state
    })
}
