import memory from "memory"
import columns from "memory/columns"

import { Kind } from "../model"

import type { Request as Output } from "../model"
import type { Tables, Walk } from "./model"

export type Input = Walk.Pick("checks", "aliases", "constants", "imports") & {
    providers: Tables,
    row: u64,
    target: u64,
    kind: u8
}

export default function (in: Input): Output {
    const { row, target, imports, providers, checks } = in
    const { codes } = imports.edges

    const kind = match in.kind {
        codes.type_only => Kind.TypeOnly,
        codes.function => Kind.Function,
        _ => Kind.Enumeration
    }

    const exported = memory.readColumnBool(imports.exported, row)
    const members = exported ? checks.members : checks.imports
    const source = providers.members
    const signatures = providers.signatures

    const { aliases, constants } = providers

    return {
        dependency: {
            kind,
            names: memory.readTextListColumn(imports.names, row),
            source_names: memory.readTextListColumn(imports.source_names, row),
            wildcard: memory.readColumnBool(imports.wildcard, row)
        },
        consumer: {
            members,
            aliases: in.aliases,
            constants: in.constants,
            types: checks.types,
            functions: checks.functions
        },
        provider: {
            executable: providers.functions[target] != null,
            members: {
                names: memory.selectListText(null, source.names, target),
                namespaces: memory.selectListColumn(source.namespaces, target),
                ids: memory.selectListColumn(source.ids, target),
                inputs: memory.selectListColumn(source.inputs, target),
                outputs: memory.selectListColumn(source.outputs, target),
                intrinsics: memory.selectListColumn(source.intrinsics, target),
                count: memory.listLength(source.ids, target)
            },
            signatures: {
                files: memory.selectListText(null, signatures.files, target),
                input_types: memory.selectListColumn(signatures.input_types, target),
                output_types: memory.selectListColumn(signatures.output_types, target),
                ownership: memory.selectListColumn(signatures.ownership, target)
            },
            aliases: {
                names: memory.selectListText(null, aliases.names, target),
                ids: memory.selectListColumn(aliases.ids, target),
                count: memory.listLength(aliases.ids, target)
            },
            kinds: memory.selectListColumn(providers.kinds, target),
            constants: {
                names: memory.selectListText(null, constants.names, target),
                types: columns.selectListValue(null, constants.types, target),
                values: columns.selectListValue(null, constants.values, target),
                count: memory.listLength(constants.names, target)
            },
            types: providers.types[target]
        },
        linked: checks.linked
    }
}
