import memory from "memory"

import { default_member } from "./const"

import type { Bindings } from "./model"

export type Input = {
    bindings: Bindings,
    include_namespaced: bool,
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    const name = in.name == default_member ? "" : in.name

    const { bindings, include_namespaced } = in

    return loop({
        row: 0,
        found: false
    }, {
        while: state => !state.found && state.row < bindings.count,
        next: state => {
            const visible =
                include_namespaced ||
                memory.readOptionalTextColumn(bindings.namespaces, state.row) == null

            state.found =
                visible && memory.readTextColumn(bindings.names, state.row) == name

            if (!state.found) {
                state.row += 1
            }
        },
        return: state => state.found ? state.row : null
    })
}
