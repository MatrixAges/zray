import type { Index } from "core/bytes/index/model"
import type { ListColumn, ReadColumn } from "memory"
import type { LinkedSignatureColumns, ListColumn as ByteList } from "memory/columns"
import type { Edges } from "../dependencies/traversal/model"
import type { Ports } from "../signature/ports"

export enum Visibility {
    Found,
    Missing,
    Invalid
}

export type Providers = {
    paths: string[],
    files: ReadColumn,
    ids: ListColumn,
    inputs: ListColumn,
    outputs: ListColumn,
    intrinsics: ByteList
}

export type Request = {
    path: string,
    key: u8[],
    ports: Ports,
    registry: Index,
    edges: Edges,
    providers: Providers,
    functions: u32?[],
    linked: LinkedSignatureColumns
}
