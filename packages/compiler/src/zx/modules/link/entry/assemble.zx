import type { ArtifactBinding, ArtifactLink } from "project_host"

export type Link = ArtifactLink

export type Input = {
    binding: ArtifactBinding,
    first: u64
}

export type Cursor = Input & {
    link: ArtifactLink
}

export type Output = {
    first: u64,
    count: u64,
    next: u64
}

export default function (in: Input): Output {
    const { binding, first } = in

    const remaining = binding.length - first
    const count = remaining < binding.capacity ? remaining : binding.capacity

    return {
        first,
        count,
        next: first + count
    }
}
