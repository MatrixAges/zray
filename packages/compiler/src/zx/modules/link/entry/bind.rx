<Module>
    <Type from="assemble" as="Binding" />

    <Args in={Binding.Cursor} out={Binding.Cursor} />

    <Call
        fn="assemble"
        in={$in.pick([
            "binding",
            "first"
        ])}
    />

    <Call
        fn="host.bindArtifactWindow"
        in={[
            $in.link,
            $ctx.assemble.first,
            $ctx.assemble.count
        ]}
    />

    <Return
        value={{
            ...$in,
            first: $ctx.assemble.next
        }}
    />
</Module>
