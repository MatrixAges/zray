import memory from "memory"

import { Status } from "../../../analysis/semantic/merging/model"

import type { Traversal as Input } from "./model"

export type Output = Input

export default function (in: Input): Output {
    const { source, position, status } = in
    const { order, scratch } = source

    if (status == Status.Ready) {
        const next = position + 1

        memory.resetArena(scratch)

        return {
            ...in,
            position: next,
            status: Status.Ready,
            running: next < order.length
        }
    }

    return {
        ...in,
        position: order.length,
        status,
        running: false
    }
}
