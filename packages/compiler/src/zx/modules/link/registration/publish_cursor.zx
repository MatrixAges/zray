import memory from "memory"

import { Status } from "../../../analysis/semantic/merging/model"
import { position_slot, status_slot, missing_origin, conflict, invalid } from "./const"

import type { Traversal as Output } from "./model"

export type Input = {
    source: Output,
    status: Status
}

export default function (in: Input): Output {
    const { source, status } = in
    const { cursor, order, scratch } = source.source

    if (status == Status.Ready) {
        const position = source.position + 1

        memory.resetArena(scratch)
        memory.writeU64(cursor, position_slot, position)

        return {
            ...source,
            position,
            running: position < order.length
        }
    }

    const code = match status {
        Status.MissingOrigin => missing_origin,
        Status.Conflict => conflict,
        _ => invalid
    }

    memory.writeU64(cursor, status_slot, code)
    memory.writeU64(cursor, position_slot, order.length)

    return {
        ...source,
        position: order.length,
        running: false
    }
}
