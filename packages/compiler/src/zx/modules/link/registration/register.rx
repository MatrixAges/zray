<Module>
    <Type from="model" as="Types" />
    <Type from="../../../analysis/semantic/merging/model" as="Merge" />

    <Args in={Types.Input} out={Merge.Status} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                source: $in,
                position: 0,
                status: Merge.Status.Ready,
                running: $in.order.length != 0
            }}
        />
    </Loop>

    <Return value={$ctx.advance.status} />
</Module>
