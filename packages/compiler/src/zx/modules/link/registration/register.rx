<Module>
    <Type from="model" as="Types" />
    <Type from="../../../analysis/semantic/merging/model" as="Merge" />

    <Args in={Types.Input} out={Merge.Status} />

    <Call fn="cursor" in={$in} />

    <Loop on={$in.running}>
        <Call module="advance" />
    </Loop>

    <Call fn="status" in={$in.cursor} />

    <Return value={$ctx.status} />
</Module>
