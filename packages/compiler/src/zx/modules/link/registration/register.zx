import integers from "std:integer"
import register from "compiler/artifact_type_register"
import memory from "memory"
import columns from "memory/columns"

import { Status } from "../../../analysis/semantic/merging/model"
import {
    position_slot,
    status_slot,
    ready,
    missing_origin,
    conflict,
    invalid
} from "./const"

import type { Input as Batch } from "./model"

export type Input = Batch

export type Output = Status

export default function (in: Input): Output {
    return loop(in, {
        while: state => memory.readU64(state.cursor, position_slot)
        < state.order.length,
        next: state => {
            const { types, origins, publication, cursor, order } = state
            const index = memory.readU64(cursor, position_slot)
            const row = order[index]

            const source =
                columns.readTypeSliceRow(types.rows, types.row_view, null, row)
            const base = columns.readTypeColumns(types.storage, types.base_view, null)

            const declared =
                columns.readNominalSliceRow(origins.rows, origins.row_view, null, row)
            const known =
                columns.readNominalColumns(origins.storage, origins.base_view, null)

            const offsets = {
                children: integers.narrow(base.children.length),
                fields: integers.narrow(base.field_types.length),
                names: integers.narrow(base.names.length)
            }

            const mapping = memory.initializeU32ListSlot(state.mappings, row, null)

            const status = register({
                preparation: {
                    request: {
                        source,
                        origins: declared,
                        base,
                        base_origins: known,
                        mapping,
                        first: 0,
                        checked: true
                    },
                    names: memory.readTextListColumn(state.names, row),
                    complete: true,
                    validation: state.limits,
                    resource: state.resource
                },
                publication: {
                    ...publication,
                    offsets
                }
            })

            if (status == Status.Ready) {
                memory.resetArena(state.scratch)
                memory.writeU64(cursor, position_slot, index + 1)
            } else {
                const code = match status {
                    Status.MissingOrigin => missing_origin,
                    Status.Conflict => conflict,
                    _ => invalid
                }

                memory.writeU64(cursor, status_slot, code)
                memory.writeU64(cursor, position_slot, order.length)
            }
        },
        return: state => match memory.readU64(state.cursor, status_slot) {
            ready => Status.Ready,
            missing_origin => Status.MissingOrigin,
            conflict => Status.Conflict,
            _ => Status.Invalid
        }
    })
}
