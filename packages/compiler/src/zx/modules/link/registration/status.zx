import memory from "memory"

import { Status } from "../../../analysis/semantic/merging/model"
import { status_slot, ready, missing_origin, conflict } from "./const"

import type { U64Buffer as Input } from "memory"

export type Output = Status

export default function (in: Input): Output {
    return match memory.readU64(in, status_slot) {
        ready => Status.Ready,
        missing_origin => Status.MissingOrigin,
        conflict => Status.Conflict,
        _ => Status.Invalid
    }
}
