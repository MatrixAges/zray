import integers from "std:integer"

import type { Append as Output } from "../../../analysis/semantic/merging/model"
import type { Base, Traversal } from "./model"

export type Input = {
    traversal: Traversal,
    base: Base
}

export default function (in: Input): Output {
    const { source: state, position } = in.traversal
    const { types: base, origins: known } = in.base
    const { modules, publication, order } = state

    const input = modules[order[position]]

    const offsets = {
        children: integers.narrow(base.children.length),
        fields: integers.narrow(base.field_types.length),
        names: integers.narrow(base.names.length)
    }

    return {
        preparation: {
            request: {
                source: input.types,
                origins: input.origins,
                base,
                base_origins: known,
                first: 0,
                source_first: 0,
                checked: true
            },
            names: input.names,
            complete: true,
            validation: state.limits
        },
        publication: {
            ...publication,
            base_labels: base.labels,
            offsets
        }
    }
}
