import integers from "std:integer"
import { nominalView, readSliceCells, typeView } from "core/column_set"
import memory from "memory"
import columns from "memory/columns"

import type { Append as Output } from "../../../analysis/semantic/merging/model"
import type { Traversal as Input } from "./model"

export default function (in: Input): Output {
    const state = in.source

    const { types, origins, publication, order } = state

    const row = order[in.position]

    readSliceCells({
        source: types.rows,
        view: types.row_view,
        layout: columns.typeColumnLayout(null, null),
        row
    })

    const source = columns.typeColumnView(types.row_view, null)

    const base = typeView({
        storage: types.storage,
        view: types.base_view
    })

    readSliceCells({
        source: origins.rows,
        view: origins.row_view,
        layout: columns.nominalColumnLayout(null, null),
        row
    })

    const declared = columns.nominalColumnView(origins.row_view, null)

    const known = nominalView({
        storage: origins.storage,
        view: origins.base_view
    })

    const offsets = {
        children: integers.narrow(base.children.length),
        fields: integers.narrow(base.field_types.length),
        names: integers.narrow(base.names.length)
    }

    const mapping = memory.initializeU32ListSlot(state.mappings, row, null)

    return {
        preparation: {
            request: {
                source,
                origins: declared,
                base,
                base_origins: known,
                mapping,
                first: 0,
                source_first: 0,
                checked: true
            },
            names: memory.readTextListColumn(state.names, row),
            complete: true,
            validation: state.limits,
            resource: state.resource
        },
        publication: {
            ...publication,
            offsets
        }
    }
}
