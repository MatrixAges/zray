import integers from "std:integer"
import columns from "memory/columns"

import type { ReadColumn } from "memory/columns"

export type Input = {
    types: ReadColumn,
    count: u64,
    prefix: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { types, count, prefix } = in

    if (prefix == 0) {
        return count == 0
    }

    return loop({
        index: 0,
        shared: true
    }, {
        while: state => state.shared && state.index < count,
        next: state => {
            const type_id = columns.readColumnU32(types, state.index)

            state.shared = integers.widen(type_id) < prefix
            state.index += 1
        },
        return: state => state.shared
    })
}
