<Module>
    <Type from="model" as="Declarations" />

    <Args in={Declarations.Input} out={void} />

    <Task name="exports" out={$ctx.prefix}>
        <Call
            fn="prefix"
            in={{
                types: $in.export_types,
                count: $in.rows.exports.length,
                prefix: $in.prefix
            }}
        />
    </Task>

    <If on={!$ctx.task.exports}>
        <Call
            module="../../../artifact/surface/own_exports"
            in={{
                source: $in.rows.exports,
                types: $in.rows.types,
                imported: false
            }}
        />
    </If>

    <Call
        fn="prefix"
        in={{
            types: $in.rows.constants.types,
            count: $in.rows.constants.count,
            prefix: $in.prefix
        }}
    />

    <If on={!$ctx.prefix}>
        <Call
            module="../../../artifact/surface/own_constants"
            in={{
                source: $in.rows.constants,
                types: $in.rows.types,
                imported: false
            }}
        />
    </If>
</Module>
