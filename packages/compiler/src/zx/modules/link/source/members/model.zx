import type { ReadColumn, TextColumn } from "memory"
import type { Mapping } from "../../../artifact/remapping/model"

export type Names = {
    names: TextColumn,
    intrinsics: ReadColumn,
    count: u64
}

export type Source = Names & {
    ids: ReadColumn,
    inputs: ReadColumn,
    outputs: ReadColumn
}

export type Row = {
    name: string,
    id?: u32,
    input_type?: u32,
    output_type?: u32,
    intrinsic?: u8,
    namespace?: string
}

export enum Anonymous {
    Entry,
    Keep,
    Skip
}

export type Input = {
    anonymous: Anonymous,
    source: Source,
    rows: Row[],
    entry?: u32,
    type_ids: u32[],
    functions: Mapping
}

export type Result = {
    rows: Row[],
    entry?: u32
}
