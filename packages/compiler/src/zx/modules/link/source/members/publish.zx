import memory from "memory"

import map from "../member"
import { Anonymous } from "./model"

import type { Input, Result } from "./model"

export type Output = Result?

export default function (in: Input): Output {
    const { source, selection, type_ids, functions } = in

    const count = selection != null ? selection.count : source.count

    return loop({
        row: 0,
        rows: in.rows,
        entry: in.entry,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const index = state.row
            const intrinsic = match {
                selection != null =>
                    memory.readListOptionalU8(
                        selection.lists.intrinsics,
                        selection.row,
                        index
                    ),
                _ => memory.readColumnOptionalU8(source.intrinsics, index)
            }

            const name = match {
                selection != null =>
                    memory.readListText(selection.lists.names, selection.row, index),
                _ => memory.readTextColumn(source.names, index)
            }
            state.row += 1

            const keep = (
                - in.anonymous != Anonymous.Skip
                - or name != ""
                - or intrinsic != null
            )

            if (keep) {
                const id = match {
                    selection != null =>
                        memory.readListOptionalU32(
                            selection.lists.ids,
                            selection.row,
                            index
                        ),
                    _ => memory.readColumnOptionalU32(source.ids, index)
                }
                const input_type = match {
                    selection != null =>
                        memory.readListOptionalU32(
                            selection.lists.inputs,
                            selection.row,
                            index
                        ),
                    _ => memory.readColumnOptionalU32(source.inputs, index)
                }
                const output_type = match {
                    selection != null =>
                        memory.readListOptionalU32(
                            selection.lists.outputs,
                            selection.row,
                            index
                        ),
                    _ => memory.readColumnOptionalU32(source.outputs, index)
                }

                const member = map({
                    name,
                    id,
                    input_type,
                    output_type,
                    intrinsic: intrinsic != null,
                    type_ids,
                    functions
                })

                if (member == null) {
                    state.valid = false
                } else if (in.anonymous == Anonymous.Entry && member.entry) {
                    state.valid = state.entry == null
                    state.entry = member.id
                } else {
                    state.rows = state.rows.push({
                        name: member.name,
                        id: member.id,
                        input_type: member.input_type,
                        output_type: member.output_type,
                        intrinsic,
                        namespace: null
                    })[0]
                }
            }
        },
        return: state => match {
            state.valid => {
                rows: state.rows,
                entry: state.entry
            },
            _ => null
        }
    })
}
