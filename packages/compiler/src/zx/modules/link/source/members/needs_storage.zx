import memory from "memory"

import type { Names as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { names, intrinsics, count } = in

    return loop({
        row: 0,
        needed: false
    }, {
        while: state => !state.needed && state.row < count,
        next: state => {
            const name = memory.readTextColumn(names, state.row)
            const intrinsic = memory.readColumnOptionalU8(intrinsics, state.row)

            state.needed = name != "" || intrinsic != null
            state.row += 1
        },
        return: state => state.needed
    })
}
