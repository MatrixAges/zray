<Module>
    <Type from="model" as="Extension" />

    <Args in={Extension.Input} out={Extension.Plan?} />

    <If on={$in.shared != null}>
        <If on={!$in.shared.same_natives}>
            <Return value={null} />
        </If>

        <If on={$in.shared.base_types == null}>
            <If on={!$in.shared.same_functions}>
                <Return value={null} />
            </If>

            <Else>
                <If on={$in.base.files.length > $in.shared.functions}>
                    <Return value={null} />
                </If>
            </Else>
        </If>
    </If>

    <If on={$in.functions.files.length < $in.base.files.length}>
        <Return value={null} />
    </If>

    <Task name="base" out={$ctx.functions}>
        <Call
            fn="../../../../ir/canonical/validation/structure/functions"
            in={{
                functions: $in.base,
                maximum_count: $in.maximum_count,
                verified: 0
            }}
        />
    </Task>

    <If on={!$ctx.task.base}>
        <Return value={null} />
    </If>

    <Task name="extended" out={$ctx.functions}>
        <Call
            fn="../../../../ir/canonical/validation/structure/functions"
            in={{
                functions: $in.functions,
                maximum_count: $in.maximum_count,
                verified: $in.base.files.length
            }}
        />
    </Task>

    <If on={!$ctx.task.extended}>
        <Return value={null} />
    </If>

    <If on={$in.suffix != null}>
        <If on={$in.functions.files.length != $in.base.files.length}>
            <Return value={null} />
        </If>

        <Task name="suffix" out={$ctx.functions}>
            <Call
                fn="../../../../ir/canonical/validation/structure/functions"
                in={{
                    functions: $in.suffix,
                    maximum_count: $in.maximum_count,
                    verified: 0
                }}
            />
        </Task>

        <If on={!$ctx.task.suffix}>
            <Return value={null} />
        </If>

        <Call
            fn="plan"
            in={{
                tail: Extension.Tail.Separate,
                base: $in.base.files.length,
                added: $in.suffix.files.length,
                shared: $in.shared
            }}
        />

        <Return value={$ctx.plan} />
    </If>

    <Call
        fn="plan"
        in={{
            tail: Extension.Tail.Embedded,
            base: $in.base.files.length,
            added: $in.functions.files.length - $in.base.files.length,
            shared: $in.shared
        }}
    />

    <Return value={$ctx.plan} />
</Module>
