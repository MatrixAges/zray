import type { Input as Declarations } from "../declarations/model"
import type { Input as Entry } from "../entry/model"
import type { Input as Initializers } from "../initializers/resolve_model"
import type { Input as Members, Result } from "../members/model"
import type { Input as Ports, Output as PublishedPorts } from "./ports"

export type Input = {
    entry: Entry,
    declarations?: Declarations,
    initializers: Initializers,
    members: Members.Omit("rows", "entry"),
    ports: Ports.Omit("linked_entry")
}

export type Output = Result & PublishedPorts & {
    initializer_prefix: u64
}
