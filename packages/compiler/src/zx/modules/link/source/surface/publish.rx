<Module>
    <Type from="model" as="Surface" />

    <Args in={Surface.Input} out={Surface.Output?} />

    <Call module="../entry/entry" in={$in.entry} />

    <If on={$ctx.entry.append}>
        <Call fn="host.appendSourceLinkEntry" in={$in.function_storage} />
    </If>

    <If on={$in.declarations != null}>
        <Call module="../declarations/publish" in={$in.declarations} />
    </If>

    <Call module="../initializers/resolve" in={$in.initializers} />

    <Call
        fn="../members/publish"
        in={{
            ...$in.members,
            rows: [],
            entry: $ctx.entry.function
        }}
    />

    <If on={$ctx.publish != null}>
        <Call
            fn="ports"
            in={{
                ...$in.ports,
                entry: $ctx.publish.entry
            }}
        />

        <Return
            value={{
                initializer_prefix: $ctx.resolve,
                ...$ctx.publish,
                ...$ctx.ports
            }}
        />
    </If>

    <Return value={null} />
</Module>
