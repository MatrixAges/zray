import integers from "std:integer"
import memory from "memory"

import remap from "../../../artifact/remapping/id"

import type { U32Buffer } from "memory"
import type { Mapping } from "../../../artifact/remapping/model"

export type Ports = {
    input_type: u32,
    output_type: u32
}

export type Input = {
    entry?: u32,
    declared: Ports,
    inputs: U32Buffer,
    outputs: U32Buffer,
    types: Mapping
}

export type Output = Ports

export default function (in: Input): Output {
    const { entry, declared, types } = in

    if (entry != null) {
        const row = integers.widen(entry)

        return {
            input_type: memory.readU32(in.inputs, row),
            output_type: memory.readU32(in.outputs, row)
        }
    }

    return {
        input_type: remap({
            id: declared.input_type,
            mapping: types
        }),
        output_type: remap({
            id: declared.output_type,
            mapping: types
        })
    }
}
