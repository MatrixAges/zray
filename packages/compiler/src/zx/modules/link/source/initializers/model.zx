import type { TextColumn, WriteColumn } from "memory"
import type { ReadColumn as WordColumn } from "memory/columns"
import type { Mapping } from "../../../artifact/remapping/model"

export type Source = {
    identity: TextColumn,
    function: WordColumn,
    schema_version: WordColumn
}

export type Target = {
    identity: WriteColumn,
    function: WriteColumn,
    schema_version: WriteColumn
}

export type Input = {
    source: Source,
    target: Target,
    functions: Mapping,
    start: u64,
    end: u64
}
