<Module>
    <Type from="resolve_model" as="Initializers" />

    <Args in={Initializers.Input} out={Initializers.Output} />

    <Call fn="../initializer_prefix" in={$in.prefix} />

    <If on={$ctx.initializer_prefix < $in.end}>
        <Call
            fn="allocate"
            in={{
                storage: $in.storage,
                shared: $in.shared,
                count: $in.end,
                prefix: $ctx.initializer_prefix
            }}
        />

        <Call
            fn="publish"
            in={{
                ...$in.omit([
                    "prefix",
                    "shared",
                    "storage"
                ]),
                start: $ctx.initializer_prefix
            }}
        />
    </If>

    <Return value={$ctx.initializer_prefix} />
</Module>
