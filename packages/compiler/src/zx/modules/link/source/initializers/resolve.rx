<Module>
    <Type from="resolve_model" as="Initializers" />

    <Args in={Initializers.Input} out={u64} />

    <Call fn="../initializer_prefix" in={$in.prefix} />

    <Loop on={$in.row < $in.end}>
        <Call
            module="next"
            in={{
                ...$in.omit(["prefix"]),
                first: $ctx.initializer_prefix,
                row: $ctx.initializer_prefix
            }}
        />
    </Loop>

    <Return value={$ctx.initializer_prefix} />
</Module>
