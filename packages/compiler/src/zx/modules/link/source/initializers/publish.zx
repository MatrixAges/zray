import bytes from "std:bytes"
import strings from "std:string"
import memory from "memory"
import columns from "memory/columns"

import remap from "../../../artifact/remapping/id"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { source, target, functions, end } = in

    const completed = loop(in.start, {
        while: row => row < end,
        next: row => {
            const identity = memory.readTextColumn(source.identity, row)
            const schema_version = columns.readColumnU32(source.schema_version, row)
            const id = columns.readColumnU32(source.function, row)
            const owned = strings.copy(identity)
            const function_id = remap({
                id,
                mapping: functions
            })

            memory.writeColumnBytes(target.identity, row, bytes.fromText(owned))
            memory.writeColumnU32(target.schema_version, row, schema_version)
            memory.writeColumnU32(target.function, row, function_id)

            row += 1
        }
    })
}
