import memory from "memory"
import columns from "memory/columns"

import remap from "../../../artifact/remapping/id"

import type { Initializer as Output } from "../../../compiled/model"
import type { Input } from "./model"

export default function (in: Input): Output {
    const { source, row, functions } = in

    return {
        identity: memory.readTextColumn(source.identity, row),
        schema_version: columns.readColumnU32(source.schema_version, row),
        function: remap({
            id: columns.readColumnU32(source.function, row),
            mapping: functions
        })
    }
}
