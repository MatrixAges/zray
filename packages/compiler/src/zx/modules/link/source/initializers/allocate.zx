import columns from "memory/columns"

import type { RowBuffer } from "memory/columns"

export type Input = {
    storage: RowBuffer,
    shared: u8[],
    count: u64,
    prefix: u64
}

export type Output = void

export default function (in: Input): Output {
    const { storage, shared, count, prefix } = in

    columns.allocateRows(storage, count)

    if (prefix != 0) {
        columns.copyRowPrefix(storage, shared, prefix)
    }
}
