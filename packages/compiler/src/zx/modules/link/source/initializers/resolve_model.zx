import type { Initializer } from "../../../compiled/model"
import type { Prefix } from "../initializer_rows"
import type { Input as Publish } from "./model"

export type Input = Publish.Omit("row") & {
    prefix?: Prefix,
    end: u64
}

export type Step = Input.Omit("prefix") & {
    first: u64,
    row: u64
}

export type Commit = Initializer & {
    first: u64,
    row: u64,
    end: u64
}
