<Module>
    <Type from="model" as="Merge" />

    <Args in={Merge.Form} out={Merge.Stage[]} />

    <Switch on={$in}>
        <Case value={Merge.Form.Program}>
            <Return
                value={[
                    Merge.Stage.ValidateProgram,
                    Merge.Stage.RegisterTypes,
                    Merge.Stage.MapFunctions,
                    Merge.Stage.BindNatives,
                    Merge.Stage.PublishFunctions
                ]}
            />
        </Case>

        <Case value={Merge.Form.AnalyzedBody}>
            <Return
                value={[
                    Merge.Stage.RegisterTypes,
                    Merge.Stage.MapFunctions,
                    Merge.Stage.PublishFunctions
                ]}
            />
        </Case>
    </Switch>
</Module>
