import type { Modules } from "core/native_module_table/model"
import type { ColumnLengths } from "memory"
import type {
    Append as TypeRegistration
} from "../../../../analysis/semantic/merging/model"
import type { Program } from "../../../../ir/canonical/validation/model"
import type {
    Input as Reservation
} from "../../../artifact/materializing/publication/reserve"
import type {
    Input as Batch,
    RootRequest
} from "../../../artifact/materializing/publication/source_model"
import type { Input as Initializer } from "../../../compiled/initializer_registry/insert"
import type { Initializer as Registered } from "../../../compiled/model"
import type { Input as RangeRequest } from "../../function_range/valid"
import type { Destination } from "../../native/publication/model"

export enum Status {
    Ready,
    InvalidIr,
    MissingOrigin,
    ConflictingType,
    ConflictingInterface,
    Exhausted,
    Invalid
}

export type Native = {
    source: Modules,
    base: Modules,
    destination: Destination
}

export type Check = {
    validation?: Program,
    types: TypeRegistration,
    range: RangeRequest,
    natives?: Native,
}

export type Commit = {
    lengths: ColumnLengths
}

export type Write = {
    batch?: Batch,
    root?: RootRequest,
    initializer?: Initializer,
    commit: Commit
}

export type Input = {
    reserve?: Reservation,
    write?: Write
}

export type Output = {
    status: Status,
    native_ids: u32?[]
}

export type Publication = {
    status: Status,
    initializer?: Registered
}
