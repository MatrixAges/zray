import { publish } from "core/column_lengths"

import type { ColumnLengths } from "memory"

export type Input = {
    lengths: ColumnLengths,
    completed: u64
}

export type Output = void

export default function (in: Input, {
    $store
}): Output {
    const { lengths, completed } = in

    if (completed != 0) {
        publish({
            target: lengths,
            count: completed
        })
    }

    $store.progress.state = {
        completed: 0
    }
}
