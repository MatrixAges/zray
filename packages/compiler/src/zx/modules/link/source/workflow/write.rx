<Module>
    <Type from="model" as="Source" />
    <Type from="../../../artifact/materializing/publication/model" as="Rows" />

    <Args in={Source.Write} out={Source.Publication} />

    <If on={$in.root != null}>
        <Call module="../../../artifact/materializing/publication/root" in={$in.root} />

        <If on={$ctx.root == Rows.PublicationStatus.Complete}>
            <If on={$in.initializer != null}>
                <Call
                    fn="../../../compiled/initializer_registry/insert"
                    in={$in.initializer}
                />

                <Call fn="settle" in={$in.commit} />

                <Return
                    value={{
                        status: Source.Status.Ready,
                        buckets: $ctx.insert
                    }}
                />
            </If>

            <Call fn="settle" in={$in.commit} />

            <Return
                value={{
                    status: Source.Status.Ready,
                    buckets: []
                }}
            />
        </If>

        <Call fn="settle" in={$in.commit} />

        <Return
            value={{
                status: Source.Status.Invalid,
                buckets: []
            }}
        />
    </If>

    <If on={$in.batch != null}>
        <Call
            module="../../../artifact/materializing/publication/source"
            in={$in.batch}
        />

        <Call fn="settle" in={$in.commit} />

        <If on={$ctx.source == Rows.PublicationStatus.Complete}>
            <Return
                value={{
                    status: Source.Status.Ready,
                    buckets: []
                }}
            />
        </If>
    </If>

    <Return
        value={{
            status: Source.Status.Invalid,
            buckets: []
        }}
    />
</Module>
