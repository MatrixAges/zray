<Module>
    <Type from="model" as="Source" />
    <Type from="../../../../analysis/semantic/merging/model" as="Types" />
    <Type from="../../native/model" as="Native" />

    <Args in={Source.Check} out={Source.Output} />

    <Store from="progress" as="progress" />

    <If on={$in.validation != null}>
        <Call module="../../../../ir/canonical/validation/validate" in={$in.validation} />

        <If on={$ctx.validate == null}>
            <Return
                value={{
                    status: Source.Status.InvalidIr,
                    native_ids: []
                }}
            />
        </If>

        <Call
            fn="set_started"
            in={true}
            setter={[$store.progress.state]}
        />
    </If>

    <Call module="../../../../analysis/semantic/merging/register" in={$in.types} />

    <Switch on={$ctx.register.status}>
        <Case value={Types.Status.MissingOrigin}>
            <Return
                value={{
                    status: Source.Status.MissingOrigin,
                    native_ids: []
                }}
            />
        </Case>

        <Case value={Types.Status.Conflict}>
            <Return
                value={{
                    status: Source.Status.ConflictingType,
                    native_ids: []
                }}
            />
        </Case>

        <Case value={Types.Status.Invalid}>
            <Return
                value={{
                    status: Source.Status.Invalid,
                    native_ids: []
                }}
            />
        </Case>
    </Switch>

    <Call fn="../../function_range/valid" in={$in.range} />

    <If on={!$ctx.valid}>
        <Return
            value={{
                status: Source.Status.Exhausted,
                native_ids: []
            }}
        />
    </If>

    <If on={$in.natives != null}>
        <Call
            module="../../native/link"
            in={{
                plan: {
                    source: $in.natives.source,
                    base: $in.natives.base,
                    types: $ctx.register.mapping
                },
                publication: {
                    source: $in.natives.source,
                    mapping: $ctx.register.mapping,
                    destination: $in.natives.destination
                }
            }}
        />

        <If on={$ctx.link.failure != null}>
            <Switch on={$ctx.link.failure}>
                <Case value={Native.Status.Conflict}>
                    <Return
                        value={{
                            status: Source.Status.ConflictingInterface,
                            native_ids: []
                        }}
                    />
                </Case>

                <Case value={Native.Status.Full}>
                    <Return
                        value={{
                            status: Source.Status.Exhausted,
                            native_ids: []
                        }}
                    />
                </Case>

                <Default>
                    <Return
                        value={{
                            status: Source.Status.Invalid,
                            native_ids: []
                        }}
                    />
                </Default>
            </Switch>
        </If>

        <Return
            value={{
                status: Source.Status.Ready,
                native_ids: $ctx.link.ids,
                registration: $ctx.register
            }}
        />
    </If>

    <Return
        value={{
            status: Source.Status.Ready,
            native_ids: [],
            registration: $ctx.register
        }}
    />
</Module>
