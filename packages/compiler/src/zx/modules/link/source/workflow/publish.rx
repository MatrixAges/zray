<Module>
    <Type from="model" as="Source" />

    <Args in={Source.Input} out={Source.Output} />

    <If on={$in.reserve != null}>
        <Call fn="../../../artifact/materializing/publication/reserve" in={$in.reserve} />
    </If>

    <If on={$in.write != null}>
        <Call module="write" in={$in.write} />

        <Return value={$ctx.write} />
    </If>

    <Return value={Source.Status.Ready} />
</Module>
