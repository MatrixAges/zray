import strings from "std:string"

import remap from "../../artifact/remapping/id"

import type { Mapping } from "../../artifact/remapping/model"
import type { Initializer } from "../../compiled/model"

export type Input = {
    source: Initializer,
    functions: Mapping,
    own_identity: bool
}

export type Output = Initializer

export default function (in: Input): Output {
    const identity = match {
        in.own_identity => strings.copy(in.source.identity),
        _ => in.source.identity
    }

    const function_id = remap({
        id: in.source.function,
        mapping: in.functions
    })

    return {
        identity,
        schema_version: in.source.schema_version,
        function: function_id
    }
}
