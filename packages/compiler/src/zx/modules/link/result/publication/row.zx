import { StoreMode } from "core/function_table/complete"
import { ColumnStoreMode } from "memory/columns"

import ownership from "../../signature/ownership"

import type { Stores } from "core/store_table/model"
import type { FunctionRow as Output } from "memory/columns"
import type { BodyColumns } from "../../signature/publication/model"
import type { Entry } from "./model"

export type Input = Entry & {
    file: string,
    stores?: Stores,
    empty: BodyColumns
}

export default function (in: Input): Output {
    const { body, ports, stores, empty, file } = in

    const mode = match ports.store_mode {
        StoreMode.transaction => ColumnStoreMode.transaction,
        _ => ColumnStoreMode.orchestration
    }

    return {
        files: file,
        input_types: ports.input_type,
        output_types: ports.output_type,
        ownership: ownership(ports.ownership),
        store_modes: mode,
        contracts: body.contracts,
        native_inputs: null,
        native_modules: null,
        native_members: [],
        native_exports: null,
        native_allocators: false,
        native_io: false,
        native_process: false,
        native_tuples: false,
        native_fallible: false,
        native_errors: null,
        native_concurrent: false,
        symbols: body.symbols,
        expressions: body.expressions,
        control: body.control ?? empty.control,
        roots: body.root,
        stores: stores ?? empty.stores
    }
}
