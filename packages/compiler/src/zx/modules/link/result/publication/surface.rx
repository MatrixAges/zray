<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Surface} out={Result.Published} />

    <Call
        module="../../../artifact/surface/own_exports"
        in={{
            source: $in.exports,
            types: $in.types,
            target: $in.export_target,
            progress: $in.export_progress
        }}
    />

    <Call
        module="../../../artifact/surface/own_constants"
        in={{
            source: $in.constants,
            types: $in.types,
            target: $in.constant_target,
            storage: $in.constant_storage
        }}
    />

    <Call fn="path" in={$in.path} />

    <If on={$in.forward != null}>
        <Call fn="forward" in={$in.forward} />

        <Call module="../../../forward_entry/build" in={$ctx.forward} />

        <Return
            value={{
                path: $ctx.path,
                wrapper: $ctx.build
            }}
        />
    </If>

    <Return
        value={{
            path: $ctx.path,
            wrapper: null
        }}
    />
</Module>
