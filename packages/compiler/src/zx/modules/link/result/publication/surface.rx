<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Surface} out={Result.Published} />

    <Call module="../../../artifact/surface/own" in={$in.surface} />

    <Call fn="../../../artifact/path" in={$in.path} />

    <If on={$in.forward != null}>
        <Call fn="forward" in={$in.forward} />

        <Call module="../../../forward_entry/build" in={$ctx.forward} />

        <Return
            value={{
                path: $ctx.path,
                wrapper: $ctx.build
            }}
        />
    </If>

    <Return
        value={{
            path: $ctx.path,
            wrapper: null
        }}
    />
</Module>
