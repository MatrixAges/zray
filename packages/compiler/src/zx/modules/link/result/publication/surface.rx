<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Surface} out={Result.Published} />

    <Call module="../../../artifact/surface/own" in={$in.surface} />

    <Call fn="../../../artifact/path" in={$in.path} />

    <If on={$in.retained != null && $in.retained.recursive != null}>
        <Call
            fn="../../../forward_entry/recursive_request"
            in={{
                symbols: $in.retained.body.symbols,
                input_type: $in.retained.ports.input_type,
                output_type: $in.retained.ports.output_type,
                function_id: $in.retained.recursive
            }}
        />

        <Call module="../../../forward_entry/build" />

        <Return
            value={{
                path: $ctx.path,
                wrapper: $ctx.build
            }}
        />
    </If>

    <Return
        value={{
            path: $ctx.path,
            wrapper: null
        }}
    />
</Module>
