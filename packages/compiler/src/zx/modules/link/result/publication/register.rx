<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Registration} out={void} />

    <Call fn="../../signature/publication/reserve" in={$in.destination} />

    <Call
        fn="row"
        in={{
            ports: $in.entry.ports,
            body: $in.entry.body,
            file: $in.file,
            stores: $in.stores,
            empty: $in.empty
        }}
    />

    <Call
        fn="append"
        in={{
            storage: $in.destination.storage,
            row: $ctx.row
        }}
    />
</Module>
