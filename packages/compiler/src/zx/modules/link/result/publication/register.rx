<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Registration} out={void} />

    <Call module="../../signature/publication/reserve_columns" in={$in.destination} />

    <Call
        fn="row"
        in={{
            ports: $in.entry.ports,
            body: $in.entry.body,
            file: $in.file,
            stores: $in.stores,
            empty: $in.empty
        }}
    />

    <Call
        fn="../../../../../core/function_table/publication/publish"
        in={{
            storage: $in.destination.storage,
            body: $ctx.row,
            native: null
        }}
    />
</Module>
