<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={Result.Output?} />

    <If on={$in.registration != null}>
        <Call module="register" in={$in.registration} />
    </If>

    <Call
        module="../../../artifact/materializing/stores/remap"
        in={{
            source: $in.store_source,
            mapping: $in.surface.types
        }}
    />

    <If on={$ctx.remap != null}>
        <Call
            module="surface"
            in={$in.pick([
                "surface",
                "path",
                "forward"
            ])}
        />

        <Call
            module="entry"
            in={{
                entry: $in.entry,
                wrapper: $ctx.surface.wrapper
            }}
        />

        <Return
            value={{
                ...$ctx.entry,
                path: $ctx.surface.path,
                stores: $ctx.remap
            }}
        />
    </If>

    <Return value={null} />
</Module>
