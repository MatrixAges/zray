<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={Result.Output?} />

    <Call
        module="../../../artifact/materializing/stores/remap"
        in={{
            source: $in.store_source,
            mapping: $in.surface.types
        }}
    />

    <If on={$ctx.remap != null}>
        <Call module="surface" in={$in.omit(["store_source"])} />

        <Return
            value={{
                ...$ctx.surface,
                stores: $ctx.remap
            }}
        />
    </If>

    <Return value={null} />
</Module>
