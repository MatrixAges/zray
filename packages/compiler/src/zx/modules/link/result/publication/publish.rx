<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={Result.Output?} />

    <If on={$in.retained != null && $in.retained.recursive != null}>
        <Call
            module="register"
            in={{
                destination: $in.destination,
                entry: $in.retained.pick([
                    "ports",
                    "body"
                ]),
                file: $in.retained.file,
                stores: $in.retained.stores,
                empty: $in.empty
            }}
        />
    </If>

    <Call
        module="../../../artifact/materializing/stores/remap"
        in={{
            source: $in.store_source,
            mapping: $in.surface.types
        }}
    />

    <If on={$ctx.remap != null}>
        <Call
            module="surface"
            in={$in.pick([
                "surface",
                "path",
                "retained"
            ])}
        />

        <Call
            module="entry"
            in={{
                entry: $in.retained,
                wrapper: $ctx.surface.wrapper
            }}
        />

        <Call
            module="../../../artifact/validation/verify"
            in={{
                ...$in.verification,
                program: {
                    ...$ctx.entry,
                    stores: $ctx.remap
                },
                empty: $in.empty
            }}
        />

        <Return
            value={{
                ...$ctx.entry,
                path: $ctx.surface.path,
                stores: $ctx.remap,
                valid: $ctx.verify != null
            }}
        />
    </If>

    <Return value={null} />
</Module>
