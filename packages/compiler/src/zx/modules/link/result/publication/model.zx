import type { Stores } from "core/store_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Input as ArtifactSurface } from "../../../artifact/surface/model"
import type { Output as Wrapper } from "../../../forward_entry/model"

export type Forward = {
    symbols: Symbols,
    input_type: u32,
    output_type: u32,
    function_id: u32
}

export type Surface = {
    surface: ArtifactSurface,
    path: string,
    forward?: Forward
}

export type Input = Surface & {
    store_source: Stores
}

export type Published = {
    path: string,
    wrapper?: Wrapper
}

export type Output = Published & {
    stores: Stores
}
