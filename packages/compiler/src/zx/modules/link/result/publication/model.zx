import type { Stores } from "core/store_table/model"
import type { Input as ArtifactSurface } from "../../../artifact/surface/model"
import type { Body, Program, Unit } from "../../../artifact/validation/body"
import type { Request as Verification } from "../../../artifact/validation/context"
import type { Output as Wrapper } from "../../../forward_entry/model"
import type { BodyColumns, Destination } from "../../signature/publication/model"

export type Registration = {
    destination: Destination,
    entry: Entry,
    file: string,
    stores?: Stores,
    empty: BodyColumns
}

export type Entry = Unit.Omit("body") & {
    body: Body
}

export type Retained = Entry & {
    file: string,
    recursive?: u32,
    stores?: Stores
}

export type Surface = {
    surface: ArtifactSurface,
    path: string,
    retained?: Retained
}

export type Input = Surface & {
    store_source: Stores,
    destination: Destination,
    empty: BodyColumns,
    verification: Verification
}

export type Published = {
    path: string,
    wrapper?: Wrapper
}

export type Selection = {
    entry?: Retained,
    wrapper?: Wrapper
}

export type Output = Program & {
    path: string,
    valid: bool
}
