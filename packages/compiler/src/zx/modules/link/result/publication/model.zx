import type { Contracts } from "core/contract_table/model"
import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { StoreMode } from "core/function_table/complete"
import type { Stores } from "core/store_table/model"
import type { Ownership, Symbols } from "core/symbol_table/model"
import type { Input as ArtifactSurface } from "../../../artifact/surface/model"
import type { Output as Wrapper } from "../../../forward_entry/model"
import type { BodyColumns, Destination } from "../../signature/publication/model"

export type Registration = {
    destination: Destination,
    entry: Entry,
    file: string,
    stores?: Stores,
    empty: BodyColumns
}

export type Ports = {
    input_type: u32,
    output_type: u32,
    ownership: Ownership,
    store_mode: StoreMode
}

export type Body = {
    symbols: Symbols,
    expressions: Expressions,
    control?: Control,
    root?: u32,
    contracts: Contracts
}

export type Entry = {
    ports: Ports,
    body: Body
}

export type Retained = Entry & {
    file: string,
    recursive?: u32,
    stores?: Stores
}

export type Surface = {
    surface: ArtifactSurface,
    path: string,
    retained?: Retained
}

export type Input = Surface & {
    store_source: Stores,
    destination: Destination,
    empty: BodyColumns
}

export type Published = {
    path: string,
    wrapper?: Wrapper
}

export type Selection = {
    entry?: Retained,
    wrapper?: Wrapper
}

export type Unit = {
    ports: Ports,
    body?: Body
}

export type Output = Unit & {
    path: string,
    stores: Stores
}
