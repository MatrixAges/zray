import integers from "std:integer"
import memory from "memory"

import type { ReadColumn } from "memory"

export type Input = {
    marks: ReadColumn,
    first: u64,
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { marks, first, count } = in

    return loop({
        row: 0,
        retained: 0
    }, {
        while: state => state.row < count,
        next: state => {
            if (memory.readColumnBool(marks, first + state.row)) {
                state.retained =
                    integers.orBits(state.retained, integers.bitMask(state.row))
            }

            state.row += 1
        },
        return: state => state.retained
    })
}
