import classify from "../cache_retention/classify"

export enum Action {
    Discard,
    Keep,
    Queue
}

export type Input = {
    keeps_replaced: bool,
    transactional: bool,
    mark: u64,
    published: u64
}

export type Output = {
    action: Action,
    keep_on_publish: bool,
    keep_on_abort: bool
}

export default function (in: Input): Output {
    if (!in.keeps_replaced) {
        return {
            action: Action.Discard,
            keep_on_publish: false,
            keep_on_abort: false
        }
    }

    if (!in.transactional) {
        return {
            action: Action.Keep,
            keep_on_publish: false,
            keep_on_abort: false
        }
    }

    const retention = classify({
        mark: in.mark,
        published: in.published
    })

    return {
        action: Action.Queue,
        keep_on_publish: retention.keep_on_publish,
        keep_on_abort: retention.keep_on_abort
    }
}
