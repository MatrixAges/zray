import host from "project_host"

import type { ParseAdoption, ParseCacheEntry } from "project_host"

export type Input = {
    adoption: ParseAdoption,
    existing?: ParseCacheEntry,
    candidate: ParseCacheEntry
}

export type Output = ParseCacheEntry?

export default function (in: Input): Output {
    const { adoption, existing, candidate } = in

    if (existing == null) {
        return host.insertParseEntry(adoption, candidate)
    }

    return host.replaceParseEntry(adoption, existing, candidate) ? existing : null
}
