<Module>
    <Type from="model" as="Staging" />

    <Args in={Staging.Publication} out={u64?} />

    <Call fn="commit" in={$in} />

    <If on={$ctx.commit != null}>
        <Return value={$ctx.commit} />
    </If>

    <If on={$in.worker_failed}>
        <Return value={$in.results.length} />
    </If>

    <Return value={null} />
</Module>
