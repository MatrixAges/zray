import memory from "memory"
import host from "project_host"

import adopt from "../adopt"

import type { Publication as Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const { batch, paths, results, has_output } = in

    return loop({
        row: 0,
        failed: false
    }, {
        while: state => !state.failed && state.row < results.length,
        next: state => {
            const row = state.row
            const candidate = results[row]

            if (candidate != null) {
                const path = memory.readTextColumn(paths, row)
                const adoption = host.preparePrefetchedParse(batch, path)
                const stored = adopt({
                    adoption,
                    candidate
                })

                if (stored == null) {
                    state.failed = true
                } else if (has_output) {
                    host.bindPrefetchedParse(batch, row, stored)
                }
            }

            if (!state.failed) {
                state.row += 1
            }
        },
        return: state => state.failed ? state.row : null
    })
}
