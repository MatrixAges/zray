export type Input = bool[]

export type Output = u64[]

export default function (in: Input): Output {
    const rows: u64[] = []

    return loop({
        row: 0,
        rows
    }, {
        while: state => state.row < in.length,
        next: state => {
            if (in[state.row]) {
                state.rows = state.rows.push(state.row)[0]
            }

            state.row += 1
        },
        return: state => state.rows
    })
}
