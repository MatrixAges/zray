import memory from "memory"
import host from "project_host"

import type { Dispatch as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { worker, sources, hits, digests, range, has_output } = in

    return loop({
        row: 0,
        success: true
    }, {
        while: state => state.success && state.row < range.count,
        next: state => {
            const row = state.row
            const index = range.first + row
            const hit = hits[row]

            if (hit == 0) {
                state.success = host.stageParseWorkerResult(
                    worker,
                    index,
                    memory.readTextColumn(sources.texts, index),
                    memory.readTextColumn(sources.paths, index),
                    digests[row]
                )
            } else if (has_output) {
                host.bindParseWorkerHit(worker, index, hit - 1)
            }

            state.row += 1
        },
        return: state => state.success
    })
}
