import memory from "memory"

import type { Dispatch as Input, Work } from "./model"

export type Output = Work[]

export default function (in: Input): Output {
    const { sources, hits, digests, range, has_output } = in

    const pending: Work[] = []

    return loop({
        row: 0,
        pending
    }, {
        while: state => state.row < range.count,
        next: state => {
            const offset = state.row
            const row = range.first + offset
            const hit = hits[offset]

            if (hit == 0) {
                const work: Work = {
                    row,
                    miss: {
                        source: memory.readTextColumn(sources.texts, row),
                        path: memory.readTextColumn(sources.paths, row),
                        digest: digests[offset]
                    }
                }

                state.pending = state.pending.push(work)[0]
            } else if (has_output) {
                const work: Work = {
                    row,
                    hit: hit - 1
                }

                state.pending = state.pending.push(work)[0]
            }

            state.row += 1
        },
        return: state => state.pending
    })
}
