import memory from "memory"
import host from "project_host"

import classify from "./classify"
import dispatch from "./dispatch"

import type { Walk as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { worker, cache, sources, buffers, count } = in

    const fair_share = count / in.participants

    const width = match {
        fair_share == 0 => 1,
        fair_share > buffers.hit_rows.length => buffers.hit_rows.length,
        _ => fair_share
    }

    const completed = loop(true, {
        while: running => running && !host.parseWorkerFailed(worker),
        next: running => {
            const first = memory.fetchAddIndexRelaxed(in.cursor, width)

            if (first >= count) {
                running = false
            } else {
                const remaining = count - first
                const range = {
                    first,
                    count: remaining < width ? remaining : width
                }

                classify({
                    cache,
                    sources,
                    buffers,
                    range
                })

                running = dispatch({
                    worker,
                    sources,
                    buffers,
                    range,
                    has_output: in.has_output
                })

                if (!running) {
                    host.failParseWorker(worker)
                }
            }
        }
    })
}
