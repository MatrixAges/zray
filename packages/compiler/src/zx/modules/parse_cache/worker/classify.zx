import bytes from "std:bytes"
import crypto from "std:crypto"
import slot from "core/bytes/index/slot"
import memory from "memory"
import columns from "memory/columns"

import type { Classification as Input, ClassificationResult } from "./model"

export type Output = ClassificationResult

export default function (in: Input): Output {
    const { cache, sources, range } = in

    const empty_hits: u64[] = []
    const empty_digests: u8[][] = []

    return loop({
        row: 0,
        hits: empty_hits,
        digests: empty_digests
    }, {
        while: state => state.row < range.count,
        next: state => {
            const index = range.first + state.row
            const source = bytes.fromText(
                memory.readTextColumn(sources.texts, index)
            )

            const entry = match {
                cache.capacity == 0 => 0,
                _ => slot({
                    ...cache.pick([
                        "keys",
                        "buckets",
                        "capacity"
                    ]),
                    key: bytes.fromText(
                        memory.readTextColumn(
                            sources.paths,
                            index
                        )
                    )
                }).entry
            }

            const text = match entry {
                0 => null,
                _ => columns.readReferencedOptionalBytes(cache.texts, entry - 1)
            }

            if (text != null && bytes.equals(text, source)) {
                const empty: u8[] = []

                state.hits = state.hits.push(entry)[0]
                state.digests = state.digests.push(empty)[0]
            } else {
                const digest = crypto.sha256(source)

                const matching = match entry {
                    0 => false,
                    _ => bytes.equals(
                        columns.readReferencedBytes(
                            cache.digests,
                            entry - 1
                        ),
                        digest
                    )
                }

                state.hits = state.hits.push(matching ? entry : 0)[0]
                state.digests = state.digests.push(digest)[0]
            }

            state.row += 1
        },
        return: state => ({
            hits: state.hits,
            digests: state.digests
        })
    })
}
