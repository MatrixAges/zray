<Module>
    <Type from="model" as="Worker" />

    <Args in={Worker.Batch} out={bool} />

    <Store from="pending" as="pending" />

    <Call
        fn="classify"
        in={$in.pick([
            "cache",
            "sources",
            "range"
        ])}
    />

    <Call
        fn="dispatch"
        in={{
            ...$in.pick([
                "sources",
                "range",
                "has_output"
            ]),
            hits: $ctx.classify.hits,
            digests: $ctx.classify.digests
        }}
    />

    <If on={$ctx.dispatch.length != 0}>
        <Call fn="stage" in={$ctx.dispatch} setter={[$store.pending.state]} />
    </If>

    <Return value={true} />
</Module>
