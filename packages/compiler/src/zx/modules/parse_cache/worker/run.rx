<Module>
    <Type from="model" as="Worker" />

    <Args in={Worker.Batch} out={bool} />

    <Call
        fn="classify"
        in={$in.pick([
            "cache",
            "sources",
            "range"
        ])}
    />

    <Call
        fn="dispatch"
        in={{
            ...$in.pick([
                "worker",
                "sources",
                "range",
                "has_output"
            ]),
            hits: $ctx.classify.hits,
            digests: $ctx.classify.digests
        }}
    />

    <Return value={$ctx.dispatch} />
</Module>
