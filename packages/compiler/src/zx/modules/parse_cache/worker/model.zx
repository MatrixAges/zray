import type { Lookup as Slot } from "core/bytes/index/slot"
import type { TextColumn } from "memory"
import type { ReferenceColumn } from "memory/columns"

export type Cache = Slot.Omit("key") & {
    texts: ReferenceColumn,
    digests: ReferenceColumn
}

export type Sources = {
    paths: TextColumn,
    texts: TextColumn
}

export type ClassificationResult = {
    hits: u64[],
    digests: u8[][]
}

export type Batch = {
    cache: Cache,
    sources: Sources,
    range: Range,
    has_output: bool
}

export type Range = {
    first: u64,
    count: u64
}

export type Classification = {
    cache: Cache,
    sources: Sources,
    range: Range
}

export type Dispatch = ClassificationResult & {
    sources: Sources,
    range: Range,
    has_output: bool
}

export type Miss = {
    source: string,
    path: string,
    digest: u8[]
}

export type Work = {
    row: u64,
    hit?: u64,
    miss?: Miss
}
