import type { Lookup as Slot } from "core/bytes/index/slot"
import type { TextColumn } from "memory"
import type { ReferenceColumn } from "memory/columns"
import type { ParseWorker } from "project_host"

export type Cache = Slot.Omit("key") & {
    texts: ReferenceColumn,
    digests: ReferenceColumn
}

export type Sources = {
    paths: TextColumn,
    texts: TextColumn
}

export type ClassificationResult = {
    hits: u64[],
    digests: u8[][]
}

export type Batch = {
    worker: ParseWorker,
    cache: Cache,
    sources: Sources,
    range: Range,
    has_output: bool
}

export type Range = {
    first: u64,
    count: u64
}

export type Classification = {
    cache: Cache,
    sources: Sources,
    range: Range
}

export type Dispatch = ClassificationResult & {
    worker: ParseWorker,
    sources: Sources,
    range: Range,
    has_output: bool
}
