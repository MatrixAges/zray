<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Probe} out={Cache.Result} />

    <Call fn="content" in={$in.omit(["format"])} />

    <If on={$ctx.content == null}>
        <Call fn="reuse" in={$in.format} />

        <Return
            value={{
                action: $ctx.reuse,
                digest: null
            }}
        />
    </If>

    <Return
        value={{
            action: Cache.Action.Parse,
            digest: $ctx.content
        }}
    />
</Module>
