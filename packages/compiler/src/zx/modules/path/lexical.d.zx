export type PathAllocator = opaque

export declare function pathParent(value: string): string? concurrent

export declare function pathBasename(value: string): string concurrent

export declare function resolvePathParts(
    allocator,
    parts: string[]
): string throws { OutOfMemory } concurrent

export declare function resolvePathFrom(
    allocator,
    root: string,
    path: string
): string throws { OutOfMemory } concurrent

export declare function resolveOwnedPathParts(
    resource: PathAllocator,
    parts: string[]
): string throws { OutOfMemory }

export declare function resolvePortablePath(
    allocator,
    base: string,
    directory: string,
    path: string
): string throws { OutOfMemory } concurrent

export declare function resolvePathSuffix(
    allocator,
    base: string,
    spelling: string,
    suffix: string
): string throws { OutOfMemory } concurrent

export declare function resolvePathJoined(
    allocator,
    base: string,
    directory: string,
    leaf: string,
    prefix: u64
): string throws { OutOfMemory, WriteFailed } concurrent
