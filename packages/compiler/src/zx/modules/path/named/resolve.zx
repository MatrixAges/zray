import encoding from "std:encoding"
import strings from "std:string"
import memory from "memory"

import select from "../alias/select"
import { module_extension } from "../const"

import type { Input as Lookup } from "../alias/model"

export type Input = Lookup & {
    member_width: u64
}

export type Output = {
    row?: u64,
    named: bool,
    owned?: string
}

export default function (in: Input): Output {
    const { path, index, release } = in

    const full = select(in.pick([
        "path",
        "index",
        "release"
    ]))

    if (full.row != null) {
        return {
            row: full.row,
            named: false,
            owned: full.fallback
        }
    }

    const end = path.length - module_extension.length - in.member_width - 1

    const owner = strings.join("", [
        encoding.sliceBytes(path, 0, end),
        module_extension
    ])

    const selected = select({
        path: owner,
        index,
        release
    })

    const indexed = selected.fallback

    if (indexed != null) {
        memory.freeOwnedText(release, owner)

        return {
            row: selected.row,
            named: true,
            owned: indexed
        }
    }

    return {
        row: selected.row,
        named: true,
        owned: owner
    }
}
