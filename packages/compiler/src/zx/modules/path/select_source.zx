import alias from "./alias/select"
import named from "./named/resolve"

import type { Input as Lookup } from "./alias/model"

export type Input = Lookup & {
    member_width?: u64
}

export type Output = {
    row?: u64,
    named: bool,
    owned?: string
}

export default function (in: Input): Output {
    const { member_width } = in

    if (member_width != null) {
        return named({
            path: in.path,
            index: in.index,
            release: in.release,
            member_width
        })
    }

    const selected = alias(in.pick([
        "path",
        "index",
        "release"
    ]))

    return {
        row: selected.row,
        named: false,
        owned: selected.fallback
    }
}
