import bytes from "std:bytes"
import encoding from "std:encoding"

import { directory_separator } from "../const"

export type Input = string

export type Output = string?

export default function (in: Input): Output {
    const source = bytes.fromText(in)

    const end = loop(source.length, {
        while: index =>
            index != 0 && bytes.startsWithText(source, index - 1, directory_separator),
        next: index => {
            index -= 1
        }
    })

    const start = loop(end, {
        while: index =>
            index != 0 && !bytes.startsWithText(source, index - 1, directory_separator),
        next: index => {
            index -= 1
        }
    })

    if (start == 0) {
        return null
    }

    const parent_end = loop(start, {
        while: index =>
            index > 1 && bytes.startsWithText(source, index - 1, directory_separator),
        next: index => {
            index -= 1
        }
    })

    return encoding.sliceBytes(in, 0, parent_end)
}
