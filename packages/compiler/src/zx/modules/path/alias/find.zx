import bytes from "std:bytes"
import probe from "core/bytes/index/slot"

import type { Table } from "core/bytes/index/slot"

export type Input = {
    path: string,
    index: Table
}

export type Output = u64?

export default function (in: Input): Output {
    if (in.index.capacity == 0) {
        return null
    }

    const found = probe({
        ...in.index,
        key: bytes.fromText(in.path)
    })

    return found.entry == 0 ? null : found.entry - 1
}
