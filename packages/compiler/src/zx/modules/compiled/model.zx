import type { Rows } from "core/constant/rows"
import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/type_table/model"
import type { Bindings } from "core/type_table/nominal"
import type { ListColumn, ReadColumn, TextColumn, U32Buffer, U64Buffer } from "memory"
import type { ListColumn as ByteList, ListProjection } from "memory/columns"
import type { Program } from "../../ir/canonical/validation/model"
import type { Mapping as FunctionMapping } from "./loading/functions/model"
import type { Status } from "./status"

export type Exports = {
    count: u64,
    names: TextColumn,
    paths: TextColumn,
    functions: ReadColumn,
    type_names: ListColumn,
    type_ids: ListColumn,
    constants: Constants,
    members: Members
}

export type Constants = {
    names: ListColumn,
    projection: ListProjection,
    rows: Rows.Omit("count")
}

export type Members = {
    names: ListColumn,
    namespaces: ListColumn,
    ids: ListColumn,
    inputs: ListColumn,
    outputs: ListColumn,
    intrinsics: ByteList
}

export type Initializers = {
    count: u64,
    identities: TextColumn,
    versions: ReadColumn,
    functions: ReadColumn
}

export type Initializer = {
    identity: string,
    schema_version: u32,
    function: u32
}

export type Selection = {
    names: TextColumn,
    modules: TextColumn,
    count: u64
}

export type Graph = {
    program: Program,
    origins: Bindings,
    origin_names: string[],
    exports: Exports,
    initializers: Initializers
}

export type Destination = {
    types: Table,
    origins: Bindings,
    origin_names: string[],
    natives: Modules,
    function_count: u64
}

export type Validation = {
    graph: Graph,
    export_index?: U64Buffer
}

export type Input = Validation & {
    instance: string,
    artifact: string,
    seed: bool,
    destination: Destination,
    type_mapping: U32Buffer,
    selection?: Selection
}

export type Result = {
    status: Status,
    types: Table,
    origins: Bindings,
    natives: Modules,
    functions: FunctionMapping,
    selection?: SelectionPlan
}

export type SelectionPlan = {
    rows: u64[],
    names: TextColumn,
    aliases: u64[],
    first: u64[]
}
