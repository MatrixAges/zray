import memory from "memory"

import { Status } from "../../status"
import lookup from "./lookup"

import type { U64Buffer } from "memory"
import type { Exports, Selection, SelectionPlan } from "../../model"

export type Input = {
    source: Exports,
    export_index?: U64Buffer,
    selection?: Selection
}

export type Output = {
    status: Status,
    selection?: SelectionPlan
}

export default function (in: Input): Output {
    const { source, selection } = in

    if (selection == null) {
        return {
            status: Status.Ready,
            selection: null
        }
    }

    const rows: u64[] = []

    const result = loop({
        index: 0,
        rows,
        aliases: rows,
        first: rows,
        found: true
    }, {
        while: current =>
            current.found && current.index < selection.count,
        next: current => {
            const module = memory.readTextColumn(selection.modules, current.index)
            const row = lookup({
                source,
                index: in.export_index,
                name: module
            })

            if (row != null) {
                const selected_rows = current.rows
                const selected = loop({
                    index: 0
                }, {
                    while: item =>
                        item.index < selected_rows.length &&
                        selected_rows[item.index] != row,
                    next: item => {
                        item.index += 1
                    },
                    return: item => item.index
                })

                if (selected == selected_rows.length) {
                    current.rows = current.rows.push(row)[0]
                    current.first = current.first.push(current.index)[0]
                }

                current.aliases = current.aliases.push(selected)[0]
            } else {
                current.found = false
            }

            current.index += 1
        }
    })

    return {
        status: result.found ? Status.Ready : Status.MissingPublicModule,
        selection: {
            rows: result.rows,
            names: selection.names,
            aliases: result.aliases,
            first: result.first
        }
    }
}
