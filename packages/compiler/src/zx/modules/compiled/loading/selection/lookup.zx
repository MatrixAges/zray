import select from "../../../project/target/select"
import slot from "../../validation/exports/index_slot"

import type { Exports } from "../../model"

export type Input = {
    source: Exports,
    index: u64[],
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    const { source, index, name } = in

    if (index.length != 0) {
        const found = slot({
            buckets: index,
            names: source.names,
            name
        })

        return found.entry == 0 ? null : found.entry - 1
    }

    return select({
        specifiers: {
            items: source.names,
            length: source.count
        },
        name,
        check_duplicates: false
    }).first
}
