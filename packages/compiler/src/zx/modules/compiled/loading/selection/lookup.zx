import memory from "memory"

import select from "../../../project/target/select"
import find from "../../imports/find"

import type { U64Buffer } from "memory"
import type { Exports } from "../../model"

export type Input = {
    source: Exports,
    index?: U64Buffer,
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    const { source, index, name } = in

    const capacity = index == null ? 0 : memory.u64Views(index).length

    if (index != null && capacity != 0) {
        return find({
            buckets: memory.u64View(index, null),
            capacity,
            names: source.names,
            count: source.count,
            name
        })
    }

    return select({
        specifiers: {
            items: source.names,
            length: source.count
        },
        name,
        check_duplicates: false
    }).first
}
