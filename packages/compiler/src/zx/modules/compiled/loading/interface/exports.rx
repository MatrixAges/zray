<Module>
    <Type from="publication" as="Publication" />
    <Type from="model" as="Interface" />

    <Args in={Interface.ExportRequest} out={void} />

    <Store from="rows" as="rows" />

    <Call fn="export_layout" in={$in} />

    <Call
        fn="stage"
        in={{
            kind: Publication.Kind.AllocateExports,
            row: 0,
            text: "",
            count: $ctx.export_layout.count
        }}
        setter={[$store.rows.pending]}
    />

    <Loop on={$in.running}>
        <Call module="next_export" in={$ctx.export_layout} />
    </Loop>
</Module>
