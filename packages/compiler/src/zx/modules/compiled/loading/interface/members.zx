import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import { Kind } from "./publication"

import type { MemberStep, Pending as Output } from "./publication"

export type Input = MemberStep.Omit("count")

export default function (in: Input): Output {
    const { source, row, index, first, mapping } = in

    const id = memory.readListOptionalU32(source.ids, row, index)
    const input = memory.readListOptionalU32(source.inputs, row, index)
    const output = memory.readListOptionalU32(source.outputs, row, index)

    return {
        kind: Kind.Member,
        row: index,
        text: memory.readListText(source.names, row, index),
        id: match {
            id == null => null,
            _ => integers.narrow(first + integers.widen(id))
        },
        input: input == null ? null : mapping[integers.widen(input)],
        output: output == null ? null : mapping[integers.widen(output)],
        intrinsic: columns.readListOptionalU8(source.intrinsics, row, index)
    }
}
