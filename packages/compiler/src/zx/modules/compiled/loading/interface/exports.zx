import bytes from "std:bytes"
import strings from "std:string"
import writeRow from "compiler/compiled_interface_row"
import memory from "memory"
import columns from "memory/columns"

import type { ExportRequest as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { exports, selection, buffers, targets } = in

    const count = selection == null ? exports.count : selection.aliases.length
    const names = selection == null ? exports.names : selection.names
    const common = in.omit(["selection"])

    columns.allocateRows(buffers.exports, count)

    const published = loop(0, {
        while: output => output < count,
        next: output => {
            const selected = selection == null ? output : selection.aliases[output]
            const first = selection == null ? output : selection.first[selected]

            if (first == output) {
                const row = selection == null ? output : selection.rows[selected]

                writeRow({
                    ...common,
                    row,
                    output
                })
            } else {
                columns.copyRow(buffers.exports, first, output)
            }

            const name = strings.copy(memory.readTextColumn(names, output))

            memory.writeColumnBytes(
                targets.exports.names,
                output,
                bytes.fromText(name)
            )

            output += 1
        }
    })
}
