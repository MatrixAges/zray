<Module>
    <Type from="model" as="Interface" />

    <Args in={Interface.Row} out={void} />

    <Store from="rows" as="rows" />

    <Call
        fn="write_header"
        in={$in.pick([
            "exports",
            "first",
            "instance",
            "row",
            "output"
        ])}
    />

    <Call fn="stage" setter={[$store.rows.pending]} />

    <Call
        module="type_rows"
        in={{
            ...$in.pick([
                "row",
                "mapping"
            ]),
            output: $ctx.stage,
            names: $in.exports.type_names,
            ids: $in.exports.type_ids,
            column: $in.targets.exports.types,
            buffer: $in.buffers.types
        }}
    />

    <Call
        module="member_rows"
        in={{
            ...$in.pick([
                "row",
                "mapping",
                "first"
            ]),
            output: $ctx.stage,
            source: $in.exports.members,
            column: $in.targets.exports.members,
            buffer: $in.buffers.members
        }}
    />

    <Call
        module="constant_rows"
        in={{
            ...$in.pick([
                "row",
                "mapping"
            ]),
            output: $ctx.stage,
            source: $in.exports.constants
        }}
    />
</Module>
