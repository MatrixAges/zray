import bytes from "std:bytes"
import strings from "std:string"
import memory from "memory"

import type { Traversal as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const name = strings.copy(memory.readTextColumn(in.names, in.output))

    memory.writeColumnBytes(
        in.source.targets.exports.names,
        in.output,
        bytes.fromText(name)
    )
}
