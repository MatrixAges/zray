import type { TextColumn } from "memory"
import type { Exports, Initializers, SelectionPlan } from "../../model"

export type Request = {
    exports: Exports,
    initializers: Initializers,
    selection?: SelectionPlan,
    mapping: u32[],
    first: u64,
    instance: string
}

export type ExportRequest = Request.Omit("initializers")

export type Row = ExportRequest.Omit("selection") & {
    row: u64,
    output: u64
}

export type Traversal = {
    source: ExportRequest,
    count: u64,
    names: TextColumn,
    output: u64,
    running: bool
}

export type ExportRow = {
    row: u64,
    first: u64
}
