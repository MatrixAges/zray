import memory from "memory"
import columns from "memory/columns"

import { Kind } from "../../../artifact/remapping/model"
import publish from "../../../artifact/surface/constants"

import type { RowBuffer, WriteColumn } from "memory/columns"
import type { Target } from "../../../artifact/surface/constants"
import type { Constants } from "../../model"

export type Input = {
    source: Constants,
    row: u64,
    output: u64,
    mapping: u32[],
    column: WriteColumn,
    buffer: RowBuffer,
    target: Target
}

export type Output = void

export default function (in: Input): Output {
    const { source } = in

    const count = memory.listLength(source.names, in.row)

    columns.allocateRowList(in.column, in.output, in.buffer, count)

    if (count == 0) {
        return
    }

    columns.projectListColumns(source.projection, in.row)

    publish({
        source: {
            ...source.rows,
            count
        },
        target: in.target,
        types: {
            kind: Kind.Dense,
            dense: in.mapping,
            sparse: [],
            planned: [],
            first: 0,
            prefix: 0,
            count: in.mapping.length
        }
    })
}
