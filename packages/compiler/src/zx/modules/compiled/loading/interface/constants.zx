import { Kind as MappingKind } from "../../../artifact/remapping/model"
import publish from "../../../artifact/surface/constants"
import { Kind } from "./publication"

import type { Rows } from "core/constant/rows"
import type { Pending as Output } from "./publication"

export type Input = {
    source: Rows,
    output: u64,
    mapping: u32[]
}

export default function (in: Input): Output {
    const { source, output, mapping } = in

    const constants = publish({
        source,
        types: {
            kind: MappingKind.Dense,
            dense: mapping,
            sparse: [],
            planned: [],
            first: 0,
            prefix: 0,
            count: mapping.length
        }
    })

    return {
        kind: Kind.Constants,
        row: output,
        text: "",
        constants
    }
}
