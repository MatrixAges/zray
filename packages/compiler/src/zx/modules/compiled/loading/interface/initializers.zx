import integers from "std:integer"
import memory from "memory"

import store from "../../identity/store"
import { Kind } from "./publication"

import type { InitializerStep as Input, Pending as Output } from "./publication"

export default function (in: Input): Output {
    const { source, row, first, instance } = in

    const id = memory.readColumnU32(source.functions, row)
    const function_id = integers.narrow(first + integers.widen(id))
    const version = memory.readColumnU32(source.versions, row)

    return {
        kind: Kind.Initializer,
        row,
        text: store({
            instance,
            value: memory.readTextColumn(source.identities, row)
        }),
        version,
        id: function_id
    }
}
