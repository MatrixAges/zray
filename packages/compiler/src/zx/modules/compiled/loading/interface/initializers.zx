import bytes from "std:bytes"
import integers from "std:integer"
import { allocateRows } from "core/row_buffer"
import memory from "memory"

import store from "../../identity/store"

import type { RowBuffer } from "memory/columns"
import type { Initializers } from "../../model"
import type { InitializerFields } from "./model"

export type Input = {
    source: Initializers,
    first: u64,
    instance: string,
    buffer: RowBuffer,
    target: InitializerFields
}

export type Output = void

export default function (in: Input): Output {
    const { source, first, instance, target } = in

    allocateRows({
        target: in.buffer,
        count: source.count
    })

    const published = loop(0, {
        while: row => row < source.count,
        next: row => {
            const identity = store({
                instance,
                value: memory.readTextColumn(source.identities, row)
            })
            const version = memory.readColumnU32(source.versions, row)
            const id = memory.readColumnU32(source.functions, row)

            memory.writeColumnBytes(
                target.identities,
                row,
                bytes.fromText(identity)
            )
            memory.writeColumnU32(target.versions, row, version)
            memory.writeColumnU32(
                target.functions,
                row,
                integers.narrow(first + integers.widen(id))
            )

            row += 1
        }
    })
}
