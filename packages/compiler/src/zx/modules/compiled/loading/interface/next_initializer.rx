<Module>
    <Type from="publication" as="Publication" />

    <Args in={Publication.InitializerStep} out={Publication.InitializerStep} />

    <Store from="rows" as="rows" />

    <Call fn="initializers" in={$in} />

    <Call fn="stage" setter={[$store.rows.pending]} />

    <Return
        value={{
            ...$in,
            row: $ctx.stage + 1
        }}
    />
</Module>
