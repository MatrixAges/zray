import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import scope from "../../identity/scope"

import type { Row } from "./model"

export type Input = Row.Pick("exports", "targets", "first", "instance", "row", "output")

export type Output = void

export default function (in: Input): Output {
    const { exports, row, output } = in

    const target = in.targets.exports
    const id = memory.readColumnOptionalU32(exports.functions, row)

    const path = scope({
        instance: in.instance,
        value: memory.readTextColumn(exports.paths, row)
    })

    const function_id: u32? = match {
        id == null => null,
        _ => integers.narrow(in.first + integers.widen(id))
    }

    memory.writeColumnBytes(target.paths, output, bytes.fromText(path))
    columns.writeColumnOptionalU32(target.functions, output, function_id)
}
