import integers from "std:integer"
import memory from "memory"

import scope from "../../identity/scope"
import { Kind } from "./publication"

import type { Row } from "./model"
import type { Pending as Output } from "./publication"

export type Input = Row.Pick("exports", "first", "instance", "row", "output")

export default function (in: Input): Output {
    const { exports, row, output } = in

    const id = memory.readColumnOptionalU32(exports.functions, row)

    const function_id: u32? = match {
        id == null => null,
        _ => integers.narrow(in.first + integers.widen(id))
    }

    return {
        kind: Kind.Header,
        row: output,
        text: scope({
            instance: in.instance,
            value: memory.readTextColumn(exports.paths, row)
        }),
        id: function_id
    }
}
