<Module>
    <Type from="publication" as="Publication" />

    <Args in={Publication.Types} out={void} />

    <Store from="rows" as="rows" />

    <Call
        fn="list_count"
        in={{
            names: $in.names,
            row: $in.row
        }}
    />

    <Call
        fn="stage"
        in={{
            kind: Publication.Kind.AllocateTypes,
            row: $in.output,
            text: "",
            count: $ctx.list_count
        }}
        setter={[$store.rows.pending]}
    />

    <Loop on={$in.index < $in.count}>
        <Call
            module="next_type"
            in={{
                ...$in.omit(["output"]),
                count: $ctx.list_count,
                index: 0
            }}
        />
    </Loop>
</Module>
