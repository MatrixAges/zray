import type { ListColumn } from "memory"
import type { Row as ConstantRow } from "../../../artifact/surface/constants"
import type { Constants, Initializers, Members } from "../../model"

export enum Kind {
    Name,
    AllocateExports,
    AllocateTypes,
    AllocateMembers,
    Alias,
    Header,
    Type,
    Member,
    Initializer,
    Constants
}

export type Pending = {
    kind: Kind,
    row: u64,
    text: string,
    id?: u32,
    input?: u32,
    output?: u32,
    intrinsic?: u8,
    version?: u32,
    count?: u64,
    source?: u64,
    constants?: ConstantRow[]
}

export type List = {
    names: ListColumn,
    row: u64
}

export type Types = List & {
    ids: ListColumn,
    output: u64,
    mapping: u32[]
}

export type TypeStep = Types.Pick("names", "ids", "row", "mapping") & {
    count: u64,
    index: u64
}

export type MemberList = {
    source: Members,
    row: u64,
    output: u64,
    mapping: u32[],
    first: u64
}

export type MemberStep = MemberList.Omit("output") & {
    count: u64,
    index: u64
}

export type ConstantList = {
    source: Constants,
    row: u64,
    output: u64,
    mapping: u32[]
}

export type InitializerList = {
    source: Initializers,
    first: u64,
    instance: string
}

export type InitializerStep = InitializerList & {
    row: u64
}
