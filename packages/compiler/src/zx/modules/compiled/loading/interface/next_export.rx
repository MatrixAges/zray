<Module>
    <Type from="publication" as="Publication" />
    <Type from="model" as="Interface" />

    <Args in={Interface.Traversal} out={Interface.Traversal} />

    <Store from="rows" as="rows" />

    <Call fn="export_row" in={$in} />

    <If on={$ctx.export_row.first == $in.output}>
        <Call
            module="row"
            in={{
                ...$in.source.omit(["selection"]),
                row: $ctx.export_row.row,
                output: $in.output
            }}
        />

        <Else>
            <Call
                fn="stage"
                in={{
                    kind: Publication.Kind.Alias,
                    row: $in.output,
                    text: "",
                    source: $ctx.export_row.first
                }}
                setter={[$store.rows.pending]}
            />
        </Else>
    </If>

    <Call fn="export_name" in={$in} />

    <Call fn="stage" setter={[$store.rows.pending]} />

    <Return
        value={{
            ...$in,
            output: $ctx.stage + 1,
            running: $ctx.stage + 1 < $in.count
        }}
    />
</Module>
