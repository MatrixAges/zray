import integers from "std:integer"
import memory from "memory"

import { Kind } from "./publication"

import type { Pending as Output, TypeStep } from "./publication"

export type Input = TypeStep.Omit("count")

export default function (in: Input): Output {
    const { names, ids, row, index, mapping } = in

    const id = memory.readListU32(ids, row, index)

    return {
        kind: Kind.Type,
        row: index,
        text: memory.readListText(names, row, index),
        id: mapping[integers.widen(id)]
    }
}
