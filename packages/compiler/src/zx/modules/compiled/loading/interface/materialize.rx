<Module>
    <Type from="model" as="Interface" />

    <Args in={Interface.Request} out={void} />

    <Call module="exports" in={$in.omit(["initializers"])} />

    <Call
        module="initializer_rows"
        in={{
            source: $in.initializers,
            first: $in.first,
            instance: $in.instance
        }}
    />
</Module>
