<Module>
    <Type from="model" as="Interface" />

    <Args in={Interface.Request} out={void} />

    <Call fn="exports" in={$in.omit(["initializers"])} />

    <Call
        fn="initializers"
        in={{
            source: $in.initializers,
            first: $in.first,
            instance: $in.instance,
            buffer: $in.buffers.initializers,
            target: $in.targets.initializers
        }}
    />
</Module>
