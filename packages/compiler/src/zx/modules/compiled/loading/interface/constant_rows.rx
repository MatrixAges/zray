<Module>
    <Type from="publication" as="Publication" />

    <Args in={Publication.ConstantList} out={void} />

    <Store from="rows" as="rows" />

    <Call
        fn="list_count"
        in={{
            names: $in.source.names,
            row: $in.row
        }}
    />

    <If on={$ctx.list_count != 0}>
        <Call
            fn="../../constant_view"
            in={{
                source: $in.source,
                row: $in.row,
                count: $ctx.list_count
            }}
        />

        <Call
            fn="constants"
            in={{
                source: $ctx.constant_view,
                output: $in.output,
                mapping: $in.mapping
            }}
        />

        <Call fn="stage" setter={[$store.rows.pending]} />
    </If>
</Module>
