<Module>
    <Type from="types/model" as="Model" />
    <Type from="../../../analysis/semantic/merging/model" as="Merge" />

    <Args in={Model.Request} out={Merge.State} />

    <Call
        module="../../../analysis/semantic/merging/prepare"
        in={{
            request: {
                ...$in.omit(["names"]),
                first: 0,
                source_first: 0,
                checked: true
            },
            names: $in.names,
            complete: true,
            validation: null
        }}
    />

    <If on={$ctx.prepare != null}>
        <Return value={$ctx.prepare} />
    </If>

    <Call fn="../../../analysis/semantic/merging/initial" in={Merge.Status.Invalid} />

    <Return value={$ctx.initial} />
</Module>
