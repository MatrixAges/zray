<Module>
    <Type from="model" as="Install" />
    <Type from="../../../../analysis/semantic/merging/publication/model" as="Types" />

    <Args in={Install.Publication} out={Types.Plan} />

    <Store from="progress" as="progress" />

    <Call
        fn="set_preparing"
        in={true}
        setter={[$store.progress.state]}
    />

    <Call
        module="../../../../analysis/semantic/merging/publication/write"
        in={{
            ...$in.installation.types,
            delta: $in.plan.types,
            origins: $in.plan.origins
        }}
    />

    <If on={$in.plan.natives.specifiers.length != 0}>
        <Call
            module="../../../link/native/publication/publish"
            in={{
                source: $in.plan.natives,
                mapping: $in.plan.functions.types,
                rows: null,
                destination: $in.installation.natives
            }}
        />
    </If>

    <If on={$in.installation.reserve.count != 0}>
        <Call
            module="../../../artifact/materializing/publication/reserve_columns"
            in={$in.installation.reserve}
        />
    </If>

    <Call
        fn="set_preparing"
        in={false}
        setter={[$store.progress.state]}
    />

    <Return value={$ctx.write} />
</Module>
