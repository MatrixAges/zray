import capacity from "core/bytes/index/fixed_capacity"

import type { Input as Plan } from "../../model"

export type Input = Plan.Pick("graph", "selection", "index_capacity")

export type Output = u64

export default function (in: Input): Output {
    const { graph, selection, index_capacity } = in

    if (index_capacity != 0 || selection == null) {
        return index_capacity
    }

    if (selection.count < 2 || graph.exports.count < 2) {
        return 0
    }

    return capacity(graph.exports.count)
}
