import type { Allocator, ArenaScope, BoolBuffer } from "memory"
import type {
    Target as TypeTarget
} from "../../../../analysis/semantic/merging/publication/model"
import type {
    Input as Reserve
} from "../../../artifact/materializing/publication/reserve"
import type { Destination as NativeTarget } from "../../../link/native/publication/model"
import type { Commit } from "../../../link/source/workflow/model"
import type { Input as Planning, Result } from "../../model"
import type { Input as Functions } from "../functions/batch_model"
import type { Request as Interface } from "../interface/model"

export type Installation = {
    types: TypeTarget,
    natives: NativeTarget,
    reserve: Reserve,
    functions: Functions.Omit("mapping"),
    interface?: Interface.Omit("selection", "mapping"),
    commit: Commit,
    owner: Allocator
}

export type Request = {
    plan: Planning,
    installation: Installation,
    temporary: Allocator,
    resources: ArenaScope,
    preparing: BoolBuffer
}

export type Publication = Request.Pick("installation", "resources", "preparing") & {
    plan: Result
}
