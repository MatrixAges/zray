<Module>
    <Type from="model" as="Install" />

    <Args in={Install.Request} out={void} />

    <Call module="prepare" in={$in.preparation} />
    <Call module="../functions/batch" in={$in.functions} />

    <If on={$in.interface != null}>
        <If
            on={$in.interface.exports.count != 0 || $in.interface.initializers.count != 0}
        >
            <Call module="../interface/materialize" in={$in.interface} />
        </If>
    </If>

    <Call fn="../../../link/source/workflow/settle" in={$in.commit} />
</Module>
