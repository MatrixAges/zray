<Module>
    <Type from="model" as="Install" />

    <Args in={Install.Publication} out={void} />

    <Call
        module="../functions/batch"
        in={{
            ...$in.installation.functions,
            mapping: $in.plan.functions
        }}
    />

    <If on={$in.installation.interface != null}>
        <If
            on={$in.installation.interface.exports.count != 0 ||
                $in.installation.interface.initializers.count != 0}
        >
            <Call
                module="../interface/materialize"
                in={{
                    ...$in.installation.interface,
                    mapping: $in.plan.functions.types,
                    selection: $in.plan.selection
                }}
            />
        </If>
    </If>

    <Call fn="../../../link/source/workflow/settle" in={$in.installation.commit} />
</Module>
