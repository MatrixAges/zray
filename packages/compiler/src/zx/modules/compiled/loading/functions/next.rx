<Module>
    <Type from="batch_model" as="Batch" />

    <Args in={Batch.Traversal} out={Batch.Traversal} />

    <Store from="../../../artifact/materializing/publication/progress" as="progress" />

    <Call fn="remap_request" in={$in} />

    <Call module="remap" />

    <Call
        fn="append"
        in={{
            state: $in,
            owned: $ctx.remap
        }}
    />

    <Call
        fn="../../../../../core/column_set/write_function"
        in={$ctx.append.publication}
    />

    <Call
        fn="../../../artifact/materializing/publication/set_completed"
        in={$ctx.append.next.row}
        setter={[$store.progress.state]}
    />

    <Return value={$ctx.append.next} />
</Module>
