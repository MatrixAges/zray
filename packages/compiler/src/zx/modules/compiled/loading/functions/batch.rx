<Module>
    <Type from="batch_model" as="Batch" />
    <Type from="../../../artifact/materializing/publication/model" as="Publication" />

    <Args in={Batch.Input} out={Batch.Output} />

    <Loop on={$in.running}>
        <Call
            module="next"
            in={{
                input: $in,
                row: 0,
                running: $in.source.files.length != 0
            }}
        />
    </Loop>

    <Return value={Publication.PublicationStatus.Complete} />
</Module>
