<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Request} out={Model.Mapped} />

    <Call fn="ports" in={$in} />

    <Call
        fn="../remap/symbols"
        in={{
            source: $in.symbols,
            mapping: $in.mapping.types
        }}
    />

    <Call
        fn="../remap/expressions"
        in={{
            source: $in.expressions,
            mapping: $in.mapping.types,
            first: $in.first
        }}
    />

    <Call
        module="../remap/contracts"
        in={{
            source: $in.contracts,
            mapping: $in.mapping.types,
            first: $in.first
        }}
    />

    <Call
        fn="../remap/stores"
        in={{
            source: $in.stores,
            mapping: $in.mapping.types,
            instance: $in.instance
        }}
    />

    <Call fn="../../../artifact/materializing/control" in={$in.control} />

    <Call
        fn="../../../artifact/materializing/metadata"
        in={{
            file: $in.header.file,
            instance: $in.instance,
            external: $in.external
        }}
    />

    <Return
        value={{
            header: {
                ...$ctx.ports,
                file: $ctx.metadata.file
            },
            symbols: $ctx.symbols,
            expressions: $ctx.expressions,
            contracts: $ctx.contracts,
            stores: $ctx.stores,
            control: $ctx.control,
            external: $ctx.metadata.external
        }}
    />
</Module>
