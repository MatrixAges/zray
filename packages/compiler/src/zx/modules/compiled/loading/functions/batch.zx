import remap from "compiler/compiled_linked_function"
import memory from "memory"

import readAttributes from "../../../artifact/materializing/publication/attributes"
import { PublicationStatus } from "../../../artifact/materializing/publication/model"
import write from "../../../artifact/materializing/publication/write"

import type { ColumnLengths, U64Buffer } from "memory"
import type { Output as External } from "../../../artifact/materializing/copy_external"
import type { Columns } from "../../../artifact/materializing/publication/model"
import type { Mapping } from "./model"

export type Input = {
    source: Columns,
    target: Columns,
    mapping: Mapping,
    instance: string,
    first: u64,
    progress: U64Buffer,
    lengths: ColumnLengths
}

export type Output = {
    columns?: Columns,
    status: PublicationStatus
}

export default function (in: Input): Output {
    const { source, target, mapping, instance, first, progress } = in

    const count = source.files.length

    const [failure, result] = try loop({
        row: 0,
        columns: target
    }, {
        while: state => state.row < count,
        next: state => {
            const row = state.row
            const native_module = source.native_modules[row]

            const external: External? = match {
                native_module != null => {
                    members: source.native_members[row],
                    errors: source.native_errors[row],
                    export_name: source.native_exports[row],
                    parameters: source.native_inputs[row]
                },
                _ => null
            }

            const owned = remap({
                header: {
                    file: source.files[row],
                    input_type: source.input_types[row],
                    output_type: source.output_types[row],
                    native_module
                },
                mapping,
                instance,
                first,
                symbols: source.symbols[row],
                expressions: source.expressions[row],
                contracts: source.contracts[row],
                control: source.control[row],
                stores: source.stores[row],
                external
            })

            state.columns = write({
                columns: state.columns,
                function: {
                    file: owned.header.file,
                    ports: {
                        input: owned.header.input_type,
                        output: owned.header.output_type,
                        native_module: owned.header.native_module
                    },
                    external: owned.external,
                    symbols: owned.symbols,
                    expressions: owned.expressions,
                    contracts: owned.contracts,
                    control: owned.control,
                    store_table: owned.stores
                },
                attributes: readAttributes({
                    source,
                    row
                }),
                row
            })

            state.row += 1
            memory.writeU64(progress, 0, state.row)
        },
        return: state => state.columns
    })

    memory.publishColumnLengths(in.lengths, memory.readU64(progress, 0))

    const allocation_failed = failure == error.OutOfMemory
    const overflow = failure == error.Overflow
    const integer_overflow = failure == error.IntegerOverflow
    const exhausted = allocation_failed || overflow || integer_overflow

    if (exhausted) {
        return {
            columns: null,
            status: PublicationStatus.Exhausted
        }
    }

    if (result == null) {
        return {
            columns: null,
            status: PublicationStatus.Invalid
        }
    }

    return {
        columns: result,
        status: PublicationStatus.Complete
    }
}
