import type { Binding, Modules } from "core/native_module_table/model"
import type { Status } from "../../status"

export type Value = Binding

export type State = {
    delta: Modules,
    mapping: u32[],
    type_ids: u32[],
    status: Status
}

export type Request = {
    source: Modules,
    base: Modules,
    type_mapping: u32[],
    instance: string,
    maximum: u64
}

export type Traversal = {
    request: Request,
    state: State,
    index: u64,
    running: bool
}
