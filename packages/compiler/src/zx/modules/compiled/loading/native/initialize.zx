import memory from "memory"

import { Status } from "../../status"

import type { Request as Input, Traversal as Output } from "./model"

export default function (in: Input): Output {
    return {
        request: in,
        state: {
            delta: {
                identities: [],
                import_names: [],
                specifiers: [],
                type_ids: [],
                type_names: [],
                type_namespaces: []
            },
            mapping: [],
            type_ids: memory.u32Views(in.type_mapping),
            status: Status.Ready
        },
        index: 0,
        running: in.source.specifiers.length != 0
    }
}
