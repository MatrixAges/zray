import check from "./exports/check"
import unique from "./unique_column"

import type { Graph } from "../model"

export type Input = Graph

export type Output = bool

export default function (in: Input): Output {
    return loop({
        graph: in,
        index: 0,
        valid: unique({
            names: in.exports.names,
            count: in.exports.count
        })
    }, {
        while: current =>
            current.valid && current.index < current.graph.exports.count,
        next: current => {
            current.valid = check({
                graph: current.graph,
                index: current.index
            })
            current.index += 1
        },
        return: state => state.valid
    })
}
