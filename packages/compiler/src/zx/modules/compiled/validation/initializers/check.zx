import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import memory from "memory"

import text from "../../../../ir/canonical/native/text"
import { store_identity_prefix } from "../../const"
import slots from "./slots"

import type { Graph } from "../../model"

export type Input = {
    graph: Graph,
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const initializers = in.graph.initializers
    const identity = memory.readTextColumn(initializers.identities, in.index)

    const index =
        integers.widen(memory.readColumnU32(initializers.functions, in.index))

    const functions = in.graph.program.context.functions
    const table = in.graph.program.context.table

    const prefix = bytes.fromText(store_identity_prefix)
    const identity_bytes = bytes.fromText(identity)
    const starts_with_prefix = bytes.startsWith(identity_bytes, 0, prefix)
    const has_name = identity_bytes.length > prefix.length
    const function_exists = index < functions.files.length

    const condition = (
        - text(identity)
        - and starts_with_prefix
        - and has_name
        - and function_exists
    )

    if (!condition) {
        return false
    }

    const input_id = integers.widen(functions.input_types[index])
    const output_id = integers.widen(functions.output_types[index])

    const condition_2 = match {
        kind(table.kinds[input_id]) != Kind.Scalar => true,
        table.first[input_id] != 0 => true,
        kind(table.kinds[output_id]) != Kind.Object => true,
        functions.native_modules[index] != null => true,
        functions.stores[index].paths.length != 0 => true,
        _ => functions.contracts[index].kinds.length != 0
    }

    if (condition_2) {
        return false
    }

    const pure = loop({
        kinds: functions.expressions[index].kinds,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.kinds.length,
        next: current => {
            current.valid = current.kinds[current.index] != ExpressionKind.Call
            current.index += 1
        },
        return: state => state.valid
    })

    return pure && slots({
        stores: functions.stores,
        identity,
        type_id: functions.output_types[index]
    })
}
