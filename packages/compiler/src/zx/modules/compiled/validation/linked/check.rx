<Module>
    <Type from="model" as="Linked" />

    <Args in={Linked.Input} out={Linked.Status} />

    <Store from="progress" as="progress" />

    <Call
        fn="../stores"
        in={{
            tables: $in.graph.program.context.functions.stores
        }}
    />

    <If on={!$ctx.stores}>
        <Return value={Linked.Status.ConflictingStore} />
    </If>

    <Call
        fn="set_progress"
        in={{
            ir_started: true,
            surface_started: false
        }}
        setter={[$store.progress.state]}
    />

    <Call module="../../../../ir/canonical/validation/validate" in={$in.graph.program} />

    <If on={$ctx.validate == null}>
        <Return value={Linked.Status.InvalidIr} />
    </If>

    <Call
        fn="set_progress"
        in={{
            ir_started: true,
            surface_started: true
        }}
        setter={[$store.progress.state]}
    />

    <Call fn="../header" in={$in.graph} />

    <If on={!$ctx.header}>
        <Return value={Linked.Status.InvalidLibrary} />
    </If>

    <Call
        module="../surface"
        in={{
            graph: $in.graph
        }}
    />

    <If on={!$ctx.surface}>
        <Return value={Linked.Status.InvalidLibrary} />
    </If>

    <Return value={Linked.Status.Valid} />
</Module>
