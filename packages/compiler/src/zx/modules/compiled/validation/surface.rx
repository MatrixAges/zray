<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.Validation} out={Model.ValidationResult} />

    <Call
        module="../../../analysis/semantic/origins"
        in={{
            table: $in.graph.program.context.table,
            origins: $in.graph.origins,
            names: $in.graph.origin_names
        }}
    />

    <If on={!$ctx.origins}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call fn="nominal" in={$in.graph} />

    <If on={!$ctx.nominal}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call fn="initializers" in={$in.graph} />

    <If on={!$ctx.initializers}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call fn="exports/name_index" in={$in} />

    <If on={!$ctx.name_index.valid}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call fn="exports" in={$in.graph} />

    <Return
        value={{
            valid: $ctx.exports,
            export_index: $ctx.name_index.export_index
        }}
    />
</Module>
