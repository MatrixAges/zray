import integers from "std:integer"
import memory from "memory"

import text from "../../../../ir/canonical/native/text"
import { input_type_name, output_type_name } from "../../const"

import type { Complete } from "core/function_table/complete"
import type { ListColumn } from "memory"

export type Input = {
    names: ListColumn,
    ids: ListColumn,
    row: u64,
    length: u64,
    count: u64,
    function_id?: u32,
    functions: Complete
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        input: in,
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < current.input.length,
        next: current => {
            const name = memory.readListText(in.names, in.row, current.index)
            const id = memory.readListU32(in.ids, in.row, current.index)
            const function_id = current.input.function_id

            current.valid = text(name) && integers.widen(id) < current.input.count

            if (current.valid && function_id != null) {
                const index = integers.widen(function_id)

                const input_matches = match {
                    name != input_type_name => true,
                    _ => id == current.input.functions.input_types[index]
                }

                current.valid = match {
                    !input_matches => false,
                    name != output_type_name => true,
                    _ => id == current.input.functions.output_types[index]
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
