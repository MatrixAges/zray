import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { TextColumn } from "memory"

export type Input = {
    names: TextColumn,
    buckets: u64[],
    name: string
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { names, buckets, name } = in

    const mask = buckets.length - 1

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(name)), mask),
        entry: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = buckets[state.slot]

            if (entry == 0 || memory.readTextColumn(names, entry - 1) == name) {
                state.entry = entry
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => ({
            slot: state.slot,
            entry: state.entry
        })
    })
}
