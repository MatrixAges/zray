import integers from "std:integer"
import { projectLists } from "core/column_set"
import memory from "memory"

import validConstants from "../../../../analysis/constants/validation/rows"
import text from "../../../../ir/canonical/native/text"
import members from "./members"
import types from "./types"

import type { Graph } from "../../model"

export type Input = {
    graph: Graph,
    index: u64
}

export type Output = bool

export default function (in: Input): Output {
    const exports = in.graph.exports
    const name = memory.readTextColumn(exports.names, in.index)
    const path = memory.readTextColumn(exports.paths, in.index)
    const function_id = memory.readColumnOptionalU32(exports.functions, in.index)
    const functions = in.graph.program.context.functions

    const type_count = memory.listLength(exports.type_names, in.index)

    if (!text(name) || !text(path)) {
        return false
    }

    if (function_id != null) {
        const index = integers.widen(function_id)

        if (
            index >= functions.files.length ||
                functions.native_modules[index] != null
        ) {
            return false
        }
    }

    const constants = exports.constants
    const count = memory.listLength(constants.names, in.index)

    if (count != 0) {
        projectLists([
            constants.projection,
            in.index
        ])

        if (!validConstants({
            constants: {
                ...constants.rows,
                count
            },
            types: {
                base: in.graph.program.context.table,
                delta: {
                    kinds: [],
                    first: [],
                    second: [],
                    labels: [],
                    children: [],
                    field_types: [],
                    field_names: [],
                    names: []
                }
            }
        })) {
            return false
        }
    }

    return members({
        members: exports.members,
        type_names: exports.type_names,
        type_count,
        row: in.index,
        constant_names: constants.names,
        constant_count: count,
        functions
    }) && types({
        names: exports.type_names,
        ids: exports.type_ids,
        length: type_count,
        row: in.index,
        count: in.graph.program.context.table.kinds.length,
        function_id,
        functions
    })
}
