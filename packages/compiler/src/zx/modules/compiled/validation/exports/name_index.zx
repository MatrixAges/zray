import slot from "core/bytes/index/borrowed/wide_slot"
import memory from "memory"

import unique from "../unique_column"

import type { Validation as Input } from "../../model"

export type Output = bool

export default function (in: Input): Output {
    const { exports } = in.graph
    const { names, count } = exports

    const buckets = in.export_index
    const capacity = buckets == null ? 0 : memory.u64Views(buckets).length

    if (buckets == null || capacity == 0) {
        return unique({
            names,
            count
        })
    }

    if (count < 2) {
        return true
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const row = state.row
            const found = slot({
                names,
                buckets,
                capacity,
                name: memory.readTextColumn(names, row)
            })

            state.valid = found.entry == 0

            if (state.valid) {
                memory.writeU64(buckets, found.slot, row + 1)
                state.row += 1
            }
        },
        return: state => state.valid
    })
}
