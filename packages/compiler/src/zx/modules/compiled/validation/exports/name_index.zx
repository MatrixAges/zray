import memory from "memory"

import unique from "../unique_column"
import slot from "./index_slot"

import type { Validation as Input, ValidationResult as Output } from "../../model"

export default function (in: Input): Output {
    const { exports } = in.graph
    const { names, count } = exports
    const { index_capacity } = in

    if (index_capacity == 0 || count < 2) {
        return {
            valid: unique({
                names,
                count
            }),
            export_index: []
        }
    }

    const empty: u64[] = []

    const buckets = loop(empty, {
        while: items => items.length < index_capacity,
        next: items => {
            items = items.push(0)[0]
        }
    })

    return loop({
        buckets,
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const row = state.row
            const found = slot({
                names,
                buckets: state.buckets,
                name: memory.readTextColumn(names, row)
            })

            state.valid = found.entry == 0

            if (state.valid) {
                state.buckets = state.buckets.with(found.slot, row + 1)
                state.row += 1
            }
        },
        return: state => ({
            valid: state.valid,
            export_index: state.buckets
        })
    })
}
