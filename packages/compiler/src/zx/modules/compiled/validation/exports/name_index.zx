import slot from "core/bytes/index/borrowed/wide_slot"
import memory from "memory"

import type { Table } from "core/bytes/index/borrowed/wide_slot"

export type Input = Table & {
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { names, buckets, capacity, count } = in

    if (count < 2) {
        return true
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            const row = state.row
            const found = slot({
                names,
                buckets,
                capacity,
                name: memory.readTextColumn(names, row)
            })

            state.valid = found.entry == 0

            if (state.valid) {
                memory.writeU64(buckets, found.slot, row + 1)
                state.row += 1
            }
        },
        return: state => state.valid
    })
}
