import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import text from "../../../../ir/canonical/native/text"
import unique from "../unique"

import type { Complete } from "core/function_table/complete"
import type { ListColumn } from "memory"
import type { Members } from "../../model"

export type Input = {
    members: Members,
    type_names: ListColumn,
    type_count: u64,
    row: u64,
    constant_names: ListColumn,
    constant_count: u64,
    functions: Complete
}

export type Output = bool

export default function (in: Input): Output {
    const { members, row } = in

    const count = memory.listLength(members.names, row)

    const total = in.type_count + count + in.constant_count

    if (total > 1) {
        const names: string[] = []

        const values = loop({
            names,
            index: 0
        }, {
            while: state => state.index < total,
            next: state => {
                const index = state.index

                const name = match {
                    index < in.type_count =>
                        memory.readListText(in.type_names, in.row, index),
                    index < in.type_count + count =>
                        memory.readListText(members.names, row, index - in.type_count),
                    _ => memory.readListText(
                        in.constant_names,
                        row,
                        index - in.type_count - count
                    )
                }

                state.names = state.names.push(name)[0]
                state.index += 1
            },
            return: state => state.names
        })

        if (!unique(values)) {
            return false
        }
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < count,
        next: current => {
            const index = current.index
            const name = memory.readListText(members.names, row, index)
            const namespace =
                memory.readListOptionalText(members.namespaces, row, index)
            const id = memory.readListOptionalU32(members.ids, row, index)
            const input = memory.readListOptionalU32(members.inputs, row, index)
            const output = memory.readListOptionalU32(members.outputs, row, index)
            const intrinsic =
                columns.readListOptionalU8(members.intrinsics, row, index)

            const named = text(name) || (name == "" && intrinsic != null)

            current.valid = named && namespace == null

            if (current.valid) {
                const complete = id != null && input != null && output != null

                if (intrinsic != null) {
                    current.valid = id == null && input == null && output == null
                } else if (complete && id != null) {
                    const linked = integers.widen(id)
                    const functions = in.functions

                    current.valid = linked < functions.files.length

                    if (current.valid) {
                        current.valid =
                            input == functions.input_types[linked] &&
                            output == functions.output_types[linked]
                    }
                } else {
                    current.valid = false
                }
            }

            current.index += 1
        },
        return: state => state.valid
    })
}
