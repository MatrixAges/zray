<Module>
    <Type from="loading/install/model" as="Install" />
    <Type from="status" as="Link" />

    <Args in={Install.Request} out={Install.Execution} />

    <Call
        fn="loading/install/initialize"
        in={$in.plan.pick([
            "graph",
            "selection",
            "index_capacity"
        ])}
    />

    <Call
        module="plan"
        in={{
            ...$in.plan,
            index_capacity: $ctx.initialize
        }}
    />

    <If on={$ctx.plan.status != Link.Status.Ready}>
        <Return
            value={{
                plan: $ctx.plan
            }}
        />
    </If>

    <Call
        module="loading/install/prepare"
        in={{
            installation: $in.installation,
            plan: $ctx.plan
        }}
    />

    <Return
        value={{
            plan: $ctx.plan,
            publication: $ctx.prepare
        }}
    />
</Module>
