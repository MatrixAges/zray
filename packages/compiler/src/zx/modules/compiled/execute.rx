<Module>
    <Type from="loading/install/model" as="Install" />
    <Type from="status" as="Link" />

    <Args in={Install.Request} out={Link.Status} />

    <Call
        fn="loading/install/initialize"
        in={$in.pick([
            "plan",
            "temporary"
        ])}
    />

    <Call module="plan" in={$in.plan} />

    <If on={$ctx.plan.status != Link.Status.Ready}>
        <Return value={$ctx.plan.status} />
    </If>

    <Call
        module="loading/install/publish"
        in={{
            ...$in.pick([
                "installation",
                "resources",
                "preparing"
            ]),
            plan: $ctx.plan
        }}
    />

    <Return value={Link.Status.Ready} />
</Module>
