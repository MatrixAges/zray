<Module>
    <Type from="declaration" as="Declaration" />

    <Args
        in={Declaration.Input & {
            instance: string
        }}
        out={{
            conflict: bool,
            value?: string
        }}
    />

    <Call
        fn="declaration"
        in={$in.pick([
            "modules",
            "requested"
        ])}
    />

    <If on={$ctx.declaration.conflict}>
        <Return
            value={{
                conflict: true,
                value: null
            }}
        />
    </If>

    <If on={$ctx.declaration.identity != null}>
        <Call
            fn="own_declaration"
            in={{
                instance: $in.instance,
                value: $ctx.declaration.identity,
                shared: $ctx.declaration.shared
            }}
        />

        <Return
            value={{
                conflict: false,
                value: $ctx.own_declaration
            }}
        />
    </If>

    <Return
        value={{
            conflict: false,
            value: null
        }}
    />
</Module>
