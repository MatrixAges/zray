import strings from "std:string"

import scope from "./scope"

export type Input = {
    instance: string,
    value: string,
    shared: bool
}

export type Output = string

export default function (in: Input): Output {
    return match in.shared {
        true => strings.copy(in.value),
        _ => scope(in.pick([
            "instance",
            "value"
        ]))
    }
}
