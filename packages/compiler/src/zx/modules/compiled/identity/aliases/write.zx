import bytes from "std:bytes"
import strings from "std:string"
import memory from "memory"
import columns from "memory/columns"

import type { Rows } from "./model"

export type Input = {
    rows: Rows,
    count: u64,
    capacity: u64,
    name: string,
    specifier: string,
    own_name: bool
}

export type Output = u64

export default function (in: Input): Output {
    const { rows, count, capacity, name, specifier, own_name } = in

    const space = match count == capacity {
        true => columns.growRows(rows.growth, count),
        _ => capacity
    }

    const stable = match own_name {
        true => strings.copy(name),
        _ => name
    }

    memory.writeColumnBytes(rows.fields.names, count, bytes.fromText(stable))
    memory.writeColumnBytes(rows.fields.specifiers, count, bytes.fromText(specifier))
    memory.writeU64(rows.progress, 0, count + 1)

    return space
}
