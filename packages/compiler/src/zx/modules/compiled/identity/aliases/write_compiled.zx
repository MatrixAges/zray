import memory from "memory"

import ownDeclaration from "../own_declaration"
import { Status } from "./model"
import write from "./write"

import type { CompiledWrite as Input, CompiledWalk as Output } from "./model"

export default function (in: Input): Output {
    const { state, item } = in
    const { identity, name } = item

    const next = {
        ...state,
        cursor: item.next,
        status: item.status,
        running: item.status == Status.Ready
    }

    if (identity == null || name == null) {
        return next
    }

    const target = ownDeclaration({
        instance: state.library.instance,
        value: identity,
        shared: item.shared
    })

    memory.writeOptionalString(state.output.pending, 0, target)

    const capacity = write({
        rows: state.output.rows,
        count: state.count,
        capacity: state.capacity,
        name,
        specifier: target,
        own_name: state.configured == null
    })

    memory.writeOptionalString(state.output.pending, 0, null)

    return {
        ...next,
        capacity,
        count: state.count + 1
    }
}
