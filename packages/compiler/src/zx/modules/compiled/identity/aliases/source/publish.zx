import { Status } from "../model"
import check from "./check"
import select from "./select"

import type { Configured, Declarations, Result } from "../model"

export type Input = {
    declarations: Declarations,
    configured?: Configured
}

export type Output = Result

export default function (in: Input): Output {
    const { declarations, configured } = in

    const total = declarations.interfaces.count + declarations.externals.count
    const count = configured == null ? total : configured.count
    const empty: string[] = []

    return loop({
        index: 0,
        names: empty,
        specifiers: empty,
        status: Status.Done
    }, {
        while: current => current.index < count && current.status == Status.Done,
        next: current => {
            const selected = select({
                declarations,
                configured,
                total,
                index: current.index
            })

            const target = selected.specifier

            if (target == null) {
                current.status = Status.Unknown
            } else {
                const status = check({
                    published: current.pick([
                        "names",
                        "specifiers"
                    ]),
                    name: selected.name,
                    specifier: target
                })

                if (status == Status.Ready) {
                    current.names = current.names.push(selected.name)[0]
                    current.specifiers = current.specifiers.push(target)[0]
                } else {
                    current.status = status
                }
            }

            current.index += 1
        },
        return: current => current.omit(["index"])
    })
}
