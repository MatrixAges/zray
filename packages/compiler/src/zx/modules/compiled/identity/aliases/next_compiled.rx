<Module>
    <Type from="model" as="Aliases" />

    <Args in={Aliases.CompiledWalk} out={Aliases.CompiledWalk} />

    <Call
        module="step"
        in={{
            modules: $in.library.modules,
            configured: $in.configured,
            row: $in.cursor
        }}
    />

    <Call
        fn="write_compiled"
        in={{
            state: $in,
            item: $ctx.step
        }}
    />

    <Return value={$ctx.write_compiled} />
</Module>
