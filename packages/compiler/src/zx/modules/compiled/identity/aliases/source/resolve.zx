import entry from "./row"

import type { Declarations } from "../model"

export type Input = {
    declarations: Declarations,
    count: u64,
    requested: string
}

export type Output = string?

export default function (in: Input): Output {
    const { declarations, count, requested } = in

    const missing: string? = null

    return loop({
        row: count,
        target: missing
    }, {
        while: current => current.row != 0 && current.target == null,
        next: current => {
            current.row -= 1

            const item = entry({
                declarations,
                index: current.row
            })

            if (item.name == requested) {
                current.target = item.specifier
            }
        },
        return: current => current.target
    })
}
