import { Status } from "../model"

import type { Aliases } from "../model"

export type Input = {
    published: Aliases,
    name: string,
    specifier: string
}

export type Output = Status

export default function (in: Input): Output {
    const { name, specifier, published } = in
    const { names, specifiers } = published

    return loop({
        row: 0,
        status: Status.Ready
    }, {
        while: current => current.row < names.length && current.status == Status.Ready,
        next: current => {
            if (names[current.row] == name) {
                const previous = specifiers[current.row]

                current.status = previous == specifier ? Status.Done : Status.Conflict
            }

            current.row += 1
        },
        return: current => current.status
    })
}
