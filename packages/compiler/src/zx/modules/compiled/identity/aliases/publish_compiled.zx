import scope from "../scope"
import { Status } from "./model"
import resolve from "./resolve"

import type { CompiledInput as Input, Result as Output } from "./model"

export default function (in: Input): Output {
    const { library, configured } = in

    const empty: string[] = []

    return loop({
        cursor: 0,
        names: empty,
        specifiers: empty,
        status: Status.Ready
    }, {
        while: state => state.status == Status.Ready,
        next: state => {
            const item = resolve({
                modules: library.modules,
                configured,
                row: state.cursor
            })

            state.cursor = item.next
            state.status = item.status

            const { identity, name } = item

            if (identity != null && name != null) {
                const target = match {
                    item.shared => identity,
                    _ => scope({
                        instance: library.instance,
                        value: identity
                    })
                }

                state.names = state.names.push(name)[0]
                state.specifiers = state.specifiers.push(target)[0]
            }
        },
        return: state => state.omit(["cursor"])
    })
}
