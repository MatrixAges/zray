import type { Modules } from "core/native_module_table/model"
import type { ReadColumn, TextColumn } from "memory"

export type Configured = {
    names: TextColumn,
    requests: TextColumn,
    count: u64
}

export type Cursor = {
    modules: Modules,
    configured?: Configured,
    row: u64
}

export type Choice = {
    next: u64,
    name?: string,
    request?: string,
    duplicate: bool
}

export enum Status {
    Done,
    Ready,
    Conflict,
    Unknown
}

export type Item = Choice.Pick("next", "name") & {
    status: Status,
    identity?: string,
    shared: bool
}

export type DeclarationRows = {
    names: TextColumn,
    identities: ReadColumn,
    count: u64
}

export type Declarations = {
    interfaces: DeclarationRows,
    externals: DeclarationRows
}

export type Compiled = {
    modules: Modules,
    instance: string
}

export type Request = {
    compiled?: Compiled,
    source?: Declarations,
    configured?: Configured
}

export type Aliases = {
    names: string[],
    specifiers: string[]
}

export type Result = Aliases & {
    status: Status
}

export type CompiledInput = {
    library: Compiled,
    configured?: Configured
}
