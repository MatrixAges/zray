<Module>
    <Type from="model" as="Alias" />

    <Args in={Alias.Cursor} out={Alias.Item} />

    <Call fn="choose" in={$in} />

    <If on={$ctx.choose.duplicate}>
        <Return
            value={{
                next: $ctx.choose.next,
                name: null,
                status: Alias.Status.Conflict,
                identity: null,
                shared: false
            }}
        />
    </If>

    <If on={$ctx.choose.request != null}>
        <Call
            fn="../declaration"
            in={{
                modules: $in.modules,
                requested: $ctx.choose.request
            }}
        />

        <Call
            fn="resolved"
            in={{
                choice: $ctx.choose,
                declaration: $ctx.declaration
            }}
        />

        <Return value={$ctx.resolved} />
    </If>

    <Return
        value={{
            next: $ctx.choose.next,
            name: null,
            status: Alias.Status.Done,
            identity: null,
            shared: false
        }}
    />
</Module>
