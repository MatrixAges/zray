<Module>
    <Type from="model" as="Alias" />

    <Args in={Alias.Request} out={Alias.Result} />

    <If on={$in.compiled != null}>
        <Call
            fn="publish_compiled"
            in={{
                library: $in.compiled,
                configured: $in.configured
            }}
        />

        <Return value={$ctx.publish_compiled} />
    </If>

    <If on={$in.source != null}>
        <Call
            fn="source/publish"
            in={{
                declarations: $in.source,
                configured: $in.configured
            }}
        />

        <Return value={$ctx.publish} />
    </If>

    <Return
        value={{
            names: [],
            specifiers: [],
            status: Alias.Status.Done
        }}
    />
</Module>
