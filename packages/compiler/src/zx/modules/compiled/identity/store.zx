import encoding from "std:encoding"

import { library_store_prefix, store_identity_prefix } from "../const"

export type Input = {
    instance: string,
    value: string
}

export type Output = string

export default function (in: Input): Output {
    const tail =
        encoding.sliceBytes(in.value, store_identity_prefix.length, in.value.length)

    return `${library_store_prefix}${in.instance.length}:${in.instance}:${tail}`
}
