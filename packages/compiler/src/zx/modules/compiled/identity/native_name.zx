import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"

import { library_native_prefix } from "../const"
import scope from "./scope"

export type Input = {
    instance: string,
    value: string
}

export type Output = string

export default function (in: Input): Output {
    return bytes.fromText(scope(in))
        -> crypto.sha256(_)
        -> encoding.encodeHex(_)
        -> `${library_native_prefix}${_}`
}
