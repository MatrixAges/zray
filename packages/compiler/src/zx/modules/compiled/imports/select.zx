import memory from "memory"

import find from "./find"

import type { Member } from "./model"

export type Input = {
    member: Member,
    count: u64
}

export type Output = u64?

export default function (in: Input): Output {
    return find({
        ...in.member,
        count: in.count,
        capacity: memory.u64Views(in.member.buckets).length
    })
}
