<Module>
    <Type from="model" as="Import" />

    <Args in={Import.Input} out={u64?} />

    <Call fn="index.resolveCompiledImport" in={$in.frame} />

    <Call
        fn="index.findAdded"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport,
            false
        ]}
    />

    <If on={$ctx.findAdded != null}>
        <Call
            fn="select"
            in={{
                member: $in.member,
                count: $ctx.findAdded
            }}
        />

        <Return value={$ctx.select} />
    </If>

    <Call
        fn="index.findInherited"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport,
            true
        ]}
    />

    <If on={$ctx.findInherited != null}>
        <Call
            fn="select"
            in={{
                member: $in.member,
                count: $ctx.findInherited
            }}
        />

        <Return value={$ctx.select} />
    </If>

    <Call
        fn="index.reserveCompiledUnit"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="index.compiledInitializerCount"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="reserve"
        in={{
            owner: $in.owner,
            initializers: $in.initializers,
            index: $in.index,
            exports: $ctx.reserveCompiledUnit,
            added: $ctx.compiledInitializerCount
        }}
    />

    <Call
        fn="index.bindCompiledImport"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="publish"
        in={{
            target: $in.initializers,
            added: $ctx.compiledInitializerCount
        }}
    />

    <Call
        fn="index.rememberCompiledLibrary"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="select"
        in={{
            member: $in.member,
            count: $ctx.bindCompiledImport
        }}
    />

    <Return value={$ctx.select} />
</Module>
