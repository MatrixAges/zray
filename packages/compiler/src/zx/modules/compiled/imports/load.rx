<Module>
    <Type from="model" as="Import" />

    <Args in={Import.Input} out={Import.Result} />

    <Call fn="index.resolveCompiledImport" in={$in.frame} />

    <Call
        fn="index.findAdded"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport,
            false
        ]}
    />

    <If on={$ctx.findAdded != null}>
        <Call
            fn="select"
            in={{
                member: $in.member,
                count: $ctx.findAdded
            }}
        />

        <Return
            value={{
                row: $ctx.select,
                published: $in.initializers.first
            }}
        />
    </If>

    <Call
        fn="index.findInherited"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport,
            true
        ]}
    />

    <If on={$ctx.findInherited != null}>
        <Call
            fn="select"
            in={{
                member: $in.member,
                count: $ctx.findInherited
            }}
        />

        <Return
            value={{
                row: $ctx.select,
                published: $in.initializers.first
            }}
        />
    </If>

    <Call
        fn="index.reserveCompiledUnit"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="../../../../core/row_buffer/reserve_append"
        in={[
            $in.initializers.rows,
            $in.initializers.first,
            $ctx.reserveCompiledUnit.initializers,
            $in.initializers.owner
        ]}
    />

    <Call
        fn="index.bindCompiledImport"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="index.rememberCompiledLibrary"
        in={[
            $in.frame,
            $ctx.resolveCompiledImport
        ]}
    />

    <Call
        fn="select"
        in={{
            member: $in.member,
            count: $ctx.bindCompiledImport
        }}
    />

    <Return
        value={{
            row: $ctx.select,
            published: $in.initializers.first + $ctx.reserveCompiledUnit.initializers
        }}
    />
</Module>
