<Module>
    <Type from="model" as="Import" />

    <Args in={Import.Input} out={Import.Result} />

    <If on={$in.initializers != null}>
        <Call
            fn="../../../../core/row_buffer/reserve_append"
            in={[
                $in.initializers.rows,
                $in.initializers.first,
                $in.initializers.count,
                $in.initializers.owner
            ]}
        />

        <Return
            value={{
                published: $in.initializers.first + $in.initializers.count,
                inherited: false
            }}
        />
    </If>

    <If on={$in.added != null}>
        <Call fn="find" in={$in.added} />

        <Return
            value={{
                row: $ctx.find,
                inherited: false
            }}
        />
    </If>

    <If on={$in.inherited != null}>
        <Call
            fn="find"
            in={$in.inherited}
        />

        <Return
            value={{
                row: $ctx.find,
                inherited: true
            }}
        />
    </If>

    <Return
        value={{
            row: null,
            inherited: false
        }}
    />
</Module>
