import type { ColumnAllocator, RowBuffer } from "memory/columns"
import type { Input as Search } from "./find"

export type Initializers = {
    rows: RowBuffer,
    owner: ColumnAllocator,
    first: u64,
    count: u64
}

export type Input = {
    initializers?: Initializers,
    added?: Search,
    inherited?: Search
}

export type Result = {
    row?: u64,
    published?: u64,
    inherited: bool
}
