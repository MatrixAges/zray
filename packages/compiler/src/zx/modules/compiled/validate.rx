<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Validation} out={Model.ValidationResult} />

    <Call fn="validation/header" in={$in.graph} />

    <If on={!$ctx.header}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call module="../../ir/canonical/validation/validate" in={$in.graph.program} />

    <If on={$ctx.validate == null}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call module="validation/surface" in={$in} />

    <If on={!$ctx.surface.valid}>
        <Return
            value={{
                valid: false,
                export_index: []
            }}
        />
    </If>

    <Call
        fn="validation/stores"
        in={{
            tables: $in.graph.program.context.functions.stores
        }}
    />

    <Return
        value={{
            valid: $ctx.stores,
            export_index: $ctx.surface.export_index
        }}
    />
</Module>
