<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Graph} out={bool} />

    <Call fn="validation/header" in={$in} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Call module="../../ir/canonical/validation/validate" in={$in.program} />

    <If on={!$ctx.validate}>
        <Return value={false} />
    </If>

    <Call module="validation/surface" in={$in} />

    <If on={!$ctx.surface}>
        <Return value={false} />
    </If>

    <Call
        fn="validation/stores"
        in={{
            tables: $in.program.context.functions.stores
        }}
    />

    <Return value={$ctx.stores} />
</Module>
