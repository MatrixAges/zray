import integers from "std:integer"
import { load_numerator, load_denominator } from "core/bytes/index/const"
import memory from "memory"
import columns from "memory/columns"

import compare from "../../../ir/compare/linked/compare"
import append from "./append"
import { Action, Status } from "./model"
import select from "./select"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { source, registry, range } = in
    const { published, buckets } = registry

    return loop({
        count: registry.count,
        space: registry.space,
        capacity: registry.capacity,
        limit: registry.capacity * load_numerator / load_denominator,
        next: 0,
        status: Status.Done
    }, {
        while: state => state.status == Status.Done && state.next < in.end,
        next: state => {
            const row = state.next
            const identity = memory.readTextColumn(source.identity, row)
            const version = columns.readColumnU32(source.schema_version, row)

            const selected = select({
                published,
                buckets,
                range,
                capacity: state.capacity,
                identity,
                version,
                id: columns.readColumnU32(source.function, row)
            })

            if (selected.action == Action.Append) {
                const cursor = append({
                    registry,
                    count: state.count,
                    space: state.space,
                    capacity: state.capacity,
                    limit: state.limit,
                    identity,
                    version,
                    slot: selected.slot,
                    function: selected.function
                })

                state.count = cursor.count
                state.space = cursor.space
                state.capacity = cursor.capacity
                state.limit = cursor.limit
            } else if (selected.action == Action.Compare) {
                const equivalent = compare({
                    functions: in.functions,
                    left_row: integers.widen(selected.previous),
                    right_row: integers.widen(selected.function),
                    version
                })

                if (!equivalent) {
                    state.status = Status.Conflict
                }
            } else {
                state.status = match selected.action {
                    Action.Conflict => Status.Conflict,
                    Action.InvalidModule => Status.InvalidModule,
                    _ => Status.Done
                }
            }

            state.next += 1
        },
        return: state => state.status
    })
}
