import { load_numerator, load_denominator } from "core/bytes/index/const"
import memory from "memory"
import columns from "memory/columns"

import append from "./append"
import { Action, Status } from "./model"
import select from "./select"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { source, published, buckets, range } = in

    const zero: u32 = 0

    return loop({
        cursor: {
            count: in.count,
            space: in.space,
            capacity: in.capacity,
            limit: in.capacity * load_numerator / load_denominator
        },
        next: in.start,
        status: Status.Done,
        previous: 0,
        function: zero
    }, {
        while: state => state.status == Status.Done && state.next < in.end,
        next: state => {
            const row = state.next
            const identity = memory.readTextColumn(source.identity, row)
            const version = columns.readColumnU32(source.schema_version, row)

            const selected = select({
                published,
                buckets,
                range,
                capacity: state.cursor.capacity,
                identity,
                version,
                id: columns.readColumnU32(source.function, row)
            })

            if (selected.action == Action.Append) {
                state.cursor = append({
                    registry: in,
                    cursor: state.cursor,
                    identity,
                    version,
                    selected
                })
            } else {
                state.status = match selected.action {
                    Action.Compare => Status.Compare,
                    Action.Conflict => Status.Conflict,
                    Action.InvalidModule => Status.InvalidModule,
                    _ => Status.Done
                }

                state.previous = selected.previous
                state.function = selected.function
            }

            state.next += 1
        },
        return: state => ({
            status: state.status,
            next: state.next,
            count: state.cursor.count,
            previous: state.previous,
            function: state.function
        })
    })
}
