import type { U32Buffer, U32Scratch, U64Buffer } from "memory"
import type { RowGrowth } from "memory/columns"
import type { Functions } from "../../../ir/compare/linked/model"
import type { Source, Target } from "../../link/source/initializers/model"

export enum Action {
    Append,
    Reuse,
    Compare,
    Conflict,
    InvalidModule
}

export enum Status {
    Done,
    Conflict,
    InvalidModule
}

export type Range = {
    first: u64,
    prefix: u64,
    count: u64,
    available: u64
}

export type Input = {
    source: Source,
    published: Source,
    target: Target,
    growth: RowGrowth,
    buckets: U32Buffer,
    scratch: U32Scratch,
    capacity: u64,
    range: Range,
    functions: Functions,
    own: bool,
    end: u64,
    count: u64,
    space: u64,
    progress: U64Buffer
}

export type Selection = {
    action: Action,
    previous: u32,
    slot: u64,
    function: u32
}

export type Output = Status

export type Cursor = {
    count: u64,
    space: u64,
    capacity: u64,
    limit: u64
}
