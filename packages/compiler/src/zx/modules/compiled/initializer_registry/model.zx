import type { Index } from "core/integer/wide_index/model"
import type { Functions } from "../../../ir/compare/linked/model"
import type { Source } from "../../link/source/initializers/model"

export enum Action {
    Append,
    Reuse,
    Compare,
    Conflict,
    InvalidModule
}

export enum Status {
    Done,
    Conflict,
    InvalidModule
}

export type Range = {
    first: u64,
    prefix: u64,
    count: u64,
    available: u64
}

export type Storage = {
    published: Source,
    buckets: u32[],
    capacity: u64,
    count: u64
}

export type Entry = {
    identity: string,
    version: u32,
    slot: u64,
    function: u32
}

export type Pending = {
    rows: Entry[],
    slots: Index,
    buckets?: u32[]
}

export type Input = {
    registry: Storage,
    source: Source,
    range: Range,
    functions: Functions,
    end: u64
}

export type Selection = {
    action: Action,
    previous: u32,
    slot: u64,
    function: u32
}

export type Output = {
    status: Status,
    rows: Entry[],
    buckets?: u32[]
}
