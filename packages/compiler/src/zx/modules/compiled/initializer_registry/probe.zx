import bytes from "std:bytes"
import integers from "std:integer"
import get from "core/integer/wide_index/get"
import memory from "memory"

import type { Pending, Storage } from "./model"

export type Input = {
    registry: Storage,
    pending: Pending,
    text: string
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { registry, pending, text } = in
    const { buckets } = pending

    const capacity = buckets == null ? registry.capacity : buckets.length

    if (capacity == 0) {
        return {
            slot: 0,
            entry: 0
        }
    }

    const mask = capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(text)), mask),
        entry: 0,
        found: false
    }, {
        while: state => !state.found,
        next: state => {
            const slot = state.slot
            const item = get({
                index: pending.slots,
                key: slot
            })
            const entry = match {
                buckets != null => integers.widen(buckets[slot]),
                item != null => registry.count + item + 1,
                _ => integers.widen(memory.readU32View(registry.buckets, slot))
            }
            const matches = match {
                entry == 0 => true,
                entry <= registry.count =>
                    memory.readTextColumn(registry.published.identity, entry - 1) == text,
                _ => pending.rows[entry - registry.count - 1].identity == text
            }

            if (matches) {
                state.entry = entry
                state.found = true
            } else {
                state.slot = integers.andBits(slot + 1, mask)
            }
        },
        return: state => state.omit(["found"])
    })
}
