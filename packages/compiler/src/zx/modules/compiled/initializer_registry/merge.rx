<Module>
    <Type from="model" as="Registry" />

    <Args in={Registry.Input} out={Registry.Output} />

    <Call fn="scan" in={$in.omit(["scratch"])} />

    <If on={$ctx.scan.status == Registry.Status.Rehash}>
        <Call
            fn="../../../../core/bytes/index/borrowed/refresh"
            in={{
                keys: $in.published.identity,
                buckets: $in.buckets,
                scratch: $in.scratch,
                capacity: $in.capacity,
                indexed: $ctx.scan.count,
                count: $ctx.scan.count,
                required: $ctx.scan.count + 1
            }}
        />
    </If>

    <Return value={$ctx.scan} />
</Module>
