import bytes from "std:bytes"
import integers from "std:integer"
import strings from "std:string"
import probe from "core/bytes/index/borrowed/probe"
import refresh from "core/bytes/index/borrowed/refresh"
import { load_numerator, load_denominator } from "core/bytes/index/const"
import { growRows } from "core/row_buffer"
import memory from "memory"

import type { Cursor as Output, Storage } from "./model"

export type Entry = {
    identity: string,
    version: u32,
    slot: u64,
    function: u32
}

export type Input = Output & Entry & {
    registry: Storage
}

export default function (in: Input): Output {
    const { registry, identity, version } = in
    const { buckets, published, target } = registry

    const index = in.count

    const space = match {
        index == in.space => growRows([
            registry.growth,
            index
        ]),
        _ => in.space
    }

    const capacity = match {
        index == in.limit => refresh({
            keys: published.identity,
            buckets,
            scratch: registry.scratch,
            capacity: in.capacity,
            indexed: index,
            count: index,
            required: index + 1
        }),
        _ => in.capacity
    }

    const slot = match {
        capacity == in.capacity => in.slot,
        _ => probe({
            keys: published.identity,
            buckets: memory.u32View(buckets, null),
            capacity,
            text: identity
        }).slot
    }

    const name = registry.own ? strings.copy(identity) : identity

    memory.writeColumnBytes(target.identity, index, bytes.fromText(name))
    memory.writeColumnU32(target.schema_version, index, version)
    memory.writeColumnU32(target.function, index, in.function)
    memory.writeU32(buckets, slot, integers.narrow(index + 1))
    memory.writeU64(registry.progress, 0, index + 1)

    return {
        count: index + 1,
        space,
        capacity,
        limit: capacity * load_numerator / load_denominator
    }
}
