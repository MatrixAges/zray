import integers from "std:integer"
import { load_numerator, load_denominator } from "core/bytes/index/const"
import insert from "core/integer/wide_index/insert"

import rebuild from "./rebuild"

import type { Entry, Pending as Output, Storage } from "./model"

export type Input = {
    registry: Storage,
    pending: Output,
    entry: Entry
}

export default function (in: Input): Output {
    const { registry, pending, entry } = in
    const { buckets } = pending

    const capacity = buckets == null ? registry.capacity : buckets.length
    const count = registry.count + pending.rows.length + 1
    const rows = pending.rows.push(entry)[0]

    if (count > capacity * load_numerator / load_denominator) {
        return {
            ...pending,
            rows,
            buckets: rebuild({
                registry,
                pending: {
                    ...pending,
                    rows
                }
            })
        }
    }

    if (buckets != null) {
        return {
            ...pending,
            rows,
            buckets: buckets.with(entry.slot, integers.narrow(count))
        }
    }

    const slots = insert({
        index: pending.slots,
        key: entry.slot
    })

    return {
        ...pending,
        rows,
        slots: slots.index
    }
}
