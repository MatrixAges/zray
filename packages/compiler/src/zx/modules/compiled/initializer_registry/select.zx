import integers from "std:integer"
import lookup from "core/bytes/index/borrowed/lookup"
import memory from "memory"
import columns from "memory/columns"

import decide from "../../../ir/compare/initializer/linked_action"
import { Output as Decision } from "../../../ir/compare/initializer/linked_action"
import { Action } from "./model"

import type { Range, Selection as Output, Storage } from "./model"

export type Input = Storage.Pick("published", "buckets") & {
    range: Range,
    capacity: u64,
    rebuilt?: u32[],
    identity: string,
    version: u32,
    id: u32
}

export default function (in: Input): Output {
    const { range, published, id } = in

    const index = integers.widen(id)

    const mapped = match {
        index < range.prefix => index,
        _ => range.first + (index - range.prefix)
    }

    if (index >= range.count || mapped >= range.available) {
        return {
            action: Action.InvalidModule,
            previous: 0,
            slot: 0,
            function: 0
        }
    }

    const function_id = integers.narrow(mapped)

    const found = lookup({
        keys: published.identity,
        buckets: memory.u32View(in.buckets, null),
        rebuilt: in.rebuilt,
        capacity: in.capacity,
        text: in.identity
    })

    if (found.entry == 0) {
        return {
            action: Action.Append,
            previous: 0,
            slot: found.slot,
            function: function_id
        }
    }

    const previous = found.entry - 1

    const previous_function = columns.readColumnU32(published.function, previous)

    const decision = decide({
        previous_version: columns.readColumnU32(published.schema_version, previous),
        previous_function,
        version: in.version,
        function: function_id
    })

    return {
        action: match decision {
            Decision.Compare => Action.Compare,
            Decision.Conflict => Action.Conflict,
            _ => Action.Reuse
        },
        previous: previous_function,
        slot: found.slot,
        function: function_id
    }
}
