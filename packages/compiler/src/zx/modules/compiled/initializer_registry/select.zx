import integers from "std:integer"
import columns from "memory/columns"

import decide from "../../../ir/compare/initializer/linked_action"
import { Output as Decision } from "../../../ir/compare/initializer/linked_action"
import { Action } from "./model"
import probe from "./probe"

import type { Pending, Range, Selection as Output, Storage } from "./model"

export type Input = {
    registry: Storage,
    pending: Pending,
    range: Range,
    identity: string,
    version: u32,
    id: u32
}

export default function (in: Input): Output {
    const { range, registry, pending, id } = in
    const { published } = registry

    const index = integers.widen(id)

    const mapped = match {
        index < range.prefix => index,
        _ => range.first + (index - range.prefix)
    }

    if (index >= range.count || mapped >= range.available) {
        return {
            action: Action.InvalidModule,
            previous: 0,
            slot: 0,
            function: 0
        }
    }

    const function_id = integers.narrow(mapped)

    const found = probe({
        registry,
        pending,
        text: in.identity
    })

    if (found.entry == 0) {
        return {
            action: Action.Append,
            previous: 0,
            slot: found.slot,
            function: function_id
        }
    }

    const previous = found.entry - 1

    const previous_function = match {
        previous < registry.count =>
            columns.readColumnU32(published.function, previous),
        _ => pending.rows[previous - registry.count].function
    }

    const previous_version = match {
        previous < registry.count =>
            columns.readColumnU32(published.schema_version, previous),
        _ => pending.rows[previous - registry.count].version
    }

    const decision = decide({
        previous_version,
        previous_function,
        version: in.version,
        function: function_id
    })

    return {
        action: match decision {
            Decision.Compare => Action.Compare,
            Decision.Conflict => Action.Conflict,
            _ => Action.Reuse
        },
        previous: previous_function,
        slot: found.slot,
        function: function_id
    }
}
