import type { Table } from "core/bytes/index/borrowed/wide_slot"
import type { ReadColumn } from "memory"

export enum Status {
    Valid,
    InvalidSpecifier,
    InvalidExternalSpecifier,
    InvalidNativeInterfacePath,
    InvalidNativeModule,
    ReservedNativeModule,
    DuplicateNativeModule
}

export type Modules = {
    index: Table,
    count: u64,
    paths: ReadColumn,
    headers: ReadColumn
}
