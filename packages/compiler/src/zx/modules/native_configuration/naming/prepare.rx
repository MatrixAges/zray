<Module>
    <Type from="model" as="Naming" />

    <Args in={Naming.Prepare} out={void} />

    <Loop on={$in.running}>
        <Call
            module="next_name"
            in={{
                ...$in,
                index: 0,
                running: $in.local.length != 0
            }}
        />
    </Loop>
</Module>
