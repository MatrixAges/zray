import slot from "core/bytes/index/borrowed/wide_slot"

import type { Registry } from "./model"

export type Input = {
    registry: Registry,
    value: string
}

export type Output = string?

export default function (in: Input): Output {
    const { registry, value } = in

    const found = slot({
        ...registry.index,
        name: value
    })

    return match found.entry {
        0 => null,
        _ => registry.names[found.entry - 1]
    }
}
