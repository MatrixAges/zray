<Module>
    <Type from="model" as="Naming" />

    <Args in={Naming.Request} out={string} />

    <If on={$in.scope.compiled}>
        <Call
            fn="../../compiled/identity/native_name"
            in={{
                instance: $in.scope.owner,
                value: $in.value
            }}
        />

        <Return value={$ctx.native_name} />
    </If>

    <If on={$in.scope.owner == $in.scope.entry_root}>
        <Return value={$in.value} />
    </If>

    <Call
        fn="package_name"
        in={{
            owner: $in.scope.owner,
            value: $in.value
        }}
    />

    <Return value={$ctx.package_name} />
</Module>
