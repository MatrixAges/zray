<Module>
    <Type from="model" as="Naming" />

    <Args in={Naming.Traversal} out={Naming.Traversal} />

    <Call
        fn="columns.readTextColumn"
        in={[
            $in.local.items,
            $in.index
        ]}
    />

    <Call
        module="backend"
        in={{
            scope: $in.scope,
            value: $ctx.readTextColumn
        }}
    />

    <Call
        fn="publish"
        in={{
            state: $in,
            name: $ctx.backend
        }}
    />

    <Return value={$ctx.publish} />
</Module>
