import integers from "std:integer"

export type Input = {
    origin_ids: u32[],
    base_labels: string[],
    delta_labels: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { origin_ids, base_labels, delta_labels } = in

    const count = base_labels.length

    return origin_ids.map(
        origin_id => {
            const id = integers.widen(origin_id)

            return match {
                id < count => base_labels[id],
                _ => delta_labels[id - count]
            }
        }
    )[0]
}
