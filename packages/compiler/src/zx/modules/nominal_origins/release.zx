import { completed_members, completed_owners } from "./const"

export type Input = u64

export enum Output {
    None,
    Owners,
    OwnersAndMembers
}

export default function (in: Input): Output {
    const completed = in

    return match {
        completed >= completed_members => Output.OwnersAndMembers,
        completed >= completed_owners => Output.Owners,
        _ => Output.None
    }
}
