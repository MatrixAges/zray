import { releaseSlots } from "core/owned_text"

import { completed_members, completed_owners } from "./const"

import type { Release as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { allocator, completed, owners_out, members_out } = in

    if (completed >= completed_owners) {
        releaseSlots({
            allocator,
            target: owners_out
        })
    }

    if (completed >= completed_members) {
        releaseSlots({
            allocator,
            target: members_out
        })
    }
}
