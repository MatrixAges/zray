import type { Bindings } from "core/type_table/nominal"

export type Input = {
    source: Bindings,
    names: string[],
    labels?: string[],
    own_origins: bool
}

export enum Column {
    Owners,
    Members,
    Names
}

export type Publication = {
    column: Column,
    source: string[],
    own: bool
}
