<Store name="nominal_origin_materialization_progress" version={1}>
    <Type from="model" as="Origin" />

    <Object name="state">
        <Field name="column" type={Origin.Column} value={Origin.Column.Owners} />
        <Field name="source" type={string[]} value={[]} />
        <Field name="own" type={bool} value={false} />
    </Object>
</Store>
