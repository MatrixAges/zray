import { into } from "core/owned_text"
import memory from "memory"

import bindNames from "./bind_names"
import { completed_members, completed_owners, progress_slot } from "./const"

import type { Bindings } from "core/type_table/nominal"
import type { Allocator, StringBuffer, U64Buffer } from "memory"

export type Input = {
    allocator: Allocator,
    source: Bindings,
    names: string[],
    labels?: string[],
    own_origins: bool,
    owners_out: StringBuffer,
    members_out: StringBuffer,
    names_out: StringBuffer,
    progress: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { allocator, source, labels, own_origins } = in

    if (own_origins) {
        into({
            allocator,
            target: in.owners_out,
            source: source.owners
        })

        memory.writeU64(in.progress, progress_slot, completed_owners)

        into({
            allocator,
            target: in.members_out,
            source: source.members
        })

        memory.writeU64(in.progress, progress_slot, completed_members)
    }

    if (labels == null) {
        into({
            allocator,
            target: in.names_out,
            source: in.names
        })

        return
    }

    bindNames({
        origin_ids: source.ids,
        base_labels: labels,
        delta_labels: [],
        origin_names_out: in.names_out
    })
}
