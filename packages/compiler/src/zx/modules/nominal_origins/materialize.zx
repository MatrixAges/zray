import memory from "zig:compiler_memory"

import bindNames from "./bind_names"

import type { StringBuffer, U64Buffer } from "zig:compiler_memory"
import type { Bindings } from "core/type_table/nominal"

export type Input = {
    source: Bindings,
    names: string[],
    labels?: string[],
    own_origins: bool,
    owners_out: StringBuffer,
    members_out: StringBuffer,
    names_out: StringBuffer,
    progress: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { source, labels, own_origins } = in

    if (own_origins) {
        memory.copyStrings(in.owners_out, source.owners)
        memory.writeU64(in.progress, 0, 1)
        memory.copyStrings(in.members_out, source.members)
        memory.writeU64(in.progress, 0, 2)
    }

    if (labels == null) {
        memory.copyStrings(in.names_out, in.names)

        return
    }

    bindNames({
        origin_ids: source.ids,
        base_labels: labels,
        delta_labels: [],
        origin_names_out: in.names_out
    })
}
