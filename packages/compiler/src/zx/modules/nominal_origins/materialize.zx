import integers from "std:integer"
import memory from "std:memory"

import type { StringBuffer, U64Buffer } from "std:memory"
import type { Bindings } from "core/type_table/nominal"

export type Input = {
    source: Bindings,
    names: string[],
    labels?: string[],
    own_origins: bool,
    owners_out: StringBuffer,
    members_out: StringBuffer,
    names_out: StringBuffer,
    progress: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { source, labels, own_origins } = in

    if (own_origins) {
        memory.copyStrings(in.owners_out, source.owners)
        memory.writeU64(in.progress, 0, 1)
        memory.copyStrings(in.members_out, source.members)
        memory.writeU64(in.progress, 0, 2)
    }

    if (labels == null) {
        memory.copyStrings(in.names_out, in.names)

        return
    }

    const result = loop(0, {
        while: index => index < source.ids.length,
        next: index => {
            const id = integers.widen(source.ids[index])

            memory.writeString(in.names_out, index, labels[id])
            index += 1
        }
    })
}
