<Module>
    <Type from="model" as="Origin" />

    <Args in={Origin.Input} out={void} />

    <Store from="progress" as="progress" />

    <Call
        fn="stage"
        in={{
            column: Origin.Column.Owners,
            source: $in.source.owners,
            own: $in.own_origins
        }}
        setter={[$store.progress.state]}
    />

    <Task name="members">
        <Call
            fn="stage"
            in={{
                column: Origin.Column.Members,
                source: $in.source.members,
                own: $in.own_origins
            }}
            setter={[$store.progress.state]}
        />
    </Task>

    <If on={$in.labels != null}>
        <Call
            fn="bind_names"
            in={{
                origin_ids: $in.source.ids,
                base_labels: $in.labels,
                delta_labels: []
            }}
        />

        <Call
            fn="stage"
            in={{
                column: Origin.Column.Names,
                source: $ctx.bind_names,
                own: false
            }}
            setter={[$store.progress.state]}
        />

        <Else>
            <Call
                fn="stage"
                in={{
                    column: Origin.Column.Names,
                    source: $in.names,
                    own: true
                }}
                setter={[$store.progress.state]}
            />
        </Else>
    </If>
</Module>
