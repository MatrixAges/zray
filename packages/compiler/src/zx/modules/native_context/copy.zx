import strings from "std:string"
import memory from "zig:compiler_memory"

import copyNames from "../copy_names"
import copyOptionalName from "../copy_optional_name"

import type {
    OptionalStringBuffer,
    StringBuffer,
    StringListBuffer,
    U32ListBuffer
} from "zig:compiler_memory"
import type { Modules } from "core/native_module_table/model"

export type Destination = {
    identities: OptionalStringBuffer,
    import_names: StringBuffer,
    specifiers: StringBuffer,
    type_ids: U32ListBuffer,
    type_names: StringListBuffer,
    type_namespaces: StringListBuffer
}

export type Input = {
    source: Modules,
    destination: Destination
}

export type Output = void

export default function (in: Input): Output {
    const { source, destination } = in

    const copied = loop(0, {
        while: index => index < source.specifiers.length,
        next: index => {
            memory.writeString(
                destination.specifiers,
                index,
                strings.copy(source.specifiers[index])
            )
            memory.writeOptionalString(
                destination.identities,
                index,
                copyOptionalName(source.identities[index])
            )
            memory.writeString(
                destination.import_names,
                index,
                strings.copy(source.import_names[index])
            )
            memory.writeStringList(
                destination.type_namespaces,
                index,
                copyNames(source.type_namespaces[index])
            )
            memory.writeU32List(
                destination.type_ids,
                index,
                source.type_ids[index].slice()
            )
            memory.writeStringList(
                destination.type_names,
                index,
                copyNames(source.type_names[index])
            )

            index += 1
        }
    })
}
