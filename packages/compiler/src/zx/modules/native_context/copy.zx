import strings from "std:string"

import copyNames from "../copy_names"
import copyOptionalName from "../copy_optional_name"

import type { Modules } from "core/native_module_table/model"

export type Input = Modules

export type Output = Modules

export default function (in: Input): Output {
    return {
        identities: in.identities.map(value => copyOptionalName(value))[0],
        import_names: in.import_names.map(value => strings.copy(value))[0],
        specifiers: in.specifiers.map(value => strings.copy(value))[0],
        type_ids: in.type_ids.map(ids => ids.slice())[0],
        type_names: in.type_names.map(names => copyNames(names))[0],
        type_namespaces: in.type_namespaces.map(names => copyNames(names))[0]
    }
}
