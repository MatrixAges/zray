import type { Ownership } from "core/symbol_table/model"
import type { ForwardedBody } from "memory/columns"

export type Parameter = {
    name: string,
    type_id: u32,
    ownership: Ownership,
    span_start: u64,
    span_end: u64
}

export type Input = {
    parameter: Parameter,
    input_type: u32,
    output_type: u32,
    function_id: u32,
    unit: bool,
    store_types: u32[]
}

export type Output = ForwardedBody
