import { Chain } from "./model"

import type { Trees } from "./model"

export type Input = {
    trees: Trees,
    edges: u64[],
    kind: Chain,
    head: u64,
    count: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const expressions = in.trees.expressions
    const blocks = in.trees.blocks
    const kind = in.kind
    const empty: u64[] = []

    const reversed = loop({
        row: in.head,
        remaining: in.count,
        items: empty
    }, {
        while: state => state.remaining != 0,
        next: state => {
            const row = state.row - 1

            state.items = state.items.push(row)[0]
            state.remaining -= 1

            state.row = match kind {
                Chain.Arguments => expressions.items[row].previous,
                Chain.Fields => expressions.fields[row].previous,
                Chain.Parameters => expressions.parameters[row].previous,
                Chain.Parts => expressions.parts[row].previous,
                Chain.Arms => expressions.arms[row].previous,
                Chain.Statements => blocks.items[row].previous,
                Chain.Names => blocks.names[row].previous,
                Chain.Cases => blocks.cases[row].previous,
                _ => 0
            }
        },
        return: state => state.items
    })

    return loop({
        remaining: reversed.length,
        edges: in.edges
    }, {
        while: state => state.remaining != 0,
        next: state => {
            state.remaining -= 1
            state.edges = state.edges.push(reversed[state.remaining])[0]
        },
        return: state => state.edges
    })
}
