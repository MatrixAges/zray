<Module>
    <Type from="model" as="Order" />

    <Args in={Order.Input} out={Order.Output} />

    <Call fn="expressions" in={$in} />

    <Call
        fn="body"
        in={{
            trees: $in,
            expressions: $ctx.expressions.expressions,
            edges: $ctx.expressions.edges
        }}
    />

    <Return value={$ctx.body} />
</Module>
