import edges from "./edges"
import chain from "./expression_chain"
import { Chain } from "./model"

import type { ExpressionsOutput as Output, Input } from "./model"

export default function (in: Input): Output {
    const nodes = in.expressions.nodes
    const empty_expressions: u64[] = []
    const empty_edges: u64[] = []

    return loop({
        row: 0,
        expressions: empty_expressions,
        edges: empty_edges
    }, {
        while: state => state.row < nodes.length,
        next: state => {
            const node = nodes[state.row]
            const kind = chain(node.kind)

            state.expressions = state.expressions.push(state.edges.length)[0]

            if (kind != Chain.Empty && node.count != 0) {
                state.edges = edges({
                    trees: in,
                    edges: state.edges,
                    kind,
                    head: node.head,
                    count: node.count
                })
            }

            state.row += 1
        },
        return: state => ({
            expressions: state.expressions,
            edges: state.edges
        })
    })
}
