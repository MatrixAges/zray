import edges from "./edges"
import { Chain } from "./model"
import chain from "./statement_chain"

import type { Output, Trees } from "./model"

export type Input = {
    trees: Trees,
    expressions: u64[],
    edges: u64[]
}

export default function (in: Input): Output {
    const trees = in.trees
    const blocks = trees.blocks
    const block_rows = blocks.blocks
    const empty_blocks: u64[] = []

    const block_state = loop({
        row: 0,
        blocks: empty_blocks,
        edges: in.edges
    }, {
        while: state => state.row < block_rows.length,
        next: state => {
            const block = block_rows[state.row]

            state.blocks = state.blocks.push(state.edges.length)[0]

            if (block.count != 0) {
                state.edges = edges({
                    trees,
                    edges: state.edges,
                    kind: Chain.Statements,
                    head: block.head,
                    count: block.count
                })
            }

            state.row += 1
        },
        return: state => ({
            blocks: state.blocks,
            edges: state.edges
        })
    })

    const statements = blocks.statements
    const empty_statements: u64[] = []

    const statement_state = loop({
        row: 0,
        statements: empty_statements,
        edges: block_state.edges
    }, {
        while: state => state.row < statements.length,
        next: state => {
            const statement = statements[state.row]
            const kind = chain(statement.kind)

            state.statements = state.statements.push(state.edges.length)[0]

            if (kind != Chain.Empty && statement.count != 0) {
                state.edges = edges({
                    trees,
                    edges: state.edges,
                    kind,
                    head: statement.head,
                    count: statement.count
                })
            }

            state.row += 1
        },
        return: state => ({
            statements: state.statements,
            edges: state.edges
        })
    })

    const names = blocks.names
    const empty_patterns: u64[] = []

    const pattern_state = loop({
        row: 0,
        patterns: empty_patterns,
        edges: statement_state.edges
    }, {
        while: state => state.row < names.length,
        next: state => {
            const name = names[state.row]

            state.patterns = state.patterns.push(state.edges.length)[0]

            if (name.count != 0) {
                state.edges = edges({
                    trees,
                    edges: state.edges,
                    kind: Chain.Names,
                    head: name.head,
                    count: name.count
                })
            }

            state.row += 1
        },
        return: state => ({
            patterns: state.patterns,
            edges: state.edges
        })
    })

    return {
        expressions: in.expressions,
        blocks: block_state.blocks,
        statements: statement_state.statements,
        patterns: pattern_state.patterns,
        edges: pattern_state.edges
    }
}
