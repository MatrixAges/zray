import type { BlockTree } from "../../../parser/body/model"
import type { ExprTree } from "../../../parser/expressions/state/model"

export enum Chain {
    Empty,
    Arguments,
    Fields,
    Parameters,
    Parts,
    Arms,
    Statements,
    Names,
    Cases
}

export type Trees = {
    expressions: ExprTree,
    blocks: BlockTree
}

export type ExpressionsOutput = {
    expressions: u64[],
    edges: u64[]
}

export type Input = Trees

export type Output = {
    expressions: u64[],
    blocks: u64[],
    statements: u64[],
    patterns: u64[],
    edges: u64[]
}
