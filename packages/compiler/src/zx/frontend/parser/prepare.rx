<Module>
    <Type from="expressions/prepare/model" as="Model" />
    <Type from="../storage" as="Storage" />

    <Args in={Storage.Input} out={Model.PreparedInput} />

    <Call module="templates/prepare" in={$in} />

    <Call fn="expressions/prepare/scan" in={$ctx.prepare.lexed.tokens} />
    <Call fn="expressions/prepare/interpolations" in={$ctx.prepare.interpolations} />

    <Return
        value={{
            source: $in.source,
            placement: $in.placement,
            lexical: $ctx.prepare,
            hints: $ctx.scan,
            interpolation_hints: $ctx.interpolations
        }}
    />
</Module>
