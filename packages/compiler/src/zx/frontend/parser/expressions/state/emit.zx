import { max_nesting_depth } from "core/const"
import memory from "memory"

import { Phase } from "./model"

import type { ExprState, ExprNode } from "./model"

export type Input = {
    state: ExprState,
    node: ExprNode
}

export type Output = ExprState

export default function (in: Input): Output {
    if (in.node.depth > max_nesting_depth) {
        const diagnostic = {
            code: "unsupported",
            start: in.node.span.start,
            end: in.node.span.end,
            message: "expression nesting exceeds 256 levels"
        }

        return {
            prepared: in.state.prepared,
            tree: in.state.tree,
            types: in.state.types,
            frames: in.state.frames,
            control: {
                ...in.state.control,
                phase: Phase.Done,
                diagnostic: diagnostic
            }
        }
    }

    const result = in.state.tree.nodes.length

    const placement = in.state.prepared.placement

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.rows)
    }

    const node = match {
        placement != null => {
            ...in.node,
            span: {
                start: in.node.span.start,
                end: in.node.span.end
            },
            name: {
                start: in.node.name.start,
                end: in.node.name.end
            }
        },
        _ => in.node
    }

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.scratch)
    }

    const nodes = in.state.tree.nodes.push(node)[0]

    return {
        prepared: in.state.prepared,
        tree: {
            nodes: nodes,
            items: in.state.tree.items,
            fields: in.state.tree.fields,
            parameters: in.state.tree.parameters,
            parts: in.state.tree.parts,
            arms: in.state.tree.arms
        },
        types: in.state.types,
        frames: in.state.frames,
        control: {
            ...in.state.control,
            result
        }
    }
}
