import terminal from "../../../lexer/terminal"

import type { Boundary } from "../model"
import type { State } from "./model"

export type Input = State

export type Output = Boundary

export default function (in: Input): Output {
    return {
        lexed: {
            tokens: terminal(in.lexer),
            comments: in.lexer.comments,
            diagnostic: in.lexer.diagnostic
        },
        token_templates: in.graph.token_templates.push(0)[0],
        templates: in.graph.templates,
        parts: in.graph.parts,
        events: in.graph.events
    }
}
