<Module>
    <Type from="empty" as="Empty" />
    <Type from="../../../storage" as="Storage" />

    <Args in={Storage.Input} out={Empty.Output} />

    <Call fn="../../../lexer/utf8/validate" in={$in.source} />

    <If on={$ctx.validate}>
        <Call fn="initial" in={$in} />

        <Call
            fn="bytes"
            in={{
                source: $in.source,
                state: $ctx.initial
            }}
        />

        <Call fn="flush" />
        <Call fn="finish" />

        <If on={$ctx.finish.lexer.diagnostic.message == ""}>
            <Call fn="publish" in={$ctx.finish} />

            <Return value={$ctx.publish} />

            <Else>
                <Call fn="empty" in={$ctx.finish.lexer.diagnostic} />

                <Return value={$ctx.empty} />
            </Else>
        </If>

        <Else>
            <Call
                fn="empty"
                in={{
                    code: "lexical",
                    start: 0,
                    end: $in.source.length,
                    message: "source must be valid UTF-8"
                }}
            />

            <Return value={$ctx.empty} />
        </Else>
    </If>
</Module>
