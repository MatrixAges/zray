import initial from "../../../lexer/initial"

import type { Input as LexicalInput } from "../../../lexer/storage"
import type { Template, Part, Event } from "../model"
import type { State, Frame } from "./model"

export type Input = LexicalInput

export type Output = State

export default function (in: Input): Output {
    const templates: Template[] = []
    const parts: Part[] = []
    const events: Event[] = []
    const frames: Frame[] = []
    const token_templates: u64[] = []

    return {
        lexer: initial({
            start: 0,
            end: in.source.length,
            placement: in.placement
        }),
        graph: {
            templates,
            parts,
            events,
            frames,
            interpolations: 0,
            token_templates
        }
    }
}
