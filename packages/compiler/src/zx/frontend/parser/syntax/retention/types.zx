import rows from "./rows"

import type { TypeInput as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { tree, layout } = in

    return rows([
        tree.nodes.length,
        layout.nodes
    ]) +
        rows([
            tree.fields.length,
            layout.fields
        ]) +
        rows([
            tree.items.length,
            layout.items
        ])
}
