import rows from "./rows"

import type { OrderInput as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { tree, layout } = in

    return rows([
        tree.heads.length,
        layout.heads
    ]) +
        rows([
            tree.fields.length,
            layout.fields
        ]) +
        rows([
            tree.items.length,
            layout.items
        ])
}
