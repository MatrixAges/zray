import { Keyword } from "../../lexer/keyword_model"
import { Kind, Symbol } from "../../lexer/token_model"
import { Phase } from "./model"

import type { Placement } from "../../storage"
import type { State, Node, Field, Item, Frame } from "./model"

export type Input = {
    start: u64,
    depth: u64,
    placement?: Placement
}

export type Output = State

export default function (in: Input): Output {
    const nodes: Node[] = []
    const fields: Field[] = []
    const items: Item[] = []
    const frames: Frame[] = []

    return {
        tree: {
            nodes,
            fields,
            items
        },
        frames,
        control: {
            phase: Phase.Start,
            placement: in.placement,
            index: 0,
            start: in.start,
            depth: in.depth,
            result: 0,
            name: {
                start: 0,
                end: 0
            },
            member: {
                start: 0,
                end: 0
            },
            qualifier_end: 0,
            token: {
                kind: Kind.Eof,
                word: Keyword.Root,
                symbol: Symbol.None,
                span: {
                    start: 0,
                    end: 0
                },
                line_break: false,
                dollar: false
            },
            diagnostic: {
                code: "",
                start: 0,
                end: 0,
                message: ""
            }
        }
    }
}
