import memory from "memory"

import copyFrame from "./copy_frame"
import replaceFrame from "./replace_frame"

import type { Item, State } from "./model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const frame = copyFrame(in.frames[in.frames.length - 1])
    const head = in.tree.items.length + 1
    const count = frame.count + 1

    const placement = in.control.placement

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.rows)
    }

    const item: Item = {
        value: in.control.result,
        previous: frame.head
    }

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.scratch)
    }

    const items = in.tree.items.push(item)[0]

    const state = {
        tree: {
            nodes: in.tree.nodes,
            fields: in.tree.fields,
            items: items
        },
        frames: in.frames,
        control: in.control
    }

    return replaceFrame({
        state: state,
        frame: {
            ...frame,
            head,
            count
        }
    })
}
