import memory from "memory"

import head from "./head"

import type { U64Buffer } from "memory"
import type { Tree } from "../model"

export type Input = {
    tree: Tree,
    heads: U64Buffer,
    fields: U64Buffer,
    items: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { tree, heads, fields, items } = in

    const field_links = loop(0, {
        while: row => row < tree.fields.length,
        next: row => {
            memory.writeU64(fields, row, 0)

            const previous = tree.fields[row].previous

            if (previous != 0) {
                memory.writeU64(fields, previous - 1, row + 1)
            }

            row += 1
        }
    })

    const item_links = loop(0, {
        while: row => row < tree.items.length,
        next: row => {
            memory.writeU64(items, row, 0)

            const previous = tree.items[row].previous

            if (previous != 0) {
                memory.writeU64(items, previous - 1, row + 1)
            }

            row += 1
        }
    })

    const head_links = loop(0, {
        while: row => row < tree.nodes.length,
        next: row => {
            const first = head({
                tree,
                node: tree.nodes[row]
            })

            memory.writeU64(heads, row, first)
            row += 1
        }
    })
}
