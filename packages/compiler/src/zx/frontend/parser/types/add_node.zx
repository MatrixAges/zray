import memory from "memory"

import { TypeKind } from "./model"

import type { Span } from "../../lexer/token_model"
import type { Node, State } from "./model"

export type Input = {
    state: State,
    kind: TypeKind,
    name: Span,
    child: u64,
    head: u64,
    count: u64
}

export type Output = State

export default function (in: Input): Output {
    const result = in.state.tree.nodes.length

    const placement = in.state.control.placement

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.rows)
    }

    const name = match {
        placement != null => {
            start: in.name.start,
            end: in.name.end
        },
        _ => in.name
    }

    const node: Node = {
        kind: in.kind,
        name,
        child: in.child,
        head: in.head,
        count: in.count
    }

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.scratch)
    }

    const nodes = in.state.tree.nodes.push(node)[0]

    return {
        tree: {
            nodes: nodes,
            fields: in.state.tree.fields,
            items: in.state.tree.items
        },
        frames: in.state.frames,
        control: {
            ...in.state.control,
            result
        }
    }
}
