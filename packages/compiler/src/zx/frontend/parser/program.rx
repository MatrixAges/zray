<Module>
    <Type from="syntax/model" as="Model" />
    <Type from="../storage" as="Storage" />

    <Args in={Storage.Request} out={Model.Program} />

    <Call
        module="prepare"
        in={$in.pick([
            "source",
            "placement"
        ])}
    />

    <Call fn="program/imports" />

    <Call module="program/declarations" />

    <Call fn="program/header" />
    <Call fn="program/body" />
    <Call fn="program/diagnostic" />
    <Call fn="../diagnostic/present" />

    <Call
        fn="syntax/retention/select_lexical"
        in={{
            tokens: $ctx.prepare.lexical.lexed.tokens,
            comments: $ctx.prepare.lexical.lexed.comments,
            omit_tokens: $in.omit_tokens,
            omit_comments: $in.omit_comments
        }}
    />

    <Return
        value={{
            types: $ctx.body.body.expression.types.tree,
            type_order: {
                heads: [],
                fields: [],
                items: []
            },
            expressions: $ctx.body.body.expression.tree,
            blocks: $ctx.body.body.tree,
            ...$ctx.select_lexical,
            imports: $ctx.body.prefix.imports,
            import_names: $ctx.body.prefix.names,
            import_sources: $ctx.body.prefix.sources,
            declarations: $ctx.body.prefix.declarations,
            constants: $ctx.body.prefix.constants,
            members: $ctx.body.prefix.members,
            contracts: $ctx.body.contracts,
            has_store: $ctx.body.header.has_store,
            function_start: $ctx.body.prefix.function_start,
            function_name: $ctx.body.prefix.function_name,
            body: $ctx.body.prefix.present ? $ctx.body.body.control.result : null,
            diagnostic: $ctx.present
        }}
    />
</Module>
