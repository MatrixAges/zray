import memory from "memory"

import type { Span } from "../../../lexer/token_model"
import type { Placement } from "../../../storage"
import type { Block } from "../model"

export type Input = Span & {
    blocks: Block[],
    placement?: Placement,
    head: u64,
    count: u64
}

export type Output = Block[]

export default function (in: Input): Output {
    const placement = in.placement

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.rows)
    }

    const block: Block = {
        span: {
            start: in.start,
            end: in.end
        },
        head: in.head,
        count: in.count
    }

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.scratch)
    }

    return in.blocks.push(block)[0]
}
