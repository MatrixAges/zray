import { FrameKind, Phase } from "../model"
import appendBlock from "./append_block"
import frame from "./frame"

import type { State, Item, Statement } from "../model"

export type Input = State

export type Output = State

export default function (in: Input): Output {
    const popped = in.frames.pop()

    const parent = popped[1] ?? frame({
        kind: FrameKind.Root,
        start: 0,
        depth: 0
    })

    const phase = parent.phase

    const start = in.frame.start
    const end = in.expression.control.last_end

    if (in.frame.kind == FrameKind.Block) {
        const complete_phase =
            match {
                parent.kind == FrameKind.Root && in.suspended.length != 0 => Phase.Resume,
                _ => phase
            }

        const result = in.tree.blocks.length

        const blocks = appendBlock({
            blocks: in.tree.blocks,
            start,
            end,
            head: in.frame.head,
            count: in.frame.count
        })

        const next = match {
            parent.kind == FrameKind.Root => parent,
            parent.phase == Phase.IfElse => {
                ...parent,
                second: result
            },
            _ => {
                ...parent,
                third: result + 1
            }
        }

        const tree = {
            statements: in.tree.statements,
            blocks,
            items: in.tree.items,
            names: in.tree.names,
            cases: in.tree.cases
        }

        return {
            expression: in.expression,
            tree: tree,
            frames: popped[0],
            suspended: in.suspended,
            frame: next,
            control: {
                ...in.control,
                phase: complete_phase,
                result
            }
        }
    }

    const result = in.tree.statements.length

    const statement: Statement = {
        kind: in.frame.statement,
        span: {
            start,
            end
        },
        name: {
            start: in.frame.name.start,
            end: in.frame.name.end
        },
        annotation: in.frame.annotation,
        first: in.frame.first,
        second: in.frame.second,
        third: in.frame.third,
        head: in.frame.head,
        count: in.frame.count,
        operator: in.frame.operator
    }

    const item: Item = {
        value: result,
        previous: parent.kind == FrameKind.Statement ? 0 : parent.head
    }

    const head = in.tree.items.length + 1
    const statements = in.tree.statements.push(statement)[0]
    const items = in.tree.items.push(item)[0]

    if (parent.kind == FrameKind.Statement) {
        const block = in.tree.blocks.length + 1

        const blocks = appendBlock({
            blocks: in.tree.blocks,
            start,
            end,
            head,
            count: 1
        })

        const tree = {
            statements,
            blocks: blocks,
            items,
            names: in.tree.names,
            cases: in.tree.cases
        }

        return {
            expression: in.expression,
            tree: tree,
            frames: popped[0],
            suspended: in.suspended,
            frame: {
                ...parent,
                third: block
            },
            control: {
                ...in.control,
                phase: Phase.Publish
            }
        }
    }

    const count = parent.count + 1

    const next = {
        ...parent,
        head,
        count: count
    }

    const tree = {
        statements,
        blocks: in.tree.blocks,
        items,
        names: in.tree.names,
        cases: in.tree.cases
    }

    return {
        expression: in.expression,
        tree: tree,
        frames: popped[0],
        suspended: in.suspended,
        frame: next,
        control: {
            ...in.control,
            phase
        }
    }
}
