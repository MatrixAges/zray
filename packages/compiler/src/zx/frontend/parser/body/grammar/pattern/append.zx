import memory from "memory"

import { PatternKind, Phase } from "../../model"

import type { Span } from "../../../../lexer/token_model"
import type { State, Name } from "../../model"

export type Input = {
    state: State,
    span: Span,
    kind: PatternKind
}

export type Output = State

export default function (in: Input): Output {
    const state = in.state

    const span = {
        start: 0,
        end: 0
    }

    const key = match state.frame.pattern_kind {
        PatternKind.Object => state.frame.name,
        _ => span
    }

    const head = state.tree.names.length + 1

    const placement = state.expression.prepared.placement

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.rows)
    }

    const name: Name = {
        span: {
            start: in.span.start,
            end: in.span.end
        },
        previous: state.frame.head,
        kind: in.kind,
        key: {
            start: key.start,
            end: key.end
        },
        head: 0,
        count: 0
    }

    if (placement != null) {
        memory.selectAllocator(placement.scope, placement.scratch)
    }

    return {
        ...state,
        tree: {
            ...state.tree,
            names: state.tree.names.push(name)[0]
        },
        frame: {
            ...state.frame,
            head,
            count: state.frame.count + 1
        },
        control: {
            ...state.control,
            phase: Phase.PatternSeparator
        }
    }
}
