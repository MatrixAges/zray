<Module>
    <Type from="syntax/model" as="Model" />
    <Type from="../storage" as="Storage" />

    <Args in={Storage.Request} out={Model.Expression} />

    <Call
        module="expression"
        in={{
            source: $in.source,
            start: 0,
            depth: 0,
            minimum: 0,
            allow_lambda: true
        }}
    />

    <Call fn="expressions/finish" />

    <Call
        fn="syntax/retention/select_lexical"
        in={{
            tokens: $ctx.finish.tokens,
            comments: $ctx.finish.comments,
            omit_tokens: $in.omit_tokens,
            omit_comments: $in.omit_comments
        }}
    />

    <Return
        value={{
            ...$ctx.finish,
            ...$ctx.select_lexical
        }}
    />
</Module>
