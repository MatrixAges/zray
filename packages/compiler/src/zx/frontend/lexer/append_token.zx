import type { Span, Token } from "./token_model"

export type Draft = Token.Omit("span") & Span

export type Input = {
    tokens: Token[],
    token: Draft
}

export type Output = Token[]

export default function (in: Input): Output {
    const { token } = in

    const item: Token = {
        kind: token.kind,
        word: token.word,
        symbol: token.symbol,
        span: {
            start: token.start,
            end: token.end
        },
        line_break: token.line_break,
        dollar: token.dollar
    }

    return in.tokens.push(item)[0]
}
