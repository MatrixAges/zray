import memory from "memory"

import append from "./append_token"
import { kind_identifier, kind_keyword } from "./const"
import { Keyword } from "./keyword_model"
import keywordValue from "./keyword_value"
import tokenKind from "./token_kind"
import { Symbol } from "./token_model"

import type { LexerState } from "./model"
import type { Span } from "./token_model"

export type Input = {
    kind: string,
    start: u64,
    end: u64,
    comment: bool,
    state: LexerState
}

export type Output = LexerState

export default function (in: Input): Output {
    const placement = in.state.placement

    if (in.comment) {
        if (placement != null) {
            memory.selectAllocator(placement.scope, placement.comments)
        }

        const span: Span = {
            start: in.start,
            end: in.end
        }

        if (placement != null) {
            memory.selectAllocator(placement.scope, placement.scratch)
        }

        return {
            source_length: in.state.source_length,
            warmed: in.state.warmed,
            ahead_one: in.state.ahead_one,
            ahead_two: in.state.ahead_two,
            keyword_state: in.state.keyword_state,
            symbol: in.state.symbol,
            line_break: in.state.line_break,
            dollar: in.state.dollar,
            offset: in.state.offset,
            skip_until: in.state.skip_until,
            mode: in.state.mode,
            start: in.state.start,
            braces: in.state.braces,
            depth: in.state.depth,
            frames: in.state.frames,
            placement,
            number: in.state.number,
            tokens: in.state.tokens,
            comments: in.state.comments.push(span)[0],
            diagnostic: in.state.diagnostic
        }
    }

    const word =
        match {
            in.kind == kind_identifier ||
                in.kind == kind_keyword => keywordValue(
                    in.state.keyword_state
                ),
            _ => Keyword.Root
        }

    const kind = tokenKind(in.kind)

    const tokens = append({
        tokens: in.state.tokens,
        placement,
        token: {
            kind,
            word,
            symbol: in.state.symbol,
            start: in.start,
            end: in.end,
            line_break: in.state.tokens.length != 0 && in.state.line_break,
            dollar: in.state.dollar
        }
    })

    return {
        source_length: in.state.source_length,
        warmed: in.state.warmed,
        ahead_one: in.state.ahead_one,
        ahead_two: in.state.ahead_two,
        keyword_state: in.state.keyword_state,
        symbol: Symbol.None,
        line_break: false,
        dollar: false,
        offset: in.state.offset,
        skip_until: in.state.skip_until,
        mode: in.state.mode,
        start: in.state.start,
        braces: in.state.braces,
        depth: in.state.depth,
        frames: in.state.frames,
        placement,
        number: in.state.number,
        tokens,
        comments: in.state.comments,
        diagnostic: in.state.diagnostic
    }
}
