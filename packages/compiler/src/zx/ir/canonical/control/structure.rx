<Module>
    <Type from="../body/workspace" as="Workspace" />

    <Args in={Workspace.Input} out={bool} />

    <Call fn="validate" in={$in.control} />

    <If on={!$ctx.validate}>
        <Return value={false} />
    </If>

    <Call fn="../body/workspace" in={$in} />

    <Return value={$ctx.workspace} />
</Module>
