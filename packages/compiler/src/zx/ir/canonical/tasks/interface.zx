import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import type { Program } from "./model"

export type Input = Program

export type Output = bool

export default function (in: Input): Output {
    return kind(in.table.kinds[integers.widen(in.input_type)]) != Kind.Task &&
        kind(
            in.table.kinds[integers.widen(
                in.output_type
            )]
        ) != Kind.Task
}
