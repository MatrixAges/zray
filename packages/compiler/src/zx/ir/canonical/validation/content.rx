<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Program} out={bool?} />

    <If on={$in.constant_exports != null}>
        <Call
            fn="../../../analysis/constants/validation/rows"
            in={{
                constants: $in.constant_exports,
                types: {
                    base: $in.context.table,
                    delta: {
                        kinds: [],
                        first: [],
                        second: [],
                        labels: [],
                        children: [],
                        field_types: [],
                        field_names: [],
                        names: []
                    }
                }
            }}
        />

        <If on={!$ctx.rows}>
            <Return value={null} />
        </If>
    </If>

    <Call
        module="unit/check"
        in={{
            context: $in.context,
            unit: $in.unit
        }}
    />

    <If on={$ctx.check == null}>
        <Return value={null} />
    </If>

    <Call module="functions/check_all" in={$in.context} />

    <If on={$ctx.check_all == null}>
        <Return value={null} />
    </If>

    <Call
        fn="exports"
        in={{
            table: $in.context.table,
            fields: {
                borrowed: $in.exports
            }
        }}
    />

    <If on={!$ctx.exports}>
        <Return value={null} />
    </If>

    <Call fn="effects/walk" in={$in} />

    <If on={!$ctx.walk}>
        <Return value={null} />
    </If>

    <Return value={$ctx.check == true && $ctx.check_all == true} />
</Module>
