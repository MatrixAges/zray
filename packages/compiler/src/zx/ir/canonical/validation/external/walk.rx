<Module>
    <Type from="walk_model" as="External" />

    <Args in={External.Input} out={bool} />

    <Call
        module="advance"
        while="running"
        in={{
            ...$in,
            index: 0,
            valid: true,
            running: $in.functions.files.length != 0
        }}
    />

    <Return value={$ctx.advance.valid} />
</Module>
