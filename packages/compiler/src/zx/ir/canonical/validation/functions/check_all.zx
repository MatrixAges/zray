import check from "compiler/ir_function_check"

import type { Context } from "../model"

export type Input = Context

export type Output = bool?

export default function (in: Input): Output {
    return loop({
        context: in,
        index: in.verified,
        valid: true,
        stores_owned: true
    }, {
        while: current =>
            current.valid && current.index < current.context.functions.files.length,
        next: current => {
            const checked = check({
                context: current.context,
                index: current.index
            })
            current.valid = checked != null
            current.stores_owned = current.stores_owned && checked == true
            current.index += 1
        },
        return: state => state.valid ? state.stores_owned : null
    })
}
