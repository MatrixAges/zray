<Module>
    <Type from="../model" as="IR" />

    <Args in={IR.Context} out={bool?} />

    <Call
        module="advance"
        while="running"
        in={{
            context: $in,
            index: $in.verified,
            valid: true,
            stores_owned: true,
            running: $in.verified < $in.functions.files.length
        }}
    />

    <Return
        value={match $ctx.advance.valid {
            true => $ctx.advance.stores_owned,
            _ => null
        }}
    />
</Module>
