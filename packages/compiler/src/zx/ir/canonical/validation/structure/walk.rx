<Module>
    <Type from="../model" as="IR" />

    <Args in={IR.Context} out={bool} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                context: $in,
                index: $in.verified,
                valid: true,
                running: $in.verified < $in.functions.files.length
            }}
        />
    </Loop>

    <Return value={$ctx.advance.valid} />
</Module>
