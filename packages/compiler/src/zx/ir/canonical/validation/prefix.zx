import type { Prefix } from "../../../analysis/semantic/types/validation/shape"
import type { Context } from "./model"

export type Input = {
    context: Context,
    stores_owned: bool
}

export type Output = {
    functions: u64,
    types: Prefix,
    native: bool,
    stores_owned?: bool
}

export default function (in: Input): Output {
    const { context, stores_owned } = in

    return {
        functions: context.functions.files.length,
        types: {
            rows: context.table.kinds.length,
            children: context.table.children.length,
            fields: context.table.field_types.length,
            names: context.table.names.length
        },
        native: true,
        stores_owned: context.verified == 0 ? stores_owned : null
    }
}
