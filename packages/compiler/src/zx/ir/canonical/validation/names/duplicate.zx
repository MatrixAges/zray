import readName from "./name"

import type { Fields } from "./model"

export type Input = {
    fields: Fields,
    name: string,
    end: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { fields, name, end } = in

    return loop({
        row: 0,
        found: false
    }, {
        while: state => !state.found && state.row < end,
        next: state => {
            state.found = readName({
                fields,
                row: state.row
            }) == name
            state.row += 1
        },
        return: state => state.found
    })
}
