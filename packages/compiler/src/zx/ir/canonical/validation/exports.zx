import valid from "./names/valid"

import type { Table } from "core/type_table/model"
import type { Fields } from "./names/model"

export type Input = {
    table: Table,
    fields: Fields
}

export type Output = bool

export default function (in: Input): Output {
    return valid({
        fields: in.fields,
        type_count: in.table.kinds.length,
        kinds: in.table.kinds
    })
}
