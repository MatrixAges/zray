import { Ownership } from "core/symbol_table/model"

import type { Output as Result } from "../../../../ownership/result"

export type Input = {
    outcome: Result,
    declared: Ownership
}

export type Output = bool?

export default function (in: Input): Output {
    if (in.outcome.message != "") {
        return null
    }

    const conservative = in.declared == Ownership.Borrowed
    const matches = in.declared == in.outcome.ownership

    return conservative || matches ? in.outcome.stores_owned : null
}
