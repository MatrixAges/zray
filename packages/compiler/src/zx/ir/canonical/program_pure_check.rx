<Module>
    <Type from="expressions/validation/payloads" as="Payloads" />
    <Type from="functions/model" as="Model" />
    <Type from="stores/absent" as="Absent" />

    <Args
        in={{
            expressions: Payloads.Input,
            functions: Model.Functions,
            suffix?: Model.Functions,
            stores: Absent.Input
        }}
        out={bool}
    />

    <Call fn="./stores/absent" in={$in.stores} />

    <If on={$ctx.absent}>
        <Task name="prefix" out={$ctx.analyze}>
            <Call
                fn="functions/analyze"
                in={{
                    functions: $in.functions,
                    concurrent: false
                }}
            />
        </Task>

        <If on={$in.suffix != null}>
            <Call
                fn="functions/analyze"
                in={{
                    functions: $in.suffix,
                    prefix: $ctx.task.prefix,
                    concurrent: false
                }}
            />

            <Call
                fn="functions/calls"
                in={{
                    expressions: $in.expressions,
                    allowed: $ctx.task.prefix,
                    suffix: $ctx.analyze,
                    limit: $ctx.task.prefix.length + $ctx.analyze.length,
                    concurrent: false
                }}
            />

            <Return value={$ctx.calls} />
        </If>

        <Call
            fn="functions/calls"
            in={{
                expressions: $in.expressions,
                allowed: $ctx.task.prefix,
                limit: $ctx.task.prefix.length,
                concurrent: false
            }}
        />

        <Return value={$ctx.calls} />

        <Else>
            <Return value={false} />
        </Else>
    </If>
</Module>
