import integers from "std:integer"

import walk from "./walk"

import type { Control } from "core/control_table/model"

export type Input = {
    control: Control,
    root?: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { control } = in

    const count = control.block_first.length
    const block = in.root

    if (block == null) {
        return count == 0
    }

    const root = integers.widen(block)

    if (root >= count) {
        return false
    }

    if (count == 1) {
        return true
    }

    const initial: u32[] = []

    const depths = loop({
        index: 0,
        items: initial
    }, {
        while: state => state.index < count,
        next: state => {
            state.items = state.items.push(0)[0]
            state.index += 1
        },
        return: state => state.items
    })

    return walk({
        control,
        root,
        depths
    })
}
