import integers from "std:integer"
import memory from "memory"

import walk from "./walk"

import type { Control } from "core/control_table/model"
import type { U32Buffer, U32Scratch } from "memory"

export type Workspace = {
    depths: U32Buffer,
    scratch: U32Scratch,
    precise: bool
}

export type Input = {
    control: Control,
    root?: u32,
    workspace: Workspace
}

export type Output = bool

export default function (in: Input): Output {
    const { control, workspace } = in
    const { depths, scratch, precise } = workspace

    const count = control.block_first.length
    const block = in.root

    if (block == null) {
        return count == 0
    }

    const root = integers.widen(block)

    if (root >= count) {
        return false
    }

    if (count == 1) {
        return true
    }

    if (count > memory.u32BufferLength(depths)) {
        memory.growU32Scratch(scratch, count, precise)
    }

    memory.clearU32Buffer(depths, count)

    return walk({
        control,
        root,
        depths
    })
}
