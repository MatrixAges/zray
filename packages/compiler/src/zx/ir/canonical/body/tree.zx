import integers from "std:integer"

import walk from "./walk"

import type { Control } from "core/control_table/model"

export type Input = {
    control: Control,
    root?: u32
}

export type Output = bool

export default function (in: Input): Output {
    const block_id = in.root

    if (block_id == null) {
        return in.control.block_first.length == 0
    }

    const root = integers.widen(block_id)

    const blocks = in.control.block_first

    if (root >= blocks.length) {
        return false
    }

    if (blocks.length == 1) {
        return true
    }

    const depths: u32[] = blocks.map(value => 0)[0]

    return walk({
        control: in.control,
        root,
        depths
    }).valid
}
