import bytes from "std:bytes"

import optionalIds from "./optional_ids"
import compareTags from "./tags"
import texts from "./texts"

import type { ColumnPair as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const words = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.words.length,
        next: state => {
            const index = state.index

            state.equal = bytes.equals(in.left.words[index], in.right.words[index])
            state.index += 1
        },
        return: state => state.equal
    })

    if (!words) {
        return false
    }

    const tags = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < in.left.tags.length,
        next: state => {
            const index = state.index

            state.equal = compareTags({
                left: in.left.tags[index],
                right: in.right.tags[index],
                mask: in.masks[index]
            })
            state.index += 1
        },
        return: state => state.equal
    })

    if (!tags) {
        return false
    }

    const options = loop({
        column: 0,
        equal: true
    }, {
        while: state => state.equal && state.column < in.left.options.length,
        next: state => {
            state.equal = optionalIds({
                left: in.left.options[state.column],
                right: in.right.options[state.column]
            })
            state.column += 1
        },
        return: state => state.equal
    })

    if (!options) {
        return false
    }

    return loop({
        column: 0,
        equal: true
    }, {
        while: state => state.equal && state.column < in.left.text.length,
        next: state => {
            state.equal = texts({
                left: in.left.text[state.column],
                right: in.right.text[state.column]
            })
            state.column += 1
        },
        return: state => state.equal
    })
}
