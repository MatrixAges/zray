import type { Range as Input } from "./range"

export type Output = bool

export default function (in: Input): Output {
    const { first, end } = in

    return loop({
        index: first,
        equal: true
    }, {
        while: row => row.equal && row.index < end,
        next: row => {
            const i = row.index
            const lhs = in.earlier_members[i]
            const rhs = in.current_members[i]

            const members = loop({
                index: 0,
                equal: lhs.length == rhs.length && in.earlier_exports[i] ==
                    in.current_exports[i]
            }, {
                while: item => item.equal && item.index < lhs.length,
                next: item => {
                    item.equal = lhs[item.index] == rhs[item.index]
                    item.index += 1
                },
                return: item => item.equal
            })

            const left_errors = in.earlier_errors[i]
            const right_errors = in.current_errors[i]
            const errors = match {
                !members => false,
                left_errors == null || right_errors == null =>
                    left_errors == null && right_errors == null,
                _ => loop({
                    index: 0,
                    equal: left_errors.length == right_errors.length
                }, {
                    while: item => item.equal && item.index < left_errors.length,
                    next: item => {
                        item.equal =
                            left_errors[item.index] == right_errors[item.index]
                        item.index += 1
                    },
                    return: item => item.equal
                })
            }

            const left_names = in.earlier_inputs[i]
            const right_names = in.current_inputs[i]

            row.equal = match {
                !errors => false,
                left_names == null || right_names == null =>
                    left_names == null && right_names == null,
                _ => loop({
                    index: 0,
                    equal: left_names.length == right_names.length
                }, {
                    while: item => item.equal && item.index < left_names.length,
                    next: item => {
                        item.equal = left_names[item.index] == right_names[item.index]
                        item.index += 1
                    },
                    return: item => item.equal
                })
            }
            row.index += 1
        },
        return: row => row.equal
    })
}
