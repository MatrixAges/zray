import memory from "memory/columns"

import type { Range as Input } from "./range"

export type Output = bool

export default function (in: Input): Output {
    const { earlier, current, first, end } = in

    const native = in.layout.native

    const left_members = memory.readReferenceTextListsRange(
        memory.readReferenceColumn(
            earlier,
            native.members.earlier
            ,
            null
        ),
        first,
        end
    )

    const right_members = memory.readReferenceTextListsRange(
        memory.readReferenceColumn(
            current,
            native.members.current
            ,
            null
        ),
        first,
        end
    )

    const left_exports = memory.readReferenceOptionalTextRange(
        memory.readReferenceColumn(
            earlier,
            native.exports.earlier
            ,
            null
        ),
        first,
        end
    )

    const right_exports = memory.readReferenceOptionalTextRange(
        memory.readReferenceColumn(
            current,
            native.exports.current
            ,
            null
        ),
        first,
        end
    )

    const left_error_lists = memory.readReferenceOptionalTextListsRange(
        memory.readReferenceColumn(
            earlier,
            native.errors.earlier
            ,
            null
        ),
        first,
        end
    )

    const right_error_lists = memory.readReferenceOptionalTextListsRange(
        memory.readReferenceColumn(
            current,
            native.errors.current
            ,
            null
        ),
        first,
        end
    )

    const left_inputs = memory.readReferenceOptionalNamedListsRange(
        memory.readReferenceColumn(
            earlier,
            native.inputs.earlier
            ,
            null
        ),
        first,
        end
    )

    const right_inputs = memory.readReferenceOptionalNamedListsRange(
        memory.readReferenceColumn(
            current,
            native.inputs.current
            ,
            null
        ),
        first,
        end
    )

    return loop({
        index: 0,
        equal: left_members.length == right_members.length
    }, {
        while: row => row.equal && row.index < left_members.length,
        next: row => {
            const i = row.index
            const lhs = left_members[i]
            const rhs = right_members[i]

            const members = loop({
                index: 0,
                equal: lhs.length == rhs.length && left_exports[i] ==
                    right_exports[i]
            }, {
                while: item => item.equal && item.index < lhs.length,
                next: item => {
                    item.equal = lhs[item.index] == rhs[item.index]
                    item.index += 1
                },
                return: item => item.equal
            })

            const left_errors = left_error_lists[i]
            const right_errors = right_error_lists[i]
            const errors = match {
                !members => false,
                left_errors == null || right_errors == null =>
                    left_errors == null && right_errors == null,
                _ => loop({
                    index: 0,
                    equal: left_errors.length == right_errors.length
                }, {
                    while: item => item.equal && item.index < left_errors.length,
                    next: item => {
                        item.equal =
                            left_errors[item.index] == right_errors[item.index]
                        item.index += 1
                    },
                    return: item => item.equal
                })
            }

            const left_names = left_inputs[i]
            const right_names = right_inputs[i]

            row.equal = match {
                !errors => false,
                left_names == null || right_names == null =>
                    left_names == null && right_names == null,
                _ => loop({
                    index: 0,
                    equal: left_names.length == right_names.length
                }, {
                    while: item => item.equal && item.index < left_names.length,
                    next: item => {
                        item.equal = left_names[item.index] == right_names[item.index]
                        item.index += 1
                    },
                    return: item => item.equal
                })
            }
            row.index += 1
        },
        return: row => row.equal
    })
}
