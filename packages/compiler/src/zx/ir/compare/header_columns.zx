import bytes from "std:bytes"
import memory from "memory/columns"

import { Storage } from "./referenced/model"
import tags from "./tags"

import type { Range as Input } from "./range"

export type Output = bool

export default function (in: Input): Output {
    const { earlier, current, first, end, layout } = in

    const headers = layout.headers

    const equal = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < headers.storage.length,
        next: state => {
            const index = state.index
            const width = headers.widths[index]
            const left =
                memory.readReferenceColumn(earlier, headers.offsets[index], null)
            const right =
                memory.readReferenceColumn(
                    current,
                    headers.current_offsets[index],
                    null
                )

            const lhs = memory.readReferenceByteRange(left, first, end, width)
            const rhs = memory.readReferenceByteRange(right, first, end, width)

            state.equal = match headers.storage[index] {
                Storage.Tags => tags({
                    left: lhs,
                    right: rhs,
                    mask: headers.masks[index]
                }),
                _ => bytes.equals(lhs, rhs)
            }
            state.index += 1
        },
        return: state => state.equal
    })

    return loop({
        row: first,
        equal
    }, {
        while: state => state.equal && state.row < end,
        next: state => {
            const row = state.row
            const module =
                in.earlier_native_modules[row] == in.current_native_modules[row]
            const root = in.earlier_roots[row] == in.current_roots[row]

            state.equal =
                module && root && in.earlier_files[row] == in.current_files[row]
            state.row += 1
        },
        return: state => state.equal
    })
}
