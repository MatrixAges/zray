import contracts from "../referenced/contracts"
import compare from "../referenced/table"

import type { RowIndices } from "../referenced/model"
import type { Functions, Part } from "./model"

export type Input = RowIndices & Functions.Pick("columns", "contract_layout") & {
    left: Part,
    right: Part
}

export type Output = bool

export default function (in: Input): Output {
    const { left, right, left_row, right_row, columns } = in

    const equal = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < columns.length,
        next: state => {
            const index = state.index

            state.equal = compare({
                left: left.bodies[index],
                right: right.bodies[index],
                columns: columns[index],
                left_row,
                right_row
            })
            state.index += 1
        },
        return: state => state.equal
    })

    return equal && contracts({
        left: left.contracts,
        right: right.contracts,
        layout: in.contract_layout,
        left_row,
        right_row
    })
}
