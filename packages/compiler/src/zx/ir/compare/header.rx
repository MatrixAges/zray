<Module>
    <Type from="range" as="Comparison" />

    <Args in={Comparison.Range} out={bool} />

    <If on={$in.first == $in.end}>
        <Return value={true} />
    </If>

    <Call fn="header_columns" in={$in} />

    <If on={!$ctx.header_columns}>
        <Return value={false} />
    </If>

    <Call fn="native_columns" in={$in} />

    <Return value={$ctx.native_columns} />
</Module>
