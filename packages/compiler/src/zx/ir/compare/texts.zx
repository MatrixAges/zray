export type Input = {
    left: string[],
    right: string[]
}

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    return loop({
        row: 0,
        equal: left.length == right.length
    }, {
        while: state => state.equal && state.row < left.length,
        next: state => {
            state.equal = left[state.row] == right[state.row]
            state.row += 1
        },
        return: state => state.equal
    })
}
