import bytes from "std:bytes"
import memory from "memory/columns"

import contracts from "./contracts"
import table from "./table"

import type { Range as Input } from "../range"

export type Output = bool

export default function (in: Input): Output {
    const { earlier, current, first, end, layout } = in
    const { earlier_offsets, current_offsets, columns } = layout.bodies

    if (first == end) {
        return true
    }

    const shared = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < earlier_offsets.length,
        next: state => {
            const index = state.index
            const left =
                memory.readReferenceColumn(earlier, earlier_offsets[index], null)
            const right =
                memory.readReferenceColumn(current, current_offsets[index], null)
            const lhs = memory.readReferenceRange(left, first, end)
            const rhs = memory.readReferenceRange(right, first, end)

            state.equal = bytes.equals(lhs, rhs)
            state.index += 1
        },
        return: state => state.equal
    })

    if (shared) {
        return true
    }

    const left_contracts = memory.readReferenceColumn(
        earlier,
        layout.contract_offsets.earlier,
        null
    )

    const right_contracts = memory.readReferenceColumn(
        current,
        layout.contract_offsets.current,
        null
    )

    return loop({
        row: first,
        equal: true
    }, {
        while: state => state.equal && state.row < end,
        next: state => {
            const row = state.row

            state.equal = loop({
                index: 0,
                equal: true
            }, {
                while: item => item.equal && item.index < earlier_offsets.length,
                next: item => {
                    const index = item.index
                    const left = memory.readReferenceColumn(
                        earlier,
                        earlier_offsets[index],
                        null
                    )
                    const right = memory.readReferenceColumn(
                        current,
                        current_offsets[index],
                        null
                    )

                    item.equal = table({
                        left,
                        right,
                        columns: {
                            offsets: columns.offsets[index],
                            widths: columns.widths[index],
                            masks: columns.masks[index],
                            storage: columns.storage[index]
                        },
                        left_row: row,
                        right_row: row
                    })
                    item.index += 1
                },
                return: item => item.equal
            })

            if (state.equal) {
                state.equal = contracts({
                    left: left_contracts,
                    right: right_contracts,
                    layout: layout.contract,
                    left_row: row,
                    right_row: row
                })
            }

            state.row += 1
        },
        return: state => state.equal
    })
}
