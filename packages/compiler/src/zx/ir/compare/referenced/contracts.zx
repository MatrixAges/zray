import memory from "memory/columns"

import compare from "./table"

import type { Contracts, RowIndices } from "./model"

export type Input = RowIndices & Contracts

export type Output = bool

export default function (in: Input): Output {
    const { left, right, layout, left_row, right_row } = in

    if (memory.sameReferenceRow(left, right, left_row, right_row)) {
        return true
    }

    const symbols = {
        left: memory.readNestedReferenceRows(left, left_row, layout.symbols),
        right: memory.readNestedReferenceRows(right, right_row, layout.symbols),
        columns: layout.symbol_columns
    }

    const expressions = {
        left: memory.readNestedReferenceRows(left, left_row, layout.expressions),
        right: memory.readNestedReferenceRows(right, right_row, layout.expressions),
        columns: layout.expression_columns
    }

    const count = memory.referenceRowCount(symbols.left)
    const same_symbols = count == memory.referenceRowCount(symbols.right)
    const same_expressions = count == memory.referenceRowCount(expressions.left)
    const complete = count == memory.referenceRowCount(expressions.right)

    const different_counts = (
        - !same_symbols
        - or !same_expressions
        - or !complete
    )

    if (different_counts) {
        return false
    }

    return loop({
        row: 0,
        equal: true
    }, {
        while: state => state.equal && state.row < count,
        next: state => {
            state.equal = compare({
                ...symbols,
                left_row: state.row,
                right_row: state.row
            })

            if (state.equal) {
                state.equal = compare({
                    ...expressions,
                    left_row: state.row,
                    right_row: state.row
                })
            }

            state.row += 1
        },
        return: state => state.equal
    })
}
