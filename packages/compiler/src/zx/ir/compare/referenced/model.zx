import type { ReferenceRows } from "memory/columns"

export enum Storage {
    Bytes,
    Tags,
    OptionalIds,
    Texts
}

export type Columns = {
    offsets: u64[],
    widths: u64[],
    masks: u8[],
    storage: Storage[]
}

export type ColumnGroups = {
    offsets: u64[][],
    widths: u64[][],
    masks: u8[][],
    storage: Storage[][]
}

export type Pair = {
    left: ReferenceRows,
    right: ReferenceRows
}

export type RowIndices = {
    left_row: u64,
    right_row: u64
}

export type Table = Pair & {
    columns: Columns
}

export type Nested = {
    symbols: u64,
    expressions: u64,
    symbol_columns: Columns,
    expression_columns: Columns
}

export type Contracts = Pair & {
    layout: Nested
}
