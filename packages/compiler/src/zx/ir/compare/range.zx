import type { ReferenceRow } from "memory/columns"
import type { ColumnGroups, Columns, Nested } from "./referenced/model"

export type Offsets = {
    earlier: u64,
    current: u64
}

export type Headers = Columns & {
    current_offsets: u64[]
}

export type HeaderValues = {
    earlier_files: string[],
    current_files: string[],
    earlier_native_modules: u32?[],
    current_native_modules: u32?[],
    earlier_roots: u32?[],
    current_roots: u32?[]
}

export type Bodies = {
    earlier_offsets: u64[],
    current_offsets: u64[],
    columns: ColumnGroups
}

export type Native = {
    earlier_members: string[][],
    current_members: string[][],
    earlier_exports: string?[],
    current_exports: string?[],
    earlier_errors: string[]?[],
    current_errors: string[]?[],
    earlier_inputs: string?[]?[],
    current_inputs: string?[]?[]
}

export type Layout = {
    headers: Headers,
    bodies: Bodies,
    contract: Nested,
    contract_offsets: Offsets
}

export type Range = HeaderValues & Native & {
    earlier: ReferenceRow,
    current: ReferenceRow,
    first: u64,
    end: u64,
    layout: Layout
}
