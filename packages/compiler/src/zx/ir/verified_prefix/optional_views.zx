import strings from "zig:string"

import type { Window } from "./window"

export type Pair = {
    left: string?[],
    right: string?[]
}

export type Input = Window & {
    pair: Pair
}

export type Output = u64

export default function (in: Input): Output {
    const { left, right } = in.pair

    return loop({
        index: in.first,
        equal: true
    }, {
        while: state => state.equal && state.index < in.end,
        next: state => {
            const a = left[state.index]
            const b = right[state.index]

            if (a == null || b == null) {
                state.equal = a == null && b == null
            } else {
                state.equal = strings.sameStorage(a, b)
            }

            if (state.equal) {
                state.index += 1
            }
        },
        return: state => state.index
    })
}
