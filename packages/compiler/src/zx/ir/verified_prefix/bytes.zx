import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    left: u8[],
    right: u8[],
    width: u64,
    mask: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { left, right, width, mask } = in

    if (bytes.equals(left, right)) {
        return left.length / width
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < left.length,
        next: state => {
            const a = integers.widenByte(left[state.index])
            const b = integers.widenByte(right[state.index])

            state.equal = integers.andBits(a, mask) == integers.andBits(b, mask)

            if (state.equal) {
                state.index += 1
            }
        },
        return: state => state.index / width
    })
}
