import bytes from "std:bytes"
import encoding from "std:encoding"
import integers from "std:integer"

import type { Window } from "./window"

export type Pair = {
    left: string,
    right: string,
    width: u64,
    mask: u64
}

export type Input = Window & {
    pair: Pair
}

export type Output = u64

export default function (in: Input): Output {
    const { width, mask } = in.pair

    const start = in.first * width
    const end = in.end * width
    const left = bytes.fromText(encoding.sliceBytes(in.pair.left, start, end))
    const right = bytes.fromText(encoding.sliceBytes(in.pair.right, start, end))

    if (bytes.equals(left, right)) {
        return in.end
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < left.length,
        next: state => {
            const a = integers.widenByte(left[state.index])
            const b = integers.widenByte(right[state.index])

            state.equal = integers.andBits(a, mask) == integers.andBits(b, mask)

            if (state.equal) {
                state.index += 1
            }
        },
        return: state => in.first + (state.index / width)
    })
}
