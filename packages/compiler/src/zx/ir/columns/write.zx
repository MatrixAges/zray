import memory from "std:memory"

import type { U8Buffer } from "std:memory"

export type Column = {
    source: u8[],
    target: U8Buffer
}

export type Input = {
    writes: Column[]
}

export type Output = void

export default function (in: Input): Output {
    const copied = loop(0, {
        while: index => index < in.writes.length,
        next: index => {
            const column = in.writes[index]

            if (column.source.length != 0) {
                const count = memory.copyBytes(
                    column.target,
                    0,
                    column.source,
                    0,
                    column.source.length
                )
            }

            index += 1
        }
    })
}
