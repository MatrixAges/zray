import memory from "memory"

import type { Allocator, ColumnTransfers } from "memory"

export type Input = {
    allocator: Allocator,
    groups: ColumnTransfers,
    counts: u64[]
}

export type Output = bool

export default function (in: Input): Output {
    const { allocator, groups, counts } = in

    const copied = loop({
        index: 0,
        valid: true
    }, {
        while: state => state.index < counts.length && state.valid,
        next: state => {
            state.valid = memory.copyColumnGroup(
                allocator,
                groups,
                state.index,
                0,
                counts[state.index]
            )
            state.index += 1
        },
        return: state => state.valid
    })

    if (!copied) {
        return false
    }

    const published = loop(0, {
        while: index => index < counts.length,
        next: index => {
            memory.publishColumnGroup(groups, index, counts[index])
            index += 1
        }
    })

    return true
}
