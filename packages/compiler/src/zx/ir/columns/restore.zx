export type Input = {
    lengths: u64[]
}

export type Range = {
    column: u64,
    count: u64
}

export type Output = Range[]

export default function (in: Input): Output {
    const lengths = in.lengths
    const ranges: Output = []

    return loop({
        column: 0,
        ranges
    }, {
        while: state => state.column < lengths.length,
        next: state => {
            const count = lengths[state.column]

            if (count != 0) {
                state.ranges = state.ranges.push({
                    column: state.column,
                    count
                })[0]
            }

            state.column += 1
        },
        return: state => state.ranges
    })
}
