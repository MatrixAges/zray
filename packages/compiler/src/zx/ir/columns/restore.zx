import memory from "memory"

import type { Allocator, TransferGroup } from "memory"

export type Input = {
    allocator: Allocator,
    group: TransferGroup
}

export type Output = void

export default function (in: Input): Output {
    const { allocator, group } = in

    const columns = memory.transferColumnCount(group)

    const reserved = loop(0, {
        while: column => column < columns,
        next: column => {
            const count = memory.transferColumnLength(group, column)

            if (count != 0) {
                const length =
                    memory.reserveTransferColumn(allocator, group, column, count)
            }

            column += 1
        }
    })

    const published = loop(0, {
        while: column => column < columns,
        next: column => {
            const count = memory.transferColumnLength(group, column)

            if (count != 0) {
                memory.copyTransferRange(group, column, 0, count)
                memory.publishTransferColumn(group, column, count)
            }

            column += 1
        }
    })
}
