import memory from "memory"

import type { TransferGroup } from "memory"

export type Input = {
    group: TransferGroup
}

export type Output = u64[]

export default function (in: Input): Output {
    const { group } = in

    const columns = memory.transferColumnCount(group)
    const empty: u64[] = []

    return loop(empty, {
        while: counts => counts.length < columns,
        next: counts => {
            const count = memory.transferColumnLength(group, counts.length)
            counts = counts.push(count)[0]
        }
    })
}
