import bytes from "std:bytes"

import scan from "./scan"

import type { Output, Walk } from "./model"

export type Input = Walk

export default function (in: Input): Output {
    const suffix = bytes.fromText(in.suffix)
    const empty: u8[][] = []

    const initial =
        in.collect && suffix.length != 0 ? empty.push(suffix)[0] : empty

    const tail = scan({
        source: in.path,
        initial: {
            parents: 0,
            length: suffix.length,
            attached: in.attached,
            parts: initial
        },
        collect: in.collect
    })

    const done = scan({
        source: in.directory,
        initial: tail,
        collect: in.collect
    })

    if (!in.collect || done.parts.length == 0) {
        return {
            ...done,
            text: []
        }
    }

    const forward: u8[][] = []

    const ordered = loop({
        index: done.parts.length,
        items: forward
    }, {
        while: state => state.index != 0,
        next: state => {
            state.index -= 1
            state.items = state.items.push(done.parts[state.index])[0]
        },
        return: state => state.items
    })

    return {
        ...done,
        text: bytes.join([], ordered)
    }
}
