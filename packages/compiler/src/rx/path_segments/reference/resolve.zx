import normalize from "../normalize"
import walk from "../walk"
import { State } from "./model"
import request from "./request"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const path = request(in.omit(["workspace"]))
    const normalized = normalize(path)

    if (!normalized.valid) {
        return {
            state: State.Invalid,
            length: 0
        }
    }

    const { workspace } = in

    const available = workspace.bytes.length - workspace.start

    if (normalized.length > available) {
        return {
            state: State.NeedSpace,
            length: normalized.length
        }
    }

    const written = walk({
        directory: in.directory,
        path: path.path,
        suffix: normalized.suffix,
        attached: normalized.attached,
        capacity: workspace.start + normalized.length,
        target: workspace.target
    })

    return {
        state: State.Ready,
        length: written.length
    }
}
