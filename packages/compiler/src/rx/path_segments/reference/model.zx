import type { U8Buffer } from "std:memory"
import type { Request } from "../model"

export type Workspace = {
    bytes: u8[],
    target: U8Buffer
}

export type Input = Request.Pick("directory", "kind") & {
    reference: string,
    workspace: Workspace
}

export enum State {
    Invalid,
    NeedSpace,
    Ready
}

export type Output = {
    state: State,
    length: u64
}
