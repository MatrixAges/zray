import integers from "std:integer"
import memory from "memory"

import { name_attribute } from "../../../schema/attribute/const"
import claim from "../../../schema/keys/claim"
import emptyKeys from "../../../schema/keys/empty"
import attribute from "../../../schema/tree/attribute"
import children from "../../../schema/tree/children"
import next from "../../../schema/tree/next"
import size from "./group_size"
import objectAt from "./object_at"

import type { Collision, Fragments } from "./model"

export type Input = {
    fragments: Fragments,
    first: u32
}

export type Output = Collision?

export default function (in: Input): Output {
    const { fragments } = in
    const { rows, output, workspace, tree } = fragments.request

    const links = memory.optionalU32Views(output.next)

    const count = size({
        columns: output,
        first: in.first
    })

    memory.allocateU32Buffer(workspace.allocator, rows, count)

    const first: u32? = in.first
    const absent: u32? = null
    const missing: Output = null

    const found = loop({
        fragment: first,
        keys: emptyKeys(),
        field: 0,
        finding: missing
    }, {
        while: state => state.finding == null && state.fragment != null,
        next: state => {
            const fragment = state.fragment

            if (fragment != null) {
                const row = integers.widen(fragment)
                const parent = objectAt({
                    fragments,
                    row
                })

                const scanned = loop({
                    node: children({
                        tree,
                        node: parent
                    }),
                    keys: state.keys,
                    field: state.field,
                    finding: missing,
                    earlier: absent
                }, {
                    while: part => part.node.head != 0 || part.node.rows.length != 0,
                    next: part => {
                        const node = part.node
                        const visit = {
                            tree,
                            node
                        }

                        const key = attribute({
                            ...visit,
                            key: name_attribute
                        })

                        if (key != null) {
                            const entered = claim({
                                seen: part.keys,
                                workspace,
                                key: key.value,
                                secondary: false,
                                row: part.field,
                                count
                            })

                            part.keys = entered.seen
                            const previous = entered.previous

                            if (previous == null) {
                                memory.writeU32(rows, part.field, fragment)
                            } else {
                                const owner = memory.readU32(rows, previous)
                                const earlier = part.earlier

                                if (earlier == null || owner < earlier) {
                                    part.earlier = owner
                                    part.finding = {
                                        fragment: row,
                                        where: node
                                    }
                                }
                            }
                        }

                        part.field += 1
                        part.node = next(visit)
                    }
                })

                state.keys = scanned.keys
                state.field = scanned.field
                state.finding = scanned.finding
                state.fragment = links[row]
            }
        },
        return: state => state.finding
    })

    memory.releaseU32Buffer(workspace.allocator, rows)

    return found
}
