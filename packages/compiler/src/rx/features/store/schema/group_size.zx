import integers from "std:integer"

import type { Grouped } from "./model"

export type Input = {
    grouped: Grouped,
    first: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { next, offsets } = in.grouped

    const first: u32? = in.first

    return loop({
        fragment: first,
        count: 0
    }, {
        while: state => state.fragment != null,
        next: state => {
            const fragment = state.fragment

            if (fragment != null) {
                const row = integers.widen(fragment)
                const begin = offsets[row]
                const end = offsets[row + 1]

                state.count += end - begin
                state.fragment = next[row]
            }
        },
        return: state => state.count
    })
}
