import integers from "std:integer"
import memory from "memory"

import type { Columns } from "./model"

export type Input = {
    columns: Columns,
    first: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { next, offsets } = in.columns

    const links = memory.optionalU32Views(next)
    const first: u32? = in.first

    return loop({
        fragment: first,
        count: 0
    }, {
        while: state => state.fragment != null,
        next: state => {
            const fragment = state.fragment

            if (fragment != null) {
                const row = integers.widen(fragment)
                const begin = memory.readU64(offsets, row)
                const end = memory.readU64(offsets, row + 1)

                state.count += end - begin
                state.fragment = links[row]
            }
        },
        return: state => state.count
    })
}
