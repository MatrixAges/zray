import integers from "std:integer"

import { name_attribute } from "../../../schema/attribute/const"
import claim from "../../../schema/keys/claim"
import emptyKeys from "../../../schema/keys/empty"
import attribute from "../../../schema/tree/attribute"
import next from "../../../schema/tree/next"
import fieldCount from "./field_count"

import type { Cursor } from "../../../schema/tree/model"
import type { Grouped as Output, Input as Request } from "./model"

export type Input = {
    request: Request,
    first: Cursor,
    objects: u64
}

export default function (in: Input): Output {
    const { request, objects } = in
    const { tree } = request

    const empty_u32: u32[] = []
    const empty_next: u32?[] = []
    const empty_u64: u64[] = []

    const grouped = loop({
        node: in.first,
        row: 0,
        field: 0,
        count: 0,
        keys: emptyKeys(),
        starts: empty_u32,
        next: empty_next,
        tails: empty_u32,
        offsets: empty_u64,
        positions: empty_u64
    }, {
        while: state => state.row < objects,
        next: state => {
            const node = state.node
            const row = state.row
            const visit = {
                tree,
                node
            }

            if (tree.layout == null) {
                state.positions = state.positions.push(node.head)[0]
            }

            state.offsets = state.offsets.push(state.field)[0]
            state.field += fieldCount(visit)

            const position = integers.narrow(row)

            state.next = state.next.push(null)[0]
            state.tails = state.tails.push(position)[0]

            const name = attribute({
                ...visit,
                key: name_attribute
            })

            if (name != null) {
                const entered = claim({
                    seen: state.keys,
                    key: name.value,
                    secondary: false,
                    row,
                    count: objects
                })

                const first = entered.previous

                state.keys = entered.seen

                if (first == null) {
                    state.starts = state.starts.push(position)[0]
                    state.count += 1
                } else {
                    const tail = integers.widen(state.tails[first])

                    state.next = state.next.splice(tail, 1, [position])[0]
                    state.tails = state.tails.splice(first, 1, [position])[0]
                }
            }

            state.node = next(visit)
            state.row += 1
        }
    })

    return {
        count: grouped.count,
        starts: grouped.starts,
        next: grouped.next,
        offsets: grouped.offsets.push(grouped.field)[0],
        positions: grouped.positions
    }
}
