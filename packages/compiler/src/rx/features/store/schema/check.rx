<Module>
    <Type from="model" as="Store" />

    <Args in={Store.Input} out={Store.Output} />

    <Call fn="order" in={$in} />

    <If on={$ctx.order.issue != Store.Issue.None || $ctx.order.objects == 1}>
        <Return
            value={{
                ...$ctx.order.pick([
                    "issue",
                    "where",
                    "objects"
                ]),
                first: $ctx.order.aliases,
                groups: $ctx.order.objects,
                starts: [],
                next: [],
                offsets: []
            }}
        />
    </If>

    <Call
        fn="group"
        in={{
            request: $in,
            ...$ctx.order.pick([
                "first",
                "objects"
            ])
        }}
    />

    <If on={$ctx.group.count != $ctx.order.objects}>
        <Call
            fn="collisions"
            in={{
                fragments: {
                    request: $in,
                    ...$ctx.order.pick([
                        "first",
                        "objects"
                    ]),
                    grouped: $ctx.group
                }
            }}
        />

        <If on={$ctx.collisions != null}>
            <Return
                value={{
                    issue: Store.Issue.DuplicateField,
                    where: $ctx.collisions.where,
                    first: $ctx.order.aliases,
                    groups: $ctx.group.count,
                    objects: $ctx.order.objects,
                    ...$ctx.group.pick([
                        "starts",
                        "next",
                        "offsets"
                    ])
                }}
            />
        </If>
    </If>

    <Return
        value={{
            issue: Store.Issue.None,
            where: null,
            first: $ctx.order.aliases,
            groups: $ctx.group.count,
            objects: $ctx.order.objects,
            ...$ctx.group.pick([
                "starts",
                "next",
                "offsets"
            ])
        }}
    />
</Module>
