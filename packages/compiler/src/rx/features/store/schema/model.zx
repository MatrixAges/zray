import type { Cursor, Input as Children } from "../../../schema/tree/model"

export enum Issue {
    None,
    DuplicateType,
    LateType,
    MissingObject,
    DuplicateField
}

export type Input = Children

export type Declaration = {
    issue: Issue,
    where?: Cursor,
    first: Cursor,
    aliases: u64,
    objects: u64
}

export type Grouped = {
    count: u64,
    starts: u32[],
    next: u32?[],
    offsets: u64[],
    positions: u64[]
}

export type Output = {
    issue: Issue,
    where?: Cursor,
    first: u64,
    groups: u64,
    objects: u64,
    starts: u32[],
    next: u32?[],
    offsets: u64[]
}

export type Fragments = {
    request: Input,
    first: Cursor,
    objects: u64,
    grouped: Grouped
}

export type Collision = {
    fragment: u64,
    where: Cursor
}
