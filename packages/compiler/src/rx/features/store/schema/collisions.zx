import integers from "std:integer"
import memory from "memory"

import groupCollision from "./group_collision"

import type { Collision, Fragments } from "./model"

export type Input = {
    fragments: Fragments,
    groups: u64
}

export type Output = Collision?

export default function (in: Input): Output {
    const { fragments, groups } = in
    const { starts, next } = fragments.request.output

    const links = memory.optionalU32Views(next)
    const finding: Output = null

    return loop({
        finding,
        index: 0
    }, {
        while: state => state.index < groups,
        next: state => {
            const first = memory.readU32(starts, state.index)
            const next = links[integers.widen(first)]
            const before = state.finding

            if (next != null) {
                if (before == null || integers.widen(next) < before.fragment) {
                    const result = groupCollision({
                        fragments,
                        first
                    })

                    if (result != null) {
                        if (before == null || result.fragment < before.fragment) {
                            state.finding = result
                        }
                    }
                }
            }

            state.index += 1
        },
        return: state => state.finding
    })
}
