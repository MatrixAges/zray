import integers from "std:integer"

import groupCollision from "./group_collision"

import type { Collision, Fragments } from "./model"

export type Input = {
    fragments: Fragments
}

export type Output = Collision?

export default function (in: Input): Output {
    const { fragments } = in
    const { starts, next } = fragments.grouped

    const finding: Output = null

    return loop({
        finding,
        index: 0
    }, {
        while: state => state.index < starts.length,
        next: state => {
            const first = starts[state.index]
            const following = next[integers.widen(first)]
            const before = state.finding

            if (following != null) {
                if (
                    before == null || integers.widen(following) < before.fragment
                ) {
                    const result = groupCollision({
                        fragments,
                        first
                    })

                    if (result != null) {
                        if (before == null || result.fragment < before.fragment) {
                            state.finding = result
                        }
                    }
                }
            }

            state.index += 1
        },
        return: state => state.finding
    })
}
