import bytes from "std:bytes"
import { ascii_dollar, ascii_dot } from "core/ascii/const"

import validPath from "../../zx/analysis/expression_program/bindings/path/ascii"

export type Input = {
    name: string,
    allow_dollar: bool
}

export type Output = bool

export default function (in: Input): Output {
    const name = bytes.fromText(in.name)

    if (!validPath(name)) {
        return false
    }

    if (bytes.indexOfScalar(name, 0, ascii_dot) != null) {
        return false
    }

    return in.allow_dollar || bytes.indexOfScalar(name, 0, ascii_dollar) == null
}
