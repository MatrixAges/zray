import { bucket_ratio, capacity_growth } from "core/bytes/index/const"

import type { Keys } from "./model"

export type Input = {
    seen: Keys,
    count: u64
}

export type Output = Keys

export default function (in: Input): Output {
    const minimum = in.count * bucket_ratio

    const capacity = loop(1, {
        while: size => size < minimum,
        next: size => {
            size *= capacity_growth
        }
    })

    const zero: u64 = 0
    const empty_buckets: u64[] = []

    const buckets = loop({
        index: 0,
        items: empty_buckets
    }, {
        while: state => state.index < capacity,
        next: state => {
            state.items = state.items.push(zero)[0]
            state.index += 1
        },
        return: state => state.items
    })

    const empty_text: string[] = []

    const text = loop({
        index: 0,
        items: empty_text
    }, {
        while: state => state.index < in.count,
        next: state => {
            state.items = state.items.push("")[0]
            state.index += 1
        },
        return: state => state.items
    })

    return {
        ...in.seen,
        capacity,
        text,
        buckets
    }
}
