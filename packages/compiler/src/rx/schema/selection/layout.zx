import { Branch, Issue } from "./model"

import type { Finding, Output } from "./model"

export type Input = Branch[]

export default function (in: Input): Output {
    const finding: Finding? = null

    return loop({
        index: 0,
        seen_default: false,
        finding
    }, {
        while: state => state.finding == null && state.index < in.length,
        next: state => {
            const index = state.index

            const branch = in[index]
            const misplaced = index == 0 || index + 1 != in.length
            const issue: Issue? = match {
                branch == Branch.Else && misplaced => Issue.MisplacedElse,
                branch == Branch.Default && state.seen_default => Issue.DuplicateDefault,
                _ => null
            }

            if (issue != null) {
                state.finding = {
                    issue,
                    index
                }
            }

            state.seen_default = state.seen_default || branch == Branch.Default
            state.index += 1
        },
        return: state => state.finding
    })
}
