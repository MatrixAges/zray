import { value_attribute } from "../attribute/const"
import { default_tag } from "../execution/const"
import claim from "../keys/claim"
import attribute from "../tree/attribute"
import name from "../tree/name"
import next from "../tree/next"
import { Issue } from "./model"

import type { Keys, Workspace } from "../keys/model"
import type { Input as Children } from "../tree/model"
import type { Finding, Output } from "./model"

export type Input = Children & {
    workspace: Workspace
}

export default function (in: Input): Output {
    const { tree, count } = in

    const empty: Keys = {
        first: null,
        second: null,
        text: [],
        capacity: 0
    }

    const finding: Finding? = null

    return loop({
        node: in.first,
        index: 0,
        keys: empty,
        repeated_case: finding,
        repeated_default: finding,
        seen_default: false
    }, {
        while: state => state.repeated_case == null && state.index < count,
        next: state => {
            const visit = {
                tree,
                node: state.node
            }

            if (name(visit) == default_tag) {
                if (state.seen_default && state.repeated_default == null) {
                    state.repeated_default = {
                        issue: Issue.DuplicateDefault,
                        index: state.index
                    }
                }

                state.seen_default = true
            } else {
                const key = attribute({
                    ...visit,
                    key: value_attribute
                })

                if (key != null) {
                    const entered = claim({
                        seen: state.keys,
                        workspace: in.workspace,
                        key: key.value,
                        secondary: key.expression,
                        row: state.index,
                        count
                    })

                    state.keys = entered.seen

                    if (entered.repeated) {
                        state.repeated_case = {
                            issue: Issue.DuplicateCase,
                            index: state.index
                        }
                    }
                }
            }

            state.node = next(visit)
            state.index += 1
        },
        return: state => match {
            state.repeated_case != null => state.repeated_case,
            _ => state.repeated_default
        }
    })
}
