<Module>
    <Type from="model" as="Schema" />

    <Args in={Schema.Input} out={Schema.Output} />

    <Call
        fn="duplicate"
        in={{
            declarations: $in,
            tag: Schema.Tag.Type
        }}
    />

    <If on={$ctx.duplicate != null}>
        <Return
            value={{
                issue: Schema.Issue.DuplicateType,
                index: $ctx.duplicate
            }}
        />
    </If>

    <Call fn="order" in={$in} />

    <Return value={$ctx.order} />
</Module>
