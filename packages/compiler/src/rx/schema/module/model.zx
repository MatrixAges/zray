export enum Tag {
    Type,
    Args,
    Store
}

export enum Issue {
    DuplicateType,
    LateType,
    MisplacedArgs,
    DuplicateStore
}

export type Input = {
    tags: Tag[],
    names: string[],
    children: u64[]
}

export type Finding = {
    issue: Issue,
    index: u64
}

export type Output = Finding?
