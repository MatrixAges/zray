import duplicate from "./duplicate"
import { Issue, Tag } from "./model"

import type { Finding, Input, Output } from "./model"

export default function (in: Input): Output {
    const repeated = duplicate({
        declarations: in,
        tag: Tag.Store
    })

    const finding: Finding? = null

    return loop({
        index: 0,
        args: false,
        steps: false,
        finding
    }, {
        while: state => state.finding == null && state.index < in.tags.length,
        next: state => {
            const index = in.children[state.index]
            const after_step = state.steps || state.index != index
            const late = state.args || after_step

            switch (in.tags[state.index]) {
                case Tag.Type:
                    if (late) {
                        state.finding = {
                            issue: Issue.LateType,
                            index
                        }
                    }
                case Tag.Args:
                    if (late) {
                        state.finding = {
                            issue: Issue.MisplacedArgs,
                            index
                        }
                    }

                    state.args = true
                case Tag.Store:
                    state.steps = true

                    if (repeated != null && repeated == index) {
                        state.finding = {
                            issue: Issue.DuplicateStore,
                            index
                        }
                    }
            }

            state.index += 1
        },
        return: state => state.finding
    })
}
