import type { Attribute, Node } from "../../syntax/document/model"
import type { Layout } from "../../syntax/tree/layout"

export type Tree = {
    layout?: Layout,
    source: string,
    decoded: string,
    nodes: Node[],
    attributes: Attribute[],
    first: u64[],
    next: u64[]
}

export type Cursor = {
    rows: u8[],
    head: u64
}

export type Input = {
    tree: Tree,
    first: Cursor,
    count: u64
}

export type Visit = {
    tree: Tree,
    node: Cursor
}
