import bytes from "std:bytes"

import hasContent from "../content/check"
import {
    name_attribute,
    value_attribute
} from "./const"
import { Issue, Role } from "./model"
import classify from "./role"
import expression from "./rows/expression"
import name from "./rows/name"
import value from "./rows/value"

import type { Attributes as Input, Finding as Output } from "./model"

export default function (in: Input): Output {
    const store_field = in.store_field

    return loop({
        row: 0,
        issue: Issue.None,
        index: 0,
        invalid_kind: false
    }, {
        while: state => !state.invalid_kind && state.row < in.rows.count,
        next: state => {
            const row = state.row
            const item = {
                rows: in.rows,
                row
            }
            const key = name(item)
            const braced_value = expression(item)
            const role = classify({
                element: in.element,
                attribute: key
            })

            const braced = role == Role.Type || role == Role.Expression
            if (role != Role.Value && braced_value != braced) {
                state.issue = braced ? Issue.Expression : Issue.Static
                state.index = row
                state.invalid_kind = true
            } else {
                const check_empty = match {
                    store_field && key == value_attribute => false,
                    store_field && key == name_attribute => true,
                    state.issue != Issue.None => false,
                    _ => braced_value || role != Role.Value
                }

                if (
                    check_empty && !hasContent(bytes.fromText(value(item)))
                ) {
                    state.issue = store_field ? Issue.EmptyField : Issue.Empty
                    state.index = row
                }
            }

            state.row += 1
        },
        return: state => ({
            issue: state.issue,
            index: state.index
        })
    })
}
