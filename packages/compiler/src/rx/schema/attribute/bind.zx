import position from "../structure/position"
import name from "./rows/name"

import type { Rows } from "./rows/model"

export enum Issue {
    None,
    Unknown,
    Duplicate,
    Missing
}

export type Input = {
    rows: Rows,
    fields: string[],
    required: u64[]
}

export type Output = {
    issue: Issue,
    row: u64,
    slots: u64[]
}

export default function (in: Input): Output {
    const { rows, fields, required } = in

    const initial: u64[] = []

    const empty = loop({
        slots: initial
    }, {
        while: state => state.slots.length < fields.length,
        next: state => {
            state.slots = state.slots.push(0)[0]
        },
        return: state => state.slots
    })

    const bound = loop({
        row: 0,
        issue: Issue.None,
        slots: empty
    }, {
        while: state => state.issue == Issue.None && state.row < rows.count,
        next: state => {
            const slot = position({
                name: name({
                    rows,
                    row: state.row
                }),
                names: fields
            })

            if (slot == null) {
                state.issue = Issue.Unknown
            } else if (state.slots[slot] != 0) {
                state.issue = Issue.Duplicate
            } else {
                state.slots[slot] = state.row + 1
                state.row += 1
            }
        }
    })

    if (bound.issue != Issue.None) {
        return bound
    }

    return loop({
        next: 0,
        row: 0,
        issue: Issue.None
    }, {
        while: state => state.issue == Issue.None && state.next < required.length,
        next: state => {
            const field = required[state.next]

            if (bound.slots[field] == 0) {
                state.row = field
                state.issue = Issue.Missing
            }

            state.next += 1
        },
        return: state => ({
            issue: state.issue,
            row: state.row,
            slots: bound.slots
        })
    })
}
