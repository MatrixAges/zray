<Module>
    <Type from="model" as="Selection" />
    <Type from="../model" as="Projection" />
    <Type from="../diagnostic" as="Diagnostic" />

    <Args in={Selection.Request} out={void} />

    <Loop on={$in.position < $in.request.count}>
        <Call
            module="advance"
            in={{
                request: $in,
                position: 0
            }}
        />
    </Loop>

    <If on={$in.final}>
        <Call
            module="../result"
            in={{
                source: $in.names,
                result: $in.field_view.object.names,
                indices: $in.indices,
                all: $in.all,
                mode: $in.field_view.object.mode
            }}
        />

        <Switch on={$ctx.result}>
            <Case value={Projection.CoverageResult.InvalidType}>
                <Call
                    module="../report"
                    in={{

                        issue: Diagnostic.Issue.Result
                    }}
                />
            </Case>

            <Case value={Projection.CoverageResult.UnexpectedField}>
                <Call
                    module="../report"
                    in={{

                        issue: Diagnostic.Issue.Outside
                    }}
                />
            </Case>
        </Switch>
    </If>
</Module>
