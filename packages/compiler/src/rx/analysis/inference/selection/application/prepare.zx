import { Mode } from "../../fields/view"

import type { Output as Plan } from "../model"
import type { Input as Selection, Request } from "./model"

export type Input = {
    input: Selection,
    plan: Plan
}

export type Output = Request

export default function (in: Input): Output {
    const { input, plan } = in
    const { names, values } = input.source
    const { all, indices } = plan

    return {
        frame: input.frame,
        field_view: input.field_view,
        source: {
            names,
            values,
            declared: input.mode == Mode.Declared,
            indices,
            all
        },
        count: all ? names.length : indices.length,
        final: input.final
    }
}
