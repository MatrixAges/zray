import type { ObjectFieldReplay } from "rx_project_host"
import type { View } from "../../fields/workflow"
import type { Input as Replay } from "../replay"

export type Request = {
    frame: ObjectFieldReplay,
    field_view: View,
    source: Replay.Pick("names", "values", "declared", "indices", "all"),
    count: u64,
    final: bool
}

export type Cursor = {
    request: Request,
    position: u64
}
