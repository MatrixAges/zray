import type { ObjectFieldReplay } from "rx_project_host"
import type { Mode } from "../../fields/view"
import type { View } from "../../fields/workflow"
import type { Issue } from "../diagnostic"
import type { Input as Replay } from "../replay"

export type Input = {
    frame: ObjectFieldReplay,
    field_view: View,
    source: Replay.Pick("names", "values"),
    mode: Mode,
    keys: string[],
    omit: bool,
    final: bool
}

export type Request = {
    frame: ObjectFieldReplay,
    field_view: View,
    source: Replay.Pick("names", "values", "declared", "indices", "all"),
    count: u64,
    final: bool
}

export type Cursor = {
    request: Request,
    position: u64
}

export type Failure = {
    frame: ObjectFieldReplay,
    issue: Issue
}
