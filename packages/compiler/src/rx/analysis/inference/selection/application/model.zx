import type { Mode } from "../../fields/view"
import type { View } from "../../fields/workflow"
import type { Input as Replay } from "../replay"

export type Input = {
    field_view: View,
    source: Replay.Pick("names", "values"),
    mode: Mode,
    keys: string[],
    omit: bool,
    final: bool
}

export type Request = Replay.Pick("names", "values", "declared", "indices", "all") & {
    field_view: View,
    count: u64,
    final: bool
}

export type Cursor = {
    request: Request,
    position: u64
}
