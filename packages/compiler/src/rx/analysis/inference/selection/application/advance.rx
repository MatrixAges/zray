<Module>
    <Type from="model" as="Selection" />
    <Type from="../../object_closure/effect" as="ObjectEffect" />

    <Args in={Selection.Cursor} out={Selection.Cursor} />

    <Store from="../../object_closure/object" as="object" />

    <Call
        fn="../replay"
        in={{
            ...$in.request.pick([
                "names",
                "values",
                "declared",
                "indices",
                "all"
            ]),
            target: $in.request.field_view.object,
            parents: $in.request.field_view.parents,
            known: $in.request.field_view.known,
            first: $in.position
        }}
    />

    <If on={$ctx.replay.position == $in.request.count}>
        <Return
            value={{
                request: $in.request,
                position: $ctx.replay.position
            }}
        />
    </If>

    <Call
        module="../../fields/target"
        in={{
            site: $in.request.field_view.site,
            name: $in.request.names[$ctx.replay.index],
            choice: $ctx.replay.target
        }}
    />

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.UnifyFields,
            target: $ctx.target,
            source: $ctx.replay.source
        }}
        setter={[$store.object.effect]}
    />

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.RefreshFields
        }}
        setter={[$store.object.effect]}
    />

    <Return
        value={{
            request: $in.request,
            position: $ctx.replay.position + 1
        }}
    />
</Module>
