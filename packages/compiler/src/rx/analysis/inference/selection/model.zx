import type { Input as Coverage } from "../../../../zx/analysis/selection/covers"
import type { Input as Fields } from "../../../../zx/analysis/selection/model"
import type { Mode } from "../fields/view"

export enum Status {
    Ready,
    Wait,
    Missing
}

export type Input = {
    fields: Fields,
    mode: Mode,
    final: bool
}

export enum CoverageResult {
    Valid,
    InvalidType,
    UnexpectedField
}

export type ResultInput = Coverage & {
    mode: Mode
}

export type Output = {
    indices: u32[],
    all: bool,
    status: Status
}
