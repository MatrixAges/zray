<Module>
    <Type from="../object_closure/replay" as="Objects" />
    <Type from="../object_closure/query" as="Query" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Objects.SelectionCursor} out={Objects.SelectionCursor} />

    <Store from="../object_closure/object" as="object" />

    <Call
        fn="../object_closure/selection"
        in={{
            ...$in.request.view.selections.omit([
                "owner",
                "spans"
            ]),
            final: $in.request.final,
            cache: $in.request.view.readiness.cache,
            start: $in.start
        }}
    />

    <If on={$ctx.selection.row == $in.request.view.selections.sources.length}>
        <Return
            value={{
                ...$in,
                start: $ctx.selection.row
            }}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Rebuild}>
        <Call
            fn="../object_closure/stage"
            in={{
                object_step: ObjectEffect.Step.UpdateReadiness,
                rebuild: true,
                position: $ctx.selection.plan.position,
                spread: false,
                shared: $ctx.selection.plan.shared
            }}
            setter={[$store.object.effect]}
        />

        <Return
            value={{
                ...$in,
                start: $ctx.selection.row
            }}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Reject}>
        <Call
            fn="reject_incomplete"
            in={{
                spans: $in.request.view.selections.spans,
                row: $ctx.selection.row
            }}
        />

        <Return
            value={{
                ...$in,
                diagnostic: $ctx.reject_incomplete
            }}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Propagate}>
        <Call
            fn="../object_closure/stage"
            in={{
                object_step: ObjectEffect.Step.UpdateReadiness,
                rebuild: false,
                position: $ctx.selection.plan.position,
                spread: false,
                shared: $ctx.selection.plan.shared
            }}
            setter={[$store.object.effect]}
        />

        <Call fn="../object_closure/read_ready" in={$store.object.effect} />

        <If on={!$ctx.read_ready}>
            <If on={$in.request.final}>
                <Call
                    fn="reject_incomplete"
                    in={{
                        spans: $in.request.view.selections.spans,
                        row: $ctx.selection.row
                    }}
                />

                <Return
                    value={{
                        ...$in,
                        diagnostic: $ctx.reject_incomplete
                    }}
                />
            </If>

            <Return
                value={{
                    ...$in,
                    start: $ctx.selection.row + 1
                }}
            />
        </If>
    </If>

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.OpenSelection,
            row: $ctx.selection.row,
            root: $ctx.selection.root
        }}
        setter={[$store.object.effect]}
    />

    <Call
        module="apply"
        in={{
            ...$in.request.view.selection,
            final: $in.request.final
        }}
    />

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.FinishRow
        }}
        setter={[$store.object.effect]}
    />

    <Return
        value={{
            ...$in,
            start: $ctx.selection.row + 1
        }}
    />
</Module>
