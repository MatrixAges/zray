<Module>
    <Type from="workflow" as="Selection" />
    <Type from="../object_closure/query" as="Query" />

    <Args in={Selection.Cursor} out={Selection.Cursor} />

    <Call
        fn="../object_closure/selection"
        in={{
            ...$in.request.views,
            cache: $in.request.readiness.cache,
            start: $in.start
        }}
    />

    <If on={$ctx.selection.row == $in.request.views.sources.length}>
        <Return
            value={{
                request: $in.request,
                start: $ctx.selection.row
            }}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Rebuild}>
        <Call
            fn="host.updateObjectReadiness"
            in={[
                $in.request.readiness.frame,
                true,
                $ctx.selection.plan.position,
                false,
                $ctx.selection.plan.shared
            ]}
        />

        <Return
            value={{
                request: $in.request,
                start: $ctx.selection.row
            }}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Reject}>
        <Call
            fn="host.rejectObjectSelection"
            in={[
                $in.request.frame,
                $ctx.selection.row
            ]}
        />
    </If>

    <If on={$ctx.selection.plan.action == Query.Action.Propagate}>
        <Call
            fn="host.updateObjectReadiness"
            in={[
                $in.request.readiness.frame,
                false,
                $ctx.selection.plan.position,
                false,
                $ctx.selection.plan.shared
            ]}
        />

        <If on={!$ctx.updateObjectReadiness}>
            <If on={$in.request.views.final}>
                <Call
                    fn="host.rejectObjectSelection"
                    in={[
                        $in.request.frame,
                        $ctx.selection.row
                    ]}
                />
            </If>

            <Return
                value={{
                    request: $in.request,
                    start: $ctx.selection.row + 1
                }}
            />
        </If>
    </If>

    <Call
        fn="host.replayObjectSelection"
        in={[
            $in.request.frame,
            $ctx.selection.row,
            $ctx.selection.root
        ]}
    />

    <Return
        value={{
            request: $in.request,
            start: $ctx.selection.row + 1
        }}
    />
</Module>
