<Module>
    <Type from="model" as="Projection" />
    <Type from="../fields/view" as="Fields" />

    <Args in={Projection.ResultInput} out={Projection.CoverageResult} />

    <If on={$in.mode == Fields.Mode.InvalidDeclared}>
        <Return value={Projection.CoverageResult.InvalidType} />
    </If>

    <If on={$in.mode == Fields.Mode.Inferred || $in.mode == Fields.Mode.Declared}>
        <Call fn="../../../../zx/analysis/selection/covers" in={$in.omit(["mode"])} />

        <If on={!$ctx.covers}>
            <Return value={Projection.CoverageResult.UnexpectedField} />
        </If>
    </If>

    <Return value={Projection.CoverageResult.Valid} />
</Module>
