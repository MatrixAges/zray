import {
    type_error,
    name_error,
    invalid_source,
    unknown_name,
    invalid_result,
    outside_result
} from "./const"

export enum Issue {
    InvalidSource,
    MissingName,
    InvalidResult,
    OutsideResult
}

export type Input = Issue

export type Output = {
    code: string,
    message: string
}

export default function (in: Input): Output {
    const name = in == Issue.MissingName || in == Issue.OutsideResult

    const message = match in {
        Issue.InvalidSource => invalid_source,
        Issue.MissingName => unknown_name,
        Issue.InvalidResult => invalid_result,
        _ => outside_result
    }

    return {
        code: name ? name_error : type_error,
        message
    }
}
