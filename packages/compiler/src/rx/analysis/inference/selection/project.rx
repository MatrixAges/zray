<Module>
    <Type from="model" as="Projection" />
    <Type from="../fields/view" as="Fields" />

    <Args in={Projection.Input} out={Projection.Output} />

    <Call fn="../../../../zx/analysis/selection/plan" in={$in.fields} />

    <If on={!$ctx.plan.missing}>
        <Return
            value={{
                indices: $ctx.plan.indices,
                all: $ctx.plan.all,
                status: Projection.Status.Ready,
                count: $ctx.plan.all ? $in.fields.count : $ctx.plan.indices.length
            }}
        />
    </If>

    <If on={$in.final || $in.mode == Fields.Mode.Declared}>
        <Return
            value={{
                indices: [],
                all: false,
                status: Projection.Status.Missing,
                count: 0
            }}
        />
    </If>

    <Return
        value={{
            indices: [],
            all: false,
            status: Projection.Status.Wait,
            count: 0
        }}
    />
</Module>
