<Module>
    <Type from="diagnostic" as="Diagnostic" />

    <Args in={Diagnostic.Report} out={void} />

    <Call fn="diagnostic" in={$in.issue} />

    <Call
        fn="../fields/host.reportReplayFieldError"
        in={[
            $in.frame,
            $ctx.diagnostic.name_error,
            $ctx.diagnostic.message
        ]}
    />
</Module>
