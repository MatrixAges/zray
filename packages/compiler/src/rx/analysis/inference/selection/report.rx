<Module>
    <Type from="diagnostic" as="Diagnostic" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Diagnostic.Report} out={void} />

    <Store from="../object_closure/object" as="object" />

    <Call fn="diagnostic" in={$in.issue} />

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.RejectField,
            name_error: $ctx.diagnostic.name_error,
            message: $ctx.diagnostic.message
        }}
        setter={[$store.object.effect]}
    />
</Module>
