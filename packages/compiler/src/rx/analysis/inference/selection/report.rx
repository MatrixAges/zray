<Module>
    <Type from="application/model" as="Selection" />

    <Args in={Selection.Failure} out={void} />

    <Call fn="diagnostic" in={$in.issue} />

    <Call
        fn="../fields/host.reportFieldError"
        in={[
            $in.frame,
            $ctx.diagnostic.code,
            $ctx.diagnostic.message
        ]}
    />
</Module>
