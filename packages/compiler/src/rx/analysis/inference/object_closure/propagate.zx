import { max_nesting_depth } from "core/const"

import type { Initial, Input as Rules } from "./model"

export type Input = {
    rules: Rules,
    initial: Initial
}

export type Output = bool[]

export default function (in: Input): Output {
    const { rules, initial } = in

    return loop({
        count: initial.count,
        position: 0,
        depth: 0,
        level_end: initial.known,
        edge: 0,
        edge_end: 0,
        ready: initial.ready,
        queue: initial.queue,
        pending: rules.sizes
    }, {
        while: state => {
            const has_edge = state.edge < state.edge_end
            const has_node = state.position < state.count

            return state.depth < max_nesting_depth && (has_edge || has_node)
        },
        next: state => {
            if (state.edge < state.edge_end) {
                const rule = rules.dependents[state.edge]
                const result = rules.results[rule]

                if (!state.ready[result]) {
                    const pending = state.pending[rule] - 1

                    state.pending[rule] = pending

                    if (pending == 0) {
                        state.ready[result] = true
                        state.queue = state.queue.push(result)[0]
                        state.count += 1
                    }
                }

                state.edge += 1
            } else {
                if (state.position == state.level_end) {
                    state.depth += 1
                    state.level_end = state.count
                }

                if (state.depth < max_nesting_depth) {
                    const node = state.queue[state.position]

                    state.edge = rules.offsets[node]
                    state.edge_end = rules.offsets[node + 1]
                    state.position += 1
                }
            }
        },
        return: state => state.ready
    })
}
