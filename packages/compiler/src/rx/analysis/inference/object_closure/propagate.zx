import memory from "zig:compiler_memory"
import { max_nesting_depth } from "core/const"

import type { Initial, Request } from "./model"

export type Input = Request & {
    initial: Initial
}

export type Output = void

export default function (in: Input): Output {
    const { rules, work, initial } = in

    const propagated = loop({
        count: initial.count,
        position: 0,
        depth: 0,
        level_end: initial.known,
        edge: 0,
        edge_end: 0
    }, {
        while: state => {
            const has_edge = state.edge < state.edge_end
            const has_node = state.position < state.count

            return state.depth < max_nesting_depth && (has_edge || has_node)
        },
        next: state => {
            if (state.edge < state.edge_end) {
                const rule = rules.dependents[state.edge]
                const result = rules.results[rule]

                if (!work.ready[result]) {
                    const pending = memory.readU64(work.pending, rule) - 1

                    memory.writeU64(work.pending, rule, pending)

                    if (pending == 0) {
                        memory.writeU8(work.ready_output, result, 1)
                        memory.writeU64(work.queue, state.count, result)

                        state.count += 1
                    }
                }

                state.edge += 1
            } else {
                if (state.position == state.level_end) {
                    state.depth += 1
                    state.level_end = state.count
                }

                if (state.depth < max_nesting_depth) {
                    const node = memory.readU64(work.queue, state.position)

                    state.edge = rules.offsets[node]
                    state.edge_end = rules.offsets[node + 1]
                    state.position += 1
                }
            }
        }
    })
}
