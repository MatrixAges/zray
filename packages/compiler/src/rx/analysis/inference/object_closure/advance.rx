<Module>
    <Type from="workflow" as="Readiness" />
    <Type from="query" as="Query" />

    <Args in={Readiness.Cursor} out={Readiness.Cursor} />

    <Call
        fn="query"
        in={{
            ...$in.request.query,
            cache: $in.request.context.cache
        }}
    />

    <If
        on={$ctx.query.action == Query.Action.Rebuild ||
            $ctx.query.action == Query.Action.Propagate}
    >
        <Call
            fn="host.updateObjectReadiness"
            in={[
                $in.request.context.frame,
                $ctx.query.action == Query.Action.Rebuild,
                $ctx.query.position,
                $in.request.query.spread,
                $ctx.query.shared
            ]}
        />

        <Return
            value={{
                request: $in.request,
                running: $ctx.query.action == Query.Action.Rebuild,
                ready: $ctx.updateObjectReadiness
            }}
        />
    </If>

    <Return
        value={{
            request: $in.request,
            running: false,
            ready: $ctx.query.action == Query.Action.Accept
        }}
    />
</Module>
