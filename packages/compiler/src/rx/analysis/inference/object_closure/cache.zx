import type { BoolListBuffer, U32ListBuffer, U64Buffer, U64ListBuffer } from "memory"

export type Cache = {
    revision: u64[],
    index: u32[][],
    edges: u64[][],
    marks: bool[][]
}

export type Slots = {
    revision: U64Buffer,
    index: U32ListBuffer,
    edges: U64ListBuffer,
    marks: BoolListBuffer
}
