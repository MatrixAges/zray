import memory from "memory"

import type { Initial, Request } from "./model"

export type Input = Request

export type Output = Initial

export default function (in: Input): Output {
    const { rules, work } = in

    return loop({
        count: 0,
        known: 0,
        node: 0,
        rule: 0
    }, {
        while: state =>
            state.node < rules.known.length || state.rule < rules.sizes.length,
        next: state => {
            if (state.node < rules.known.length) {
                const node = state.node
                const known = rules.known[node]

                memory.writeU8(work.ready_output, node, known ? 1 : 0)

                if (known) {
                    memory.writeU64(work.queue, state.count, node)

                    state.count += 1
                    state.known += 1
                }

                state.node += 1
            } else {
                const result = rules.results[state.rule]
                const empty = rules.sizes[state.rule] == 0
                const shortcut = rules.spread && state.rule >= rules.constructions
                const admissible = empty || shortcut

                if (admissible && !work.ready[result]) {
                    memory.writeU64(work.queue, state.count, result)
                    memory.writeU8(work.ready_output, result, 1)

                    state.count += 1
                }

                state.rule += 1
            }
        },
        return: state => ({
            count: state.count,
            known: state.known
        })
    })
}
