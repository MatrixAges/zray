import memory from "memory"

import { selection_slot, spread_slot } from "./const"

import type { Publication, Work } from "./model"

export type Input = Publication & Work.Pick("ready")

export type Output = bool

export default function (in: Input): Output {
    const { marks, position, spread, shared } = in

    const ready = memory.boolViews(in.ready)

    if (spread || shared) {
        memory.writeBoolList(marks, spread_slot, ready)
    }

    if (!spread || shared) {
        memory.writeBoolList(marks, selection_slot, ready)
    }

    return ready[position]
}
