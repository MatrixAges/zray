import type { U8Buffer, U64Buffer } from "std:memory"

export type Input = {
    known: bool[],
    sizes: u64[],
    results: u64[],
    offsets: u64[],
    dependents: u64[],
    constructions: u64,
    spread: bool
}

export type Work = {
    ready: bool[],
    ready_output: U8Buffer,
    queue: U64Buffer,
    pending: U64Buffer
}

export type Request = {
    rules: Input,
    work: Work
}

export type Initial = {
    count: u64,
    known: u64
}
