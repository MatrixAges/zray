import type { Cache } from "./cache"
import type { Snapshot, SnapshotInput } from "./layout/model"

export type Input = {
    known: bool[],
    sizes: u64[],
    results: u64[],
    offsets: u64[],
    dependents: u64[],
    constructions: u64,
    spread: bool
}

export type Initial = {
    count: u64,
    known: u64,
    ready: bool[],
    queue: u64[]
}

export type Update = {
    cache: Cache,
    layout: SnapshotInput,
    revision: u64,
    rebuild: bool,
    spread: bool
}

export type UpdateOutcome = {
    revision?: u64,
    snapshot?: Snapshot,
    marks?: bool[]
}
