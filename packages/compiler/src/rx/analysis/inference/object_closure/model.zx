import type { U8Buffer, U64Buffer } from "zig:compiler_memory"

export type Input = {
    known: bool[],
    sizes: u64[],
    results: u64[],
    offsets: u64[],
    dependents: u64[],
    constructions: u64,
    spread: bool
}

export type Work = {
    ready: bool[],
    ready_output: U8Buffer,
    queue: U64Buffer,
    pending: U64Buffer
}

export type Request = {
    rules: Input,
    work: Work
}

export type Initial = {
    count: u64,
    known: u64
}

export type Counters = {
    sizes: u8[],
    pending: U8Buffer
}

export type Publication = {
    position: u64,
    shared: bool
}

export type Proof = Request & {
    counters: Counters,
    publication: Publication
}

export type Result = {
    ready: bool,
    spread: bool,
    selection: bool
}
