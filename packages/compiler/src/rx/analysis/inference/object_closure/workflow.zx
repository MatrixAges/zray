import type { Kind } from "../unification/model"
import type { Cache } from "./cache"
import type { Input } from "./query"

export type Context = {
    cache: Cache,
    kinds: Kind[],
    revision: u64,
    constructions: u64,
    selections: u64
}

export type Spread = {
    context: Context,
    root: u32
}

export type Request = {
    context: Context,
    query: Input.Omit("cache")
}

export type Cursor = {
    request: Request,
    running: bool,
    ready: bool
}
