import type { ObjectReadiness } from "rx_project_host"
import type { Cache } from "./cache"
import type { Input } from "./query"

export type Context = {
    frame: ObjectReadiness,
    cache: Cache
}

export type Request = {
    context: Context,
    query: Input.Omit("cache")
}

export type Cursor = {
    request: Request,
    running: bool,
    ready: bool
}
