import type { ObjectReadiness } from "rx_project_host"
import type { Input, Snapshot } from "./query"

export type Cache = {
    snapshot?: Snapshot
}

export type Context = {
    frame: ObjectReadiness,
    cache: Cache
}

export type Request = {
    context: Context,
    query: Input.Omit("snapshot")
}

export type Cursor = {
    request: Request,
    running: bool,
    ready: bool
}
