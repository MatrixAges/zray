import {
    dependents_slot,
    known_slot,
    offsets_slot,
    results_slot,
    sizes_slot
} from "./const"

import type { Input as Rules, Update } from "./model"

export type Input = Update.Pick("cache", "spread") & {
    constructions: u64
}

export type Output = Rules

export default function (in: Input): Output {
    const { cache, spread, constructions } = in

    return {
        known: cache.marks[known_slot],
        sizes: cache.edges[sizes_slot],
        dependents: cache.edges[dependents_slot],
        constructions,
        spread,
        results: cache.edges[results_slot],
        offsets: cache.edges[offsets_slot]
    }
}
