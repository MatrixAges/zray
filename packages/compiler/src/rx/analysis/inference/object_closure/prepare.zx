import memory from "memory"

import {
    dependents_slot,
    known_slot,
    offsets_slot,
    results_slot,
    sizes_slot
} from "./const"

import type { Input as Rules, Update } from "./model"

export type Input = Update.Pick("cache", "scratch", "work", "spread") & {
    constructions: u64
}

export type Output = Rules

export default function (in: Input): Output {
    const { cache, scratch, work, spread, constructions } = in

    const known = cache.marks[known_slot]
    const sizes = cache.edges[sizes_slot]
    const dependents = cache.edges[dependents_slot]

    memory.allocateBoolViews(work.ready, known.length)
    memory.allocateU64Buffer(scratch, work.queue, known.length)

    if (dependents.length != 0) {
        memory.allocateU64Buffer(scratch, work.pending, sizes.length)
    }

    return {
        known,
        sizes,
        dependents,
        constructions,
        spread,
        results: cache.edges[results_slot],
        offsets: cache.edges[offsets_slot]
    }
}
