<Module>
    <Type from="model" as="ObjectRules" />

    <Args in={ObjectRules.Proof} out={bool} />

    <Call
        fn="initial"
        in={$in.pick([
            "rules",
            "work"
        ])}
    />

    <If on={$in.rules.dependents.length != 0}>
        <Call
            fn="copy_pending"
            in={{
                sizes: $in.rules.sizes,
                pending: $in.work.pending
            }}
        />

        <Call
            fn="propagate"
            in={{
                ...$in.pick([
                    "rules",
                    "work"
                ]),
                initial: $ctx.initial
            }}
        />
    </If>

    <Call
        fn="publish"
        in={{
            ...$in.publication,
            ready: $in.work.ready
        }}
    />

    <Return value={$ctx.publish} />
</Module>
