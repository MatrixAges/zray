<Module>
    <Type from="model" as="ObjectRules" />

    <Args in={ObjectRules.Request} out={void} />

    <Call fn="initial" in={$in} />

    <If on={$in.rules.dependents.length != 0}>
        <Call
            fn="propagate"
            in={{
                ...$in,
                initial: $ctx.initial
            }}
        />
    </If>
</Module>
