import position from "core/integer/index/lookup"

import { Kind } from "../unification/model"
import {
    buckets_slot,
    keys_slot,
    revision_slot,
    selection_slot,
    spread_slot
} from "./const"

import type { Kind as Shape } from "../unification/model"
import type { Cache } from "./cache"

export type Input = {
    root: u32,
    kind: Shape,
    revision: u64,
    constructions: u64,
    selections: u64,
    cache: Cache,
    spread: bool
}

export enum Action {
    Accept,
    Reject,
    Rebuild,
    Propagate
}

export type Output = {
    action: Action,
    position: u64,
    shared: bool
}

export default function (in: Input): Output {
    const rejected: Output = {
        action: Action.Reject,
        position: 0,
        shared: false
    }

    if (in.kind == Kind.Known) {
        return {
            ...rejected,
            action: Action.Accept
        }
    }

    if (in.constructions == 0 && in.selections == 0) {
        return rejected
    }

    const cache = in.cache
    const keys = cache.index[keys_slot]

    if (keys.length == 0 || cache.revision[revision_slot] != in.revision) {
        return {
            ...rejected,
            action: Action.Rebuild
        }
    }

    const entry = position({
        keys,
        buckets: cache.index[buckets_slot],
        key: in.root
    })

    if (entry == null) {
        return rejected
    }

    const slot = in.spread ? spread_slot : selection_slot
    const cached = cache.marks[slot]

    if (cached.length == 0) {
        return {
            action: Action.Propagate,
            position: entry,
            shared: in.selections == 0
        }
    }

    return {
        ...rejected,
        action: cached[entry] ? Action.Accept : Action.Reject
    }
}
