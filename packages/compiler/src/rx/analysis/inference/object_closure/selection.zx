import integers from "std:integer"

import shape from "../fields/shape"
import { Mode } from "../fields/view"
import representative from "../forest/borrowed_root"
import query from "./query"
import { Action } from "./query"

import type { U32Buffer } from "memory"
import type { Columns } from "../fields/shape"
import type { Mode as ObjectMode } from "../fields/view"
import type { Output as Plan, Snapshot } from "./query"

export type Input = {
    parents: U32Buffer,
    columns: Columns,
    sources: u32[],
    revision: u64,
    constructions: u64,
    snapshot?: Snapshot,
    start: u64,
    final: bool
}

export type Output = {
    row: u64,
    root: u32,
    mode: ObjectMode,
    plan: Plan
}

export default function (in: Input): Output {
    const missing: u32 = 0

    const rejected: Plan = {
        action: Action.Reject,
        position: 0,
        shared: false
    }

    const selected = loop({
        row: in.start,
        root: missing,
        plan: rejected,
        found: false
    }, {
        while: state => !state.found && state.row < in.sources.length,
        next: state => {
            const root = representative({
                parents: in.parents,
                value: in.sources[state.row]
            })
            const plan = query({
                root,
                kind: in.columns.kinds[integers.widen(root)],
                revision: in.revision,
                constructions: in.constructions,
                selections: in.sources.length,
                snapshot: in.snapshot,
                spread: false
            })

            if (plan.action == Action.Reject && !in.final) {
                state.row += 1
            } else {
                state.root = root
                state.plan = plan
                state.found = true
            }
        },
        return: state => ({
            row: state.row,
            root: state.root,
            plan: state.plan
        })
    })

    const { row, root, plan } = selected

    const selected_source =
        plan.action == Action.Accept || plan.action == Action.Propagate

    const mode = match {
        selected_source => shape({
            columns: in.columns,
            root
        }).mode,
        _ => Mode.Unknown
    }

    return {
        row,
        root,
        mode,
        plan
    }
}
