<Module>
    <Type from="model" as="Readiness" />

    <Args in={Readiness.Update} out={Readiness.UpdateOutcome} />

    <If on={$in.rebuild}>
        <Call module="layout/snapshot" in={$in.layout} />

        <Return
            value={{
                revision: $in.revision,
                snapshot: $ctx.snapshot,
                marks: null
            }}
        />
    </If>

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "cache",
                "spread"
            ]),
            constructions: $in.layout.columns.construction_results.length
        }}
    />

    <Call module="prove" />

    <Return
        value={{
            revision: null,
            snapshot: null,
            marks: $ctx.prove
        }}
    />
</Module>
