<Module>
    <Type from="model" as="Readiness" />

    <Args in={Readiness.Update} out={Readiness.UpdateOutcome} />

    <If on={$in.rebuild}>
        <Call module="layout/snapshot" in={$in.layout} />

        <Call
            fn="publish_snapshot"
            in={{
                layout: $ctx.snapshot,
                slots: $in.slots
            }}
        />

        <Return
            value={{
                ready: false,
                revision: $in.revision
            }}
        />
    </If>

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "cache",
                "scratch",
                "work",
                "spread"
            ]),
            constructions: $in.layout.columns.construction_results.length
        }}
    />

    <Call
        module="prove"
        in={{
            rules: $ctx.prepare,
            work: $in.work,
            publication: {
                marks: $in.slots.marks,
                ...$in.pick([
                    "position",
                    "spread",
                    "shared"
                ])
            }
        }}
    />

    <Return
        value={{
            ready: $ctx.prove
        }}
    />
</Module>
