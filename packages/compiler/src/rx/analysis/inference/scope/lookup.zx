import contains from "../../../../zx/analysis/semantic/resolving/contains"
import candidate from "./candidate"
import { implicit_input_name } from "./const"

import type { Candidates, Query } from "./model"

export type Input = Query & {
    facts: string[],
    identifier: bool
}

export type Request = Input & {
    candidates: Candidates
}

export type Output = {
    next: u64,
    first?: u32,
    second?: u32,
    implicit_input: bool,
    refined: bool
}

export default function (in: Input): Output {
    const missing: u32? = null
    const active = in.active
    const name = in.name
    const topology = in.topology

    const matches = loop({
        next: in.start,
        first: missing,
        second: missing
    }, {
        while: state => state.second == null && state.next < active.names.length,
        next: state => {
            const row = state.next
            state.next += 1

            const value = candidate({
                topology,
                active,
                name,
                row
            })

            if (value != null) {
                if (state.first == null) {
                    state.first = value
                } else {
                    state.second = value
                }
            }
        },
        return: state => state
    })

    return {
        ...matches,
        implicit_input: in.identifier && name == implicit_input_name,
        refined: contains({
            names: in.facts,
            name
        })
    }
}
