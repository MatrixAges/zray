import overlaps from "../../../../zx/analysis/expression_program/bindings/path/overlaps"
import { Collision } from "../bindings/model"
import pair from "../bindings/pair"

import type { Query } from "./model"

export type Input = Query & {
    value: u32,
    end: u64
}

export type Output = {
    next: u64,
    action: Collision,
    left: u32
}

export default function (in: Input): Output {
    const active = in.active
    const name = in.name
    const value = in.value
    const topology = in.topology
    const no_binding: u32 = 0

    return loop({
        next: in.start,
        action: Collision.Ignore,
        left: no_binding
    }, {
        while: state =>
            state.action == Collision.Ignore && state.next < in.end,
        next: state => {
            const row = state.next
            state.next += 1

            if (overlaps({
                left: active.names[row],
                right: name
            })) {
                const left = active.values[row]
                state.action = pair({
                    topology,
                    left,
                    right: value,
                    final: false
                })

                state.left = left
            }
        },
        return: state => state
    })
}
