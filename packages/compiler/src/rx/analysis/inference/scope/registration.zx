import type { Topology } from "../bindings/model"
import type { Active } from "./model"

export type DeferredPair = {
    row: u64,
    left: u32,
    right: u32
}

export type Input = {
    topology: Topology,
    active: Active,
    incoming: Active,
    parallel: bool
}

export type Output = {
    deferred: DeferredPair[],
    conflict_row?: u64
}
