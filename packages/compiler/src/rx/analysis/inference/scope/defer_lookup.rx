<Module>
    <Type from="deferred" as="Scope" />

    <Args in={Scope.NewLookup} out={u32} />

    <Call fn="lookup_host.reserveScopeLookupNode" in={$in.destination.frame} />
    <Call fn="lookup_host.reserveScopeLookupRow" in={$in.destination.frame} />

    <Call module="../nodes/append" in={$in.destination.node} />

    <Call
        fn="publish_lookup"
        in={{
            node: $in.destination.node.first,
            span: $in.destination.node.span.omit(["rows"]),
            rows: $in.destination.rows
        }}
    />

    <Return value={$ctx.publish_lookup} />
</Module>
