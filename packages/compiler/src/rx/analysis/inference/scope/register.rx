<Module>
    <Type from="registration" as="Scope" />

    <Args in={Scope.Request} out={void} />

    <Loop on={$in.running}>
        <Call
            module="advance_registration"
            in={{
                request: $in,
                row: $in.batch != null ? 1 : 0,
                next: 0,
                count: $in.count,
                published: 0,
                running: true
            }}
        />
    </Loop>
</Module>
