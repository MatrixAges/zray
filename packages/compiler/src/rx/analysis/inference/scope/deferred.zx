import type { IndexBuffer, SourceSpanBuffer, U32Buffer } from "memory"
import type { ScopeLookup } from "rx_project_host"
import type { Input as Append } from "../nodes/append"

export type Lookups = {
    values: U32Buffer,
    spans: SourceSpanBuffer,
    length: IndexBuffer,
    position: u64
}

export type Destination = {
    frame: ScopeLookup,
    node: Append,
    rows: Lookups
}

export type NewLookup = {
    destination: Destination
}
