import memory from "memory"

import candidate from "./candidate"
import { initial_candidate_capacity } from "./const"

import type { Candidates, Query } from "./model"

export type Input = Query & {
    candidates: Candidates,
    first: u32,
    second: u32
}

export type Output = void

export default function (in: Input): Output {
    const { scratch, values, lengths } = in.candidates

    const visible = in.active.names.length

    const capacity = match {
        visible < initial_candidate_capacity => visible,
        _ => initial_candidate_capacity
    }

    memory.growU32Scratch(scratch, capacity, true)
    memory.writeU32(values, 0, in.first)
    memory.writeU32(values, 1, in.second)
    memory.publishColumnLengths(lengths, 2)

    const collected = loop({
        next: in.start,
        count: 2
    }, {
        while: state => state.next < visible,
        next: state => {
            const value = candidate({
                topology: in.topology,
                active: in.active,
                name: in.name,
                row: state.next
            })

            if (value != null) {
                if (state.count == memory.u32BufferLength(values)) {
                    memory.growU32Scratch(scratch, state.count + 1, false)
                }

                memory.writeU32(values, state.count, value)
                memory.publishColumnLengths(lengths, 1)
                state.count += 1
            }

            state.next += 1
        }
    })
}
