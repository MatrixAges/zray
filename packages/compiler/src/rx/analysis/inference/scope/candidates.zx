import candidate from "./candidate"

import type { Query } from "./model"

export type Input = Query & {
    first: u32,
    second: u32
}

export type Output = u32[]

export default function (in: Input): Output {
    const visible = in.active.names.length

    const initial: u32[] = [
        in.first,
        in.second
    ]

    return loop({
        next: in.start,
        values: initial
    }, {
        while: state => state.next < visible,
        next: state => {
            const value = candidate({
                topology: in.topology,
                active: in.active,
                name: in.name,
                row: state.next
            })

            if (value != null) {
                state.values = state.values.push(value)[0]
            }

            state.next += 1
        },
        return: state => state.values
    })
}
