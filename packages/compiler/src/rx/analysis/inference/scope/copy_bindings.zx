import memory from "memory"

import type { Publication } from "./registration"

export type Input = Publication.Omit("frame") & {
    offset: u64
}

export type Output = void

export default function (in: Input): Output {
    const { target, incoming, spans, first, end, offset } = in

    const count = end - first
    const names = memory.borrowStringRange(incoming.names, first, count)

    memory.copyStringViewsAt(target.names, offset, names)
    memory.copyU32Range(target.values, offset, incoming.values, first, end)

    const copied = memory.copyBytes(
        target.spans,
        offset * spans.width,
        spans.source,
        first * spans.width,
        end * spans.width
    )

    memory.writeIndex(target.length, 0, offset + count)
}
