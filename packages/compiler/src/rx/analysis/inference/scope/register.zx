import { Collision } from "../bindings/model"
import collision from "./collision"

import type { DeferredPair, Input, Output } from "./registration"

export default function (in: Input): Output {
    const { topology, active, incoming } = in

    const deferred: DeferredPair[] = []
    const conflict_row: u64? = null

    return loop({
        row: in.parallel ? 1 : 0,
        next: 0,
        deferred,
        conflict_row
    }, {
        while: state => state.conflict_row == null && state.row < incoming.names.length,
        next: state => {
            const row = state.row
            const right = incoming.values[row]
            const pair = collision({
                topology,
                active,
                name: incoming.names[row],
                value: right,
                start: state.next,
                end: in.parallel ? row : active.names.length
            })

            if (pair.action == Collision.Ignore) {
                state.row += 1
                state.next = 0
            } else if (pair.action == Collision.Conflict) {
                state.conflict_row = row
            } else {
                state.deferred = state.deferred.push({
                    row,
                    left: pair.left,
                    right
                })[0]
                state.next = pair.next
            }
        },
        return: state => state.pick([
            "deferred",
            "conflict_row"
        ])
    })
}
