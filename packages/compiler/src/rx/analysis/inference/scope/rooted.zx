import bytes from "std:bytes"

import { implicit_input_name } from "./const"
import startsAtRoot from "./path_root"

export type Input = {
    names: string[],
    path: u8[],
    implicit_input: bool
}

export type Output = bool

export default function (in: Input): Output {
    const path = in.path
    const names = in.names

    if (in.implicit_input) {
        const input_path = startsAtRoot({
            root: bytes.fromText(implicit_input_name),
            path
        })

        if (input_path) {
            return true
        }
    }

    return loop({
        row: 0,
        found: false
    }, {
        while: state => !state.found && state.row < names.length,
        next: state => {
            const root = bytes.fromText(names[state.row])

            state.found = startsAtRoot({
                path,
                root
            })

            state.row += 1
        },
        return: state => state.found
    })
}
