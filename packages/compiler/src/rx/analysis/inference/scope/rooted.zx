import bytes from "std:bytes"
import { ascii_dot } from "core/ascii/const"

import overlaps from "../../../../zx/analysis/expression_program/bindings/path/overlaps"
import { implicit_input_name } from "./const"

export type Input = {
    names: string[],
    path: string,
    implicit_input: bool
}

export type Output = bool

export default function (in: Input): Output {
    const path = bytes.fromText(in.path)
    const names = in.names

    if (in.implicit_input) {
        const input_path = overlaps({
            left: implicit_input_name,
            right: in.path
        })

        if (input_path) {
            return true
        }
    }

    return loop({
        row: 0,
        found: false
    }, {
        while: state => !state.found && state.row < names.length,
        next: state => {
            const root = bytes.fromText(names[state.row])

            if (root.length == path.length) {
                state.found = bytes.equals(path, root)
            } else if (root.length < path.length) {
                state.found =
                    path[root.length] == ascii_dot && bytes.startsWith(path, 0, root)
            }

            state.row += 1
        },
        return: state => state.found
    })
}
