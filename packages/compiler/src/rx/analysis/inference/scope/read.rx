<Module>
    <Type from="lookup" as="Lookup" />
    <Type from="model" as="Scope" />

    <Args in={Lookup.Input} out={Scope.LookupResult} />

    <Call fn="lookup" in={$in} />

    <If on={$ctx.lookup.second != null}>
        <Call
            fn="candidates"
            in={{
                ...$in.pick([
                    "topology",
                    "active",
                    "name"
                ]),
                first: $ctx.lookup.first ?? 0,
                second: $ctx.lookup.second ?? 0,
                start: $ctx.lookup.next
            }}
        />

        <Return
            value={{
                ...$ctx.lookup.pick([
                    "implicit_input",
                    "refined"
                ]),
                value: null,
                candidates: $ctx.candidates
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.lookup.pick([
                "implicit_input",
                "refined"
            ]),
            value: $ctx.lookup.first,
            candidates: null
        }}
    />
</Module>
