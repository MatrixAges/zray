<Module>
    <Type from="request" as="Classes" />
    <Type from="model" as="AssignmentClasses" />

    <Args in={Classes.Input} out={AssignmentClasses.Created} />

    <Call
        module="payload/run"
        in={{
            view: $in.view,
            initial_count: $in.nodes.kinds.length
        }}
    />

    <Call
        module="build"
        in={{
            payloads: $ctx.run,
            nodes: $in.nodes,
            edges: $in.rows.edges,
            count: $ctx.run.initial.length + $ctx.run.registered.length
        }}
    />

    <Return
        value={{
            ...$ctx.run,
            ...$ctx.build
        }}
    />
</Module>
