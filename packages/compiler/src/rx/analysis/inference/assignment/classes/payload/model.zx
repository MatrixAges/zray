import type { U32Buffer } from "memory"
import type { AssignmentApplication } from "rx_project_host"
import type { View } from "../../application/merge"
import type { Cursor } from "../payloads"

export type Request = {
    frame: AssignmentApplication,
    view: View,
    payloads: U32Buffer
}

export type Range = {
    request: Request,
    start: u64,
    limit: u64
}

export type Iteration = Cursor & {
    range: Range
}
