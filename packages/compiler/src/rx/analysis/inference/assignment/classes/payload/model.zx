import type { View } from "../../application/merge"
import type { Cursor } from "../payloads"

export type Request = {
    view: View,
    initial_count: u64
}

export type Range = {
    request: Request.Omit("initial_count"),
    start: u64,
    limit: u64
}

export type Iteration = Cursor & {
    range: Range
}
