import integers from "std:integer"

import { Kind } from "../../unification/model"

import type { Nodes, Payloads } from "../model"

export type Input = {
    parents: u32[],
    payloads: Payloads,
    nodes: Nodes
}

export type Output = u32?[]

export default function (in: Input): Output {
    const parents = in.parents
    const initial = in.payloads.initial
    const registered = in.payloads.registered
    const absent: u32? = null
    const empty: u32?[] = []

    const representatives = loop(empty, {
        while: items => items.length < parents.length,
        next: items => {
            items = items.push(absent)[0]
        },
        return: items => items
    })

    return loop({
        position: 0,
        representatives
    }, {
        while: state => state.position < parents.length,
        next: state => {
            const position = state.position
            const payload = match {
                position < initial.length => initial[position],
                _ => registered[position - initial.length]
            }
            const index = integers.widen(payload)

            if (
                in.nodes.kinds[index] != Kind.Unknown ||
                    in.nodes.allowed[index] != null
            ) {
                const parent = parents[index]

                state.representatives[integers.widen(parent)] = payload
            }

            state.position += 1
        },
        return: state => state.representatives
    })
}
