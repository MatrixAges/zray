import integers from "std:integer"
import memory from "zig:compiler_memory"

import { Kind } from "../../unification/model"

import type { OptionalU32Buffer } from "zig:compiler_memory"
import type { Nodes, Payloads } from "../model"

export type Input = {
    parents: u32[],
    payloads: Payloads,
    nodes: Nodes,
    target: OptionalU32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const parents = in.parents
    const initial = in.payloads.initial
    const registered = in.payloads.registered

    const published = loop(0, {
        while: position => position < parents.length,
        next: position => {
            const payload = match {
                position < initial.length => initial[position],
                _ => registered[position - initial.length]
            }
            const index = integers.widen(payload)

            if (
                in.nodes.kinds[index] != Kind.Unknown ||
                    in.nodes.allowed[index] != null
            ) {
                const parent = parents[index]

                memory.writeOptionalU32(
                    in.target,
                    integers.widen(parent),
                    payload
                )
            }

            position += 1
        }
    })
}
