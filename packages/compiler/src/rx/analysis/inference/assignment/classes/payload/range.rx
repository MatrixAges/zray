<Module>
    <Type from="model" as="Payload" />

    <Args in={Payload.Range} out={u32[]} />

    <Loop on={$in.next < $in.range.limit}>
        <Call
            module="advance"
            in={{
                range: $in,
                next: $in.start,
                source: null,
                remaining: null,
                values: []
            }}
        />
    </Loop>

    <Return value={$ctx.advance.values} />
</Module>
