<Module>
    <Type from="model" as="Payload" />
    <Type from="../payloads" as="Scan" />
    <Type from="../../../solve/replay_effect" as="Effect" />

    <Args in={Payload.Iteration} out={Payload.Iteration} />

    <Store from="../../../solve/replay" as="replay" />

    <Call
        fn="../payloads"
        in={{
            view: $in.range.request.view,
            limit: $in.range.limit,
            next: $in.next,
            source: $in.source,
            remaining: $in.remaining,
            values: $in.values
        }}
    />

    <If on={$ctx.payloads.action == Scan.Action.Depth}>
        <Call
            fn="../../../solve/stage_replay"
            in={{
                step: Effect.Step.RejectAssignmentDepth,
                left: $ctx.payloads.origin
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <If on={$ctx.payloads.action == Scan.Action.Register}>
        <Call
            fn="../../../solve/stage_replay"
            in={{
                step: Effect.Step.RegisterAssignmentPayload,
                left: $ctx.payloads.origin,
                right: $ctx.payloads.source,
                budget: $ctx.payloads.remaining ?? 0
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="../../../solve/read_assignment_payload" in={$store.replay.effect} />

        <Return
            value={{
                range: $in.range,
                next: $ctx.payloads.next,
                source: $ctx.read_assignment_payload.id,
                remaining: $ctx.read_assignment_payload.remaining,
                values: $ctx.payloads.values
            }}
        />
    </If>

    <Return
        value={{
            range: $in.range,
            next: $ctx.payloads.next,
            source: $ctx.payloads.source,
            remaining: $ctx.payloads.remaining,
            values: $ctx.payloads.values
        }}
    />
</Module>
