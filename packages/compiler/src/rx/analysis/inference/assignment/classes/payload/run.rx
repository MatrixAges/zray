<Module>
    <Type from="../../model" as="Assignment" />
    <Type from="model" as="Payload" />

    <Args in={Payload.Request} out={Assignment.Payloads} />

    <Task name="initial" out={$ctx.range}>
        <Call
            module="range"
            in={{
                request: $in.omit(["initial_count"]),
                start: 0,
                limit: $in.initial_count
            }}
        />
    </Task>

    <Call
        module="range"
        in={{
            request: $in.omit(["initial_count"]),
            start: $in.initial_count,
            limit: $in.view.parents.length
        }}
    />

    <Return
        value={{
            initial: $ctx.task.initial,
            registered: $ctx.range
        }}
    />
</Module>
