import type { OptionalU32Buffer, U8Buffer, U32Buffer } from "zig:compiler_memory"
import type { Edges, Nodes, Payloads } from "../model"

export type Storage = {
    parents: U32Buffer,
    ranks: U8Buffer,
    representatives: OptionalU32Buffer
}

export type Input = {
    payloads: Payloads,
    nodes: Nodes,
    edges: Edges,
    storage: Storage,
    parents: u32[],
    ranks: u8[]
}
