import integers from "std:integer"
import memory from "memory"

import root from "./root"

import type { Edges } from "../model"
import type { Storage } from "./model"

export type Input = {
    payloads: u32[],
    parents: u32[],
    ranks: u8[],
    edges: Edges,
    storage: Storage
}

export type Output = void

export default function (in: Input): Output {
    const { parents, ranks, edges, storage } = in

    const joined = loop({
        edge: 0,
        index: 0
    }, {
        while: state =>
            state.edge < edges.left.length || state.index < parents.length,
        next: state => {
            if (state.edge == edges.left.length) {
                const parent = root({
                    parents,
                    item: integers.narrow(state.index)
                })

                memory.writeU32(storage.parents, state.index, parent)
                state.index += 1
            } else {
                const source = edges.left[state.edge]
                const target = edges.right[state.edge]
                const left_root = root({
                    parents,
                    item: in.payloads[integers.widen(source)]
                })
                const right_root = root({
                    parents,
                    item: in.payloads[integers.widen(target)]
                })

                const left = integers.widen(left_root)
                const right = integers.widen(right_root)

                if (left != right) {
                    const left_rank = ranks[left]
                    const right_rank = ranks[right]

                    if (left_rank < right_rank) {
                        memory.writeU32(storage.parents, left, right_root)
                    } else {
                        memory.writeU32(storage.parents, right, left_root)

                        if (left_rank == right_rank) {
                            memory.writeU8(
                                storage.ranks,
                                left,
                                left_rank + 1
                            )
                        }
                    }
                }

                state.edge += 1
            }
        }
    })
}
