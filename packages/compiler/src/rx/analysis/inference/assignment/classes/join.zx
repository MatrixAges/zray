import integers from "std:integer"

import root from "./root"

import type { Edges } from "../model"

export type Input = {
    payloads: u32[],
    count: u64,
    edges: Edges
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty_parents: u32[] = []

    const initial_parents = loop(empty_parents, {
        while: parents => parents.length < in.count,
        next: parents => {
            const id = integers.narrow(parents.length)

            parents = parents.push(id)[0]
        },
        return: parents => parents
    })

    const zero_rank: u8 = 0
    const empty_ranks: u8[] = []

    const initial_ranks = loop(empty_ranks, {
        while: ranks => ranks.length < in.count,
        next: ranks => {
            ranks = ranks.push(zero_rank)[0]
        },
        return: ranks => ranks
    })

    const { edges } = in

    return loop({
        parents: initial_parents,
        ranks: initial_ranks,
        edge: 0,
        index: 0
    }, {
        while: state =>
            state.edge < edges.left.length || state.index < in.count,
        next: state => {
            if (state.edge == edges.left.length) {
                const parent = root({
                    parents: state.parents,
                    item: integers.narrow(state.index)
                })

                state.parents[state.index] = parent
                state.index += 1
            } else {
                const source = edges.left[state.edge]
                const target = edges.right[state.edge]
                const left_root = root({
                    parents: state.parents,
                    item: in.payloads[integers.widen(source)]
                })
                const right_root = root({
                    parents: state.parents,
                    item: in.payloads[integers.widen(target)]
                })

                const left = integers.widen(left_root)
                const right = integers.widen(right_root)

                if (left != right) {
                    const left_rank = state.ranks[left]
                    const right_rank = state.ranks[right]

                    if (left_rank < right_rank) {
                        state.parents[left] = right_root
                    } else {
                        state.parents[right] = left_root

                        if (left_rank == right_rank) {
                            state.ranks[left] = left_rank + 1
                        }
                    }
                }

                state.edge += 1
            }
        },
        return: state => state.parents
    })
}
