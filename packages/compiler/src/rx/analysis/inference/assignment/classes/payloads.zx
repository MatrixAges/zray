import integers from "std:integer"
import { max_nesting_depth } from "core/const"
import memory from "memory"

import payload from "../../optional/payload"
import { Action as PayloadAction } from "../../optional/payload"

import type { U32Buffer } from "memory"
import type { View } from "../application/merge"

export enum Action {
    Scan,
    Register,
    Depth
}

export type Range = {
    start: u64,
    limit: u64
}

export type Cursor = {
    next: u64,
    source?: u32,
    remaining?: u64
}

export type Input = Cursor & {
    view: View,
    payloads: U32Buffer,
    range: Range
}

export type Output = Cursor.Omit("source") & {
    source: u32,
    origin: u32,
    action: Action
}

export default function (in: Input): Output {
    const { graph, known, parents } = in.view
    const { start, limit } = in.range

    const payloads = in.payloads
    const source = in.source ?? integers.narrow(in.next)

    const initial: Output = {
        next: in.next,
        source,
        remaining: in.remaining,
        origin: source,
        action: Action.Scan
    }

    return loop(initial, {
        while: state =>
            state.action == Action.Scan &&
            state.next < limit,
        next: state => {
            const source = state.source
            const result = payload({
                graph,
                known,
                parents,
                value: source,
                remaining: state.remaining ?? max_nesting_depth
            })

            if (result.action == PayloadAction.Register) {
                state.source = result.value
                state.origin = result.root
                state.remaining = result.remaining
                state.action = Action.Register
            } else if (result.action == PayloadAction.Depth) {
                state.origin = result.root
                state.action = Action.Depth
            } else {
                memory.writeU32(
                    payloads,
                    state.next - start,
                    result.root
                )

                state.next += 1
                state.remaining = null

                if (state.next < limit) {
                    state.source = integers.narrow(state.next)
                }
            }
        },
        return: state => state
    })
}
