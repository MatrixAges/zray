import integers from "std:integer"
import memory from "std:memory"
import { max_nesting_depth } from "core/const"

import representative from "../../forest/borrowed_root"
import { Route as WalkRoute } from "../../optional/model"
import walk from "../../optional/walk"

import type { U32Buffer } from "std:memory"
import type { Graph } from "../../optional/model"

export enum Action {
    Scan,
    Register,
    Depth
}

export type Input = {
    graph: Graph,
    parents: U32Buffer,
    payloads: U32Buffer,
    start: u64,
    limit: u64,
    next: u64,
    source: u32,
    origin: u32,
    remaining?: u64,
    action: Action
}

export type Output = Input.Omit("graph", "payloads", "start", "limit", "parents")

export default function (in: Input): Output {
    return loop(in, {
        while: state =>
            state.action == Action.Scan &&
            state.next < state.limit,
        next: state => {
            const source = state.source
            const result = walk({
                graph: state.graph,
                parents: state.parents,
                value: source,
                root: source,
                remaining: state.remaining ?? max_nesting_depth,
                route: WalkRoute.Boundary
            })

            if (result.route == WalkRoute.Declared) {
                state.source = result.value
                state.origin = result.root
                state.remaining = result.remaining
                state.action = Action.Register
            } else if (result.route == WalkRoute.Boundary) {
                const boundary = representative({
                    parents: state.parents,
                    value: result.value
                })

                state.origin = boundary
                state.action = Action.Depth
            } else {
                memory.writeU32(
                    state.payloads,
                    state.next - state.start,
                    result.root
                )

                state.next += 1
                state.remaining = null

                if (state.next < state.limit) {
                    state.source = integers.narrow(state.next)
                }
            }
        },
        return: state => ({
            next: state.next,
            source: state.source,
            origin: state.origin,
            remaining: state.remaining,
            action: state.action
        })
    })
}
