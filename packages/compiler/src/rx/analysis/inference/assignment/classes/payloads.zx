import integers from "std:integer"
import memory from "zig:compiler_memory"
import { max_nesting_depth } from "core/const"

import payload from "../../optional/payload"
import { Action as PayloadAction } from "../../optional/payload"

import type { U32Buffer } from "zig:compiler_memory"
import type { State as Known } from "core/integer/map/model"
import type { Graph } from "../../optional/model"

export enum Action {
    Scan,
    Register,
    Depth
}

export type Input = {
    graph: Graph,
    known: Known,
    parents: U32Buffer,
    payloads: U32Buffer,
    start: u64,
    limit: u64,
    next: u64,
    source: u32,
    origin: u32,
    remaining?: u64,
    action: Action
}

export type Output =
    Input.Omit("graph", "known", "payloads", "start", "limit", "parents")

export default function (in: Input): Output {
    return loop(in, {
        while: state =>
            state.action == Action.Scan &&
            state.next < state.limit,
        next: state => {
            const source = state.source
            const result = payload({
                graph: state.graph,
                known: state.known,
                parents: state.parents,
                value: source,
                remaining: state.remaining ?? max_nesting_depth
            })

            if (result.action == PayloadAction.Register) {
                state.source = result.value
                state.origin = result.root
                state.remaining = result.remaining
                state.action = Action.Register
            } else if (result.action == PayloadAction.Depth) {
                state.origin = result.root
                state.action = Action.Depth
            } else {
                memory.writeU32(
                    state.payloads,
                    state.next - state.start,
                    result.root
                )

                state.next += 1
                state.remaining = null

                if (state.next < state.limit) {
                    state.source = integers.narrow(state.next)
                }
            }
        },
        return: state => ({
            next: state.next,
            source: state.source,
            origin: state.origin,
            remaining: state.remaining,
            action: state.action
        })
    })
}
