<Module>
    <Type from="model" as="AssignmentClasses" />
    <Type from="../model" as="Assignment" />

    <Args in={AssignmentClasses.Input} out={Assignment.ClassLookup} />

    <Call
        fn="join"
        in={{
            payloads: $in.payloads.initial,
            count: $in.count,
            edges: $in.edges
        }}
    />

    <Call
        fn="representatives"
        in={{
            parents: $ctx.join,
            payloads: $in.payloads,
            nodes: $in.nodes
        }}
    />

    <Return
        value={{
            groups: $ctx.join,
            representatives: $ctx.representatives
        }}
    />
</Module>
