<Module>
    <Type from="model" as="AssignmentClasses" />

    <Args in={AssignmentClasses.Input} out={void} />

    <Call
        fn="initialize"
        in={{
            storage: $in.storage,
            parents: $in.parents
        }}
    />

    <Call
        fn="join"
        in={{
            payloads: $in.payloads.initial,
            parents: $in.parents,
            ranks: $in.ranks,
            edges: $in.edges,
            storage: $in.storage
        }}
    />

    <Call
        fn="representatives"
        in={{
            parents: $in.parents,
            payloads: $in.payloads,
            nodes: $in.nodes,
            target: $in.storage.representatives
        }}
    />
</Module>
