import type { U32Buffer } from "memory"
import type { ConstraintRound, ProjectionGraph, ProjectionSpans } from "rx_project_host"
import type { Graph } from "../../optional/model"
import type { Diagnostic } from "../../projections/site"
import type { Session as Resolver } from "../../resolve/model"
import type { Edges } from "../model"

export enum Action {
    Scan,
    Resolve,
    Mismatch
}

export type Columns = Edges & {
    graph: Graph,
    parents: U32Buffer
}

export type Cursor = {
    index: u64,
    source_type?: u32,
    resolved?: u32
}

export type Scan = Columns & Cursor

export type Result = Cursor.Pick("index", "source_type") & {
    node: u32,
    action: Action
}

export type Request = {
    frame: ConstraintRound,
    resolver: Resolver,
    owner: ProjectionGraph,
    spans: ProjectionSpans,
    columns: Columns
}

export type Iteration = Cursor & {
    request: Request,
    diagnostic?: Diagnostic
}
