import accepts from "../../optional/known"
import endpoint from "./endpoint"

import type { U32Buffer } from "zig:compiler_memory"
import type { Graph } from "../../optional/model"
import type { Edges } from "../model"

export enum Action {
    Scan,
    Resolve,
    Mismatch
}

export type Input = {
    graph: Graph,
    edges: Edges,
    parents: U32Buffer,
    index: u64,
    source_type?: u32,
    resolved?: u32
}

export type Output = Input.Pick("index", "source_type") & {
    node: u32,
    action: Action
}

export default function (in: Input): Output {
    const { graph, edges, parents } = in

    const source: u32? = in.source_type == null ? in.resolved : in.source_type
    const target: u32? = in.source_type == null ? null : in.resolved
    const no_node: u32 = 0

    return loop({
        index: in.index,
        source_type: source,
        target_type: target,
        node: no_node,
        action: Action.Scan
    }, {
        while: state => state.action == Action.Scan && state.index < edges.left.length,
        next: state => {
            if (state.source_type == null) {
                const source = endpoint({
                    graph,
                    parents,
                    value: edges.left[state.index]
                })

                state.source_type = source.known

                if (source.known == null) {
                    state.node = source.node
                    state.action = Action.Resolve
                }
            }

            if (state.action == Action.Scan && state.target_type == null) {
                const expected = endpoint({
                    graph,
                    parents,
                    value: edges.right[state.index]
                })

                state.target_type = expected.known

                if (expected.known == null) {
                    state.node = expected.node
                    state.action = Action.Resolve
                }
            }

            const expected = state.target_type

            if (state.action == Action.Scan && expected != null) {
                const result = accepts({
                    types: graph.types,
                    expected,
                    actual: state.source_type
                })

                if (result.accepts) {
                    state.index += 1
                    state.source_type = null
                    state.target_type = null
                } else {
                    state.action = Action.Mismatch
                }
            }
        },
        return: state => ({
            index: state.index,
            source_type: state.source_type,
            node: state.node,
            action: state.action
        })
    })
}
