<Module>
    <Type from="model" as="Validation" />

    <Args in={Validation.Request} out={void} />

    <Loop on={$in.index < $in.request.columns.left.length}>
        <Call
            module="advance"
            in={{
                request: $in,
                index: 0,
                source_type: null,
                resolved: null
            }}
        />
    </Loop>
</Module>
