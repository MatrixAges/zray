import representative from "../../forest/borrowed_root"

import type { Edges } from "../model"
import type { Normalization } from "./model"

export type Input = Normalization

export type Output = Edges

export default function (in: Input): Output {
    const { assignments, parents } = in

    const left = assignments.left.map(
        value => representative({
            parents,
            value
        })
    )[0]

    const right = assignments.right.map(
        value => representative({
            parents,
            value
        })
    )[0]

    return {
        left,
        right
    }
}
