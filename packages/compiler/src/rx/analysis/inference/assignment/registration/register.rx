<Module>
    <Type from="model" as="Registration" />

    <Args in={Registration.Input} out={Registration.Outcome} />

    <Call fn="endpoints" in={$in.endpoints} />

    <If on={$ctx.endpoints.left == $ctx.endpoints.right}>
        <Return
            value={{
                action: Registration.Action.Skip,
                capacity: $in.buckets.length,
                ...$ctx.endpoints,
                slot: 0
            }}
        />
    </If>

    <Call
        fn="admit"
        in={{
            keys: $in.keys,
            buckets: $in.buckets,
            pair: $ctx.endpoints,
            rows: $in.rows
        }}
    />

    <Return
        value={{
            ...$ctx.admit.pick([
                "action",
                "capacity"
            ]),
            ...$ctx.endpoints,
            slot: $ctx.admit.slot ?? 0
        }}
    />
</Module>
