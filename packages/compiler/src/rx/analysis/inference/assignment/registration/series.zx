import memory from "memory"

import knownNode from "../../known/find"
import admit from "./admit"
import endpoints from "./endpoints"
import { Action } from "./model"
import publish from "./publish"

import type { Progress as Output, Series as Input } from "./model"

export default function (in: Input): Output {
    const rows = in.rows
    const spans = in.spans

    return loop({
        next: in.next,
        position: rows.position,
        action: Action.Skip,
        capacity: in.buckets.length
    }, {
        while: state => state.action == Action.Skip && state.next < in.values.length,
        next: state => {
            const index = state.next
            const known = in.known
            const repeated = in.repeated
            const right: u32? = match {
                repeated != null => repeated,
                known != null => knownNode({
                    known,
                    type_id: in.targets[index]
                }),
                _ => in.targets[index]
            }

            if (right == null) {
                state.action = Action.Register
            } else {
                const pair = endpoints({
                    parents: in.parents,
                    left: in.values[index],
                    right
                })

                if (pair.left == pair.right) {
                    state.next += 1
                } else {
                    const destination = {
                        ...rows,
                        position: state.position
                    }
                    const result = admit({
                        keys: in.keys,
                        buckets: in.buckets,
                        pair,
                        rows: destination
                    })
                    const slot = result.slot

                    if (slot != null) {
                        publish({
                            pair,
                            rows: destination,
                            slot
                        })

                        const start = index * spans.width
                        const offset = state.position * spans.width
                        const copied = memory.copyBytes(
                            spans.target,
                            offset,
                            spans.source,
                            start,
                            start + spans.width
                        )

                        state.position += 1
                        state.next += 1
                    } else if (result.action == Action.Skip) {
                        state.next += 1
                    } else {
                        state.action = result.action
                        state.capacity = result.capacity
                    }
                }
            }
        },
        return: state => state
    })
}
