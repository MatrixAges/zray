import knownNode from "../../known/find"
import admit from "./admit"
import endpoints from "./endpoints"
import { Action } from "./model"

import type { Progress as Output, Series as Input } from "./model"

export default function (in: Input): Output {
    const zero: u32 = 0
    const zero_key: u64 = 0

    return loop({
        next: in.next,
        position: in.rows.position,
        action: Action.Skip,
        capacity: in.buckets.length,
        left: zero,
        right: zero,
        key: zero_key,
        slot: 0
    }, {
        while: state => state.action == Action.Skip && state.next < in.values.length,
        next: state => {
            const index = state.next
            const known = in.known
            const repeated = in.repeated
            const right: u32? = match {
                repeated != null => repeated,
                known != null => knownNode({
                    known,
                    type_id: in.targets[index]
                }),
                _ => in.targets[index]
            }

            if (right == null) {
                state.action = Action.Register
            } else {
                const pair = endpoints({
                    parents: in.parents,
                    left: in.values[index],
                    right
                })

                if (pair.left == pair.right) {
                    state.next += 1
                } else {
                    const result = admit({
                        keys: in.keys,
                        buckets: in.buckets,
                        pair,
                        rows: {
                            ...in.rows,
                            position: state.position
                        }
                    })

                    if (result.action == Action.Skip) {
                        state.next += 1
                    } else {
                        state.action = result.action
                        state.capacity = result.capacity
                        state.left = pair.left
                        state.right = pair.right
                        state.key = pair.key
                        state.slot = result.slot ?? 0
                    }
                }
            }
        },
        return: state => state
    })
}
