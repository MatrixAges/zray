<Module>
    <Type from="workflow" as="Registration" />

    <Args in={Registration.Reservation} out={void} />

    <If on={$in.position == $in.storage.rows.capacity}>
        <Call fn="host.growAssignmentRows" in={$in.frame} />
    </If>

    <Call fn="host.u32BufferLength" in={$in.storage.rows.buckets} />

    <If on={$in.capacity > $ctx.u32BufferLength}>
        <Call
            fn="rebuild"
            in={{
                target: $in.storage.replacement,
                allocator: $in.storage.allocator,
                keys: $in.storage.keys,
                count: $in.position,
                capacity: $in.capacity
            }}
        />

        <Call
            fn="host.swapU32Buffers"
            in={[
                $in.storage.rows.buckets,
                $in.storage.replacement
            ]}
        />

        <Call
            fn="host.releaseU32Buffer"
            in={[
                $in.storage.allocator,
                $in.storage.replacement
            ]}
        />
    </If>
</Module>
