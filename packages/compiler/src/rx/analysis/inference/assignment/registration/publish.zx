import integers from "std:integer"
import memory from "memory"

import type { Publication as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const pair = in.pair
    const rows = in.rows
    const row = integers.narrow(rows.position + 1) - 1

    memory.writeU64(rows.keys, rows.position, pair.key)
    memory.writeU32(rows.left, rows.position, pair.left)
    memory.writeU32(rows.right, rows.position, pair.right)
    memory.writeU32(rows.buckets, in.slot, row)

    const spans = in.spans
    const start = in.span_index * spans.width
    const offset = rows.position * spans.width

    const copied = memory.copyBytes(
        spans.target,
        offset,
        spans.source,
        start,
        start + spans.width
    )
}
