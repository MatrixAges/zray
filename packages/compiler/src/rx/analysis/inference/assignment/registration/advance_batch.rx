<Module>
    <Type from="workflow" as="Registration" />
    <Type from="model" as="Actions" />
    <Type from="effect" as="Effect" />

    <Args in={Registration.BatchCursor} out={Registration.BatchCursor} />

    <Store from="publication" as="publication" />

    <Call
        fn="series"
        in={{
            ...$in.request.omit([
                "storage",
                "position"
            ]),
            parents: $in.request.storage.parents,
            keys: $in.request.storage.keys,
            buckets: $in.request.storage.buckets,
            rows: {
                position: $in.position,
                capacity: $in.request.storage.capacity
            },
            next: $in.next
        }}
    />

    <Switch on={$ctx.series.action}>
        <Case value={Actions.Action.Commit}>
            <Call
                fn="stage"
                in={{
                    registration_step: Effect.Step.Append,
                    row: {
                        left: $ctx.series.left,
                        right: $ctx.series.right,
                        key: $ctx.series.key,
                        slot: $ctx.series.slot,
                        span_index: $ctx.series.next
                    }
                }}
                setter={[$store.publication.effect]}
            />

            <Return
                value={{
                    request: $in.request,
                    next: $ctx.series.next + 1,
                    position: $ctx.series.position + 1
                }}
            />
        </Case>

        <Case value={Actions.Action.Overflow}>
            <Call
                fn="stage"
                in={{
                    registration_step: Effect.Step.Overflow
                }}
                setter={[$store.publication.effect]}
            />
        </Case>

        <Case value={Actions.Action.Reserve}>
            <If on={$ctx.series.position == $in.request.storage.capacity}>
                <Call
                    fn="stage"
                    in={{
                        registration_step: Effect.Step.Grow
                    }}
                    setter={[$store.publication.effect]}
                />
            </If>

            <If on={$ctx.series.capacity > $in.request.storage.buckets.length}>
                <Call
                    fn="rebuild"
                    in={{
                        keys: $in.request.storage.keys,
                        count: $ctx.series.position,
                        capacity: $ctx.series.capacity
                    }}
                />

                <Call
                    fn="stage"
                    in={{
                        registration_step: Effect.Step.ReplaceIndex,
                        buckets: $ctx.rebuild
                    }}
                    setter={[$store.publication.effect]}
                />
            </If>
        </Case>

        <Case value={Actions.Action.Register}>
            <Call
                fn="stage"
                in={{
                    registration_step: Effect.Step.RegisterTarget,
                    type_id: $in.request.targets[$ctx.series.next],
                    span_index: $ctx.series.next
                }}
                setter={[$store.publication.effect]}
            />
        </Case>
    </Switch>

    <Return
        value={{
            request: $in.request,
            next: $ctx.series.next,
            position: $ctx.series.position
        }}
    />
</Module>
