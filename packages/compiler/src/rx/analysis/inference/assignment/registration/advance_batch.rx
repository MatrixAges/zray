<Module>
    <Type from="workflow" as="Registration" />
    <Type from="model" as="Actions" />

    <Args in={Registration.BatchCursor} out={Registration.BatchCursor} />

    <Call
        fn="series"
        in={{
            ...$in.request.omit([
                "frame",
                "storage",
                "position"
            ]),
            keys: $in.request.storage.keys,
            buckets: $in.request.storage.buckets,
            rows: {
                position: $in.position,
                capacity: $in.request.storage.capacity
            },
            next: $in.next
        }}
    />

    <Switch on={$ctx.series.action}>
        <Case value={Actions.Action.Commit}>
            <Call
                fn="host.commitAssignment"
                in={[
                    $in.request.frame,
                    $ctx.series.left,
                    $ctx.series.right,
                    $ctx.series.key,
                    $ctx.series.slot,
                    $ctx.series.next
                ]}
            />

            <Return
                value={{
                    request: $in.request,
                    next: $ctx.series.next + 1,
                    position: $ctx.series.position + 1
                }}
            />
        </Case>

        <Case value={Actions.Action.Overflow}>
            <Call fn="host.requireAllocation" in={false} />
        </Case>

        <Case value={Actions.Action.Reserve}>
            <If on={$ctx.series.position == $in.request.storage.capacity}>
                <Call fn="host.growAssignmentRows" in={$in.request.frame} />
            </If>

            <If on={$ctx.series.capacity > $in.request.storage.buckets.length}>
                <Call
                    fn="rebuild"
                    in={{
                        keys: $in.request.storage.keys,
                        count: $ctx.series.position,
                        capacity: $ctx.series.capacity
                    }}
                />

                <Call
                    fn="host.replaceAssignmentIndex"
                    in={[
                        $in.request.frame,
                        $ctx.rebuild
                    ]}
                />
            </If>
        </Case>

        <Case value={Actions.Action.Register}>
            <Call
                fn="host.registerAssignmentTarget"
                in={[
                    $in.request.frame,
                    $in.request.targets[$ctx.series.next],
                    $ctx.series.next
                ]}
            />
        </Case>
    </Switch>

    <Return
        value={{
            request: $in.request,
            next: $ctx.series.next,
            position: $ctx.series.position
        }}
    />
</Module>
