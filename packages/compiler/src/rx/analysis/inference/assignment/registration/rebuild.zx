import integers from "std:integer"
import { max_u32 } from "core/const"
import probe from "core/integer/wide_index/probe"

export type Input = {
    keys: u64[],
    count: u64,
    capacity: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    const initial = loop(empty, {
        while: buckets => buckets.length < in.capacity,
        next: buckets => {
            buckets = buckets.push(max_u32)[0]
        },
        return: buckets => buckets
    })

    return loop({
        buckets: initial,
        position: 0
    }, {
        while: state => state.position < in.count,
        next: state => {
            const slot = probe({
                keys: in.keys,
                buckets: state.buckets,
                key: in.keys[state.position]
            })

            state.buckets[slot] = integers.narrow(state.position)
            state.position += 1
        },
        return: state => state.buckets
    })
}
