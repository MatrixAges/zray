import integers from "std:integer"
import { max_u32 } from "core/const"
import probe from "core/integer/wide_index/probe"
import memory from "memory"

import type { Allocator, U32Buffer } from "memory"

export type Input = {
    keys: u64[],
    allocator: Allocator,
    target: U32Buffer,
    count: u64,
    capacity: u64
}

export type Output = void

export default function (in: Input): Output {
    memory.allocateFilledU32Buffer(in.allocator, in.target, in.capacity, max_u32)

    const buckets = memory.u32Views(in.target)

    const written = loop({
        position: 0
    }, {
        while: state => state.position < in.count,
        next: state => {
            const slot = probe({
                keys: in.keys,
                buckets,
                key: in.keys[state.position]
            })

            memory.writeU32(in.target, slot, integers.narrow(state.position))

            state.position += 1
        }
    })
}
