import memory from "memory"

import type { Visibility } from "./workflow"

export type Input = Visibility & {
    first: u64,
    end: u64
}

export type Output = void

export default function (in: Input): Output {
    memory.writeIndex(in.length, 0, in.end)

    const previous = memory.readU64(in.revision, 0)
    const added = in.end - in.first

    memory.writeU64(in.revision, 0, previous + added)
}
