<Module>
    <Type from="workflow" as="Registration" />
    <Type from="model" as="Actions" />
    <Type from="effect" as="Effect" />

    <Args in={Registration.SingleCursor} out={Registration.SingleCursor} />

    <Store from="publication" as="publication" />

    <Call
        module="register"
        in={{
            endpoints: $in.request.endpoints,
            keys: $in.request.storage.keys,
            buckets: $in.request.storage.buckets,
            rows: {
                position: $in.request.position,
                capacity: $in.request.storage.capacity
            }
        }}
    />

    <Switch on={$ctx.register.action}>
        <Case value={Actions.Action.Commit}>
            <Call
                fn="stage"
                in={{
                    registration_step: Effect.Step.Append,
                    row: {
                        left: $ctx.register.left,
                        right: $ctx.register.right,
                        key: $ctx.register.key,
                        slot: $ctx.register.slot,
                        span_index: 0
                    }
                }}
                setter={[$store.publication.effect]}
            />
        </Case>

        <Case value={Actions.Action.Overflow}>
            <Call
                fn="stage"
                in={{
                    registration_step: Effect.Step.Overflow
                }}
                setter={[$store.publication.effect]}
            />
        </Case>

        <Case value={Actions.Action.Reserve}>
            <If on={$in.request.position == $in.request.storage.capacity}>
                <Call
                    fn="stage"
                    in={{
                        registration_step: Effect.Step.Grow
                    }}
                    setter={[$store.publication.effect]}
                />
            </If>

            <If on={$ctx.register.capacity > $in.request.storage.buckets.length}>
                <Call
                    fn="rebuild"
                    in={{
                        keys: $in.request.storage.keys,
                        count: $in.request.position,
                        capacity: $ctx.register.capacity
                    }}
                />

                <Call
                    fn="stage"
                    in={{
                        registration_step: Effect.Step.ReplaceIndex,
                        buckets: $ctx.rebuild
                    }}
                    setter={[$store.publication.effect]}
                />
            </If>
        </Case>
    </Switch>

    <Return
        value={{
            ...$in,
            retry: $ctx.register.action == Actions.Action.Reserve
        }}
    />
</Module>
