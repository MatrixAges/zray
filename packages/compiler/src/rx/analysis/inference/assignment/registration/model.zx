import type { State as KnownTypes } from "core/integer/map/model"
import type { U8Buffer, U32Buffer, U64Buffer } from "memory"

export type Endpoints = {
    parents: U32Buffer,
    left: u32,
    right: u32
}

export type Pair = {
    left: u32,
    right: u32,
    key: u64
}

export enum Action {
    Skip,
    Reserve,
    Added,
    Register,
    Overflow
}

export type Rows = {
    left: U32Buffer,
    right: U32Buffer,
    keys: U64Buffer,
    buckets: U32Buffer,
    position: u64,
    capacity: u64
}

export type Input = {
    endpoints: Endpoints,
    keys: u64[],
    buckets: u32[],
    rows: Rows,
    spans: Spans
}

export type Admission = Input.Omit("endpoints", "spans") & {
    pair: Pair
}

export type Publication = {
    pair: Pair,
    rows: Rows,
    slot: u64,
    spans: Spans,
    span_index: u64
}

export type Output = {
    action: Action,
    capacity: u64
}

export type Decision = Output & {
    slot?: u64
}

export type Spans = {
    source: u8[],
    target: U8Buffer,
    width: u64
}

export type Series = Input.Omit("endpoints") & {
    parents: U32Buffer,
    values: u32[],
    targets: u32[],
    repeated?: u32,
    known?: KnownTypes,
    next: u64
}

export type Progress = Output & {
    next: u64,
    position: u64
}
