import type { State as KnownTypes } from "core/integer/map/model"

export type Endpoints = {
    parents: u32[],
    left: u32,
    right: u32
}

export type Pair = {
    left: u32,
    right: u32,
    key: u64
}

export enum Action {
    Skip,
    Reserve,
    Commit,
    Register,
    Overflow
}

export type Rows = {
    position: u64,
    capacity: u64
}

export type Input = {
    endpoints: Endpoints,
    keys: u64[],
    buckets: u32[],
    rows: Rows
}

export type Admission = {
    keys: u64[],
    rows: Rows,
    buckets: u32[],
    pair: Pair
}

export type Output = {
    action: Action,
    capacity: u64
}

export type Decision = Output & {
    slot?: u64
}

export type Outcome = Output & Pair & {
    slot: u64
}

export type Series = Input.Omit("endpoints") & {
    parents: u32[],
    values: u32[],
    targets: u32[],
    repeated?: u32,
    known?: KnownTypes,
    next: u64
}

export type Progress = Outcome & {
    next: u64,
    position: u64
}
