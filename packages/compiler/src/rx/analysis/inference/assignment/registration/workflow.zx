import type { Endpoints, Series } from "./model"

export type Storage = {
    keys: u64[],
    buckets: u32[],
    capacity: u64,
    parents: u32[]
}

export type Request = {
    storage: Storage,
    position: u64
}

export type Single = Request & {
    endpoints: Endpoints
}

export type SingleCursor = {
    request: Single,
    retry: bool
}

export type Batch =
    Request & Series.Pick("values", "targets", "repeated", "known")

export type BatchCursor = {
    request: Batch,
    next: u64,
    position: u64
}
