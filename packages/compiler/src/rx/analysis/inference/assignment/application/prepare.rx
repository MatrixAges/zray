<Module>
    <Type from="model" as="Materialization" />
    <Type from="../depth/model" as="OptionalDepth" />

    <Args in={Materialization.Preparation} out={Materialization.Prepared} />

    <Call module="../depth/solve" in={$in.depth} />

    <If on={$ctx.solve.issue != OptionalDepth.Issue.None}>
        <Return
            value={{
                depth: $ctx.solve,
                deferred: {
                    first: 0,
                    words: 0
                }
            }}
        />
    </If>

    <Call
        fn="deferred_plan"
        in={{
            resolved: $in.resolved_indexes,
            nodes: $in.depth.graph.nodes.kinds.length
        }}
    />

    <Return
        value={{
            depth: $ctx.solve,
            deferred: $ctx.deferred_plan
        }}
    />
</Module>
