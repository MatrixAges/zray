import type { ClassLookup, Nodes } from "../model"

export type Deferred = {
    first: u64,
    words: u64
}

export type Materialization = {
    nodes: Nodes,
    depths: u64[],
    deferred: u64[],
    classes: ClassLookup,
    parents: u32[],
    next: u64
}

export type Candidate = {
    next: u64,
    node: u32,
    payload?: u32,
    layers: u64
}
