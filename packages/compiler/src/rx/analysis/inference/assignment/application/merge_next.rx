<Module>
    <Type from="workflow" as="Assignment" />
    <Type from="merge" as="Merge" />
    <Type from="../../solve/replay_effect" as="Effect" />

    <Args in={Assignment.Iteration} out={Assignment.Iteration} />

    <Store from="../../solve/replay" as="replay" />

    <Call
        fn="merge"
        in={{
            view: $in.request.view,
            classes: $in.request.classes,
            next: $in.next,
            other: $in.other,
            value: $in.value,
            remaining: $in.remaining
        }}
    />

    <If on={$ctx.merge.action == Merge.Action.Depth}>
        <Call
            fn="../../solve/stage_replay"
            in={{
                step: Effect.Step.RejectAssignmentDepth,
                left: $ctx.merge.root
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <If on={$ctx.merge.action == Merge.Action.Register}>
        <Call
            fn="../../solve/stage_replay"
            in={{
                step: Effect.Step.RegisterAssignmentPayload,
                left: $ctx.merge.root,
                right: $ctx.merge.value,
                budget: $ctx.merge.remaining
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="../../solve/read_assignment_payload" in={$store.replay.effect} />

        <Return
            value={{
                request: $in.request,
                next: $ctx.merge.next,
                other: $ctx.merge.other,
                value: $ctx.read_assignment_payload.id,
                remaining: $ctx.read_assignment_payload.remaining
            }}
        />
    </If>

    <If on={$ctx.merge.action == Merge.Action.Merge}>
        <Call
            fn="../../solve/stage_replay"
            in={{
                step: Effect.Step.MergeAssignmentClass,
                row: $ctx.merge.next - 1,
                right: $ctx.merge.other ?? 0
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Return
        value={{
            request: $in.request,
            next: $ctx.merge.next,
            other: null,
            value: 0,
            remaining: 0
        }}
    />
</Module>
