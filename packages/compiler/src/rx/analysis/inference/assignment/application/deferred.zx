import integers from "std:integer"
import memory from "zig:compiler_memory"

import representative from "../../forest/borrowed_root"
import { unsigned_word_bits } from "./const"

import type { U32Buffer, U64Buffer } from "zig:compiler_memory"

export type Input = {
    parents: U32Buffer,
    values: u32[],
    resolved: bool[],
    words: U64Buffer,
    first: u64
}

export type Output = void

export default function (in: Input): Output {
    const scanned = loop({
        row: in.first
    }, {
        while: state => state.row < in.values.length,
        next: state => {
            const row = state.row

            if (!in.resolved[row]) {
                const root = representative({
                    parents: in.parents,
                    value: in.values[row]
                })
                const index = integers.widen(root)
                const word = index / unsigned_word_bits
                const position = index % unsigned_word_bits
                const mask = integers.bitMask(position)
                const marked = integers.orBits(memory.readU64(in.words, word), mask)

                memory.writeU64(in.words, word, marked)
            }

            state.row += 1
        }
    })
}
