import type { Diagnostic, SpanSource } from "../../projections/site"
import type { Sequences } from "../../sequences/defaults/model"
import type { ClassLookup, Edges, Nodes, Payloads } from "../model"
import type { View } from "./merge"

export type Rows = {
    edges: Edges,
    spans: SpanSource
}

export type SequencesView = {
    sequence: Sequences,
    members: u32[][],
    spans: SpanSource
}

export type Indexes = {
    values: u32[],
    resolved: bool[]
}

export type Request = {
    view: View,
    nodes: Nodes,
    rows: Rows,
    sequences: SequencesView,
    indexes: Indexes,
    node_spans: SpanSource
}

export type Execution = Request & {
    payloads: Payloads,
    classes: ClassLookup
}

export type Update = {
    changed: bool,
    diagnostic?: Diagnostic
}
