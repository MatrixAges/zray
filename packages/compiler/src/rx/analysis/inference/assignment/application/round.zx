import type {
    AssignmentApplication,
    ProjectionGraph,
    ProjectionSpans
} from "rx_project_host"
import type { Sequences } from "../../sequences/defaults/model"
import type { ClassLookup, Edges, Nodes, Payloads } from "../model"
import type { View } from "./merge"

export type Rows = {
    edges: Edges,
    spans: ProjectionSpans
}

export type SequencesView = {
    sequence: Sequences,
    members: u32[][],
    spans: ProjectionSpans
}

export type Indexes = {
    values: u32[],
    resolved: bool[]
}

export type Request = {
    frame: AssignmentApplication,
    owner: ProjectionGraph,
    view: View,
    nodes: Nodes,
    rows: Rows,
    sequences: SequencesView,
    indexes: Indexes,
    node_spans: ProjectionSpans
}

export type Execution = Request & {
    payloads: Payloads,
    classes: ClassLookup
}
