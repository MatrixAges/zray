import type { U64Buffer } from "memory"
import type { AssignmentMaterialization } from "rx_project_host"
import type { Materialization } from "../model"

export type Indexes = {
    values: u32[],
    resolved: bool[],
    words: U64Buffer,
    first: u64
}

export type Request = {
    frame: AssignmentMaterialization,
    views: Materialization.Omit("next"),
    indexes: Indexes
}

export type Iteration = {
    request: Request,
    next: u64
}
