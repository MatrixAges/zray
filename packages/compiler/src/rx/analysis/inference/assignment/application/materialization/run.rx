<Module>
    <Type from="model" as="Materialization" />

    <Args in={Materialization.Request} out={u64} />

    <Loop on={$in.next < $in.request.views.depths.length}>
        <Call
            module="advance"
            in={{
                request: $in,
                next: 0
            }}
        />
    </Loop>

    <Call fn="../host.assignmentRevision" in={$in.frame} />

    <Return value={$ctx.assignmentRevision} />
</Module>
