<Module>
    <Type from="model" as="Materialization" />

    <Args in={Materialization.Request} out={void} />

    <If on={$in.views.deferred.length != 0}>
        <Call
            fn="../deferred"
            in={{
                ...$in.indexes,
                parents: $in.views.parents
            }}
        />
    </If>

    <Loop on={$in.next < $in.request.views.depths.length}>
        <Call
            module="advance"
            in={{
                request: $in,
                next: 0
            }}
        />
    </Loop>
</Module>
