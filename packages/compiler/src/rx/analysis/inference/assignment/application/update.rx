<Module>
    <Type from="round" as="Assignments" />
    <Type from="../../solve/replay_effect" as="Effect" />

    <Args in={Assignments.Request} out={Assignments.Update} />

    <Store from="../../solve/replay" as="replay" />

    <Call
        fn="../../solve/stage_replay"
        in={{
            step: Effect.Step.ReadRevision
        }}
        setter={[$store.replay.effect]}
    />

    <Call fn="../../solve/read_revision" in={$store.replay.effect} />

    <Call
        module="../classes/create"
        in={$in.pick([
            "view",
            "nodes",
            "rows"
        ])}
    />

    <Call
        module="propagate"
        in={{
            view: $in.view,
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <If on={$ctx.propagate != $ctx.read_revision}>
        <Return
            value={{
                changed: true,
                diagnostic: null
            }}
        />
    </If>

    <Call
        module="../../sequences/defaults/run"
        in={{
            ...$in,
            payloads: $ctx.create.pick([
                "initial",
                "registered"
            ]),
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <If on={$ctx.run.changed || $ctx.run.diagnostic != null}>
        <Return value={$ctx.run} />
    </If>

    <Call
        module="materialization/materialize"
        in={{
            ...$in,
            payloads: $ctx.create.pick([
                "initial",
                "registered"
            ]),
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <Return value={$ctx.materialize} />
</Module>
