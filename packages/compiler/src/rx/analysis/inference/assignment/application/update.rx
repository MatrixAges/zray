<Module>
    <Type from="round" as="Assignments" />

    <Args in={Assignments.Request} out={bool} />

    <Call fn="host.assignmentRevision" in={$in.frame} />

    <Call
        module="../classes/create"
        in={$in.pick([
            "frame",
            "view",
            "nodes",
            "rows"
        ])}
    />

    <Call
        module="propagate"
        in={{
            frame: $in.frame,
            view: $in.view,
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <If on={$ctx.propagate != $ctx.assignmentRevision}>
        <Return value={true} />
    </If>

    <Call
        module="../../sequences/defaults/run"
        in={{
            ...$in,
            payloads: $ctx.create.pick([
                "initial",
                "registered"
            ]),
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <If on={$ctx.run}>
        <Return value={true} />
    </If>

    <Call
        module="materialization/materialize"
        in={{
            ...$in,
            payloads: $ctx.create.pick([
                "initial",
                "registered"
            ]),
            classes: $ctx.create.pick([
                "groups",
                "representatives"
            ])
        }}
    />

    <Return value={$ctx.materialize} />
</Module>
