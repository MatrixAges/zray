<Module>
    <Type from="workflow" as="Assignment" />
    <Type from="../../solve/replay_effect" as="Effect" />

    <Args in={Assignment.Request} out={u64} />

    <Store from="../../solve/replay" as="replay" />

    <Loop on={$in.next < $in.request.classes.groups.length}>
        <Call
            module="merge_next"
            in={{
                request: $in,
                next: 0,
                other: null,
                value: 0,
                remaining: 0
            }}
        />
    </Loop>

    <Call
        fn="../../solve/stage_replay"
        in={{
            step: Effect.Step.ReadRevision
        }}
        setter={[$store.replay.effect]}
    />

    <Call fn="../../solve/read_revision" in={$store.replay.effect} />

    <Return value={$ctx.read_revision} />
</Module>
