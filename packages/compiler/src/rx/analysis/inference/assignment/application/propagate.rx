<Module>
    <Type from="workflow" as="Assignment" />

    <Args in={Assignment.Request} out={u64} />

    <Loop on={$in.next < $in.request.classes.groups.length}>
        <Call
            module="merge_next"
            in={{
                request: $in,
                next: 0,
                other: null,
                value: 0,
                remaining: 0
            }}
        />
    </Loop>

    <Call fn="host.assignmentRevision" in={$in.frame} />

    <Return value={$ctx.assignmentRevision} />
</Module>
