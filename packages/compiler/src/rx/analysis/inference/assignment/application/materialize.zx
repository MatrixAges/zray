import integers from "std:integer"
import memory from "memory"

import representative from "../../forest/borrowed_root"
import { Kind } from "../../unification/model"
import { unsigned_word_bits } from "./const"

import type { Candidate, Materialization } from "./model"

export type Input = Materialization

export type Output = Candidate

export default function (in: Input): Output {
    const { nodes, parents, classes, deferred, depths } = in

    const pending: u32? = null

    return loop({
        next: in.next,
        payload: pending
    }, {
        while: state => state.payload == null && state.next < depths.length,
        next: state => {
            const index = state.next
            const node = integers.narrow(index)
            if (memory.readU32(parents, index) != node) {
                const root = representative({
                    parents,
                    value: node
                })
            } else {
                const kind = nodes.kinds[index]

                if (kind == Kind.Unknown && nodes.allowed[index] == null) {
                    const group = integers.widen(classes.groups[index])
                    const other = classes.representatives[group]

                    if (other != null) {
                        if (deferred.length == 0) {
                            state.payload = other
                        } else {
                            const word = deferred[index / unsigned_word_bits]
                            const mask = integers.bitMask(index % unsigned_word_bits)

                            if (integers.andBits(word, mask) == 0) {
                                state.payload = other
                            }
                        }
                    }
                }
            }

            state.next += 1
        },
        return: state => {
            const next = state.next
            const payload = state.payload
            const index = payload == null ? 0 : next - 1

            return {
                next,
                payload,
                node: integers.narrow(index),
                layers: payload == null ? 0 : depths[index]
            }
        }
    })
}
