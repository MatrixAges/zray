import integers from "std:integer"
import memory from "std:memory"

import representative from "../../forest/borrowed_root"
import { Kind } from "../../unification/model"
import { unsigned_word_bits } from "./const"

import type { U32Buffer } from "std:memory"
import type { ClassLookup, Nodes } from "../model"

export type Input = {
    nodes: Nodes,
    deferred: u64[],
    classes: ClassLookup,
    parents: U32Buffer,
    next: u64,
    limit: u64,
    other?: u32
}

export type Output = Input.Pick("next", "other")

export default function (in: Input): Output {
    return loop(in, {
        while: state => state.other == null && state.next < state.limit,
        next: state => {
            const index = state.next
            const node = integers.narrow(index)
            if (memory.readU32(state.parents, index) != node) {
                const root = representative({
                    parents: state.parents,
                    value: node
                })

            } else {
                const kind = state.nodes.kinds[index]

                if (kind == Kind.Unknown && state.nodes.allowed[index] == null) {
                    const group = integers.widen(state.classes.groups[index])
                    const other = state.classes.representatives[group]

                    if (other != null) {
                        if (state.deferred.length == 0) {
                            state.other = other
                        } else {
                            const word = state.deferred[index / unsigned_word_bits]
                            const mask = integers.bitMask(index % unsigned_word_bits)

                            if (integers.andBits(word, mask) == 0) {
                                state.other = other
                            }
                        }
                    }
                }
            }

            state.next += 1
        },
        return: state => ({
            next: state.next,
            other: state.other
        })
    })
}
