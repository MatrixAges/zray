import { unsigned_word_bits } from "./const"

import type { Deferred } from "./model"

export type Input = {
    resolved: bool[],
    nodes: u64
}

export type Output = Deferred

export default function (in: Input): Output {
    const resolved = in.resolved

    const first = loop(0, {
        while: row => row < resolved.length && resolved[row],
        next: row => {
            row += 1
        },
        return: row => row
    })

    if (first == resolved.length) {
        return {
            first,
            words: 0
        }
    }

    const whole_words = in.nodes / unsigned_word_bits
    const partial_word = in.nodes % unsigned_word_bits != 0

    return {
        first,
        words: partial_word ? whole_words + 1 : whole_words
    }
}
