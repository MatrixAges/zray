<Module>
    <Type from="../round" as="Assignments" />
    <Type from="../../depth/model" as="Depth" />

    <Args in={Assignments.Execution} out={Assignments.Update} />

    <Call fn="../host.assignmentRevision" in={$in.frame} />

    <Call
        module="../../depth/solve"
        in={{
            graph: {
                nodes: $in.nodes,
                arguments: $in.view.graph.arguments,
                types: $in.view.graph.types
            },
            assignments: $in.rows.edges,
            parents: $in.view.parents
        }}
    />

    <If on={$ctx.solve.issue != Depth.Issue.None}>
        <Call
            fn="reject"
            in={{
                node_spans: $in.node_spans,
                spans: $in.rows.spans,
                edges: $in.rows.edges.left.length,
                issue: $ctx.solve
            }}
        />

        <Return
            value={{
                changed: false,
                diagnostic: $ctx.reject
            }}
        />
    </If>

    <Call
        fn="../deferred"
        in={{
            parents: $in.view.parents,
            values: $in.indexes.values,
            resolved: $in.indexes.resolved,
            nodes: $in.nodes.kinds.length
        }}
    />

    <Call
        module="run"
        in={{
            frame: $in.frame,
            views: {
                nodes: $in.nodes,
                depths: $ctx.solve.depths,
                deferred: $ctx.deferred,
                classes: $in.classes,
                parents: $in.view.parents
            }
        }}
    />

    <Return
        value={{
            changed: $ctx.run != $ctx.assignmentRevision,
            diagnostic: null
        }}
    />
</Module>
