import integers from "std:integer"

import { Issue } from "../../depth/model"
import {
    incompatible_optional,
    optional_to_required,
    recursive_optional
} from "../const"

import type { ProjectionSpans } from "rx_project_host"
import type { Diagnostic } from "../../../projections/site"
import type { Output as IssueSite } from "../../depth/model"

export type Input = {
    node_spans: ProjectionSpans,
    spans: ProjectionSpans,
    edges: u64,
    issue: IssueSite
}

export type Output = Diagnostic

export default function (in: Input): Output {
    const { node_spans, spans, edges, issue } = in

    const message = match issue.issue {
        Issue.Bounds => incompatible_optional,
        Issue.OptionalToRequired => optional_to_required,
        _ => recursive_optional
    }

    const node = issue.node
    const node_location = node != null || edges == 0

    const row = match {
        node != null => integers.widen(node),
        node_location => 0,
        _ => issue.position
    }

    return {
        spans: node_location ? node_spans : spans,
        row,
        message,
        unsupported: false
    }
}
