import { max_nesting_depth } from "core/const"

import representative from "../../forest/borrowed_root"
import payload from "../../optional/payload"
import { Action as PayloadAction } from "../../optional/payload"
import candidate from "./merge_candidate"

import type { U32Buffer } from "zig:compiler_memory"
import type { State as Known } from "core/integer/map/model"
import type { Graph } from "../../optional/model"
import type { ClassLookup } from "../model"

export enum Action {
    Scan,
    Merge,
    Register,
    Depth
}

export type Input = {
    graph: Graph,
    allowed: u16?[],
    classes: ClassLookup,
    parents: U32Buffer,
    known: Known,
    next: u64,
    other?: u32,
    value: u32,
    root: u32,
    remaining: u64,
    action: Action
}

export type Output = Input.Pick(
    "action",
    "next",
    "other",
    "value",
    "root",
    "remaining"
)

export default function (in: Input): Output {
    const { graph, allowed, classes, parents, known } = in

    return loop({
        action: Action.Scan,
        next: in.next,
        other: in.other,
        value: in.value,
        root: in.root,
        remaining: in.remaining
    }, {
        while: state => state.action == Action.Scan && state.next < classes.groups.length,
        next: state => {
            const continuing = state.other != null
            const other: u32? = match {
                continuing => state.other,
                _ => candidate({
                    graph,
                    allowed,
                    classes,
                    parents,
                    index: state.next
                })
            }

            if (other == null) {
                state.next += 1
            } else {
                const result = payload({
                    graph,
                    parents,
                    known,
                    value: continuing ? state.value : other,
                    remaining: continuing ? state.remaining : max_nesting_depth
                })

                if (result.action == PayloadAction.Ready) {
                    const root = representative({
                        parents,
                        value: other
                    })

                    if (result.root == root) {
                        state.other = other
                        state.action = Action.Merge
                    } else {
                        state.other = null
                    }

                    state.next += 1
                } else {
                    state.other = other
                    state.value = result.value
                    state.root = result.root
                    state.remaining = result.remaining
                    state.action = match result.action {
                        PayloadAction.Depth => Action.Depth,
                        _ => Action.Register
                    }
                }
            }
        },
        return: state => state
    })
}
