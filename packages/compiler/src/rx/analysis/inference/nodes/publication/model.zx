import type {
    IndexBuffer,
    OptionalU8Buffer,
    OptionalU16Buffer,
    SourceSpanBuffer
} from "memory"
import type { Span } from "../../../../syntax/model"

export type Range = {
    first: u64,
    end: u64
}

export type Storage = {
    length: IndexBuffer,
    allowed: OptionalU16Buffer,
    fallback: OptionalU8Buffer
}

export type UniformSpan = Span & {
    rows: SourceSpanBuffer
}

export type Finish = Range & {
    storage: Storage
}

export type Uniform = Finish & {
    span: UniformSpan
}
