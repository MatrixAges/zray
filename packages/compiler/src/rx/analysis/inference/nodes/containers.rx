<Module>
    <Type from="containers" as="Append" />

    <Args in={Append.Input} out={void} />

    <Call
        fn="write_containers"
        in={$in.omit([
            "storage",
            "span"
        ])}
    />

    <Call
        module="publication/uniform"
        in={$in.pick([
            "first",
            "end",
            "storage",
            "span"
        ])}
    />
</Module>
