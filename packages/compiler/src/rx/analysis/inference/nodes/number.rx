<Module>
    <Type from="number" as="Number" />

    <Args in={Number.Input} out={void} />

    <Call fn="../scalar/literal" in={$in.token} />
    <Call fn="initialize" in={$in.rows} />

    <Call
        fn="../scalar/publication/number"
        in={{
            ...$ctx.literal,
            storage: $in.storage,
            row: $in.rows.first
        }}
    />

    <Call
        fn="publication/spans"
        in={{
            first: $in.rows.first,
            end: $in.rows.end,
            span: $in.span
        }}
    />

    <Call
        fn="publication/length"
        in={{
            length: $in.length,
            end: $in.rows.end
        }}
    />
</Module>
