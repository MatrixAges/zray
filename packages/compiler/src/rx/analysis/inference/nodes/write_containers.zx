import integers from "std:integer"

export type Input = {
    first: u64,
    end: u64,
    payload?: u32,
    container: u8,
    unknown: u8
}

export type Row = {
    parent: u32,
    kind: u8,
    argument: u32
}

export type Output = Row[]

export default function (in: Input): Output {
    const start = in.first
    const seed = in.payload ?? integers.narrow(start)
    const empty: Row[] = []

    const seed_rows: Row[] = [{
        parent: seed,
        kind: in.unknown,
        argument: 0
    }]

    const initial = in.payload == null ? seed_rows : empty

    const row = in.payload == null ? start + 1 : start

    return loop({
        row,
        payload: seed,
        rows: initial
    }, {
        while: state => state.row < in.end,
        next: state => {
            const id = integers.narrow(state.row)

            state.rows = state.rows.push({
                parent: id,
                kind: in.container,
                argument: state.payload
            })[0]

            state.payload = id
            state.row += 1
        },
        return: state => state.rows
    })
}
