import type { State as Table } from "core/integer/map/model"
import type { Types } from "../optional/model"

export type Registry = {
    table: Table
}

export type Input = Registry & {
    members: u32[],
    types: Types,
    type_id: u32,
    remaining?: u64,
    next: u64,
    end: u64
}

export enum Action {
    Scan,
    Commit,
    Reserve,
    Invalid,
    Overflow
}

export type Output = {
    next: u64,
    end: u64,
    capacity: u64,
    value: u32,
    slot: u64,
    tag: u8,
    type_id: u32,
    remaining?: u64,
    action: Action
}
