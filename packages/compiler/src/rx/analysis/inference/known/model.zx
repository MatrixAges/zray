import type { State as Table } from "core/integer/map/model"
import type { U8Buffer, U32Buffer } from "memory"
import type { Types } from "../optional/model"
import type { Columns } from "../unification/commit/model"

export type Storage = {
    metadata: U8Buffer,
    keys: U32Buffer,
    values: U32Buffer
}

export type Nodes = {
    parents: U32Buffer,
    columns: Columns,
    capacity: u64,
    known_kind: u8
}

export type Registry = {
    table: Table,
    storage: Storage,
    nodes: Nodes
}

export type Input = Registry & {
    members: u32[],
    types: Types,
    type_id: u32,
    remaining?: u64,
    next: u64,
    end: u64
}

export enum Action {
    Scan,
    Reserve,
    Invalid,
    Overflow
}

export type Output = {
    next: u64,
    end: u64,
    capacity: u64,
    value: u32,
    type_id: u32,
    remaining?: u64,
    action: Action
}
