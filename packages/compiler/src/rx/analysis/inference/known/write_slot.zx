import memory from "memory"

import type { Search } from "core/integer/map/model"
import type { Storage } from "./model"

export type Input = {
    storage: Storage,
    position: Search,
    node: u32,
    type_id: u32
}

export type Output = void

export default function (in: Input): Output {
    const { position, storage } = in

    memory.writeU32(storage.values, position.slot, in.node)
    memory.writeU32(storage.keys, position.slot, in.type_id)
    memory.writeU8(storage.metadata, position.slot, position.tag)
}
