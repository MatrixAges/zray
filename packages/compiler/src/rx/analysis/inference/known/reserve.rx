<Module>
    <Type from="workflow" as="Registration" />

    <Args in={Registration.Reservation} out={void} />

    <If on={$in.end == $in.view.nodes.capacity}>
        <Call fn="host.reserveKnownNodes" in={$in.frame} />
    </If>

    <If on={$in.capacity != $in.view.table.metadata.length}>
        <Call
            fn="host.reserveKnownIndex"
            in={[
                $in.frame,
                $in.capacity
            ]}
        />
    </If>

    <Call fn="host.refreshKnownRegistry" in={$in.frame} />
</Module>
