import integers from "std:integer"
import { max_u32 } from "core/const"
import { capacity_growth, initial_capacity } from "core/integer/map/const"
import probe from "core/integer/map/find"

import { Action } from "./model"

import type { Output as Progress, Registry } from "./model"

export type Input = Registry & {
    type_id: u32,
    end: u64,
    grow_index: bool
}

export type Output = Progress.Pick(
    "action",
    "capacity",
    "value",
    "slot",
    "tag"
)

export default function (in: Input): Output {
    const capacity = in.table.metadata.length

    const empty: Output = {
        action: Action.Reserve,
        capacity,
        value: 0,
        slot: 0,
        tag: 0
    }

    if (capacity == 0) {
        return {
            ...empty,
            capacity: initial_capacity
        }
    }

    const position = probe({
        metadata: in.table.metadata,
        keys: in.table.keys,
        key: in.type_id
    })

    if (position.found) {
        return {
            ...empty,
            action: Action.Scan,
            value: in.table.values[position.slot]
        }
    }

    if (in.end > integers.widen(max_u32)) {
        return {
            ...empty,
            action: Action.Overflow
        }
    }

    if (in.grow_index) {
        return {
            ...empty,
            capacity: capacity * capacity_growth
        }
    }

    return {
        action: Action.Commit,
        capacity,
        value: integers.narrow(in.end),
        slot: position.slot,
        tag: position.tag
    }
}
