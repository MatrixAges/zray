<Module>
    <Type from="workflow" as="Registration" />
    <Type from="model" as="Registry" />

    <Args in={Registration.Cursor} out={Registration.Cursor} />

    <Call
        fn="register"
        in={{
            table: $in.request.view.table,
            members: $in.request.members,
            types: $in.request.types,
            next: $in.next,
            end: $in.end,
            type_id: $in.type_id,
            remaining: $in.remaining
        }}
    />

    <Switch on={$ctx.register.action}>
        <Case value={Registry.Action.Commit}>
            <Call
                fn="host.commitKnownNode"
                in={[
                    $in.request.frame,
                    $ctx.register.slot,
                    $ctx.register.tag,
                    $ctx.register.type_id
                ]}
            />

            <Call
                fn="step"
                in={{
                    members: $in.request.members,
                    types: $in.request.types,
                    next: $ctx.register.next,
                    type_id: $ctx.register.type_id,
                    remaining: $ctx.register.remaining
                }}
            />

            <Return
                value={{
                    request: $in.request,
                    next: $ctx.step.next,
                    end: $ctx.register.end + 1,
                    type_id: $ctx.step.type_id,
                    remaining: $ctx.step.remaining,
                    value: $ctx.commitKnownNode,
                    running: $ctx.step.running
                }}
            />
        </Case>

        <Case value={Registry.Action.Invalid}>
            <Call fn="host.rejectKnownType" in={$in.request.frame} />
        </Case>

        <Case value={Registry.Action.Overflow}>
            <Call fn="host.requireAllocation" in={false} />
        </Case>

        <Case value={Registry.Action.Reserve}>
            <Call
                fn="host.reserveKnownIndex"
                in={[
                    $in.request.frame,
                    $ctx.register.capacity
                ]}
            />
        </Case>
    </Switch>

    <Return
        value={{
            request: $in.request,
            next: $ctx.register.next,
            end: $ctx.register.end,
            type_id: $ctx.register.type_id,
            remaining: $ctx.register.remaining,
            value: $ctx.register.value,
            running: $ctx.register.action == Registry.Action.Reserve
        }}
    />
</Module>
