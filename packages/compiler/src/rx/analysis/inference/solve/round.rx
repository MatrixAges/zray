<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Round} out={Solve.Round} />

    <Call module="propagate" in={$in.request} />

    <If on={$ctx.propagate}>
        <Return value={$in} />
    </If>

    <Call module="infer_defaults" in={$in.request} />

    <If on={$ctx.infer_defaults}>
        <Return value={$in} />
    </If>

    <Call module="finalize" in={$in.request} />

    <Return
        value={{
            request: $in.request,
            restart: $ctx.finalize
        }}
    />
</Module>
