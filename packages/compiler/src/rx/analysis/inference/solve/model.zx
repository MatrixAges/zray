import type { ConstraintRound } from "rx_project_host"
import type { Request as Assignments } from "../assignment/application/round"
import type { View } from "../bindings/workflow"
import type { Replay as Indexes } from "../index/workflow"
import type { View as NonNull } from "../non_null/model"
import type { Replay as Lengths } from "../projections/model"

export type Frame = ConstraintRound

export type Request = {
    frame: Frame,
    bindings: View,
    non_null: NonNull,
    lengths: Lengths,
    indexes: Indexes,
    assignments: Assignments
}

export type Round = {
    request: Request,
    restart: bool
}
