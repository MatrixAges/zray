import type { Request as Assignments } from "../assignment/application/round"
import type { Request as Validation } from "../assignment/validation/model"
import type { View } from "../bindings/workflow"
import type { Replay as Indexes } from "../index/workflow"
import type { View as NonNull } from "../non_null/model"
import type { View as Objects } from "../object_closure/replay"
import type { Replay as Lengths } from "../projections/model"
import type { Replay as Sequences } from "../sequences/workflow"

export type Request = {
    bindings: View,
    non_null: NonNull,
    lengths: Lengths,
    indexes: Indexes,
    assignments: Assignments,
    objects: Objects,
    sequences: Sequences,
    validation: Validation
}

export type Round = {
    request: Request,
    restart: bool
}
