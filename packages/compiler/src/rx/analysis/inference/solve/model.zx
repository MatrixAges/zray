import type { ConstraintRound } from "rx_project_host"
import type { View } from "../bindings/workflow"
import type { View as NonNull } from "../non_null/model"

export type Frame = ConstraintRound

export type Request = {
    frame: Frame,
    bindings: View,
    non_null: NonNull
}

export type Round = {
    request: Request,
    restart: bool
}
