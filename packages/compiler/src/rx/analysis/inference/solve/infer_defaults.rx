<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Call fn="host.refreshSolverAssignments" in={$in.frame} />

    <Call module="../assignment/application/update" in={$in.assignments} />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.assignments.owner,
            diagnostic: $ctx.update.diagnostic
        }}
    />

    <If on={$ctx.update.changed}>
        <Return value={true} />
    </If>

    <Call module="../index/defaults" in={$in.indexes} />

    <Return value={$ctx.defaults} />
</Module>
