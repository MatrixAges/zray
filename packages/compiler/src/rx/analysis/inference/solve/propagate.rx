<Module>
    <Type from="model" as="Solve" />
    <Type from="replay_effect" as="Effect" />

    <Args in={Solve.Request} out={bool} />

    <Store from="replay" as="replay" />

    <Task name="initial" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshBindings
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../bindings/validate" in={$in.bindings} />

    <If on={$ctx.validate != null}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.RejectBinding,
                diagnostic: $ctx.validate
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Call
        module="../bindings/run"
        in={{
            view: $in.bindings,
            final: false
        }}
    />

    <If on={$ctx.run != null}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.RejectBinding,
                diagnostic: $ctx.run
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshNonNull
        }}
        setter={[$store.replay.effect]}
    />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: false
        }}
    />

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshSequences
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../sequences/replay_sequences" in={$in.sequences} />

    <Call
        module="../projections/apply_diagnostic"
    />

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshObjects
        }}
        setter={[$store.replay.effect]}
    />

    <Call
        module="../construction/construct"
        in={{
            view: $in.objects,
            final: false
        }}
    />

    <Call
        module="../selection/select"
        in={{
            view: $in.objects,
            final: false
        }}
    />

    <Call
        module="../projections/apply_diagnostic"
    />

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshLengths
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../projections/run" in={$in.lengths} />

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshIndexes
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../index/run" in={$in.indexes} />

    <Task name="current" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <Return value={$ctx.task.current != $ctx.task.initial} />
</Module>
