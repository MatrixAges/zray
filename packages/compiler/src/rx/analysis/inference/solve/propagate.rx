<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Call fn="host.solveRevision" in={$in.frame} />
    <Call fn="host.refreshSolverBindings" in={$in.frame} />

    <Call module="../bindings/validate" in={$in.bindings} />

    <Call
        module="../bindings/run"
        in={{
            view: $in.bindings,
            final: false
        }}
    />

    <Call fn="host.refreshSolverNonNull" in={$in.frame} />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: false
        }}
    />

    <Call fn="host.solveSequences" in={$in.frame} />

    <Call
        fn="host.solveConstructions"
        in={[
            $in.frame,
            false
        ]}
    />

    <Call
        fn="host.solveSelections"
        in={[
            $in.frame,
            false
        ]}
    />

    <Call fn="host.solveLengths" in={$in.frame} />

    <Call
        fn="host.solveIndexes"
        in={[
            $in.frame,
            $ctx.solveRevision
        ]}
    />

    <Return value={$ctx.solveIndexes} />
</Module>
