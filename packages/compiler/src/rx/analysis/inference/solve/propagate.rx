<Module>
    <Type from="model" as="Solve" />
    <Type from="replay_effect" as="Effect" />

    <Args in={Solve.Request} out={bool} />

    <Store from="replay" as="replay" />

    <Task name="initial" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <Call fn="host.refreshSolverBindings" in={$in.frame} />

    <Call module="../bindings/validate" in={$in.bindings} />

    <If on={$ctx.validate != null}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.RejectBinding,
                diagnostic: $ctx.validate
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Call
        module="../bindings/run"
        in={{
            view: $in.bindings,
            final: false
        }}
    />

    <If on={$ctx.run != null}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.RejectBinding,
                diagnostic: $ctx.run
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Call fn="host.refreshSolverNonNull" in={$in.frame} />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: false
        }}
    />

    <Call fn="host.refreshSolverSequences" in={$in.frame} />

    <Call module="../sequences/replay_sequences" in={$in.sequences} />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.sequences.owner,
            diagnostic: $ctx.replay_sequences
        }}
    />

    <Call fn="host.refreshSolverObjects" in={$in.frame} />

    <Call
        module="../construction/construct"
        in={{
            view: $in.objects,
            final: false
        }}
    />

    <Call
        module="../selection/select"
        in={{
            view: $in.objects,
            final: false
        }}
    />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.objects.selections.owner,
            diagnostic: $ctx.select
        }}
    />

    <Call fn="host.refreshSolverLengths" in={$in.frame} />

    <Call module="../projections/run" in={$in.lengths} />

    <Call fn="host.refreshSolverIndexes" in={$in.frame} />

    <Call module="../index/run" in={$in.indexes} />

    <Task name="current" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <Return value={$ctx.task.current != $ctx.task.initial} />
</Module>
