<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Call fn="host.solveAssignmentClasses" in={$in.frame} />

    <If on={$ctx.solveAssignmentClasses}>
        <Return value={true} />
    </If>

    <Call fn="host.solveSequenceDefaults" in={$in.frame} />

    <If on={$ctx.solveSequenceDefaults}>
        <Return value={true} />
    </If>

    <Call fn="host.solveMaterializeAssignments" in={$in.frame} />

    <If on={$ctx.solveMaterializeAssignments}>
        <Return value={true} />
    </If>

    <Call module="../index/defaults" in={$in.indexes} />

    <Return value={$ctx.defaults} />
</Module>
