export enum Step {
    UnifyBinding,
    RefreshBindings,
    RejectBinding,
    MergeNonNull,
    RefreshNonNull,
    ReserveNonNull,
    RegisterNonNull,
    ReadRevision,
    RefreshLengths,
    RefreshIndexes,
    MarkIndexResolved,
    RefreshSequences,
    RefreshValidation,
    RefreshObjects,
    RefreshAssignments,
    RefreshAssignmentTypes,
    ReserveAssignmentOptional,
    RegisterAssignmentPayload,
    RejectAssignmentDepth,
    MergeAssignmentClass
}

export enum DiagnosticSource {
    Collision,
    Lookup,
    Use
}

export type Diagnostic = {
    source: DiagnosticSource,
    row: u64,
    message: string
}

export type Command = {
    step: Step,
    row?: u64,
    left?: u32,
    right?: u32,
    diagnostic?: Diagnostic,
    budget?: u64
}

export type Effect = Command & {
    id: u32,
    revision: u64,
    remaining: u64
}
