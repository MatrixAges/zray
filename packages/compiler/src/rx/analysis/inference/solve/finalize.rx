<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Task name="initial" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <Call fn="host.refreshSolverNonNull" in={$in.frame} />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: true
        }}
    />

    <Task name="after_non_null" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <If on={$ctx.task.after_non_null != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call fn="host.refreshSolverObjects" in={$in.frame} />

    <Call
        module="../selection/select"
        in={{
            view: $in.objects,
            final: true
        }}
    />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.objects.selections.owner,
            diagnostic: $ctx.select
        }}
    />

    <Task name="after_select" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <If on={$ctx.task.after_select != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call
        module="../construction/construct"
        in={{
            view: $in.objects,
            final: true
        }}
    />

    <Task name="after_construct" out={$ctx.solveRevision}>
        <Call fn="host.solveRevision" in={$in.frame} />
    </Task>

    <If on={$ctx.task.after_construct != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call fn="host.refreshSolverLengths" in={$in.frame} />

    <Call module="../projections/validate" in={$in.lengths} />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.lengths.owner,
            diagnostic: $ctx.validate
        }}
    />

    <Call fn="host.refreshSolverBindings" in={$in.frame} />

    <Task name="bindings" out={$ctx.run}>
        <Call
            module="../bindings/run"
            in={{
                view: $in.bindings,
                final: true
            }}
        />
    </Task>

    <If on={$ctx.task.bindings != null}>
        <Call
            fn="../bindings/host.applyBindingDiagnostic"
            in={[
                $in.bindings.frame,
                $ctx.task.bindings.source,
                $ctx.task.bindings.row,
                $ctx.task.bindings.message
            ]}
        />
    </If>

    <Call fn="host.refreshSolverValidation" in={$in.frame} />

    <Call module="../assignment/validation/run" in={$in.validation} />

    <Call
        module="../projections/apply_diagnostic"
        in={{
            graph: $in.validation.owner,
            diagnostic: $ctx.run
        }}
    />

    <Return value={false} />
</Module>
