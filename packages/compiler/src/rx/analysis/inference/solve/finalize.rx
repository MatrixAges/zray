<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Call fn="host.solveRevision" in={$in.frame} />
    <Call fn="host.refreshSolverNonNull" in={$in.frame} />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: true
        }}
    />

    <If on={$ctx.replay != $ctx.solveRevision}>
        <Return value={true} />
    </If>

    <Call
        fn="host.solveSelections"
        in={[
            $in.frame,
            true
        ]}
    />

    <If on={$ctx.solveSelections}>
        <Return value={true} />
    </If>

    <Call
        fn="host.solveConstructions"
        in={[
            $in.frame,
            true
        ]}
    />

    <If on={$ctx.solveConstructions}>
        <Return value={true} />
    </If>

    <Call fn="host.refreshSolverLengths" in={$in.frame} />

    <Call module="../projections/validate" in={$in.lengths} />

    <Call fn="host.refreshSolverBindings" in={$in.frame} />

    <Call
        module="../bindings/run"
        in={{
            view: $in.bindings,
            final: true
        }}
    />

    <Call fn="host.solveValidateAssignments" in={$in.frame} />

    <Return value={false} />
</Module>
