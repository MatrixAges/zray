<Module>
    <Type from="model" as="Solve" />

    <Args in={Solve.Request} out={bool} />

    <Call
        fn="host.solveNonNull"
        in={[
            $in.frame,
            true
        ]}
    />

    <If on={$ctx.solveNonNull}>
        <Return value={true} />
    </If>

    <Call
        fn="host.solveSelections"
        in={[
            $in.frame,
            true
        ]}
    />

    <If on={$ctx.solveSelections}>
        <Return value={true} />
    </If>

    <Call
        fn="host.solveConstructions"
        in={[
            $in.frame,
            true
        ]}
    />

    <If on={$ctx.solveConstructions}>
        <Return value={true} />
    </If>

    <Call fn="host.solveValidateLengths" in={$in.frame} />
    <Call fn="host.refreshSolverBindings" in={$in.frame} />

    <Call
        module="../bindings/run"
        in={{
            view: $in.bindings,
            final: true
        }}
    />

    <Call fn="host.solveValidateAssignments" in={$in.frame} />

    <Return value={false} />
</Module>
