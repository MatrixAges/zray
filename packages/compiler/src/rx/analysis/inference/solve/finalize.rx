<Module>
    <Type from="model" as="Solve" />
    <Type from="replay_effect" as="Effect" />

    <Args in={Solve.Request} out={bool} />

    <Store from="replay" as="replay" />

    <Task name="initial" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshNonNull
        }}
        setter={[$store.replay.effect]}
    />

    <Call
        module="../non_null/replay"
        in={{
            view: $in.non_null,
            infer_source: true
        }}
    />

    <Task name="after_non_null" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <If on={$ctx.task.after_non_null != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshObjects
        }}
        setter={[$store.replay.effect]}
    />

    <Call
        module="../selection/select"
        in={{
            view: $in.objects,
            final: true
        }}
    />

    <Call
        module="../projections/apply_diagnostic"
    />

    <Task name="after_select" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <If on={$ctx.task.after_select != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call
        module="../construction/construct"
        in={{
            view: $in.objects,
            final: true
        }}
    />

    <Task name="after_construct" out={$ctx.read_revision}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.ReadRevision
            }}
            setter={[$store.replay.effect]}
        />

        <Call fn="read_revision" in={$store.replay.effect} />
    </Task>

    <If on={$ctx.task.after_construct != $ctx.task.initial}>
        <Return value={true} />
    </If>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshLengths
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../projections/validate" in={$in.lengths} />

    <Call
        module="../projections/apply_diagnostic"
    />

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshBindings
        }}
        setter={[$store.replay.effect]}
    />

    <Task name="bindings" out={$ctx.run}>
        <Call
            module="../bindings/run"
            in={{
                view: $in.bindings,
                final: true
            }}
        />
    </Task>

    <If on={$ctx.task.bindings != null}>
        <Call
            fn="stage_replay"
            in={{
                step: Effect.Step.RejectBinding,
                diagnostic: $ctx.task.bindings
            }}
            setter={[$store.replay.effect]}
        />
    </If>

    <Call
        fn="stage_replay"
        in={{
            step: Effect.Step.RefreshValidation
        }}
        setter={[$store.replay.effect]}
    />

    <Call module="../assignment/validation/run" in={$in.validation} />

    <Call
        module="../projections/apply_diagnostic"
    />

    <Return value={false} />
</Module>
