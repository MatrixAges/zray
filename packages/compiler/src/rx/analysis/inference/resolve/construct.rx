<Module>
    <Type from="model" as="Resolve" />

    <Args in={Resolve.Request} out={u32} />

    <Call fn="diagnostic" in={$in.route} />

    <If on={$ctx.diagnostic != null}>
        <Call
            fn="host.reportResolveFailure"
            in={[
                $in.resolver.frame,
                $in.node,
                $ctx.diagnostic.code,
                $ctx.diagnostic.message
            ]}
        />
    </If>

    <Call
        fn="host.prepareResolveConstruction"
        in={[
            $in.resolver.frame,
            $in.node,
            $in.route == Resolve.Route.Object
        ]}
    />

    <Call
        fn="candidate"
        in={{
            route: $in.route,
            child: $in.completed ?? 0,
            names: $in.resolver.payload.names,
            values: $in.values,
            used: $in.used,
            count: $in.count
        }}
    />

    <Call
        module="../../../../zx/analysis/semantic/construct_type"
        in={{
            tables: $in.resolver.tables,
            candidate: $ctx.candidate
        }}
    />

    <If on={$ctx.construct_type.diagnostic.message != ""}>
        <Call
            fn="host.reportResolveConstruction"
            in={[
                $in.resolver.frame,
                $ctx.construct_type.diagnostic.code,
                $ctx.construct_type.diagnostic.message
            ]}
        />
    </If>

    <If on={$ctx.construct_type.row != null}>
        <Call
            fn="host.bindResolvedType"
            in={[
                $in.resolver.frame,
                $ctx.construct_type.row.layout.kind,
                $ctx.construct_type.row.layout.first,
                $ctx.construct_type.row.layout.second,
                $ctx.construct_type.row.label,
                $ctx.construct_type.row.children,
                $ctx.construct_type.row.fields.names,
                $ctx.construct_type.row.fields.types,
                $ctx.construct_type.row.names
            ]}
        />
    </If>

    <Call fn="host.finishResolveConstruction" in={$in.resolver.frame} />

    <Return value={$ctx.construct_type.id} />
</Module>
