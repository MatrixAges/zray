<Module>
    <Type from="model" as="Resolve" />
    <Type from="effect" as="Resolution" />

    <Args in={Resolve.Request} out={u32} />

    <Store from="resolution" as="resolution" />

    <Call fn="diagnostic" in={$in.route} />

    <If on={$ctx.diagnostic != null}>
        <Call
            fn="stage"
            in={{
                resolve_step: Resolution.Step.Reject,
                node: $in.node,
                code: $ctx.diagnostic.code,
                message: $ctx.diagnostic.message
            }}
            setter={[$store.resolution.effect]}
        />
    </If>

    <Call
        fn="stage"
        in={{
            resolve_step: Resolution.Step.Prepare,
            node: $in.node,
            object: $in.route == Resolve.Route.Object
        }}
        setter={[$store.resolution.effect]}
    />

    <Call
        fn="candidate"
        in={{
            route: $in.route,
            child: $in.completed ?? 0,
            names: $in.resolver.payload.names,
            values: $in.values,
            used: $in.used,
            count: $in.count
        }}
    />

    <Call
        module="../../../../zx/analysis/semantic/construct_type"
        in={{
            tables: $in.resolver.tables,
            candidate: $ctx.candidate
        }}
    />

    <If on={$ctx.construct_type.diagnostic.message != ""}>
        <Call
            fn="stage"
            in={{
                resolve_step: Resolution.Step.RejectType,
                code: $ctx.construct_type.diagnostic.code,
                message: $ctx.construct_type.diagnostic.message
            }}
            setter={[$store.resolution.effect]}
        />
    </If>

    <If on={$ctx.construct_type.row != null}>
        <Call
            fn="stage"
            in={{
                resolve_step: Resolution.Step.Publish,
                kind: $ctx.construct_type.row.layout.kind,
                first: $ctx.construct_type.row.layout.first,
                second: $ctx.construct_type.row.layout.second,
                label: $ctx.construct_type.row.label,
                children: $ctx.construct_type.row.children,
                field_names: $ctx.construct_type.row.fields.names,
                field_types: $ctx.construct_type.row.fields.types,
                names: $ctx.construct_type.row.names
            }}
            setter={[$store.resolution.effect]}
        />
    </If>

    <Call
        fn="stage"
        in={{
            resolve_step: Resolution.Step.Finish
        }}
        setter={[$store.resolution.effect]}
    />

    <Return value={$ctx.construct_type.id} />
</Module>
