import { Kind } from "core/type_table/model"

import { Kind as NodeKind } from "../unification/model"

import type { Candidate } from "../../../../zx/analysis/semantic/types/model"
import type { Pending } from "./continuation"

export type Input = Pending

export type Output = Candidate

export default function (in: Input): Output {
    const kind = match in.kind {
        NodeKind.List => Kind.List,
        NodeKind.Optional => Kind.Optional,
        NodeKind.Tuple => Kind.Tuple,
        _ => Kind.Object
    }

    const members = in.members
    const empty: u32[] = []

    return {
        kind,
        first: in.child,
        second: 0,
        label: "",
        children: kind == Kind.Tuple ? members : empty,
        fields: {
            names: in.names,
            types: kind == Kind.Object ? members : empty
        },
        names: []
    }
}
