import { Kind } from "core/type_table/model"

import { Route } from "./model"

import type { Candidate } from "../../../../zx/analysis/semantic/types/model"
import type { Payload } from "./continuation"
import type { Route as Construction } from "./model"

export type Input = {
    route: Construction,
    child: u32,
    payload: Payload
}

export type Output = Candidate

export default function (in: Input): Output {
    const kind = match in.route {
        Route.List => Kind.List,
        Route.Optional => Kind.Optional,
        Route.Tuple => Kind.Tuple,
        _ => Kind.Object
    }

    const members = in.payload.members
    const empty: u32[] = []

    return {
        kind,
        first: in.child,
        second: 0,
        label: "",
        children: kind == Kind.Tuple ? members : empty,
        fields: {
            names: in.payload.names,
            types: kind == Kind.Object ? members : empty
        },
        names: []
    }
}
