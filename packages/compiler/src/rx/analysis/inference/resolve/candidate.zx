import { Kind } from "core/type_table/model"

import { Route } from "./model"

import type { Candidate } from "../../../../zx/analysis/semantic/types/model"
import type { Route as Construction } from "./model"

export type Input = {
    route: Construction,
    child: u32,
    names: string[],
    values: u32[],
    used: u64,
    count: u64
}

export type Output = Candidate

export default function (in: Input): Output {
    const kind = match in.route {
        Route.List => Kind.List,
        Route.Optional => Kind.Optional,
        Route.Tuple => Kind.Tuple,
        _ => Kind.Object
    }

    const empty: u32[] = []

    const members = loop({
        offset: 0,
        items: empty
    }, {
        while: state => state.offset < in.count,
        next: state => {
            state.items = state.items.push(in.values[in.used + state.offset])[0]
            state.offset += 1
        },
        return: state => state.items
    })

    return {
        kind,
        first: in.child,
        second: 0,
        label: "",
        children: kind == Kind.Tuple ? members : empty,
        fields: {
            names: in.names,
            types: kind == Kind.Object ? members : empty
        },
        names: []
    }
}
