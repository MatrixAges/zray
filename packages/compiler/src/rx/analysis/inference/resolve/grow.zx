import { reserveResolveFrames, reserveResolveValues } from "rx_project_host"

import { frame_width } from "./const"
import { Route } from "./model"

import type { Request } from "./model"

export type Input = Request

export type Output = Request

export default function (in: Input): Output {
    if (in.route == Route.GrowFrames) {
        const used = in.depth * frame_width

        const frame_capacity =
            reserveResolveFrames(in.resolver.frame, used, frame_width)

        return {
            ...in,
            frame_capacity,
            route: Route.Search
        }
    }

    const value_capacity = reserveResolveValues(in.resolver.frame, in.used, 1)

    return {
        ...in,
        value_capacity,
        route: Route.Search
    }
}
