<Module>
    <Type from="model" as="Resolve" />
    <Type from="effect" as="Resolution" />

    <Args in={Resolve.Request} out={Resolve.Request} />

    <Store from="resolution" as="resolution" />

    <Call fn="walk" in={$in} />

    <If on={$ctx.walk.route == Resolve.Route.Complete}>
        <Return value={$ctx.walk} />
    </If>

    <If on={$ctx.walk.route == Resolve.Route.Record}>
        <Call
            fn="stage"
            in={{
                resolve_step: Resolution.Step.Record,
                node: $ctx.walk.node,
                type_id: $ctx.walk.completed ?? 0
            }}
            setter={[$store.resolution.effect]}
        />

        <Return
            value={{
                ...$ctx.walk,
                route: Resolve.Route.Search
            }}
        />
    </If>

    <Call module="construct" in={$ctx.walk} />

    <Call
        fn="stage"
        in={{
            resolve_step: Resolution.Step.Record,
            node: $ctx.walk.node,
            type_id: $ctx.construct
        }}
        setter={[$store.resolution.effect]}
    />

    <Return
        value={{
            ...$ctx.walk,
            completed: $ctx.construct,
            count: 0,
            route: Resolve.Route.Search
        }}
    />
</Module>
