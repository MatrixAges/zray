import type { U8Buffer, U32Buffer, U64Buffer } from "memory"
import type { TypeResolver } from "rx_project_host"
import type { Kind } from "../unification/model"

export enum Route {
    Search,
    Complete,
    List,
    Optional,
    Object,
    Tuple,
    GrowFrames,
    GrowValues,
    Depth,
    Sequence,
    Unconstrained,
    NumericMismatch
}

export type View = {
    kinds: Kind[],
    arguments: u32[],
    members: u32[][],
    allowed: u16?[],
    fallback: u8?[]
}

export type Publication = {
    kinds: U8Buffer,
    arguments: U32Buffer,
    revision: U64Buffer,
    known_kind: u8
}

export type Request = {
    frame: TypeResolver,
    graph: View,
    publication: Publication,
    parents: U32Buffer,
    frames: U64Buffer,
    values: U32Buffer,
    frame_capacity: u64,
    value_capacity: u64,
    depth: u64,
    used: u64,
    count: u64,
    node: u32,
    completed?: u32,
    route: Route
}
