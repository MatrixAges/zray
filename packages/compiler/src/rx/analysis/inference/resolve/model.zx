import type { Tables } from "core/type_table/model"
import type { TypeResolver } from "rx_project_host"
import type { Kind } from "../unification/model"
import type { Payload } from "./continuation"

export enum Route {
    Search,
    Complete,
    Record,
    List,
    Optional,
    Object,
    Tuple,
    Depth,
    Sequence,
    Unconstrained,
    NumericMismatch
}

export type View = {
    kinds: Kind[],
    arguments: u32[],
    members: u32[][],
    allowed: u16?[],
    fallback: u8?[]
}

export type Session = {
    frame: TypeResolver,
    graph: View,
    parents: u32[],
    tables: Tables,
    payload: Payload,
}

export type Input = {
    resolver: Session,
    node: u32
}

export type Request = {
    resolver: Session,
    frames: u64[],
    values: u32[],
    depth: u64,
    used: u64,
    count: u64,
    node: u32,
    completed?: u32,
    route: Route
}
