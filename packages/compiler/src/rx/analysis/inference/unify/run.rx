<Module>
    <Type from="model" as="Walk" />

    <Args in={Walk.Request} out={void} />

    <Call module="push" in={$in.omit(["stack"])} />

    <Loop on={$in.count != 0}>
        <Call
            module="advance"
            in={{
                ...$in,
                count: 1
            }}
        />
    </Loop>
</Module>
