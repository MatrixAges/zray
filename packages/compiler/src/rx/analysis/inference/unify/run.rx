<Module>
    <Type from="model" as="Walk" />
    <Type from="effect" as="Unification" />

    <Args in={Walk.Request} out={Walk.Diagnostic?} />

    <Store from="unification" as="unification" />

    <Call
        fn="stage"
        in={{
            step: Unification.Step.BeginWalk
        }}
        setter={[$store.unification.effect]}
    />

    <Call module="push" in={$in.omit(["stack"])} />

    <Loop on={$in.count != 0 && $in.diagnostic == null}>
        <Call
            module="advance"
            in={{
                ...$in,
                count: 1,
                positions: [0],
                diagnostic: null
            }}
        />
    </Loop>

    <Return value={$ctx.advance.diagnostic} />
</Module>
