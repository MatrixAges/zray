import type { State as KnownTypes } from "core/integer/map/model"
import type { UnificationTarget } from "rx_project_host"
import type { Rooted } from "../unification/admission/model"
import type { Action, Operands, Step } from "../unification/application/model"
import type { Route } from "../unification/model"

export type View = Rooted.Omit("left", "right") & {
    kind_bytes: u8[],
    allowed: u16?[],
    fallback: u8?[]
}

export type Frame = Operands & {
    parent: u32,
    child: u32,
    route: Route,
    action: Action,
    first_allowed?: u16,
    second_allowed?: u16,
    first_fallback?: u8,
    second_fallback?: u8,
    kind: u8,
    argument: u32,
    members: u32[],
    declared: string[]
}

export type Publication = {
    target: UnificationTarget,
    frame: Frame,
    members: u32[]
}

export type Row = {
    snapshot: Frame,
    positions: u64[]
}

export type Candidate = {
    frame: Frame
}

export type Merge = {
    target: UnificationTarget,
    candidate: Candidate,
    depth: u64
}

export type Stack = {
    frame: Row,
    parents: u32[],
    known: KnownTypes
}

export type Request = Merge & {
    stack: Stack
}

export type Cursor = Request & {
    count: u64,
    positions: u64[],
    diagnostic?: Diagnostic
}

export type Scan = {
    step: Step,
    left: u32,
    right: u32,
    positions: u64[]
}

export type Child = Cursor.Omit("diagnostic") & Scan.Omit("positions")

export type Diagnostic = {
    message: string,
    depth: bool
}
