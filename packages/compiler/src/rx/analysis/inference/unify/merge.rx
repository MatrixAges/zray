<Module>
    <Type from="model" as="Walk" />
    <Type from="../unification/model" as="Admission" />
    <Type from="../unification/application/model" as="Application" />
    <Type from="effect" as="Unification" />

    <Args in={Walk.MergeInput} out={Walk.Diagnostic?} />

    <Store from="unification" as="unification" />

    <Call
        fn="stage"
        in={{
            step: Unification.Step.Prepare,
            left: $in.left,
            right: $in.right,
            depth: $in.depth,
            rooted: false
        }}
        setter={[$store.unification.effect]}
    />

    <Call fn="diagnose" in={$in.candidate.frame.route} />

    <If on={$ctx.diagnose != null}>
        <Return value={$ctx.diagnose} />
    </If>

    <If on={$in.candidate.frame.route != Admission.Route.Same}>
        <If on={$in.candidate.frame.action == Application.Action.Adopt}>
            <Call
                module="commit"
                in={{
                    frame: $in.candidate.frame,
                    members: $in.candidate.frame.members
                }}
            />
        </If>

        <If on={$in.candidate.frame.action != Application.Action.Adopt}>
            <Call
                module="run"
                in={$in.omit([
                    "left",
                    "right"
                ])}
            />

            <Return value={$ctx.run} />
        </If>
    </If>

    <Return value={null} />
</Module>
