<Module>
    <Type from="model" as="Walk" />
    <Type from="../unification/application/model" as="Application" />
    <Type from="../unification/model" as="Admission" />

    <Args in={Walk.Cursor} out={Walk.Cursor} />

    <Call fn="scan" in={$in} />

    <If on={$ctx.scan.step == Application.Step.Publish}>
        <Call
            module="publish"
            in={$in.omit([
                "count",
                "positions"
            ])}
        />

        <Return
            value={{
                ...$in,
                count: $in.count - 1,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call
        fn="reject_child"
        in={{
            target: $in.target,
            step: $ctx.scan.step
        }}
    />

    <Call
        module="child"
        in={{
            ...$in,
            ...$ctx.scan.omit(["positions"])
        }}
    />

    <If on={$in.candidate.frame.route == Admission.Route.Same}>
        <Return
            value={{
                ...$in,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call
        fn="diagnose"
        in={{
            target: $in.target,
            route: $in.candidate.frame.route
        }}
    />

    <If on={$in.candidate.frame.action == Application.Action.Adopt}>
        <Call
            fn="commit"
            in={{
                target: $in.target,
                frame: $in.candidate.frame,
                members: $in.candidate.frame.members
            }}
        />

        <Return
            value={{
                ...$in,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call
        module="push"
        in={$in.omit([
            "stack",
            "count",
            "positions"
        ])}
    />

    <Call fn="push_position" in={$ctx.scan.positions} />

    <Return
        value={{
            ...$in,
            count: $in.count + 1,
            positions: $ctx.push_position
        }}
    />
</Module>
