<Module>
    <Type from="model" as="Walk" />
    <Type from="../unification/application/model" as="Application" />
    <Type from="../unification/model" as="Admission" />

    <Args in={Walk.Cursor} out={Walk.Cursor} />

    <Call fn="scan" in={$in.omit(["diagnostic"])} />

    <If on={$ctx.scan.step == Application.Step.Publish}>
        <Call
            module="publish"
            in={$in.omit([
                "count",
                "positions",
                "diagnostic"
            ])}
        />

        <Return
            value={{
                ...$in,
                count: $in.count - 1,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call fn="reject_child" in={$ctx.scan.step} />

    <If on={$ctx.reject_child != null}>
        <Return
            value={{
                ...$in,
                diagnostic: $ctx.reject_child
            }}
        />
    </If>

    <Call
        module="child"
        in={{
            ...$in.omit(["diagnostic"]),
            ...$ctx.scan.omit(["positions"])
        }}
    />

    <If on={$in.candidate.frame.route == Admission.Route.Same}>
        <Return
            value={{
                ...$in,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call fn="diagnose" in={$in.candidate.frame.route} />

    <If on={$ctx.diagnose != null}>
        <Return
            value={{
                ...$in,
                diagnostic: $ctx.diagnose
            }}
        />
    </If>

    <If on={$in.candidate.frame.action == Application.Action.Adopt}>
        <Call
            module="commit"
            in={{
                target: $in.target,
                frame: $in.candidate.frame,
                members: $in.candidate.frame.members
            }}
        />

        <Return
            value={{
                ...$in,
                positions: $ctx.scan.positions
            }}
        />
    </If>

    <Call
        module="push"
        in={$in.omit([
            "stack",
            "count",
            "positions",
            "diagnostic"
        ])}
    />

    <Call fn="push_position" in={$ctx.scan.positions} />

    <Return
        value={{
            ...$in,
            count: $in.count + 1,
            positions: $ctx.push_position
        }}
    />
</Module>
