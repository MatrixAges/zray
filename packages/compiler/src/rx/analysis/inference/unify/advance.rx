<Module>
    <Type from="model" as="Walk" />
    <Type from="../unification/application/model" as="Application" />
    <Type from="../unification/model" as="Admission" />

    <Args in={Walk.Request} out={Walk.Request} />

    <Call fn="scan" in={$in} />

    <If on={$ctx.scan == Application.Step.Publish}>
        <Call module="publish" in={$in} />

        <Call
            fn="host.writeU64"
            in={[
                $in.stack.count_slot,
                0,
                $in.stack.count[0] - 1
            ]}
        />

        <Return value={$in} />
    </If>

    <Call
        fn="reject_child"
        in={{
            target: $in.target,
            step: $ctx.scan
        }}
    />

    <Call
        module="child"
        in={{
            ...$in,
            step: $ctx.scan
        }}
    />

    <If on={$in.candidate.frame.route == Admission.Route.Same}>
        <Return value={$in} />
    </If>

    <Call
        fn="diagnose"
        in={{
            target: $in.target,
            route: $in.candidate.frame.route
        }}
    />

    <If on={$in.candidate.frame.action == Application.Action.Adopt}>
        <Call
            fn="commit"
            in={{
                target: $in.target,
                frame: $in.candidate.frame,
                members: $in.candidate.frame.members
            }}
        />

        <Return value={$in} />
    </If>

    <Call module="push" in={$in.omit(["stack"])} />

    <Call
        fn="host.writeU64"
        in={[
            $in.stack.count_slot,
            0,
            $in.stack.count[0] + 1
        ]}
    />

    <Return value={$in} />
</Module>
