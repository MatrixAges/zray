<Module>
    <Type from="application" as="Length" />
    <Type from="../fields/model" as="Fields" />
    <Type from="effect" as="ProjectionEffect" />

    <Args in={Length.Input} out={bool} />

    <Store from="publication" as="projection" />

    <If on={$in.node != null}>
        <Call
            fn="stage"
            in={{
                projection_step: ProjectionEffect.Step.Merge,
                site: {
                    spans: $in.site.spans,
                    row: $in.site.row
                },
                left: $in.node ?? 0,
                right: $in.value
            }}
            setter={[$store.projection.effect]}
        />

        <Return value={true} />
    </If>

    <If on={$in.plan.route == Fields.Route.Open}>
        <Call
            fn="stage"
            in={{
                projection_step: ProjectionEffect.Step.ReadLength,
                site: {
                    spans: $in.site.spans,
                    row: $in.site.row
                },
                left: $in.root
            }}
            setter={[$store.projection.effect]}
        />

        <Call fn="read_id" in={$store.projection.effect} />

        <Call
            fn="stage"
            in={{
                projection_step: ProjectionEffect.Step.Merge,
                site: {
                    spans: $in.site.spans,
                    row: $in.site.row
                },
                left: $ctx.read_id,
                right: $in.value
            }}
            setter={[$store.projection.effect]}
        />

        <Return value={true} />
    </If>

    <If on={$in.plan.route == Fields.Route.RequireList}>
        <Call
            fn="stage"
            in={{
                projection_step: ProjectionEffect.Step.RequireList,
                site: {
                    spans: $in.site.spans,
                    row: $in.site.row
                },
                left: $in.target
            }}
            setter={[$store.projection.effect]}
        />

        <Else>
            <If
                on={$in.plan.route != Fields.Route.Length &&
                    $in.plan.route != Fields.Route.KnownMember}
            >
                <Call fn="../fields/diagnostic" in={$in.plan.route} />

                <Call
                    fn="stage"
                    in={{
                        projection_step: ProjectionEffect.Step.Reject,
                        site: {
                            spans: $in.site.spans,
                            row: $in.site.row
                        },
                        message: $ctx.diagnostic,
                        unsupported: false
                    }}
                    setter={[$store.projection.effect]}
                />

                <Return value={true} />
            </If>
        </Else>
    </If>

    <Call
        fn="stage"
        in={{
            projection_step: ProjectionEffect.Step.RegisterType,
            site: {
                spans: $in.site.spans,
                row: $in.site.row
            },
            left: $in.plan.value
        }}
        setter={[$store.projection.effect]}
    />

    <Call fn="read_id" in={$store.projection.effect} />

    <Call
        fn="stage"
        in={{
            projection_step: ProjectionEffect.Step.Merge,
            site: {
                spans: $in.site.spans,
                row: $in.site.row
            },
            left: $ctx.read_id,
            right: $in.value
        }}
        setter={[$store.projection.effect]}
    />

    <Return value={true} />
</Module>
