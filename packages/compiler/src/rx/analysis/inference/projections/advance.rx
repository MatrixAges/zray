<Module>
    <Type from="model" as="Lengths" />
    <Type from="../solve/replay_effect" as="Effect" />

    <Args in={Lengths.Cursor} out={Lengths.Cursor} />

    <Store from="../solve/replay" as="replay" />

    <Call
        fn="length"
        in={{
            ...$in.request.omit([
                "spans"
            ]),
            start: $in.row
        }}
    />

    <If on={$ctx.length.row == $in.request.targets.length}>
        <Return
            value={{
                ...$in,
                row: $ctx.length.row
            }}
        />
    </If>

    <Call
        module="apply"
        in={{
            site: {
                spans: $in.request.spans,
                row: $ctx.length.row
            },
            plan: $ctx.length.plan,
            node: $ctx.length.node,
            target: $in.request.targets[$ctx.length.row],
            value: $in.request.values[$ctx.length.row],
            root: $ctx.length.root
        }}
    />

    <Call
        fn="../solve/stage_replay"
        in={{
            step: Effect.Step.RefreshLengths
        }}
        setter={[$store.replay.effect]}
    />

    <Return
        value={{
            ...$in,
            row: $ctx.length.row + 1
        }}
    />
</Module>
