<Module>
    <Type from="model" as="Lengths" />
    <Type from="site" as="Projection" />

    <Args in={Lengths.Replay} out={Projection.Diagnostic?} />

    <Call
        fn="scan"
        in={$in.pick([
            "targets",
            "kinds",
            "parents"
        ])}
    />

    <If on={$ctx.scan != null}>
        <Call
            fn="reject"
            in={{
                spans: $in.spans,
                row: $ctx.scan
            }}
        />

        <Return value={$ctx.reject} />
    </If>

    <Return value={null} />
</Module>
