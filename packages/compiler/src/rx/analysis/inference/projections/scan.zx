import integers from "std:integer"

import representative from "../forest/borrowed_root"
import { Kind } from "../unification/model"

import type { Kind as ShapeKind } from "../unification/model"

export type Input = {
    targets: u32[],
    kinds: ShapeKind[],
    parents: u32[]
}

export type Output = u64?

export default function (in: Input): Output {
    const parents = in.parents
    const missing: u64? = null

    return loop({
        row: 0,
        pending: missing
    }, {
        while: state => state.pending == null && state.row < in.targets.length,
        next: state => {
            const row = state.row
            const parent = representative({
                parents,
                value: in.targets[row]
            })
            const root = integers.widen(parent)

            if (in.kinds[root] == Kind.Unknown) {
                state.pending = row
            } else {
                state.row += 1
            }
        },
        return: state => state.pending
    })
}
