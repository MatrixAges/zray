<Module>
    <Type from="site" as="Projection" />
    <Type from="effect" as="ProjectionEffect" />

    <Args in={Projection.Diagnostic?} out={void} />

    <Store from="publication" as="projection" />

    <If on={$in != null}>
        <Call
            fn="stage"
            in={{
                projection_step: ProjectionEffect.Step.Reject,
                site: {
                    spans: $in.spans,
                    row: $in.row
                },
                message: $in.message,
                unsupported: $in.unsupported
            }}
            setter={[$store.projection.effect]}
        />
    </If>
</Module>
