import type { ProjectionGraph, ProjectionSpans } from "rx_project_host"

export type Site = {
    graph: ProjectionGraph,
    spans: ProjectionSpans,
    row: u64
}

export type Diagnostic = Site.Omit("graph") & {
    message: string,
    unsupported: bool
}

export type Publication = {
    graph: ProjectionGraph,
    diagnostic?: Diagnostic
}
