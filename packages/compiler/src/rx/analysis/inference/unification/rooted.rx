<Module>
    <Type from="admission/model" as="Admission" />
    <Type from="occurs/model" as="Occurs" />

    <Args in={Admission.Rooted} out={Admission.Output} />

    <Call
        fn="occurs/check"
        in={{
            graph: $in.graph,
            parents: $in.parents,
            source: $in.left,
            target: $in.right,
            depth: 0
        }}
    />

    <If on={$ctx.check != Occurs.Reach.Absent}>
        <Call
            fn="admission/reject"
            in={{
                left: $in.left,
                right: $in.right,
                reach: $ctx.check
            }}
        />

        <Return value={$ctx.reject} />
    </If>

    <Call
        fn="admission/rows"
        in={{
            left: $in.left,
            right: $in.right,
            graph: $in.graph,
            types: $in.types
        }}
    />

    <Call module="decide" in={$ctx.rows} />

    <Call
        fn="application/project"
        in={{
            graph: $in.graph,
            types: $in.types,
            route: $ctx.decide,
            left: $in.left,
            right: $in.right
        }}
    />

    <Return
        value={{
            left: $in.left,
            right: $in.right,
            route: $ctx.decide,
            ...$ctx.project
        }}
    />
</Module>
