import type { U64Buffer } from "memory"

export type Index = {
    names: string[],
    keys: u8[][],
    buckets: U64Buffer,
    capacity: u64
}

export type Input = {
    existing: Index,
    incoming: string[],
    closed: bool
}

export type Output = {
    scanned: u64,
    length: u64,
    positions: u64[]
}
