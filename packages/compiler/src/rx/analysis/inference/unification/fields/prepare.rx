<Module>
    <Type from="model" as="Fields" />

    <Args in={Fields.Input} out={Fields.Output} />

    <Call
        fn="capacity"
        in={{
            existing: $in.existing.length,
            incoming: $in.incoming.length
        }}
    />

    <Call
        module="align"
        in={{
            ...$in,
            capacity: $ctx.capacity
        }}
    />

    <Return value={$ctx.align} />
</Module>
