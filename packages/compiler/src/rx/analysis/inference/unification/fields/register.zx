import probe from "./probe"

export type Input = {
    names: string[],
    capacity: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const { names, capacity } = in

    const empty: u64[] = []

    if (capacity == 0) {
        return empty
    }

    const buckets = loop(empty, {
        while: items => items.length < capacity,
        next: items => {
            items = items.push(0)[0]
        }
    })

    return loop({
        buckets,
        row: 0
    }, {
        while: state => state.row < names.length,
        next: state => {
            const row = state.row
            const found = probe({
                names,
                buckets: state.buckets,
                name: names[row]
            })

            if (found.position == null) {
                state.buckets = state.buckets.with(found.slot, row + 1)
            }

            state.row += 1
        },
        return: state => state.buckets
    })
}
