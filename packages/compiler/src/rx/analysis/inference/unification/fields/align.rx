<Module>
    <Type from="model" as="Fields" />

    <Args in={Fields.Scan} out={Fields.Output} />

    <Call
        fn="register"
        in={{
            names: $in.existing,
            capacity: $in.capacity
        }}
    />

    <Call
        fn="positions"
        in={{
            ...$in.omit(["capacity"]),
            buckets: $ctx.register
        }}
    />

    <Return value={$ctx.positions} />
</Module>
