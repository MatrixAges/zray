<Module>
    <Type from="workflow" as="Fields" />

    <Args in={Fields.Merge} out={void} />

    <If on={$in.length != $in.columns.prefix}>
        <Call
            module="../../fields/growth/resize"
            in={{
                storage: $in.storage,
                count: $in.length
            }}
        />

        <Call fn="publish" in={$in.columns} />
    </If>
</Module>
