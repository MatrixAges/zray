import find from "../find_field"
import probe from "./probe"

import type { Input as Fields, Output } from "./model"

export type Input = Fields & {
    buckets: u64[]
}

export default function (in: Input): Output {
    const { existing, buckets } = in

    const positions: u64[] = []

    return loop({
        scanned: 0,
        length: existing.length,
        missing: false,
        positions
    }, {
        while: state => state.scanned < in.incoming.length && !state.missing,
        next: state => {
            const name = in.incoming[state.scanned]

            const position = match {
                buckets.length == 0 => find({
                    names: existing,
                    name
                }),
                _ => probe({
                    names: existing,
                    buckets,
                    name
                }).position
            }

            if (position == null && in.closed) {
                state.missing = true
            } else {
                state.positions =
                    state.positions.push(position == null ? state.length : position)[0]

                if (position == null) {
                    state.length += 1
                }

                state.scanned += 1
            }
        },
        return: state => ({
            scanned: state.scanned,
            length: state.length,
            positions: state.positions
        })
    })
}
