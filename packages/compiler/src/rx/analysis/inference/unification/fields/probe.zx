import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    names: string[],
    buckets: u64[],
    name: string
}

export type Output = {
    slot: u64,
    position?: u64
}

export default function (in: Input): Output {
    const { names, buckets, name } = in

    const mask = buckets.length - 1

    return loop({
        slot: integers.andBits(bytes.hash(bytes.fromText(name)), mask),
        entry: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = buckets[state.slot]

            if (entry == 0 || names[entry - 1] == name) {
                state.entry = entry
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => ({
            slot: state.slot,
            position: state.entry == 0 ? null : state.entry - 1
        })
    })
}
