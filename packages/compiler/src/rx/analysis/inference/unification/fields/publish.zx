import memory from "memory"

import type { StringBuffer, U32Buffer } from "memory"

export type Input = {
    names: string[],
    values: u32[],
    positions: u64[],
    prefix: u64,
    target_names: StringBuffer,
    target_values: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const positions = in.positions
    const names = in.names
    const values = in.values
    const prefix = in.prefix
    const target_names = in.target_names
    const target_values = in.target_values

    const written = loop({
        row: 0
    }, {
        while: state => state.row < positions.length,
        next: state => {
            const position = positions[state.row]

            if (position >= prefix) {
                memory.writeString(target_names, position, names[state.row])
                memory.writeU32(target_values, position, values[state.row])
            }

            state.row += 1
        }
    })
}
