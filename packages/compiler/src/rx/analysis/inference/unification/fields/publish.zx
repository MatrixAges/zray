import resize from "../../fields/growth/capacity"

export type Addition = {
    position: u64,
    name: string,
    value: u32
}

export type Input = {
    names: string[],
    values: u32[],
    positions: u64[],
    prefix: u64,
    length: u64,
    capacity: u64,
    published: u64
}

export type Output = {
    capacity?: u64,
    additions: Addition[]
}

export default function (in: Input): Output {
    const empty: Addition[] = []

    if (in.length == in.prefix) {
        return {
            capacity: null,
            additions: empty
        }
    }

    const capacity = resize({
        prefix: in.prefix,
        capacity: in.capacity,
        published: in.published,
        count: in.length
    })

    const additions = loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < in.positions.length,
        next: state => {
            const row = state.row
            const position = in.positions[row]

            if (position >= in.prefix) {
                state.items = state.items.push({
                    position,
                    name: in.names[row],
                    value: in.values[row]
                })[0]
            }

            state.row += 1
        },
        return: state => state.items
    })

    return {
        capacity,
        additions
    }
}
