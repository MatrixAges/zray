import fixedCapacity from "core/bytes/index/fixed_capacity"

import { minimum_indexed_fields, minimum_indexed_queries } from "./const"

export type Input = {
    existing: u64,
    incoming: u64
}

export type Output = u64

export default function (in: Input): Output {
    if (
        in.existing < minimum_indexed_fields || in.incoming < minimum_indexed_queries
    ) {
        return 0
    }

    return fixedCapacity(in.existing)
}
