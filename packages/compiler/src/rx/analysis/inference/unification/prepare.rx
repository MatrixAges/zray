<Module>
    <Type from="admission/model" as="Admission" />
    <Type from="model" as="Unification" />

    <Args in={Admission.Input} out={Admission.Output} />

    <Call
        fn="admission/roots"
        in={$in.omit([
            "graph",
            "types"
        ])}
    />

    <If on={$ctx.roots.route != Unification.Route.Ready}>
        <Return value={$ctx.roots} />
    </If>

    <Call
        module="rooted"
        in={{
            graph: $in.graph,
            types: $in.types,
            parents: $in.parents,
            left: $ctx.roots.left,
            right: $ctx.roots.right
        }}
    />

    <Return value={$ctx.rooted} />
</Module>
