<Module>
    <Type from="commit/model" as="Commit" />

    <Args in={Commit.Input} out={Commit.Output} />

    <Call
        fn="commit/publish_prefix"
        in={$in.pick([
            "left",
            "right"
        ])}
    />

    <If on={$ctx.publish_prefix.allowed != null}>
        <Call
            module="../scalar/apply"
            in={{
                target: {
                    graph: $in.graph,
                    node: $in.parent
                },
                requested: $ctx.publish_prefix.allowed ?? 0
            }}
        />

        <Return
            value={{
                fallback: $ctx.publish_prefix.fallback,
                allowed: $ctx.apply.allowed,
                message: $ctx.apply.message
            }}
        />
    </If>

    <Return
        value={{
            fallback: $ctx.publish_prefix.fallback,
            allowed: null,
            message: null
        }}
    />
</Module>
