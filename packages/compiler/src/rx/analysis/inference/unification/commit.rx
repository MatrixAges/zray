<Module>
    <Type from="commit/model" as="Commit" />

    <Args in={Commit.Input} out={Commit.Output} />

    <Call
        fn="commit/publish_shape"
        in={$in.pick([
            "parent",
            "columns",
            "shape"
        ])}
    />

    <Call
        fn="../forest/link"
        in={$in.pick([
            "parents",
            "parent",
            "child"
        ])}
    />

    <Call
        fn="commit/publish_prefix"
        in={$in.pick([
            "parent",
            "storage",
            "left",
            "right"
        ])}
    />

    <If on={$ctx.publish_prefix != null}>
        <Call
            module="../scalar/apply"
            in={{
                target: {
                    graph: $in.graph,
                    node: $in.parent
                },
                storage: $in.storage,
                requested: $ctx.publish_prefix ?? 0
            }}
        />

        <Return value={$ctx.apply.message} />
    </If>

    <Return value={null} />
</Module>
