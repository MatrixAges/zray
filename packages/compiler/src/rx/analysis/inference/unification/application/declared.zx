import integers from "std:integer"
import memory from "memory"

import { Kind } from "../model"
import { Action } from "./model"

import type { Application, Request } from "./model"

export type Input = Request

export type Output = Application

export default function (in: Input): Output {
    const left_index = integers.widen(in.left)
    const left_known = in.graph.kinds[left_index] == Kind.Known
    const source = left_known ? in.left : in.right
    const inferred = left_known ? in.right : in.left
    const index = integers.widen(inferred)
    const kind = in.graph.kinds[index]

    const action = match kind {
        Kind.List => Action.KnownChild,
        Kind.Optional => Action.KnownChild,
        Kind.Tuple => Action.KnownTuple,
        Kind.Object => Action.KnownObject,
        _ => Action.Adopt
    }

    const left_members = in.graph.members[index]

    const no_operands = action == Action.Adopt ||
        (action != Action.KnownChild && left_members.length == 0)

    if (no_operands) {
        return {
            left_operand: 0,
            right_operand: 0,
            left_members: [],
            right_members: [],
            action: Action.Adopt,
            source,
            right_names: []
        }
    }

    const declared = in.graph.arguments[integers.widen(source)]
    const type_index = integers.widen(declared)
    const argument = in.types.arguments[type_index]

    if (action == Action.KnownChild) {
        return {
            action,
            source,
            left_operand: in.graph.arguments[index],
            right_operand: argument,
            left_members: [],
            right_members: [],
            right_names: []
        }
    }

    const first = integers.widen(argument)
    const count = integers.widen(in.types.sizes[type_index])
    const values = action == Action.KnownTuple ? in.types.children : in.types.field_values
    const right_members = memory.borrowU32Range(values, first, count)

    const right_names = match action {
        Action.KnownObject =>
            memory.borrowStringRange(in.types.field_names, first, count),
        _ => []
    }

    return {
        action,
        source,
        left_operand: 0,
        right_operand: 0,
        left_members,
        right_members,
        right_names
    }
}
