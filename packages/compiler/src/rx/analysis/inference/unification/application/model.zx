import type { State as KnownTypes } from "core/integer/map/model"
import type { U32Buffer } from "memory"
import type { Route, TypeColumns } from "../model"
import type { Graph } from "../occurs/model"

export enum Action {
    Adopt,
    Child,
    Tuple,
    Object,
    KnownChild,
    KnownTuple,
    KnownObject
}

export type Operands = {
    left_operand: u32,
    right_operand: u32,
    left_members: u32[],
    right_members: u32[]
}

export type Application = Operands & {
    action: Action,
    source: u32,
    right_names: string[]
}

export type Request = {
    graph: Graph,
    types: TypeColumns,
    route: Route,
    left: u32,
    right: u32
}

export enum Step {
    Publish,
    Merge,
    MergeKnown,
    MissingField,
    Depth,
    Skip
}

export type PairInput = Operands & {
    action: Action,
    position: u64,
    positions: u64[]
}

export type PairOutput = {
    step: Step,
    position: u64,
    left: u32,
    right: u32
}

export type Advance = {
    pair: PairInput,
    known: KnownTypes,
    parents: U32Buffer,
    depth: u64
}
