import integers from "std:integer"

import { Route } from "../model"
import declared from "./declared"
import { Action } from "./model"

import type { Application, Request } from "./model"

export type Input = Request

export type Output = Application

export default function (in: Input): Output {
    const { route, left, right } = in

    if (route == Route.Known) {
        return declared(in)
    }

    if (route == Route.Child) {
        const arguments = in.graph.arguments

        return {
            action: Action.Child,
            source: left,
            left_operand: arguments[integers.widen(left)],
            right_operand: arguments[integers.widen(right)],
            left_members: [],
            right_members: [],
            right_names: []
        }
    }

    if (route == Route.Object || route == Route.Tuple) {
        const members = in.graph.members
        const first = members[integers.widen(left)]
        const second = members[integers.widen(right)]

        const empty_object = route == Route.Object &&
            (first.length == 0 || second.length == 0)

        if (empty_object) {
            return {
                left_operand: 0,
                right_operand: 0,
                left_members: [],
                right_members: [],
                action: Action.Adopt,
                source: first.length == 0 ? right : left,
                right_names: []
            }
        }

        return {
            action: route == Route.Object ? Action.Object : Action.Tuple,
            source: left,
            left_operand: 0,
            right_operand: 0,
            left_members: first,
            right_members: second,
            right_names: []
        }
    }

    return {
        left_operand: 0,
        right_operand: 0,
        left_members: [],
        right_members: [],
        action: Action.Adopt,
        source: route == Route.Right ? right : left,
        right_names: []
    }
}
