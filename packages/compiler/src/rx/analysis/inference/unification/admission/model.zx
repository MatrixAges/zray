import type { U32Buffer } from "zig:compiler_memory"
import type { Application } from "../application/model"
import type { Route, TypeColumns } from "../model"
import type { Graph } from "../occurs/model"

export type Columns = TypeColumns

export type Rooted = {
    graph: Graph,
    types: Columns,
    parents: U32Buffer,
    left: u32,
    right: u32
}

export type Input = Rooted & {
    depth: u64
}

export type Roots = {
    left: u32,
    right: u32,
    route: Route
}

export type Output = Roots & Application
