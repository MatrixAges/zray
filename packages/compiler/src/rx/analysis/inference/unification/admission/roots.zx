import { max_nesting_depth } from "core/const"

import representative from "../../forest/borrowed_root"
import { Action } from "../application/model"
import { Route } from "../model"

import type { Output as Admission } from "./model"

export type Input = {
    parents: u32[],
    left: u32,
    right: u32,
    depth: u64,
    rooted?: bool
}

export type Output = Admission

export default function (in: Input): Output {
    const rooted = in.rooted ?? false

    if (!rooted && in.depth >= max_nesting_depth) {
        return {
            left_operand: 0,
            right_operand: 0,
            left_members: [],
            right_members: [],
            left: in.left,
            right: in.right,
            route: Route.Depth,
            action: Action.Adopt,
            source: in.left,
            right_names: []
        }
    }

    const left = match {
        rooted => in.left,
        _ => representative({
            parents: in.parents,
            value: in.left
        })
    }

    const right = match {
        rooted => in.right,
        _ => representative({
            parents: in.parents,
            value: in.right
        })
    }

    const route = left == right ? Route.Same : Route.Ready

    return {
        left_operand: 0,
        right_operand: 0,
        left_members: [],
        right_members: [],
        left,
        right,
        route,
        action: Action.Adopt,
        source: left,
        right_names: []
    }
}
