import integers from "std:integer"

import combineFallback from "../../scalar/combine_fallback"
import intersect from "../../scalar/intersect"

import type { Input as Commit } from "./model"

export type Input = Commit.Pick("left", "right")

export type Output = {
    allowed?: u64,
    fallback?: u8
}

export default function (in: Input): Output {
    const allowed = intersect({
        left: in.left.allowed,
        right: in.right.allowed
    })

    const combined = combineFallback({
        left: in.left.fallback,
        right: in.right.fallback
    })

    const fallback: u8? = match {
        combined == null => null,
        _ => integers.narrowByte(integers.widen(combined))
    }

    return {
        allowed,
        fallback
    }
}
