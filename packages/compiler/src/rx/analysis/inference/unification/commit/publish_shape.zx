import integers from "std:integer"
import memory from "std:memory"

import type { Input as Commit } from "./model"

export type Input = Commit.Pick("parent", "columns", "shape")

export type Output = void

export default function (in: Input): Output {
    const parent = integers.widen(in.parent)
    const shape = in.shape
    const columns = in.columns

    memory.writeU8(columns.kinds, parent, shape.kind)
    memory.writeU32(columns.arguments, parent, shape.argument)
    memory.writeU32List(columns.members, parent, shape.members)
}
