import integers from "std:integer"
import { max_nesting_depth, max_u64 } from "core/const"

import payload from "./payload"
import { Action as PayloadAction } from "./payload"
import { Mode } from "./query"

import type { Output as Payload } from "./payload"
import type { Input } from "./query"

export enum Action {
    Continue,
    Ready,
    Missing,
    Register,
    Depth
}

export type Output = Payload.Omit("open", "action") & {
    action: Action
}

export default function (in: Input): Output {
    const hint = in.mode == Mode.Hint
    const limit = hint ? max_u64 : max_nesting_depth

    const result = payload({
        ...in.pick([
            "graph",
            "parents",
            "known",
            "value"
        ]),
        remaining: in.remaining ?? limit
    })

    const { root, remaining } = result

    const action = match result.action {
        PayloadAction.Register => Action.Register,
        PayloadAction.Depth => Action.Depth,
        _ => match {
            !hint => Action.Ready,
            !result.open => Action.Ready,
            in.allowed[integers.widen(root)] != null => Action.Ready,
            _ => Action.Missing
        }
    }

    const value = match {
        action == Action.Ready && !hint => root,
        _ => result.value
    }

    return {
        action,
        remaining,
        root,
        value
    }
}
