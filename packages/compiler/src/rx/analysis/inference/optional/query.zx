import type { State as Known } from "core/integer/map/model"
import type { Graph } from "./model"
import type { Action } from "./payload"

export enum Mode {
    Hint,
    Payload
}

export type Guard = {
    graph: Graph,
    known: Known,
    parents: u32[],
    value: u32
}

export type Input = Guard & {
    allowed: u16?[],
    mode: Mode,
    remaining?: u64
}

export type Output = {
    action: Action,
    value?: u32,
    root: u32,
    remaining: u64
}
