import integers from "std:integer"

import payload from "./payload"
import { Action } from "./payload"

import type { Input as PayloadInput, Output as PayloadOutput } from "./payload"

export type Input = PayloadInput & {
    allowed: u16?[]
}

export type Output = PayloadOutput.Pick("action", "value", "root") & {
    hint?: u32
}

export default function (in: Input): Output {
    const { action, value, root, open } = payload(in.omit(["allowed"]))

    const restricted = in.allowed[integers.widen(root)] != null
    const usable = action == Action.Ready && (!open || restricted)

    return {
        action,
        value,
        root,
        hint: usable ? value : null
    }
}
