<Module>
    <Type from="request" as="Optional" />
    <Type from="lookup" as="Lookup" />

    <Args in={Optional.Request} out={Optional.Result} />

    <Loop on={$in.action == Lookup.Action.Continue}>
        <Call
            module="advance"
            in={{
                request: $in,
                value: $in.value,
                remaining: null,
                action: Lookup.Action.Continue,
                diagnostic: null
            }}
        />
    </Loop>

    <If on={$ctx.advance.action == Lookup.Action.Ready}>
        <Return
            value={{
                value: $ctx.advance.value,
                diagnostic: null
            }}
        />
    </If>

    <Return
        value={{
            value: null,
            diagnostic: $ctx.advance.diagnostic
        }}
    />
</Module>
