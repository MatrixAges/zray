<Module>
    <Type from="request" as="Optional" />
    <Type from="lookup" as="Lookup" />

    <Args in={Optional.Cursor} out={Optional.Cursor} />

    <Store from="publication" as="publication" />

    <Call
        fn="lookup"
        in={{
            ...$in.request.view,
            mode: $in.request.mode,
            value: $in.value,
            remaining: $in.remaining
        }}
    />

    <If on={$ctx.lookup.action == Lookup.Action.Depth}>
        <Call fn="reject_depth" in={$ctx.lookup.root} />

        <Return
            value={{
                ...$in,
                action: Lookup.Action.Depth,
                diagnostic: $ctx.reject_depth
            }}
        />
    </If>

    <If on={$ctx.lookup.action == Lookup.Action.Register}>
        <Call
            fn="stage"
            in={$ctx.lookup.pick([
                "root",
                "value",
                "remaining"
            ])}
            setter={[$store.publication.effect]}
        />

        <Call fn="read" in={$store.publication.effect} />

        <Return
            value={{
                request: $in.request,
                value: $ctx.read.value,
                remaining: $ctx.read.remaining,
                action: Lookup.Action.Continue,
                diagnostic: null
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            value: $ctx.lookup.value,
            action: $ctx.lookup.action
        }}
    />
</Module>
