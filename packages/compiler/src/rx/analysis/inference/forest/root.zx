import integers from "std:integer"

export type Input = {
    parents: u32[],
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { parents, value } = in

    return loop({
        value,
        parent: parents[integers.widen(value)]
    }, {
        while: state => state.value != state.parent,
        next: state => {
            state.value = state.parent
            state.parent = parents[integers.widen(state.value)]
        },
        return: state => state.value
    })
}
