import integers from "std:integer"
import memory from "memory"

import type { U32Buffer } from "memory"

export type Input = {
    parents: U32Buffer,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    return loop({
        value: in.value,
        parent: memory.readU32(in.parents, integers.widen(in.value))
    }, {
        while: state => state.value != state.parent,
        next: state => {
            state.value = state.parent
            state.parent = memory.readU32(in.parents, integers.widen(state.value))
        },
        return: state => state.value
    })
}
