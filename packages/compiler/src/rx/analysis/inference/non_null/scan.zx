import integers from "std:integer"

import representative from "../forest/borrowed_root"
import { Kind } from "../unification/model"
import observe from "./observe"

import type { State as Known } from "core/integer/map/model"
import type { Graph } from "../optional/model"

export enum Action {
    Wait,
    Unify,
    Register,
    Infer
}

export type Input = {
    graph: Graph,
    parents: u32[],
    sources: u32[],
    values: u32[],
    known: Known,
    infer_source: bool,
    next: u64
}

export type Output = {
    next: u64,
    value: u32,
    action: Action
}

export default function (in: Input): Output {
    const value: u32 = 0

    return loop({
        next: in.next,
        value,
        action: Action.Wait
    }, {
        while: state =>
            state.action == Action.Wait && state.next < in.sources.length,
        next: state => {
            const index = state.next
            const source = in.sources[index]
            const node = representative({
                parents: in.parents,
                value: source
            })
            const kind = in.graph.kinds[integers.widen(node)]

            if (kind == Kind.Unknown) {
                if (in.infer_source) {
                    const target = representative({
                        parents: in.parents,
                        value: in.values[index]
                    })

                    if (
                        in.graph.kinds[integers.widen(target)] != Kind.Unknown
                    ) {
                        state.action = Action.Infer
                    }
                }
            } else {
                const value = observe({
                    graph: in.graph,
                    known: in.known,
                    source,
                    node,
                    kind
                })

                if (value.register) {
                    state.value = value.node
                    state.action = Action.Register
                } else {
                    const left = representative({
                        parents: in.parents,
                        value: in.values[index]
                    })
                    const right = representative({
                        parents: in.parents,
                        value: value.node
                    })

                    if (left != right) {
                        state.value = value.node
                        state.action = Action.Unify
                    }
                }
            }

            state.next += 1
        },
        return: state => state
    })
}
