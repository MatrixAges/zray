import integers from "std:integer"

import representative from "../forest/borrowed_root"
import find from "../known/find"
import { Route as WalkRoute } from "../optional/model"
import walk from "../optional/walk"
import { Kind } from "../unification/model"

import type { U32Buffer } from "zig:compiler_memory"
import type { State as Known } from "core/integer/map/model"
import type { Graph } from "../optional/model"

export enum Action {
    Wait,
    Unify,
    Register,
    Infer
}

export type Input = {
    graph: Graph,
    parents: U32Buffer,
    sources: u32[],
    values: u32[],
    known: Known,
    infer_source: bool,
    next: u64,
    value: u32,
    action: Action
}

export type Output = Input.Pick("next", "value", "action")

export default function (in: Input): Output {
    return loop(in, {
        while: state =>
            state.action == Action.Wait && state.next < state.sources.length,
        next: state => {
            const index = state.next
            const source = state.sources[index]
            const result = walk({
                graph: state.graph,
                parents: state.parents,
                value: source,
                root: source,
                remaining: 1,
                route: WalkRoute.Boundary
            })

            if (result.route != WalkRoute.Open) {
                const operand = match result.route {
                    WalkRoute.Declared => find({
                        known: state.known,
                        type_id: result.value
                    }),
                    _ => result.value
                }

                if (operand == null) {
                    state.value = result.value
                    state.action = Action.Register
                } else {
                    const left = representative({
                        parents: state.parents,
                        value: state.values[index]
                    })
                    const right = representative({
                        parents: state.parents,
                        value: operand
                    })

                    if (left != right) {
                        state.value = operand
                        state.action = Action.Unify
                    }
                }
            } else if (state.infer_source) {
                const value = representative({
                    parents: state.parents,
                    value: state.values[index]
                })

                if (
                    state.graph.kinds[integers.widen(value)] != Kind.Unknown
                ) {
                    state.action = Action.Infer
                }
            }

            state.next += 1
        },
        return: state => ({
            next: state.next,
            value: state.value,
            action: state.action
        })
    })
}
