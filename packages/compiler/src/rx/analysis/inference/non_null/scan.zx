import integers from "std:integer"

import representative from "../forest/borrowed_root"
import guard from "../optional/guard"
import { Action as QueryAction } from "../optional/payload"
import { Kind } from "../unification/model"

import type { State as Known } from "core/integer/map/model"
import type { U32Buffer } from "memory"
import type { Graph } from "../optional/model"

export enum Action {
    Wait,
    Unify,
    Register,
    Infer
}

export type Input = {
    graph: Graph,
    parents: U32Buffer,
    sources: u32[],
    values: u32[],
    known: Known,
    infer_source: bool,
    next: u64
}

export type Output = {
    next: u64,
    value: u32,
    action: Action
}

export default function (in: Input): Output {
    const value: u32 = 0

    return loop({
        next: in.next,
        value,
        action: Action.Wait
    }, {
        while: state =>
            state.action == Action.Wait && state.next < in.sources.length,
        next: state => {
            const index = state.next
            const source = in.sources[index]
            const result = guard({
                graph: in.graph,
                known: in.known,
                parents: in.parents,
                value: source
            })
            const operand = result.value

            if (operand != null) {
                if (result.action == QueryAction.Register) {
                    state.value = operand
                    state.action = Action.Register
                } else {
                    const left = representative({
                        parents: in.parents,
                        value: in.values[index]
                    })
                    const right = representative({
                        parents: in.parents,
                        value: operand
                    })

                    if (left != right) {
                        state.value = operand
                        state.action = Action.Unify
                    }
                }
            } else if (in.infer_source) {
                const value = representative({
                    parents: in.parents,
                    value: in.values[index]
                })

                if (
                    in.graph.kinds[integers.widen(value)] != Kind.Unknown
                ) {
                    state.action = Action.Infer
                }
            }

            state.next += 1
        },
        return: state => state
    })
}
