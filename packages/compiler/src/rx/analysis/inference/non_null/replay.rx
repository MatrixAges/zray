<Module>
    <Type from="model" as="NonNull" />

    <Args in={NonNull.Replay} out={void} />

    <Loop on={$in.next < $in.request.view.sources.length}>
        <Call
            module="advance"
            in={{
                request: $in,
                next: 0
            }}
        />
    </Loop>
</Module>
