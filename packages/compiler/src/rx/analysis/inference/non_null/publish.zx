import integers from "std:integer"
import memory from "memory"

import type { Span } from "../../../syntax/model"
import type { ProjectionRows } from "./model"

export type Input = {
    rows: ProjectionRows,
    source: u32,
    node: u64,
    span: Span
}

export type Output = u32

export default function (in: Input): Output {
    const { rows, source, span } = in

    const row = rows.position
    const end = row + 1
    const value = integers.narrow(in.node)

    memory.writeU32(rows.sources, row, source)
    memory.writeU32(rows.values, row, value)
    memory.fillSourceSpanRange(rows.spans, row, end, span.start, span.end)
    memory.writeIndex(rows.length, 0, end)

    return value
}
