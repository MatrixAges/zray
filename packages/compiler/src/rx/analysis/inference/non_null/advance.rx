<Module>
    <Type from="model" as="NonNull" />
    <Type from="scan" as="Scan" />

    <Args in={NonNull.Cursor} out={NonNull.Cursor} />

    <Call
        fn="scan"
        in={{
            ...$in.request.view.pick([
                "graph",
                "parents",
                "sources",
                "values",
                "known"
            ]),
            infer_source: $in.request.infer_source,
            next: $in.next
        }}
    />

    <Switch on={$ctx.scan.action}>
        <Case value={Scan.Action.Infer}>
            <Call
                fn="host.reserveNonNullSource"
                in={[
                    $in.request.view.frame,
                    $ctx.scan.next - 1,
                    $in.request.view.values[$ctx.scan.next - 1]
                ]}
            />

            <Call
                fn="host.mergeNonNullProjection"
                in={[
                    $in.request.view.frame,
                    $ctx.scan.next - 1,
                    $in.request.view.sources[$ctx.scan.next - 1],
                    $ctx.reserveNonNullSource
                ]}
            />
        </Case>

        <Case value={Scan.Action.Register}>
            <Call
                fn="host.registerNonNullPayload"
                in={[
                    $in.request.view.frame,
                    $ctx.scan.next - 1,
                    $ctx.scan.value
                ]}
            />

            <Call
                fn="host.mergeNonNullProjection"
                in={[
                    $in.request.view.frame,
                    $ctx.scan.next - 1,
                    $in.request.view.values[$ctx.scan.next - 1],
                    $ctx.registerNonNullPayload
                ]}
            />
        </Case>

        <Case value={Scan.Action.Wait}>
            <Return
                value={{
                    ...$in,
                    next: $in.request.view.sources.length
                }}
            />
        </Case>

        <Default>
            <Call
                fn="host.mergeNonNullProjection"
                in={[
                    $in.request.view.frame,
                    $ctx.scan.next - 1,
                    $in.request.view.values[$ctx.scan.next - 1],
                    $ctx.scan.value
                ]}
            />
        </Default>
    </Switch>

    <Call fn="host.refreshNonNullTopology" in={$in.request.view.frame} />

    <Return
        value={{
            ...$in,
            next: $ctx.scan.next
        }}
    />
</Module>
