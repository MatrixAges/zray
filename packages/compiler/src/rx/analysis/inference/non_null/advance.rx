<Module>
    <Type from="model" as="NonNull" />
    <Type from="scan" as="Scan" />
    <Type from="../solve/replay_effect" as="Effect" />

    <Args in={NonNull.Cursor} out={NonNull.Cursor} />

    <Store from="../solve/replay" as="replay" />

    <Call
        fn="scan"
        in={{
            ...$in.request.view.pick([
                "graph",
                "parents",
                "sources",
                "values",
                "known"
            ]),
            infer_source: $in.request.infer_source,
            next: $in.next
        }}
    />

    <Switch on={$ctx.scan.action}>
        <Case value={Scan.Action.Infer}>
            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.ReserveNonNull,
                    row: $ctx.scan.next - 1,
                    right: $in.request.view.values[$ctx.scan.next - 1]
                }}
                setter={[$store.replay.effect]}
            />

            <Call fn="../solve/read_replay_id" in={$store.replay.effect} />

            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.MergeNonNull,
                    row: $ctx.scan.next - 1,
                    left: $in.request.view.sources[$ctx.scan.next - 1],
                    right: $ctx.read_replay_id
                }}
                setter={[$store.replay.effect]}
            />
        </Case>

        <Case value={Scan.Action.Register}>
            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.RegisterNonNull,
                    row: $ctx.scan.next - 1,
                    right: $ctx.scan.value
                }}
                setter={[$store.replay.effect]}
            />

            <Call fn="../solve/read_replay_id" in={$store.replay.effect} />

            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.MergeNonNull,
                    row: $ctx.scan.next - 1,
                    left: $in.request.view.values[$ctx.scan.next - 1],
                    right: $ctx.read_replay_id
                }}
                setter={[$store.replay.effect]}
            />
        </Case>

        <Case value={Scan.Action.Wait}>
            <Return
                value={{
                    ...$in,
                    next: $in.request.view.sources.length
                }}
            />
        </Case>

        <Default>
            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.MergeNonNull,
                    row: $ctx.scan.next - 1,
                    left: $in.request.view.values[$ctx.scan.next - 1],
                    right: $ctx.scan.value
                }}
                setter={[$store.replay.effect]}
            />
        </Default>
    </Switch>

    <Call
        fn="../solve/stage_replay"
        in={{
            step: Effect.Step.RefreshNonNull
        }}
        setter={[$store.replay.effect]}
    />

    <Return
        value={{
            ...$in,
            next: $ctx.scan.next
        }}
    />
</Module>
