import type { IndexBuffer, SourceSpanBuffer, U32Buffer, U64Buffer } from "memory"
import type { NonNullReplay } from "rx_project_host"
import type { Input as Append } from "../nodes/append"
import type { Input as Scan } from "./scan"

export type View = Scan.Omit("next", "infer_source") & {
    frame: NonNullReplay,
    node: Append,
    revision: U64Buffer
}

export type Replay = {
    view: View,
    infer_source: bool
}

export type Cursor = {
    request: Replay,
    next: u64
}

export type ProjectionRows = {
    sources: U32Buffer,
    values: U32Buffer,
    spans: SourceSpanBuffer,
    length: IndexBuffer,
    position: u64
}
