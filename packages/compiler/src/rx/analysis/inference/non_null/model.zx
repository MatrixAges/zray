import type { NonNullReplay } from "rx_project_host"
import type { Input as Scan } from "./scan"

export type View = Scan.Omit("next", "infer_source") & {
    frame: NonNullReplay
}

export type Replay = {
    view: View,
    infer_source: bool
}

export type Cursor = {
    request: Replay,
    next: u64
}
