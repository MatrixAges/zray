import bytes from "std:bytes"
import memory from "std:memory"

import type { U32Buffer } from "std:memory"
import type { Field } from "../../../../zx/frontend/parser/expressions/state/model"

export type Input = {
    source: u8[],
    fields: Field[],
    order: u64[],
    target: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const fields = in.fields
    const order = in.order
    const source = in.source

    const scan = loop({
        cursor: order.length,
        stopped: false
    }, {
        while: state => state.cursor != 0 && !state.stopped,
        next: state => {
            state.cursor -= 1

            const field = fields[order[state.cursor]]

            if (field.spread) {
                state.stopped = true
            } else {
                const span = field.name
                const length = span.end - span.start
                const name = source.splice(span.start, length, [])[1]

                const duplicate = loop({
                    index: state.cursor + 1,
                    found: false
                }, {
                    while: suffix => suffix.index < order.length && !suffix.found,
                    next: suffix => {
                        const next = fields[order[suffix.index]].name

                        suffix.found =
                            next.end - next.start == length &&
                            bytes.startsWith(source, next.start, name)
                        suffix.index += 1
                    },
                    return: suffix => suffix.found
                })

                if (!duplicate) {
                    memory.writeU32(in.target, state.cursor, 1)
                }
            }
        }
    })
}
