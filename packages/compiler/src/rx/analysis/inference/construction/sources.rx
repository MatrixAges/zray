<Module>
    <Type from="sources" as="Sources" />

    <Args in={Sources.Request} out={Sources.Step} />

    <Call
        fn="named"
        in={$in.pick([
            "names",
            "keys",
            "initial",
            "first"
        ])}
    />

    <Call
        fn="sources"
        in={{
            ...$in.omit([
                "keys",
                "initial",
                "first"
            ]),
            row: $ctx.named.row
        }}
    />

    <Return
        value={{
            ...$ctx.sources,
            keys: $ctx.named.keys
        }}
    />
</Module>
