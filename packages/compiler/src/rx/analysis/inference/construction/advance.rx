<Module>
    <Type from="../object_closure/replay" as="Objects" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Objects.ConstructionCursor} out={Objects.ConstructionCursor} />

    <Store from="../object_closure/object" as="object" />

    <Call
        fn="queue"
        in={{
            ...$in.request.view.constructions,
            first: $in.first
        }}
    />

    <If on={$ctx.queue.position == $in.request.view.constructions.results.length}>
        <Return
            value={{
                request: $in.request,
                first: $ctx.queue.position
            }}
        />
    </If>

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.OpenConstruction,
            row: $ctx.queue.position,
            root: $ctx.queue.root,
            final: $in.request.final
        }}
        setter={[$store.object.effect]}
    />

    <Call module="apply" in={$in.request.view.construction} />

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.FinishRow
        }}
        setter={[$store.object.effect]}
    />

    <Return
        value={{
            request: $in.request,
            first: $ctx.queue.position + 1
        }}
    />
</Module>
