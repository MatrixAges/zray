import integers from "std:integer"
import memory from "memory"

import collectKeys from "./collect_keys"

import type {
    StringListBuffer,
    U8Buffer,
    U32ListBuffer,
    U64Buffer
} from "memory"

export type Columns = {
    fields: StringListBuffer,
    values: U32ListBuffer,
    roots: U64Buffer,
    open: U8Buffer,
    aliases: U8Buffer
}

export type Input = {
    keys: string[],
    names: string[],
    values: u32[],
    columns: Columns,
    row: u64,
    root: u32,
    open: bool,
    aliases: bool
}

export type Output = string[]

export default function (in: Input): Output {
    const { keys, names, columns, row, root, open, aliases } = in

    memory.writeU64(columns.roots, row, integers.widen(root))
    memory.writeU8(columns.open, row, open ? 1 : 0)
    memory.writeU8(columns.aliases, row, aliases ? 1 : 0)

    if (aliases) {
        memory.writeStringList(columns.fields, row, [])
        memory.writeU32List(columns.values, row, [])
    } else {
        memory.writeStringList(columns.fields, row, names)
        memory.writeU32List(columns.values, row, in.values)
    }

    return collectKeys({
        keys,
        additions: names
    })
}
