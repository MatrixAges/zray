import shape from "../fields/shape"
import { Mode } from "../fields/view"

import type { Input as FieldShape } from "../fields/shape"

export type Input = FieldShape

export type Output = bool

export default function (in: Input): Output {
    const view = shape(in)
    const invalid = view.mode == Mode.Invalid || view.mode == Mode.InvalidDeclared

    return invalid || !view.empty
}
