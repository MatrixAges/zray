import type { ObjectConstructionRow } from "rx_project_host"
import type { Context } from "../../object_closure/workflow"
import type { Columns } from "../publish"
import type { Request as Sources, Output as Spread, Step } from "../sources"

export type Request = {
    frame: ObjectConstructionRow,
    scan: Sources.Omit("first", "keys"),
    columns: Columns,
    members: Members,
    readiness: Context
}

export type Members = {
    names: string[],
    values: u32[]
}

export type Cursor = Step & {
    request: Request
}

export type Readiness = Spread.Pick("row", "root", "action") & {
    frame: ObjectConstructionRow,
    readiness: Context
}
