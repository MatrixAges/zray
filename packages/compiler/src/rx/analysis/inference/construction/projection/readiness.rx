<Module>
    <Type from="model" as="Projection" />
    <Type from="../spread" as="Spread" />
    <Type from="../diagnostic" as="Diagnostic" />

    <Args in={Projection.Readiness} out={bool} />

    <Switch on={$in.action}>
        <Case value={Spread.Action.Closed}>
            <Return value={true} />
        </Case>

        <Case value={Spread.Action.Open}>
            <Return value={false} />
        </Case>

        <Case value={Spread.Action.Unknown}>
            <Call
                module="../report"
                in={{
                    frame: $in.frame,
                    row: $in.row,
                    issue: Diagnostic.Issue.UnknownSpread
                }}
            />

            <Return value={false} />
        </Case>

        <Case value={Spread.Action.Invalid}>
            <Call
                module="../report"
                in={{
                    frame: $in.frame,
                    row: $in.row,
                    issue: Diagnostic.Issue.InvalidSpread
                }}
            />

            <Return value={false} />
        </Case>

        <Case value={Spread.Action.InvalidDeclared}>
            <Call
                module="../report"
                in={{
                    frame: $in.frame,
                    row: $in.row,
                    issue: Diagnostic.Issue.InvalidDeclared
                }}
            />

            <Return value={false} />
        </Case>
    </Switch>

    <Call
        module="../../object_closure/spread"
        in={{
            context: $in.readiness,
            root: $in.root
        }}
    />

    <If
        on={$in.action == Spread.Action.ProveRequired &&
            !$ctx.spread}
    >
        <Call
            module="../report"
            in={{
                frame: $in.frame,
                row: $in.row,
                issue: Diagnostic.Issue.UnknownSpread
            }}
        />
    </If>

    <Return value={$ctx.spread} />
</Module>
