<Module>
    <Type from="model" as="Projection" />
    <Type from="../../fields/view" as="Fields" />
    <Type from="../../object_closure/effect" as="ObjectEffect" />

    <Args in={Projection.Cursor} out={Projection.Cursor} />

    <Store from="../../object_closure/object" as="object" />

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.BindSpread,
            root: $in.root,
            declared: $in.mode == Fields.Mode.Declared,
            inferred: $in.mode == Fields.Mode.Inferred
        }}
        setter={[$store.object.effect]}
    />

    <Call
        module="readiness"
        in={{

            readiness: $in.request.readiness,
            ...$in.pick([
                "row",
                "root",
                "action"
            ])
        }}
    />

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.CommitSpread,
            row: $in.row,
            root: $in.root,
            open: !$ctx.readiness,
            aliases: $in.root == $in.request.scan.result
        }}
        setter={[$store.object.effect]}
    />

    <Call
        fn="../collect_keys"
        in={{
            keys: $in.keys,
            additions: $in.request.members.names
        }}
    />

    <If on={$in.row + 1 == $in.request.scan.names.length}>
        <Return
            value={{
                ...$in,
                row: $in.row + 1,
                keys: $ctx.collect_keys
            }}
        />
    </If>

    <Call
        module="../sources"
        in={{
            ...$in.request.scan,
            keys: $ctx.collect_keys,
            first: $in.row + 1
        }}
    />

    <Return
        value={{
            request: $in.request,
            ...$ctx.sources
        }}
    />
</Module>
