<Module>
    <Type from="model" as="Projection" />
    <Type from="../../fields/view" as="Fields" />

    <Args in={Projection.Cursor} out={Projection.Cursor} />

    <Call
        fn="host.bindObjectSpreadFields"
        in={[
            $in.request.frame,
            $in.root,
            $in.mode == Fields.Mode.Declared,
            $in.mode == Fields.Mode.Inferred
        ]}
    />

    <Call
        module="readiness"
        in={{
            frame: $in.request.frame,
            readiness: $in.request.readiness,
            ...$in.pick([
                "row",
                "root",
                "action"
            ])
        }}
    />

    <Call
        fn="host.commitObjectSpread"
        in={[
            $in.request.frame,
            $in.row,
            $in.root,
            !$ctx.readiness,
            $in.root == $in.request.scan.result
        ]}
    />

    <Call
        fn="../collect_keys"
        in={{
            keys: $in.keys,
            additions: $in.request.members.names
        }}
    />

    <If on={$in.row + 1 == $in.request.scan.names.length}>
        <Return
            value={{
                ...$in,
                row: $in.row + 1,
                keys: $ctx.collect_keys
            }}
        />
    </If>

    <Call
        module="../sources"
        in={{
            ...$in.request.scan,
            keys: $ctx.collect_keys,
            first: $in.row + 1
        }}
    />

    <Return
        value={{
            request: $in.request,
            ...$ctx.sources
        }}
    />
</Module>
