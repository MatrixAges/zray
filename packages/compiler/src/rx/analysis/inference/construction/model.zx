import type { Kind as Shape } from "../unification/model"

export enum Kind {
    Absent,
    Named,
    Open,
    AmbiguousNamed,
    AmbiguousOpen
}

export enum Route {
    Skip,
    Register,
    Bind,
    InferRequired,
    InferConstrained,
    Ambiguous,
    RegisterAmbiguous,
    MissingRequired
}

export enum Receiver {
    Node,
    Type,
    Target
}

export type Parts = {
    explicit: string?[],
    explicit_values: u32[],
    fields: string[][],
    values: u32[][],
    roots: u64[],
    open: bool[],
    aliases: bool[],
    shapes: Shape[]
}

export type Candidate = {
    part: u64,
    value: u32,
    receiver: Receiver,
    kind: Kind
}

export type Candidates = {
    parts: u64[],
    values: u32[],
    receivers: Receiver[],
    routes: Route[]
}

export type Policy = {
    open: Route,
    absent: Route,
    ambiguous: Route,
    ambiguous_named: Route
}

export type Input = {
    parts: Parts,
    names: string[],
    final: bool
}

export type Output = Candidates
