import representative from "../forest/borrowed_root"
import requiresReplay from "./requires_replay"

import type { U32Buffer } from "memory"
import type { Columns } from "../fields/shape"

export type Input = {
    columns: Columns,
    parents: U32Buffer,
    results: u32[],
    parts: u64[],
    first: u64
}

export type Output = {
    position: u64,
    root: u32
}

export default function (in: Input): Output {
    const initial_root: u32 = 0

    const { columns, parents, results, parts } = in

    return loop({
        position: in.first,
        root: initial_root,
        found: false
    }, {
        while: state => state.position < results.length && !state.found,
        next: state => {
            const row = state.position
            const root = representative({
                parents,
                value: results[row]
            })
            const needs_replay = parts[row] != 0 || requiresReplay({
                columns,
                root
            })

            if (needs_replay) {
                state.root = root
                state.found = true
            } else {
                state.position += 1
            }
        },
        return: state => ({
            position: state.position,
            root: state.root
        })
    })
}
