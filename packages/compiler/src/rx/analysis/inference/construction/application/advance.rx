<Module>
    <Type from="model" as="Construction" />
    <Type from="../application" as="Application" />
    <Type from="../diagnostic" as="Diagnostic" />
    <Type from="../../object_closure/effect" as="ObjectEffect" />

    <Args in={Construction.Cursor} out={Construction.Cursor} />

    <Store from="../../object_closure/object" as="object" />

    <Call
        fn="../replay"
        in={{
            names: $in.request.names,
            plan: $in.request.pick([
                "parts",
                "values",
                "routes",
                "receivers"
            ]),
            ...$in.request.field_view.omit(["site"]),
            start: $in.row
        }}
    />

    <If on={$ctx.replay.row == $in.request.names.length}>
        <Return
            value={{
                request: $in.request,
                row: $ctx.replay.row
            }}
        />
    </If>

    <Call
        module="../../fields/target"
        in={{
            site: $in.request.field_view.site,
            name: $in.request.names[$ctx.replay.row],
            choice: $ctx.replay.target
        }}
    />

    <Call
        module="source"
        in={{

            part: $in.request.parts[$ctx.replay.row],
            target: $ctx.target,
            source: $ctx.replay.source,
            register_type: $ctx.replay.register_type
        }}
    />

    <Switch on={$ctx.replay.effect}>
        <Case value={Application.Effect.Bind}>
            <Call
                fn="../../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.ExpectField,
                    source: $ctx.source,
                    target: $ctx.target
                }}
                setter={[$store.object.effect]}
            />
        </Case>

        <Case value={Application.Effect.Ambiguous}>
            <Call
                module="../report"
                in={{

                    row: null,
                    issue: Diagnostic.Issue.AmbiguousField
                }}
            />
        </Case>

        <Case value={Application.Effect.Require}>
            <Call
                module="required"
                in={{

                    part: $in.request.parts[$ctx.replay.row],
                    name: $in.request.names[$ctx.replay.row],
                    target: $ctx.target,
                    route: $in.request.routes[$ctx.replay.row],
                    shape: $in.request.shape
                }}
            />
        </Case>
    </Switch>

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.RefreshFields
        }}
        setter={[$store.object.effect]}
    />

    <Return
        value={{
            request: $in.request,
            row: $ctx.replay.row + 1
        }}
    />
</Module>
