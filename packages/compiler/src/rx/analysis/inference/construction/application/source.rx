<Module>
    <Type from="model" as="Construction" />

    <Args in={Construction.Source} out={u32} />

    <If on={$in.register_type != null}>
        <Call
            fn="host.registerConstructedSource"
            in={[
                $in.frame,
                $in.part,
                $in.register_type
            ]}
        />

        <Return value={$ctx.registerConstructedSource} />
    </If>

    <Return value={$in.source ?? $in.target} />
</Module>
