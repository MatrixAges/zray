<Module>
    <Type from="model" as="Construction" />
    <Type from="../activate" as="Activation" />
    <Type from="../diagnostic" as="Diagnostic" />
    <Type from="../../object_closure/effect" as="ObjectEffect" />

    <Args in={Construction.Required} out={void} />

    <Store from="../../object_closure/object" as="object" />

    <Call
        fn="../../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.DescribeTarget,
            target: $in.target
        }}
        setter={[$store.object.effect]}
    />

    <Call
        fn="../activate"
        in={{
            ...$in.shape,
            route: $in.route
        }}
    />

    <Switch on={$ctx.activate}>
        <Case value={Activation.Effect.Infer}>
            <Call
                fn="../../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.InferField,
                    row: $in.part,
                    name: $in.name,
                    target: $in.target
                }}
                setter={[$store.object.effect]}
            />
        </Case>

        <Case value={Activation.Effect.Missing}>
            <Call
                module="../report"
                in={{

                    row: null,
                    issue: Diagnostic.Issue.MissingField
                }}
            />
        </Case>
    </Switch>
</Module>
