import { kind_optional } from "core/type_table/const"

import { Kind } from "../unification/model"
import { Route } from "./model"

import type { Kind as Shape } from "../unification/model"
import type { Route as Resolution } from "./model"

export enum Effect {
    Skip,
    Infer,
    Missing
}

export type Input = {
    route: Resolution,
    kind: Shape,
    type_kind: u8,
    restricted: bool
}

export type Output = Effect

export default function (in: Input): Output {
    const optional = in.kind == Kind.Optional ||
        (in.kind == Kind.Known && in.type_kind == kind_optional)

    if (optional) {
        return Effect.Skip
    }

    const unrestricted = in.kind == Kind.Unknown && !in.restricted

    return match in.route {
        Route.InferConstrained => unrestricted ? Effect.Skip : Effect.Infer,
        Route.InferRequired => Effect.Infer,
        Route.MissingRequired => Effect.Missing,
        _ => Effect.Skip
    }
}
