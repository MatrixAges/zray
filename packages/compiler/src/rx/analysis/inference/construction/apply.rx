<Module>
    <Type from="workflow" as="Construction" />
    <Type from="../fields/view" as="Fields" />
    <Type from="diagnostic" as="Diagnostic" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Construction.Row} out={void} />

    <Store from="../object_closure/object" as="object" />

    <Switch on={$in.mode}>
        <Case value={Fields.Mode.Invalid}>
            <Call
                module="report"
                in={{

                    row: null,
                    issue: Diagnostic.Issue.InvalidSpread
                }}
            />
        </Case>

        <Case value={Fields.Mode.InvalidDeclared}>
            <Call
                module="report"
                in={{

                    row: null,
                    issue: Diagnostic.Issue.InvalidDeclared
                }}
            />
        </Case>
    </Switch>

    <Call module="projection/run" in={$in.projection} />

    <Call
        module="resolve"
        in={{
            parts: $in.parts,
            keys: $ctx.run,
            final: $in.projection.scan.final
        }}
    />

    <If on={$ctx.resolve.names.length != 0}>
        <Call
            fn="../object_closure/stage"
            in={{
                object_step: ObjectEffect.Step.RefreshFields
            }}
            setter={[$store.object.effect]}
        />

        <Call
            module="application/run"
            in={{

                field_view: $in.field_view,
                shape: $in.shape,
                ...$ctx.resolve
            }}
        />
    </If>
</Module>
