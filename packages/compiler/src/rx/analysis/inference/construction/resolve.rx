<Module>
    <Type from="model" as="Construction" />

    <Args in={Construction.Input} out={Construction.Output} />

    <Call fn="keys" in={$in.keys} />
    <Call fn="admit" in={$in.final} />

    <Call
        fn="search_all"
        in={{
            parts: $in.parts,
            names: $ctx.keys,
            policy: $ctx.admit
        }}
    />

    <Return
        value={{
            ...$ctx.search_all,
            names: $ctx.keys
        }}
    />
</Module>
