<Module>
    <Type from="model" as="Construction" />

    <Args in={Construction.Input} out={Construction.Output} />

    <If on={$in.keys.length == 0}>
        <Return
            value={{
                parts: [],
                values: [],
                receivers: [],
                routes: [],
                names: $in.keys
            }}
        />
    </If>

    <Call fn="admit" in={$in.final} />

    <Call
        fn="search_all"
        in={{
            parts: $in.parts,
            names: $in.keys,
            policy: $ctx.admit
        }}
    />

    <Return
        value={{
            ...$ctx.search_all,
            names: $in.keys
        }}
    />
</Module>
