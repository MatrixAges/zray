import { Route } from "./model"

import type { Policy } from "./model"

export type Input = bool

export type Output = Policy

export default function (in: Input): Output {
    return {
        ambiguous: in ? Route.Ambiguous : Route.Skip,
        ambiguous_named: in ? Route.RegisterAmbiguous : Route.Register,
        open: in ? Route.InferRequired : Route.InferConstrained,
        absent: in ? Route.MissingRequired : Route.Skip
    }
}
