import collectKeys from "./collect_keys"

export type Input = {
    names: string?[],
    keys: string[],
    initial: string[],
    first: u64
}

export type Output = {
    row: u64,
    keys: string[]
}

export default function (in: Input): Output {
    const { names } = in

    const initial_keys = match {
        in.first == 0 => collectKeys({
            keys: in.keys,
            additions: in.initial
        }),
        _ => in.keys
    }

    return loop({
        row: in.first,
        keys: initial_keys,
        stopped: false
    }, {
        while: state => state.row < names.length && !state.stopped,
        next: state => {
            const name = names[state.row]

            if (name == null) {
                state.stopped = true
            } else {
                state.keys = collectKeys({
                    keys: state.keys,
                    additions: [name]
                })

                state.row += 1
            }
        },
        return: state => ({
            row: state.row,
            keys: state.keys
        })
    })
}
