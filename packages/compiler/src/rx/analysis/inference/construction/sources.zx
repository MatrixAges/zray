import integers from "std:integer"

import classify from "../fields/view"
import { Mode } from "../fields/view"
import representative from "../forest/borrowed_root"
import { Kind } from "../unification/model"
import spread from "./spread"
import { Action } from "./spread"

import type { U32Buffer } from "std:memory"
import type { Mode as ObjectMode } from "../fields/view"
import type { Kind as Shape } from "../unification/model"
import type { Action as SpreadAction } from "./spread"

export type Input = {
    names: string?[],
    values: u32[],
    parents: U32Buffer,
    kinds: Shape[],
    arguments: u32[],
    members: u32[][],
    type_kinds: u8[],
    type_sizes: u32[],
    result: u32,
    start: u64,
    final: bool
}

export type Output = {
    row: u64,
    root: u32,
    mode: ObjectMode,
    action: SpreadAction
}

export default function (in: Input): Output {
    const row = loop(in.start, {
        while: position =>
            position < in.names.length && in.names[position] != null,
        next: position => {
            position += 1
        }
    })

    if (row == in.names.length) {
        return {
            row,
            root: 0,
            mode: Mode.Unknown,
            action: Action.Open
        }
    }

    const root = representative({
        parents: in.parents,
        value: in.values[row]
    })

    const index = integers.widen(root)
    const argument = integers.widen(in.arguments[index])
    const kind = in.kinds[index]

    const mode = classify({
        kind,
        type_kind: kind == Kind.Known ? in.type_kinds[argument] : 0
    })

    const empty = match mode {
        Mode.Inferred => in.members[index].length == 0,
        Mode.Declared => in.type_sizes[argument] == 0,
        _ => true
    }

    const action = spread({
        mode,
        final: in.final,
        aliases: root == in.result,
        empty
    })

    return {
        row,
        root,
        mode,
        action
    }
}
