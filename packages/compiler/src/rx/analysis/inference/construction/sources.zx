import shape from "../fields/shape"
import { Mode } from "../fields/view"
import representative from "../forest/borrowed_root"
import spread from "./spread"
import { Action } from "./spread"

import type { U32Buffer } from "zig:compiler_memory"
import type { StringSet } from "zig:string"
import type { Columns } from "../fields/shape"
import type { Mode as ObjectMode } from "../fields/view"
import type { Action as SpreadAction } from "./spread"

export type Input = {
    names: string?[],
    values: u32[],
    parents: U32Buffer,
    columns: Columns,
    result: u32,
    row: u64,
    final: bool
}

export type Request = Input.Omit("row") & {
    keys: StringSet,
    initial: string[],
    first: u64
}

export type Output = {
    row: u64,
    root: u32,
    mode: ObjectMode,
    action: SpreadAction
}

export default function (in: Input): Output {
    const { row } = in

    if (row == in.names.length) {
        return {
            row,
            root: 0,
            mode: Mode.Unknown,
            action: Action.Open
        }
    }

    const root = representative({
        parents: in.parents,
        value: in.values[row]
    })

    const { mode, empty } = shape({
        columns: in.columns,
        root
    })

    const action = spread({
        mode,
        final: in.final,
        aliases: root == in.result,
        empty
    })

    return {
        row,
        root,
        mode,
        action
    }
}
