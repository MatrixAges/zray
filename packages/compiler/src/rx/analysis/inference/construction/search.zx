import { Kind as Shape } from "../unification/model"
import { Kind, Receiver } from "./model"

import type { Candidate, Parts } from "./model"

export type Input = {
    parts: Parts,
    name: string
}

export type Output = Candidate

export default function (in: Input): Output {
    const missing: u32 = 0

    return loop({
        cursor: in.parts.explicit.length,
        part: 0,
        value: missing,
        receiver: Receiver.Node,
        kind: Kind.Absent,
        done: false
    }, {
        while: state => !state.done && state.cursor != 0,
        next: state => {
            const part = state.cursor - 1
            const explicit = in.parts.explicit[part]
            const aliases = explicit == null && in.parts.aliases[part]

            const names: string[] = match {
                explicit == null => in.parts.fields[part],
                _ => []
            }

            const field = loop({
                index: 0
            }, {
                while: position =>
                    position.index < names.length &&
                    names[position.index] != in.name,
                next: position => {
                    position.index += 1
                },
                return: position => position.index
            })

            const listed = field < names.length
            const named = explicit == in.name || aliases || listed

            if (named) {
                const clear = state.kind == Kind.Absent

                state.part = part
                state.kind = clear ? Kind.Named : Kind.AmbiguousNamed

                if (explicit != null) {
                    state.receiver = Receiver.Node
                    state.value = in.parts.explicit_values[part]
                } else if (aliases) {
                    state.receiver = Receiver.Target
                } else {
                    const shape = in.parts.shapes[in.parts.roots[part]]

                    state.receiver = shape == Shape.Known ? Receiver.Type : Receiver.Node
                    state.value = in.parts.values[part][field]
                }

                state.done = true
            } else if (explicit == null && in.parts.open[part]) {
                const previous = state.kind != Kind.Absent
                const root = in.parts.roots[part]
                const repeated = previous && root == in.parts.roots[state.part]

                if (!repeated) {
                    state.kind = previous ? Kind.AmbiguousOpen : Kind.Open
                    state.part = part
                }
            }

            state.cursor -= 1
        },
        return: state => ({
            part: state.part,
            value: state.value,
            receiver: state.receiver,
            kind: state.kind
        })
    })
}
