    InferInterpolations,
    StringResult,
    MatchResult,
    InferSubject,
    InferArms,
    InferFallback,
    InferTarget,
    InferPosition,
    RegisterIndex,
    ReadKeys,
    InferReceiver,
    RegisterSelection,
    ReserveParts,
