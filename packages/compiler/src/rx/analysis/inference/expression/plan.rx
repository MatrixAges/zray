<Module>
    <Type from="model" as="Constraints" />

    <Args in={Constraints.Input} out={Constraints.Output} />

    <Switch on={$in}>
        <Case value={Constraints.Form.BoundValue}>
            <Return
                value={[
                    Constraints.Step.BoundValue,
                    Constraints.Step.RefineValue,
                    Constraints.Step.RequireValue,
                    Constraints.Step.ExpectResult
                ]}
            />
        </Case>

        <Case value={Constraints.Form.UnboundValue}>
            <Return
                value={[
                    Constraints.Step.TypeHint,
                    Constraints.Step.InferValue,
                    Constraints.Step.RefineValue,
                    Constraints.Step.ExpectResult
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Template}>
            <Return
                value={[
                    Constraints.Step.InferInterpolations,
                    Constraints.Step.StringResult
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Match}>
            <Return
                value={[
                    Constraints.Step.MatchResult,
                    Constraints.Step.InferSubject,
                    Constraints.Step.InferArms,
                    Constraints.Step.InferFallback
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Index}>
            <Return
                value={[
                    Constraints.Step.InferTarget,
                    Constraints.Step.InferPosition,
                    Constraints.Step.RegisterIndex
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Selection}>
            <Return
                value={[
                    Constraints.Step.ReadKeys,
                    Constraints.Step.InferReceiver,
                    Constraints.Step.RegisterSelection
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Object}>
            <Return
                value={[
                    Constraints.Step.ReserveParts,
                    Constraints.Step.PlanFieldHints,
                    Constraints.Step.InferFields,
                    Constraints.Step.ObjectResult,
                    Constraints.Step.ExpectResult,
                    Constraints.Step.RegisterObject
                ]}
            />
        </Case>

        <Case value={Constraints.Form.Sequence}>
            <Return
                value={[
                    Constraints.Step.SequenceResult,
                    Constraints.Step.ExpectResult,
                    Constraints.Step.InferElements,
                    Constraints.Step.RegisterSequence
                ]}
            />
        </Case>
    </Switch>
</Module>
