import type { ExprTree } from "../../../../zx/frontend/parser/expressions/state/model"

export enum Kind {
    Template,
    Match
}

export type Input = {
    tree: ExprTree,
    order: u64[],
    first: u64,
    end: u64,
    kind: Kind
}

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    return loop({
        next: in.first,
        values: empty
    }, {
        while: state => state.next < in.end,
        next: state => {
            const row = in.order[state.next]

            if (in.kind == Kind.Template) {
                const part = in.tree.parts[row]

                if (part.expression) {
                    state.values = state.values.push(part.value)[0]
                }
            } else {
                const arm = in.tree.arms[row]

                state.values = state.values.push(arm.condition)[0]
                state.values = state.values.push(arm.result)[0]
            }

            state.next += 1
        },
        return: state => state.values
    })
}
