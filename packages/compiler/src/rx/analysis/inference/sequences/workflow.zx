import type { Diagnostic, SpanSource } from "../projections/site"
import type { ReplayInput } from "./model"

export type Replay = ReplayInput.Omit("start") & {
    spans: SpanSource
}

export type Cursor = {
    request: Replay,
    row: u64,
    diagnostic?: Diagnostic
}

export type List = {
    row: u64,
    argument: u32,
    declared: bool
}

export type Failure = {
    spans: SpanSource,
    row: u64,
    length: bool
}
