<Module>
    <Type from="model" as="Shape" />

    <Args in={Shape.IndexInput} out={Shape.IndexPlan} />

    <Call
        fn="target"
        in={{
            graph: $in.graph,
            root: $in.root
        }}
    />

    <Call
        fn="index_plan"
        in={{
            graph: $in.graph,
            root: $in.root,
            position: $in.position,
            target: $ctx.target
        }}
    />

    <Return value={$ctx.index_plan} />
</Module>
