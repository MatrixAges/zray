<Module>
    <Type from="model" as="Sequences" />
    <Type from="workflow" as="Replay" />
    <Type from="../solve/replay_effect" as="Effect" />
    <Type from="../projections/effect" as="ProjectionEffect" />

    <Args in={Replay.Cursor} out={Replay.Cursor} />

    <Store from="../projections/publication" as="projection" />
    <Store from="../solve/replay" as="replay" />

    <Call
        fn="replay"
        in={{
            ...$in.request.omit([
                "spans"
            ]),
            start: $in.row
        }}
    />

    <Switch on={$ctx.replay.plan.route}>
        <Case value={Sequences.SequenceRoute.Wait}>
            <Return
                value={{
                    ...$in,
                    row: $in.request.values.length
                }}
            />
        </Case>

        <Case value={Sequences.SequenceRoute.List}>
            <Call
                module="list"
                in={{
                    row: $ctx.replay.row,
                    argument: $ctx.replay.plan.argument,
                    declared: $ctx.replay.plan.declared
                }}
            />

            <Call
                fn="../projections/stage"
                in={{
                    projection_step: ProjectionEffect.Step.ExpectSequence,
                    site: {
                        spans: $in.request.spans,
                        row: $ctx.replay.row
                    },
                    members: $ctx.replay.targets,
                    repeated: $ctx.list,
                    declared: false
                }}
                setter={[$store.projection.effect]}
            />
        </Case>

        <Case value={Sequences.SequenceRoute.Tuple}>
            <Call
                fn="../projections/stage"
                in={{
                    projection_step: ProjectionEffect.Step.ExpectSequence,
                    site: {
                        spans: $in.request.spans,
                        row: $ctx.replay.row
                    },
                    members: $ctx.replay.targets,
                    repeated: null,
                    declared: $ctx.replay.plan.declared
                }}
                setter={[$store.projection.effect]}
            />
        </Case>

        <Default>
            <Call
                fn="reject"
                in={{
                    spans: $in.request.spans,
                    row: $ctx.replay.row,
                    length: $ctx.replay.plan.route == Sequences.SequenceRoute.Length
                }}
            />

            <Return
                value={{
                    ...$in,
                    diagnostic: $ctx.reject
                }}
            />
        </Default>
    </Switch>

    <Call
        fn="../solve/stage_replay"
        in={{
            step: Effect.Step.RefreshSequences
        }}
        setter={[$store.replay.effect]}
    />

    <Return
        value={{
            ...$in,
            row: $ctx.replay.row + 1
        }}
    />
</Module>
