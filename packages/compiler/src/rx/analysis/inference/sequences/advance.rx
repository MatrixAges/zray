<Module>
    <Type from="model" as="Sequences" />
    <Type from="workflow" as="Replay" />

    <Args in={Replay.Cursor} out={Replay.Cursor} />

    <Call
        fn="replay"
        in={{
            ...$in.request.omit([
                "frame",
                "owner",
                "spans"
            ]),
            start: $in.row
        }}
    />

    <Switch on={$ctx.replay.plan.route}>
        <Case value={Sequences.SequenceRoute.Wait}>
            <Return
                value={{
                    ...$in,
                    row: $in.request.values.length
                }}
            />
        </Case>

        <Case value={Sequences.SequenceRoute.List}>
            <Call
                module="list"
                in={{
                    owner: $in.request.owner,
                    row: $ctx.replay.row,
                    argument: $ctx.replay.plan.argument,
                    declared: $ctx.replay.plan.declared
                }}
            />

            <Call
                fn="host.expectSequenceMembers"
                in={[
                    $in.request.owner,
                    $ctx.replay.row,
                    $ctx.replay.targets,
                    $ctx.list,
                    false
                ]}
            />
        </Case>

        <Case value={Sequences.SequenceRoute.Tuple}>
            <Call
                fn="host.expectSequenceMembers"
                in={[
                    $in.request.owner,
                    $ctx.replay.row,
                    $ctx.replay.targets,
                    null,
                    $ctx.replay.plan.declared
                ]}
            />
        </Case>

        <Default>
            <Call
                fn="reject"
                in={{
                    owner: $in.request.owner,
                    spans: $in.request.spans,
                    row: $ctx.replay.row,
                    length: $ctx.replay.plan.route == Sequences.SequenceRoute.Length
                }}
            />
        </Default>
    </Switch>

    <Call fn="../solve/host.refreshSolverSequences" in={$in.request.frame} />

    <Return
        value={{
            ...$in,
            row: $ctx.replay.row + 1
        }}
    />
</Module>
