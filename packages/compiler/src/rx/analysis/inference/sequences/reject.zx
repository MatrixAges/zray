import { invalid_sequence, tuple_length } from "./const"

import type { Diagnostic } from "../projections/site"
import type { Failure } from "./workflow"

export type Input = Failure

export type Output = Diagnostic

export default function (in: Input): Output {
    return {
        spans: in.spans,
        row: in.row,
        message: in.length ? tuple_length : invalid_sequence,
        unsupported: false
    }
}
