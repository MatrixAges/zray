import { depth_error, recursive_sequence } from "./const"
import { Route } from "./model"

import type { ProjectionSpans } from "rx_project_host"
import type { Diagnostic } from "../../projections/site"
import type { Output as Plan } from "./model"

export type Input = {
    spans: ProjectionSpans,
    plan: Plan
}

export type Output = Diagnostic

export default function (in: Input): Output {
    const depth = in.plan.route == Route.Depth

    return {
        spans: in.spans,
        row: in.plan.position,
        message: depth ? depth_error : recursive_sequence,
        unsupported: depth
    }
}
