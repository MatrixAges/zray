<Module>
    <Type from="../../assignment/application/round" as="Assignments" />
    <Type from="model" as="Sequences" />

    <Args in={Assignments.Execution} out={Assignments.Update} />

    <If on={$in.sequences.sequence.values.length == 0}>
        <Return
            value={{
                changed: false,
                diagnostic: null
            }}
        />
    </If>

    <Call fn="canonical.u32Views" in={$in.view.parents} />

    <Call
        module="choose"
        in={{
            graph: {
                parents: $ctx.u32Views,
                kinds: $in.view.graph.kinds,
                arguments: $in.view.graph.arguments,
                members: $in.sequences.members
            },
            classes: {
                ...$in.payloads,
                ...$in.classes
            },
            sequences: $in.sequences.sequence
        }}
    />

    <Switch on={$ctx.choose.route}>
        <Case value={Sequences.Route.Empty}>
            <Return
                value={{
                    changed: false,
                    diagnostic: null
                }}
            />
        </Case>

        <Case value={Sequences.Route.Select}>
            <Call
                fn="../../projections/host.requireProjectionList"
                in={[
                    $in.owner,
                    $in.sequences.spans,
                    $ctx.choose.position,
                    $in.sequences.sequence.values[$ctx.choose.position]
                ]}
            />
        </Case>

        <Default>
            <Call
                fn="reject"
                in={{
                    spans: $in.sequences.spans,
                    plan: $ctx.choose
                }}
            />

            <Return
                value={{
                    changed: false,
                    diagnostic: $ctx.reject
                }}
            />
        </Default>
    </Switch>

    <Return
        value={{
            changed: true,
            diagnostic: null
        }}
    />
</Module>
