<Module>
    <Type from="../../assignment/application/round" as="Assignments" />
    <Type from="model" as="Sequences" />
    <Type from="../../projections/effect" as="ProjectionEffect" />

    <Args in={Assignments.Execution} out={Assignments.Update} />

    <Store from="../../projections/publication" as="projection" />

    <If on={$in.sequences.sequence.values.length == 0}>
        <Return
            value={{
                changed: false,
                diagnostic: null
            }}
        />
    </If>

    <Call
        module="choose"
        in={{
            graph: {
                parents: $in.view.parents,
                kinds: $in.view.graph.kinds,
                arguments: $in.view.graph.arguments,
                members: $in.sequences.members
            },
            classes: {
                ...$in.payloads,
                ...$in.classes
            },
            sequences: $in.sequences.sequence
        }}
    />

    <Switch on={$ctx.choose.route}>
        <Case value={Sequences.Route.Empty}>
            <Return
                value={{
                    changed: false,
                    diagnostic: null
                }}
            />
        </Case>

        <Case value={Sequences.Route.Select}>
            <Call
                fn="../../projections/stage"
                in={{
                    projection_step: ProjectionEffect.Step.RequireList,
                    site: {
                        spans: $in.sequences.spans,
                        row: $ctx.choose.position
                    },
                    left: $in.sequences.sequence.values[$ctx.choose.position]
                }}
                setter={[$store.projection.effect]}
            />
        </Case>

        <Default>
            <Call
                fn="reject"
                in={{
                    spans: $in.sequences.spans,
                    plan: $ctx.choose
                }}
            />

            <Return
                value={{
                    changed: false,
                    diagnostic: $ctx.reject
                }}
            />
        </Default>
    </Switch>

    <Return
        value={{
            changed: true,
            diagnostic: null
        }}
    />
</Module>
