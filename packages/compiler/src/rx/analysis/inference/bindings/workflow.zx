import type { BindingDiagnosticSource, BindingReplay } from "rx_project_host"
import type { Input, Pairs } from "./model"

export type View = Input.Omit("start", "collisions") & {
    frame: BindingReplay,
    collisions: CollisionRows,
    uses: u32[]
}

export type CollisionRows = Pairs.Omit("final") & {
    messages: string[]
}

export type Replay = {
    view: View,
    final: bool
}

export type Diagnostic = {
    source: BindingDiagnosticSource,
    row: u64,
    message: string
}

export type Cursor = {
    request: Replay,
    start: u64,
    running: bool,
    diagnostic?: Diagnostic
}
