export type { Diagnostic } from "../solve/replay_effect"

import type { Input, Pairs } from "./model"
import type { Diagnostic } from "../solve/replay_effect"

export type View = Input.Omit("start", "collisions") & {
    collisions: CollisionRows,
    uses: u32[]
}

export type CollisionRows = Pairs.Omit("final") & {
    messages: string[]
}

export type Replay = {
    view: View,
    final: bool
}

export type Cursor = {
    request: Replay,
    start: u64,
    running: bool,
    diagnostic?: Diagnostic
}
