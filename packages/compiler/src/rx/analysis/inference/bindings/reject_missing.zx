import { reportBindingName } from "rx_project_host"

import { missing_message } from "./const"

import type { BindingReporter, BindingSpans } from "rx_project_host"

export type Input = {
    reporter: BindingReporter,
    spans: BindingSpans,
    row: u64
}

export type Output = void

export default function (in: Input): Output {
    reportBindingName(in.reporter, in.spans, in.row, missing_message)
}
