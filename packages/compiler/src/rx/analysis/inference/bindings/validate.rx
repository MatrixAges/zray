<Module>
    <Type from="workflow" as="Bindings" />
    <Type from="host" as="Host" />

    <Args in={Bindings.View} out={Bindings.Diagnostic?} />

    <If on={$in.uses.length != 0}>
        <Call
            fn="uses"
            in={{
                topology: $in.topology,
                values: $in.uses
            }}
        />

        <If on={$ctx.uses != null}>
            <Call
                fn="diagnostic"
                in={{
                    source: Host.BindingDiagnosticSource.Use,
                    row: $ctx.uses
                }}
            />

            <Return value={$ctx.diagnostic} />
        </If>
    </If>

    <Return value={null} />
</Module>
