import representative from "../forest/borrowed_root"
import lookup from "./lookup"
import { Action } from "./model"

import type { Output as Result, Scan } from "./model"

export type Input = Scan

export type Output = Result

export default function (in: Input): Output {
    const value: u32 = 0

    return loop({
        row: in.start,
        value,
        action: Action.Done
    }, {
        while: state => state.action == Action.Done && state.row < in.candidates.length,
        next: state => {
            const result = lookup({
                topology: in.topology,
                candidates: in.candidates[state.row]
            })

            const selected = result.selected

            if (result.multiple) {
                state.row += 1
            } else if (selected == null) {
                state.action = Action.Missing
            } else {
                const parents = in.topology.parents
                const target = representative({
                    parents,
                    value: in.values[state.row]
                })
                const source = representative({
                    parents,
                    value: selected
                })

                if (target == source) {
                    state.row += 1
                } else {
                    state.action = Action.Unify
                    state.value = source
                }
            }
        },
        return: state => state
    })
}
