<Module>
    <Type from="use_model" as="Requirement" />
    <Type from="model" as="Bindings" />

    <Args in={Requirement.Use} out={bool} />

    <Call
        fn="node"
        in={$in.pick([
            "topology",
            "value"
        ])}
    />

    <Switch on={$ctx.node}>
        <Case value={Bindings.Status.Void}>
            <Call
                fn="reject_missing"
                in={{
                    reporter: $in.reporter,
                    spans: $in.source,
                    row: 0
                }}
            />
        </Case>

        <Case value={Bindings.Status.Pending}>
            <Return value={true} />
        </Case>
    </Switch>

    <Return value={false} />
</Module>
