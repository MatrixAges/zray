<Module>
    <Type from="workflow" as="Bindings" />

    <Args in={Bindings.Replay} out={void} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                request: $in,
                start: 0,
                running:
                    $in.view.values.length != 0 || $in.view.collisions.left.length != 0
            }}
        />
    </Loop>
</Module>
