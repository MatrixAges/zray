<Module>
    <Type from="model" as="Bindings" />
    <Type from="workflow" as="Replay" />

    <Args in={Replay.Cursor} out={Replay.Cursor} />

    <Call
        module="propagate"
        in={{
            ...$in.request.view.pick([
                "topology",
                "candidates",
                "values"
            ]),
            collisions: {
                ...$in.request.view.collisions.pick([
                    "left",
                    "right"
                ]),
                final: $in.request.final
            },
            start: $in.start
        }}
    />

    <If on={$ctx.propagate.action == Bindings.Action.Unify}>
        <Call
            fn="host.unifyBindingReplay"
            in={[
                $in.request.view.frame,
                $ctx.propagate.row,
                $ctx.propagate.value
            ]}
        />

        <Call fn="host.refreshBindingTopology" in={$in.request.view.frame} />

        <Return
            value={{
                request: $in.request,
                start: $ctx.propagate.row + 1,
                running: $ctx.propagate.row + 1 < $in.request.view.values.length
            }}
        />
    </If>

    <Switch on={$ctx.propagate.action}>
        <Case value={Bindings.Action.Conflict}>
            <Call
                fn="host.reportBindingName"
                in={[
                    $in.request.view.reporter,
                    $in.request.view.collisions.spans,
                    $ctx.propagate.row,
                    $in.request.view.collisions.messages[$ctx.propagate.row]
                ]}
            />
        </Case>

        <Case value={Bindings.Action.Missing}>
            <Call
                fn="reject_missing"
                in={{
                    reporter: $in.request.view.reporter,
                    spans: $in.request.view.lookup_spans,
                    row: $ctx.propagate.row
                }}
            />
        </Case>
    </Switch>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
