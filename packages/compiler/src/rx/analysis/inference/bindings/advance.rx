<Module>
    <Type from="model" as="Bindings" />
    <Type from="workflow" as="Replay" />
    <Type from="../solve/replay_effect" as="Effect" />

    <Args in={Replay.Cursor} out={Replay.Cursor} />

    <Store from="../solve/replay" as="replay" />

    <Call
        module="propagate"
        in={{
            ...$in.request.view.pick([
                "topology",
                "candidates",
                "values"
            ]),
            collisions: {
                ...$in.request.view.collisions.pick([
                    "left",
                    "right"
                ]),
                final: $in.request.final
            },
            start: $in.start
        }}
    />

    <If on={$ctx.propagate.action == Bindings.Action.Unify}>
        <Call
            fn="../solve/stage_replay"
            in={{
                step: Effect.Step.UnifyBinding,
                row: $ctx.propagate.row,
                right: $ctx.propagate.value
            }}
            setter={[$store.replay.effect]}
        />

        <Call
            fn="../solve/stage_replay"
            in={{
                step: Effect.Step.RefreshBindings
            }}
            setter={[$store.replay.effect]}
        />

        <Return
            value={{
                request: $in.request,
                start: $ctx.propagate.row + 1,
                running: $ctx.propagate.row + 1 < $in.request.view.values.length,
                diagnostic: null
            }}
        />
    </If>

    <Switch on={$ctx.propagate.action}>
        <Case value={Bindings.Action.Conflict}>
            <Call
                fn="diagnostic"
                in={{
                    source: Effect.DiagnosticSource.Collision,
                    row: $ctx.propagate.row,
                    message:
                        $in.request.view.collisions.messages[$ctx.propagate.row]
                }}
            />

            <Return
                value={{
                    ...$in,
                    running: false,
                    diagnostic: $ctx.diagnostic
                }}
            />
        </Case>

        <Case value={Bindings.Action.Missing}>
            <Call
                fn="diagnostic"
                in={{
                    source: Effect.DiagnosticSource.Lookup,
                    row: $ctx.propagate.row
                }}
            />

            <Return
                value={{
                    ...$in,
                    running: false,
                    diagnostic: $ctx.diagnostic
                }}
            />
        </Case>
    </Switch>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
