import integers from "std:integer"

import { Issue } from "../model"
import {
    incompatible_operator,
    incompatible_requirements,
    requires_scalar
} from "./const"

import type { Output as Decision } from "../restriction"
import type { Outcome } from "./model"

export type Input = Decision

export type Output = Outcome

export default function (in: Input): Output {
    const message: string? = match in.issue {
        Issue.Empty => incompatible_requirements,
        Issue.Operator => incompatible_operator,
        Issue.Structure => requires_scalar,
        _ => null
    }

    if (message != null) {
        return {
            message,
            root: in.root,
            allowed: null,
            changed: false
        }
    }

    return {
        message: null,
        root: in.root,
        allowed: integers.narrowShort(in.allowed),
        changed: in.changed
    }
}
