import { BinaryOperator } from "core/expression_table/kinds"

import classify from "../../../../zx/analysis/analyzer/expressions/operators/classify"
import { Form } from "../operators/model"
import domain from "./domain"
import { Domain } from "./model"

export type Input = BinaryOperator

export type Output = {
    form: Form,
    allowed?: u64,
    use_hint: bool
}

export default function (in: Input): Output {
    const facts = classify(in)

    const form = match {
        in == BinaryOperator.Coalesce => Form.Coalesce,
        in == BinaryOperator.LogicalAnd => Form.And,
        facts.logical => Form.Or,
        facts.comparison => Form.Compare,
        _ => Form.Arithmetic
    }

    const numeric = form == Form.Arithmetic || form == Form.Compare
    const allowed: u64? = numeric && !facts.equality ? domain(Domain.Numeric) : null
    const use_hint = form == Form.Arithmetic || form == Form.Coalesce

    return {
        form,
        allowed,
        use_hint
    }
}
