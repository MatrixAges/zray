<Module>
    <Type from="existing" as="Fields" />
    <Type from="workflow" as="Replay" />

    <Args in={Replay.Target} out={u32} />

    <Switch on={$in.choice.action}>
        <Case value={Fields.Action.Field}>
            <Call
                module="read"
                in={{
                    site: $in.site,
                    name: $in.name,
                    open: false
                }}
            />

            <Return value={$ctx.read} />
        </Case>

        <Case value={Fields.Action.Append}>
            <Call module="write" in={$in.omit(["choice"])} />

            <Return value={$ctx.write} />
        </Case>

        <Case value={Fields.Action.Register}>
            <Call
                fn="host.registerFieldType"
                in={[
                    $in.site.frame,
                    $in.choice.value
                ]}
            />

            <Return value={$ctx.registerFieldType} />
        </Case>

        <Default>
            <Return value={$in.choice.value} />
        </Default>
    </Switch>
</Module>
