<Module>
    <Type from="existing" as="Fields" />
    <Type from="workflow" as="Replay" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Replay.Target} out={u32} />

    <Store from="../object_closure/object" as="object" />

    <Switch on={$in.choice.action}>
        <Case value={Fields.Action.Field}>
            <Call
                module="read"
                in={{
                    site: $in.site,
                    name: $in.name,
                    open: false
                }}
            />

            <Return value={$ctx.read.value} />
        </Case>

        <Case value={Fields.Action.Append}>
            <Call module="write" in={$in.omit(["choice"])} />

            <Return value={$ctx.write} />
        </Case>

        <Case value={Fields.Action.Register}>
            <Call
                fn="../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.RegisterType,
                    type_id: $in.choice.value
                }}
                setter={[$store.object.effect]}
            />

            <Call fn="../object_closure/read_id" in={$store.object.effect} />

            <Return value={$ctx.read_id} />
        </Case>

        <Default>
            <Return value={$in.choice.value} />
        </Default>
    </Switch>
</Module>
