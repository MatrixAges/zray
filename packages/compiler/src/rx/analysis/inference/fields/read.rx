<Module>
    <Type from="workflow" as="Access" />
    <Type from="model" as="Fields" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Access.Read} out={Access.Outcome} />

    <Store from="../object_closure/object" as="object" />

    <Call
        fn="plan"
        in={{
            receiver: {
                ...$in.site.receiver,
                name: $in.name
            },
            members: $in.site.members,
            open: $in.open
        }}
    />

    <Switch on={$ctx.plan.route}>
        <Case value={Fields.Route.Member}>
            <Return
                value={{
                    value: $ctx.plan.value,
                    revised: false
                }}
            />
        </Case>

        <Case value={Fields.Route.AppendMember}>
            <Call module="write" in={$in.omit(["open"])} />

            <Return
                value={{
                    value: $ctx.write,
                    revised: true
                }}
            />
        </Case>

        <Case value={Fields.Route.DeferLength}>
            <Call
                fn="../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.AddNode
                }}
                setter={[$store.object.effect]}
            />

            <Call fn="../object_closure/read_id" in={$store.object.effect} />

            <Call
                fn="../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.AppendLength,
                    source: $ctx.read_id
                }}
                setter={[$store.object.effect]}
            />

            <Return
                value={{
                    value: $ctx.read_id,
                    revised: false
                }}
            />
        </Case>

        <Case value={Fields.Route.RequireList}>
            <Call
                fn="../object_closure/stage"
                in={{
                    object_step: ObjectEffect.Step.RequireList
                }}
                setter={[$store.object.effect]}
            />
        </Case>

        <Default>
            <If
                on={$ctx.plan.route != Fields.Route.Length &&
                    $ctx.plan.route != Fields.Route.KnownMember}
            >
                <Call fn="diagnostic" in={$ctx.plan.route} />

                <Call
                    fn="../object_closure/stage"
                    in={{
                        object_step: ObjectEffect.Step.RejectAccess,
                        message: $ctx.diagnostic
                    }}
                    setter={[$store.object.effect]}
                />
            </If>
        </Default>
    </Switch>

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.RegisterType,
            type_id: $ctx.plan.value
        }}
        setter={[$store.object.effect]}
    />

    <Call fn="../object_closure/read_id" in={$store.object.effect} />

    <Return
        value={{
            value: $ctx.read_id,
            revised: false
        }}
    />
</Module>
