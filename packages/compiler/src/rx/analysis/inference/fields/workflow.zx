import type { State as Known } from "core/integer/map/model"
import type { FieldAccess } from "rx_project_host"
import type { Object, Output as Field } from "./existing"
import type { Members, Receiver } from "./model"

export type View = {
    object: Object,
    parents: u32[],
    known: Known,
    site: Site
}

export type Site = {
    frame: FieldAccess,
    receiver: Receiver.Omit("name"),
    members: Members,
    prefix: u64,
    capacity: u64,
    published: u64
}

export type Write = {
    site: Site,
    name: string
}

export type Read = Write & {
    open: bool
}

export type Target = Write & {
    choice: Field
}

export type Outcome = {
    value: u32,
    revised: bool
}
