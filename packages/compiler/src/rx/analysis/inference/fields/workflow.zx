import type { State as Known } from "core/integer/map/model"
import type { Allocator, U32Buffer } from "memory"
import type { FieldAccess } from "rx_project_host"
import type { Input as Shape } from "../unification/commit/publish_shape"
import type { Object, Output as Field } from "./existing"
import type { Storage } from "./growth/model"
import type { Members, Receiver } from "./model"

export type View = {
    object: Object,
    parents: U32Buffer,
    known: Known,
    site: Site
}

export type Site = Shape.Omit("shape") & {
    frame: FieldAccess,
    receiver: Receiver.Omit("name"),
    members: Members,
    storage: Storage,
    allocator: Allocator,
    object_kind: u8
}

export type Write = {
    site: Site,
    name: string
}

export type Read = Write & {
    open: bool
}

export type Target = Write & {
    choice: Field
}

export type Outcome = {
    value: u32,
    revised: bool
}
