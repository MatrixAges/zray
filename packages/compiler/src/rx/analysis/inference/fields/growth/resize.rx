<Module>
    <Type from="model" as="Fields" />

    <Args in={Fields.Resize} out={void} />

    <Call fn="capacity" in={$in} />

    <Call
        fn="../host.bindFieldColumns"
        in={[
            $in.storage.frame,
            $in.count,
            $ctx.capacity
        ]}
    />

    <If on={$ctx.capacity != null}>
        <Call
            fn="copy_prefix"
            in={$in.storage.pick([
                "source_names",
                "source_values",
                "target_names",
                "target_values"
            ])}
        />
    </If>

    <Call
        fn="extent"
        in={{
            extent: $in.storage.extent,
            count: $in.count
        }}
    />
</Module>
