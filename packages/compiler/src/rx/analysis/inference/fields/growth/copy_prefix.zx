import memory from "memory"

import type { Storage } from "./model"

export type Input =
    Storage.Pick("source_names", "source_values", "target_names", "target_values")

export type Output = void

export default function (in: Input): Output {
    memory.copyStringViewsAt(in.target_names, 0, in.source_names)
    memory.copyU32sAt(in.target_values, 0, in.source_values)
}
