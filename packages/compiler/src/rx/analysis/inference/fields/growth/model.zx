import type { StringBuffer, U32Buffer } from "memory"
import type { FieldColumnStorage } from "rx_project_host"

export type Storage = {
    frame: FieldColumnStorage,
    source_names: string[],
    source_values: u32[],
    capacity: u64,
    published: u64,
    target_names: StringBuffer,
    target_values: U32Buffer,
    extent: U32Buffer
}

export type Resize = {
    storage: Storage,
    count: u64
}
