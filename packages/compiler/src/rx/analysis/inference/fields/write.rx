<Module>
    <Type from="workflow" as="Fields" />
    <Type from="../object_closure/effect" as="ObjectEffect" />

    <Args in={Fields.Write} out={u32} />

    <Store from="../object_closure/object" as="object" />

    <Call
        fn="growth/capacity"
        in={{
            prefix: $in.site.prefix,
            capacity: $in.site.capacity,
            published: $in.site.published,
            count: $in.site.prefix + 1
        }}
    />

    <Call
        fn="../object_closure/stage"
        in={{
            object_step: ObjectEffect.Step.AppendMember,
            name: $in.name,
            capacity: $ctx.capacity
        }}
        setter={[$store.object.effect]}
    />

    <Call fn="../object_closure/read_id" in={$store.object.effect} />

    <Return value={$ctx.read_id} />
</Module>
