import type { State as KnownTypes } from "core/integer/map/model"
import type { U32Buffer } from "memory"
import type { ProjectionSpans } from "rx_project_host"
import type { Graph, IndexPlan } from "../sequences/model"

export enum Action {
    Done,
    Resolved,
    Apply
}

export type Input = {
    graph: Graph,
    parents: U32Buffer,
    targets: u32[],
    values: u32[],
    resolved: bool[],
    positions: u64?[],
    known: KnownTypes,
    start: u64
}

export type Output = {
    action: Action,
    row: u64,
    plan: IndexPlan,
    node?: u32
}

export type EffectInput = IndexPlan & {
    node?: u32
}

export type Effect = {
    value: u32,
    declared: bool,
    error_spans: ProjectionSpans,
    message?: string
}
