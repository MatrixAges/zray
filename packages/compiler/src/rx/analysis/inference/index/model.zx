import type { State as KnownTypes } from "core/integer/map/model"
import type { U8Buffer, U32Buffer } from "memory"
import type { Graph, IndexPlan } from "../sequences/model"

export type Input = {
    graph: Graph,
    parents: U32Buffer,
    targets: u32[],
    values: u32[],
    resolved: bool[],
    resolution: U8Buffer,
    positions: u64?[],
    known: KnownTypes,
    start: u64
}

export type Output = {
    found: bool,
    row: u64,
    plan: IndexPlan,
    node?: u32
}

export type EffectInput = IndexPlan & {
    node?: u32
}

export type Effect = {
    value: u32,
    declared: bool,
    message?: string
}
