<Module>
    <Type from="workflow" as="Indexes" />

    <Args in={Indexes.Application} out={bool} />

    <Call fn="effect" in={$in} />

    <If on={$ctx.effect.message != null}>
        <Call
            fn="../projections/host.rejectProjection"
            in={[
                $in.site.graph,
                $ctx.effect.error_spans,
                $in.site.row,
                $ctx.effect.message ?? ""
            ]}
        />

        <Return value={true} />
    </If>

    <If on={$ctx.effect.declared}>
        <Call
            fn="../projections/host.registerProjectionType"
            in={[
                $in.site.graph,
                $in.site.spans,
                $in.site.row,
                $ctx.effect.value
            ]}
        />

        <Call
            fn="../projections/host.mergeProjection"
            in={[
                $in.site.graph,
                $in.site.spans,
                $in.site.row,
                $ctx.registerProjectionType,
                $in.value
            ]}
        />

        <Return value={true} />
    </If>

    <Call
        fn="../projections/host.mergeProjection"
        in={[
            $in.site.graph,
            $in.site.spans,
            $in.site.row,
            $ctx.effect.value,
            $in.value
        ]}
    />

    <Return value={true} />
</Module>
