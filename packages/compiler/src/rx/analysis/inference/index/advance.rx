<Module>
    <Type from="workflow" as="Indexes" />
    <Type from="model" as="Model" />
    <Type from="../solve/replay_effect" as="Effect" />

    <Args in={Indexes.Cursor} out={Indexes.Cursor} />

    <Store from="../solve/replay" as="replay" />

    <Call
        fn="replay"
        in={{
            ...$in.request.omit([
                "spans",
                "index_spans"
            ]),
            start: $in.row
        }}
    />

    <Switch on={$ctx.replay.action}>
        <Case value={Model.Action.Done}>
            <Return
                value={{
                    ...$in,
                    row: $in.request.targets.length
                }}
            />
        </Case>

        <Case value={Model.Action.Resolved}>
            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.MarkIndexResolved,
                    row: $ctx.replay.row
                }}
                setter={[$store.replay.effect]}
            />
        </Case>

        <Case value={Model.Action.Apply}>
            <Call
                module="apply"
                in={{
                    site: {
                        spans: $in.request.spans,
                        row: $ctx.replay.row
                    },
                    index_spans: $in.request.index_spans,
                    value: $in.request.values[$ctx.replay.row],
                    route: $ctx.replay.plan.route,
                    child: $ctx.replay.plan.child,
                    declared: $ctx.replay.plan.declared,
                    node: $ctx.replay.node
                }}
            />

            <If on={$ctx.apply}>
                <Call
                    fn="../solve/stage_replay"
                    in={{
                        step: Effect.Step.MarkIndexResolved,
                        row: $ctx.replay.row
                    }}
                    setter={[$store.replay.effect]}
                />
            </If>

            <Call
                fn="../solve/stage_replay"
                in={{
                    step: Effect.Step.RefreshIndexes
                }}
                setter={[$store.replay.effect]}
            />
        </Case>
    </Switch>

    <Return
        value={{
            ...$in,
            row: $ctx.replay.row + 1
        }}
    />
</Module>
