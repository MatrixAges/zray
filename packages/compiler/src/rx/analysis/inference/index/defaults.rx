<Module>
    <Type from="workflow" as="Indexes" />
    <Type from="../projections/effect" as="ProjectionEffect" />

    <Args in={Indexes.Replay} out={bool} />

    <Store from="../projections/publication" as="projection" />

    <Call
        fn="../projections/scan"
        in={{
            targets: $in.targets,
            kinds: $in.graph.kinds,
            parents: $in.parents
        }}
    />

    <If on={$ctx.scan == null}>
        <Return value={false} />
    </If>

    <Call
        fn="../projections/stage"
        in={{
            projection_step: ProjectionEffect.Step.RequireList,
            site: {
                spans: $in.spans,
                row: $ctx.scan ?? 0
            },
            left: $in.targets[$ctx.scan ?? 0]
        }}
        setter={[$store.projection.effect]}
    />

    <Call fn="../projections/read_id" in={$store.projection.effect} />

    <Call
        fn="../projections/stage"
        in={{
            projection_step: ProjectionEffect.Step.Merge,
            site: {
                spans: $in.spans,
                row: $ctx.scan ?? 0
            },
            left: $ctx.read_id,
            right: $in.values[$ctx.scan ?? 0]
        }}
        setter={[$store.projection.effect]}
    />

    <Return value={true} />
</Module>
