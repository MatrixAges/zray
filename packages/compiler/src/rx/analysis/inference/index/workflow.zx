import type { SpanSource } from "../projections/site"
import type { Site } from "../projections/site"
import type { IndexInput } from "../sequences/model"
import type { EffectInput, Input } from "./model"

export type Replay = Input.Omit("start") & {
    spans: SpanSource,
    index_spans: SpanSource
}

export type Cursor = {
    request: Replay,
    row: u64
}

export type Application = EffectInput & {
    site: Site,
    index_spans: SpanSource,
    value: u32
}

export type Immediate = IndexInput & {
    site: Site,
    index_spans: SpanSource,
    target: u32,
    value: u32
}
