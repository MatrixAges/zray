import type { ConstraintRound, ProjectionGraph, ProjectionSpans } from "rx_project_host"
import type { Site } from "../projections/site"
import type { IndexInput } from "../sequences/model"
import type { EffectInput, Input } from "./model"

export type Replay = Input.Omit("start") & {
    frame: ConstraintRound,
    owner: ProjectionGraph,
    spans: ProjectionSpans,
    index_spans: ProjectionSpans
}

export type Cursor = {
    request: Replay,
    row: u64
}

export type Application = EffectInput & {
    site: Site,
    index_spans: ProjectionSpans,
    value: u32
}

export type Immediate = IndexInput & {
    site: Site,
    index_spans: ProjectionSpans,
    target: u32,
    value: u32
}
