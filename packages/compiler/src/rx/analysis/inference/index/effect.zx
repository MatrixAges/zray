import { scalar_u8 } from "core/type_table/const"

import { IndexRoute } from "../sequences/model"
import { missing_literal, out_of_bounds, invalid_target } from "./const"

import type { Effect, EffectInput } from "./model"

export type Input = EffectInput

export type Output = Effect

export default function (in: Input): Output {
    const { route, child, declared, node } = in

    if (node != null) {
        return {
            value: node,
            declared: false,
            message: null
        }
    }

    const reads_byte = route == IndexRoute.String

    const message: string? = match route {
        IndexRoute.MissingLiteral => missing_literal,
        IndexRoute.OutOfBounds => out_of_bounds,
        IndexRoute.Invalid => invalid_target,
        _ => null
    }

    return {
        value: reads_byte ? scalar_u8 : child,
        declared: reads_byte || declared,
        message
    }
}
