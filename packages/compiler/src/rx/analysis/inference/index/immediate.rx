<Module>
    <Type from="workflow" as="Indexes" />
    <Type from="../sequences/model" as="Sequences" />
    <Type from="../projections/effect" as="ProjectionEffect" />

    <Args in={Indexes.Immediate} out={bool} />

    <Store from="../projections/publication" as="projection" />

    <Call fn="plan" in={$in} />

    <If on={$ctx.plan.route != Sequences.IndexRoute.Wait}>
        <Call module="apply" in={$ctx.plan} />

        <Return value={true} />
    </If>

    <Call
        fn="../projections/stage"
        in={{
            projection_step: ProjectionEffect.Step.AppendIndex
        }}
        setter={[$store.projection.effect]}
    />

    <Return value={false} />
</Module>
