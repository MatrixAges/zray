export enum Form {
    Call,
    Task,
    Parallel,
    Selection,
    Case,
    ParallelTask
}

export enum Step {
    Done,
    BindGetters,
    CompileArgument,
    RestoreBindings,
    PublishCall,
    CompileTaskBody,
    CompileTaskOutput,
    PublishTask,
    CompileParallelBranches,
    PublishParallelBindings,
    CompileSubject,
    CompileCases,
    CheckSelection,
    CompileLabel,
    RefineSubject,
    CompileCaseBody,
    RestoreCaseScope,
    WriteCase,
    CompileParallelTaskBody,
    CheckTaskCalls,
    ResolveCaptures,
    LowerParallelTask,
    CheckTaskProgram,
    AnalyzeTaskOwnership,
    ValidateTaskProgram,
    BuildCaptureArgument,
    PublishParallelTask
}

export type Input = Form

export type Output = Step[]
