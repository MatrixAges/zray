<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={Flow.Output} />

    <Switch on={$in}>
        <Case value={Flow.Form.Call}>
            <Return
                value={[
                    Flow.Step.BindGetters,
                    Flow.Step.CompileArgument,
                    Flow.Step.RestoreBindings,
                    Flow.Step.PublishCall
                ]}
            />
        </Case>

        <Case value={Flow.Form.Task}>
            <Return
                value={[
                    Flow.Step.CompileTaskBody,
                    Flow.Step.CompileTaskOutput,
                    Flow.Step.RestoreBindings,
                    Flow.Step.PublishTask
                ]}
            />
        </Case>

        <Case value={Flow.Form.Parallel}>
            <Return
                value={[
                    Flow.Step.CompileParallelBranches,
                    Flow.Step.PublishParallelBindings
                ]}
            />
        </Case>

        <Case value={Flow.Form.Selection}>
            <Return
                value={[
                    Flow.Step.CompileSubject,
                    Flow.Step.CompileCases,
                    Flow.Step.CheckSelection
                ]}
            />
        </Case>

        <Case value={Flow.Form.Case}>
            <Return
                value={[
                    Flow.Step.CompileLabel,
                    Flow.Step.RefineSubject,
                    Flow.Step.CompileCaseBody,
                    Flow.Step.RestoreCaseScope,
                    Flow.Step.WriteCase
                ]}
            />
        </Case>

        <Case value={Flow.Form.ParallelTask}>
            <Return
                value={[
                    Flow.Step.CompileParallelTaskBody,
                    Flow.Step.CheckTaskCalls,
                    Flow.Step.ResolveCaptures,
                    Flow.Step.LowerParallelTask,
                    Flow.Step.CheckTaskProgram,
                    Flow.Step.AnalyzeTaskOwnership,
                    Flow.Step.ValidateTaskProgram,
                    Flow.Step.BuildCaptureArgument,
                    Flow.Step.PublishParallelTask
                ]}
            />
        </Case>
    </Switch>
</Module>
