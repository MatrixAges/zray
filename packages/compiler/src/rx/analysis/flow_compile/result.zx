import { scalar_void } from "core/type_table/const"

export type Input = {
    names: string[],
    types: u32[],
    row: u64
}

export type Output = {
    type_id: u32,
    name?: string
}

export default function (in: Input): Output {
    const type_id = in.types[in.row]

    return {
        type_id,
        name: type_id == scalar_void ? null : in.names[in.row]
    }
}
