import integers from "std:integer"

import type { Input as Request, Selection } from "./layout/model"

export type Input = Request

export type Output = Selection

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        cursor: 0,
        positions: empty,
        first: 0,
        optional_count: 0
    }, {
        while: state => state.positions.length < in.count,
        next: state => {
            const row = state.cursor

            if (in.marked[row]) {
                if (state.positions.length == 0) {
                    state.first = row
                }

                state.positions = state.positions.push(integers.narrow(row))[0]

                if (in.types[row] != in.parameters[row]) {
                    state.optional_count += 1
                }
            }

            state.cursor += 1
        },
        return: state => ({
            positions: state.positions,
            first: state.first,
            contiguous: state.cursor - state.first == in.count,
            optional_count: state.optional_count
        })
    })
}
