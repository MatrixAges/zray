import integers from "std:integer"
import memory from "memory"

import type { Input as Request, Selection } from "./layout/model"

export type Input = Request

export type Output = Selection

export default function (in: Input): Output {
    memory.allocateU32Views(in.positions, in.count)

    return loop({
        cursor: 0,
        written: 0,
        first: 0,
        optional_count: 0
    }, {
        while: state => state.written < in.count,
        next: state => {
            const row = state.cursor

            if (in.marked[row]) {
                if (state.written == 0) {
                    state.first = row
                }

                memory.writeU32(
                    in.positions,
                    state.written,
                    integers.narrow(row)
                )

                if (in.types[row] != in.parameters[row]) {
                    state.optional_count += 1
                }

                state.written += 1
            }

            state.cursor += 1
        },
        return: state => ({
            positions: memory.u32Views(in.positions),
            first: state.first,
            contiguous: state.cursor - state.first == in.count,
            optional_count: state.optional_count
        })
    })
}
