import integers from "std:integer"
import memory from "std:memory"
import { kind_optional } from "core/type_table/const"

import present from "../../../zx/analysis/semantic/resolving/contains"

import type { U32Buffer } from "std:memory"

export type Input = {
    names: string[],
    types: u32[],
    kinds: u8[],
    children: u32[],
    facts: string[],
    narrowed: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const result = loop(0, {
        while: index => index < in.names.length,
        next: index => {
            const type_id = in.types[index]
            const row = integers.widen(type_id)
            const narrowed = match {
                in.kinds[row] == kind_optional &&
                    present({
                        name: in.names[index],
                        names: in.facts
                    }) => in.children[row],
                _ => type_id
            }

            memory.writeU32(in.narrowed, index, narrowed)
            index += 1
        }
    })
}
