import integers from "std:integer"
import { kind_optional } from "core/type_table/const"

import present from "../../../zx/analysis/semantic/resolving/contains"

export type Input = {
    names: string[],
    types: u32[],
    kinds: u8[],
    children: u32[],
    facts: string[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        index: 0,
        narrowed: empty
    }, {
        while: state => state.index < in.names.length,
        next: state => {
            const type_id = in.types[state.index]
            const row = integers.widen(type_id)
            const narrowed = match {
                in.kinds[row] == kind_optional &&
                    present({
                        name: in.names[state.index],
                        names: in.facts
                    }) => in.children[row],
                _ => type_id
            }

            state.narrowed = state.narrowed.push(narrowed)[0]
            state.index += 1
        },
        return: state => state.narrowed
    })
}
