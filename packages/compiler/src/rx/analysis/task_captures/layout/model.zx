export type Input = {
    types: u32[],
    parameters: u32[],
    marked: bool[],
    count: u64
}

export type Selection = {
    positions: u32[],
    first: u64,
    contiguous: bool,
    optional_count: u64
}

export type Output = {
    positions: u32[],
    source_types: u32[],
    parameter_types: u32[],
    optional_count: u64
}
