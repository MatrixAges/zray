<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call fn="transport" in={$in} />

    <Call
        fn="rows"
        in={{
            source_types: $ctx.transport.source_types,
            parameters: $ctx.transport.parameter_types
        }}
    />

    <Return
        value={{
            ...$ctx.transport,
            rows: $ctx.rows
        }}
    />
</Module>
