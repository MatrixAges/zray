<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call fn="../positions" in={$in} />

    <Task name="source" out={$ctx.transport}>
        <Call
            fn="transport"
            in={{
                types: $in.types,
                selection: $ctx.positions
            }}
        />
    </Task>

    <If on={$ctx.positions.optional_count == 0}>
        <Return
            value={{
                source_types: $ctx.task.source,
                parameter_types: $ctx.task.source,
                optional_count: $ctx.positions.optional_count
            }}
        />
    </If>

    <Task name="parameters" out={$ctx.transport}>
        <Call
            fn="transport"
            in={{
                types: $in.parameters,
                selection: $ctx.positions
            }}
        />
    </Task>

    <Return
        value={{
            source_types: $ctx.task.source,
            parameter_types: $ctx.task.parameters,
            optional_count: $ctx.positions.optional_count
        }}
    />
</Module>
