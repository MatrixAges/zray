import type { Rows } from "./model"

export type Input = {
    source_types: u32[],
    parameters: u32[]
}

export type Output = Rows

export default function (in: Input): Output {
    const count = in.parameters.length

    return loop({
        position: 0,
        optional_count: 0
    }, {
        while: state => state.position < count,
        next: state => {
            const position = state.position

            if (in.source_types[position] != in.parameters[position]) {
                state.optional_count += 1
            }

            state.position += 1
        },
        return: state => ({
            optional_count: state.optional_count
        })
    })
}
