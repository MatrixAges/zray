import integers from "std:integer"
import memory from "memory"

import type { Selection } from "./model"

export type Input = {
    types: u32[],
    selection: Selection
}

export type Output = u32[]

export default function (in: Input): Output {
    const { types, selection } = in

    const positions = selection.positions

    if (selection.contiguous) {
        return memory.borrowU32Range(types, selection.first, positions.length)
    }

    return positions.map(position => types[integers.widen(position)])[0]
}
