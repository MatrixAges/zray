import integers from "std:integer"

import type { Input as Request, Types } from "./model"

export type Input = Request

export type Output = Types

export default function (in: Input): Output {
    const types = in.types
    const parameters = in.parameters

    return {
        source_types:
            in.positions.map(position => types[integers.widen(position)])[0],
        parameter_types:
            in.positions.map(position => parameters[integers.widen(position)])[0]
    }
}
