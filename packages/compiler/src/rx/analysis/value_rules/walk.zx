import { ExprKind } from "../../../zx/frontend/parser/expressions/state/model"
import admit from "./admit"
import child from "./child"
import { Issue } from "./model"
import template from "./template"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const missing: u64? = null
    const empty_stack: u64[] = []

    const empty: Output = {
        issue: Issue.None,
        node: in.root
    }

    return loop({
        node: in.root,
        ordinal: 0,
        depth: 0,
        ancestors: empty_stack,
        positions: empty_stack,
        condition: missing,
        policy: empty,
        style: empty,
        active: true
    }, {
        while: state => state.active && state.policy.issue == Issue.None,
        next: state => {
            const kind = in.tree.nodes[state.node].kind

            if (state.ordinal == 0) {
                state.policy = admit({
                    walk: in,
                    node: state.node
                })

                if (kind == ExprKind.Conditional) {
                    if (state.condition == null) {
                        state.condition = state.depth
                    } else if (state.style.issue == Issue.None) {
                        state.style = {
                            issue: Issue.NestedConditional,
                            node: state.node
                        }
                    }
                }
            }

            if (state.policy.issue == Issue.None) {
                const request = {
                    walk: in,
                    node: state.node,
                    index: state.ordinal
                }

                const next = match kind {
                    ExprKind.Template => template(request),
                    _ => {
                        node: child(request),
                        next: state.ordinal + 1
                    }
                }

                if (next.node != null) {
                    if (state.depth < state.ancestors.length) {
                        state.ancestors[state.depth] = state.node
                        state.positions[state.depth] = next.next
                    } else {
                        state.ancestors = state.ancestors.push(state.node)[0]
                        state.positions = state.positions.push(next.next)[0]
                    }

                    state.node = next.node
                    state.ordinal = 0
                    state.depth += 1
                } else {
                    if (state.condition == state.depth) {
                        state.condition = null
                    }

                    if (state.depth == 0) {
                        state.active = false
                    } else {
                        state.depth -= 1
                        state.node = state.ancestors[state.depth]
                        state.ordinal = state.positions[state.depth]
                    }
                }
            }
        },
        return: state => match state.policy.issue {
            Issue.None => state.style,
            _ => state.policy
        }
    })
}
