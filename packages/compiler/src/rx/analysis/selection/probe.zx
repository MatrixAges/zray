import bytes from "std:bytes"
import integers from "std:integer"

import { empty_slot } from "./const"
import equal from "./equal"
import read from "./label"
import { Kind } from "./model"

import type { Label, Labels } from "./model"

export type Input = {
    labels: Labels,
    slots: u64[],
    value: Label
}

export type Output = {
    slot: u64,
    duplicate: bool
}

export default function (in: Input): Output {
    const hash = match in.value.kind {
        Kind.String => bytes.hash(bytes.fromText(in.value.text)),
        _ => integers.hash(in.value.number)
    }

    return loop({
        slot: hash % in.slots.length,
        done: false,
        duplicate: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = in.slots[state.slot]

            if (entry == empty_slot) {
                state.done = true
            } else {
                const previous = read({
                    labels: in.labels,
                    index: entry - 1
                })
                const same = equal({
                    left: previous,
                    right: in.value
                })

                if (same) {
                    state.done = true
                    state.duplicate = true
                } else {
                    state.slot = (state.slot + 1) % in.slots.length
                }
            }
        },
        return: state => ({
            slot: state.slot,
            duplicate: state.duplicate
        })
    })
}
