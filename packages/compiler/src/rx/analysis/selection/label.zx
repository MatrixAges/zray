import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import { Kind } from "./model"

import type { Label, Labels } from "./model"

export type Input = {
    labels: Labels,
    index: u64
}

export type Output = Label

export default function (in: Input): Output {
    const { labels } = in

    const empty: Label = {
        kind: Kind.Default,
        number: 0,
        text: ""
    }

    const program = labels[in.index]

    if (program == null) {
        return empty
    }

    const { control, expressions } = program

    const block = integers.widen(program.root ?? 0)

    const last = integers.widen(control.block_first[block]) +
        integers.widen(control.block_count[block]) - 1

    const root = control.results[integers.widen(control.statement_payloads[last])]

    if (root == null) {
        return {
            ...empty,
            kind: Kind.Invalid
        }
    }

    const row = integers.widen(root)
    const payload = integers.widen(expressions.payloads[row])

    return match expressions.kinds[row] {
        ExpressionKind.Integer => {
            ...empty,
            kind: Kind.Integer,
            number: expressions.integers[payload]
        },
        ExpressionKind.NegativeInteger => {
            ...empty,
            kind: Kind.Negative,
            number: expressions.negative_integers[payload]
        },
        ExpressionKind.String => {
            ...empty,
            kind: Kind.String,
            text: expressions.strings[payload]
        },
        ExpressionKind.Boolean => {
            ...empty,
            kind: Kind.Boolean,
            number: expressions.booleans[payload] ? 1 : 0
        },
        ExpressionKind.EnumValue => {
            ...empty,
            kind: Kind.Enumeration,
            number: integers.widen(expressions.enumerations[payload])
        },
        _ => {
            ...empty,
            kind: Kind.Invalid
        }
    }
}
