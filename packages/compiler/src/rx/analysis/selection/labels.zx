import bytes from "std:bytes"

import { empty_slot, hash_capacity_factor, linear_case_limit } from "./const"
import read from "./label"
import { Kind } from "./model"
import previous from "./previous"
import probe from "./probe"

import type { Checked, Labels } from "./model"

export type Input = Labels

export type Output = Checked

export default function (in: Input): Output {
    const count = in.length

    const slots: u64[] = match {
        count > linear_case_limit => bytes.repeat(
            count * hash_capacity_factor,
            0
        ).map(byte => empty_slot)[0],
        _ => []
    }

    const failure: u64? = null

    return loop({
        index: 0,
        slots,
        failure,
        duplicate: false,
        has_default: false
    }, {
        while: state => state.failure == null && state.index < count,
        next: state => {
            const value = read({
                labels: in,
                index: state.index
            })

            if (value.kind == Kind.Invalid) {
                state.failure = state.index
            } else if (value.kind == Kind.Default) {
                state.has_default = true
            } else {
                if (state.slots.length == 0) {
                    state.duplicate = previous({
                        labels: in,
                        index: state.index,
                        value
                    })
                } else {
                    const found = probe({
                        labels: in,
                        slots: state.slots,
                        value
                    })

                    state.duplicate = found.duplicate

                    if (!found.duplicate) {
                        state.slots[found.slot] = state.index + 1
                    }
                }

                if (state.duplicate) {
                    state.failure = state.index
                }
            }

            state.index += 1
        },
        return: state => ({
            failure: {
                index: state.failure,
                duplicate: state.duplicate
            },
            has_default: state.has_default
        })
    })
}
