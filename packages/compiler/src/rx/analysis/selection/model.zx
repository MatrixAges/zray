import type { Control, Expressions } from "memory/columns"

export enum Kind {
    Default,
    Invalid,
    Integer,
    Negative,
    String,
    Boolean,
    Enumeration
}

export type LabelView = {
    control: Control,
    expressions: Expressions,
    root?: u32
}

export type Labels = LabelView?[]

export type Label = {
    kind: Kind,
    number: u64,
    text: string
}

export type Subject = {
    type_id: u32,
    enum_members?: u64,
    case_count: u64
}

export type Coverage = {
    valid: bool,
    exhaustive: bool
}

export type Failure = {
    index?: u64,
    duplicate: bool
}

export type Checked = {
    failure: Failure,
    has_default: bool
}

export type Input = {
    subject: Subject,
    labels: Labels
}

export type Output = {
    coverage: Coverage,
    failure: Failure
}
