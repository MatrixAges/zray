import equal from "./equal"
import read from "./label"

import type { Label, Labels } from "./model"

export type Input = {
    labels: Labels,
    index: u64,
    value: Label
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        cursor: 0,
        found: false
    }, {
        while: state => !state.found && state.cursor < in.index,
        next: state => {
            const previous = read({
                labels: in.labels,
                index: state.cursor
            })

            state.found = equal({
                left: previous,
                right: in.value
            })

            state.cursor += 1
        },
        return: state => state.found
    })
}
