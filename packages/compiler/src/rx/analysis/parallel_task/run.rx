<Module>
    <Type from="model" as="Task" />

    <Args in={Task.Input} out={u32} />

    <Call fn="host.compileParallelTaskBody" in={$in.frame} />
    <Call fn="host.checkParallelTaskCalls" in={$in.frame} />
    <Call fn="host.resolveParallelTaskCaptures" in={$in.frame} />
    <Call fn="host.lowerParallelTaskProgram" in={$in.frame} />
    <Call fn="host.checkParallelTaskProgram" in={$in.frame} />
    <Call fn="host.analyzeParallelTaskOwnership" in={$in.frame} />
    <Call fn="host.validateParallelTaskProgram" in={$in.frame} />
    <Call fn="host.buildParallelTaskArgument" in={$in.frame} />
    <Call fn="../project/flow/traversal/select_result" in={$in.results} />

    <Call
        fn="host.publishParallelTask"
        in={[
            $in.frame,
            $ctx.select_result.row,
            $ctx.select_result.visible
        ]}
    />

    <Return value={$ctx.publishParallelTask} />
</Module>
