import memory from "memory"

import type { ColumnLengths } from "memory"

export type Input = {
    active: ColumnLengths,
    slot: u32,
    value?: u32
}

export type Output = {
    slot: u32,
    bindings: u64,
    value?: u32
}

export default function (in: Input): Output {
    return {
        slot: in.slot,
        bindings: memory.readLengthSlot(in.active, 0),
        value: in.value
    }
}
