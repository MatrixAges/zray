import { Action, Stage } from "./model"

export type Input = Action

export type Output = Stage

export default function (in: Input): Output {
    return match in {
        Action.Done => Stage.Done,
        Action.Calls => Stage.Emit,
        Action.Parallel => Stage.Emit,
        Action.Return => Stage.Emit,
        Action.ReturnBorrowed => Stage.Emit,
        Action.OpenTask => Stage.Enter,
        Action.OpenSelection => Stage.Enter,
        Action.OpenCase => Stage.Enter,
        _ => Stage.Leave
    }
}
