import integers from "std:integer"
import memory from "memory"

import type { Scopes } from "./workflow"

export type Input = {
    scopes: Scopes,
    slot: u32
}

export type Output = void

export default function (in: Input): Output {
    const { scopes, slot } = in

    const count = memory.readU64(scopes.bindings, integers.widen(slot))

    memory.shrinkLengthSlot(scopes.active, 0, count)
}
