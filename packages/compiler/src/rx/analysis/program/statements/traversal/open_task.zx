import integers from "std:integer"

import { Action } from "./model"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const unit = integers.widen(in.shape.steps.firsts[in.position])

    return {
        action: Action.OpenTask,
        next: in.position + 1,
        first: in.shape.units.firsts[unit],
        count: in.shape.units.counts[unit]
    }
}
