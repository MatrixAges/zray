import type { Steps, Units } from "../../control/model"

export enum Region {
    Root,
    Task,
    Selection,
    Case
}

export enum Action {
    Done,
    Calls,
    Parallel,
    Return,
    ReturnBorrowed,
    OpenTask,
    OpenSelection,
    OpenCase,
    CloseTask,
    EvaluateTask,
    BindTask,
    CloseSelection,
    CloseCase
}

export type Shape = {
    steps: Steps,
    units: Units,
    cases: u32[]
}

export type Input = {
    shape: Shape,
    region: Region,
    position: u64,
    end: u64,
    scope_step: u64,
    case_first: u32,
    borrow_root: bool
}

export type Output = {
    action: Action,
    next: u64,
    first?: u32,
    count?: u32,
    unit?: u32,
    target?: u32,
    exhaustive?: bool
}

export type Config = {
    shape: Shape,
    layout: u32[],
    borrow_root: bool
}

export type Frame = {
    region: Region,
    block: u32,
    position: u64,
    end: u64,
    step: u64,
    target: u32,
    cases: u32
}

export type Event = {
    action: Action,
    block: u32,
    first: u32,
    count: u32,
    slot: u32,
    exhaustive: bool
}

export type Schedule = {
    events: Event[],
    slots: u64
}
