import frames from "rx_statement_frame"

import { invalid_module } from "./const"
import { Action } from "./model"

import type { Effect } from "./driver_model"

export type Input = Effect

export type Output = u8

export default function (in: Input): Output {
    const { context, action, first, count, unit, target, position } = in

    if (first == null || count == null) {
        return invalid_module
    }

    frames.seek(context, in.next)

    if (action == Action.OpenTask) {
        return frames.pushTask(context, position, first, count)
    }

    if (action == Action.OpenSelection) {
        return frames.pushSelection(context, position, first, count)
    }

    if (unit != null && target != null) {
        return frames.pushCase(context, position, first, count, unit, target)
    }

    return invalid_module
}
