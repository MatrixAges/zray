<Module>
    <Type from="model" as="Calls" />
    <Type from="../workflow" as="Traversal" />

    <Args in={Calls.Batch} out={Traversal.Effect} />

    <Call fn="target" in={$in} />

    <Call
        module="invoke"
        in={{
            item: $ctx.target
        }}
    />

    <If on={$in.parallel_first != null}>
        <Call
            module="parallel_member"
            in={{
                control: $in.control,
                position: $in.parallel_first + $in.offset,
                value: $ctx.invoke
            }}
        />

        <Return
            value={{
                member: $ctx.parallel_member
            }}
        />
    </If>

    <Call
        module="publish_call"
        in={{
            control: $in.control,
            value: $ctx.invoke
        }}
    />

    <Return value={$ctx.publish_call} />
</Module>
