<Module>
    <Type from="model" as="Calls" />

    <Args in={Calls.Batch} out={Calls.Batch} />

    <Call fn="target" in={$in} />

    <Call
        module="invoke"
        in={{
            frame: $in.frame,
            item: $ctx.target
        }}
    />

    <If on={$in.parallel_first != null}>
        <Call
            module="parallel_member"
            in={{
                frame: $in.frame,
                control: $in.control,
                position: $in.parallel_first + $in.offset,
                value: $ctx.invoke
            }}
        />

        <Return
            value={{
                ...$in,
                offset: $in.offset + 1,
                published: $in.published + ($ctx.parallel_member ? 1 : 0)
            }}
        />

        <Else>
            <Call
                module="publish_call"
                in={{
                    frame: $in.frame,
                    control: $in.control,
                    value: $ctx.invoke
                }}
            />
        </Else>
    </If>

    <Return
        value={{
            ...$in,
            offset: $in.offset + 1
        }}
    />
</Module>
