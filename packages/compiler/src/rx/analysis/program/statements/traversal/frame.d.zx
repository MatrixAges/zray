export type Context = opaque

export type Snapshot = opaque

export declare function inspect(context: Context, target: Snapshot): u8
export declare function seek(context: Context, position: u64): void

export declare function writeCalls(context: Context, position: u64, end: u64): u8
export declare function writeParallel(context: Context, first: u32, count: u32): u8
export declare function writeReturn(context: Context, position: u64, borrowed: bool): u8

export declare function pushTask(
    context: Context,
    position: u64,
    first: u32,
    count: u32
): u8
export declare function pushSelection(
    context: Context,
    position: u64,
    first: u32,
    count: u32
): u8
export declare function pushCase(
    context: Context,
    position: u64,
    first: u32,
    count: u32,
    unit: u32,
    target: u32
): u8

export declare function writeCase(context: Context): u8
export declare function writeSelection(
    context: Context,
    count: u32,
    exhaustive: bool
): void

export declare function evaluateTask(context: Context): u8
export declare function writeTaskEvaluation(context: Context): void
export declare function defineTaskBinding(context: Context): u8
export declare function publishTaskBinding(context: Context): u8
export declare function restoreScope(context: Context): void
export declare function pop(context: Context): void
