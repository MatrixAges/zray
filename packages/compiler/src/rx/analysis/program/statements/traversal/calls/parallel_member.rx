<Module>
    <Type from="../workflow" as="Traversal" />
    <Type from="../../../control/write/parallel_member" as="Member" />

    <Args in={Traversal.CallMember} out={Member.Row} />

    <Call
        fn="../host.registerBodyCallResult"
        in={[
            $in.frame,
            $in.value,
            true
        ]}
    />

    <Return
        value={{
            position: $in.position,
            symbol: $ctx.registerBodyCallResult,
            value: $in.value
        }}
    />
</Module>
