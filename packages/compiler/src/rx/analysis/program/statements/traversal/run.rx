<Module>
    <Type from="workflow" as="Traversal" />
    <Type from="publication" as="Publication" />

    <Args in={Traversal.Request} out={Traversal.Output} />

    <Store from="publication" as="publication" />

    <If on={!$in.started}>
        <Call
            fn="walk"
            in={$in.pick([
                "shape",
                "layout",
                "borrow_root"
            ])}
        />

        <Call
            fn="stage"
            in={{
                step: Publication.Step.Reserve,
                slots: $ctx.walk.slots
            }}
            setter={[$store.publication.effect]}
        />

        <Return
            value={{
                events: $ctx.walk.events
            }}
        />
    </If>

    <If on={$in.row < $in.events.length}>
        <Call
            module="step"
            in={{
                control: $in.control,
                scopes: $in.scopes,
                events: $in.events,
                call_ids: $in.shape.steps.firsts,
                row: $in.row,
                offset: $in.offset
            }}
        />

        <Return
            value={{
                next: {
                    row: $ctx.step.offset == null ? $in.row + 1 : $in.row,
                    offset: $ctx.step.offset ?? 0,
                    implicit_return: $in.implicit_return,
                    effect: $ctx.step.effect
                }
            }}
        />
    </If>

    <Call
        fn="stage"
        in={{
            step: Publication.Step.SelectWriter,
            block: $in.root
        }}
        setter={[$store.publication.effect]}
    />

    <If on={$in.implicit_return}>
        <Call
            fn="../../control/write/result"
            in={{
                writer: $in.control.writer
            }}
        />

        <Return
            value={{
                next: {
                    row: $in.row,
                    offset: 0,
                    implicit_return: false,
                    effect: {
                        statement: $ctx.result
                    }
                }
            }}
        />
    </If>

    <Call
        fn="../../control/write/block_id"
        in={{
            layout: $in.control.layout,
            unit: $in.root
        }}
    />

    <Call
        fn="../../control/write/finish_block"
        in={{
            control: $in.control,
            block: $ctx.block_id,
            expected: $in.expected
        }}
    />

    <Call fn="host.requireBodyBlock" />

    <Return
        value={{
            block: $ctx.block_id
        }}
    />
</Module>
