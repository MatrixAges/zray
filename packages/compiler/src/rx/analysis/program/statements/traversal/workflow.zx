import type { ColumnLengths } from "memory"
import type { BodyStatements } from "rx_project_host"
import type { Row as CaseMember } from "../../control/write/case_member"
import type { Row as ParallelMember } from "../../control/write/parallel_member"
import type { Control, Statement } from "../../control/write/publication"
import type { Config, Event } from "./model"
import type { Output as SavedScope } from "./scope_save"

export type Scopes = {
    active: ColumnLengths,
    bindings: u64[],
    values: u32?[]
}

export type Request = Config & {
    frame: BodyStatements,
    control: Control,
    scopes: Scopes,
    root: u32,
    expected: u32[],
    implicit_return: bool,
    started: bool,
    events: Event[],
    row: u64,
    offset: u32
}

export type Scan =
    Request.Pick("frame", "control", "scopes", "events", "row", "offset") & {
        call_ids: u32[]
    }

export type Write = Scan.Pick("frame", "control", "scopes", "call_ids", "offset") & {
    event: Event
}

export type Task = Write.Pick("frame", "control", "scopes", "event")

export type CallResult = Write.Pick("frame", "control") & {
    value: u32
}

export type CallMember = CallResult & {
    position: u32
}

export type Effect = {
    statement?: Statement,
    member?: ParallelMember,
    case_member?: CaseMember,
    scope?: SavedScope,
    restore?: u64,
    binding?: u32,
    bindings?: u32[]
}

export type Step = {
    effect: Effect,
    offset?: u32
}

export type Next = {
    row: u64,
    offset: u32,
    implicit_return: bool,
    effect: Effect
}

export type Output = {
    events?: Event[],
    next?: Next,
    block?: u32
}
