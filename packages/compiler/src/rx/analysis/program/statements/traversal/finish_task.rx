<Module>
    <Type from="model" as="Plan" />
    <Type from="workflow" as="Traversal" />
    <Type from="publication" as="Publication" />

    <Args in={Traversal.Task} out={Traversal.Effect} />

    <Store from="publication" as="publication" />

    <Task name="evaluate_body_value" out={$ctx.read_id}>
        <Call
            fn="stage"
            in={{
                step: Publication.Step.EvaluateValue,
                row: $in.event.first,
                borrowed: false
            }}
            setter={[$store.publication.effect]}
        />

        <Call fn="read_id" in={$store.publication.effect} />
    </Task>

    <Call
        fn="scope_restore"
        in={{
            scopes: $in.scopes,
            slot: $in.event.slot
        }}
    />

    <If on={$in.event.action == Plan.Action.BindTask}>
        <Task name="define_body_task_binding" out={$ctx.read_id}>
            <Call
                fn="stage"
                in={{
                    step: Publication.Step.DefineTask,
                    row: $in.event.first,
                    value: $ctx.task.evaluate_body_value
                }}
                setter={[$store.publication.effect]}
            />

            <Call fn="read_id" in={$store.publication.effect} />
        </Task>

        <Call
            fn="../../control/write/binding"
            in={{
                writer: $in.control.writer,
                symbol: $ctx.task.define_body_task_binding,
                value: $ctx.task.evaluate_body_value
            }}
        />

        <Return
            value={{
                statement: $ctx.binding,
                restore: $ctx.scope_restore,
                binding: $ctx.task.define_body_task_binding
            }}
        />
    </If>

    <Call
        fn="../../control/write/binding"
        in={{
            writer: $in.control.writer,
            value: $ctx.task.evaluate_body_value
        }}
    />

    <Return
        value={{
            statement: $ctx.binding,
            restore: $ctx.scope_restore
        }}
    />
</Module>
