<Module>
    <Type from="model" as="Plan" />
    <Type from="workflow" as="Traversal" />

    <Args in={Traversal.Task} out={Traversal.Effect} />

    <Call
        fn="host.evaluateBodyValue"
        in={[
            $in.frame,
            $in.event.first,
            false
        ]}
    />

    <Call
        fn="scope_restore"
        in={{
            scopes: $in.scopes,
            slot: $in.event.slot
        }}
    />

    <If on={$in.event.action == Plan.Action.BindTask}>
        <Call
            fn="host.defineBodyTaskBinding"
            in={[
                $in.frame,
                $in.event.first,
                $ctx.evaluateBodyValue
            ]}
        />

        <Call
            fn="../../control/write/binding"
            in={{
                writer: $in.control.writer,
                symbol: $ctx.defineBodyTaskBinding,
                value: $ctx.evaluateBodyValue
            }}
        />

        <Return
            value={{
                statement: $ctx.binding,
                restore: $ctx.scope_restore,
                binding: $ctx.defineBodyTaskBinding
            }}
        />
    </If>

    <Call
        fn="../../control/write/binding"
        in={{
            writer: $in.control.writer,
            value: $ctx.evaluateBodyValue
        }}
    />

    <Return
        value={{
            statement: $ctx.binding,
            restore: $ctx.scope_restore
        }}
    />
</Module>
