<Module>
    <Type from="workflow" as="Traversal" />
    <Type from="publication" as="Publication" />

    <Args in={Traversal.Scan} out={Traversal.Step} />

    <Store from="publication" as="publication" />

    <Call
        fn="stage"
        in={{
            step: Publication.Step.SelectWriter,
            block: $in.events[$in.row].block
        }}
        setter={[$store.publication.effect]}
    />

    <Call
        module="apply"
        in={{
            control: $in.control,
            scopes: $in.scopes,
            event: $in.events[$in.row],
            call_ids: $in.call_ids,
            offset: $in.offset
        }}
    />

    <Return value={$ctx.apply} />
</Module>
