import integers from "std:integer"
import memory from "memory"
import frames from "rx_statement_frame"

import {
    case_first_slot,
    case_region,
    end_slot,
    position_slot,
    scope_step_slot,
    selection_region,
    task_region
} from "./const"
import { Region } from "./model"

import type { Driver } from "./driver_model"
import type { Input as Frame } from "./model"

export type Input = Driver

export type Output = Frame

export default function (in: Input): Output {
    const { cursor } = in

    const region = match frames.inspect(in.context, in.snapshot_target) {
        task_region => Region.Task,
        selection_region => Region.Selection,
        case_region => Region.Case,
        _ => Region.Root
    }

    return {
        shape: in.shape,
        borrow_root: in.borrow_root,
        region,
        position: memory.readU64(cursor, position_slot),
        end: memory.readU64(cursor, end_slot),
        scope_step: memory.readU64(cursor, scope_step_slot),
        case_first: integers.narrow(memory.readU64(cursor, case_first_slot))
    }
}
