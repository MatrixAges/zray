<Module>
    <Type from="../host" as="Body" />

    <Args in={Body.BodyStatements} out={void} />

    <Call fn="../host.prepareBodyImport" in={$in} />

    <If on={$ctx.prepareBodyImport.addition}>
        <Call fn="../host.appendBodyFunctionTail" in={$in} />
    </If>

    <If on={$ctx.prepareBodyImport.needs_initializers}>
        <Call fn="../host.linkBodyInitializers" in={$in} />
    </If>

    <If on={$ctx.prepareBodyImport.addition}>
        <Call fn="../host.appendBodyFunctionEntry" in={$in} />
    </If>
</Module>
