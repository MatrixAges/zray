<Module>
    <Type from="model" as="Plan" />
    <Type from="workflow" as="Traversal" />

    <Args in={Traversal.Write} out={void} />

    <Switch on={$in.event.action}>
        <Case value={Plan.Action.Calls}>
            <Call
                module="calls/run"
                in={{
                    frame: $in.frame,
                    indices: $in.call_ids,
                    first: $in.event.first,
                    count: $in.event.count,
                    offset: 0,
                    published: 0
                }}
            />
        </Case>

        <Case value={Plan.Action.Parallel}>
            <Call fn="host.bodyParallelStart" in={$in.frame} />

            <Call
                module="calls/run"
                in={{
                    frame: $in.frame,
                    indices: $in.call_ids,
                    first: $in.event.first,
                    count: $in.event.count,
                    offset: 0,
                    parallel_first: $ctx.bodyParallelStart,
                    published: 0
                }}
            />

            <Call
                fn="host.publishBodyParallel"
                in={[
                    $in.frame,
                    $in.event.count,
                    $ctx.run
                ]}
            />
        </Case>

        <Case value={Plan.Action.Return}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    false
                ]}
            />

            <Call
                fn="host.emitBodyReturn"
                in={[
                    $in.frame,
                    $ctx.evaluateBodyValue
                ]}
            />
        </Case>

        <Case value={Plan.Action.ReturnBorrowed}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    true
                ]}
            />

            <Call
                fn="host.emitBodyReturn"
                in={[
                    $in.frame,
                    $ctx.evaluateBodyValue
                ]}
            />
        </Case>

        <Case value={Plan.Action.OpenTask}>
            <Call
                fn="host.saveBodyScope"
                in={[
                    $in.frame,
                    $in.event.slot,
                    null
                ]}
            />
        </Case>

        <Case value={Plan.Action.OpenSelection}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    false
                ]}
            />

            <Call
                fn="host.saveBodyScope"
                in={[
                    $in.frame,
                    $in.event.slot,
                    $ctx.evaluateBodyValue
                ]}
            />
        </Case>

        <Case value={Plan.Action.OpenCase}>
            <Call
                fn="host.evaluateBodyCaseLabel"
                in={[
                    $in.frame,
                    $in.event.first
                ]}
            />

            <Call
                fn="host.saveBodyScope"
                in={[
                    $in.frame,
                    $in.event.slot,
                    $ctx.evaluateBodyCaseLabel
                ]}
            />

            <Call fn="host.initializeBodyCase" in={$in.frame} />
        </Case>

        <Case value={Plan.Action.CloseTask}>
            <Call
                fn="host.restoreBodyScope"
                in={[
                    $in.frame,
                    $in.event.slot
                ]}
            />
        </Case>

        <Case value={Plan.Action.EvaluateTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "frame",
                    "event"
                ])}
            />
        </Case>

        <Case value={Plan.Action.BindTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "frame",
                    "event"
                ])}
            />
        </Case>

        <Case value={Plan.Action.CloseSelection}>
            <Call
                fn="host.emitBodySelection"
                in={[
                    $in.frame,
                    $in.event.slot,
                    $in.event.count,
                    $in.event.exhaustive
                ]}
            />
        </Case>

        <Case value={Plan.Action.CloseCase}>
            <Call
                fn="host.emitBodyCase"
                in={[
                    $in.frame,
                    $in.event.slot,
                    $in.event.first,
                    $in.event.count
                ]}
            />

            <Call
                fn="host.restoreBodyScope"
                in={[
                    $in.frame,
                    $in.event.slot
                ]}
            />
        </Case>
    </Switch>
</Module>
