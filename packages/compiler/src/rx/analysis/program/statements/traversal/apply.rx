<Module>
    <Type from="model" as="Plan" />
    <Type from="workflow" as="Traversal" />

    <Args in={Traversal.Write} out={void} />

    <Switch on={$in.event.action}>
        <Case value={Plan.Action.Calls}>
            <Call
                module="calls/run"
                in={{
                    frame: $in.frame,
                    control: $in.control,
                    bindings: $in.scopes.active,
                    indices: $in.call_ids,
                    first: $in.event.first,
                    count: $in.event.count,
                    offset: 0,
                    published: 0
                }}
            />
        </Case>

        <Case value={Plan.Action.Parallel}>
            <Call fn="../../control/write/parallel_start" in={$in.control.writer} />

            <Call
                module="calls/run"
                in={{
                    frame: $in.frame,
                    control: $in.control,
                    bindings: $in.scopes.active,
                    indices: $in.call_ids,
                    first: $in.event.first,
                    count: $in.event.count,
                    offset: 0,
                    parallel_first: $ctx.parallel_start,
                    published: 0
                }}
            />

            <Call
                module="../../control/write/publish_parallel"
                in={{
                    resource: $in.control.resource,
                    bindings: $in.control.bindings,
                    writer: $in.control.writer,
                    first: $ctx.parallel_start,
                    count: $in.event.count,
                    published: $ctx.run
                }}
            />
        </Case>

        <Case value={Plan.Action.Return}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    false
                ]}
            />

            <Call
                fn="../../control/write/result"
                in={{
                    writer: $in.control.writer,
                    value: $ctx.evaluateBodyValue
                }}
            />
        </Case>

        <Case value={Plan.Action.ReturnBorrowed}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    true
                ]}
            />

            <Call
                fn="../../control/write/result"
                in={{
                    writer: $in.control.writer,
                    value: $ctx.evaluateBodyValue
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenTask}>
            <Call
                fn="scope_save"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot,
                    value: null
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenSelection}>
            <Call
                fn="host.evaluateBodyValue"
                in={[
                    $in.frame,
                    $in.event.first,
                    false
                ]}
            />

            <Call
                fn="scope_save"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot,
                    value: $ctx.evaluateBodyValue
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenCase}>
            <Call
                fn="host.evaluateBodyCaseLabel"
                in={[
                    $in.frame,
                    $in.event.first
                ]}
            />

            <Call
                fn="scope_save"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot,
                    value: $ctx.evaluateBodyCaseLabel
                }}
            />

            <Call fn="host.initializeBodyCase" in={$in.frame} />
        </Case>

        <Case value={Plan.Action.CloseTask}>
            <Call
                fn="scope_restore"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot
                }}
            />
        </Case>

        <Case value={Plan.Action.EvaluateTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "frame",
                    "control",
                    "scopes",
                    "event"
                ])}
            />
        </Case>

        <Case value={Plan.Action.BindTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "frame",
                    "control",
                    "scopes",
                    "event"
                ])}
            />
        </Case>

        <Case value={Plan.Action.CloseSelection}>
            <Call
                fn="scope_value"
                in={{
                    values: $in.scopes.values,
                    slot: $in.event.slot
                }}
            />

            <If on={$ctx.scope_value != null}>
                <Call
                    fn="../../control/write/selection"
                    in={{
                        writer: $in.control.writer,
                        subject: $ctx.scope_value,
                        count: $in.event.count,
                        exhaustive: $in.event.exhaustive
                    }}
                />

                <Else>
                    <Call fn="host.requireBodyBlock" in={false} />
                </Else>
            </If>
        </Case>

        <Case value={Plan.Action.CloseCase}>
            <Call
                fn="scope_value"
                in={{
                    values: $in.scopes.values,
                    slot: $in.event.slot
                }}
            />

            <Call
                module="../../control/write/publish_case"
                in={{
                    control: $in.control,
                    unit: $in.event.block,
                    end: $in.event.count,
                    position: $in.event.first,
                    label: $ctx.scope_value
                }}
            />

            <Call
                fn="scope_restore"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot
                }}
            />
        </Case>
    </Switch>
</Module>
