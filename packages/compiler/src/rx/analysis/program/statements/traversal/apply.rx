<Module>
    <Type from="model" as="Plan" />
    <Type from="workflow" as="Traversal" />
    <Type from="publication" as="Publication" />

    <Args in={Traversal.Write} out={Traversal.Step} />

    <Store from="publication" as="publication" />

    <Switch on={$in.event.action}>
        <Case value={Plan.Action.Calls}>
            <Call
                module="calls/step"
                in={{
                    control: $in.control,
                    indices: $in.call_ids,
                    first: $in.event.first,
                    offset: $in.offset
                }}
            />

            <Return
                value={{
                    effect: $ctx.step,
                    offset: $in.offset + 1 < $in.event.count ? $in.offset + 1 : null
                }}
            />
        </Case>

        <Case value={Plan.Action.Parallel}>
            <Call fn="../../control/write/parallel_start" in={$in.control.writer} />

            <If on={$in.offset < $in.event.count}>
                <Call
                    module="calls/step"
                    in={{
                        control: $in.control,
                        indices: $in.call_ids,
                        first: $in.event.first,
                        offset: $in.offset,
                        parallel_first: $ctx.parallel_start
                    }}
                />

                <Return
                    value={{
                        effect: $ctx.step,
                        offset: $in.offset + 1
                    }}
                />
            </If>

            <Call
                module="../../control/write/publish_parallel"
                in={{
                    writer: $in.control.writer,
                    first: $ctx.parallel_start,
                    count: $in.event.count
                }}
            />

            <Return
                value={{
                    effect: {
                        statement: $ctx.publish_parallel.statement,
                        bindings: $ctx.publish_parallel.bindings
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.Return}>
            <Task name="evaluate_body_value" out={$ctx.read_id}>
                <Call
                    fn="stage"
                    in={{
                        step: Publication.Step.EvaluateValue,
                        row: $in.event.first,
                        borrowed: false
                    }}
                    setter={[$store.publication.effect]}
                />

                <Call fn="read_id" in={$store.publication.effect} />
            </Task>

            <Call
                fn="../../control/write/result"
                in={{
                    writer: $in.control.writer,
                    value: $ctx.task.evaluate_body_value
                }}
            />

            <Return
                value={{
                    effect: {
                        statement: $ctx.result
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.ReturnBorrowed}>
            <Task name="evaluate_body_value" out={$ctx.read_id}>
                <Call
                    fn="stage"
                    in={{
                        step: Publication.Step.EvaluateValue,
                        row: $in.event.first,
                        borrowed: true
                    }}
                    setter={[$store.publication.effect]}
                />

                <Call fn="read_id" in={$store.publication.effect} />
            </Task>

            <Call
                fn="../../control/write/result"
                in={{
                    writer: $in.control.writer,
                    value: $ctx.task.evaluate_body_value
                }}
            />

            <Return
                value={{
                    effect: {
                        statement: $ctx.result
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenTask}>
            <Call
                fn="scope_save"
                in={{
                    active: $in.scopes.active,
                    slot: $in.event.slot,
                    value: null
                }}
            />

            <Return
                value={{
                    effect: {
                        scope: $ctx.scope_save
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenSelection}>
            <Task name="evaluate_body_value" out={$ctx.read_id}>
                <Call
                    fn="stage"
                    in={{
                        step: Publication.Step.EvaluateValue,
                        row: $in.event.first,
                        borrowed: false
                    }}
                    setter={[$store.publication.effect]}
                />

                <Call fn="read_id" in={$store.publication.effect} />
            </Task>

            <Call
                fn="scope_save"
                in={{
                    active: $in.scopes.active,
                    slot: $in.event.slot,
                    value: $ctx.task.evaluate_body_value
                }}
            />

            <Return
                value={{
                    effect: {
                        scope: $ctx.scope_save
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.OpenCase}>
            <Task name="evaluate_body_case_label" out={$ctx.read_optional_id}>
                <Call
                    fn="stage"
                    in={{
                        step: Publication.Step.EvaluateLabel,
                        row: $in.event.first
                    }}
                    setter={[$store.publication.effect]}
                />

                <Call fn="read_optional_id" in={$store.publication.effect} />
            </Task>

            <Call
                fn="scope_save"
                in={{
                    active: $in.scopes.active,
                    slot: $in.event.slot,
                    value: $ctx.task.evaluate_body_case_label
                }}
            />

            <Call
                fn="stage"
                in={{
                    step: Publication.Step.InitializeCase
                }}
                setter={[$store.publication.effect]}
            />

            <Return
                value={{
                    effect: {
                        scope: $ctx.scope_save
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.CloseTask}>
            <Call
                fn="scope_restore"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot
                }}
            />

            <Return
                value={{
                    effect: {
                        restore: $ctx.scope_restore
                    }
                }}
            />
        </Case>

        <Case value={Plan.Action.EvaluateTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "control",
                    "scopes",
                    "event"
                ])}
            />

            <Return
                value={{
                    effect: $ctx.finish_task
                }}
            />
        </Case>

        <Case value={Plan.Action.BindTask}>
            <Call
                module="finish_task"
                in={$in.pick([
                    "control",
                    "scopes",
                    "event"
                ])}
            />

            <Return
                value={{
                    effect: $ctx.finish_task
                }}
            />
        </Case>

        <Case value={Plan.Action.CloseSelection}>
            <Call
                fn="scope_value"
                in={{
                    values: $in.scopes.values,
                    slot: $in.event.slot
                }}
            />

            <If on={$ctx.scope_value != null}>
                <Call
                    fn="../../control/write/selection"
                    in={{
                        writer: $in.control.writer,
                        subject: $ctx.scope_value,
                        count: $in.event.count,
                        exhaustive: $in.event.exhaustive
                    }}
                />

                <Return
                    value={{
                        effect: {
                            statement: $ctx.selection
                        }
                    }}
                />

                <Else>
                    <Call fn="host.requireBodyBlock" in={false} />
                </Else>
            </If>

            <Return
                value={{
                    effect: {}
                }}
            />
        </Case>

        <Case value={Plan.Action.CloseCase}>
            <Call
                fn="scope_value"
                in={{
                    values: $in.scopes.values,
                    slot: $in.event.slot
                }}
            />

            <Call
                module="../../control/write/publish_case"
                in={{
                    control: $in.control,
                    unit: $in.event.block,
                    end: $in.event.count,
                    position: $in.event.first,
                    label: $ctx.scope_value
                }}
            />

            <Call
                fn="scope_restore"
                in={{
                    scopes: $in.scopes,
                    slot: $in.event.slot
                }}
            />

            <Return
                value={{
                    effect: {
                        case_member: $ctx.publish_case,
                        restore: $ctx.scope_restore
                    }
                }}
            />
        </Case>
    </Switch>

    <Return
        value={{
            effect: {}
        }}
    />
</Module>
