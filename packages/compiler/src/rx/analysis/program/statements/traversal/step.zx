import { Kind } from "../../control/model"
import { Action } from "./model"

export type Input = {
    kinds: Kind[],
    position: u64
}

export type Output = Action

export default function (in: Input): Output {
    return match in.kinds[in.position] {
        Kind.Call => Action.Call,
        Kind.Parallel => Action.Parallel,
        Kind.Return => Action.Return,
        Kind.Task => Action.OpenTask,
        _ => Action.OpenSelection
    }
}
