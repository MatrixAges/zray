<Module>
    <Type from="model" as="Traversal" />

    <Args in={Traversal.Input} out={Traversal.Output} />

    <If on={$in.position == $in.end}>
        <Call fn="finish" in={$in.region} />

        <Return
            value={{
                action: $ctx.finish,
                next: $in.position
            }}
        />
    </If>

    <If on={$in.region == Traversal.Region.Selection}>
        <Return
            value={{
                action: Traversal.Action.OpenCase,
                next: $in.position + 1
            }}
        />
    </If>

    <Call
        fn="step"
        in={$in.pick([
            "kinds",
            "position"
        ])}
    />

    <Return
        value={{
            action: $ctx.step,
            next: $in.position + 1
        }}
    />
</Module>
