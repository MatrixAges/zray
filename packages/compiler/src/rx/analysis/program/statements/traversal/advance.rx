<Module>
    <Type from="model" as="Traversal" />

    <Args in={Traversal.Input} out={Traversal.Batch} />

    <Call fn="call_end" in={$in} />

    <Call
        module="step"
        in={{
            ...$in,
            position: $ctx.call_end
        }}
    />

    <Return
        value={{
            ...$ctx.step,
            position: $ctx.call_end,
            pop: $ctx.call_end == $in.end && $in.region != Traversal.Region.Root
        }}
    />
</Module>
