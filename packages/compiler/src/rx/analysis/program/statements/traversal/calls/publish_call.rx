<Module>
    <Type from="../workflow" as="Traversal" />

    <Args in={Traversal.CallResult} out={Traversal.Effect} />

    <Call
        fn="../host.registerBodyCallResult"
        in={[
            $in.frame,
            $in.value,
            false
        ]}
    />

    <Call
        fn="../../../control/write/binding"
        in={{
            writer: $in.control.writer,
            symbol: $ctx.registerBodyCallResult,
            value: $in.value
        }}
    />

    <Return
        value={{
            statement: $ctx.binding,
            binding: $ctx.registerBodyCallResult
        }}
    />
</Module>
