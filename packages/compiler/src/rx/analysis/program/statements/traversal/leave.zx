import frames from "rx_statement_frame"

import { advancing, invalid_module } from "./const"
import { Action } from "./model"

import type { Effect } from "./driver_model"

export type Input = Effect

export type Output = u8

export default function (in: Input): Output {
    const { context, action, count, exhaustive } = in

    if (action == Action.CloseSelection) {
        if (count == null || exhaustive == null) {
            return invalid_module
        }

        frames.writeSelection(context, count, exhaustive)
        frames.pop(context)

        return advancing
    }

    if (action == Action.CloseCase) {
        const status = frames.writeCase(context)

        if (status != advancing) {
            return status
        }
    }

    if (action == Action.EvaluateTask || action == Action.BindTask) {
        const evaluated = frames.evaluateTask(context)

        if (evaluated != advancing) {
            return evaluated
        }

        if (action == Action.EvaluateTask) {
            frames.writeTaskEvaluation(context)
        } else {
            const defined = frames.defineTaskBinding(context)

            if (defined != advancing) {
                return defined
            }
        }
    }

    frames.restoreScope(context)

    if (action == Action.BindTask) {
        const status = frames.publishTaskBinding(context)

        if (status != advancing) {
            return status
        }
    }

    frames.pop(context)

    return advancing
}
