import integers from "std:integer"

import { continues, unreachable } from "./const"
import { Status } from "./model"

import type { Output, Row, Units } from "./model"

export type Input = {
    units: Units,
    rows: Row[],
    capture_count: u64,
    void_output: bool
}

export default function (in: Input): Output {
    const last = in.units.firsts.length - 1
    const root = in.rows[last].tag
    const implicit_return = root == continues && in.void_output
    const extra_return = implicit_return ? 1 : 0
    const root_extra = in.capture_count + extra_return

    const status = match {
        root == unreachable => Status.Unreachable,
        root == continues && !in.void_output => Status.Incomplete,
        _ => Status.Ready
    }

    const inline_start: u64? = null
    const block_firsts: u32[] = []
    const block_counts: u32[] = []

    return loop({
        evaluations: 0,
        constants: 0,
        parallels: 0,
        invocations: 0,
        selections: 0,
        cases: 0,
        results: 0,
        statement: 0,
        block_count: 0,
        inline_start,
        unit: 0,
        rows: in.rows,
        block_firsts,
        block_counts
    }, {
        while: state => status == Status.Ready && state.unit <= last,
        next: state => {
            if (in.units.blocks[state.unit]) {
                const inline_start = state.inline_start

                if (inline_start != null) {
                    const head = state.rows[inline_start]

                    state.rows[inline_start] = {
                        ...head,
                        tag: integers.narrow(state.unit)
                    }
                    state.inline_start = null
                }

                const current = state.rows[state.unit]

                state.rows[state.unit] = {
                    evaluations: integers.narrow(state.evaluations),
                    constants: integers.narrow(state.constants),
                    parallels: integers.narrow(state.parallels),
                    invocations: integers.narrow(state.invocations),
                    selections: integers.narrow(state.selections),
                    cases: integers.narrow(state.cases),
                    results: integers.narrow(state.results),
                    tag: integers.narrow(state.block_count)
                }

                state.evaluations += integers.widen(current.evaluations)
                state.constants += integers.widen(current.constants)
                state.parallels += integers.widen(current.parallels)
                state.invocations += integers.widen(current.invocations)
                state.selections += integers.widen(current.selections)
                state.cases += integers.widen(current.cases)
                state.results += integers.widen(current.results)

                const end =
                    state.evaluations +
                    state.constants +
                    state.parallels +
                    state.selections +
                    state.results

                const extra = state.unit == last ? root_extra : 0
                const count = end - state.statement + extra

                state.block_firsts =
                    state.block_firsts.push(integers.narrow(state.statement))[0]
                state.block_counts =
                    state.block_counts.push(integers.narrow(count))[0]

                state.statement = end
                state.block_count += 1
            } else if (state.inline_start == null) {
                state.inline_start = state.unit
            }

            state.unit += 1
        },
        return: state => ({
            status,
            evaluations: state.evaluations,
            constants: state.constants + in.capture_count,
            parallels: state.parallels,
            invocations: state.invocations,
            selections: state.selections,
            cases: state.cases,
            results: state.results + (implicit_return ? 1 : 0),
            implicit_return,
            rows: state.rows,
            block_firsts: state.block_firsts,
            block_counts: state.block_counts
        })
    })
}
