import integers from "std:integer"
import memory from "memory"

import {
    cases_lane,
    constants_lane,
    continues,
    evaluations_lane,
    invocations_lane,
    lane_count,
    parallels_lane,
    results_lane,
    selections_lane,
    tag_lane,
    unreachable
} from "./const"
import exchange from "./exchange"
import { Status } from "./model"

import type { U32Buffer } from "memory"
import type { Blocks, Output, Units } from "./model"

export type Input = {
    units: Units,
    layout: U32Buffer,
    blocks: Blocks,
    capture_count: u64,
    void_output: bool
}

export default function (in: Input): Output {
    const last = in.units.firsts.length - 1
    const layout = in.layout
    const root = memory.readU32(layout, last * lane_count + tag_lane)
    const implicit_return = root == continues && in.void_output
    const extra_return = implicit_return ? 1 : 0
    const root_extra = in.capture_count + extra_return

    const status = match {
        root == unreachable => Status.Unreachable,
        root == continues && !in.void_output => Status.Incomplete,
        _ => Status.Ready
    }

    const inline_start: u64? = null

    return loop({
        evaluations: 0,
        constants: 0,
        parallels: 0,
        invocations: 0,
        selections: 0,
        cases: 0,
        results: 0,
        statement: 0,
        block_count: 0,
        inline_start,
        unit: 0
    }, {
        while: state => status == Status.Ready && state.unit <= last,
        next: state => {
            const row = state.unit * lane_count

            if (in.units.blocks[state.unit]) {
                const inline_start = state.inline_start

                if (inline_start != null) {
                    memory.writeU32(
                        layout,
                        inline_start * lane_count + tag_lane,
                        integers.narrow(state.unit)
                    )
                    state.inline_start = null
                }

                state.evaluations += exchange({
                    layout,
                    position: row + evaluations_lane,
                    replacement: state.evaluations
                })
                state.constants += exchange({
                    layout,
                    position: row + constants_lane,
                    replacement: state.constants
                })
                state.parallels += exchange({
                    layout,
                    position: row + parallels_lane,
                    replacement: state.parallels
                })
                state.invocations += exchange({
                    layout,
                    position: row + invocations_lane,
                    replacement: state.invocations
                })
                state.selections += exchange({
                    layout,
                    position: row + selections_lane,
                    replacement: state.selections
                })
                state.cases += exchange({
                    layout,
                    position: row + cases_lane,
                    replacement: state.cases
                })
                state.results += exchange({
                    layout,
                    position: row + results_lane,
                    replacement: state.results
                })

                memory.writeU32(
                    layout,
                    row + tag_lane,
                    integers.narrow(state.block_count)
                )

                const end =
                    state.evaluations +
                    state.constants +
                    state.parallels +
                    state.selections +
                    state.results

                const extra = state.unit == last ? root_extra : 0
                const count = end - state.statement + extra

                memory.writeU32(
                    in.blocks.firsts,
                    state.block_count,
                    integers.narrow(state.statement)
                )
                memory.writeU32(
                    in.blocks.counts,
                    state.block_count,
                    integers.narrow(count)
                )

                state.statement = end
                state.block_count += 1
            } else if (state.inline_start == null) {
                state.inline_start = state.unit
            }

            state.unit += 1
        },
        return: state => ({
            status,
            evaluations: state.evaluations,
            constants: state.constants + in.capture_count,
            parallels: state.parallels,
            invocations: state.invocations,
            selections: state.selections,
            cases: state.cases,
            results: state.results + (implicit_return ? 1 : 0),
            implicit_return
        })
    })
}
