import integers from "std:integer"

import { continues, returns, unreachable } from "./const"

import type { Row } from "./model"

export type Input = {
    rows: Row[],
    cases: u32[],
    first: u64,
    count: u64,
    exhaustive: bool
}

export type Output = u32

export default function (in: Input): Output {
    const end = in.first + in.count
    const initial = in.exhaustive ? returns : continues

    return loop({
        index: in.first,
        exit: initial
    }, {
        while: state => state.index < end && state.exit != unreachable,
        next: state => {
            const exit = in.rows[integers.widen(in.cases[state.index])].tag

            if (exit == unreachable || exit == continues) {
                state.exit = exit
            }

            state.index += 1
        },
        return: state => state.exit
    })
}
