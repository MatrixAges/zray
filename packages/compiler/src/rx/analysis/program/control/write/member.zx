import memory from "memory"

import type { OptionalU32Buffer, U32Buffer } from "memory"

export type Input = {
    optional: OptionalU32Buffer,
    required: U32Buffer,
    index: u64,
    optional_id?: u32,
    required_id: u32
}

export type Output = void

export default function (in: Input): Output {
    memory.writeOptionalU32(in.optional, in.index, in.optional_id)
    memory.writeU32(in.required, in.index, in.required_id)
}
