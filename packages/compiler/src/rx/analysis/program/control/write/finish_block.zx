import integers from "std:integer"

import { statement_lane } from "../const"

import type { Finish } from "./publication"

export type Input = Finish

export type Output = bool

export default function (in: Input): Output {
    const { firsts, lengths, writer } = in.control

    const block = integers.widen(in.block)
    const first = integers.widen(firsts[block])
    const count = integers.widen(lengths[block])
    const statement = integers.widen(writer.cells[statement_lane])

    if (statement != first + count) {
        return false
    }

    const compared = loop({
        lane: 0,
        equal: true
    }, {
        while: state => state.equal && state.lane < statement_lane,
        next: state => {
            const lane = state.lane
            const actual = writer.cells[lane]

            state.equal = actual == in.expected[lane]
            state.lane += 1
        },
        return: state => state.equal
    })

    return compared
}
