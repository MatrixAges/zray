import type { Cursor } from "./buffers"
import type { Output as Header } from "./header"

export type Control = {
    writer: Cursor,
    layout: u32[],
    firsts: u32[],
    lengths: u32[]
}

export type Finish = {
    control: Control,
    block: u32,
    expected: u32[]
}

export type Case = {
    control: Control,
    unit: u32,
    end: u32,
    position: u32,
    label?: u32
}

export type Statement = {
    header: Header,
    value?: u32,
    symbol?: u32,
    first?: u32,
    count?: u32,
    exhaustive?: bool,
    member_lane?: u64,
    next_member?: u32
}
