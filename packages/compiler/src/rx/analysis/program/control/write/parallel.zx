import { StatementKind } from "core/control_table/model"

import { invocations_lane, parallels_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"
import type { Statement } from "./publication"

export type Input = {
    writer: Cursor,
    count: u32
}

export type Output = Statement

export default function (in: Input): Output {
    const { writer, count } = in

    const first = writer.cells[invocations_lane]

    return {
        header: header({
            writer,
            kind: StatementKind.Parallel,
            row: writer.cells[parallels_lane],
            lane: parallels_lane
        }),
        first,
        count,
        member_lane: invocations_lane,
        next_member: first + count
    }
}
