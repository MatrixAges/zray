import integers from "std:integer"
import { StatementKind } from "core/control_table/model"
import memory from "memory"

import { invocations_lane, parallels_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    count: u32
}

export type Output = void

export default function (in: Input): Output {
    const { writer } = in
    const { columns, cells } = writer

    const row = memory.readU32(cells, parallels_lane)
    const index = integers.widen(row)
    const first = memory.readU32(cells, invocations_lane)

    memory.writeU32(columns.parallel_first, index, first)
    memory.writeU32(columns.parallel_count, index, in.count)

    header({
        writer,
        kind: StatementKind.Parallel,
        row,
        lane: parallels_lane
    })

    memory.writeU32(cells, invocations_lane, first + in.count)
}
