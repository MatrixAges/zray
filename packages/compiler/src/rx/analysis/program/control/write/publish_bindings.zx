import integers from "std:integer"
import memory from "memory"

import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    first: u32,
    count: u32
}

export type Output = u32[]

export default function (in: Input): Output {
    const first = integers.widen(in.first)
    const count = integers.widen(in.count)
    const symbols = memory.optionalU32Views(in.writer.parallel_symbols)

    const bindings: u32[] = []

    return loop({
        source: first,
        bindings
    }, {
        while: state => state.source < first + count,
        next: state => {
            const id = symbols[state.source]

            if (id != null) {
                state.bindings = state.bindings.push(id)[0]
            }

            state.source += 1
        },
        return: state => state.bindings
    })
}
