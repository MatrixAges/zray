import { StatementKind } from "core/control_table/model"

import { cases_lane, selections_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"
import type { Statement } from "./publication"

export type Input = {
    writer: Cursor,
    subject: u32,
    count: u32,
    exhaustive: bool
}

export type Output = Statement

export default function (in: Input): Output {
    const { writer, subject, count, exhaustive } = in

    const first = writer.cells[cases_lane]

    return {
        header: header({
            writer,
            kind: StatementKind.Switch,
            row: writer.cells[selections_lane],
            lane: selections_lane
        }),
        value: subject,
        first,
        count,
        exhaustive,
        member_lane: cases_lane,
        next_member: first + count
    }
}
