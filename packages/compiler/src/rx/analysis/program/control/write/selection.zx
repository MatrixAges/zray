import integers from "std:integer"
import { StatementKind } from "core/control_table/model"
import memory from "memory"

import { cases_lane, selections_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    subject: u32,
    count: u32,
    exhaustive: bool
}

export type Output = void

export default function (in: Input): Output {
    const { writer } = in
    const { columns, cells } = writer

    const row = memory.readU32(cells, selections_lane)
    const index = integers.widen(row)
    const first = memory.readU32(cells, cases_lane)

    memory.writeU32(columns.selection_subjects, index, in.subject)
    memory.writeU32(columns.selection_first, index, first)
    memory.writeU32(columns.selection_count, index, in.count)
    memory.writeU8(columns.selection_exhaustive, index, in.exhaustive ? 1 : 0)

    header({
        writer,
        kind: StatementKind.Switch,
        row,
        lane: selections_lane
    })

    memory.writeU32(cells, cases_lane, first + in.count)
}
