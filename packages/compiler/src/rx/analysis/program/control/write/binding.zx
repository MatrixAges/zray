import { StatementKind } from "core/control_table/model"

import { constants_lane, evaluations_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"
import type { Statement } from "./publication"

export type Input = {
    writer: Cursor,
    symbol?: u32,
    value: u32
}

export type Output = Statement

export default function (in: Input): Output {
    const { writer, symbol, value } = in

    if (symbol == null) {
        return {
            header: header({
                writer,
                kind: StatementKind.Evaluate,
                row: writer.cells[evaluations_lane],
                lane: evaluations_lane
            }),
            value
        }
    }

    return {
        header: header({
            writer,
            kind: StatementKind.Constant,
            row: writer.cells[constants_lane],
            lane: constants_lane
        }),
        symbol,
        value
    }
}
