import integers from "std:integer"
import { StatementKind } from "core/control_table/model"
import memory from "memory"

import { constants_lane, evaluations_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    symbol?: u32,
    value: u32
}

export type Output = void

export default function (in: Input): Output {
    const { writer, symbol, value } = in
    const { columns, cells } = writer

    if (symbol == null) {
        const row = memory.readU32(cells, evaluations_lane)

        memory.writeU32(columns.evaluations, integers.widen(row), value)

        header({
            writer,
            kind: StatementKind.Evaluate,
            row,
            lane: evaluations_lane
        })

        return
    }

    const row = memory.readU32(cells, constants_lane)
    const index = integers.widen(row)

    memory.writeU32(columns.constant_values, index, value)
    memory.writeU32(columns.constant_symbols, index, symbol)

    header({
        writer,
        kind: StatementKind.Constant,
        row,
        lane: constants_lane
    })
}
