import memory from "memory"

import { statement_lane } from "../const"

import type { StatementKind } from "core/control_table/model"
import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    kind: StatementKind,
    row: u32,
    lane: u64
}

export type Output = {
    kind: StatementKind,
    row: u32,
    lane: u64,
    next_row: u32,
    statement: u32,
    next_statement: u32
}

export default function (in: Input): Output {
    const { writer, kind, row, lane } = in

    const statement = memory.readU32(writer.cells, statement_lane)

    return {
        kind,
        row,
        lane,
        next_row: row + 1,
        statement,
        next_statement: statement + 1
    }
}
