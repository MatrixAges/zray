import integers from "std:integer"
import memory from "zig:compiler_memory"

import { statement_lane } from "../const"

import type { U8Buffer, U32Buffer } from "zig:compiler_memory"

export type Header = {
    kinds: U8Buffer,
    payloads: U32Buffer,
    cursor: U32Buffer,
    kind: u8
}

export type Input = {
    header: Header,
    row: u32,
    lane: u64
}

export type Output = void

export default function (in: Input): Output {
    const { header, row, lane } = in

    const statement = memory.readU32(header.cursor, statement_lane)
    const index = integers.widen(statement)

    memory.writeU8(header.kinds, index, header.kind)
    memory.writeU32(header.payloads, index, row)
    memory.writeU32(header.cursor, statement_lane, statement + 1)
    memory.writeU32(header.cursor, lane, row + 1)
}
