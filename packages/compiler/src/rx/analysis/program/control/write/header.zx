import integers from "std:integer"
import memory from "memory"
import { writeStatementKind } from "memory/columns"

import { statement_lane } from "../const"

import type { StatementKind } from "core/control_table/model"
import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    kind: StatementKind,
    row: u32,
    lane: u64
}

export type Output = void

export default function (in: Input): Output {
    const { writer, row, lane } = in

    const statement = memory.readU32(writer.cells, statement_lane)
    const index = integers.widen(statement)

    writeStatementKind(writer.columns.statement_kinds, index, in.kind)
    memory.writeU32(writer.columns.statement_payloads, index, row)
    memory.writeU32(writer.cells, statement_lane, statement + 1)
    memory.writeU32(writer.cells, lane, row + 1)
}
