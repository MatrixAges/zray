import integers from "std:integer"
import memory from "memory"

import type { Allocator, ColumnRanges } from "memory"

export type Input = {
    resource: Allocator,
    bindings: ColumnRanges,
    published: u32
}

export type Output = void

export default function (in: Input): Output {
    memory.setColumnRangeCount(in.bindings, 0, integers.widen(in.published))
    memory.reserveColumnRange(in.resource, in.bindings, 0, null, false)
}
