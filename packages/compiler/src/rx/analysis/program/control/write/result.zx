import integers from "std:integer"
import { StatementKind } from "core/control_table/model"
import memory from "memory"

import { results_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"

export type Input = {
    writer: Cursor,
    value?: u32
}

export type Output = void

export default function (in: Input): Output {
    const { writer } = in

    const row = memory.readU32(writer.cells, results_lane)

    memory.writeOptionalU32(writer.columns.results, integers.widen(row), in.value)

    header({
        writer,
        kind: StatementKind.Result,
        row,
        lane: results_lane
    })
}
