import { StatementKind } from "core/control_table/model"
import memory from "memory"

import { results_lane } from "../const"
import header from "./header"

import type { Cursor } from "./buffers"
import type { Statement } from "./publication"

export type Input = {
    writer: Cursor,
    value?: u32
}

export type Output = Statement

export default function (in: Input): Output {
    const { writer, value } = in

    return {
        header: header({
            writer,
            kind: StatementKind.Result,
            row: memory.readU32(writer.cells, results_lane),
            lane: results_lane
        }),
        value
    }
}
