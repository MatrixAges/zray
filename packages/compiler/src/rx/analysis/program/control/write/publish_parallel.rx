<Module>
    <Type from="parallel_model" as="Parallel" />

    <Args in={Parallel.Input} out={Parallel.Output} />

    <Call
        fn="parallel"
        in={{
            writer: $in.writer,
            count: $in.count
        }}
    />

    <Call
        fn="publish_bindings"
        in={{
            writer: $in.writer,
            first: $in.first,
            count: $in.count
        }}
    />

    <Return
        value={{
            statement: $ctx.parallel,
            bindings: $ctx.publish_bindings
        }}
    />
</Module>
