<Module>
    <Type from="parallel_model" as="Parallel" />

    <Args in={Parallel.Input} out={void} />

    <Call
        fn="reserve_bindings"
        in={$in.pick([
            "resource",
            "bindings",
            "published"
        ])}
    />

    <Call
        fn="parallel"
        in={$in.pick([
            "writer",
            "count"
        ])}
    />

    <Call
        fn="publish_bindings"
        in={$in.omit([
            "resource",
            "published"
        ])}
    />
</Module>
