<Module>
    <Type from="publication" as="Control" />
    <Type from="case_member" as="Member" />
    <Type from="../../statements/traversal/publication" as="Body" />

    <Args in={Control.Case} out={Member.Row} />

    <Store from="../../statements/traversal/publication" as="publication" />

    <Call
        fn="block_id"
        in={{
            layout: $in.control.layout,
            unit: $in.unit
        }}
    />

    <Call
        fn="expected"
        in={{
            layout: $in.control.layout,
            unit: $in.end
        }}
    />

    <Call
        fn="finish_block"
        in={{
            control: $in.control,
            block: $ctx.block_id,
            expected: $ctx.expected
        }}
    />

    <If on={!$ctx.finish_block}>
        <Call
            fn="../../statements/traversal/stage"
            in={{
                step: Body.Step.RejectBlock
            }}
            setter={[$store.publication.effect]}
        />
    </If>

    <Return
        value={{
            block: $ctx.block_id,
            position: $in.position,
            label: $in.label
        }}
    />
</Module>
