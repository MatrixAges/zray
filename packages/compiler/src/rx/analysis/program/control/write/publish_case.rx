<Module>
    <Type from="publication" as="Control" />
    <Type from="case_member" as="Member" />

    <Args in={Control.Case} out={Member.Row} />

    <Call
        fn="block_id"
        in={{
            layout: $in.control.layout,
            unit: $in.unit
        }}
    />

    <Call
        fn="expected"
        in={{
            layout: $in.control.layout,
            unit: $in.end
        }}
    />

    <Call
        fn="finish_block"
        in={{
            control: $in.control,
            block: $ctx.block_id,
            expected: $ctx.expected
        }}
    />

    <Call fn="../../statements/traversal/host.requireBodyBlock" />

    <Return
        value={{
            block: $ctx.block_id,
            position: $in.position,
            label: $in.label
        }}
    />
</Module>
