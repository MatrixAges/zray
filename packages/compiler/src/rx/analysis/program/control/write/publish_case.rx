<Module>
    <Type from="publication" as="Control" />

    <Args in={Control.Case} out={void} />

    <Call
        fn="block_id"
        in={{
            layout: $in.control.layout,
            unit: $in.unit
        }}
    />

    <Call
        fn="expected"
        in={{
            layout: $in.control.layout,
            unit: $in.end
        }}
    />

    <Call
        fn="finish_block"
        in={{
            control: $in.control,
            block: $ctx.block_id,
            expected: $ctx.expected
        }}
    />

    <Call fn="../../statements/traversal/host.requireBodyBlock" />

    <Call
        fn="case_member"
        in={{
            writer: $in.control.writer,
            block: $ctx.block_id,
            position: $in.position,
            label: $in.label
        }}
    />
</Module>
