import summarizeUnit from "./unit"

import type { Row, Shape } from "./model"

export type Input = {
    shape: Shape
}

export type Output = Row[]

export default function (in: Input): Output {
    const count = in.shape.units.firsts.length
    const rows: Row[] = []

    return loop({
        unit: 0,
        rows
    }, {
        while: state => state.unit < count,
        next: state => {
            const row = summarizeUnit({
                shape: in.shape,
                rows: state.rows,
                unit: state.unit
            })

            state.rows = state.rows.push(row)[0]
            state.unit += 1
        },
        return: state => state.rows
    })
}
