import integers from "std:integer"

import { continues, returns, unreachable } from "./const"
import getterCount from "./getter_count"
import { Kind, Publish } from "./model"
import selectionExit from "./selection_exit"

import type { Row, Shape } from "./model"

export type Input = {
    shape: Shape,
    rows: Row[],
    unit: u64
}

export type Output = Row

export default function (in: Input): Output {
    const first = integers.widen(in.shape.units.firsts[in.unit])
    const end = first + integers.widen(in.shape.units.counts[in.unit])
    const steps = in.shape.steps

    return loop({
        index: first,
        exit: continues,
        evaluations: 0,
        constants: 0,
        parallels: 0,
        invocations: 0,
        selections: 0,
        cases: 0,
        results: 0
    }, {
        while: state => state.index < end && state.exit != unreachable,
        next: state => {
            if (state.exit == returns) {
                state.exit = unreachable
            } else {
                const index = state.index
                const output = steps.outputs[index]

                switch (steps.kinds[index]) {
                    case Kind.Call:
                        const call = integers.widen(steps.firsts[index])

                        state.constants +=
                            integers.widen(in.shape.calls.getters[call])

                        if (in.shape.calls.publishes[call]) {
                            state.constants += 1
                        } else {
                            state.evaluations += 1
                        }
                    case Kind.Parallel:
                        const count = integers.widen(steps.counts[index])

                        state.constants += getterCount({
                            getters: in.shape.calls.getters,
                            first: integers.widen(steps.firsts[index]),
                            count
                        })
                        state.parallels += 1
                        state.invocations += count
                    case Kind.Return:
                        state.results += 1
                        state.exit = returns
                    case Kind.Task:
                        const child = in.rows[integers.widen(steps.firsts[index])]

                        state.evaluations += integers.widen(child.evaluations)
                        state.constants += integers.widen(child.constants)
                        state.parallels += integers.widen(child.parallels)
                        state.invocations += integers.widen(child.invocations)
                        state.selections += integers.widen(child.selections)
                        state.cases += integers.widen(child.cases)
                        state.results += integers.widen(child.results)

                        if (output == Publish.None || child.tag == unreachable) {
                            state.exit = child.tag
                        }
                    case Kind.Selection:
                        const count = integers.widen(steps.counts[index])

                        state.selections += 1
                        state.cases += count
                        state.exit = selectionExit({
                            rows: in.rows,
                            cases: in.shape.cases,
                            first: integers.widen(steps.firsts[index]),
                            count,
                            exhaustive: steps.exhaustive[index]
                        })
                }

                if (output == Publish.Constant) {
                    state.constants += 1
                } else if (output == Publish.Evaluate) {
                    state.evaluations += 1
                }
            }

            state.index += 1
        },
        return: state => ({
            evaluations: integers.narrow(state.evaluations),
            constants: integers.narrow(state.constants),
            parallels: integers.narrow(state.parallels),
            invocations: integers.narrow(state.invocations),
            selections: integers.narrow(state.selections),
            cases: integers.narrow(state.cases),
            results: integers.narrow(state.results),
            tag: state.exit
        })
    })
}
