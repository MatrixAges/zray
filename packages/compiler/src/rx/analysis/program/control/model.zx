export enum Kind {
    Call,
    Parallel,
    Return,
    Task,
    Selection
}

export enum Publish {
    None,
    Evaluate,
    Constant
}

export enum Status {
    Ready,
    Unreachable,
    Incomplete
}

export type Steps = {
    kinds: Kind[],
    outputs: Publish[],
    firsts: u32[],
    counts: u32[],
    exhaustive: bool[]
}

export type Units = {
    firsts: u32[],
    counts: u32[],
    blocks: bool[]
}

export type Calls = {
    getters: u32[],
    publishes: bool[]
}

export type Shape = {
    steps: Steps,
    units: Units,
    cases: u32[],
    calls: Calls
}

export type Row = {
    evaluations: u32,
    constants: u32,
    parallels: u32,
    invocations: u32,
    selections: u32,
    cases: u32,
    results: u32,
    tag: u32
}

export type Input = {
    shape: Shape,
    capture_count: u64,
    void_output: bool
}

export type Output = {
    status: Status,
    evaluations: u64,
    constants: u64,
    parallels: u64,
    invocations: u64,
    selections: u64,
    cases: u64,
    results: u64,
    implicit_return: bool,
    rows: Row[],
    block_firsts: u32[],
    block_counts: u32[]
}
