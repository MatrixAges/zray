<Module>
    <Type from="model" as="Symbols" />

    <Args in={Symbols.Input} out={Symbols.Output} />

    <Call fn="fresh" in={$in.ownership} />

    <Return
        value={{
            names: $in.names,
            types: $in.types,
            span_start: $in.span_start,
            span_end: $in.span_end,
            ownership: $ctx.fresh
        }}
    />
</Module>
