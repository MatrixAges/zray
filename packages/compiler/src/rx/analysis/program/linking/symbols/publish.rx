<Module>
    <Type from="model" as="Symbols" />

    <Args in={Symbols.Input} out={void} />

    <Call fn="../literals/write_columns" in={$in.columns} />
    <Call fn="fresh" in={$in.ownership} />

    <If on={$in.owned_text != null}>
        <Call fn="../../../../../core/owned_text/into" in={$in.owned_text} />
    </If>

    <Call
        fn="../../../../../core/column_lengths/publish"
        in={{
            target: $in.lengths,
            count: $in.ownership.count
        }}
    />
</Module>
