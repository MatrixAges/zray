<Module>
    <Type from="model" as="Call" />

    <Args in={Call.Input} out={Call.Output} />

    <Call fn="operands" in={$in.operands} />
    <Call fn="../write_header" in={$in.row} />

    <Return
        value={{
            row: $ctx.write_header,
            operands: $ctx.operands
        }}
    />
</Module>
