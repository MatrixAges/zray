import memory from "zig:compiler_memory"

import type { U32Buffer } from "zig:compiler_memory"

export type Input = {
    functions: U32Buffer,
    arguments: U32Buffer,
    function_id: u32,
    argument: u32
}

export type Output = void

export default function (in: Input): Output {
    memory.writeU32(in.functions, 0, in.function_id)
    memory.writeU32(in.arguments, 0, in.argument)
}
