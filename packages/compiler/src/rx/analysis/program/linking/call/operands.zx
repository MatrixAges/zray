import range from "../operands/range"

import type { Input as Stores, Output as StoreRange } from "../operands/range"

export type Input = {
    function_id: u32,
    argument: u32,
    stores: Stores
}

export type Output = {
    function_id: u32,
    argument: u32,
    stores: StoreRange
}

export default function (in: Input): Output {
    const { function_id, argument, stores } = in

    return {
        function_id,
        argument,
        stores: range(stores)
    }
}
