<Module>
    <Type from="workflow" as="Payload" />

    <Args in={Payload.Effect} out={Payload.Operand} />

    <Call
        fn="../operands/prepare"
        in={{
            work: $in.operands,
            index: $in.row,
            route: $in.route
        }}
    />

    <If on={!$ctx.prepare}>
        <Return
            value={{
                value: 0
            }}
        />
    </If>

    <Call module="../operands/write" in={$in.operands} />

    <Call fn="../host.requireExpressionOperand" in={$ctx.write != null} />

    <Return
        value={{
            value: $in.operands.payload,
            patch: $ctx.write
        }}
    />
</Module>
