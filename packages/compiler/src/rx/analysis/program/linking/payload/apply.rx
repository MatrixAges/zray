<Module>
    <Type from="workflow" as="Payload" />

    <Args in={Payload.Effect} out={u32} />

    <Call
        fn="../host.prepareExpressionOperand"
        in={[
            $in.frame,
            $in.row,
            $in.route
        ]}
    />

    <If on={!$ctx.prepareExpressionOperand}>
        <Return value={0} />
    </If>

    <Call module="../operands/reserve" in={$in.operands.allocation} />
    <Call module="../operands/write" in={$in.operands} />

    <Call fn="../host.requireExpressionOperand" />

    <Call fn="../operands/commit" in={$in.operands.allocation.omit(["resource"])} />

    <Return value={$ctx.commit} />
</Module>
