import { OperandRoute as Kind } from "rx_project_host"

import {
    collection,
    object,
    scope,
    selection,
    sequence,
    transform
} from "./const"

export { OperandRoute as Kind } from "rx_project_host"

export type Input = u8

export type Output = Kind

export default function (in: Input): Output {
    return match in {
        sequence => Kind.Sequence,
        collection => Kind.Collection,
        transform => Kind.Transform,
        scope => Kind.Scope,
        selection => Kind.Selection,
        object => Kind.Object,
        _ => Kind.Fixed
    }
}
