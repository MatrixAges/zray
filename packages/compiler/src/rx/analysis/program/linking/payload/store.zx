import integers from "std:integer"
import memory from "memory"

import type { Publication } from "./workflow"

export type Input = Publication

export type Output = void

export default function (in: Input): Output {
    const columns = in.columns
    const mapped = columns.rows[integers.widen(in.row)]

    memory.writeU32(
        columns.target,
        integers.widen(mapped) - columns.base,
        in.value
    )
}
