import integers from "std:integer"

import type { Patch } from "./model"
import type { Publication } from "./workflow"

export type Input = Publication

export type Output = Patch

export default function (in: Input): Output {
    const columns = in.columns
    const mapped = columns.rows[integers.widen(in.row)]

    return {
        index: integers.widen(mapped) - columns.base,
        value: in.value
    }
}
