import type { ExpressionKind } from "core/expression_table/kinds"

export type LiteralBases = {
    integers: u64,
    negative_integers: u64,
    floats: u64,
    strings: u64,
    booleans: u64,
    enumerations: u64,
    errors: u64
}

export type Columns = {
    kinds: ExpressionKind[],
    payloads: u32[],
    rows: u32[],
    literals: LiteralBases,
    base: u64
}

export type Input = {
    columns: Columns,
    first: u64
}

export type Patch = {
    index: u64,
    value: u32
}

export type Output = {
    next?: u64,
    pending: bool,
    row: u32,
    kind: u8,
    writes: Patch[]
}
