import type { ExpressionLink } from "rx_project_host"
import type { Columns, Input as Scan } from "./model"
import type { Kind } from "./route"

export type Cursor = Scan & {
    frame: ExpressionLink
}

export type Pending = {
    frame: ExpressionLink,
    columns: Columns,
    row: u64,
    end: u64
}

export type Effect = {
    frame: ExpressionLink,
    row: u32,
    route: Kind
}

export type Publication = {
    columns: Columns,
    row: u32,
    value: u32
}
