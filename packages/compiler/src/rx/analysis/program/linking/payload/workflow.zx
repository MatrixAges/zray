import type { Patch, Work } from "../operands/workflow"
import type { Columns, Input as Scan, Patch as Payload } from "./model"
import type { Kind } from "./route"

export type Cursor = Scan & {
    operands: Work
}

export type Step = {
    next?: u64,
    writes: Payload[],
    operand?: Payload,
    patch?: Patch
}

export type Effect = {
    row: u32,
    route: Kind,
    operands: Work
}

export type Operand = {
    value: u32,
    patch?: Patch
}

export type Publication = {
    columns: Columns,
    row: u32,
    value: u32
}
