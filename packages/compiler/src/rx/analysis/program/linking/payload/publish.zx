import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"

import {
    collection,
    fixed,
    object,
    scope,
    selection,
    sequence,
    transform
} from "./const"
import literal from "./literal"

import type { Input as Request, Output as Progress } from "./model"

export type Input = Request

export type Output = Progress

export default function (in: Input): Output {
    const columns = in.columns

    return loop({
        next: in.first,
        pending: 0
    }, {
        while: state => state.next < columns.rows.length && state.pending < columns.limit,
        next: state => {
            const row = state.next
            const target = columns.rows[row]

            if (target != max_u32) {
                const kind = columns.kinds[row]
                const ready = literal({
                    bases: columns.literals,
                    kind,
                    payload: columns.payloads[row]
                })

                if (ready == null) {
                    const route = match kind {
                        ExpressionKind.List => sequence,
                        ExpressionKind.Tuple => sequence,
                        ExpressionKind.Template => sequence,
                        ExpressionKind.ListOperation => collection,
                        ExpressionKind.Transform => transform,
                        ExpressionKind.Scope => scope,
                        ExpressionKind.Match => selection,
                        ExpressionKind.Object => object,
                        _ => fixed
                    }

                    memory.writeU8(columns.pending_kinds, state.pending, route)
                    memory.writeU32(
                        columns.pending_rows,
                        state.pending,
                        integers.narrow(row)
                    )
                    state.pending += 1
                } else {
                    memory.writeU32(
                        columns.target,
                        integers.widen(target) - columns.base,
                        integers.narrow(ready)
                    )
                }
            }

            state.next += 1
        },
        return: state => state
    })
}
