import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import {
    collection,
    fixed,
    object,
    scope,
    selection,
    sequence,
    transform
} from "./const"
import literal from "./literal"

import type { Input as Request, Output as Progress, Patch } from "./model"

export type Input = Request

export type Output = Progress

export default function (in: Input): Output {
    const columns = in.columns

    const writes: Patch[] = []
    const row: u32 = 0
    const kind: u8 = 0

    const progress = loop({
        next: in.first,
        pending: false,
        row,
        kind,
        writes
    }, {
        while: state => state.next < columns.rows.length && !state.pending,
        next: state => {
            const row = state.next
            const target = columns.rows[row]

            if (target != max_u32) {
                const kind = columns.kinds[row]
                const ready = literal({
                    bases: columns.literals,
                    kind,
                    payload: columns.payloads[row]
                })

                if (ready == null) {
                    const route = match kind {
                        ExpressionKind.List => sequence,
                        ExpressionKind.Tuple => sequence,
                        ExpressionKind.Template => sequence,
                        ExpressionKind.ListOperation => collection,
                        ExpressionKind.Transform => transform,
                        ExpressionKind.Scope => scope,
                        ExpressionKind.Match => selection,
                        ExpressionKind.Object => object,
                        _ => fixed
                    }

                    state.pending = true
                    state.row = integers.narrow(row)
                    state.kind = route
                } else {
                    state.writes = state.writes.push({
                        index: integers.widen(target) - columns.base,
                        value: integers.narrow(ready)
                    })[0]
                }
            }

            state.next += 1
        },
        return: state => state
    })

    const next: u64? = match {
        progress.next < columns.rows.length => progress.next,
        _ => null
    }

    return {
        ...progress,
        next
    }
}
