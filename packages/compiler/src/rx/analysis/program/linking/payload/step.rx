<Module>
    <Type from="workflow" as="Payload" />

    <Args in={Payload.Cursor} out={Payload.Step?} />

    <Call
        fn="publish"
        in={$in.pick([
            "columns",
            "first"
        ])}
    />

    <If on={!$ctx.publish.pending}>
        <Return
            value={{
                next: $ctx.publish.next,
                writes: $ctx.publish.writes
            }}
        />
    </If>

    <Call fn="route" in={$ctx.publish.kind} />

    <Call
        module="apply"
        in={{
            row: $ctx.publish.row,
            route: $ctx.route,
            operands: $in.operands
        }}
    />

    <If on={$ctx.apply != null}>
        <Call
            fn="store"
            in={{
                columns: $in.columns,
                row: $ctx.publish.row,
                value: $ctx.apply.value
            }}
        />

        <Return
            value={{
                next: $ctx.publish.next,
                writes: $ctx.publish.writes,
                operand: $ctx.store,
                patch: $ctx.apply.patch
            }}
        />
    </If>

    <Return value={null} />
</Module>
