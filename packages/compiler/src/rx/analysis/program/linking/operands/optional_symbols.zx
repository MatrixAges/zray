import integers from "std:integer"
import { max_u32 } from "core/const"

import symbol from "./symbol"

import type { Symbols } from "./model"

export type Input = {
    source: u32?[],
    first: u32,
    count: u32,
    symbols: Symbols
}

export type Output = u32?[]?

export default function (in: Input): Output {
    const empty: u32? = null

    const first = integers.widen(in.first)
    const count = integers.widen(in.count)

    const items: u32?[] = []

    const mapped = loop({
        items,
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < count,
        next: state => {
            const value = in.source[first + state.position]

            if (value == null) {
                state.items = state.items.push(empty)[0]
            } else {
                const id = symbol({
                    symbols: in.symbols,
                    source: value
                })

                if (id == max_u32) {
                    state.valid = false
                } else {
                    state.items = state.items.push(id)[0]
                }
            }

            state.position += 1
        }
    })

    if (!mapped.valid) {
        return null
    }

    return mapped.items
}
