import type { Expressions } from "core/expression_table/model"
import type { Allocator, ColumnRanges } from "memory"
import type { ExpressionLink, OperandColumn, OperandRoute } from "rx_project_host"
import type { Symbols } from "./model"

export type Allocation = {
    resource: Allocator,
    header: ColumnRanges,
    members: ColumnRanges,
    evaluation: ColumnRanges
}

export type Work = {
    frame: ExpressionLink,
    data: Expressions,
    symbols: Symbols,
    allocation: Allocation,
    mapping: u32[],
    index: u64,
    slots: OperandColumn[],
    row: u64,
    route: OperandRoute
}

export type Prepare = {
    work: Work,
    index: u32,
    route: OperandRoute
}
