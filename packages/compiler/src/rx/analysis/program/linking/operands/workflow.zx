import type { Expressions } from "core/expression_table/model"
import type { ColumnLengths } from "memory"
import type { OperandColumn, OperandRoute } from "rx_project_host"
import type { Symbols } from "./model"

export type Cell = {
    word?: u32,
    symbol?: u32,
    byte?: u8
}

export type Column = {
    words?: u32[],
    symbols?: u32?[],
    bytes?: u8[]
}

export type Patch = {
    header: Cell[],
    members: Column[],
    evaluation?: u32[]
}

export type Source = {
    data: Expressions,
    metadata: Metadata,
    symbols: Symbols,
    mapping: u32[],
    headers: OperandColumn[][],
    lengths: ColumnLengths
}

export type Work = Source.Omit("lengths", "headers") & {
    index: u64,
    slots: OperandColumn[],
    row: u64,
    payload: u32,
    members_first: u64,
    evaluation_first: u64,
    route: OperandRoute
}

export type Metadata = {
    kinds: u8[],
    unary: u8[],
    binary: u8[],
    iteration: u8[],
    collection: u8[],
    transform: u8[],
    scope: u8[]
}

export type Prepare = {
    source: Source,
    index: u32,
    route: OperandRoute
}

export type Prepared = {
    kind: u8,
    count: u32,
    work?: Work
}

export type Publication = {
    kind: u8,
    count: u32,
    patch: Patch
}
