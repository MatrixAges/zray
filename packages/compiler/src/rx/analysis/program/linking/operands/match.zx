import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import expressions from "./expressions"
import writeRange from "./range"

import type { OptionalU32Buffer, U32Buffer } from "memory"
import type { SourceRange } from "./model"
import type { Range } from "./range"

export type Input = {
    subject?: u32,
    fallback: u32,
    mapping: u32[],
    conditions: u32[],
    results: u32[],
    source_range: SourceRange,
    target_conditions: U32Buffer,
    target_results: U32Buffer,
    subjects: OptionalU32Buffer,
    fallbacks: U32Buffer,
    range: Range
}

export type Output = bool

export default function (in: Input): Output {
    const source = in.subject
    const subject: u32? = source == null ? null : in.mapping[integers.widen(source)]

    if (subject == max_u32) {
        return false
    }

    const fallback = in.mapping[integers.widen(in.fallback)]

    if (fallback == max_u32) {
        return false
    }

    const conditions = expressions({
        source: in.conditions,
        source_range: in.source_range,
        mapping: in.mapping,
        target: in.target_conditions
    })

    if (!conditions) {
        return false
    }

    const results = expressions({
        source: in.results,
        source_range: in.source_range,
        mapping: in.mapping,
        target: in.target_results
    })

    if (!results) {
        return false
    }

    memory.writeOptionalU32(in.subjects, 0, subject)
    memory.writeU32(in.fallbacks, 0, fallback)

    writeRange({
        range: in.range,
        count: integers.widen(in.source_range.count)
    })

    return true
}
