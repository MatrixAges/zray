import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import symbol from "./symbol"

import type { U32Buffer } from "memory"
import type { Symbols } from "./model"

export type Input = {
    source: u32[],
    first: u32,
    count: u32,
    symbols: Symbols,
    target: U32Buffer
}

export type Output = bool

export default function (in: Input): Output {
    const first = integers.widen(in.first)
    const count = integers.widen(in.count)
    const source = memory.borrowU32Range(in.source, first, count)

    return loop({
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < count,
        next: state => {
            const id = symbol({
                symbols: in.symbols,
                source: source[state.position]
            })

            if (id == max_u32) {
                state.valid = false
            } else {
                memory.writeU32(in.target, state.position, id)
                state.position += 1
            }
        },
        return: state => state.valid
    })
}
