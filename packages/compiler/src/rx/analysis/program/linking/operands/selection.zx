import integers from "std:integer"
import { max_u32 } from "core/const"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.match_first[row]
    const count = data.match_count[row]
    const source = data.match_subjects[row]

    const subject: u32? = match {
        source == null => null,
        _ => in.mapping[integers.widen(source)]
    }

    if (subject == max_u32) {
        return null
    }

    const fallback = in.mapping[integers.widen(data.match_fallbacks[row])]

    if (fallback == max_u32) {
        return null
    }

    const conditions = expressions({
        source: data.match_conditions,
        first,
        count,
        mapping: in.mapping
    })

    if (conditions == null) {
        return null
    }

    const results = expressions({
        source: data.match_results,
        first,
        count,
        mapping: in.mapping
    })

    if (results == null) {
        return null
    }

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            {
                symbol: subject
            },
            {
                word: fallback
            },
            window.first,
            window.count
        ],
        members: [
            {
                words: conditions
            },
            {
                words: results
            }
        ]
    }
}
