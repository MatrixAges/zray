import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.match_first[row]
    const count = data.match_count[row]

    const { header, members } = in.allocation

    const source = data.match_subjects[row]

    const subject: u32? = match {
        source == null => null,
        _ => in.mapping[integers.widen(source)]
    }

    if (subject == max_u32) {
        return false
    }

    const fallback = in.mapping[integers.widen(data.match_fallbacks[row])]

    if (fallback == max_u32) {
        return false
    }

    const conditions = expressions({
        source: data.match_conditions,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 0, null)
    })

    if (!conditions) {
        return false
    }

    const results = expressions({
        source: data.match_results,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 1, null)
    })

    if (!results) {
        return false
    }

    memory.writeOptionalU32(
        memory.columnRangeOptionalU32Tail(header, 0, null),
        0,
        subject
    )

    memory.writeU32(memory.columnRangeU32Tail(header, 1, null), 0, fallback)

    writeRange({
        header,
        slot: 2,
        members: members,
        count: integers.widen(count)
    })

    return true
}
