import operands from "./expressions"
import writeRange from "./range"

import type { Input as Operands } from "./expressions"
import type { Range } from "./range"

export type Input = Operands & {
    range: Range
}

export type Output = bool

export default function (in: Input): Output {
    const valid = operands(in.pick([
        "source",
        "mapping",
        "target"
    ]))

    if (!valid) {
        return false
    }

    writeRange({
        range: in.range,
        count: in.source.length
    })

    return true
}
