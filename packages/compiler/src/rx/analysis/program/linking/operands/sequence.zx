import integers from "std:integer"
import memory from "memory"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.sequence_first[row]
    const count = data.sequence_count[row]

    const { header, members } = in.allocation

    const valid = expressions({
        source: data.sequence_items,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 0, null)
    })

    if (!valid) {
        return false
    }

    writeRange({
        header,
        slot: 0,
        members: members,
        count: integers.widen(count)
    })

    return true
}
