
import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.sequence_first[row]
    const count = data.sequence_count[row]

    const valid = expressions({
        source: data.sequence_items,
        first,
        count,
        mapping: in.mapping
    })

    if (valid == null) {
        return null
    }

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            window.first,
            window.count
        ],
        members: [{
            words: valid
        }]
    }
}
