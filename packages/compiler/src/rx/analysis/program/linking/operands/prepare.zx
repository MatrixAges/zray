import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"
import { OperandRoute } from "rx_project_host"

import type { Prepare, Prepared } from "./workflow"

export type Input = Prepare

export type Output = Prepared?

export default function (in: Input): Output {
    const { source, route } = in
    const { data, metadata, lengths } = source

    const index = integers.widen(in.index)

    const kind = data.kinds[index]

    if (kind == ExpressionKind.None || kind == ExpressionKind.Unit) {
        return null
    }

    const code = metadata.kinds[index]
    const kind_index = integers.widenByte(code)
    const header = source.headers[kind_index]

    if (header.length == 0) {
        return {
            kind: code,
            count: 0
        }
    }

    const row = integers.widen(data.payloads[index])

    const count = match route {
        OperandRoute.Sequence => data.sequence_count[row],
        OperandRoute.Collection => data.collection_count[row],
        OperandRoute.Transform => data.transform_count[row],
        OperandRoute.Scope => data.scope_count[row],
        OperandRoute.Selection => data.match_count[row],
        OperandRoute.Object => data.object_count[row],
        _ => 0
    }

    const slot = 1 + kind_index * 2

    return {
        kind: code,
        count,
        work: {
            ...source.omit([
                "lengths",
                "headers"
            ]),
            mapping: memory.borrowU32Range(source.mapping, 0, index),
            index,
            row,
            slots: header,
            payload: integers.narrow(memory.readLengthSlot(lengths, slot)),
            members_first: memory.readLengthSlot(lengths, slot + 1),
            evaluation_first: memory.readLengthSlot(lengths, 0),
            route
        }
    }
}
