import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

export type Input = {
    source: u32[],
    first: u32,
    count: u32,
    mapping: u32[]
}

export type Output = u32[]?

export default function (in: Input): Output {
    const count = integers.widen(in.count)
    const first = integers.widen(in.first)
    const source = memory.borrowU32Range(in.source, first, count)

    const items: u32[] = []

    const mapped = loop({
        items,
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < count,
        next: state => {
            const id = in.mapping[integers.widen(source[state.position])]

            if (id == max_u32) {
                state.valid = false
            } else {
                state.items = state.items.push(id)[0]
                state.position += 1
            }
        }
    })

    if (!mapped.valid) {
        return null
    }

    return mapped.items
}
