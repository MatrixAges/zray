import integers from "std:integer"
import memory from "zig:compiler_memory"
import { max_u32 } from "core/const"

import expressions from "./expressions"
import writeRange from "./range"

import type { U8Buffer, U32Buffer } from "zig:compiler_memory"
import type { SourceRange } from "./model"
import type { Range } from "./range"

export type Input = {
    target: u32,
    kind: u8,
    mapping: u32[],
    arguments: u32[],
    source_range: SourceRange,
    target_arguments: U32Buffer,
    kinds: U8Buffer,
    targets: U32Buffer,
    range: Range
}

export type Output = bool

export default function (in: Input): Output {
    const target = in.mapping[integers.widen(in.target)]

    if (target == max_u32) {
        return false
    }

    const valid = expressions({
        source: in.arguments,
        source_range: in.source_range,
        mapping: in.mapping,
        target: in.target_arguments
    })

    if (!valid) {
        return false
    }

    memory.writeU8(in.kinds, 0, in.kind)
    memory.writeU32(in.targets, 0, target)

    writeRange({
        range: in.range,
        count: integers.widen(in.source_range.count)
    })

    return true
}
