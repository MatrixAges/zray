import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"
import { expressionOperandBytes, OperandColumn } from "rx_project_host"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.collection_first[row]
    const count = data.collection_count[row]

    const { header, members } = in.allocation

    const target = in.mapping[integers.widen(data.collection_targets[row])]

    if (target == max_u32) {
        return false
    }

    const valid = expressions({
        source: data.collection_arguments,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 0, null)
    })

    if (!valid) {
        return false
    }

    memory.writeU8(
        memory.columnRangeU8Tail(header, 0, null),
        0,
        expressionOperandBytes(in.frame, OperandColumn.collection_kinds)[row]
    )

    memory.writeU32(memory.columnRangeU32Tail(header, 1, null), 0, target)

    writeRange({
        header,
        slot: 2,
        members: members,
        count: integers.widen(count)
    })

    return true
}
