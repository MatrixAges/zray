import integers from "std:integer"
import { max_u32 } from "core/const"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.collection_first[row]
    const count = data.collection_count[row]

    const target = in.mapping[integers.widen(data.collection_targets[row])]

    if (target == max_u32) {
        return null
    }

    const valid = expressions({
        source: data.collection_arguments,
        first,
        count,
        mapping: in.mapping
    })

    if (valid == null) {
        return null
    }

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            {
                byte: in.metadata.collection[row]
            },
            {
                word: target
            },
            window.first,
            window.count
        ],
        members: [{
            words: valid
        }]
    }
}
