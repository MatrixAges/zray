<Module>
    <Type from="workflow" as="Operands" />

    <Args in={Operands.Allocation} out={void} />

    <Call
        fn="reserve"
        in={{
            resource: $in.resource,
            ranges: $in.header
        }}
    />

    <Call
        fn="reserve"
        in={{
            resource: $in.resource,
            ranges: $in.members
        }}
    />

    <Call
        fn="reserve"
        in={{
            resource: $in.resource,
            ranges: $in.evaluation
        }}
    />
</Module>
