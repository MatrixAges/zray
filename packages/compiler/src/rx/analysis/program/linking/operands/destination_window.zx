import integers from "std:integer"

import type { Cell } from "./workflow"

export type Input = {
    first: u64,
    count: u32
}

export type Output = {
    first: Cell,
    count: Cell
}

export default function (in: Input): Output {
    return {
        first: {
            word: integers.narrow(in.first)
        },
        count: {
            word: in.count
        }
    }
}
