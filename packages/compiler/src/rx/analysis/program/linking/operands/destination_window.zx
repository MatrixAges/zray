import integers from "std:integer"
import memory from "memory"

import type { ColumnRanges } from "memory"

export type Input = {
    header: ColumnRanges,
    slot: u64,
    members: ColumnRanges,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { header, slot, members } = in

    const count_slot = slot + 1

    const first = memory.columnRangeLength(members, 0)

    memory.writeU32(
        memory.columnRangeU32Tail(header, slot, null),
        0,
        integers.narrow(first)
    )

    memory.writeU32(
        memory.columnRangeU32Tail(header, count_slot, null),
        0,
        integers.narrow(in.count)
    )
}
