import integers from "std:integer"
import memory from "zig:compiler_memory"
import { max_u32 } from "core/const"

import expressions from "./expressions"
import optionalSymbols from "./optional_symbols"
import writeRange from "./range"

import type { OptionalU32Buffer, U8Buffer, U32Buffer } from "zig:compiler_memory"
import type { SourceRange, Symbols } from "./model"
import type { Range } from "./range"

export type Input = {
    result: u32,
    mapping: u32[],
    symbols: Symbols,
    binding_symbols: u32?[],
    binding_values: u32[],
    borrows: u8[],
    source_range: SourceRange,
    target_symbols: OptionalU32Buffer,
    target_values: U32Buffer,
    target_borrows: U8Buffer,
    results: U32Buffer,
    range: Range
}

export type Output = bool

export default function (in: Input): Output {
    const result = in.mapping[integers.widen(in.result)]

    if (result == max_u32) {
        return false
    }

    const symbols = optionalSymbols({
        source: in.binding_symbols,
        source_range: in.source_range,
        symbols: in.symbols,
        target: in.target_symbols
    })

    if (!symbols) {
        return false
    }

    const values = expressions({
        source: in.binding_values,
        source_range: in.source_range,
        mapping: in.mapping,
        target: in.target_values
    })

    if (!values) {
        return false
    }

    const length = integers.widen(in.source_range.count)

    if (length != 0) {
        const first = integers.widen(in.source_range.first)

        const copied = memory.copyBytes(
            in.target_borrows,
            0,
            in.borrows,
            first,
            first + length
        )
    }

    memory.writeU32(in.results, 0, result)

    writeRange({
        range: in.range,
        count: length
    })

    return true
}
