import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"
import { expressionOperandBytes, OperandColumn } from "rx_project_host"

import writeRange from "./destination_window"
import expressions from "./expressions"
import optionalSymbols from "./optional_symbols"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.scope_first[row]
    const count = data.scope_count[row]

    const result = in.mapping[integers.widen(data.scope_results[row])]

    if (result == max_u32) {
        return null
    }

    const symbols = optionalSymbols({
        source: data.scope_symbols,
        first,
        count,
        symbols: in.symbols
    })

    if (symbols == null) {
        return null
    }

    const values = expressions({
        source: data.scope_values,
        first,
        count,
        mapping: in.mapping
    })

    if (values == null) {
        return null
    }

    const start = integers.widen(first)
    const length = integers.widen(count)

    const borrows = match {
        length == 0 => [],
        _ => memory.borrowU8Range(
            expressionOperandBytes(
                in.frame,
                OperandColumn.scope_borrows
            ),
            start,
            length
        )
    }

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            {
                word: result
            },
            window.first,
            window.count
        ],
        members: [
            {
                symbols: symbols
            },
            {
                words: values
            },
            {
                bytes: borrows
            }
        ]
    }
}
