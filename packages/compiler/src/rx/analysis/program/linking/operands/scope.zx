import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"
import { expressionOperandBytes, OperandColumn } from "rx_project_host"

import writeRange from "./destination_window"
import expressions from "./expressions"
import optionalSymbols from "./optional_symbols"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.scope_first[row]
    const count = data.scope_count[row]

    const { header, members } = in.allocation

    const result = in.mapping[integers.widen(data.scope_results[row])]

    if (result == max_u32) {
        return false
    }

    const symbols = optionalSymbols({
        source: data.scope_symbols,
        first,
        count,
        symbols: in.symbols,
        target: memory.columnRangeOptionalU32Tail(members, 0, null)
    })

    if (!symbols) {
        return false
    }

    const values = expressions({
        source: data.scope_values,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 1, null)
    })

    if (!values) {
        return false
    }

    const length = integers.widen(count)

    if (length != 0) {
        const start = integers.widen(first)

        const copied = memory.copyBytes(
            memory.columnRangeU8Tail(members, 2, null),
            0,
            expressionOperandBytes(in.frame, OperandColumn.scope_borrows),
            start,
            start + length
        )
    }

    memory.writeU32(memory.columnRangeU32Tail(header, 0, null), 0, result)

    writeRange({
        header,
        slot: 1,
        members: members,
        count: length
    })

    return true
}
