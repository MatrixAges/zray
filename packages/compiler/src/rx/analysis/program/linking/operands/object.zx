import integers from "std:integer"
import memory from "memory"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.object_first[row]
    const count = data.object_count[row]
    const evaluation_first = data.object_evaluation_first[row]
    const evaluation_count = data.object_evaluation_count[row]

    const { header, members } = in.allocation

    const evaluation_columns = in.allocation.evaluation

    const fields = expressions({
        source: data.object_field_values,
        first,
        count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(members, 1, null)
    })

    if (!fields) {
        return false
    }

    const evaluation = expressions({
        source: data.object_evaluation_values,
        first: evaluation_first,
        count: evaluation_count,
        mapping: in.mapping,
        target: memory.columnRangeU32Tail(evaluation_columns, 0, null)
    })

    if (!evaluation) {
        return false
    }

    const field_count = integers.widen(count)

    if (field_count != 0) {
        const start = integers.widen(first)
        const end = start + field_count

        memory.copyU32Range(
            memory.columnRangeU32Tail(members, 0, null),
            0,
            data.object_field_indices,
            start,
            end
        )
    }

    writeRange({
        header,
        slot: 0,
        members: members,
        count: field_count
    })

    writeRange({
        header,
        slot: 2,
        members: evaluation_columns,
        count: integers.widen(evaluation_count)
    })

    return true
}
