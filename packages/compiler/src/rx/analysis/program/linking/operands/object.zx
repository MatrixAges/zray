import integers from "std:integer"
import memory from "memory"

import expressions from "./expressions"
import writeRange from "./range"

import type { U8Buffer, U32Buffer } from "memory"
import type { SourceRange } from "./model"
import type { Range } from "./range"

export type Input = {
    mapping: u32[],
    fields: u32[],
    indices: u8[],
    index_width: u64,
    evaluation: u32[],
    source_fields: SourceRange,
    source_evaluation: SourceRange,
    target_fields: U32Buffer,
    target_evaluation: U32Buffer,
    target_indices: U8Buffer,
    field_range: Range,
    evaluation_range: Range
}

export type Output = bool

export default function (in: Input): Output {
    const fields = expressions({
        source: in.fields,
        source_range: in.source_fields,
        mapping: in.mapping,
        target: in.target_fields
    })

    if (!fields) {
        return false
    }

    const evaluation = expressions({
        source: in.evaluation,
        source_range: in.source_evaluation,
        mapping: in.mapping,
        target: in.target_evaluation
    })

    if (!evaluation) {
        return false
    }

    const field_count = integers.widen(in.source_fields.count)

    if (field_count != 0) {
        const start = integers.widen(in.source_fields.first) * in.index_width
        const end = start + field_count * in.index_width

        const copied = memory.copyBytes(
            in.target_indices,
            0,
            in.indices,
            start,
            end
        )
    }

    writeRange({
        range: in.field_range,
        count: field_count
    })

    writeRange({
        range: in.evaluation_range,
        count: integers.widen(in.source_evaluation.count)
    })

    return true
}
