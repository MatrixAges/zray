import integers from "std:integer"
import memory from "memory"

import writeRange from "./destination_window"
import expressions from "./expressions"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.object_first[row]
    const count = data.object_count[row]
    const evaluation_first = data.object_evaluation_first[row]
    const evaluation_count = data.object_evaluation_count[row]

    const fields = expressions({
        source: data.object_field_values,
        first,
        count,
        mapping: in.mapping
    })

    if (fields == null) {
        return null
    }

    const evaluation = expressions({
        source: data.object_evaluation_values,
        first: evaluation_first,
        count: evaluation_count,
        mapping: in.mapping
    })

    if (evaluation == null) {
        return null
    }

    const field_count = integers.widen(count)

    const indices = match {
        field_count == 0 => [],
        _ =>
            memory.borrowU32Range(
                data.object_field_indices,
                integers.widen(first),
                field_count
            )
    }

    const evaluation_window = writeRange({
        first: in.evaluation_first,
        count: evaluation_count
    })

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            window.first,
            window.count,
            evaluation_window.first,
            evaluation_window.count
        ],
        members: [
            {
                words: indices
            },
            {
                words: fields
            }
        ],
        evaluation
    }
}
