import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"
import { expressionOperandBytes, OperandColumn } from "rx_project_host"

import writeRange from "./destination_window"
import symbols from "./symbols"

import type { Work } from "./workflow"

export type Input = Work

export type Output = bool

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.transform_first[row]
    const count = data.transform_count[row]

    const { header, members } = in.allocation

    const mapping = in.mapping
    const target = mapping[integers.widen(data.transform_targets[row])]

    if (target == max_u32) {
        return false
    }

    const body = mapping[integers.widen(data.transform_bodies[row])]

    if (body == max_u32) {
        return false
    }

    const source = data.transform_initials[row]

    const initial: u32? = match {
        source == null => null,
        _ => mapping[integers.widen(source)]
    }

    if (initial == max_u32) {
        return false
    }

    const valid = symbols({
        source: data.transform_parameters,
        first,
        count,
        symbols: in.symbols,
        target: memory.columnRangeU32Tail(members, 0, null)
    })

    if (!valid) {
        return false
    }

    memory.writeU8(
        memory.columnRangeU8Tail(header, 0, null),
        0,
        expressionOperandBytes(in.frame, OperandColumn.transform_kinds)[row]
    )

    memory.writeU32(memory.columnRangeU32Tail(header, 1, null), 0, target)
    memory.writeU32(memory.columnRangeU32Tail(header, 2, null), 0, body)

    memory.writeOptionalU32(
        memory.columnRangeOptionalU32Tail(header, 3, null),
        0,
        initial
    )

    writeRange({
        header,
        slot: 4,
        members: members,
        count: integers.widen(count)
    })

    return true
}
