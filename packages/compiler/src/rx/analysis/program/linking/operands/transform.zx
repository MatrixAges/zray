import integers from "std:integer"
import { max_u32 } from "core/const"

import writeRange from "./destination_window"
import symbols from "./symbols"

import type { Patch, Work } from "./workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row } = in

    const first = data.transform_first[row]
    const count = data.transform_count[row]

    const mapping = in.mapping
    const target = mapping[integers.widen(data.transform_targets[row])]

    if (target == max_u32) {
        return null
    }

    const body = mapping[integers.widen(data.transform_bodies[row])]

    if (body == max_u32) {
        return null
    }

    const source = data.transform_initials[row]

    const initial: u32? = match {
        source == null => null,
        _ => mapping[integers.widen(source)]
    }

    if (initial == max_u32) {
        return null
    }

    const valid = symbols({
        source: data.transform_parameters,
        first,
        count,
        symbols: in.symbols
    })

    if (valid == null) {
        return null
    }

    const window = writeRange({
        first: in.members_first,
        count
    })

    return {
        header: [
            {
                byte: in.metadata.transform[row]
            },
            {
                word: target
            },
            {
                word: body
            },
            {
                symbol: initial
            },
            window.first,
            window.count
        ],
        members: [{
            words: valid
        }]
    }
}
