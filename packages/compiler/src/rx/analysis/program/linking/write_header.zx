import type { Metadata } from "core/expression_table/append/model"
import type { ExpressionRow } from "../capture/model"

export type Input = {
    metadata: Metadata,
    kind: u8,
    payload: u32
}

export type Output = ExpressionRow

export default function (in: Input): Output {
    const { metadata, kind, payload } = in

    return {
        kind,
        payload,
        type_id: metadata.type_id,
        start: metadata.span_start,
        end: metadata.span_end
    }
}
