import integers from "std:integer"
import memory from "std:memory"
import { max_u32 } from "core/const"

import symbol from "../operands/symbol"

import type { OptionalU32Buffer, U32Buffer } from "std:memory"
import type { Symbols } from "../operands/model"

export enum Mode {
    Expression,
    Symbol,
    Raw
}

export type Column = {
    value: u32,
    mode: Mode,
    target: U32Buffer
}

export type Input = {
    columns: Column[],
    mapping: u32[],
    symbols: Symbols,
    optional_symbol?: u32,
    optional_target?: OptionalU32Buffer
}

export type Output = bool

export default function (in: Input): Output {
    const written = loop({
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < in.columns.length,
        next: state => {
            const column = in.columns[state.position]
            const value = match column.mode {
                Mode.Expression => in.mapping[integers.widen(column.value)],
                Mode.Symbol => symbol({
                    symbols: in.symbols,
                    source: column.value
                }),
                _ => column.value
            }

            state.valid = column.mode == Mode.Raw || value != max_u32

            if (state.valid) {
                memory.writeU32(column.target, 0, value)
            }

            state.position += 1
        },
        return: state => state.valid
    })

    if (!written) {
        return false
    }

    const target = in.optional_target

    if (target == null) {
        return true
    }

    const source = in.optional_symbol

    const id: u32? = match {
        source == null => null,
        _ => symbol({
            symbols: in.symbols,
            source
        })
    }

    if (id == max_u32) {
        return false
    }

    memory.writeOptionalU32(target, 0, id)

    return true
}
