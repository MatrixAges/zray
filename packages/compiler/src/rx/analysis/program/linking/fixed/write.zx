import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"

import symbol from "../operands/symbol"

import type { OptionalU32Buffer, U8Buffer, U32Buffer } from "memory"
import type { Symbols } from "../operands/model"

export type Column = {
    source: u32[],
    target: U32Buffer
}

export type Metadata = {
    source: u8[],
    target: U8Buffer
}

export type Input = {
    kind: ExpressionKind,
    columns: Column[],
    row: u64,
    mapping: u32[],
    symbols: Symbols,
    optional_symbol?: u32,
    optional_target?: OptionalU32Buffer,
    metadata?: Metadata
}

export type Output = bool

export default function (in: Input): Output {
    const { columns, row } = in

    const width = columns.length

    const expressions = match in.kind {
        ExpressionKind.Reference => 0,
        ExpressionKind.Field => 1,
        ExpressionKind.TupleField => 1,
        ExpressionKind.Iteration => 3,
        _ => width
    }

    const mapped = match in.kind {
        ExpressionKind.Field => expressions,
        ExpressionKind.TupleField => expressions,
        _ => width
    }

    const written = loop({
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < width,
        next: state => {
            const position = state.position
            const column = columns[position]
            const source = column.source[row]
            const value = match {
                position < expressions => in.mapping[integers.widen(source)],
                position < mapped => symbol({
                    symbols: in.symbols,
                    source
                }),
                _ => source
            }

            state.valid = position >= mapped || value != max_u32

            if (state.valid) {
                memory.writeU32(column.target, 0, value)
            }

            state.position += 1
        },
        return: state => state.valid
    })

    if (!written) {
        return false
    }

    const target = in.optional_target

    if (target != null) {
        const source = in.optional_symbol

        const id: u32? = match {
            source == null => null,
            _ => symbol({
                symbols: in.symbols,
                source
            })
        }

        if (id == max_u32) {
            return false
        }

        memory.writeOptionalU32(target, 0, id)
    }

    const metadata = in.metadata

    if (metadata != null) {
        memory.writeU8(metadata.target, 0, metadata.source[row])
    }

    return true
}
