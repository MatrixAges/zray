import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"
import { expressionOperandBytes, expressionOperandWords } from "rx_project_host"

import symbol from "../operands/symbol"

import type { Cell, Patch, Work } from "../operands/workflow"

export type Input = Work

export type Output = Patch?

export default function (in: Input): Output {
    const { data, row, slots, frame } = in

    const kind = data.kinds[in.index]
    const width = slots.length

    const has_metadata = match kind {
        ExpressionKind.Unary => true,
        ExpressionKind.Binary => true,
        ExpressionKind.Iteration => true,
        _ => false
    }

    const words = match kind {
        ExpressionKind.Iteration => width - 2,
        _ => has_metadata ? width - 1 : width
    }

    const expressions = match kind {
        ExpressionKind.Reference => 0,
        ExpressionKind.Field => 1,
        ExpressionKind.TupleField => 1,
        ExpressionKind.Iteration => 3,
        _ => words
    }

    const mapped = match kind {
        ExpressionKind.Field => expressions,
        ExpressionKind.TupleField => expressions,
        _ => words
    }

    const cells: Cell[] = []

    const written = loop({
        cells,
        position: 0,
        valid: true
    }, {
        while: state => state.valid && state.position < words,
        next: state => {
            const position = state.position
            const column = expressionOperandWords(frame, slots[position])
            const source = column[row]
            const value = match {
                position < expressions => in.mapping[integers.widen(source)],
                position < mapped => symbol({
                    symbols: in.symbols,
                    source
                }),
                _ => source
            }

            state.valid = position >= mapped || value != max_u32

            if (state.valid) {
                state.cells = state.cells.push({
                    word: value
                })[0]
            }

            state.position += 1
        }
    })

    if (!written.valid) {
        return null
    }

    const source: u32? = match kind {
        ExpressionKind.Iteration => data.iteration_environment_symbols[row],
        _ => null
    }

    const id: u32? = match {
        source == null => null,
        _ => symbol({
            symbols: in.symbols,
            source
        })
    }

    if (id == max_u32) {
        return null
    }

    const header = match kind {
        ExpressionKind.Iteration => written.cells.push({
            symbol: id
        })[0],
        _ => written.cells
    }

    const completed = match {
        has_metadata => header.push({
            byte: expressionOperandBytes(frame, slots[width - 1])[row]
        })[0],
        _ => header
    }

    return {
        header: completed,
        members: []
    }
}
