import { max_u32 } from "core/const"

export type Input = u32[]

export type Range = {
    start: u64,
    end: u64
}

export type Output = Range[]

export default function (in: Input): Output {
    const ranges: Range[] = []

    return loop({
        cursor: 0,
        ranges
    }, {
        while: state => state.cursor < in.length,
        next: state => {
            const start = state.cursor

            if (in[start] == max_u32) {
                state.cursor += 1
            } else {
                const end = loop(start + 1, {
                    while: row => row < in.length && in[row] != max_u32,
                    next: row => {
                        row += 1
                    }
                })

                state.ranges = state.ranges.push({
                    start,
                    end
                })[0]
                state.cursor = end
            }
        },
        return: state => state.ranges
    })
}
