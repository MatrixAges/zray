import memory from "memory"

import type { Publication } from "./model"

export type Input = Publication

export type Output = void

export default function (in: Input): Output {
    const { target, counts } = in

    const published = loop(0, {
        while: slot => slot < counts.length,
        next: slot => {
            const count = counts[slot]

            if (count != 0) {
                memory.advanceLengthSlot(target, slot, count)
            }

            slot += 1
        }
    })
}
