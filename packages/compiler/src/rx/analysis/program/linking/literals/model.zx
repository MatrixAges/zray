import type { Into } from "core/owned_text"
import type { ColumnLengths, U8Buffer } from "memory"

export type Column = {
    source: u8[],
    target: U8Buffer
}

export type Text = Into

export type Copy = {
    columns: Column[],
    owned_text?: Text
}

export type Publication = {
    target: ColumnLengths,
    counts: u64[]
}

export type Input = Copy & {
    publication: Publication
}
