import type { Output as Headers } from "./headers"
import type { Input as Literals } from "./literals/model"
import type { Input as Plan } from "./model"
import type { Source as Operands } from "./operands/workflow"
import type { Columns } from "./payload/model"
import type { Step } from "./payload/workflow"
import type { Input as Symbols, Output as SymbolRows } from "./symbols/model"

export type Request = {
    plan?: Plan,
    symbols?: Symbols,
    literals?: Literals,
    payload?: Columns,
    operands?: Operands,
    first?: u64
}

export type Initial = {
    returned: u32,
    first?: u64,
    ranges: Headers,
    count: u64,
    rows: u32[],
    bindings: u32[]
}

export type Publication = {
    symbols?: SymbolRows,
    literals?: Literals
}

export type Output = {
    initial?: Initial,
    publication?: Publication,
    step?: Step
}
