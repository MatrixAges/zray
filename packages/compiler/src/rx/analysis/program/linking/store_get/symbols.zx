import memory from "memory"

import type { Input as Publication, SymbolRow } from "./model"

export type Input = Publication.Pick("getters", "span", "copy_tag")

export type Output = SymbolRow[]

export default function (in: Input): Output {
    const { getters, span } = in

    const empty: SymbolRow[] = []

    return loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < getters.count,
        next: state => {
            const name = memory.readTextColumn(getters.names, state.row)
            const type_id = memory.readColumnU32(getters.types, state.row)

            state.rows = state.rows.push({
                name,
                type_id,
                start: span.start,
                end: span.end,
                ownership: in.copy_tag
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })
}
