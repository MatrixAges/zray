import integers from "std:integer"
import memory from "memory"

import write from "../../capture/expression"

import type { Input as Publication } from "./model"

export type Input = Publication.Omit("symbols", "constants")

export type Output = void

export default function (in: Input): Output {
    const { getters, expressions } = in

    const written = loop(0, {
        while: row => row < getters.count,
        next: row => {
            write({
                columns: expressions.header,
                row,
                span: in.span,
                kind: expressions.kind,
                payload: expressions.first_payload + integers.narrow(row),
                type_id: memory.readColumnU32(getters.types, row)
            })
            row += 1
        }
    })
}
