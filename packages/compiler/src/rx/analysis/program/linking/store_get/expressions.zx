import integers from "std:integer"
import memory from "memory"

import type { ExpressionRow } from "../../capture/model"
import type { Input as Publication } from "./model"

export type Input = Publication.Pick("getters", "span", "first_payload", "kind")

export type Output = ExpressionRow[]

export default function (in: Input): Output {
    const { getters, span } = in

    const empty: ExpressionRow[] = []

    return loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < getters.count,
        next: state => {
            state.rows = state.rows.push({
                kind: in.kind,
                payload: in.first_payload + integers.narrow(state.row),
                type_id: memory.readColumnU32(getters.types, state.row),
                start: span.start,
                end: span.end
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })
}
