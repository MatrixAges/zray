import type { Getters } from "../../../store/bindings/model"
import type { ExpressionRow, Span } from "../../capture/model"

export type SymbolRow = {
    name: string,
    type_id: u32,
    start: u64,
    end: u64,
    ownership: u8
}

export type ConstantRow = {
    symbol: u32,
    value: u32
}

export type ConstantsOutput = {
    constants: ConstantRow[],
    bindings: u32[]
}

export type Input = {
    getters: Getters,
    span: Span,
    first_payload: u32,
    kind: u8,
    copy_tag: u8,
    first_symbol: u32,
    first_expression: u32
}

export type Output = {
    expressions: ExpressionRow[],
    symbols: SymbolRow[],
    constants: ConstantRow[],
    bindings: u32[]
}
