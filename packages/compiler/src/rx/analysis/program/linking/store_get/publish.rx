<Module>
    <Type from="model" as="StoreGet" />

    <Args in={StoreGet.Input} out={void} />

    <Call
        fn="expressions"
        in={$in.omit([
            "symbols",
            "constants",
            "lengths"
        ])}
    />

    <Call
        fn="symbols"
        in={$in.omit([
            "expressions",
            "constants",
            "lengths"
        ])}
    />

    <Call
        fn="constants"
        in={{
            ...$in.constants,
            count: $in.getters.count
        }}
    />

    <Call
        fn="../../../../../core/column_lengths/publish"
        in={{
            target: $in.lengths,
            count: $in.getters.count
        }}
    />
</Module>
