<Module>
    <Type from="model" as="StoreGet" />

    <Args in={StoreGet.Input} out={StoreGet.Output} />

    <Call
        fn="expressions"
        in={$in.pick([
            "getters",
            "span",
            "first_payload",
            "kind"
        ])}
    />

    <Call
        fn="symbols"
        in={$in.pick([
            "getters",
            "span",
            "copy_tag"
        ])}
    />

    <Call
        fn="constants"
        in={{
            first_symbol: $in.first_symbol,
            first_expression: $in.first_expression,
            count: $in.getters.count
        }}
    />

    <Return
        value={{
            expressions: $ctx.expressions,
            symbols: $ctx.symbols,
            constants: $ctx.constants.constants,
            bindings: $ctx.constants.bindings
        }}
    />
</Module>
