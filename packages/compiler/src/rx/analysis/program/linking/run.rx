<Module>
    <Type from="workflow" as="Linking" />

    <Args in={Linking.Request} out={Linking.Output} />

    <If on={$in.first != null}>
        <Call
            module="payload/step"
            in={{
                columns: $in.payload,
                operands: $in.operands,
                first: $in.first
            }}
        />

        <Return
            value={{
                step: $ctx.step
            }}
        />
    </If>

    <Call module="plan" in={$in.plan} />

    <Call
        fn="host.reserveExpressionLink"
        in={[
            $in.frame,
            $ctx.plan.returned,
            $ctx.plan.rows,
            $ctx.plan.bindings,
            $ctx.plan.count
        ]}
    />

    <Call fn="host.prepareLinkSymbols" in={$in.frame} />
    <Call fn="host.prepareLinkLiterals" in={$in.frame} />
    <Call fn="headers" in={$ctx.plan.rows} />

    <If on={$ctx.prepareLinkSymbols}>
        <Call module="symbols/publish" in={$in.symbols} />

        <Return
            value={{
                initial: {
                    returned: $ctx.reserveExpressionLink,
                    first: $ctx.plan.rows.length > 0 ? 0 : null,
                    ranges: $ctx.headers,
                    count: $ctx.plan.count,
                    symbols: $ctx.publish,
                    literals: $ctx.prepareLinkLiterals ? $in.literals : null
                }
            }}
        />
    </If>

    <Return
        value={{
            initial: {
                returned: $ctx.reserveExpressionLink,
                first: $ctx.plan.rows.length > 0 ? 0 : null,
                ranges: $ctx.headers,
                count: $ctx.plan.count,
                literals: $ctx.prepareLinkLiterals ? $in.literals : null
            }
        }}
    />
</Module>
