<Module>
    <Type from="workflow" as="Linking" />

    <Args in={Linking.Request} out={Linking.Output} />

    <If on={$in.first != null && $in.payload != null && $in.operands != null}>
        <Call
            module="payload/step"
            in={{
                columns: $in.payload,
                operands: $in.operands,
                first: $in.first
            }}
        />

        <Return
            value={{
                step: $ctx.step
            }}
        />
    </If>

    <If on={$in.plan != null}>
        <Call module="plan" in={$in.plan} />

        <If on={$ctx.plan.returned != null}>
            <Call fn="headers" in={$ctx.plan.rows} />

            <Return
                value={{
                    initial: {
                        returned: $ctx.plan.returned,
                        first: $ctx.plan.rows.length > 0 ? 0 : null,
                        ranges: $ctx.headers,
                        count: $ctx.plan.count,
                        rows: $ctx.plan.rows,
                        bindings: $ctx.plan.bindings
                    }
                }}
            />
        </If>

        <Return
            value={{
                initial: null
            }}
        />
    </If>

    <If on={$in.symbols != null}>
        <Call module="symbols/publish" in={$in.symbols} />

        <Return
            value={{
                publication: {
                    symbols: $ctx.publish,
                    literals: $in.literals
                }
            }}
        />
    </If>

    <Return
        value={{
            publication: {
                literals: $in.literals
            }
        }}
    />
</Module>
