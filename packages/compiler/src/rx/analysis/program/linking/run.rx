<Module>
    <Type from="workflow" as="Linking" />

    <Args in={Linking.Request} out={u32} />

    <Call module="plan" in={$in.plan} />

    <Call
        fn="host.reserveExpressionLink"
        in={[
            $in.frame,
            $ctx.plan.returned,
            $ctx.plan.rows,
            $ctx.plan.bindings,
            $ctx.plan.count
        ]}
    />

    <Call fn="host.prepareLinkSymbols" in={$in.frame} />

    <If on={$ctx.prepareLinkSymbols}>
        <Call module="symbols/publish" in={$in.symbols} />
    </If>

    <Call fn="host.prepareLinkLiterals" in={$in.frame} />

    <If on={$ctx.prepareLinkLiterals}>
        <Call module="literals/write" in={$in.literals} />
    </If>

    <Loop on={$in.first < $in.columns.rows.length}>
        <Call
            module="payload/step"
            in={{
                frame: $in.frame,
                columns: $in.payload,
                operands: $in.operands,
                first: 0
            }}
        />
    </Loop>

    <Call fn="headers" in={$in.headers} />

    <Call
        fn="../../../../core/column_lengths/publish"
        in={{
            target: $in.lengths,
            count: $ctx.plan.count
        }}
    />

    <Return value={$ctx.reserveExpressionLink} />
</Module>
