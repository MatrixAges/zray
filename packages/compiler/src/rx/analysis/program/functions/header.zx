import type { Shared } from "./model"

export type Input = Shared

export type Output = bool

export default function (in: Input): Output {
    const { actual, expected } = in

    const same_input = actual.input_type == expected.input_type
    const same_output = actual.output_type == expected.output_type

    const same_types = (
        - same_input
        - and same_output
    )

    const same_ownership = actual.ownership == expected.ownership
    const same_mode = actual.store_mode == expected.store_mode

    const same_header = (
        - same_types
        - and same_ownership
        - and same_mode
    )

    return same_header && actual.file_name == expected.file_name
}
