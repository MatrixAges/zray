import type { Complete } from "core/function_table/complete"
import type { Stores } from "core/store_table/model"

export type Header = {
    file_name: string,
    input_type: u32,
    output_type: u32,
    ownership: u8,
    store_mode: u8,
    stores: Stores
}

export type Shared = {
    actual: Complete.Pick("files", "input_types", "output_types", "stores") & {
        ownership: u8[],
        store_modes: u8[]
    },
    expected: Header,
    index: u64,
    initializers_shared: bool
}

export enum Reuse {
    Invalid,
    Checked,
    CheckInitializers
}
