import type { Stores } from "core/store_table/model"
import type { ReadColumn, TextColumn } from "memory"
import type { Getters } from "../../store/bindings/model"

export type Slots = Stores.Omit("handles")

export type Slot = {
    path: string,
    type_id: u32,
    readable: bool,
    writable: bool
}

export type GetterRows = Getters.Pick("types", "count") & {
    paths: TextColumn
}

export type Source = {
    slots: Slots,
    getters?: GetterRows
}

export type Request = {
    registered: Slots,
    source: Source,
    count: u64
}

export type Output = {
    compatible: bool,
    readable: bool[],
    writable: bool[],
    appended: Slot[],
    mapping: u32[]
}
