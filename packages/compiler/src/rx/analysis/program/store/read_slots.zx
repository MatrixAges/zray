import memory from "memory"

import { Status } from "./model"
import register from "./register"

import type { GetterRows, Progress, Scan } from "./model"

export type Input = Scan & {
    source: GetterRows
}

export type Output = Progress

export default function (in: Input): Output {
    const { source, registered, permissions, mapping } = in

    return loop({
        next: in.first,
        status: Status.Ready
    }, {
        while: state => state.status == Status.Ready && state.next < source.count,
        next: state => {
            const index = state.next

            state.status = register({
                registered,
                permissions,
                mapping,
                index,
                slot: {
                    path: memory.readTextColumn(source.paths, index),
                    type_id: memory.readColumnU32(source.types, index),
                    readable: true,
                    writable: false
                }
            })

            if (state.status == Status.Ready) {
                state.next += 1
            }
        },
        return: state => state
    })
}
