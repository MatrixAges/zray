<Module>
    <Type from="model" as="Store" />

    <Args in={Store.Cursor} out={Store.Cursor} />

    <Call fn="host.borrowProgramStoreSlots" in={$in.request.frame} />

    <Call
        fn="scan"
        in={{
            ...$in.request.pick([
                "source",
                "registered",
                "permissions",
                "mapping"
            ]),
            first: $in.first
        }}
    />

    <Call
        fn="host.requireProgramStoreMatch"
        in={$ctx.scan.status != Store.Status.Conflict}
    />

    <If on={$ctx.scan.status == Store.Status.Append}>
        <Call
            fn="slot"
            in={{
                source: $in.request.source,
                index: $ctx.scan.next
            }}
        />

        <Call
            fn="copy_path"
            in={{
                allocator: $in.request.allocator,
                path: $ctx.slot.path,
                registered: $in.request.registered.paths.length
            }}
        />

        <Call fn="host.reserveProgramStoreSlot" in={$in.request.frame} />

        <Call
            fn="publish"
            in={{
                target: $in.request.tail,
                slot: {
                    ...$ctx.slot,
                    path: $ctx.copy_path
                },
                mapping: $in.request.mapping,
                index: $ctx.scan.next,
                id: $in.request.registered.paths.length
            }}
        />

        <Return
            value={{
                request: $in.request,
                first: $ctx.scan.next + 1
            }}
        />
    </If>

    <Return
        value={{
            request: $in.request,
            first: $ctx.scan.next
        }}
    />
</Module>
