import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { Allocator } from "memory"

export type Input = {
    allocator: Allocator,
    path: string,
    registered: u64
}

export type Output = string

export default function (in: Input): Output {
    memory.requireAllocation(in.registered < integers.widen(max_u32))

    return memory.copyColumnText(in.allocator, in.path)
}
