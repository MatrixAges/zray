import find from "core/store_table/find"

import type { Slot, Slots } from "./model"

export type Input = {
    registered: Slots,
    slot: Slot
}

export type Output = {
    row?: u64,
    compatible: bool,
    readable: bool,
    writable: bool
}

export default function (in: Input): Output {
    const { registered, slot } = in

    const row = find({
        paths: registered.paths,
        identity: slot.path
    })

    if (row == null) {
        return {
            compatible: true,
            readable: slot.readable,
            writable: slot.writable
        }
    }

    return {
        row,
        compatible: registered.types[row] == slot.type_id,
        readable: registered.readable[row] || slot.readable,
        writable: registered.writable[row] || slot.writable
    }
}
