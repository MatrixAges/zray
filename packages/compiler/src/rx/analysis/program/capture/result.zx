import integers from "std:integer"

import type { Result, ResultOutput } from "./model"

export type Input = Result & {
    expression: u32
}

export type Output = ResultOutput

export default function (in: Input): Output {
    return {
        statement_kind: in.result_kind,
        statement_payload: 0,
        result_expression: in.expression,
        block_first: 0,
        block_count: integers.narrow(in.count + 1)
    }
}
