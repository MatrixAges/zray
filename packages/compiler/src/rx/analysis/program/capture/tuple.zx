import integers from "std:integer"

import type { ExpressionRow, Tuple, TupleOutput } from "./model"

export type Input = Tuple

export type Output = TupleOutput

export default function (in: Input): Output {
    const { source_types, parameter_types, span } = in

    const count = source_types.length
    const expressions: ExpressionRow[] = []
    const references: u32[] = []
    const optionals: u32[] = []
    const items: u32[] = []

    return loop({
        position: 0,
        row: count + 1,
        optional_row: 0,
        expressions,
        references,
        optionals,
        items
    }, {
        while: state => state.position < count,
        next: state => {
            const position = state.position
            const symbol = integers.narrow(position + 1)
            const reference = integers.narrow(state.row)
            const source = source_types[position]
            const target = parameter_types[position]

            state.references = state.references.push(symbol)[0]
            state.expressions = state.expressions.push({
                kind: in.reference_kind,
                payload: symbol,
                type_id: source,
                start: span.start,
                end: span.end
            })[0]

            if (source != target) {
                state.row += 1
                state.optionals = state.optionals.push(reference)[0]
                state.expressions = state.expressions.push({
                    kind: in.optional_kind,
                    payload: integers.narrow(state.optional_row),
                    type_id: target,
                    start: span.start,
                    end: span.end
                })[0]
                state.optional_row += 1
            }

            state.items = state.items.push(integers.narrow(state.row))[0]
            state.position += 1
            state.row += 1
        },
        return: state => {
            const out_expressions = state.expressions.push({
                kind: in.tuple_kind,
                payload: 0,
                type_id: in.result_type,
                start: span.start,
                end: span.end
            })[0]

            return {
                expressions: out_expressions,
                references: state.references,
                optionals: state.optionals,
                firsts: [0],
                counts: [integers.narrow(count)],
                items: state.items,
                result_expression: integers.narrow(state.row)
            }
        }
    })
}
