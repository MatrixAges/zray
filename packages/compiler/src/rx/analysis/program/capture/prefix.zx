import integers from "std:integer"
import memory from "memory"

import { environment_name } from "./const"
import expression from "./expression"

import type { Prefix } from "./model"

export type Input = Prefix

export type Output = void

export default function (in: Input): Output {
    const { symbols, expressions, statements, captures, span, bindings } = in

    memory.writeString(symbols.names, 0, environment_name)
    memory.writeU32(symbols.types, 0, in.input_type)
    memory.writeU64(symbols.starts, 0, span.start)
    memory.writeU64(symbols.ends, 0, span.end)
    memory.writeU32(in.references, 0, 0)

    expression({
        columns: expressions,
        span,
        row: 0,
        kind: in.reference_kind,
        type_id: in.input_type,
        payload: 0
    })

    const written = loop(0, {
        while: row => row < captures.positions.length,
        next: row => {
            const symbol = row + 1
            const id = integers.narrow(symbol)
            const payload = integers.narrow(row)
            const type_id = captures.types[row]
            const name = captures.names[integers.widen(captures.positions[row])]
            const statement = in.statement + row
            const constant = in.constant + row

            memory.writeString(symbols.names, symbol, name)
            memory.writeU32(symbols.types, symbol, type_id)
            memory.writeU64(symbols.starts, symbol, span.start)
            memory.writeU64(symbols.ends, symbol, span.end)
            memory.writeU32(in.targets, row, 0)
            memory.writeU32(in.indices, row, payload)
            expression({
                columns: expressions,
                span,
                row: symbol,
                kind: in.field_kind,
                type_id,
                payload
            })

            memory.writeU8(statements.kinds, statement, in.constant_kind)
            memory.writeU32(
                statements.payloads,
                statement,
                integers.narrow(constant)
            )
            memory.writeU32(statements.symbols, constant, id)
            memory.writeU32(statements.values, constant, id)

            if (bindings != null) {
                memory.writeU32(bindings, row, id)
            }

            row += 1
        }
    })
}
