import integers from "std:integer"

import type {
    ExpressionRow,
    Prefix,
    PrefixOutput,
    StatementRow,
    SymbolRow
} from "./model"

export type Input = Prefix

export type Output = PrefixOutput

export default function (in: Input): Output {
    const { types, span } = in

    const symbols: SymbolRow[] = [
        {
            type_id: in.input_type,
            start: span.start,
            end: span.end
        }
    ]

    const expressions: ExpressionRow[] = [
        {
            kind: in.reference_kind,
            payload: 0,
            type_id: in.input_type,
            start: span.start,
            end: span.end
        }
    ]

    const statements: StatementRow[] = []
    const references: u32[] = [0]
    const targets: u32[] = []
    const indices: u32[] = []
    const bindings: u32[] = []

    return loop({
        row: 0,
        symbols,
        expressions,
        statements,
        targets,
        indices,
        bindings
    }, {
        while: state => state.row < types.length,
        next: state => {
            const symbol = state.row + 1
            const id = integers.narrow(symbol)
            const payload = integers.narrow(state.row)
            const type_id = types[state.row]
            const constant = in.constant + state.row

            state.symbols = state.symbols.push({
                type_id,
                start: span.start,
                end: span.end
            })[0]
            state.targets = state.targets.push(0)[0]
            state.indices = state.indices.push(payload)[0]
            state.expressions = state.expressions.push({
                kind: in.field_kind,
                payload,
                type_id,
                start: span.start,
                end: span.end
            })[0]
            state.statements = state.statements.push({
                kind: in.constant_kind,
                payload: integers.narrow(constant),
                symbol: id,
                value: id
            })[0]

            if (in.include_bindings) {
                state.bindings = state.bindings.push(id)[0]
            }

            state.row += 1
        },
        return: state => ({
            symbols: state.symbols,
            expressions: state.expressions,
            statements: state.statements,
            references,
            targets: state.targets,
            indices: state.indices,
            bindings: state.bindings
        })
    })
}
