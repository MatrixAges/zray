import memory from "zig:compiler_memory"

import type { Expressions, Span } from "./model"

export type Input = {
    columns: Expressions,
    span: Span,
    row: u64,
    kind: u8,
    type_id: u32,
    payload: u32
}

export type Output = void

export default function (in: Input): Output {
    const { columns, span, row, kind, type_id, payload } = in

    memory.writeU8(columns.kinds, row, kind)
    memory.writeU32(columns.types, row, type_id)
    memory.writeU32(columns.payloads, row, payload)
    memory.writeU64(columns.starts, row, span.start)
    memory.writeU64(columns.ends, row, span.end)
}
