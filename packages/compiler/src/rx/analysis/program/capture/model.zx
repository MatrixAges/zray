export type Span = {
    start: u64,
    end: u64
}

export type SymbolRow = {
    type_id: u32,
    start: u64,
    end: u64
}

export type ExpressionRow = {
    kind: u8,
    payload: u32,
    type_id: u32,
    start: u64,
    end: u64
}

export type StatementRow = {
    kind: u8,
    payload: u32,
    symbol: u32,
    value: u32
}

export type Prefix = {
    types: u32[],
    span: Span,
    input_type: u32,
    statement: u64,
    constant: u64,
    reference_kind: u8,
    field_kind: u8,
    constant_kind: u8,
    include_bindings: bool
}

export type PrefixOutput = {
    symbols: SymbolRow[],
    expressions: ExpressionRow[],
    statements: StatementRow[],
    references: u32[],
    targets: u32[],
    indices: u32[],
    bindings: u32[]
}

export type Tuple = {
    source_types: u32[],
    parameter_types: u32[],
    span: Span,
    result_type: u32,
    reference_kind: u8,
    optional_kind: u8,
    tuple_kind: u8
}

export type TupleOutput = {
    expressions: ExpressionRow[],
    references: u32[],
    optionals: u32[],
    firsts: u32[],
    counts: u32[],
    items: u32[],
    result_expression: u32
}

export type Result = {
    count: u64,
    result_kind: u8
}

export type ResultOutput = {
    statement_kind: u8,
    statement_payload: u32,
    result_expression?: u32,
    block_first: u32,
    block_count: u32
}

export type Names = {
    source: string[],
    positions: u32[]
}

export type Argument = {
    prefix: Prefix,
    tuple: Tuple,
    result: Result
}

export type ArgumentOutput = {
    prefix: PrefixOutput,
    tuple: TupleOutput,
    result: ResultOutput
}

export type Binding = {
    prefix: Prefix,
    names: Names
}

export type BindingOutput = {
    prefix: PrefixOutput,
    names: string[]
}
