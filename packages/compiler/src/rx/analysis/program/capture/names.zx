import integers from "std:integer"

import { environment_name } from "./const"

import type { Names } from "./model"

export type Input = Names

export type Output = string[]

export default function (in: Input): Output {
    const names: string[] = [environment_name]

    return loop({
        row: 0,
        names
    }, {
        while: state => state.row < in.positions.length,
        next: state => {
            const value = in.source[integers.widen(in.positions[state.row])]

            state.names = state.names.push(value)[0]
            state.row += 1
        },
        return: state => state.names
    })
}
