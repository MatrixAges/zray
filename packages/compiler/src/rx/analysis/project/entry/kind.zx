import bytes from "std:bytes"

import { zx_extension } from "./const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const path = bytes.fromText(in)
    const suffix = bytes.fromText(zx_extension)
    const width = suffix.length

    if (path.length < width) {
        return false
    }

    return bytes.startsWith(path, path.length - width, suffix)
}
