import memory from "memory"

import {
    alias_attribute,
    name_attribute,
    value_attribute
} from "../../../schema/attribute/const"
import {
    input_attribute,
    output_attribute,
    source_attribute
} from "./const"
import { Kind } from "./model"

import type { Attributes as Output, Names as Input } from "./model"

export default function (in: Input): Output {
    const primary = match in.kind {
        Kind.Arguments => input_attribute,
        Kind.Field => name_attribute,
        _ => source_attribute
    }

    const secondary = match in.kind {
        Kind.Arguments => output_attribute,
        Kind.Field => value_attribute,
        _ => alias_attribute
    }

    const last_alias = in.kind == Kind.Store
    const absent: u64? = null

    return loop({
        row: 0,
        first: absent,
        second: absent
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const name = memory.readTextColumn(in.names, row)
            const select_second = last_alias || state.second == null

            if (name == primary && state.first == null) {
                state.first = row
            } else if (name == secondary && select_second) {
                state.second = row
            }

            state.row += 1
        },
        return: state => ({
            first: state.first,
            second: state.second
        })
    })
}
