import memory from "memory"
import columns from "memory/columns"

import {
    alias_attribute,
    name_attribute,
    value_attribute
} from "../../../schema/attribute/const"
import { input_attribute, output_attribute, source_attribute } from "./const"
import { Kind } from "./model"

import type { Layout } from "../../../syntax/tree/layout"

export type Input = {
    node: u8[],
    layout: Layout,
    kind: Kind
}

export type Output = {
    first?: u8[],
    second?: u8[]
}

export default function (in: Input): Output {
    const { node, layout, kind } = in

    const width = layout.attribute_width
    const slots = columns.readBorrowedRowList(node, layout.node_attributes, width)

    const primary = match kind {
        Kind.Arguments => input_attribute,
        Kind.Field => name_attribute,
        _ => source_attribute
    }

    const secondary = match kind {
        Kind.Arguments => output_attribute,
        Kind.Field => value_attribute,
        _ => alias_attribute
    }

    const last_alias = kind == Kind.Store
    const first: u8[]? = null
    const second: u8[]? = null

    return loop({
        next: 0,
        first,
        second
    }, {
        while: state => state.next < slots.length,
        next: state => {
            const row = memory.borrowU8Range(slots, state.next, width)
            const name = columns.readBorrowedRowText(row, layout.attribute_name)
            const take_second = last_alias || state.second == null

            if (name == primary && state.first == null) {
                state.first = row
            } else if (name == secondary && take_second) {
                state.second = row
            }

            state.next += width
        },
        return: state => ({
            first: state.first,
            second: state.second
        })
    })
}
