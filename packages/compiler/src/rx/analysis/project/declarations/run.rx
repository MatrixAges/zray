<Module>
    <Type from="workflow" as="Declaration" />

    <Args in={Declaration.Run} out={Declaration.Plan} />

    <Call fn="key" in={$in.kind} />

    <Call
        module="visit"
        in={{
            ...$in,
            tag: $ctx.key,
            namespaces: {
                keys: [],
                values: [],
                buckets: []
            },
            plan: {
                entries: [],
                failure: null
            }
        }}
    />

    <Return value={$ctx.visit} />
</Module>
