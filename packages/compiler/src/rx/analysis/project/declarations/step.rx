<Module>
    <Type from="workflow" as="Declaration" />
    <Type from="model" as="Scan" />

    <Args in={Declaration.Visit} out={Declaration.Visit} />

    <Call
        fn="find"
        in={$in.pick([
            "names",
            "tree",
            "next",
            "count",
            "kind",
            "tag"
        ])}
    />

    <If on={$ctx.find.node == null}>
        <Return
            value={{
                ...$in,
                next: $ctx.find.next
            }}
        />
    </If>

    <Call
        fn="edges"
        in={{
            reference: $in.references,
            first: $in.edge
        }}
    />

    <If on={$in.kind == Scan.Kind.Store}>
        <Call
            module="../../store/references/prepare"
            in={{
                target: $in.target,
                edge: $ctx.edges,
                from: $ctx.find.first ?? [],
                alias: $ctx.find.second,
                layout: $in.tree.layout,
                index: $in.namespaces
            }}
        />

        <Return
            value={{
                ...$in,
                next: $ctx.find.next,
                edge: ($ctx.edges ?? 0) + 1,
                namespaces: $ctx.prepare
            }}
        />
    </If>

    <Switch on={$in.kind}>
        <Case value={Scan.Kind.TypeImport}>
            <Call
                module="../type_imports/select"
                in={{
                    target: $in.target,
                    from: $ctx.find.first ?? [],
                    alias: $ctx.find.second,
                    edge: $ctx.edges,
                    signatures: $in.signatures
                }}
            />
        </Case>

        <Case value={Scan.Kind.Arguments}>
            <Call
                fn="host.publishArgumentDeclaration"
                in={[
                    $in.target,
                    $ctx.find.node ?? [],
                    $ctx.find.first ?? [],
                    $ctx.find.second ?? []
                ]}
            />
        </Case>
    </Switch>

    <Return
        value={{
            ...$in,
            next: $ctx.find.next,
            edge: $ctx.edges == null ? $in.edge : $ctx.edges + 1
        }}
    />
</Module>
