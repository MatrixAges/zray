<Module>
    <Type from="workflow" as="Declaration" />

    <Args in={Declaration.Visit} out={Declaration.Visit} />

    <Call
        fn="find"
        in={$in.pick([
            "names",
            "tree",
            "next",
            "count",
            "kind",
            "tag"
        ])}
    />

    <If on={$ctx.find.declaration != null}>
        <Call
            fn="edges"
            in={{
                reference: $in.references,
                first: $in.edge
            }}
        />

        <Call
            module="select"
            in={{
                cursor: $in,
                hit: $ctx.find.declaration,
                edge: $ctx.edges
            }}
        />

        <If on={$ctx.select.failure != null}>
            <Return
                value={{
                    ...$in,
                    plan: {
                        ...$in.plan,
                        failure: $ctx.select.failure
                    }
                }}
            />
        </If>

        <If on={$ctx.select.entry != null}>
            <Call
                fn="record"
                in={{
                    plan: $in.plan,
                    entry: $ctx.select.entry
                }}
            />

            <Return
                value={{
                    ...$in,
                    plan: $ctx.record,
                    namespaces: $ctx.select.namespaces,
                    next: $ctx.find.next,
                    edge: $ctx.edges == null ? $in.edge : $ctx.edges + 1
                }}
            />
        </If>

        <Return
            value={{
                ...$in,
                next: $ctx.find.next,
                edge: $ctx.edges == null ? $in.edge : $ctx.edges + 1
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            next: $ctx.find.next
        }}
    />
</Module>
