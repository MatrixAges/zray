import { arguments_tag, store_tag, type_tag } from "../../../schema/execution/const"
import { field_tag } from "./const"
import { Kind } from "./model"

export type Input = Kind

export type Output = string

export default function (in: Input): Output {
    return match in {
        Kind.Arguments => arguments_tag,
        Kind.TypeImport => type_tag,
        Kind.Store => store_tag,
        _ => field_tag
    }
}
