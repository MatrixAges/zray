import memory from "std:memory"

import { arguments_tag, field_tag, store_tag, type_tag } from "./const"
import { Kind } from "./model"

import type { Rows as Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const tag = match in.kind {
        Kind.Arguments => arguments_tag,
        Kind.TypeImport => type_tag,
        Kind.Store => store_tag,
        _ => field_tag
    }

    const absent: u64? = null

    return loop({
        row: in.start,
        found: absent
    }, {
        while: state => state.found == null && state.row < in.count,
        next: state => {
            const row = state.row

            if (memory.readTextColumn(in.names, row) == tag) {
                state.found = row
            }

            state.row += 1
        },
        return: state => state.found
    })
}
