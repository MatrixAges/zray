<Store name="mixed_workspace_recycle" version={1}>
    <Type from="operation" as="Operation" />

    <Object name="effect">
        <Field
            name="action"
            type={Operation.Action}
            value={Operation.Action.ClearResults}
        />

        <Field name="row" type={u64} value={0} />
        <Field name="count" type={u64} value={0} />
        <Field name="ready" type={bool} value={false} />
    </Object>
</Store>
