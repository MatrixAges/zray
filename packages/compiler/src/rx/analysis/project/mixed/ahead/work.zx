import memory from "memory"
import host from "rx_project_host"

import type { AtomicIndex } from "memory"
import type { MixedWorker } from "rx_project_host"

export type Input = {
    worker: MixedWorker,
    cursor: AtomicIndex,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { worker, cursor, count } = in

    const completed = loop(memory.fetchAddIndexRelaxed(cursor, 1), {
        while: row => row < count,
        next: row => {
            if (host.preparedMixedIsZX(worker, row)) {
                host.runPreparedMixedZX(worker, row)
            } else {
                host.runPreparedMixedRX(worker, row)
            }

            row = memory.fetchAddIndexRelaxed(cursor, 1)
        }
    })
}
