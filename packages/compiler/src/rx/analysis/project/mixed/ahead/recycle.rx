<Module>
    <Type from="reset" as="Reset" />
    <Type from="operation" as="Operation" />

    <Args in={Reset.Input} out={void} />

    <Store from="workspace" as="workspace" />

    <If on={$in.rows != 0}>
        <Call
            fn="stage"
            in={{
                action: Operation.Action.ClearResults,
                row: 0
            }}
            setter={[$store.workspace.effect]}
        />

        <Call fn="reset" in={$in} />

        <Loop on={$in.index < $in.count}>
            <Call
                module="worker"
                in={{
                    count: $ctx.reset,
                    index: 0
                }}
            />
        </Loop>
    </If>

    <Call
        fn="stage"
        in={{
            action: Operation.Action.ResetBindings,
            row: 0
        }}
        setter={[$store.workspace.effect]}
    />
</Module>
