<Module>
    <Type from="reset" as="Reset" />

    <Args in={Reset.Input} out={void} />

    <Store from="workspace" as="workspace" />

    <If on={$in.rows != 0}>
        <Call
            fn="stage_recycle"
            in={{
                action: Reset.Action.ClearResults,
                worker: 0
            }}
            setter={[$store.workspace.recycle]}
        />

        <Call fn="reset" in={$in} />

        <Loop on={$in.index < $in.count}>
            <Call
                module="worker"
                in={{
                    count: $ctx.reset,
                    index: 0
                }}
            />
        </Loop>
    </If>

    <Call
        fn="stage_recycle"
        in={{
            action: Reset.Action.ResetBindings,
            worker: 0
        }}
        setter={[$store.workspace.recycle]}
    />
</Module>
