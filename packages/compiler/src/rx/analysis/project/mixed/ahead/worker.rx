<Module>
    <Type from="reset" as="Reset" />
    <Type from="operation" as="Operation" />

    <Args in={Reset.Worker} out={Reset.Worker} />

    <Store from="workspace" as="workspace" />

    <Call
        fn="stage"
        in={{
            action: Operation.Action.ResetWorker,
            row: $in.index
        }}
        setter={[$store.workspace.effect]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
