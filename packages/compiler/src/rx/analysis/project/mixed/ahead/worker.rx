<Module>
    <Type from="reset" as="Reset" />

    <Args in={Reset.Worker} out={Reset.Worker} />

    <Store from="workspace" as="workspace" />

    <Call
        fn="stage_recycle"
        in={{
            action: Reset.Action.ResetWorker,
            worker: $in.index
        }}
        setter={[$store.workspace.recycle]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
