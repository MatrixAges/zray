export type Input = {
    zx_results: bool[],
    first: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { zx_results, first } = in

    return loop(first, {
        while: row => row < zx_results.length && !zx_results[row],
        next: row => {
            row += 1
        }
    })
}
