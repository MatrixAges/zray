import { mixedResultIsZX } from "rx_project_host"

import type { MixedWorkspace } from "rx_project_host"

export type Input = {
    workspace: MixedWorkspace,
    rows: u64,
    first: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { workspace, rows, first } = in

    return loop(first, {
        while: row => row < rows && !mixedResultIsZX(workspace, row),
        next: row => {
            row += 1
        }
    })
}
