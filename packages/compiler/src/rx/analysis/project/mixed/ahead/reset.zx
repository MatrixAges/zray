export type Input = {
    rows: u64,
    workers: u64
}

export type Worker = {
    count: u64,
    index: u64
}

export enum Action {
    ClearResults,
    ResetWorker,
    ResetBindings
}

export type Recycle = {
    action: Action,
    worker: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { rows, workers } = in

    return rows < workers ? rows : workers
}
