import type { MixedWorkspace } from "rx_project_host"

export type Input = {
    rows: u64,
    workers: u64
}

export type Request = Input & {
    workspace: MixedWorkspace
}

export type Worker = {
    workspace: MixedWorkspace,
    count: u64,
    index: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { rows, workers } = in

    return rows < workers ? rows : workers
}
