<Module>
    <Type from="model" as="Mixed" />

    <Args in={Mixed.Input} out={bool} />

    <Call fn="../../workflow.ready" in={$in} />

    <If on={!$ctx.ready}>
        <Return value={false} />
    </If>

    <Call fn="../../workflow.prepareWindow" in={$in} />
    <Call fn="../../workflow.restorePrefix" in={$in} />

    <If on={$ctx.restorePrefix}>
        <Return value={true} />
    </If>

    <Call fn="dispatch" in={$in} />

    <Switch on={$ctx.dispatch}>
        <Case value={Mixed.Action.NextWindow}>
            <Return value={true} />
        </Case>

        <Case value={Mixed.Action.MissingSignature}>
            <Call fn="../../workflow.rejectBody" in={$in} />
        </Case>

        <Case value={Mixed.Action.AnalyzeZX}>
            <Call fn="../../workflow.analyzeBody" in={$in} />
        </Case>

        <Case value={Mixed.Action.LowerRX}>
            <Call fn="../../workflow.lowerBody" in={$in} />
        </Case>
    </Switch>

    <Call fn="../../workflow.recordBody" in={$in} />

    <Return value={true} />
</Module>
