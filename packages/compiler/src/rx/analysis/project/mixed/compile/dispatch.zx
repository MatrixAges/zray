import mixed from "rx_project_workflow"

import { analyze_zx, lower_rx, missing_signature, next_window } from "./const"
import { Action } from "./model"

import type { Input } from "./model"

export type Output = Action

export default function (in: Input): Output {
    return match mixed.dispatchBody(in) {
        missing_signature => Action.MissingSignature,
        analyze_zx => Action.AnalyzeZX,
        lower_rx => Action.LowerRX,
        next_window => Action.NextWindow,
        _ => Action.Skip
    }
}
