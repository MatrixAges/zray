<Module>
    <Type from="model" as="Mixed" />

    <Args in={Mixed.Input} out={void} />

    <Call fn="walk" in={$in} />
    <Call fn="../../workflow.materializeOutput" in={$in} />
    <Call fn="../../workflow.publishExports" in={$in} />
    <Call fn="../../workflow.retainHistory" in={$in} />
</Module>
