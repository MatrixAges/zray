<Module>
    <Type from="model" as="Mixed" />

    <Args in={Mixed.Input} out={void} />

    <Call fn="walk" in={$in} />
    <Call fn="../../workflow/" export="materializeOutput" in={$in} />
    <Call fn="../../workflow/" export="publishExports" in={$in} />
    <Call fn="../../workflow/" export="retainHistory" in={$in} />
</Module>
