import host from "rx_project_host"

import type { Input as WindowInput } from "./windows"

export type Input = WindowInput

export type Output = void

export default function (in: Input): Output {
    host.materializeMixedModule(in.state)

    if (in.has_exports) {
        host.publishMixedExports(in.state)
    }

    if (in.retain) {
        host.retainMixedHistory(in.state)
    }
}
