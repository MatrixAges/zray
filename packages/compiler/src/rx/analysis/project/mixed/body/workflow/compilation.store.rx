<Store name="mixed_body_compilation" version={1}>
    <Type from="effect" as="Body" />

    <Object name="effect">
        <Field name="step" type={Body.Step} value={Body.Step.OpenZX} />
        <Field name="checked" type={bool?} value={null} />
        <Field name="entry" type={bool?} value={null} />
        <Field name="message" type={string?} value={null} />
        <Field name="ready" type={bool} value={false} />
        <Field name="declared" type={bool} value={false} />
        <Field name="slots" type={u64} value={0} />
    </Object>
</Store>
