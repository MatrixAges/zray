<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Request} out={void} />

    <Call fn="types" in={$in.boundary} />

    <Call
        fn="host.appendMixedBodyLink"
        in={[
            $in.body,
            $in.boundary.prepared.functions == $in.boundary.body_functions,
            $ctx.types,
            $in.source,
            $in.initializers != $in.retained
        ]}
    />

    <If on={$ctx.appendMixedBodyLink != null}>
        <Call
            fn="commit"
            in={{
                ...$in.pick([
                    "verified",
                    "present"
                ]),
                count: $ctx.appendMixedBodyLink
            }}
        />

        <Else>
            <Call
                fn="reject"
                in={$in.pick([
                    "body",
                    "source"
                ])}
            />
        </Else>
    </If>
</Module>
