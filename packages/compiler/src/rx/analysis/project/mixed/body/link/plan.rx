<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Body} out={Link.Plan} />

    <Call
        fn="types"
        in={$in.pick([
            "prepared",
            "current"
        ])}
    />

    <Return
        value={{
            replace_prefix: $in.prepared.functions == $in.body_functions,
            type_prefix: $ctx.types
        }}
    />
</Module>
