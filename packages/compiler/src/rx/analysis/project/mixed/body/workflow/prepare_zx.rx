<Module>
    <Type from="model" as="Body" />
    <Type from="effect" as="Effect" />

    <Args in={Body.Preparation} out={void} />

    <Store from="compilation" as="compilation" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.OpenZX
        }}
        setter={[$store.compilation.effect]}
    />

    <If on={$in.check}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.CheckZX
            }}
            setter={[$store.compilation.effect]}
        />
    </If>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.BindZX,
            checked: $in.check
        }}
        setter={[$store.compilation.effect]}
    />
</Module>
