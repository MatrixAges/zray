import host from "rx_project_host"

import type { Mixed as Input } from "rx_project_host"

export type Output = u64

export default function (in: Input): Output {
    const row = host.preparedMixedZXRow(in)

    if (row != null) {
        if (host.acceptsPreparedMixedZX(in, row)) {
            return host.linkPreparedMixedZX(in, row)
        }

        host.retirePreparedMixedZX(in, row)
    }

    return host.analyzeMixedZX(in)
}
