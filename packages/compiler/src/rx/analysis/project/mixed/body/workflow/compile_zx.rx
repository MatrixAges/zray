<Module>
    <Type from="model" as="Body" />

    <Args in={Body.ZXBody} out={void} />

    <Call
        module="prepare_zx"
        in={{
            source: $in.source,
            check: true
        }}
    />

    <Call fn="host.analyzeMixedZXBody" in={$in.body} />

    <If on={$ctx.analyzeMixedZXBody != null}>
        <If on={$in.setter}>
            <Call fn="authorize_setter" in={$ctx.analyzeMixedZXBody} />

            <If on={$ctx.authorize_setter != null}>
                <Call
                    fn="host.rejectMixedZXSetter"
                    in={[
                        $in.body,
                        $ctx.authorize_setter
                    ]}
                />

                <Else>
                    <Call fn="host.installMixedZXSetter" in={$in.body} />
                </Else>
            </If>
        </If>

        <Call fn="host.linkMixedZXBody" in={$in.body} />

        <Else>
            <Call fn="host.reportMixedZXBody" in={$in.body} />
        </Else>
    </If>
</Module>
