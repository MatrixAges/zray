<Module>
    <Type from="model" as="Body" />
    <Type from="effect" as="Effect" />

    <Args in={Body.RXBody} out={void} />

    <Store from="compilation" as="compilation" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.BindRX
        }}
        setter={[$store.compilation.effect]}
    />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.LowerRX,
            entry: $in.index == $in.entry
        }}
        setter={[$store.compilation.effect]}
    />

    <Call fn="read_ready" in={$store.compilation.effect} />

    <If on={$ctx.read_ready}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.LinkRX
            }}
            setter={[$store.compilation.effect]}
        />

        <Else>
            <Call
                fn="stage"
                in={{
                    step: Effect.Step.ReportRX
                }}
                setter={[$store.compilation.effect]}
            />
        </Else>
    </If>
</Module>
