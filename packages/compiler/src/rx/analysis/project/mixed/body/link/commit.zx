import memory from "memory"

import type { Publication } from "./model"

export type Input = Publication & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { count, verified, present } = in

    memory.writeColumnIndex(verified, 0, count)

    if (present != null) {
        memory.writeBool(present, 0, true)
    }
}
