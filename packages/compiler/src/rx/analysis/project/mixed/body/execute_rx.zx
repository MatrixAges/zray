import host from "rx_project_host"

import type { Mixed as Input } from "rx_project_host"

export type Output = u64

export default function (in: Input): Output {
    const row = host.acceptedPreparedMixedRX(in)

    if (row != null) {
        return host.linkPreparedMixedRX(in, row)
    }

    return host.lowerMixedRX(in)
}
