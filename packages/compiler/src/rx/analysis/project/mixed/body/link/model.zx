import type { BoolBuffer, WriteColumn } from "memory"
import type { MixedBodyLink } from "rx_project_host"

export type Boundary = {
    functions: u64,
    types: u64
}

export type Body = {
    prepared: Boundary,
    current: Boundary,
    body_functions: u64
}

export type Publication = {
    verified: WriteColumn,
    present?: BoolBuffer
}

export type Request = Publication & {
    body: MixedBodyLink,
    source: bool,
    initializers: u64,
    retained: u64,
    boundary: Body
}
