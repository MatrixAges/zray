export type Boundary = {
    functions: u64,
    types: u64
}

export type Body = {
    prepared: Boundary,
    current: Boundary,
    body_functions: u64
}

export type Request = {
    source: bool,
    boundary: Body
}

export type Result = {
    replace_prefix: bool,
    type_prefix?: u64,
    shared_initializers: bool,
    message: string
}
