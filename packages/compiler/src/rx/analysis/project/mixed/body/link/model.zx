import type { SourceBody } from "project_host"

export type Boundary = {
    functions: u64,
    types: u64
}

export type Body = {
    prepared: Boundary,
    current: Boundary,
    body_functions: u64
}

export type Request = {
    body: SourceBody,
    source: bool,
    initializers: u8[],
    shared: u8[],
    boundary: Body
}

export type Result = {
    verified?: u64,
    message?: string
}
