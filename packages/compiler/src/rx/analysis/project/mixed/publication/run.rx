<Module>
    <Type from="../windows" as="Windows" />
    <Type from="../operation" as="Operation" />

    <Args in={Windows.Input} out={void} />

    <Store from="../operation" as="mixed" />

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.Materialize
        }}
        setter={[$store.mixed.effect]}
    />

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.Observations
        }}
        setter={[$store.mixed.effect]}
    />

    <If on={$in.has_exports}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.Exports
            }}
            setter={[$store.mixed.effect]}
        />
    </If>

    <If on={$in.retain}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.Retain
            }}
            setter={[$store.mixed.effect]}
        />
    </If>
</Module>
