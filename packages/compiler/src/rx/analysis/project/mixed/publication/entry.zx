import integers from "std:integer"

export enum Form {
    Missing,
    InvalidFunction,
    TypeOnly,
    Function
}

export type Input = {
    present: bool,
    function?: u32,
    natives: u32?[],
    rx: bool,
    has_exports: bool,
    has_members: bool
}

export type Output = {
    form: Form,
    visible: u64,
    entry?: u32
}

export default function (in: Input): Output {
    const id = in.function
    const count = in.natives.length

    if (!in.present) {
        return {
            form: Form.Missing,
            visible: 0
        }
    }

    if (id == null) {
        return {
            form: Form.TypeOnly,
            visible: count
        }
    }

    const row = integers.widen(id)

    if (row >= count) {
        return {
            form: Form.InvalidFunction,
            visible: 0
        }
    }

    const inline_body = (
        - in.rx
        - and !in.has_exports
        - and !in.has_members
    )

    if (inline_body) {
        return {
            form: Form.Function,
            visible: row
        }
    }

    return {
        form: Form.Function,
        visible: count,
        entry: in.natives[row] == null ? id : null
    }
}
