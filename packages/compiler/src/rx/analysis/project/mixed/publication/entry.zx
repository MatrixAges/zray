import integers from "std:integer"

import { invalid_entry_function, missing_entry } from "./const"

export type Input = {
    present: bool,
    function?: u32,
    natives: u32?[],
    rx: bool,
    has_exports: bool,
    has_members: bool
}

export type Output = {
    visible: u64,
    function?: u32,
    entry?: u32,
    message?: string
}

export default function (in: Input): Output {
    const id = in.function
    const count = in.natives.length

    if (!in.present) {
        return {
            visible: 0,
            message: missing_entry
        }
    }

    if (id == null) {
        return {
            visible: count
        }
    }

    const row = integers.widen(id)

    if (row >= count) {
        return {
            visible: 0,
            message: invalid_entry_function
        }
    }

    const inline_body = (
        - in.rx
        - and !in.has_exports
        - and !in.has_members
    )

    if (inline_body) {
        return {
            visible: row,
            function: id
        }
    }

    const entry: u32? = in.natives[row] == null ? id : null

    return {
        visible: count,
        function: id,
        entry
    }
}
