import integers from "std:integer"
import host from "rx_project_host"

import { invalid_entry_function, missing_entry } from "./const"

import type { MixedEntry } from "rx_project_host"

export type Input = {
    target: MixedEntry,
    present: bool,
    function?: u32,
    natives: u32?[],
    rx: bool,
    has_exports: bool,
    has_members: bool
}

export type Output = void

export default function (in: Input): Output {
    const target = in.target
    const id = in.function
    const count = in.natives.length

    if (!in.present) {
        host.rejectMixedEntry(target, missing_entry)

        return
    }

    if (id == null) {
        host.installMixedTypeEntry(target, count)

        return
    }

    const row = integers.widen(id)

    if (row >= count) {
        host.rejectMixedEntry(target, invalid_entry_function)

        return
    }

    const inline_body = (
        - in.rx
        - and !in.has_exports
        - and !in.has_members
    )

    if (inline_body) {
        host.installMixedFunctionEntry(target, id, row, null)

        return
    }

    const entry: u32? = in.natives[row] == null ? id : null

    host.installMixedFunctionEntry(target, id, count, entry)
}
