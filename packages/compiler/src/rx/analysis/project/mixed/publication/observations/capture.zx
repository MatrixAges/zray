import memory from "memory"

import type { ListColumn } from "memory"

export type Input = {
    functions: ListColumn,
    first: u64,
    count: u64,
    shared_functions: u64
}

export type Output = {
    end: u64,
    shared: bool
}

export default function (in: Input): Output {
    const { functions, first, count, shared_functions } = in

    const shared = memory.listLength(functions, first) == shared_functions

    const end = loop(first + 1, {
        while: row => row < count &&
            (memory.listLength(functions, row) == shared_functions) == shared,
        next: row => {
            row += 1
        }
    })

    return {
        end,
        shared
    }
}
