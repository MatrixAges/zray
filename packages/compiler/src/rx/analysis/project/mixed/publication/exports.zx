import host from "rx_project_host"

import { invalid_export_name, missing_export } from "./const"

import type { MixedExports } from "rx_project_host"

export type Input = {
    target: MixedExports,
    roots: u64[],
    compiled: bool[],
    invalid_name?: u64
}

export type Output = void

export default function (in: Input): Output {
    const first: u64 = 0

    const copied = loop(first, {
        while: index => index < in.roots.length,
        next: index => {
            const { roots, compiled, invalid_name, target } = in
            if (invalid_name != null && invalid_name == index) {
                host.rejectMixedExport(target, invalid_export_name)
            } else {
                const root = roots[index]

                if (compiled[root]) {
                    host.installMixedExport(target, index, root)
                } else {
                    host.rejectMixedExport(target, missing_export)
                }
            }

            index += 1
        }
    })
}
