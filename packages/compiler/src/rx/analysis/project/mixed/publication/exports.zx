import { invalid_export_name, missing_export } from "./const"

export type Input = {
    roots: u64[],
    compiled: bool[],
    invalid_name?: u64
}

export type Output = {
    count: u64,
    message?: string
}

export default function (in: Input): Output {
    const { roots, compiled, invalid_name } = in

    const first: Output = {
        count: 0
    }

    return loop(first, {
        while: state => state.count < roots.length && state.message == null,
        next: state => {
            if (invalid_name != null && invalid_name == state.count) {
                state.message = invalid_export_name
            } else if (!compiled[roots[state.count]]) {
                state.message = missing_export
            } else {
                state.count += 1
            }
        }
    })
}
