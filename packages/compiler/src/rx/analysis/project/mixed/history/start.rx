<Module>
    <Type from="model" as="History" />

    <Args in={History.Start} out={bool} />

    <Call fn="../../history/inputs" in={$in.inputs} />

    <If on={!$ctx.inputs}>
        <Return value={false} />
    </If>

    <Call fn="checkpoint" in={$in.boundary} />

    <If on={!$ctx.checkpoint}>
        <Return value={false} />
    </If>

    <Call fn="graph_match" in={$in.graph} />

    <If on={!$ctx.graph_match}>
        <Return value={false} />
    </If>

    <Call module="align" in={$in.alignment} />

    <If on={!$ctx.align}>
        <Return value={false} />
    </If>

    <Call fn="index.matchHistoryHeaders" in={$in.functions} />

    <Return value={$ctx.matchHistoryHeaders} />
</Module>
