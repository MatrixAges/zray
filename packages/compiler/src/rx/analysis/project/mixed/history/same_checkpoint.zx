import memory from "memory"

import type { ReadColumn } from "memory"

export type Input = {
    earlier: ReadColumn,
    current: u64[]
}

export type Output = bool

export default function (in: Input): Output {
    const { earlier, current } = in

    return loop(0, {
        while: slot => slot < current.length &&
            memory.readColumnIndex(earlier, slot) == current[slot],
        next: slot => {
            slot += 1
        },
        return: slot => slot == current.length
    })
}
