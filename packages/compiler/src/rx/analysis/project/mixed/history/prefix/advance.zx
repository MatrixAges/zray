import host from "rx_project_host"

import scan from "./scan"

import type { HistoryReplay } from "rx_project_host"
import type { Input as Prefix } from "./model"

export type Input = {
    prefix: Prefix,
    replay: HistoryReplay
}

export type Output = u64

export default function (in: Input): Output {
    const { prefix, replay } = in

    return loop({
        position: prefix.first,
        stopped: false
    }, {
        while: state => state.position < prefix.end && !state.stopped,
        next: state => {
            const result = scan({
                ...prefix,
                first: state.position
            })

            state.position = result.position

            if (result.inspect_store) {
                const matches = host.sameHistoryStore(
                    replay,
                    prefix.order[result.position]
                )

                if (matches) {
                    state.position += 1
                } else {
                    state.stopped = true
                }
            } else {
                state.stopped = true
            }
        },
        return: state => state.position
    })
}
