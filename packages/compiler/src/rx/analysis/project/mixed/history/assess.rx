<Module>
    <Type from="model" as="History" />

    <Args in={History.Reanalysis} out={History.Assessment} />

    <Call module="align" in={$in.alignment} />

    <If on={!$ctx.align}>
        <Return value={History.Assessment.Misaligned} />
    </If>

    <If on={$in.compiled_dependency}>
        <Return value={History.Assessment.Changed} />
    </If>

    <Call fn="changed" in={$in.dependencies} />

    <If on={$ctx.changed}>
        <Return value={History.Assessment.Changed} />
    </If>

    <Call fn="stable" in={$in.functions} />

    <If
        on={$in.comparison != null && $ctx.stable == History.Assessment.CompareFunctions}
    >
        <Call module="compare_functions" in={$in.comparison} />

        <If on={$ctx.compare_functions}>
            <Return value={History.Assessment.Unchanged} />
        </If>

        <Return value={History.Assessment.Changed} />
    </If>

    <Return value={$ctx.stable} />
</Module>
