import changed from "../changed"
import sameSignature from "../signature"
import sameBoundaries from "./boundaries"
import sameDigest from "./digest"
import readSignature from "./read_signature"

import type { Ranges } from "../../../source_graph/source"
import type { History } from "./model"

export type Input = {
    history?: History,
    sources: Ranges,
    index: u64,
    position: u64,
    entry: u64
}

export enum Decision {
    Analyze,
    Reuse,
    CompareStore
}

export type Output = Decision

export default function (in: Input): Output {
    const { history, index, position, entry, sources } = in

    if (history == null || index == entry) {
        return Decision.Analyze
    }

    const { compiled, starts, ends, targets, redone } = history.dependencies

    if (compiled[index]) {
        return Decision.Analyze
    }

    const dependency_changed = changed({
        dependencies: targets,
        redone,
        first: starts[index],
        end: ends[index]
    })

    if (dependency_changed) {
        return Decision.Analyze
    }

    const stable_links = sameBoundaries({
        boundaries: history.boundaries,
        position
    })

    if (!stable_links) {
        return Decision.Analyze
    }

    if (index >= sources.rx_end) {
        if (index < history.previous_sources.rx_end) {
            return Decision.Analyze
        }

        return history.shared_stores ? Decision.Reuse : Decision.CompareStore
    }

    const same = sameDigest({
        earlier: history.earlier,
        current: history.current,
        index
    })

    if (!same) {
        return Decision.Analyze
    }

    if (index < sources.zx_count) {
        return Decision.Reuse
    }

    const previous = history.previous_sources

    if (index < previous.zx_count || index >= previous.rx_end) {
        return Decision.Analyze
    }

    const signatures = history.signatures

    if (signatures == null) {
        return Decision.Reuse
    }

    const compatible = sameSignature({
        previous: readSignature({
            columns: signatures.earlier,
            row: index - previous.zx_count
        }),
        current: readSignature({
            columns: signatures.current,
            row: index - sources.zx_count
        })
    })

    return compatible ? Decision.Reuse : Decision.Analyze
}
