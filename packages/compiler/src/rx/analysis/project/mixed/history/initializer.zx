import prefix from "../../../../../zx/modules/link/source/initializer_prefix"

import type { InitializerPair } from "./link_model"

export type Input = InitializerPair

export type Output = bool

export default function (in: Input): Output {
    if (in.left.count != in.right.count) {
        return false
    }

    const count = prefix({
        ...in,
        identity: false
    })

    return count == in.left.count
}
