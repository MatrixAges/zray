import memory from "memory"

import type { Counters } from "./model"

export type Input = Counters & {
    count: u64,
    verified_end: u64
}

export type Output = void

export default function (in: Input): Output {
    memory.writeColumnIndex(in.verified, 0, in.verified_end)
    memory.writeColumnIndex(in.reused, 0, in.reused_before + in.count)
}
