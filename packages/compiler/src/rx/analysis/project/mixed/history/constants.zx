import memory from "memory"
import columns from "memory/columns"

import equal from "../../../../../zx/analysis/constants/bindings/borrowed_equal"

import type { Constants as Input } from "./link_model"

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (in.shared) {
        return true
    }

    return loop({
        row: 0,
        equal: true
    }, {
        while: state => state.equal && state.row < left.count,
        next: state => {
            const row = state.row
            const name = memory.readTextColumn(left.names, row)
            const type_id = columns.readColumnU32(left.types, row)

            state.equal = name == memory.readTextColumn(right.names, row) &&
                type_id == columns.readColumnU32(right.types, row) &&
                equal({
                    previous: left.values,
                    current: right.values,
                    left: row,
                    right: row
                })
            state.row += 1
        },
        return: state => state.equal
    })
}
