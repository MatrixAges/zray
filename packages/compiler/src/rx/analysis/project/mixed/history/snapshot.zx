import type { Extent } from "./extent"

export type Input = {
    types: u64[],
    origins: u64[],
    extent: Extent
}

export type Output = u64[]

export default function (in: Input): Output {
    const { types, origins, extent } = in

    const words: u64[] = []

    const captured = loop(words, {
        while: values => values.length < types.length + origins.length,
        next: values => {
            const slot = values.length
            const count = match {
                slot < types.length => types[slot],
                _ => origins[slot - types.length]
            }

            values = values.push(count)[0]
        }
    })

    const extent_words = [
        extent.functions,
        extent.native_modules,
        extent.initializers,
        extent.libraries
    ]

    return captured.concat(extent_words)[0]
}
