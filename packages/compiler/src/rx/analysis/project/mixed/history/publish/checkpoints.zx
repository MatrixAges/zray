import copySpan from "./span"

import type { Output as Span } from "./span"

export type Input = {
    first: u64,
    end: u64,
    checkpoints: u64
}

export type Output = Span

export default function (in: Input): Output {
    return copySpan({
        width: in.checkpoints,
        first: in.first + 1,
        end: in.end + 1
    })
}
