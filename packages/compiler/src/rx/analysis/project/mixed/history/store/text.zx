import bytes from "std:bytes"
import host from "rx_project_host"

import type { Text as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const [left, right] = in

    if (host.historyTextValue(left) != host.historyTextValue(right)) {
        return false
    }

    return bytes.equals(
        host.historyTextPosition(left),
        host.historyTextPosition(right)
    )
}
