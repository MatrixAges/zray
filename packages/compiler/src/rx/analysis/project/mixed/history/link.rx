<Module>
    <Type from="link_model" as="History" />

    <Args in={History.Link} out={bool} />

    <Call fn="ports" in={$in.ports} />

    <If on={!$ctx.ports}>
        <Return value={false} />
    </If>

    <Call fn="exports" in={$in.exports} />

    <If on={!$ctx.exports}>
        <Return value={false} />
    </If>

    <Call fn="initializer" in={$in.initializers} />

    <If on={!$ctx.initializer}>
        <Return value={false} />
    </If>

    <If
        on={$in.members.left.count != $in.members.right.count ||
            $in.constants.left.count != $in.constants.right.count}
    >
        <Return value={false} />
    </If>

    <Call fn="members" in={$in.members} />

    <If on={!$ctx.members}>
        <Return value={false} />
    </If>

    <Call fn="constants" in={$in.constants} />

    <Return value={$ctx.constants} />
</Module>
