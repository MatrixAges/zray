import type { ReadColumn } from "memory"
import type { Layout } from "../../../../../syntax/tree/layout"
import type { Ports } from "../../../signatures/model"
import type { Ranges } from "../../../source_graph/source"

export type Dependencies = {
    compiled: bool[],
    starts: u64[],
    ends: u64[],
    targets: u64[],
    redone: bool[]
}

export type Digests = {
    words: u64[],
    present: bool[]
}

export type Boundaries = {
    words: ReadColumn,
    stride: u64,
    functions_offset: u64
}

export type SignatureColumns = Ports & {
    names: string[],
    bindings: u8[],
    tasks: u8[]
}

export type Signatures = {
    earlier: SignatureColumns,
    current: SignatureColumns
}

export type Stores = {
    earlier: u8[],
    current: u8[],
    width: u64,
    node_offset: u64,
    layout: Layout
}

export type History = {
    dependencies: Dependencies,
    earlier: Digests,
    current: Digests,
    boundaries: Boundaries,
    previous_sources: Ranges,
    signatures?: Signatures,
    stores?: Stores
}

export type Input = {
    order: ReadColumn,
    first: u64,
    end: u64,
    entry: u64,
    sources: Ranges,
    history: History
}
