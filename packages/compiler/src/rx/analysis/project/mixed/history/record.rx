<Module>
    <Type from="model" as="History" />

    <Args in={History.Record} out={History.RecordResult} />

    <Call fn="snapshot" in={$in.capture} />

    <If on={$in.analysis != null}>
        <Call module="assess" in={$in.analysis} />

        <Call
            fn="record_assessment"
            in={{
                ...$in.target,
                assessment: $ctx.assess
            }}
        />

        <Return
            value={{
                checkpoint: $ctx.snapshot,
                recorded: $ctx.record_assessment
            }}
        />
    </If>

    <Call
        fn="record_assessment"
        in={{
            ...$in.target,
            assessment: null
        }}
    />

    <Return
        value={{
            checkpoint: $ctx.snapshot,
            recorded: $ctx.record_assessment
        }}
    />
</Module>
