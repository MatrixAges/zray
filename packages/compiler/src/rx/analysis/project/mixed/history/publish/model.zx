import type { ReadColumn, U8Buffer, WriteColumn } from "memory"

export type Column = {
    earlier: u8[],
    current: U8Buffer,
    width: u64
}

export type Modules = {
    surfaces: Column,
    functions: Column,
    present: Column,
    available: bool[]
}

export type Counters = {
    verified: WriteColumn,
    reused: WriteColumn,
    reused_before: u64
}

export type Input = {
    rows: ReadColumn,
    first: u64,
    end: u64,
    modules: Modules,
    checkpoints: Column
    counters: Counters
    verified_end: u64
}
