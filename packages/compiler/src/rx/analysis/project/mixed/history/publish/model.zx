import type { Output as Counters } from "./counters"
import type { Input as Modules, Output as ModuleSpans } from "./modules"
import type { Output as Span } from "./span"

export type Input = Modules & {
    checkpoints: u64,
    reused_before: u64,
    verified_end: u64
}

export type Output = {
    modules: ModuleSpans,
    checkpoints: Span,
    counters: Counters
}
