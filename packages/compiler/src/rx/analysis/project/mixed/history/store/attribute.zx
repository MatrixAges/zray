import columns from "memory/columns"

import samePosition from "./position"

import type { Pair as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { left, right, layout } = in
    const { attribute_kind: kind, attribute_name: name, attribute_value: value } = layout

    if (left[kind] != right[kind]) {
        return false
    }

    if (
        columns.readBorrowedRowText(left, name) !=
            columns.readBorrowedRowText(right, name)
    ) {
        return false
    }

    if (
        columns.readBorrowedRowText(left, value) !=
            columns.readBorrowedRowText(right, value)
    ) {
        return false
    }

    const width = layout.location_width

    if (!samePosition({
        left,
        right,
        offset: layout.attribute_location,
        width
    })) {
        return false
    }

    if (!samePosition({
        left,
        right,
        offset: layout.attribute_value_location,
        width
    })) {
        return false
    }

    const offset = layout.attribute_raw_value
    const raw_left = columns.readBorrowedRowOptionalText(left, offset)
    const raw_right = columns.readBorrowedRowOptionalText(right, offset)

    if (raw_left == null) {
        return raw_right == null
    }

    if (raw_right == null) {
        return false
    }

    return raw_left == raw_right
}
