import memory from "memory"
import columns from "memory/columns"

import leaves from "./leaves"
import { Leaf } from "./model"
import samePosition from "./position"

import type { Pair as Input } from "./model"

export type Output = bool

export default function equal(in: Input): Output {
    const { left, right, layout } = in

    if (columns.sameBorrowedBytes(left, right)) {
        return true
    }

    const name = layout.node_name

    if (
        columns.readBorrowedRowText(left, name) !=
            columns.readBorrowedRowText(right, name)
    ) {
        return false
    }

    if (!samePosition({
        left,
        right,
        offset: layout.node_location,
        width: layout.location_width
    })) {
        return false
    }

    const { node_attributes, attribute_width } = layout

    if (!leaves({
        left: columns.readBorrowedRowList(left, node_attributes, attribute_width),
        right: columns.readBorrowedRowList(right, node_attributes, attribute_width),
        layout,
        leaf: Leaf.Attribute
    })) {
        return false
    }

    const { node_children, node_width } = layout

    const left_children = columns.readBorrowedRowList(left, node_children, node_width)
    const right_children = columns.readBorrowedRowList(right, node_children, node_width)

    if (left_children.length != right_children.length) {
        return false
    }

    if (!columns.sameBorrowedBytes(left_children, right_children)) {
        const children = loop({
            offset: 0,
            matches: true
        }, {
            while: state => state.matches && state.offset < left_children.length,
            next: state => {
                state.matches = equal({
                    left: memory.borrowU8Range(
                        left_children,
                        state.offset,
                        node_width
                    ),
                    right:
                        memory.borrowU8Range(
                            right_children,
                            state.offset,
                            node_width
                        ),
                    layout
                })
                state.offset += node_width
            },
            return: state => state.matches
        })

        if (!children) {
            return false
        }
    }

    const { node_text, text_width } = layout

    return leaves({
        left: columns.readBorrowedRowList(left, node_text, text_width),
        right: columns.readBorrowedRowList(right, node_text, text_width),
        layout,
        leaf: Leaf.Text
    })
}
