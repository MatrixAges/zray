import memory from "memory"

import { initializer_column, library_column, native_module_column } from "./const"

import type { Boundaries } from "./model"

export type Input = {
    boundaries: Boundaries,
    position: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { words, stride, functions_offset } = in.boundaries

    const before = in.position * stride + functions_offset
    const after = before + stride

    const natives = memory.readColumnIndex(words, before + native_module_column) ==
        memory.readColumnIndex(words, after + native_module_column)

    const initializers =
        memory.readColumnIndex(words, before + initializer_column) ==
        memory.readColumnIndex(words, after + initializer_column)

    const libraries = memory.readColumnIndex(words, before + library_column) ==
        memory.readColumnIndex(words, after + library_column)

    return natives && initializers && libraries
}
