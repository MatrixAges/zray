import { initializer_column, library_column } from "./const"

import type { Boundaries } from "./model"

export type Input = {
    boundaries: Boundaries,
    position: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { words, stride, links_offset } = in.boundaries

    const before = in.position * stride + links_offset
    const after = before + stride
    const natives = words[before] == words[after]

    const initializers =
        words[before + initializer_column] == words[after + initializer_column]

    const libraries = words[before + library_column] == words[after + library_column]

    return natives && initializers && libraries
}
