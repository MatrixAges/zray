import bytes from "std:bytes"

import type { Source } from "./reuse_model"

export type Input = Source

export type Output = bool

export default function (in: Input): Output {
    if (in.store) {
        return true
    }

    const previous = in.previous_digest
    const current = in.current_digest

    if (previous == null || current == null) {
        return false
    }

    return bytes.equals(previous, current)
}
