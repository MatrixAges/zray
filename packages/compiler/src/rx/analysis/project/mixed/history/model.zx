import type { BoolBuffer, WriteColumn } from "memory"
import type { HistoryFunctionRange, HistoryModuleLink } from "rx_project_host"
import type { ColumnPair } from "../../../../../zx/ir/compare/model"
import type { Inputs as SourceInputs } from "../../history/model"
import type { Input as Dependencies } from "./changed"
import type { Extent } from "./extent"
import type { Input as Capture } from "./snapshot"

export type Alignment = {
    extent_left: Extent,
    extent_right: Extent,
    columns: ColumnPair
}

export type FunctionRange = {
    first: u64,
    previous_first: u64,
    linked: bool,
    store: bool
}

export type Reanalysis = {
    alignment: Alignment,
    dependencies: Dependencies,
    compiled_dependency: bool,
    functions: FunctionRange,
    comparison: Comparison
}

export type Comparison = {
    link: HistoryModuleLink,
    functions: HistoryFunctionRange
}

export type RecordTarget = {
    row: u64,
    analyzed: u64,
    counter: WriteColumn,
    redone: BoolBuffer,
    aligned: BoolBuffer
}

export type Record = {
    capture: Capture,
    target: RecordTarget,
    analysis?: Reanalysis
}

export enum Assessment {
    Misaligned,
    Changed,
    Unchanged,
    CompareFunctions
}

export type Graph = {
    earlier_order: u8[],
    current_order: u8[],
    earlier_paths: string[],
    current_paths: string[],
    shared_paths: bool
}

export type Earlier = {
    inputs: SourceInputs,
    checkpoint: u8[],
    graph: Graph,
    alignment: Alignment,
    functions: HistoryFunctionRange
}

export type Start = {
    capture: Capture,
    checkpoint: u8[],
    earlier?: Earlier
}
