import { Assessment } from "./model"

import type { RecordTarget, Recorded } from "./model"

export type Input = RecordTarget & {
    assessment?: Assessment
}

export type Output = Recorded

export default function (in: Input): Output {
    return {
        analyzed: in.analyzed + 1,
        redone: in.assessment != Assessment.Unchanged,
        aligned: in.aligned && in.assessment != Assessment.Misaligned
    }
}
