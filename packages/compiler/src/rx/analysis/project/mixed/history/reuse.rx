<Module>
    <Type from="reuse_model" as="History" />

    <Args in={History.Input} out={bool} />

    <If on={$in.compiled_dependency}>
        <Return value={false} />
    </If>

    <Call
        fn="links"
        in={$in.pick([
            "before",
            "after"
        ])}
    />

    <If on={!$ctx.links}>
        <Return value={false} />
    </If>

    <Call fn="same_source" in={$in.source} />

    <If on={!$ctx.same_source}>
        <Return value={false} />
    </If>

    <Call fn="changed" in={$in.dependencies} />

    <If on={$ctx.changed}>
        <Return value={false} />
    </If>

    <Call fn="confirm" in={$in.confirmation} />

    <Return value={$ctx.confirm} />
</Module>
