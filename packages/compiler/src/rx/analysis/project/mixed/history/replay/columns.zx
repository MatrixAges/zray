import memory from "memory"

import type { Range, Restore as Input } from "./model"

export type Output = Range[]

export default function (in: Input): Output {
    const { boundaries, column_count } = in
    const { words, stride, functions_offset } = boundaries

    const first = in.first * stride
    const end = in.end * stride
    const ranges: Output = []

    return loop({
        column: 0,
        ranges
    }, {
        while: state => state.column < column_count,
        next: state => {
            const { column } = state
            const slot = column < functions_offset ? column : functions_offset
            const from = memory.readColumnIndex(words, first + slot)
            const to = memory.readColumnIndex(words, end + slot)

            if (from != to) {
                state.ranges = state.ranges.push({
                    column,
                    first: from,
                    count: to - from
                })[0]
            }

            state.column += 1
        },
        return: state => state.ranges
    })
}
