import memory from "memory"

import copySpan from "./span"

import type { ReadColumn } from "memory"
import type { Output as Span } from "./span"

export type Input = {
    rows: ReadColumn,
    modules: {
        surfaces: u64,
        functions: u64,
        present: u64,
        available: bool[]
    },
    first: u64,
    end: u64
}

export type Spans = {
    present: Span,
    surfaces?: Span,
    functions?: Span
}

export type Output = Spans[]

export default function (in: Input): Output {
    const { rows, modules, end } = in
    const { surfaces, functions, present, available } = modules

    const spans: Output = []

    return loop({
        position: in.first,
        spans
    }, {
        while: current => current.position < end,
        next: current => {
            const { position } = current
            const first = memory.readColumnIndex(rows, position)
            const loaded = available[first]
            const next = loop({
                next: position + 1,
                row: first + 1
            }, {
                while: state =>
                    state.next < end &&
                    memory.readColumnIndex(rows, state.next) == state.row &&
                    available[state.row] == loaded,
                next: state => {
                    state.next += 1
                    state.row += 1
                },
                return: state => state.next
            })
            const limit = first + (next - position)

            const present_span = copySpan({
                width: present,
                first,
                end: limit
            })

            if (loaded) {
                current.spans = current.spans.push({
                    present: present_span,
                    surfaces: copySpan({
                        width: surfaces,
                        first,
                        end: limit
                    }),
                    functions: copySpan({
                        width: functions,
                        first,
                        end: limit
                    })
                })[0]
            } else {
                current.spans = current.spans.push({
                    present: present_span
                })[0]
            }

            current.position = next
        },
        return: current => current.spans
    })
}
