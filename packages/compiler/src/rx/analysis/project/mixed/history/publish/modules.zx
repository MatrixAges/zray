import memory from "memory"

import copySpan from "./span"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("rows", "modules", "first", "end")

export type Output = void

export default function (in: Input): Output {
    const { rows, modules, end } = in
    const { surfaces, functions, present, available } = modules

    const copied = loop(in.first, {
        while: position => position < end,
        next: position => {
            const first = memory.readColumnIndex(rows, position)
            const loaded = available[first]
            const next = loop({
                next: position + 1,
                row: first + 1
            }, {
                while: state =>
                    state.next < end &&
                    memory.readColumnIndex(rows, state.next) == state.row &&
                    available[state.row] == loaded,
                next: state => {
                    state.next += 1
                    state.row += 1
                },
                return: state => state.next
            })
            const limit = first + (next - position)

            copySpan({
                column: present,
                first,
                end: limit
            })

            if (loaded) {
                copySpan({
                    column: surfaces,
                    first,
                    end: limit
                })
                copySpan({
                    column: functions,
                    first,
                    end: limit
                })
            }

            position = next
        }
    })
}
