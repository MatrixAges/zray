import type { Rows as ConstantRows } from "core/constant/rows"
import type { NamedRows } from "memory"
import type { BindingColumns } from "../../../../../zx/modules/binding/model"
import type { Prefix } from "../../../../../zx/modules/link/source/initializer_rows"

export type Port = {
    function?: u32,
    input_type: u32,
    output_type: u32
}

export type PortPair = {
    left: Port,
    right: Port
}

export type ExportPair = {
    left: NamedRows,
    right: NamedRows,
    left_count: u64,
    right_count: u64,
    shared: bool
}

export type InitializerPair = Prefix

export type Link = {
    ports: PortPair,
    exports: ExportPair,
    initializers: InitializerPair,
    members: Members,
    constants: Constants
}

export type Members = {
    left: BindingColumns,
    right: BindingColumns,
    shared: bool
}

export type Constants = {
    left: ConstantRows,
    right: ConstantRows,
    shared: bool
}
