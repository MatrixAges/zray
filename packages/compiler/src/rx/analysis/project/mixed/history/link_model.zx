import type { Literal } from "core/constant/model"
import type { TextColumn } from "memory"
import type { FunctionBinding } from "../../../../../zx/modules/binding/model"
import type { Prefix } from "../../../../../zx/modules/link/source/initializer_rows"

export type Port = {
    function?: u32,
    input_type: u32,
    output_type: u32
}

export type Rows = {
    names: TextColumn,
    data: u8[],
    count: u64
}

export type Constant = {
    name: string,
    value: Literal
}

export type PortPair = {
    left: Port,
    right: Port
}

export type RowPair = {
    left: Rows,
    right: Rows,
    stride: u64,
    little_endian: bool,
    shared: bool
}

export type ExportPair = RowPair & {
    type_id: u64
}

export type InitializerPair = Prefix.Omit("identity", "function_prefix")

export type Link = {
    ports: PortPair,
    exports: ExportPair,
    initializers: InitializerPair
}

export type MemberPair = {
    left: FunctionBinding,
    right: FunctionBinding
}

export type ConstantPair = {
    left: Constant,
    right: Constant
}
