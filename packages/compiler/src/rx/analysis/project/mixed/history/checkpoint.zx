import bytes from "std:bytes"

import extent from "./extent"

import type { Extent } from "./extent"

export type Checkpoint = {
    types: u8[],
    origins: u8[],
    extent: Extent
}

export type Input = {
    before: Checkpoint,
    after: Checkpoint
}

export type Output = bool

export default function (in: Input): Output {
    const { before, after } = in

    const same_extent = extent({
        left: before.extent,
        right: after.extent
    })

    if (!same_extent || !bytes.equals(before.types, after.types)) {
        return false
    }

    return bytes.equals(before.origins, after.origins)
}
