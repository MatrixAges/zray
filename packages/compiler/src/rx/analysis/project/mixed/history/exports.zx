import memory from "memory"

import type { ExportPair } from "./link_model"

export type Input = ExportPair

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (in.left_count != in.right_count) {
        return false
    }

    if (in.shared) {
        return true
    }

    return loop({
        row: 0,
        same: true
    }, {
        while: state => state.same && state.row < in.left_count,
        next: state => {
            const row = state.row
            const left_type = memory.readRowId(left, row)
            const right_type = memory.readRowId(right, row)

            state.same = left_type == right_type &&
                memory.readRowName(left, row) == memory.readRowName(right, row)

            state.row += 1
        },
        return: state => state.same
    })
}
