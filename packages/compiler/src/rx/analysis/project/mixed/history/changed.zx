export type Input = {
    dependencies: u64[],
    redone: bool[],
    first: u64,
    end: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { dependencies, redone, first, end } = in

    return loop({
        position: first,
        changed: false
    }, {
        while: state => state.position < end && !state.changed,
        next: state => {
            state.changed = redone[dependencies[state.position]]
            state.position += 1
        },
        return: state => state.changed
    })
}
