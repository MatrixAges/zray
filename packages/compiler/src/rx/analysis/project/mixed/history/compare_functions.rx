<Module>
    <Type from="model" as="History" />

    <Args in={History.Comparison} out={bool} />

    <Call fn="index.matchHistoryLink" in={$in.link} />

    <If on={!$ctx.matchHistoryLink}>
        <Return value={false} />
    </If>

    <Call module="../../../../../zx/ir/compare/header" in={$in.functions} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Call fn="../../../../../zx/ir/compare/referenced/bodies" in={$in.functions} />

    <Return value={$ctx.bodies} />
</Module>
