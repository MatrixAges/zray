import sameSignature from "./signature"
import sameStore from "./store/equal"

import type { Confirmation as Input } from "./reuse_model"

export type Output = bool

export default function (in: Input): Output {
    const { matches, signature } = in

    const store_nodes = in.store

    if (!matches) {
        return false
    }

    if (signature != null) {
        return sameSignature(signature)
    }

    if (store_nodes != null) {
        return sameStore(store_nodes)
    }

    return true
}
