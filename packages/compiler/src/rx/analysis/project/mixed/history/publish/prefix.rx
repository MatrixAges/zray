<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call
        fn="modules"
        in={$in.pick([
            "rows",
            "modules",
            "first",
            "end"
        ])}
    />

    <Call
        fn="checkpoints"
        in={$in.pick([
            "first",
            "end",
            "checkpoints"
        ])}
    />

    <Call
        fn="counters"
        in={{
            reused_before: $in.reused_before,
            count: $in.end - $in.first,
            verified_end: $in.verified_end
        }}
    />

    <Return
        value={{
            modules: $ctx.modules,
            checkpoints: $ctx.checkpoints,
            counters: $ctx.counters
        }}
    />
</Module>
