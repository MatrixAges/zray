<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call
        fn="modules"
        in={$in.pick([
            "rows",
            "modules"
        ])}
    />

    <Call
        fn="checkpoints"
        in={$in.pick([
            "first",
            "end",
            "checkpoints"
        ])}
    />

    <Call
        fn="counters"
        in={{
            ...$in.counters,
            count: $in.end - $in.first
        }}
    />
</Module>
