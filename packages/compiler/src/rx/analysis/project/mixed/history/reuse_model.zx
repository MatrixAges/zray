import type { Input as Dependencies } from "./changed"
import type { Links } from "./links"
import type { Input as Signatures } from "./signature"
import type { Nodes } from "./store/model"

export type Source = {
    store: bool,
    previous_digest?: u8[],
    current_digest?: u8[]
}

export type Confirmation = {
    matches: bool,
    signature?: Signatures,
    store?: Nodes
}

export type Input = {
    source: Source,
    compiled_dependency: bool,
    dependencies: Dependencies,
    before: Links,
    after: Links,
    confirmation: Confirmation
}
