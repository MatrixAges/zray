import host from "rx_project_host"

import equal from "./text"

import type { Rows as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const [left, right] = in

    const count = host.historyXmlRowCount(left)

    if (count != host.historyXmlRowCount(right)) {
        return false
    }

    if (host.historyXmlRowsShare(left, right)) {
        return true
    }

    return loop({
        row: 0,
        matches: true
    }, {
        while: state => state.matches && state.row < count,
        next: state => {
            const row = state.row

            state.matches = equal([
                host.historyTextAt(left, row, null),
                host.historyTextAt(right, row, null)
            ])
            state.row += 1
        },
        return: state => state.matches
    })
}
