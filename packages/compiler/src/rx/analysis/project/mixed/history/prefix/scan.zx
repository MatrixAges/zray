import probe from "./probe"
import { Decision } from "./probe"

import type { Input as PrefixInput, Output as PrefixOutput } from "./model"

export type Input = PrefixInput

export type Output = PrefixOutput

export default function (in: Input): Output {
    const { order, entry, end, sources, history } = in

    return loop({
        position: in.first,
        stopped: false,
        inspect_source: false
    }, {
        while: state => state.position < end && !state.stopped,
        next: state => {
            const index = order[state.position]
            const decision = probe({
                history,
                sources,
                index,
                position: state.position,
                entry
            })

            if (decision == Decision.Reuse) {
                state.position += 1
            } else {
                state.inspect_source = decision != Decision.Analyze
                state.stopped = true
            }
        },
        return: state => ({
            position: state.position,
            inspect_source: state.inspect_source
        })
    })
}
