import memory from "memory"

import probe from "./probe"

import type { Input as Window } from "./model"

export type Input = Window

export type Output = u64

export default function (in: Input): Output {
    const { order, entry, end, sources, history } = in

    return loop({
        position: in.first,
        reuse: true
    }, {
        while: state => state.reuse && state.position < end,
        next: state => {
            state.reuse = probe({
                history,
                sources,
                index: memory.readColumnIndex(order, state.position),
                position: state.position,
                entry
            })

            if (state.reuse) {
                state.position += 1
            }
        },
        return: state => state.position
    })
}
