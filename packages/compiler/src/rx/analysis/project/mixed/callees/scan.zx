import memory from "zig:compiler_memory"

import lookup from "./lookup"
import { Action } from "./model"

import type { Input as ScanInput, Output as ScanOutput } from "./model"

export type Input = ScanInput

export type Output = ScanOutput

export default function (in: Input): Output {
    const { calls, published, zx_count, rx_end, ids } = in

    return loop({
        position: in.first,
        target: 0,
        action: Action.Done
    }, {
        while: state => state.position < calls.rows.length && state.action == Action.Done,
        next: state => {
            const position = state.position
            const result = lookup({
                kind: calls.kinds[position],
                target: calls.rows[position],
                zx_count,
                rx_end,
                published
            })
            const id = result.function_id

            if (id != null) {
                memory.writeU32(ids, position, id)

                state.position += 1
            } else {
                state.target = result.target
                state.action = result.action
            }
        },
        return: state => ({
            position: state.position,
            target: state.target,
            action: state.action,
            function_id: null
        })
    })
}
