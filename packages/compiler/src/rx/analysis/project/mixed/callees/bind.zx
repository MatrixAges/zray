import {
    missing_member,
    missing_rx,
    missing_zx,
    not_executable_rx,
    not_executable_zx
} from "./const"
import lookup from "./lookup"
import { Action, EffectKind } from "./model"
import resume from "./resume"

import type { Published, Reply, Request, Targets } from "./model"

export type Input = {
    calls: Targets,
    published: Published,
    zx_count: u64,
    rx_end: u64,
    position: u64,
    reply?: Reply
}

export type Output = {
    ids: u32[],
    effect: Request
}

export default function (in: Input): Output {
    const empty: u32[] = []

    const { calls, published, zx_count, rx_end, reply } = in

    const initial: Output = {
        ids: empty,
        effect: {
            kind: EffectKind.Done,
            position: in.position
        }
    }

    const resumed = resume(reply)

    if (resumed.message != null) {
        return {
            ...initial,
            effect: {
                kind: EffectKind.Reject,
                position: in.position,
                message: resumed.message
            }
        }
    }

    const function_id = resumed.function_id

    const ids = match {
        function_id != null => [function_id],
        _ => empty
    }

    const first = reply == null ? in.position : in.position + 1

    return loop({
        cursor: first,
        output: {
            ...initial,
            ids
        }
    }, {
        while: state =>
            state.cursor < calls.rows.length &&
            state.output.effect.kind == EffectKind.Done,
        next: state => {
            const position = state.cursor
            const target = calls.rows[position]
            const selected = lookup({
                calls,
                published,
                zx_count,
                rx_end,
                position,
                target
            })

            const { action } = selected
            const id = selected.id

            if (action == Action.LoadLibrary) {
                state.output.effect = {
                    kind: EffectKind.ImportLibrary,
                    position,
                    target
                }
            } else if (action == Action.CompileSetter) {
                state.output.effect = {
                    kind: EffectKind.CompileSetter,
                    position,
                    target
                }
            } else if (id != null) {
                state.output.ids = state.output.ids.push(id)[0]
            } else {
                const message = match action {
                    Action.MissingMember => missing_member,
                    Action.MissingRX => missing_rx,
                    Action.MissingZX => missing_zx,
                    Action.NotExecutableRX => not_executable_rx,
                    _ => not_executable_zx
                }

                state.output.effect = {
                    kind: EffectKind.Reject,
                    position,
                    name: action == Action.MissingMember,
                    message
                }
            }

            state.cursor += 1
        },
        return: state => state.output
    })
}
