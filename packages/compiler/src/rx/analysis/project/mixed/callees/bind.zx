import host from "rx_project_host"

import admit from "../../../call/compiled_admission"
import { Output as Admission } from "../../../call/compiled_admission"
import {
    missing_member,
    missing_rx,
    missing_zx,
    not_executable_library,
    not_executable_rx,
    not_executable_zx,
    unauthorized_transaction
} from "./const"
import lookup from "./lookup"
import { Action } from "./model"

import type { MixedCallees } from "rx_project_host"
import type { Published, Targets } from "./model"

export type Input = {
    calls: Targets,
    published: Published,
    zx_count: u64,
    rx_end: u64,
    binding: MixedCallees
}

export type Output = u32[]

export default function (in: Input): Output {
    const ids: u32[] = []

    return loop({
        position: 0,
        ids
    }, {
        while: state => state.position < in.calls.rows.length,
        next: state => {
            const { position } = state
            const { calls, published, zx_count, rx_end, binding } = in
            const target = calls.rows[position]
            const selected = lookup({
                calls,
                published,
                zx_count,
                rx_end,
                position,
                target
            })

            const { action } = selected

            if (action == Action.LoadLibrary) {
                const imported = host.importMixedCallee(binding, position, target)
                const function_id = imported.function_id

                if (function_id == null) {
                    host.rejectMixedCallee(
                        binding,
                        position,
                        false,
                        not_executable_library
                    )
                } else {
                    const verdict = admit({
                        executable: true,
                        setter: imported.setter,
                        has_stores: imported.has_stores,
                        orchestration: imported.orchestration
                    })

                    if (verdict != Admission.Executable) {
                        host.rejectMixedCallee(
                            binding,
                            position,
                            false,
                            unauthorized_transaction
                        )
                    }

                    state.ids = state.ids.push(function_id)[0]
                }
            } else if (action == Action.CompileSetter) {
                const id = host.compileMixedSetter(binding, position, target)

                host.restoreMixedCalleeOwner(binding)

                if (id == null) {
                    host.rejectMixedCallee(
                        binding,
                        position,
                        false,
                        not_executable_zx
                    )
                } else {
                    state.ids = state.ids.push(id)[0]
                }
            } else if (selected.id != null) {
                state.ids = state.ids.push(selected.id)[0]
            } else {
                const message = match action {
                    Action.MissingMember => missing_member,
                    Action.MissingRX => missing_rx,
                    Action.MissingZX => missing_zx,
                    Action.NotExecutableRX => not_executable_rx,
                    _ => not_executable_zx
                }

                host.rejectMixedCallee(
                    binding,
                    position,
                    action == Action.MissingMember,
                    message
                )
            }

            state.position += 1
        },
        return: state => state.ids
    })
}
