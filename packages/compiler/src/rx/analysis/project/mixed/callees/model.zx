import type { IndirectTextColumn } from "memory/columns"
import type { Members } from "../../../call/named/model"

export enum TargetKind {
    Source,
    AuthorizedSource,
    Compiled,
    NamedSource
}

export type Targets = {
    kinds: TargetKind[],
    references: IndirectTextColumn,
    rows: u64[]
}

export type Published = {
    members: Members,
    present: bool[],
    functions: (u32?)[]
}

export enum Action {
    Bind,
    LoadLibrary,
    CompileSetter,
    MissingRX,
    MissingZX,
    NotExecutableRX,
    NotExecutableZX,
    MissingMember
}

export enum EffectKind {
    Done,
    ImportLibrary,
    CompileSetter,
    Reject
}

export type Request = {
    kind: EffectKind,
    position: u64,
    target?: u64,
    name?: bool,
    message?: string
}

export type Imported = {
    function_id?: u32,
    setter: bool,
    has_stores: bool,
    orchestration: bool
}

export type Reply = {
    library?: Imported,
    setter?: u32
}
