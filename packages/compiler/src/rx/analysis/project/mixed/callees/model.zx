import type { IndirectTextColumn } from "memory/columns"
import type { Members } from "../../../call/named/model"

export enum TargetKind {
    Source,
    AuthorizedSource,
    Compiled,
    NamedSource
}

export type Targets = {
    kinds: TargetKind[],
    references: IndirectTextColumn,
    rows: u64[]
}

export type Published = {
    members: Members,
    present: bool[],
    functions: (u32?)[]
}

export enum Action {
    Bind,
    LoadLibrary,
    CompileSetter,
    MissingRX,
    MissingZX,
    NotExecutableRX,
    NotExecutableZX,
    MissingMember
}
