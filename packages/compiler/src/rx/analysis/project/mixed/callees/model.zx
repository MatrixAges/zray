import type { U32Buffer } from "memory"
import type { IndirectTextColumn } from "memory/columns"
import type { Members } from "../../../call/named/model"

export enum TargetKind {
    Source,
    AuthorizedSource,
    Compiled,
    NamedSource
}

export type Targets = {
    kinds: TargetKind[],
    references: IndirectTextColumn,
    rows: u64[]
}

export type Published = {
    members: Members,
    present: bool[],
    functions: (u32?)[]
}

export enum Action {
    Done,
    Bind,
    LoadLibrary,
    CompileSetter,
    MissingRX,
    MissingZX,
    NotExecutableRX,
    NotExecutableZX,
    MissingMember
}

export type Pending = {
    action: Action,
    target: u64,
    function_id?: u32
}

export type Output = Pending & {
    position: u64
}

export type Input = {
    calls: Targets,
    published: Published,
    zx_count: u64,
    rx_end: u64,
    ids: U32Buffer,
    first: u64
}
