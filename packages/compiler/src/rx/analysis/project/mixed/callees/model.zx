import type { U32Buffer } from "std:memory"

export enum TargetKind {
    Source,
    AuthorizedSource,
    Compiled
}

export type Targets = {
    kinds: TargetKind[],
    rows: u64[]
}

export type Published = {
    present: bool[],
    functions: (u32?)[]
}

export enum Action {
    Done,
    Bind,
    LoadLibrary,
    CompileSetter,
    MissingRX,
    MissingZX,
    NotExecutableRX,
    NotExecutableZX
}

export type Pending = {
    action: Action,
    target: u64,
    function_id?: u32
}

export type Output = Pending & {
    position: u64
}

export type Input = {
    calls: Targets,
    published: Published,
    zx_count: u64,
    rx_end: u64,
    ids: U32Buffer,
    first: u64
}
