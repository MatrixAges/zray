import memory from "memory"
import columns from "memory/columns"

import member from "../../../call/named/member"
import resultName from "../../../result_name/select"
import { Action, TargetKind } from "./model"

import type { U32Buffer } from "memory"
import type { Published, Targets } from "./model"

export type Input = {
    calls: Targets,
    position: u64,
    target: u64,
    zx_count: u64,
    rx_end: u64,
    published: Published,
    ids: U32Buffer
}

export type Output = Action

export default function (in: Input): Output {
    const { target, position, zx_count, rx_end, published, ids } = in

    const kind = in.calls.kinds[position]

    if (kind == TargetKind.Compiled) {
        return Action.LoadLibrary
    }

    if (kind == TargetKind.NamedSource) {
        if (!published.present[target]) {
            return Action.MissingMember
        }

        const reference = columns.readIndirectTextColumn(in.calls.references, position)

        const name = resultName({
            reference,
            function_target: true
        })

        const function_id = member({
            members: published.members,
            module: target,
            name
        })

        if (function_id == null) {
            return Action.MissingMember
        }

        memory.writeU32(ids, position, function_id)

        return Action.Bind
    }

    const is_rx = target >= zx_count && target < rx_end

    if (kind == TargetKind.AuthorizedSource && !is_rx) {
        return Action.CompileSetter
    }

    if (!published.present[target]) {
        return is_rx ? Action.MissingRX : Action.MissingZX
    }

    const function_id = published.functions[target]

    if (function_id == null) {
        return is_rx ? Action.NotExecutableRX : Action.NotExecutableZX
    }

    memory.writeU32(ids, position, function_id)

    return Action.Bind
}
