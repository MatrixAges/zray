import columns from "memory/columns"

import member from "../../../call/named/member"
import resultName from "../../../result_name/select"
import { Action, TargetKind } from "./model"

import type { Published, Targets } from "./model"

export type Input = {
    calls: Targets,
    position: u64,
    target: u64,
    zx_count: u64,
    rx_end: u64,
    published: Published
}

export type Output = {
    action: Action,
    id?: u32
}

export default function (in: Input): Output {
    const { target, position, zx_count, rx_end, published } = in

    const kind = in.calls.kinds[position]

    if (kind == TargetKind.Compiled) {
        return {
            action: Action.LoadLibrary
        }
    }

    if (kind == TargetKind.NamedSource) {
        if (!published.present[target]) {
            return {
                action: Action.MissingMember
            }
        }

        const reference = columns.readIndirectTextColumn(in.calls.references, position)

        const name = resultName({
            reference,
            function_target: true
        })

        const function_id = member({
            members: published.members,
            module: target,
            name
        })

        if (function_id == null) {
            return {
                action: Action.MissingMember
            }
        }

        return {
            action: Action.Bind,
            id: function_id
        }
    }

    const is_rx = target >= zx_count && target < rx_end

    if (kind == TargetKind.AuthorizedSource && !is_rx) {
        return {
            action: Action.CompileSetter
        }
    }

    if (!published.present[target]) {
        return {
            action: is_rx ? Action.MissingRX : Action.MissingZX
        }
    }

    const function_id = published.functions[target]

    if (function_id == null) {
        return {
            action: is_rx ? Action.NotExecutableRX : Action.NotExecutableZX
        }
    }

    return {
        action: Action.Bind,
        id: function_id
    }
}
