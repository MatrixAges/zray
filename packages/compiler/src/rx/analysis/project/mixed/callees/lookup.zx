import columns from "memory/columns"

import member from "../../../call/named/member"
import resultName from "../../../result_name/select"
import { Action, TargetKind } from "./model"

import type { Pending, Published, Targets } from "./model"

export type Input = {
    calls: Targets,
    position: u64,
    target: u64,
    zx_count: u64,
    rx_end: u64,
    published: Published
}

export type Output = Pending

export default function (in: Input): Output {
    const { target, zx_count, rx_end, published } = in

    const kind = in.calls.kinds[in.position]

    if (kind == TargetKind.Compiled) {
        return {
            action: Action.LoadLibrary,
            target,
            function_id: null
        }
    }

    if (kind == TargetKind.NamedSource) {
        if (!published.present[target]) {
            return {
                action: Action.MissingMember,
                target,
                function_id: null
            }
        }

        const reference =
            columns.readIndirectTextColumn(in.calls.references, in.position)

        const name = resultName({
            reference,
            function_target: true
        })

        const function_id = member({
            members: published.members,
            module: target,
            name
        })

        return {
            action: function_id == null ? Action.MissingMember : Action.Bind,
            target,
            function_id
        }
    }

    const is_rx = target >= zx_count && target < rx_end

    if (kind == TargetKind.AuthorizedSource && !is_rx) {
        return {
            action: Action.CompileSetter,
            target,
            function_id: null
        }
    }

    if (!published.present[target]) {
        const action = is_rx ? Action.MissingRX : Action.MissingZX

        return {
            action,
            target,
            function_id: null
        }
    }

    const function_id = published.functions[target]

    if (function_id == null) {
        const action = is_rx ? Action.NotExecutableRX : Action.NotExecutableZX

        return {
            action,
            target,
            function_id: null
        }
    }

    return {
        action: Action.Bind,
        target,
        function_id
    }
}
