import type { Mixed, MixedAction } from "rx_project_host"

export type Input = {
    state: Mixed,
    length: u64,
    has_exports: bool,
    retain: bool
}

export type Cursor = Input.Omit("has_exports") & {
    position: u64,
    limit: u64,
    end: u64,
    batch: u64
}

export type Body = {
    state: Mixed,
    limit: u64,
    action: MixedAction
}
