import type { ReadColumn } from "memory"
import type { Selection } from "./operation"

export type Input = {
    batch_ends: ReadColumn,
    length: u64,
    has_exports: bool,
    retain: bool
}

export type Cursor = Input.Omit("has_exports") & {
    position: u64,
    limit: u64,
    end: u64,
    batch: u64
}

export type Dispatch = {
    selection: Selection,
    limit: u64
}
