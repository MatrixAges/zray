import type { Request as Symbols } from "../../../../../zx/modules/binding/model"

export type Input = {
    count: u64,
    symbols: Symbols[],
    row: u64
}

export type Rows = {
    named: u8[],
    fallback: u8[],
    stride: u64,
    prefix: u64,
    exported: bool
}

export type Plan = {
    exported: bool,
    prefix: u64,
    fits: bool,
    names: string[],
    sources: u8[][]
}

export type Effect = {
    row: u64,
    publication?: Plan,
    message?: string,
    rows?: Rows
}
