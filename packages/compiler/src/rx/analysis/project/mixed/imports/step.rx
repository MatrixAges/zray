<Module>
    <Type from="model" as="Imports" />

    <Args in={Imports.Input} out={Imports.Input} />

    <Call
        fn="host.openMixedImport"
        in={[
            $in.binding,
            $in.row,
            $in.pending
        ]}
    />

    <If on={$ctx.openMixedImport != null}>
        <Call module="../../../../../zx/modules/binding/bind" in={$in.symbols[0]} />

        <If on={$ctx.bind.message != ""}>
            <Call
                fn="host.rejectMixedImport"
                in={[
                    $in.binding,
                    $in.row,
                    $ctx.bind.message
                ]}
            />
        </If>

        <If on={$ctx.bind.function_names.length != 0}>
            <Call
                fn="publish"
                in={{
                    names: $ctx.bind.function_names,
                    indices: $ctx.bind.function_indices,
                    rows: $ctx.openMixedImport
                }}
            />

            <Return
                value={{
                    ...$in,
                    row: $in.row + 1,
                    pending: $ctx.publish
                }}
            />
        </If>
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            pending: null
        }}
    />
</Module>
