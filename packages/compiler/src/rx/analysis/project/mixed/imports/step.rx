<Module>
    <Type from="model" as="Imports" />

    <Args in={Imports.Input} out={Imports.Input} />

    <Store from="binding" as="binding" />

    <Call
        fn="stage"
        in={{
            row: $in.row
        }}
        setter={[$store.binding.effect]}
    />

    <Call fn="read" in={$store.binding.effect} />

    <If on={$ctx.read != null}>
        <Call module="../../../../../zx/modules/binding/bind" in={$in.symbols[0]} />

        <If on={$ctx.bind.message != ""}>
            <Call
                fn="stage"
                in={{
                    row: $in.row,
                    message: $ctx.bind.message
                }}
                setter={[$store.binding.effect]}
            />
        </If>

        <If on={$ctx.bind.function_names.length != 0}>
            <Call
                fn="publish"
                in={{
                    names: $ctx.bind.function_names,
                    indices: $ctx.bind.function_indices,
                    rows: $ctx.read
                }}
            />

            <Call
                fn="stage"
                in={{
                    row: $in.row,
                    publication: $ctx.publish
                }}
                setter={[$store.binding.effect]}
            />
        </If>
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
