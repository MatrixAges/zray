import memory from "std:memory"

import { ImportKind } from "../../../../../zx/frontend/parser/imports/model"

import type { U64Buffer } from "std:memory"
import type { Import } from "../../../../../zx/frontend/parser/imports/model"

export type Input = {
    imports: Import[],
    first: u64,
    rows: U64Buffer,
    capacity: u64
}

export type Output = {
    next: u64,
    count: u64
}

export default function (in: Input): Output {
    const { imports, rows, capacity } = in

    return loop({
        next: in.first,
        count: 0
    }, {
        while: state => state.next < imports.length && state.count < capacity,
        next: state => {
            const index = state.next

            if (imports[index].kind != ImportKind.TypeOnly) {
                memory.writeU64(rows, state.count, index)

                state.count += 1
            }

            state.next += 1
        },
        return: state => ({
            next: state.next,
            count: state.count
        })
    })
}
