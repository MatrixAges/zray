import host from "rx_project_host"

import { ImportKind } from "../../../../../zx/frontend/parser/imports/model"
import publish from "./publish"

import type { Request as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const gathered = loop(0, {
        while: row => row < in.imports.length,
        next: row => {
            const item = in.imports[row]

            if (item.kind != ImportKind.TypeOnly) {
                const selected = host.selectMixedImport(in.binding, row)

                if (selected != null) {
                    const target = item.exported ? in.published : in.functions

                    publish({
                        selected,
                        target,
                        layout: in.layout
                    })
                }
            }

            row += 1
        }
    })
}
