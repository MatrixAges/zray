import memory from "memory"
import columns from "memory/columns"

import type { MixedImportRows } from "rx_project_host"

export type Input = {
    names: string[],
    indices: u64[],
    rows: MixedImportRows
}

export type Output = {
    exported: bool,
    prefix: u64,
    fits: bool,
    names: string[],
    sources: u8[][]
}

export default function (in: Input): Output {
    const { names, indices, rows } = in
    const { named, fallback, stride, prefix, exported } = rows

    const limit = columns.rowCapacityLimit()
    const fits = names.length <= limit && prefix <= limit - names.length
    const sources: u8[][] = []

    if (!fits) {
        return {
            exported,
            prefix,
            fits,
            names,
            sources
        }
    }

    const first_named = fallback.length == 0 ? 0 : 1

    const selected = loop(sources, {
        while: selected => selected.length < names.length,
        next: selected => {
            const row = selected.length
            const index = indices[row]
            const use_named = index >= first_named
            const source = use_named ? named : fallback
            const start = match use_named {
                true => (index - first_named) * stride,
                _ => 0
            }

            selected = selected.push(memory.borrowU8Range(source, start, stride))[0]
        }
    })

    return {
        exported,
        prefix,
        fits,
        names,
        sources: selected
    }
}
