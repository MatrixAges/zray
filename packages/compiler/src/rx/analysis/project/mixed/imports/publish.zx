import bytes from "std:bytes"
import strings from "std:string"
import { reserveAppend } from "core/row_buffer"
import memory from "memory"
import columns from "memory/columns"

import type { MixedImportRows } from "rx_project_host"
import type { Request } from "./model"

export type Input = Request.Pick("functions", "published", "layout") & {
    names: string[],
    indices: u64[],
    rows: MixedImportRows,
    exported: bool
}

export type Output = void

export default function (in: Input): Output {
    const { names, indices, rows, layout } = in

    const target = in.exported ? in.published : in.functions

    const { named, fallback } = rows
    const { stride, name_offset } = layout

    const used = memory.readU64(target.used, 0)
    const prefix = used == 0 ? target.prefix.length / stride : 0

    memory.requireAllocation(prefix <= columns.rowCapacityLimit() - names.length)

    const capacity = reserveAppend([
        target.storage,
        used,
        prefix + names.length,
        null
    ])

    if (prefix != 0) {
        columns.copyRowPrefix(target.storage, target.prefix, prefix)
    }

    const first = used + prefix
    const first_named = fallback.length == 0 ? 0 : 1

    const written = loop(0, {
        while: row => row < names.length,
        next: row => {
            const index = indices[row]
            const use_named = index >= first_named
            const source = use_named ? named : fallback
            const start = match use_named {
                true => (index - first_named) * stride,
                _ => 0
            }

            const destination = first + row
            const owned = strings.copy(names[row])
            const copied = memory.copyBytes(
                target.bytes,
                destination * stride,
                source,
                start,
                start + stride
            )

            columns.writeRowByteField(
                target.storage,
                destination,
                name_offset,
                bytes.fromText(owned)
            )
            row += 1
        }
    })

    memory.writeU64(target.used, 0, first + names.length)
}
