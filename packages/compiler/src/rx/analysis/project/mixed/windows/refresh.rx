<Module>
    <Type from="../windows" as="Windows" />
    <Type from="../operation" as="Operation" />

    <Args in={Windows.Cursor} out={Windows.Cursor} />

    <Store from="../operation" as="mixed" />

    <If on={$in.position != $in.limit}>
        <Return value={$in} />
    </If>

    <If on={$in.position == $in.end}>
        <Call
            fn="batch_end"
            in={$in.pick([
                "batch_ends",
                "batch"
            ])}
        />

        <Call
            fn="../stage"
            in={{
                step: Operation.Step.Prefetch,
                first: $in.position,
                end: $ctx.batch_end
            }}
            setter={[$store.mixed.effect]}
        />

        <Call fn="../read_count" in={$store.mixed.effect} />

        <Return
            value={{
                ...$in,
                end: $ctx.batch_end,
                batch: $in.batch + 1,
                limit: $in.position + $ctx.read_count
            }}
        />
    </If>

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.Prefetch,
            first: $in.position,
            end: $in.end
        }}
        setter={[$store.mixed.effect]}
    />

    <Call fn="../read_count" in={$store.mixed.effect} />

    <Return
        value={{
            ...$in,
            limit: $in.position + $ctx.read_count
        }}
    />
</Module>
