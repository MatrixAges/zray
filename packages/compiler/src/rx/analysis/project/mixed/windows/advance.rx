<Module>
    <Type from="../windows" as="Windows" />
    <Type from="../operation" as="Operation" />

    <Args in={Windows.Cursor} out={Windows.Cursor} />

    <Store from="../operation" as="mixed" />

    <Call module="refresh" in={$in} />

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.RestorePrefix,
            first: $in.position,
            end: $ctx.refresh.limit
        }}
        setter={[$store.mixed.effect]}
    />

    <Call fn="../read_count" in={$store.mixed.effect} />

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.Select,
            first: $ctx.read_count,
            end: $ctx.refresh.limit
        }}
        setter={[$store.mixed.effect]}
    />

    <Call fn="../read_selection" in={$store.mixed.effect} />

    <Call
        module="dispatch"
        in={{
            selection: $ctx.read_selection,
            limit: $ctx.refresh.limit
        }}
    />

    <If on={$in.retain && $ctx.read_selection.action != Operation.Action.Exhausted}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.Record,
                selection: $ctx.read_selection
            }}
            setter={[$store.mixed.effect]}
        />
    </If>

    <Return
        value={{
            ...$ctx.refresh,
            position: $ctx.dispatch
        }}
    />
</Module>
