<Module>
    <Type from="../windows" as="Windows" />
    <Type from="../operation" as="Operation" />

    <Args in={Windows.Dispatch} out={u64} />

    <Store from="../operation" as="mixed" />

    <If on={$in.selection.action == Operation.Action.Exhausted}>
        <Return value={$in.limit} />
    </If>

    <Switch on={$in.selection.action}>
        <Case value={Operation.Action.MissingSignature}>
            <Call
                fn="../stage"
                in={{
                    step: Operation.Step.Reject,
                    selection: $in.selection
                }}
                setter={[$store.mixed.effect]}
            />
        </Case>

        <Case value={Operation.Action.AnalyzeZX}>
            <Call module="../body/execute_zx" in={$in.selection} />
        </Case>

        <Case value={Operation.Action.LowerRX}>
            <Call module="../body/execute_rx" in={$in.selection} />
        </Case>
    </Switch>

    <Return value={$in.selection.following} />
</Module>
