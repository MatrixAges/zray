import type { Input as PriorBatch } from "../ahead/reset"
import type { Input as Preview, Output as Selected } from "./preview"

export type Request = {
    selection: Preview.Omit("capacity"),
    prior: PriorBatch,
    minimum: u64,
    capacity: u64
}

export type Collect = Request.Pick("selection", "capacity") & {
    initial: Selected,
    limit: u64
}

export type Cursor = Collect.Omit("initial") & {
    cursor: u64,
    scan: u64,
    positions: u64[],
    accepted: u64,
    last: u64
}

export type Accepted = {
    count: u64,
    last: u64
}
