import memory from "memory"
import host from "rx_project_host"

import preview from "./preview"

import type { Accepted, Request, Started } from "./preparation"

export type Input = Request.Pick("selection", "workspace", "capacity") & {
    initial: Started
}

export type Output = Accepted

export default function (in: Input): Output {
    const { selection, workspace, capacity, initial } = in
    const { order, signatures } = selection
    const { limit } = initial

    return loop({
        cursor: 0,
        scan: initial.next,
        positions: initial.positions,
        accepted: 0,
        last: 0
    }, {
        while: stage => stage.accepted < limit && stage.positions.length != 0,
        next: stage => {
            const position = stage.positions[stage.cursor]
            const index = memory.readColumnIndex(order, position)
            const is_zx = index < signatures.length

            host.openMixedCandidate(workspace, index)

            const ready = match is_zx {
                true => host.prepareMixedZXCandidate(workspace, index),
                _ => host.prepareMixedRXCandidate(workspace, index)
            }

            if (ready) {
                host.recordMixedCandidate(workspace, position)
                stage.accepted += 1
                stage.last = position
            } else {
                host.restoreMixedCandidateDiagnostic(workspace)
            }

            stage.cursor += 1

            if (stage.cursor == stage.positions.length && stage.accepted < limit) {
                const more = preview({
                    ...selection,
                    start: stage.scan,
                    capacity
                })

                stage.cursor = 0
                stage.positions = more.positions
                stage.scan = more.next
            }
        },
        return: stage => {
            return {
                count: stage.accepted,
                last: stage.last
            }
        }
    })
}
