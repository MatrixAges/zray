export type Input = {
    batch_ends: u64[],
    batch: u64,
    first: u64,
    end: u64
}

export type Output = {
    batch: u64,
    end: u64
}

export default function (in: Input): Output {
    if (in.first == in.end) {
        return {
            batch: in.batch + 1,
            end: in.batch_ends[in.batch]
        }
    }

    return {
        batch: in.batch,
        end: in.end
    }
}
