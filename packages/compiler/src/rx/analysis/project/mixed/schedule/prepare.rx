<Module>
    <Type from="preparation" as="Preparation" />
    <Type from="../ahead/reset" as="Reset" />

    <Args in={Preparation.Request} out={u64} />

    <Store from="../ahead/workspace" as="workspace" />

    <Call module="../ahead/recycle" in={$in.prior} />

    <Call
        fn="start"
        in={$in.pick([
            "selection",
            "workspace",
            "minimum"
        ])}
    />

    <If on={$ctx.start != null}>
        <Call
            fn="collect"
            in={{
                ...$in.pick([
                    "selection",
                    "workspace",
                    "capacity"
                ]),
                initial: $ctx.start
            }}
        />

        <Call
            fn="prepared"
            in={{
                accepted: $ctx.collect,
                first: $in.selection.start,
                end: $in.selection.end,
                workers: $ctx.start.workers,
                limit: $ctx.start.limit,
                minimum: $in.minimum
            }}
        />

        <If on={$ctx.prepared.participants != 0}>
            <Call
                fn="host.executeMixedWorkers"
                in={[
                    $in.workspace,
                    $ctx.prepared.participants
                ]}
            />

            <Else>
                <If on={$ctx.collect.count != 0}>
                    <Call
                        fn="../ahead/stage_recycle"
                        in={{
                            action: Reset.Action.ClearResults,
                            worker: 0
                        }}
                        setter={[$store.workspace.recycle]}
                    />
                </If>
            </Else>
        </If>

        <Return value={$ctx.prepared.consumed} />

        <Else>
            <Return value={$in.selection.end - $in.selection.start} />
        </Else>
    </If>
</Module>
