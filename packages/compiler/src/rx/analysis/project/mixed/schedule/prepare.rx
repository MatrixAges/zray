<Module>
    <Type from="preparation" as="Preparation" />
    <Type from="../ahead/operation" as="Operation" />

    <Args in={Preparation.Request} out={u64} />

    <Store from="../ahead/workspace" as="workspace" />

    <Call module="../ahead/recycle" in={$in.prior} />

    <Call
        fn="start"
        in={$in.pick([
            "selection",
            "minimum"
        ])}
    />

    <If on={$ctx.start != null}>
        <Call
            fn="../ahead/stage"
            in={{
                action: Operation.Action.Reserve,
                row: 0
            }}
            setter={[$store.workspace.effect]}
        />

        <Call fn="../ahead/read_count" in={$store.workspace.effect} />

        <Call
            module="collect"
            in={{
                ...$in.pick([
                    "selection",
                    "capacity"
                ]),
                initial: $ctx.start,
                limit: $ctx.read_count >= $in.minimum ? $ctx.read_count : $in.minimum
            }}
        />

        <Call
            fn="prepared"
            in={{
                accepted: $ctx.collect,
                first: $in.selection.start,
                end: $in.selection.end,
                workers: $ctx.read_count,
                limit: $ctx.read_count >= $in.minimum ? $ctx.read_count : $in.minimum,
                minimum: $in.minimum
            }}
        />

        <If on={$ctx.prepared.participants != 0}>
            <Call
                fn="../ahead/stage"
                in={{
                    action: Operation.Action.Execute,
                    row: $ctx.prepared.participants
                }}
                setter={[$store.workspace.effect]}
            />

            <Else>
                <If on={$ctx.collect.count != 0}>
                    <Call
                        fn="../ahead/stage"
                        in={{
                            action: Operation.Action.ClearResults,
                            row: 0
                        }}
                        setter={[$store.workspace.effect]}
                    />
                </If>
            </Else>
        </If>

        <Return value={$ctx.prepared.consumed} />

        <Else>
            <Return value={$in.selection.end - $in.selection.start} />
        </Else>
    </If>
</Module>
