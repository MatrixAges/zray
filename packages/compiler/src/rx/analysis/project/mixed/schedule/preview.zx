import integers from "std:integer"
import memory from "memory"

import probe from "../history/prefix/probe"
import { Decision } from "../history/prefix/probe"

import type { U64Buffer } from "memory"
import type { History } from "../history/prefix/model"

export type Input = {
    order: u64[],
    start: u64,
    end: u64,
    entry: u64,
    signatures: i64[],
    local_calls: bool[],
    compiled_dependencies: bool[],
    history?: History,
    positions: U64Buffer,
    capacity: u64
}

export type Output = {
    next: u64,
    count: u64,
    signature_checks: u64
}

export default function (in: Input): Output {
    const { order, end, entry, signatures, local_calls } = in
    const { compiled_dependencies, positions, capacity } = in

    const zx_count = signatures.length
    const rx_end = zx_count + local_calls.length

    const sources = {
        zx_count,
        rx_end
    }

    return loop({
        next: in.start,
        count: 0,
        signature_checks: 0
    }, {
        while: state => state.next < end && state.count < capacity,
        next: state => {
            const index = order[state.next]

            if (!compiled_dependencies[index]) {
                const eligible = match {
                    index < zx_count => signatures[index] > 0,
                    index < rx_end => index != entry && local_calls[index - zx_count],
                    _ => false
                }

                if (eligible) {
                    const decision = probe({
                        history: in.history,
                        sources,
                        index,
                        position: state.next,
                        entry
                    })

                    if (decision != Decision.Reuse) {
                        memory.writeU64(positions, state.count, state.next)

                        if (decision == Decision.CompareSignature) {
                            const bit = integers.bitMask(state.count)
                            state.signature_checks =
                                integers.orBits(state.signature_checks, bit)
                        }

                        state.count += 1
                    }
                }
            }

            state.next += 1
        },
        return: state => ({
            next: state.next,
            count: state.count,
            signature_checks: state.signature_checks
        })
    })
}
