import preview from "./preview"

import type { Request } from "./preparation"
import type { Output as Selected } from "./preview"

export type Input = Request.Pick("selection", "minimum")

export type Output = Selected?

export default function (in: Input): Output {
    const { selection, minimum } = in

    if (selection.end - selection.start < minimum) {
        return null
    }

    const initial = preview({
        ...selection,
        capacity: minimum
    })

    return initial.positions.length < minimum ? null : initial
}
