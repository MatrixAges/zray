<Module>
    <Type from="windows" as="Windows" />

    <Args in={Windows.Input} out={void} />

    <Loop on={$in.position < $in.length}>
        <Call
            module="windows/advance"
            in={{
                batch_ends: $in.batch_ends,
                length: $in.length,
                retain: $in.retain,
                position: 0,
                limit: 0,
                end: 0,
                batch: 0
            }}
        />
    </Loop>

    <Call module="publication/run" in={$in} />
</Module>
