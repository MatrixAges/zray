import origin from "./origin"

import type { Origins } from "./model"

export type Input = {
    origins: Origins,
    first: u64,
    end: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    return loop({
        row: in.first,
        offsets: empty
    }, {
        while: state => state.row < in.end,
        next: state => {
            const offset = origin({
                origins: in.origins,
                row: state.row
            })

            state.offsets = state.offsets.push(offset)[0]
            state.row += 1
        },
        return: state => state.offsets
    })
}
