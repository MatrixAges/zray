<Module>
    <Type from="model" as="Ports" />

    <Args in={Ports.State} out={Ports.State} />

    <Call fn="next" in={$in} />

    <If on={$ctx.next.nodes != 0}>
        <Call
            fn="inferred"
            in={{
                origins: $in.request.origins,
                first: $in.position,
                end: $ctx.next.inferred_until
            }}
        />

        <Call
            fn="host.commitInferredPorts"
            in={[
                $in.request.graph,
                $in.position,
                $ctx.next.inferred_until,
                $ctx.inferred
            ]}
        />
    </If>

    <If on={$ctx.next.declared}>
        <Call
            fn="origin"
            in={{
                origins: $in.request.origins,
                row: $ctx.next.inferred_until
            }}
        />

        <Call
            fn="host.commitDeclaredPort"
            in={[
                $in.request.graph,
                $ctx.next.inferred_until,
                $ctx.next.input,
                $ctx.next.output,
                $ctx.origin
            ]}
        />
    </If>

    <Return
        value={{
            request: $in.request,
            position: $ctx.next.next_module,
            start: $ctx.next.next
        }}
    />
</Module>
