import memory from "memory"

import type { Ports } from "./model"

export type Input = {
    ports: Ports,
    row: u64,
    input: u32,
    output: u32,
    fixed: bool
}

export type Output = void

export default function (in: Input): Output {
    const { ports, row } = in

    memory.writeU32(ports.inputs, row, in.input)
    memory.writeU32(ports.outputs, row, in.output)
    memory.writeBool(ports.fixed, row, in.fixed)
    memory.writeU64(ports.binding_ends, row, 0)
    memory.writeU64(ports.task_ends, row, 0)
}
