import pickPorts from "../../contracts/ports"
import origin from "./origin"

import type { Range, State } from "./model"

export type Input = State

export type Output = Range

export default function (in: Input): Output {
    const { owners, types, modules } = in.request
    const { start } = in

    if (start == owners.length) {
        return {
            inferred_until: modules,
            declared: null,
            next_module: modules,
            next: start
        }
    }

    const selected = pickPorts({
        owners,
        types,
        start
    })

    return {
        inferred_until: selected.owner,
        declared: {
            row: selected.owner,
            offset: origin({
                origins: in.request.origins,
                row: selected.owner
            }),
            input: selected.input,
            output: selected.output
        },
        next_module: selected.owner + 1,
        next: selected.next
    }
}
