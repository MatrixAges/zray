import type { ReadColumn } from "memory"
import type { DeclaredPort } from "rx_project_host"
import type { Input as Declarations } from "../../contracts/ports"

export type Origins = {
    ends: u64[],
    locations: ReadColumn
}

export type Request = Declarations.Omit("start") & {
    modules: u64,
    origins: Origins
}

export type State = {
    request: Request,
    start: u64
}

export type Range = {
    inferred_until: u64,
    declared?: DeclaredPort,
    next_module: u64,
    next: u64
}
