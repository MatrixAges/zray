import type { U8Buffer, U32Buffer } from "zig:compiler_memory"
import type { Input as Nodes } from "../../../inference/nodes/initialize"
import type { Input as Declarations } from "../../contracts/ports"

export type Ports = {
    inputs: U32Buffer,
    outputs: U32Buffer,
    fixed: U8Buffer,
    first_node: u64,
    count: u64
}

export type Input = {
    nodes: Nodes,
    ports: Ports
}

export type Output = void

export type Cursor = Declarations & {
    modules: u64
}

export type Range = {
    inferred_until: u64,
    declared: bool,
    input: u32,
    output: u32,
    next: u64
}
