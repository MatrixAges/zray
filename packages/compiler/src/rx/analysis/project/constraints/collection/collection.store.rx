<Store name="rx_constraint_collection" version={1}>
    <Type from="effect" as="Collection" />

    <Object name="effect">
        <Field
            name="collection_step"
            type={Collection.Step}
            value={Collection.Step.Open}
        />

        <Field name="row" type={u64?} value={null} />
        <Field name="fixed" type={bool?} value={null} />
        <Field name="binding_end" type={u64?} value={null} />
        <Field name="task_end" type={u64?} value={null} />
        <Field name="input" type={u32?} value={null} />
        <Field name="shortcut" type={bool} value={false} />
        <Field name="input_fixed" type={bool} value={false} />
        <Field name="returned" type={bool} value={false} />
        <Field name="used" type={bool} value={false} />
        <Field name="bindings" type={u64} value={0} />
        <Field name="tasks" type={u64} value={0} />
        <Field name="parents" type={u32[]} value={[]} />
    </Object>
</Store>
