<Module>
    <Type from="model" as="Collection" />
    <Type from="effect" as="CollectionEffect" />

    <Args in={Collection.Request} out={void} />

    <Store from="collection" as="collection" />

    <Loop on={$in.row < $in.request.modules}>
        <Call
            module="row"
            in={{
                request: $in,
                row: 0,
                unused: 0
            }}
        />
    </Loop>

    <Call
        fn="stage"
        in={{
            collection_step: CollectionEffect.Step.Release
        }}
        setter={[$store.collection.effect]}
    />

    <If on={$ctx.row.unused != 0}>
        <Call
            module="../../input_defaults/apply"
            in={{
                ...$in,
                unused: $ctx.row.unused
            }}
        />
    </If>
</Module>
