<Module>
    <Type from="effect" as="CollectionEffect" />

    <Args in={bool} out={CollectionEffect.Body} />

    <Store from="collection" as="collection" />

    <If on={$in}>
        <Call
            fn="stage"
            in={{
                collection_step: CollectionEffect.Step.Forward
            }}
            setter={[$store.collection.effect]}
        />

        <Call fn="read_body" in={$store.collection.effect} />

        <Return value={$ctx.read_body} />
    </If>

    <Call
        fn="stage"
        in={{
            collection_step: CollectionEffect.Step.Infer
        }}
        setter={[$store.collection.effect]}
    />

    <Call fn="read_body" in={$store.collection.effect} />

    <If on={!$ctx.read_body.returned}>
        <Call
            fn="stage"
            in={{
                collection_step: CollectionEffect.Step.DefaultOutput
            }}
            setter={[$store.collection.effect]}
        />
    </If>

    <Return value={$ctx.read_body} />
</Module>
