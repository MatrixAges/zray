import type { BoolBuffer, U32Buffer, U64Buffer } from "memory"
import type { ConstraintCollection } from "rx_project_host"
import type { Edges } from "../../../inference/assignment/model"
import type { Ports } from "../ports/model"

export type Publication = Ports.Pick("fixed", "binding_ends", "task_ends")

export type DefaultColumns = {
    inputs: u32[],
    fixed: bool[],
    edges: Edges
}

export type Request = {
    frame: ConstraintCollection,
    modules: u64,
    parents: U32Buffer,
    unused: U64Buffer,
    marked: BoolBuffer,
    ports: Publication,
    default_columns: DefaultColumns
}

export type Cursor = {
    request: Request,
    row: u64
}
