<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Cursor} out={Collection.Cursor} />

    <Call
        fn="host.openConstraintModule"
        in={[
            $in.request.frame,
            $in.row
        ]}
    />

    <Call
        module="infer"
        in={{
            frame: $in.request.frame,
            shortcut: $ctx.openConstraintModule.shortcut
        }}
    />

    <Call
        fn="publish"
        in={{
            already_fixed: $ctx.openConstraintModule.fixed,
            used: $ctx.infer.used
        }}
    />

    <Call
        fn="host.commitConstraintPort"
        in={[
            $in.request.frame,
            $in.row,
            $ctx.publish.fixed,
            $ctx.infer.binding_end,
            $ctx.infer.task_end
        ]}
    />

    <Return
        value={{
            request: $in.request,
            row: $in.row + 1,
            unused: $in.unused + $ctx.publish.unused
        }}
    />
</Module>
