<Module>
    <Type from="model" as="Collection" />
    <Type from="effect" as="CollectionEffect" />

    <Args in={Collection.Cursor} out={Collection.Cursor} />

    <Store from="collection" as="collection" />

    <Call
        fn="stage"
        in={{
            collection_step: CollectionEffect.Step.Open,
            row: $in.row
        }}
        setter={[$store.collection.effect]}
    />

    <Call fn="read_opened" in={$store.collection.effect} />

    <Call module="infer" in={$ctx.read_opened.shortcut} />

    <Call
        fn="publish"
        in={{
            already_fixed: $ctx.read_opened.fixed,
            used: $ctx.infer.used
        }}
    />

    <Call
        fn="stage"
        in={{
            collection_step: CollectionEffect.Step.PublishPort,
            row: $in.row,
            fixed: $ctx.publish.fixed,
            binding_end: $ctx.infer.binding_end,
            task_end: $ctx.infer.task_end
        }}
        setter={[$store.collection.effect]}
    />

    <Return
        value={{
            request: $in.request,
            row: $in.row + 1,
            unused: $in.unused + $ctx.publish.unused
        }}
    />
</Module>
