import frames from "rx_prepared_flow"

import { Action } from "../traversal/model"

import type { Effect } from "./model"

export type Input = Effect

export type Output = void

export default function (in: Input): Output {
    const { action, context, compiling } = in

    switch (action) {
        case Action.CloseTask:
            frames.closeTask(context, compiling, false)
        case Action.CloseParallelTask:
            frames.closeTask(context, compiling, true)
        case Action.CloseParallel:
            frames.closeParallel(context, compiling)
        case Action.CloseSelection:
            frames.closeSelection(context, compiling)
        default:
            frames.closeCase(context, compiling)
    }

    frames.pop(context, compiling)
}
