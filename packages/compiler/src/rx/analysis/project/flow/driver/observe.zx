import memory from "memory"
import frames from "rx_prepared_flow"

import { Region } from "../traversal/model"
import {
    case_region,
    end_slot,
    first_slot,
    parallel_region,
    parallel_task_region,
    selection_region,
    task_region
} from "./const"

import type { Input as Frame } from "../traversal/model"
import type { Driver } from "./model"

export type Input = Driver

export type Output = Frame

export default function (in: Input): Output {
    const { kinds, items, cursor } = in

    const region = match frames.observe(in.context, in.compiling, in.target) {
        task_region => Region.Task,
        parallel_task_region => Region.ParallelTask,
        parallel_region => Region.Parallel,
        selection_region => Region.Selection,
        case_region => Region.Case,
        _ => Region.Root
    }

    return {
        kinds,
        items,
        region,
        first: memory.readU64(cursor, first_slot),
        end: memory.readU64(cursor, end_slot)
    }
}
