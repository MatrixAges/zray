export type Context = opaque

export type Snapshot = opaque

export declare function observe(context: Context, compiling: bool, target: Snapshot): u8

export declare function calls(context: Context, compiling: bool, next: u64): void throws {
    InvalidFlow,
    InvalidSource,
    OutOfMemory
}

export declare function result(context: Context, compiling: bool, next: u64): void throws {
    InvalidFlow,
    InvalidSource,
    OutOfMemory
}

export declare function task(
    context: Context,
    compiling: bool,
    next: u64,
    parallel: bool
): void throws { InvalidFlow, InvalidSource, OutOfMemory }

export declare function parallel(
    context: Context,
    compiling: bool,
    next: u64
): void throws { InvalidFlow, InvalidSource, OutOfMemory }

export declare function selection(
    context: Context,
    compiling: bool,
    next: u64
): void throws { InvalidFlow, InvalidSource, OutOfMemory }

export declare function openCase(
    context: Context,
    compiling: bool,
    next: u64
): void throws { InvalidFlow, InvalidSource, OutOfMemory }

export declare function closeTask(
    context: Context,
    compiling: bool,
    parallel: bool
): void throws { InvalidFlow, InvalidSource, OutOfMemory }

export declare function closeParallel(context: Context, compiling: bool): void throws {
    InvalidFlow,
    InvalidSource,
    OutOfMemory
}

export declare function closeSelection(context: Context, compiling: bool): void throws {
    InvalidFlow,
    InvalidSource,
    OutOfMemory
}

export declare function closeCase(context: Context, compiling: bool): void throws {
    InvalidFlow,
    InvalidSource,
    OutOfMemory
}

export declare function pop(context: Context, compiling: bool): void
