import type { U64Buffer } from "memory"
import type { Context, Snapshot } from "rx_prepared_flow"
import type { Input as Frame, Output as Event } from "../traversal/model"

export type Driver = Frame.Pick("kinds", "items") & {
    context: Context,
    compiling: bool,
    cursor: U64Buffer,
    target: Snapshot
}

export type Effect =
    Driver.Pick("context", "compiling") & Event.Pick("action", "next")

export type Move = Driver.Pick("context", "compiling") & {
    next: u64
}

export type Task = Move & {
    parallel: bool
}
