import type { ReadColumn } from "memory"
import type { Cursor, Plan, SavedReturn } from "./model"
import type { Rows as ResultRows } from "./select_result"

export type Lengths = {
    bindings: u64,
    facts: u64
}

export type Request = Plan & {
    cursor: Cursor,
    lengths: Lengths,
    labels: ReadColumn,
    fallback: u8,
    returns?: SavedReturn,
    results?: ResultRows
}

export type Iteration = {
    request: Request,
    running: bool
}
