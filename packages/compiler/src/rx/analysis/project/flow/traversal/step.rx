<Module>
    <Type from="model" as="Model" />
    <Type from="workflow" as="Traversal" />

    <Args in={Traversal.Iteration} out={Traversal.Iteration} />

    <Call fn="host.refreshFlowCursor" in={$in.request.frame} />

    <Call
        fn="advance"
        in={{
            ...$in.request.cursor,
            kinds: $in.request.kinds,
            items: $in.request.items
        }}
    />

    <Call
        fn="host.advanceLengthSlot"
        in={[
            $in.request.cursor_length,
            0,
            $ctx.advance.next - $in.request.cursor.first
        ]}
    />

    <If on={$in.request.cursor.first < $ctx.advance.position}>
        <Call
            module="calls/run"
            in={{
                frame: $in.request.frame,
                items: $in.request.items,
                lengths: $in.request.lengths,
                cursor: $in.request.cursor,
                results: $in.request.results,
                row: $in.request.cursor.first,
                end: $ctx.advance.position
            }}
        />
    </If>

    <Call
        module="apply"
        in={{
            frame: $in.request.frame,
            lengths: $in.request.lengths,
            labels: $in.request.labels,
            fallback: $in.request.fallback,
            inference: $in.request.returns != null,
            cursor: $in.request.cursor,
            returns: $in.request.returns,
            results: $in.request.results,
            saved_bindings: $in.request.cursor.saved_bindings,
            saved_facts: $in.request.cursor.saved_facts,
            case_remaining: $in.request.cursor.case_remaining,
            case_stopped: $in.request.cursor.case_stopped,
            end: $in.request.cursor.end,
            action: $ctx.advance.action,
            item: $ctx.advance.item,
            position: $ctx.advance.position
        }}
    />

    <If on={$ctx.advance.pop}>
        <Call fn="host.popFlowFrame" in={$in.request.frame} />
    </If>

    <Return
        value={{
            request: $in.request,
            running: $ctx.advance.action != Model.Action.Done
        }}
    />
</Module>
