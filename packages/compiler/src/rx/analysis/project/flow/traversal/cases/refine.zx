import memory from "memory"
import { refineFlowCase } from "rx_project_host"

import type { Row } from "../effect"
import type { Update } from "./coverage"

export type Input = Row.Pick("frame", "position", "lengths") & {
    coverage?: Update
}

export type Output = u64

export default function (in: Input): Output {
    const facts = memory.readLengthSlot(in.lengths, 1)

    refineFlowCase(in.frame, in.position, in.coverage)

    return facts
}
