<Module>
    <Type from="effect" as="Effect" />
    <Type from="host" as="Host" />
    <Type from="model" as="Model" />

    <Args in={Effect.Input} out={void} />

    <Switch on={$in.action}>
        <Case value={Model.Action.Return}>
            <Call
                fn="host.evaluateFlowReturn"
                in={[
                    $in.frame,
                    $in.item
                ]}
            />

            <If on={$in.returns == null}>
                <Call
                    fn="publish_step"
                    in={{
                        frame: $in.frame,
                        index:
                            $in.cursor.target_first +
                            ($in.position - $in.cursor.target_start),
                        kind: Host.FlowKind.Return
                    }}
                />

                <Else>
                    <If on={$in.returns != null}>
                        <Call fn="mark_returned" in={$in.returns} />
                    </If>
                </Else>
            </If>
        </Case>

        <Case value={Model.Action.OpenTask}>
            <Call
                fn="host.openFlowTask"
                in={[
                    $in.frame,
                    $in.position,
                    $in.item,
                    false
                ]}
            />
        </Case>

        <Case value={Model.Action.OpenParallelTask}>
            <Call
                fn="host.openFlowTask"
                in={[
                    $in.frame,
                    $in.position,
                    $in.item,
                    true
                ]}
            />
        </Case>

        <Case value={Model.Action.OpenParallel}>
            <Call
                fn="host.openFlowParallel"
                in={[
                    $in.frame,
                    $in.position,
                    $in.item
                ]}
            />
        </Case>

        <Case value={Model.Action.OpenSelection}>
            <Call
                fn="host.openFlowSelection"
                in={[
                    $in.frame,
                    $in.position,
                    $in.item
                ]}
            />
        </Case>

        <Case value={Model.Action.OpenCase}>
            <Call
                module="cases/open"
                in={$in.pick([
                    "frame",
                    "position",
                    "lengths",
                    "labels",
                    "fallback",
                    "inference",
                    "end",
                    "case_remaining",
                    "case_stopped",
                    "coverage"
                ])}
            />
        </Case>

        <Case value={Model.Action.CloseTask}>
            <Call
                module="tasks/close"
                in={{
                    frame: $in.frame,
                    lengths: $in.lengths,
                    saved_bindings: $in.saved_bindings,
                    cursor: $in.cursor,
                    returns: $in.returns,
                    results: $in.results,
                    parallel: false
                }}
            />
        </Case>

        <Case value={Model.Action.CloseParallelTask}>
            <Call
                module="tasks/close"
                in={{
                    frame: $in.frame,
                    lengths: $in.lengths,
                    saved_bindings: $in.saved_bindings,
                    cursor: $in.cursor,
                    returns: $in.returns,
                    results: $in.results,
                    parallel: true
                }}
            />
        </Case>

        <Case value={Model.Action.CloseParallel}>
            <Call fn="host.mergeFlowParallelBindings" in={$in.frame} />

            <If on={$in.returns == null}>
                <Call
                    fn="publish_step"
                    in={{
                        frame: $in.frame,
                        index: $in.cursor.destination,
                        kind: Host.FlowKind.Parallel
                    }}
                />
            </If>
        </Case>

        <Case value={Model.Action.CloseSelection}>
            <If on={$in.returns == null}>
                <Call fn="host.checkFlowSelection" in={$in.frame} />

                <Call
                    fn="publish_step"
                    in={{
                        frame: $in.frame,
                        index: $in.cursor.destination,
                        kind: Host.FlowKind.Selection,
                        exhaustive: $ctx.checkFlowSelection
                    }}
                />
            </If>
        </Case>

        <Case value={Model.Action.CloseCase}>
            <Call
                module="cases/close"
                in={$in.pick([
                    "frame",
                    "lengths",
                    "saved_bindings",
                    "saved_facts",
                    "cursor",
                    "returns"
                ])}
            />
        </Case>
    </Switch>
</Module>
