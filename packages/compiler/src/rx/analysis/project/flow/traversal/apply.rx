<Module>
    <Type from="effect" as="Effect" />
    <Type from="host" as="Host" />
    <Type from="model" as="Model" />
    <Type from="operation" as="Operation" />

    <Args in={Effect.Input} out={void} />

    <Store from="operations" as="operations" />

    <Switch on={$in.action}>
        <Case value={Model.Action.Return}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.EvaluateReturn,
                    item: $in.item,
                    returned: $in.returns != null
                }}
                setter={[$store.operations.effect]}
            />

            <If on={$in.returns == null}>
                <Call
                    module="write_step"
                    in={{
                        index:
                            $in.cursor.target_first +
                            ($in.position - $in.cursor.target_start),
                        kind: Host.FlowKind.Return
                    }}
                />
            </If>
        </Case>

        <Case value={Model.Action.OpenTask}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.OpenTask,
                    row: $in.position,
                    item: $in.item,
                    parallel: false
                }}
                setter={[$store.operations.effect]}
            />
        </Case>

        <Case value={Model.Action.OpenParallelTask}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.OpenTask,
                    row: $in.position,
                    item: $in.item,
                    parallel: true
                }}
                setter={[$store.operations.effect]}
            />
        </Case>

        <Case value={Model.Action.OpenParallel}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.OpenParallel,
                    row: $in.position,
                    item: $in.item
                }}
                setter={[$store.operations.effect]}
            />
        </Case>

        <Case value={Model.Action.OpenSelection}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.OpenSelection,
                    row: $in.position,
                    item: $in.item
                }}
                setter={[$store.operations.effect]}
            />
        </Case>

        <Case value={Model.Action.OpenCase}>
            <Call
                module="cases/open"
                in={$in.pick([
                    "position",
                    "lengths",
                    "labels",
                    "fallback",
                    "inference",
                    "end",
                    "case_remaining",
                    "case_stopped"
                ])}
            />
        </Case>

        <Case value={Model.Action.CloseTask}>
            <Call
                module="tasks/close"
                in={{
                    lengths: $in.lengths,
                    saved_bindings: $in.saved_bindings,
                    cursor: $in.cursor,
                    returns: $in.returns,
                    results: $in.results,
                    parallel: false
                }}
            />
        </Case>

        <Case value={Model.Action.CloseParallelTask}>
            <Call
                module="tasks/close"
                in={{
                    lengths: $in.lengths,
                    saved_bindings: $in.saved_bindings,
                    cursor: $in.cursor,
                    returns: $in.returns,
                    results: $in.results,
                    parallel: true
                }}
            />
        </Case>

        <Case value={Model.Action.CloseParallel}>
            <Call
                fn="stage"
                in={{
                    step: Operation.Step.MergeBindings
                }}
                setter={[$store.operations.effect]}
            />

            <If on={$in.returns == null}>
                <Call
                    module="write_step"
                    in={{
                        index: $in.cursor.destination,
                        kind: Host.FlowKind.Parallel
                    }}
                />
            </If>
        </Case>

        <Case value={Model.Action.CloseSelection}>
            <If on={$in.returns == null}>
                <Task name="check_flow_selection" out={$ctx.read_flag}>
                    <Call
                        fn="stage"
                        in={{
                            step: Operation.Step.CheckSelection
                        }}
                        setter={[$store.operations.effect]}
                    />

                    <Call fn="read_flag" in={$store.operations.effect} />
                </Task>

                <Call
                    module="write_step"
                    in={{
                        index: $in.cursor.destination,
                        kind: Host.FlowKind.Selection,
                        exhaustive: $ctx.task.check_flow_selection
                    }}
                />
            </If>
        </Case>

        <Case value={Model.Action.CloseCase}>
            <Call
                module="cases/close"
                in={$in.pick([
                    "lengths",
                    "saved_bindings",
                    "saved_facts",
                    "cursor",
                    "returns"
                ])}
            />
        </Case>
    </Switch>
</Module>
