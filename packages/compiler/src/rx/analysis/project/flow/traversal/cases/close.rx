<Module>
    <Type from="../effect" as="Effect" />

    <Args in={Effect.BranchClose} out={void} />

    <Call
        fn="../host.finishFlowCase"
        in={[
            $in.frame,
            $in.returns == null ? $in.cursor.destination : null,
            $in.saved_facts,
            $in.saved_bindings
        ]}
    />
</Module>
