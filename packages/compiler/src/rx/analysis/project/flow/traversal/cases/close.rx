<Module>
    <Type from="../effect" as="Effect" />

    <Args in={Effect.BranchClose} out={void} />

    <If on={$in.returns == null}>
        <Call
            fn="../host.finishFlowCase"
            in={[
                $in.frame,
                $in.cursor.destination
            ]}
        />
    </If>

    <Call
        fn="../host.shrinkLengthSlot"
        in={[
            $in.lengths,
            1,
            $in.saved_facts
        ]}
    />

    <Call
        fn="../host.shrinkLengthSlot"
        in={[
            $in.lengths,
            0,
            $in.saved_bindings
        ]}
    />
</Module>
