export enum Kind {
    Call,
    Result,
    Task,
    Parallel,
    Selection,
    ParallelTask
}

export enum Region {
    Root,
    Task,
    ParallelTask,
    Parallel,
    Selection,
    Case
}

export enum Action {
    Done,
    Return,
    OpenTask,
    OpenParallelTask,
    OpenParallel,
    OpenSelection,
    OpenCase,
    CloseTask,
    CloseParallelTask,
    CloseParallel,
    CloseSelection,
    CloseCase
}

export type Cursor = {
    region: Region,
    first: u64,
    end: u64,
    saved_bindings: u64,
    saved_facts: u64,
    case_remaining?: bool,
    case_stopped: bool
}

export type Plan = {
    kinds: Kind[],
    items: u32[]
}

export type Input = Cursor & Plan

export type Batch = {
    action: Action,
    next: u64,
    item: u32,
    position: u64,
    pop: bool
}
