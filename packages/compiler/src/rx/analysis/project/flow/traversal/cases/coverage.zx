import memory from "memory"

import record from "../../../../condition/coverage"
import remaining from "../../../../condition/remaining"
import isDefault from "./is_default"

import type { CaseCoverage } from "../effect"

export type Input = CaseCoverage & {
    truth?: bool
}

export type Output = void

export default function (in: Input): Output {
    if (isDefault(in.pick([
        "labels",
        "position",
        "fallback"
    ]))) {
        const truth = remaining({
            ...in.pick([
                "frame",
                "labels",
                "fallback",
                "end"
            ]),
            first: in.position + 1,
            stopped: in.case_stopped,
            remaining: in.case_remaining
        })

        memory.writeColumnOptionalBool(in.coverage.truth, in.position, truth)
        memory.writeColumnBool(in.coverage.stopped, 0, true)
        memory.writeColumnOptionalBool(in.coverage.remaining, 0, truth)

        return
    }

    memory.writeColumnOptionalBool(in.coverage.truth, in.position, in.truth)

    if (!in.case_stopped) {
        const next = record({
            remaining: in.case_remaining,
            label: in.truth
        })

        memory.writeColumnBool(in.coverage.stopped, 0, next.stopped)
        memory.writeColumnOptionalBool(in.coverage.remaining, 0, next.remaining)
    }
}
