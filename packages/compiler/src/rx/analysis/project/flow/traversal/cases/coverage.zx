import record from "../../../../condition/coverage"
import remaining from "../../../../condition/remaining"
import isDefault from "./is_default"

import type { CaseCoverage } from "../effect"

export type Input = CaseCoverage & {
    truth?: bool,
    inference: bool
}

export type Update = {
    truth?: bool,
    stopped?: bool,
    remaining?: bool
}

export type Output = Update?

export default function (in: Input): Output {
    if (!in.inference) {
        return null
    }

    if (isDefault(in.pick([
        "labels",
        "position",
        "fallback"
    ]))) {
        const truth = remaining({
            ...in.pick([
                "frame",
                "labels",
                "fallback",
                "end"
            ]),
            first: in.position + 1,
            stopped: in.case_stopped,
            remaining: in.case_remaining
        })

        return {
            truth,
            stopped: true,
            remaining: truth
        }
    }

    if (!in.case_stopped) {
        const next = record({
            remaining: in.case_remaining,
            label: in.truth
        })

        return {
            truth: in.truth,
            stopped: next.stopped,
            remaining: next.remaining
        }
    }

    return {
        truth: in.truth
    }
}
