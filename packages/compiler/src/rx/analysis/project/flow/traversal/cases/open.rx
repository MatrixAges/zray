<Module>
    <Type from="../effect" as="Effect" />

    <Args in={Effect.Row} out={void} />

    <Call
        fn="../host.readLengthSlot"
        in={[
            $in.lengths,
            0
        ]}
    />

    <Call
        fn="../host.evaluateFlowCaseLabel"
        in={[
            $in.frame,
            $in.position
        ]}
    />

    <If on={$in.inference}>
        <Call
            fn="coverage"
            in={{
                ...$in.omit([
                    "inference",
                    "lengths"
                ]),
                truth: $ctx.evaluateFlowCaseLabel
            }}
        />
    </If>

    <Call
        fn="refine"
        in={$in.pick([
            "frame",
            "position",
            "lengths"
        ])}
    />

    <Call
        fn="../host.pushFlowCase"
        in={[
            $in.frame,
            $in.position,
            $ctx.readLengthSlot,
            $ctx.refine
        ]}
    />
</Module>
