<Module>
    <Type from="../effect" as="Effect" />
    <Type from="../operation" as="Operation" />

    <Args in={Effect.Row} out={void} />

    <Store from="../operations" as="operations" />

    <Task name="saved_bindings" out={$ctx.scope_length}>
        <Call
            fn="../scope_length"
            in={{
                lengths: $in.lengths,
                facts: false
            }}
        />
    </Task>

    <Task name="evaluate_flow_case_label" out={$ctx.read_truth}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.EvaluateLabel,
                row: $in.position
            }}
            setter={[$store.operations.effect]}
        />

        <Call fn="../read_truth" in={$store.operations.effect} />
    </Task>

    <Call
        module="coverage"
        in={{
            ...$in.omit(["lengths"]),
            truth: $ctx.task.evaluate_flow_case_label
        }}
    />

    <Task name="saved_facts" out={$ctx.scope_length}>
        <Call
            fn="../scope_length"
            in={{
                lengths: $in.lengths,
                facts: true
            }}
        />
    </Task>

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.RefineCase,
            row: $in.position,
            coverage: $ctx.coverage
        }}
        setter={[$store.operations.effect]}
    />

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.PushCase,
            row: $in.position,
            bindings: $ctx.task.saved_bindings,
            facts: $ctx.task.saved_facts
        }}
        setter={[$store.operations.effect]}
    />
</Module>
