<Module>
    <Type from="../effect" as="Effect" />

    <Args in={Effect.Row} out={void} />

    <Call
        fn="../host.readLengthSlot"
        in={[
            $in.lengths,
            0
        ]}
    />

    <Call
        fn="is_default"
        in={{
            labels: $in.labels,
            position: $in.position,
            fallback: $in.fallback
        }}
    />

    <If on={$ctx.is_default}>
        <Call
            fn="../host.evaluateFlowDefaultCase"
            in={[
                $in.frame,
                $in.position
            ]}
        />

        <Else>
            <Call
                fn="../host.evaluateFlowCaseLabel"
                in={[
                    $in.frame,
                    $in.position
                ]}
            />
        </Else>
    </If>

    <Call
        fn="../host.refineFlowCase"
        in={[
            $in.frame,
            $in.position
        ]}
    />

    <Call
        fn="../host.pushFlowCase"
        in={[
            $in.frame,
            $in.position,
            $ctx.readLengthSlot,
            $ctx.refineFlowCase
        ]}
    />
</Module>
