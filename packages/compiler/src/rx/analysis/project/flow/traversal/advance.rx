<Module>
    <Type from="model" as="Traversal" />

    <Args in={Traversal.Input} out={Traversal.Output} />

    <Call fn="call_end" in={$in} />

    <If on={$ctx.call_end == $in.end}>
        <Call fn="finish" in={$in.region} />

        <Return
            value={{
                action: $ctx.finish,
                next: $in.end,
                item: 0,
                position: $ctx.call_end,
                pop: $in.region != Traversal.Region.Root
            }}
        />
    </If>

    <If on={$in.region == Traversal.Region.Selection}>
        <Return
            value={{
                action: Traversal.Action.OpenCase,
                next: $in.first + 1,
                item: 0,
                position: $in.first,
                pop: false
            }}
        />
    </If>

    <Call fn="action" in={$in.kinds[$ctx.call_end]} />

    <Return
        value={{
            action: $ctx.action,
            next: $ctx.call_end + 1,
            item: $in.items[$ctx.call_end],
            position: $ctx.call_end,
            pop: false
        }}
    />
</Module>
