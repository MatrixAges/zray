<Module>
    <Type from="model" as="Calls" />
    <Type from="../host" as="Host" />
    <Type from="../model" as="Model" />

    <Args in={Calls.Batch} out={Calls.Batch} />

    <Call
        fn="../host.readLengthSlot"
        in={[
            $in.lengths,
            0
        ]}
    />

    <Call
        fn="../host.prepareFlowCall"
        in={[
            $in.frame,
            $in.items[$in.row]
        ]}
    />

    <Call fn="../host.bindFlowGetters" in={$in.frame} />

    <If on={$ctx.prepareFlowCall}>
        <Call fn="../host.evaluateFlowArgument" in={$in.frame} />

        <Else>
            <Call fn="../host.createFlowUnitArgument" in={$in.frame} />
        </Else>
    </If>

    <Call
        fn="../host.shrinkLengthSlot"
        in={[
            $in.lengths,
            0,
            $ctx.readLengthSlot
        ]}
    />

    <Call fn="../select_result" in={$in.results} />

    <Call
        fn="../host.registerFlowCall"
        in={[
            $in.frame,
            $ctx.select_result.row,
            $ctx.select_result.visible
        ]}
    />

    <If on={$ctx.registerFlowCall != null}>
        <If on={$in.cursor.region == Model.Region.Parallel}>
            <Call
                fn="../host.checkFlowParallelCall"
                in={[
                    $in.frame,
                    $in.items[$in.row],
                    $ctx.registerFlowCall
                ]}
            />

            <Else>
                <Call
                    fn="../publish_step"
                    in={{
                        frame: $in.frame,
                        index:
                            $in.cursor.target_first +
                            ($in.row - $in.cursor.target_start),
                        kind: Host.FlowKind.Call,
                        first: $ctx.registerFlowCall
                    }}
                />
            </Else>
        </If>
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
