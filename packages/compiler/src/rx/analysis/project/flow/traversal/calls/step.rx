<Module>
    <Type from="model" as="Calls" />
    <Type from="../host" as="Host" />
    <Type from="../model" as="Model" />
    <Type from="../operation" as="Operation" />

    <Args in={Calls.Batch} out={Calls.Batch} />

    <Store from="../operations" as="operations" />

    <Call
        fn="../host.readLengthSlot"
        in={[
            $in.lengths,
            0
        ]}
    />

    <Task name="prepare_flow_call" out={$ctx.read_flag}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.PrepareCall,
                item: $in.items[$in.row]
            }}
            setter={[$store.operations.effect]}
        />

        <Call fn="../read_flag" in={$store.operations.effect} />
    </Task>

    <Call
        fn="../stage"
        in={{
            step: Operation.Step.BindGetters
        }}
        setter={[$store.operations.effect]}
    />

    <If on={$ctx.task.prepare_flow_call}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.EvaluateArgument
            }}
            setter={[$store.operations.effect]}
        />

        <Else>
            <Call
                fn="../stage"
                in={{
                    step: Operation.Step.CreateUnit
                }}
                setter={[$store.operations.effect]}
            />
        </Else>
    </If>

    <Call fn="../select_result" in={$in.results} />

    <Task name="register_flow_call" out={$ctx.read_id}>
        <Call
            fn="../stage"
            in={{
                step: Operation.Step.RegisterCall,
                row: $ctx.select_result.row,
                visible: $ctx.select_result.visible,
                next: $ctx.select_result.next,
                bindings: $ctx.readLengthSlot
            }}
            setter={[$store.operations.effect]}
        />

        <Call fn="../read_id" in={$store.operations.effect} />
    </Task>

    <If on={$ctx.task.register_flow_call != null}>
        <If on={$in.cursor.region == Model.Region.Parallel}>
            <Call
                fn="../stage"
                in={{
                    step: Operation.Step.CheckCall,
                    item: $in.items[$in.row],
                    id: $ctx.task.register_flow_call
                }}
                setter={[$store.operations.effect]}
            />

            <Else>
                <Call
                    module="../write_step"
                    in={{
                        index:
                            $in.cursor.target_first +
                            ($in.row - $in.cursor.target_start),
                        kind: Host.FlowKind.Call,
                        first: $ctx.task.register_flow_call
                    }}
                />
            </Else>
        </If>
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
