import type { ColumnLengths, ReadColumn } from "memory"
import type { FlowTraversal } from "rx_project_host"
import type { Batch, Cursor } from "./model"
import type { Request } from "./workflow"

export type Input = Batch.Pick("action", "item", "position") & Cursor.Pick(
    "end",
    "saved_bindings",
    "saved_facts",
    "case_remaining",
    "case_stopped"
) & {
    frame: FlowTraversal,
    lengths: ColumnLengths,
    labels: ReadColumn,
    fallback: u8,
    inference: bool
} & Request.Pick("cursor", "returns", "results", "coverage")

export type CaseCoverage = Input.Pick(
    "frame",
    "position",
    "labels",
    "fallback",
    "end",
    "case_remaining",
    "case_stopped",
    "coverage"
)

export type Row = CaseCoverage & Input.Pick("lengths", "inference")

export type CaseClose = Input.Pick("frame", "lengths", "saved_bindings", "saved_facts")

export type BranchClose = CaseClose & Input.Pick("cursor", "returns")

export type TaskClose = CaseClose.Omit("saved_facts") & Request.Pick(
    "cursor",
    "returns",
    "results",
) & {
    parallel: bool
}
