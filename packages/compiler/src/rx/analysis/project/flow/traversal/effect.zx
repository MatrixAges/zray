import type { ReadColumn } from "memory"
import type { Batch, Cursor } from "./model"
import type { Lengths, Request } from "./workflow"

export type Input = Batch.Pick("action", "item", "position") & Cursor.Pick(
    "end",
    "saved_bindings",
    "saved_facts",
    "case_remaining",
    "case_stopped"
) & {
    lengths: Lengths,
    labels: ReadColumn,
    fallback: u8,
    inference: bool
} & Request.Pick("cursor", "returns", "results")

export type CaseCoverage = Input.Pick(
    "position",
    "labels",
    "fallback",
    "end",
    "case_remaining",
    "case_stopped"
)

export type Row = CaseCoverage & Input.Pick("lengths", "inference")

export type CaseClose = Input.Pick("lengths", "saved_bindings", "saved_facts")

export type BranchClose = CaseClose & Input.Pick("cursor", "returns")

export type TaskClose = CaseClose.Omit("saved_facts") & Request.Pick(
    "cursor",
    "returns",
    "results",
) & {
    parallel: bool
}

export type Lookahead = CaseCoverage.Pick("labels", "fallback", "end", "position") & {
    stopped: bool,
    remaining?: bool
}

export type Coverage = CaseCoverage & {
    truth?: bool,
    inference: bool
}
