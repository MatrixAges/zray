import { FlowPublish } from "./operation"

import type { FlowKind } from "./operation"

export type Input = {
    index: u64,
    kind: FlowKind,
    first?: u32,
    exhaustive?: bool,
    output?: FlowPublish
}

export type Request = Input & {
}

export type Output = {
    index: u64,
    kind: FlowKind,
    first: u32,
    exhaustive: bool,
    output: FlowPublish
}

export default function (in: Input): Output {
    return {
        index: in.index,
        kind: in.kind,
        first: in.first ?? 0,
        exhaustive: in.exhaustive ?? false,
        output: in.output ?? FlowPublish.None
    }
}
