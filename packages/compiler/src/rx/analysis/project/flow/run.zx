import memory from "memory"

export enum Kind {
    Call,
    Result,
    Task,
    Parallel,
    Selection,
    ParallelTask
}

export type Input = {
    kinds: Kind[],
    items: u32[],
    first: u64,
    end: u64
}

export type Output = {
    kind: Kind,
    items: u32[]
}

export default function (in: Input): Output {
    const kind = in.kinds[in.first]

    const next = in.first + 1

    const end = match kind {
        Kind.Call => loop(next, {
            while: row => row < in.end && in.kinds[row] == Kind.Call,
            next: row => {
                row += 1
            },
            return: row => row
        }),
        _ => next
    }

    return {
        kind,
        items: memory.borrowU32Range(in.items, in.first, end - in.first)
    }
}
