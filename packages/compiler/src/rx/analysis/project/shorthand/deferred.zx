import memory from "memory"
import { completeDerivedShortcut } from "rx_project_host"

import type { Resolve as Input } from "../workflow/derive/model"

export type Output = void

export default function (in: Input): Output {
    const count = memory.columnLength(in.shortcuts)

    const completed = loop(0, {
        while: row => row < count,
        next: row => {
            if (memory.readColumnBool(in.shortcuts, row)) {
                completeDerivedShortcut(in.state, row)
            }

            row += 1
        }
    })
}
