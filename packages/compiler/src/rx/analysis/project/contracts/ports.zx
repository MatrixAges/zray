import { ports_per_declaration } from "./const"
import grouping from "./group"

export type Input = {
    owners: u64[],
    types: u32[],
    start: u64
}

export type Output = {
    owner: u64,
    input: u32,
    output: u32,
    next: u64
}

export default function (in: Input): Output {
    const types = in.types

    const { owner, end } = grouping({
        owners: in.owners,
        start: in.start
    })

    return {
        owner,
        input: types[end - ports_per_declaration],
        output: types[end - 1],
        next: end
    }
}
