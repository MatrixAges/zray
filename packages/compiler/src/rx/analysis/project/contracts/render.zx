import bytes from "std:bytes"

import { assignment, declaration, newline } from "./const"

import type { Fields } from "./model"

export type Input = Fields & {
    ends: u64[]
}

export type Output = u8[]

export default function (in: Input): Output {
    const { names, expressions, ends } = in

    const count = ends.length

    if (count == 0) {
        return []
    }

    const prefix = bytes.fromText(declaration)
    const equal = bytes.fromText(assignment)
    const line = bytes.fromText(newline)
    const empty: u8[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < count,
        next: state => {
            const name = bytes.fromText(names[state.row])
            const expression = bytes.fromText(expressions[state.row])

            const part = prefix
                .concat(name)[0]
                .concat(equal)[0]
                .concat(expression)[0]
                .concat(
                    line
                )[0]

            state.out = state.out.concat(part)[0]
            state.row += 1
        },
        return: state => state.out
    })
}
