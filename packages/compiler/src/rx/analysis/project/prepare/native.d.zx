export type Context = opaque

export type Invocation = opaque

export type FlowTarget = opaque

export declare function beginModule(context: Context, row: u64): void throws { InvalidFlow, OutOfMemory }

export declare function resolveStores(context: Context): void throws { InvalidFlow, OutOfMemory }

export declare function prepareBody(context: Context): void throws { InvalidFlow, OutOfMemory }

export declare function importTypes(context: Context): void throws { InvalidFlow, OutOfMemory }

export declare function publishModule(context: Context): void throws { InvalidFlow, OutOfMemory }

export declare function scanCall(context: Invocation): void

export declare function parseArgument(context: Invocation): void throws { InvalidFlow, OutOfMemory }

export declare function authorizeCall(context: Invocation): void throws { InvalidFlow, OutOfMemory }

export declare function resolveCallee(context: Invocation): void throws { InvalidFlow, OutOfMemory }

export declare function publishCall(context: Invocation): void throws { InvalidFlow, OutOfMemory }

export declare function recordArgument(context: Invocation): void throws { InvalidFlow, OutOfMemory }

export declare function bindCall(context: FlowTarget, slot: u64, item: u32, previous_end: u32): void throws { InvalidFlow, OutOfMemory }

export declare function bindResult(context: FlowTarget, slot: u64, item: u32): void

export declare function bindTaskResult(context: FlowTarget, slot: u64, item: u32): void

export declare function bindTask(context: FlowTarget, slot: u64, item: u32, first: u32, count: u32, output: bool): void

export declare function bindParallelTask(context: FlowTarget, slot: u64, item: u32, first: u32, count: u32, task_id: u64): void

export declare function bindGroup(context: FlowTarget, item: u32, first: u32, count: u32): void

export declare function bindSelection(context: FlowTarget, slot: u64, item: u32, conditional: bool, else_branch: bool): void throws { InvalidFlow, OutOfMemory }

export declare function taskReturns(context: FlowTarget, slot: u64): void throws { InvalidFlow, OutOfMemory }

export declare function unreachableStep(context: FlowTarget, slot: u64): void throws { InvalidFlow, OutOfMemory }

export declare function unsupportedStep(context: FlowTarget, slot: u64): void throws { InvalidFlow, OutOfMemory }
