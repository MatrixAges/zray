<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Module} out={void} />

    <Call fn="begin" in={$in} />
    <Call fn="../../prepare.resolveStores" in={$in.context} />
    <Call fn="../../prepare.prepareBody" in={$in.context} />
    <Call fn="../../prepare.importTypes" in={$in.context} />
    <Call fn="../../prepare.publishModule" in={$in.context} />
</Module>
