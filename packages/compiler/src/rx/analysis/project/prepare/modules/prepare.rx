<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Run} out={Preparation.Run} />

    <Store from="publication" as="publication" />

    <Task name="begin">
        <Call
            fn="publish"
            in={{
                step: Preparation.Step.Begin,
                row: $in.row
            }}
            setter={[$store.publication.command]}
        />
    </Task>

    <Task name="stores">
        <Call
            fn="publish"
            in={{
                step: Preparation.Step.Stores,
                row: $in.row
            }}
            setter={[$store.publication.command]}
        />
    </Task>

    <Task name="flow">
        <Call
            fn="publish"
            in={{
                step: Preparation.Step.Flow,
                row: $in.row
            }}
            setter={[$store.publication.command]}
        />
    </Task>

    <Task name="imports">
        <Call
            fn="publish"
            in={{
                step: Preparation.Step.Imports,
                row: $in.row
            }}
            setter={[$store.publication.command]}
        />
    </Task>

    <Task name="publish">
        <Call
            fn="publish"
            in={{
                step: Preparation.Step.Publish,
                row: $in.row
            }}
            setter={[$store.publication.command]}
        />
    </Task>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
