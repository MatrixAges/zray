<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Form} out={Preparation.Step[]} />

    <Switch on={$in}>
        <Case value={Preparation.Form.Module}>
            <Return
                value={[
                    Preparation.Step.BeginModule,
                    Preparation.Step.ResolveStores,
                    Preparation.Step.PrepareBody,
                    Preparation.Step.ImportTypes,
                    Preparation.Step.PublishModule
                ]}
            />
        </Case>

        <Case value={Preparation.Form.Call}>
            <Return
                value={[
                    Preparation.Step.ScanCall,
                    Preparation.Step.ParseArgument,
                    Preparation.Step.AuthorizeCall,
                    Preparation.Step.ResolveCallee,
                    Preparation.Step.PublishCall,
                    Preparation.Step.RecordArgument,
                    Preparation.Step.BindPrevious
                ]}
            />
        </Case>
    </Switch>
</Module>
