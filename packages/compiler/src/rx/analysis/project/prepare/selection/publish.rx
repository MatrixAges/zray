<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Publication} />

    <Call
        fn="inspect"
        in={$in.pick([
            "tree",
            "slot"
        ])}
    />

    <If on={$in.conditional}>
        <Call
            fn="conditional"
            in={{
                ...$in.pick([
                    "units",
                    "labels",
                    "slot",
                    "has_else"
                ]),
                branches: $ctx.inspect
            }}
        />

        <Return
            value={{
                row: $in.row,
                subject: $ctx.inspect.subject,
                cases: $ctx.conditional
            }}
        />
    </If>

    <Call
        fn="cases"
        in={{
            ...$in.pick([
                "tree",
                "units",
                "labels",
                "facts"
            ]),
            branches: $ctx.inspect
        }}
    />

    <Return
        value={{
            row: $in.row,
            subject: $ctx.inspect.subject,
            cases: $ctx.cases
        }}
    />
</Module>
