import { allocateRows } from "core/row_buffer"
import columns from "memory/columns"

import type { RowBuffer } from "memory/columns"

export type Input = [
    RowBuffer,
    u64
]

export type Output = void

export default function (in: Input): Output {
    const [storage, count] = in

    columns.clearRowStorage(storage)

    allocateRows({
        target: storage,
        count
    })
}
