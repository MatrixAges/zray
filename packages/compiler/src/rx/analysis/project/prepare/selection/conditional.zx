import write from "./write"

import type { Branches, Cases as Output, Input as Selection } from "./model"

export type Input = Selection.Pick("units", "labels", "slot", "has_else") & {
    branches: Branches
}

export default function (in: Input): Output {
    const { units, labels, branches } = in

    const affirmative = write({
        cases: {
            firsts: [],
            counts: [],
            kinds: [],
            sources: []
        },
        units,
        slot: in.slot,
        tag: labels.affirmative,
        attribute: branches.subject
    })

    if (!in.has_else) {
        return affirmative
    }

    return write({
        cases: affirmative,
        units,
        slot: branches.first_child + branches.child_count - 1,
        tag: labels.fallback,
        attribute: null
    })
}
