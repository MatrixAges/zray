import write from "./write"

import type { Branches, Input as Selection } from "./model"

export type Input = Selection.Pick("tree", "units", "rows", "slot", "has_else") & {
    branches: Branches
}

export type Output = void

export default function (in: Input): Output {
    const { units, rows, branches } = in
    const { labels } = rows

    const width = in.tree.layout.attribute_width

    write({
        rows: rows.body,
        units,
        slot: in.slot,
        row: 0,
        tag: labels.affirmative,
        attribute: branches.subject,
        attribute_width: width
    })

    if (in.has_else) {
        write({
            rows: rows.body,
            units,
            slot: branches.first_child + branches.child_count - 1,
            row: 1,
            tag: labels.fallback,
            attribute: null,
            attribute_width: width
        })
    }
}
