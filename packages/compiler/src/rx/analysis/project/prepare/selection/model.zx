import type { Tree } from "../flow/tree"

export type Labels = {
    ordinary: u8,
    affirmative: u8,
    fallback: u8
}

export type Units = {
    unit_firsts: u32[],
    unit_counts: u32[]
}

export type Input = {
    tree: Tree,
    labels: Labels,
    units: Units,
    facts: u32[],
    slot: u64,
    row: u32,
    conditional: bool,
    has_else: bool
}

export type Branches = {
    subject: u8[],
    first_child: u64,
    child_count: u64
}

export type Cases = {
    firsts: u32[],
    counts: u32[],
    kinds: u8[],
    sources: u8[][]
}

export type Publication = {
    row: u32,
    subject: u8[],
    cases: Cases
}
