import type { RowBuffer, WriteColumn } from "memory/columns"
import type { Tree } from "../flow/tree"

export type CaseRows = {
    kind: WriteColumn,
    source: WriteColumn,
    first: WriteColumn,
    count: WriteColumn,
    truth: WriteColumn
}

export type Labels = {
    ordinary: u8,
    affirmative: u8,
    fallback: u8
}

export type SelectionRows = {
    subject: WriteColumn,
    cases: WriteColumn
}

export type Rows = {
    destination: SelectionRows,
    storage: RowBuffer,
    labels: Labels,
    body: CaseRows
}

export type Units = {
    unit_firsts: u32[],
    unit_counts: u32[]
}

export type Input = {
    tree: Tree,
    rows: Rows,
    units: Units,
    facts: u32[],
    slot: u64,
    row: u32,
    conditional: bool,
    has_else: bool
}

export type Branches = {
    subject: u8[],
    first_child: u64,
    child_count: u64,
    case_count: u64
}
