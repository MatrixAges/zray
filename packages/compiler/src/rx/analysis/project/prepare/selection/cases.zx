import integers from "std:integer"

import { alternate } from "../../../../dependency_graph/flow/const"
import find from "../../../../schema/tree/attribute_row"
import { result_value } from "../flow/const"
import node from "../flow/tree"
import write from "./write"

import type { Branches, Cases as Output, Input as Selection } from "./model"

export type Input = Selection.Pick("tree", "units", "labels", "facts") & {
    branches: Branches
}

export default function (in: Input): Output {
    const { tree, units, labels, facts, branches } = in
    const { layout } = tree

    const cases: Output = {
        firsts: [],
        counts: [],
        kinds: [],
        sources: []
    }

    const mask = integers.widen(alternate)

    return loop(cases, {
        while: values => values.kinds.length < branches.child_count,
        next: values => {
            const row = values.kinds.length
            const slot = branches.first_child + row
            const flags = integers.widen(facts[slot])
            const fallback = integers.andBits(flags, mask) != 0
            const attribute: u8[]? = match {
                fallback => null,
                _ => find({
                    layout,
                    node: node([
                        tree,
                        slot
                    ]),
                    key: result_value
                })
            }

            values = write({
                cases: values,
                units,
                slot,
                tag: fallback ? labels.fallback : labels.ordinary,
                attribute
            })
        }
    })
}
