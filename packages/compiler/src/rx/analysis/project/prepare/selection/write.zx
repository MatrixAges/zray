import type { Cases as Output, Units } from "./model"

export type Input = {
    cases: Output,
    units: Units,
    slot: u64,
    tag: u8,
    attribute?: u8[]
}

export default function (in: Input): Output {
    const { cases, units, slot } = in

    return {
        firsts: cases.firsts.push(units.unit_firsts[slot])[0],
        counts: cases.counts.push(units.unit_counts[slot])[0],
        kinds: cases.kinds.push(in.tag)[0],
        sources: cases.sources.push(in.attribute ?? [])[0]
    }
}
