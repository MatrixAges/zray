import columns from "memory/columns"

import reference from "../flow/write_reference"

import type { CaseRows, Units } from "./model"

export type Input = {
    rows: CaseRows,
    units: Units,
    slot: u64,
    row: u64,
    tag: u8,
    attribute: u8[]?,
    attribute_width: u64
}

export type Output = void

export default function (in: Input): Output {
    const { rows, units, slot, row, tag } = in

    columns.writeColumnU32(rows.first, row, units.unit_firsts[slot])
    columns.writeColumnU32(rows.count, row, units.unit_counts[slot])
    columns.writeColumnU8(rows.kind, row, tag)
    columns.writeColumnOptionalBool(rows.truth, row, null)

    reference([
        rows.source,
        row,
        in.attribute,
        in.attribute_width
    ])
}
