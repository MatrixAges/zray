import find from "../../../../../schema/tree/attribute_row"
import { task_out } from "../const"

import type { Layout } from "../../../../../syntax/tree/layout"

export type Input = {
    layout: Layout,
    node: u8[]
}

export type Output = bool

export default function (in: Input): Output {
    return find({
        layout: in.layout,
        node: in.node,
        key: task_out
    }) != null
}
