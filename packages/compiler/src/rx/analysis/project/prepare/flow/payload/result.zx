import find from "../../../../../schema/tree/attribute_row"
import { result_value, task_out } from "../const"
import node from "../tree"

import type { Input, Result as Output } from "./model"

export default function (in: Input): Output {
    const { tree, event } = in

    const source = node([
        tree,
        event.slot
    ])

    const implicit = event.implicit_item

    const value = find({
        layout: tree.layout,
        node: source,
        key: implicit == null ? result_value : task_out
    })

    return {
        row: implicit ?? event.item,
        attribute: value ?? []
    }
}
