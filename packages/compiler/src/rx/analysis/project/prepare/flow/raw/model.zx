import type { Layout } from "../../../../../syntax/tree/layout"

export type Tree = {
    nodes: u8[][],
    children: u64[]
}

export type Rows = Tree & {
    parents: u64[],
    siblings: u64[],
    counts: u64[],
    slots: u64[]
}

export type Input = {
    root: u8[],
    layout: Layout
}

export type Counts = {
    steps: u64,
    calls: u64,
    results: u64,
    tasks: u64,
    groups: u64,
    selections: u64
}

export type Output = {
    tree: Tree,
    capacity: Counts,
    facts: u32[],
    unit_firsts: u32[],
    unit_counts: u32[],
    step_rows: u32[],
    events: u64[],
    parallel_tasks: u64
}
