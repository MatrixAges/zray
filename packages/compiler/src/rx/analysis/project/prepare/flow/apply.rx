<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Apply} out={void} />

    <If on={$in.event.header == null}>
        <Call fn="diagnostic" in={$in.event.route} />

        <Call
            fn="tree"
            in={[
                $in.tree,
                $in.event.slot
            ]}
        />

        <Call
            fn="host.rejectPreparedFlow"
            in={[
                $in.invocation.state,
                $ctx.tree,
                $ctx.diagnostic.at_output,
                $ctx.diagnostic.code,
                $ctx.diagnostic.message
            ]}
        />

        <Else>
            <Call module="payload/plan" in={$in} />

            <Call
                fn="host.beginPreparedCall"
                in={[
                    $in.invocation.state,
                    $in.event.header,
                    $in.event.implicit_header,
                    $ctx.plan,
                    $in.event.previous_end
                ]}
            />

            <If on={$in.event.route == Flow.Route.Call}>
                <Call module="../invocation/run" in={$in.invocation} />
            </If>
        </Else>
    </If>
</Module>
