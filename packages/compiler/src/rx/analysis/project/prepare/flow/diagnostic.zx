import {
    conflicting_output,
    return_path_code,
    unreachable_step,
    unsupported_code,
    unsupported_step
} from "./const"
import { Route } from "./model"

export type Input = Route

export type Output = {
    code: string,
    message: string,
    at_output: bool
}

export default function (in: Input): Output {
    return match in {
        Route.TaskReturns => {
            code: return_path_code,
            message: conflicting_output,
            at_output: true
        },
        Route.Unreachable => {
            code: return_path_code,
            message: unreachable_step,
            at_output: false
        },
        _ => {
            code: unsupported_code,
            message: unsupported_step,
            at_output: false
        }
    }
}
