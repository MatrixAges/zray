<Module>
    <Type from="../model" as="Flow" />
    <Type from="model" as="Payload" />

    <Args in={Flow.Apply} out={Payload.Payload} />

    <Switch on={$in.event.route}>
        <Case value={Flow.Route.Call}>
            <Call
                fn="../tree"
                in={[
                    $in.tree,
                    $in.event.slot
                ]}
            />

            <Return
                value={{
                    node: $ctx.tree
                }}
            />
        </Case>

        <Case value={Flow.Route.Result}>
            <Call
                fn="result"
                in={$in.pick([
                    "tree",
                    "event"
                ])}
            />

            <Return
                value={{
                    result: $ctx.result
                }}
            />
        </Case>

        <Case value={Flow.Route.Task}>
            <Call
                fn="write_task"
                in={$in.pick([
                    "tree",
                    "event"
                ])}
            />

            <Return
                value={{
                    task: $ctx.write_task
                }}
            />
        </Case>

        <Case value={Flow.Route.ParallelTask}>
            <If on={$in.event.implicit_item != null}>
                <Call
                    fn="result"
                    in={$in.pick([
                        "tree",
                        "event"
                    ])}
                />

                <Call
                    fn="write_task"
                    in={$in.pick([
                        "tree",
                        "event"
                    ])}
                />

                <Return
                    value={{
                        result: $ctx.result,
                        task: $ctx.write_task
                    }}
                />
            </If>

            <Call
                fn="write_task"
                in={$in.pick([
                    "tree",
                    "event"
                ])}
            />

            <Return
                value={{
                    task: $ctx.write_task
                }}
            />
        </Case>

        <Case value={Flow.Route.Parallel}>
            <Call fn="parallel" in={$in.event} />

            <Return
                value={{
                    group: $ctx.parallel
                }}
            />
        </Case>

        <Default>
            <Call
                module="../../selection/publish"
                in={{
                    tree: $in.tree,
                    labels: $in.labels,
                    units: $in.index.pick([
                        "unit_firsts",
                        "unit_counts"
                    ]),
                    facts: $in.index.facts,
                    slot: $in.event.slot,
                    row: $in.event.item,
                    conditional: $in.event.route == Flow.Route.If,
                    has_else: $in.event.else_branch
                }}
            />

            <Return
                value={{
                    selection: $ctx.publish
                }}
            />
        </Default>
    </Switch>
</Module>
