import integers from "std:integer"

import bodyEvent from "../../../../../dependency_graph/flow/body_event"
import {
    check_task_event,
    declaration
} from "../../../../../dependency_graph/flow/const"
import project from "../../../../../dependency_graph/flow/project"
import unit from "../../../../../dependency_graph/flow/unit"
import zeros from "../../../../../dependency_graph/flow/zeros"
import { Tag } from "../../../../../schema/execution/model"
import capacityAfter from "./capacity"
import role from "./role"
import taskOutput from "./task_output"

import type { View } from "../../../../../dependency_graph/flow/model"
import type { Layout } from "../../../../../syntax/tree/layout"
import type { Counts, Output as Planned, Rows } from "./model"

export type Input = {
    layout: Layout,
    rows: Rows
}

export type Output = Planned

export default function (in: Input): Output {
    const { layout, rows } = in
    const { nodes, children, counts, parents, siblings } = rows

    const node_count = nodes.length

    const view: View = {
        nodes: null,
        siblings,
        slots: rows.slots
    }

    const capacity: Counts = {
        steps: 0,
        calls: 0,
        results: 0,
        tasks: 0,
        groups: 0,
        selections: 0
    }

    const facts = zeros(node_count)
    const unit_firsts = zeros(node_count)
    const unit_counts = zeros(node_count)
    const step_rows = zeros(node_count)
    const events: u64[] = []

    const planned = loop({
        next: 1,
        finishing: false,
        module_steps: 0,
        parallel_tasks: 0,
        facts,
        unit_firsts,
        unit_counts,
        step_rows,
        events,
        capacity
    }, {
        while: state => state.next != 0,
        next: state => {
            const slot = state.next - 1
            const node = nodes[slot]
            const head = children[slot]
            const tag = role([
                layout,
                node
            ])

            if (!state.finishing && tag == Tag.Task) {
                if (taskOutput({
                    layout,
                    node
                })) {
                    state.facts[slot] = 1
                    state.events = state.events.push(check_task_event + slot)[0]
                }
            }

            if (!state.finishing && head != 0) {
                state.next = head
            } else {
                const parent = parents[slot]

                const parent_tag = match parent {
                    0 => Tag.Unknown,
                    _ => role([
                        layout,
                        nodes[parent - 1]
                    ])
                }

                const parallel = tag == Tag.Task && parent_tag == Tag.Parallel
                const has_output = tag == Tag.Task && state.facts[slot] != 0

                if (parallel) {
                    state.parallel_tasks += 1
                }

                const projected = project({
                    view,
                    head,
                    tag,
                    facts: state.facts
                })

                const marks = integers.andBits(
                    integers.widen(projected.flags),
                    integers.widen(declaration)
                )

                if (parent == 1 && marks == 0) {
                    state.module_steps += 1
                }

                const implicit = parallel && has_output

                const placed = unit({
                    geometry: {
                        children: {
                            view,
                            head
                        },
                        facts: projected.facts,
                        child_count: counts[slot],
                        tag,
                        root_steps: state.module_steps,
                        implicit_result: implicit
                    },
                    step_rows: state.step_rows,
                    slot,
                    start: state.capacity.steps,
                    flags: projected.flags,
                    task_output: has_output
                })

                state.facts = projected.facts
                state.facts[slot] = placed.fact
                state.unit_firsts[slot] = placed.first
                state.unit_counts[slot] = placed.count
                state.step_rows = placed.step_rows

                const loop_body = tag == Tag.Call && parent_tag == Tag.Loop

                if (parent != 0 && !loop_body) {
                    const event = bodyEvent({
                        tag,
                        slot,
                        parallel_rank: parallel ? state.parallel_tasks : null
                    })

                    if (event != null) {
                        state.events = state.events.push(event)[0]
                    }
                }

                state.capacity = capacityAfter({
                    capacity: state.capacity,
                    tag,
                    implicit,
                    loop_body,
                    steps: placed.end
                })

                const previous = siblings[slot]
                state.finishing = previous == 0
                state.next = state.finishing ? parent : previous
            }
        },
        return: state => state.pick([
            "capacity",
            "facts",
            "unit_firsts",
            "unit_counts",
            "step_rows",
            "events",
            "parallel_tasks"
        ])
    })

    return {
        ...planned,
        tree: rows.pick([
            "nodes",
            "children"
        ])
    }
}
