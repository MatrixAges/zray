import native from "rx_prepare"

import { Route } from "./model"

import type { TaskBinding } from "./model"

export type Input = TaskBinding

export type Output = void

export default function (in: Input): Output {
    native.bindSelection(
        in.context,
        in.slot,
        in.item,
        in.route == Route.If,
        in.else_branch
    )
}
