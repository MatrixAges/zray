import step from "compiler/rx_prepare_event"

import type { Walk } from "./model"

export type Input = Walk

export type Output = void

export default function (in: Input): Output {
    const completed = loop({
        remaining: in.count
    }, {
        while: state => state.remaining != 0,
        next: state => {
            state.remaining = step({
                context: in.context,
                index: in.index,
                rows: in.rows,
                remaining: state.remaining
            })
        }
    })
}
