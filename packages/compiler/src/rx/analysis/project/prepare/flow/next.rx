<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={Flow.Output} />

    <Call
        fn="read"
        in={$in.pick([
            "index",
            "remaining"
        ])}
    />

    <Call
        fn="layout"
        in={{
            index: $in.index,
            event: $ctx.read
        }}
    />

    <Call
        fn="publish"
        in={{
            rows: $in.rows,
            layout: $ctx.layout
        }}
    />

    <Return value={$ctx.publish} />
</Module>
