<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={Flow.Output} />

    <Call
        fn="read"
        in={$in.pick([
            "index",
            "remaining"
        ])}
    />

    <If on={!$ctx.read.ready}>
        <Return
            value={{
                remaining: 0,
                slot: 0,
                route: Flow.Route.Done,
                row: 0,
                first: 0,
                count: 0,
                task_id: null,
                task_output: false,
                else_branch: false,
                item: 0,
                implicit_item: null
            }}
        />
    </If>

    <Call
        fn="layout"
        in={{
            index: $in.index,
            event: $ctx.read
        }}
    />

    <Call
        fn="publish"
        in={{
            rows: $in.rows,
            layout: $ctx.layout
        }}
    />

    <Return value={$ctx.publish} />
</Module>
