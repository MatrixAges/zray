<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Step} out={u64} />

    <Call
        fn="read"
        in={$in.pick([
            "index",
            "remaining"
        ])}
    />

    <If on={!$ctx.read.ready}>
        <Return value={0} />
    </If>

    <Call
        fn="layout"
        in={{
            index: $in.index,
            event: $ctx.read
        }}
    />

    <Call
        fn="publish"
        in={{
            rows: $in.rows,
            layout: $ctx.layout
        }}
    />

    <Switch on={$ctx.publish.route}>
        <Case value={Flow.Route.Call}>
            <Call
                fn="bind_call"
                in={{
                    context: $in.context,
                    flags: $ctx.read.flags,
                    row: $ctx.publish.row,
                    slot: $ctx.publish.slot,
                    item: $ctx.publish.item
                }}
            />
        </Case>

        <Case value={Flow.Route.Result}>
            <Call
                fn="bind_result"
                in={{
                    context: $in.context,
                    slot: $ctx.publish.slot,
                    item: $ctx.publish.item
                }}
            />
        </Case>

        <Case value={Flow.Route.Task}>
            <Call
                fn="bind_task"
                in={{
                    context: $in.context,
                    ...$ctx.publish
                }}
            />
        </Case>

        <Case value={Flow.Route.ParallelTask}>
            <Call
                fn="bind_task"
                in={{
                    context: $in.context,
                    ...$ctx.publish
                }}
            />
        </Case>

        <Case value={Flow.Route.Parallel}>
            <Call
                fn="bind_group"
                in={{
                    context: $in.context,
                    item: $ctx.publish.item,
                    first: $ctx.publish.first,
                    count: $ctx.publish.count
                }}
            />
        </Case>

        <Case value={Flow.Route.Switch}>
            <Call
                fn="bind_selection"
                in={{
                    context: $in.context,
                    ...$ctx.publish
                }}
            />
        </Case>

        <Case value={Flow.Route.If}>
            <Call
                fn="bind_selection"
                in={{
                    context: $in.context,
                    ...$ctx.publish
                }}
            />
        </Case>

        <Default>
            <Call
                fn="diagnostic"
                in={{
                    context: $in.context,
                    slot: $ctx.publish.slot,
                    route: $ctx.publish.route
                }}
            />
        </Default>
    </Switch>

    <Return value={$ctx.publish.remaining} />
</Module>
