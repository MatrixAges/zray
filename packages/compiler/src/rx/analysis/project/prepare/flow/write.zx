import integers from "std:integer"
import memory from "std:memory"

import type { Rows } from "./model"

export type Input = {
    rows: Rows,
    lane: u64,
    row: u32,
    code: u8
}

export type Output = u32

export default function (in: Input): Output {
    const { rows, lane } = in

    const position = integers.widen(in.row)
    const item = memory.readU32(rows.cursors, lane)

    memory.writeU8(rows.kinds, position, in.code)
    memory.writeU32(rows.items, position, item)
    memory.writeU32(rows.cursors, lane, item + 1)

    return item
}
