import type { Rows } from "./model"
import type { Header as Output } from "./payload/shape"

export type Input = {
    rows: Rows,
    lane: u64,
    row: u32,
    code: u8
}

export default function (in: Input): Output {
    const { rows, lane, row, code } = in

    const item = rows.cursors[lane]

    return {
        position: row,
        code,
        lane,
        item,
        next: item + 1
    }
}
