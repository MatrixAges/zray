import type { U8Buffer, U32Buffer } from "memory"
import type { FlowTarget } from "rx_prepare"

export type Index = {
    facts: u32[],
    events: u64[],
    unit_firsts: u32[],
    unit_counts: u32[],
    step_rows: u32[],
    parallel_tasks: u64
}

export enum Route {
    Done,
    TaskReturns,
    Unreachable,
    Unsupported,
    Call,
    Result,
    Task,
    ParallelTask,
    Parallel,
    Switch,
    If
}

export type Input = {
    index: Index,
    remaining: u64,
    rows: Rows
}

export type Codes = {
    call: u8,
    result: u8,
    task: u8,
    parallel_task: u8,
    parallel: u8,
    selection: u8
}

export type Rows = {
    kinds: U8Buffer,
    items: U32Buffer,
    cursors: U32Buffer,
    codes: Codes
}

export type Event = {
    ready: bool,
    remaining: u64,
    slot: u64,
    flags: u64,
    phase: u64
}

export type Layout = Event.Pick("remaining", "slot") & {
    route: Route,
    row: u32,
    first: u32,
    count: u32,
    task_id?: u64,
    task_output: bool,
    else_branch: bool
}

export type Output = Layout & {
    item: u32,
    implicit_item?: u32
}

export type Walk = Input.Omit("remaining") & {
    context: FlowTarget,
    count: u64
}

export type Step = Input & {
    context: FlowTarget
}

export type Target = {
    context: FlowTarget
}

export type Position = Target & Output.Pick("slot", "item")

export type Group = Target & Output.Pick("first", "count", "item")

export type TaskBinding = Target & Output

export type Diagnostic = Target & Output.Pick("slot", "route")
