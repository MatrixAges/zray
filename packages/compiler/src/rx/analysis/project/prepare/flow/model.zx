import type { Run as Invocation } from "../invocation/model"
import type { Labels } from "../selection/model"
import type { Header } from "./payload/shape"
import type { Tree } from "./tree"

export type Index = {
    facts: u32[],
    events: u64[],
    unit_firsts: u32[],
    unit_counts: u32[],
    step_rows: u32[],
    parallel_tasks: u64
}

export enum Route {
    Done,
    TaskReturns,
    Unreachable,
    Unsupported,
    Call,
    Result,
    Task,
    ParallelTask,
    Parallel,
    Switch,
    If
}

export type Input = {
    index: Index,
    remaining: u64,
    rows: Rows
}

export type Codes = {
    call: u8,
    result: u8,
    task: u8,
    parallel_task: u8,
    parallel: u8,
    selection: u8
}

export type Rows = {
    cursors: u32[],
    codes: Codes
}

export type Event = {
    ready: bool,
    remaining: u64,
    slot: u64,
    flags: u64,
    phase: u64
}

export type Layout = Event.Pick("remaining", "slot") & {
    route: Route,
    row: u32,
    previous_end: u32,
    first: u32,
    count: u32,
    task_id?: u32,
    task_output: bool,
    else_branch: bool
}

export type Output = Layout & {
    item: u32,
    implicit_item?: u32,
    header?: Header,
    implicit_header?: Header
}

export type Body = Input.Omit("remaining") & {
    tree: Tree,
    labels: Labels
}

export type Run = {
    invocation: Invocation,
    body?: Body,
    remaining: u64
}

export type Apply = Body.Omit("rows") & Run.Pick("invocation") & {
    event: Output
}
