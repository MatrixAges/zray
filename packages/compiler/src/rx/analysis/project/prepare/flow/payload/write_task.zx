import find from "../../../../../schema/tree/attribute_row"
import { task_out } from "../const"
import { Route } from "../model"
import node from "../tree"

import type { Input, Task as Output } from "./model"

export default function (in: Input): Output {
    const { tree, event } = in

    const source = node([
        tree,
        event.slot
    ])

    const explicit_output = event.route == Route.Task && event.task_output

    const output: u8[]? = match {
        explicit_output => find({
            layout: tree.layout,
            node: source,
            key: task_out
        }),
        _ => null
    }

    return {
        row: event.item,
        first: event.first,
        count: event.count,
        node: source,
        id: event.task_id,
        output
    }
}
