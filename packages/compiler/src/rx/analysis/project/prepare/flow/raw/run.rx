<Module>
    <Type from="model" as="Raw" />

    <Args in={Raw.Run} out={Raw.Output} />

    <Call
        fn="collect"
        in={$in.pick([
            "root",
            "layout"
        ])}
    />

    <Call
        fn="reserve"
        in={[
            $in.buffers,
            $ctx.collect.nodes.length
        ]}
    />

    <Call
        fn="layout"
        in={{
            layout: $in.layout,
            buffers: $in.buffers,
            rows: $ctx.collect
        }}
    />

    <Return value={$ctx.layout} />
</Module>
