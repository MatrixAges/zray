import type { U64Buffer } from "memory"
import type { CallAdmission, InvocationPreparation } from "rx_project_host"
import type {
    Input as ExportLookup
} from "../../../../../zx/modules/compiled/imports/find"
import type { Input as CallAttributes } from "../../../call/attributes/scan"
import type { Input as LibraryAdmission } from "../../../call/compiled_admission"
import type { Input as EdgeSearch } from "../../declarations/edges"
import type { Kind } from "../../flow/traversal/model"
import type { Signatures } from "../../references/call_signature"

export type Previous = {
    state: InvocationPreparation,
    previous_end: u32,
    previous_kind?: Kind
}

export type Run = Previous & {
    attributes: CallAttributes,
    edges: EdgeSearch,
    admission: CallAdmission,
    compiled: CompiledView,
    signatures: Signatures
}

export type Compiled = Previous.Pick("state") & {
    edge?: u64,
    compiled: CompiledView
}

export type CompiledView = {
    members: ExportLookup,
    admission: LibraryAdmission,
    check: CompiledCheck
}

export type CompiledCheck = {
    words: U64Buffer,
    function: u64
}
