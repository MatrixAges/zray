<Module>
    <Type from="../" as="Binding" />

    <Args in={Binding.Invocation} out={void} />

    <Call fn="../../prepare.scanCall" in={$in} />
    <Call fn="../../prepare.parseArgument" in={$in} />
    <Call fn="../../prepare.authorizeCall" in={$in} />
    <Call fn="../../prepare.resolveCallee" in={$in} />
    <Call fn="../../prepare.publishCall" in={$in} />
    <Call fn="../../prepare.recordArgument" in={$in} />
</Module>
