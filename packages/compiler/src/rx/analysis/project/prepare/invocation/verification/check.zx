import integers from "std:integer"
import memory from "memory"

import { first_member_bit, prefix_bit, word_bits } from "./const"

import type { CompiledCheck as Input } from "../model"

export enum State {
    Checked,
    VerifyAll,
    VerifyExtension
}

export type Output = State

export default function (in: Input): Output {
    const bit = in.function + first_member_bit
    const index = bit / word_bits
    const mask = integers.bitMask(bit % word_bits)
    const word = memory.readU64(in.words, index)

    if (integers.andBits(word, mask) != 0) {
        return State.Checked
    }

    const first = match index {
        0 => word,
        _ => memory.readU64(in.words, 0)
    }

    const verified = integers.andBits(first, prefix_bit) != 0

    return verified ? State.VerifyExtension : State.VerifyAll
}
