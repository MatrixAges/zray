import integers from "std:integer"

import { first_member_bit, prefix_bit, word_bits } from "./const"

import type { CompiledCheck as Input } from "../model"

export type Output = {
    index: u64,
    word: u64,
    first?: u64
}

export default function (in: Input): Output {
    const bit = in.function + first_member_bit
    const index = bit / word_bits
    const mask = integers.bitMask(bit % word_bits)
    const updated = integers.orBits(in.words[index], mask)

    if (index == 0) {
        return {
            index,
            word: integers.orBits(updated, prefix_bit)
        }
    }

    return {
        index,
        word: updated,
        first: integers.orBits(in.words[0], prefix_bit)
    }
}
