<Module>
    <Type from="model" as="Invocation" />
    <Type from="../../../call/admission_model" as="Admission" />
    <Type from="effect" as="Effect" />

    <Args in={Invocation.Run} out={void} />

    <Store from="invocation" as="invocation" />

    <Call fn="../../../call/attributes/scan" in={$in.attributes} />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ReadCall,
            slots: $ctx.scan
        }}
        setter={[$store.invocation.effect]}
    />

    <If on={$ctx.scan.setter != null}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.AuthorizeSetter
            }}
            setter={[$store.invocation.effect]}
        />
    </If>

    <Call fn="../../declarations/edges" in={$in.edges} />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ReadTarget,
            edge: $ctx.edges
        }}
        setter={[$store.invocation.effect]}
    />

    <Call fn="../../../call/availability" in={$in.admission} />

    <If on={$ctx.availability == Admission.CallRoute.Compiled}>
        <Call
            module="compiled"
            in={{
                edge: $ctx.edges,
                compiled: $in.compiled
            }}
        />
    </If>

    <Call
        fn="publish"
        in={{
            edge: $ctx.edges,
            route: $ctx.availability,
            admission: $in.admission,
            signatures: $in.signatures
        }}
    />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Publish,
            publication: $ctx.publish
        }}
        setter={[$store.invocation.effect]}
    />

    <Call fn="read_flag" in={$store.invocation.effect} />

    <If on={$ctx.read_flag && $in.previous_kind != null}>
        <Call
            module="previous"
            in={$in.pick([
                "previous_end",
                "previous_kind"
            ])}
        />
    </If>
</Module>
