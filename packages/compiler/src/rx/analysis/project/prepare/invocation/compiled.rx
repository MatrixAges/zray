<Module>
    <Type from="model" as="Invocation" />
    <Type from="../../../call/admission_model" as="Admission" />
    <Type from="verification/check" as="Check" />
    <Type from="effect" as="Effect" />

    <Args in={Invocation.Compiled} out={void} />

    <Store from="invocation" as="invocation" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ResolveLibrary,
            edge: $in.edge
        }}
        setter={[$store.invocation.effect]}
    />

    <Call fn="read_index" in={$store.invocation.effect} />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.FindLibrary,
            index: $ctx.read_index
        }}
        setter={[$store.invocation.effect]}
    />

    <Call fn="read_flag" in={$store.invocation.effect} />

    <If on={!$ctx.read_flag}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.LinkLibrary,
                index: $ctx.read_index
            }}
            setter={[$store.invocation.effect]}
        />
    </If>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ReadMembers,
            index: $ctx.read_index,
            edge: $in.edge
        }}
        setter={[$store.invocation.effect]}
    />

    <Call
        fn="../../../../../zx/modules/compiled/imports/find"
        in={$in.compiled.members}
    />

    <If on={$ctx.find == null}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.RejectLibrary,
                status: Admission.CompiledCallStatus.MissingExport
            }}
            setter={[$store.invocation.effect]}
        />
    </If>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.SelectMember,
            index: $ctx.read_index,
            member: $ctx.find
        }}
        setter={[$store.invocation.effect]}
    />

    <Call fn="compiled_status" in={$in.compiled.admission} />

    <If on={$ctx.compiled_status != Admission.CompiledCallStatus.Ready}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.RejectLibrary,
                status: $ctx.compiled_status
            }}
            setter={[$store.invocation.effect]}
        />
    </If>

    <Call fn="verification/check" in={$in.compiled.check} />

    <If on={$ctx.check != Check.State.Checked}>
        <Call fn="verification/remember" in={$in.compiled.check} />

        <Call
            fn="stage"
            in={{
                step: Effect.Step.ValidateLibrary,
                verification: {
                    verified_prefix: $ctx.check == Check.State.VerifyExtension,
                    index: $ctx.remember.index,
                    word: $ctx.remember.word,
                    first: $ctx.remember.first
                }
            }}
            setter={[$store.invocation.effect]}
        />
    </If>
</Module>
