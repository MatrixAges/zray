import { readPreparedCall } from "rx_project_host"

import scan from "../../../call/attributes/scan"

import type { Run } from "./model"

export type Input = Run.Pick("state", "attributes")

export type Output = bool

export default function (in: Input): Output {
    const slots = scan(in.attributes)

    return readPreparedCall(
        in.state,
        slots.argument,
        slots.function,
        slots.module,
        slots.setter
    )
}
