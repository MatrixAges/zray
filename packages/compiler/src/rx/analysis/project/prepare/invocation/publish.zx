import { CallRoute } from "../../../call/admission_model"
import signature from "../../references/call_signature"

import type { Publication } from "../../../call/admission_model"
import type { Input as Selection } from "../../references/call_signature"

export type Input = Selection & {
    edge?: u64
}

export type Output = Publication

export default function (in: Input): Output {
    const target = signature(in.pick([
        "route",
        "admission",
        "signatures"
    ]))

    return {
        ...target,
        edge: in.edge,
        route: in.route,
        local: in.route == CallRoute.Source || in.route == CallRoute.NamedSource
    }
}
