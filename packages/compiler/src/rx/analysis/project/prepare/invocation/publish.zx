import { CallRoute, publishPreparedCall } from "rx_project_host"

import signature from "../../references/call_signature"

import type { Input as Selection } from "../../references/call_signature"
import type { Run } from "./model"

export type Input = Selection & Run.Pick("state") & {
    edge?: u64
}

export type Output = bool

export default function (in: Input): Output {
    const target = signature(in.pick([
        "route",
        "admission",
        "signatures"
    ]))

    const local = in.route == CallRoute.Source || in.route == CallRoute.NamedSource

    return publishPreparedCall(
        in.state,
        in.edge,
        in.route,
        target.callee,
        target.module,
        target.signature,
        target.member,
        local
    )
}
