export type Input = {
    order: u64[],
    first: u64,
    end: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    return loop({
        position: 0,
        entries: empty
    }, {
        while: state => state.position < in.order.length,
        next: state => {
            const row = in.order[state.position]

            if (row >= in.first && row < in.end) {
                state.entries = state.entries.push(row - in.first)[0]
            }

            state.position += 1
        },
        return: state => state.entries
    })
}
