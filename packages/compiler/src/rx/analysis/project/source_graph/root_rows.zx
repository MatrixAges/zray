import memory from "std:memory"

import type { U64Buffer } from "std:memory"

export type Input = {
    roots: U64Buffer,
    first: u64,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { roots, first, count } = in

    const written = loop(0, {
        while: index => index < count,
        next: index => {
            memory.writeU64(roots, index, first + index)
            index += 1
        }
    })
}
