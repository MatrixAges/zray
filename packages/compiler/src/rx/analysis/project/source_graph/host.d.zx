export type GraphVisit = mutable_opaque

export type GraphInternalModules = opaque

export declare function openSourceGraphScanner(
    target: GraphVisit,
    paths: string[],
    buckets: u64[]
): void
    throws { OutOfMemory }

export declare function finishSourceGraphScan(target: GraphVisit, retain_parses: bool): u64[]

export declare function readSourceGraphZX(target: GraphVisit, owner: u64): void
    throws { OutOfMemory, InvalidGraph }

export declare function readSourceGraphRX(target: GraphVisit, owner: u64, row: u64, store: bool): void
    throws { OutOfMemory, InvalidGraph }

export declare function publishSourceGraphDependencies(
    target: GraphVisit,
    owner: u64,
    start: u64
): u64[] throws { OutOfMemory }

export declare function sourceGraphInternal(modules: GraphInternalModules, reference: string): string?
