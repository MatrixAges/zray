export type GraphConstruction = opaque

export type GraphModuleRegistration = opaque

export type GraphVisit = opaque

export type GraphEdgePublication = opaque

export type GraphEdgeScan = opaque

export declare function rejectGraphModuleRegistration(
    target: GraphModuleRegistration,
    row: u64,
    message: string
): void throws { OutOfMemory, InvalidDsl }

export declare function validateRegisteredGraphModule(
    target: GraphModuleRegistration,
    row: u64,
    path: u8[]
): void throws { OutOfMemory, InvalidDsl }

export declare function rejectSourceGraphPath(
    target: GraphConstruction,
    row: u64,
    normalized: bool,
    message: string
): void throws { OutOfMemory, InvalidGraph }

export declare function rejectSourceGraphRoot(
    target: GraphConstruction,
    path: string,
    missing: string
): u64 throws { OutOfMemory, InvalidGraph }

export declare function openSourceGraphScanner(target: GraphVisit): void
    throws { OutOfMemory }

export declare function finishSourceGraphScan(target: GraphVisit, retain_parses: bool): u64[]

export declare function rejectSourceGraphCycle(
    target: GraphConstruction,
    owner: u64,
    edge: u64
): void throws { InvalidGraph }

export declare function readSourceGraphZX(target: GraphVisit, owner: u64): void
    throws { OutOfMemory, InvalidGraph }

export declare function readSourceGraphRX(target: GraphVisit, owner: u64, row: u64, store: bool): void
    throws { OutOfMemory, InvalidGraph }

export declare function publishSourceGraphDependencies(
    target: GraphVisit,
    owner: u64,
    start: u64
): u64[] throws { OutOfMemory }

export declare function appendSourceGraphEdge(
    target: GraphEdgePublication,
    row: u64?,
    named: bool
): void throws { OutOfMemory }

export declare function rejectSourceGraphEdge(
    target: GraphEdgePublication,
    store: bool,
    message: string
): void throws { OutOfMemory, InvalidGraph }

export declare function bindSourceGraphTreeReference(
    target: GraphEdgeScan,
    node: u8[],
    attribute: u8[]?,
    function_target: bool,
    call: bool,
    type_import: bool
): void

export declare function rejectSourceGraphReference(
    target: GraphEdgeScan,
    site: u64,
    message: string
): void throws { OutOfMemory, InvalidGraph }

export declare function resolveSourceGraphReference(
    target: GraphEdgeScan,
    site: u64,
    length: u64,
    is_store: bool
): void throws { OutOfMemory, InvalidGraph }

export declare function sourceGraphInternal(target: GraphEdgeScan, reference: string): string?

export declare function appendSourceGraphNative(
    target: GraphEdgeScan,
    site: u64,
    name: string
): void throws { OutOfMemory, InvalidGraph }

export declare function resolveSourceGraphImport(
    target: GraphEdgeScan,
    site: u64,
    reference: string,
    package_route: bool,
    first: u64?,
    duplicate: bool
): void throws { OutOfMemory, InvalidGraph }
