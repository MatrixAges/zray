import type { U64Buffer } from "memory"

export type Input = {
    offsets: u64[],
    ends: u64[],
    targets: u64[],
    roots: u64[],
    order: u64[],
    order_out: U64Buffer
}

export type Cycle = {
    owner: u64,
    edge: u64
}

export type Output = {
    count: u64,
    batch_ends: u64[],
    cycle?: Cycle
}

export type Ranked = {
    order: u64[],
    depths: u64[],
    count: u64
}
