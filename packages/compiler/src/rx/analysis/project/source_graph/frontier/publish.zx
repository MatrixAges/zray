import type { Edges, Publication } from "./model"

export type Input = Publication

export type Output = Edges

export default function (in: Input): Output {
    return {
        starts: in.starts.splice(in.owner, 1, [in.edge_start])[0],
        ends: in.ends.splice(in.owner, 1, [in.edge_end])[0]
    }
}
