import type { Position, Selection } from "./model"

export type Input = Position

export type Output = Selection

export default function (in: Input): Output {
    if (in.cursor == in.end) {
        return {
            cursor: in.cursor,
            owner: null
        }
    }

    const owner = in.queue[in.cursor]

    return {
        cursor: in.cursor + 1,
        owner
    }
}
