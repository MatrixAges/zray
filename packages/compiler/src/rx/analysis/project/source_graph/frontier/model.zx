export type Frontier = {
    seen: bool[],
    queue: u64[],
    end: u64
}

export type Edges = {
    starts: u64[],
    ends: u64[]
}

export type Queue = Frontier & {
    targets: u64[],
    first: u64
}

export type Position = {
    queue: u64[],
    cursor: u64,
    end: u64
}

export type Publication = Edges & {
    owner: u64,
    edge_start: u64,
    edge_end: u64
}

export type Selection = {
    cursor: u64,
    owner?: u64
}
