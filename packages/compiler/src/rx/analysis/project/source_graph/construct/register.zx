import bytes from "std:bytes"
import fixed from "core/bytes/index/fixed"
import memory from "memory"
import host from "rx_graph_host"

import { store_suffix } from "../../../../../const"
import resolve from "../../../../../zx/modules/project/target/package/path"
import { Kind } from "../../../../path_kind/model"
import normalize from "../../../../path_segments/normalize"
import { duplicate_path, duplicate_store, invalid_registration } from "./const"

import type { Registration as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { target, ranges, paths, index, normalized, root } = in

    const registered = loop(0, {
        while: row => row < ranges.end,
        next: row => {
            const is_store = row >= ranges.rx_end
            const path = match {
                row < ranges.zx_count => memory.readTextColumn(paths.zx, row),
                is_store => memory.readTextColumn(paths.stores, row - ranges.rx_end),
                _ => memory.readTextColumn(paths.rx, row - ranges.zx_count)
            }

            if (row >= ranges.zx_count) {
                const plan = normalize({
                    directory: [],
                    path: bytes.fromText(path),
                    kind: is_store ? Kind.SpecialFile : Kind.ModuleFile,
                    suffix: is_store ? store_suffix : ""
                })

                if (!plan.valid) {
                    host.rejectSourceGraphPath(
                        target,
                        row,
                        false,
                        invalid_registration
                    )
                }
            }

            const absolute = resolve({
                root,
                path
            })

            memory.writeTextSlot(normalized, row, absolute)

            const duplicate = fixed({
                ...index,
                key: bytes.fromText(absolute),
                insert: row
            })

            if (duplicate != null) {
                const message = is_store ? duplicate_store : duplicate_path
                host.rejectSourceGraphPath(target, row, !is_store, message)
            }

            row += 1
        }
    })
}
