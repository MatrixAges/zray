import bytes from "std:bytes"
import lexical from "lexical_path"
import memory from "memory"

import { store_suffix } from "../../../../../const"
import { Kind } from "../../../../path_kind/model"
import normalize from "../../../../path_segments/normalize"
import zeroes from "../zeroes"
import { duplicate_path, duplicate_store, invalid_registration } from "./const"
import probe from "./probe"

import type { Index, PathIssue, Registration as Input } from "./model"

export type Output = Index & {
    issue?: PathIssue
}

export default function (in: Input): Output {
    const { ranges, paths, root } = in

    const initial: Output = {
        keys: [],
        buckets: zeroes(in.capacity)
    }

    return loop(initial, {
        while: index => index.issue == null && index.keys.length < ranges.end,
        next: index => {
            const row = index.keys.length
            const is_store = row >= ranges.rx_end
            const path = match {
                row < ranges.zx_count => memory.readTextColumn(paths.zx, row),
                is_store => memory.readTextColumn(paths.stores, row - ranges.rx_end),
                _ => memory.readTextColumn(paths.rx, row - ranges.zx_count)
            }

            if (row >= ranges.zx_count) {
                const plan = normalize({
                    directory: [],
                    path: bytes.fromText(path),
                    kind: is_store ? Kind.SpecialFile : Kind.ModuleFile,
                    suffix: is_store ? store_suffix : ""
                })

                if (!plan.valid) {
                    index.issue = {
                        row,
                        message: invalid_registration
                    }
                }
            }

            if (index.issue == null) {
                const absolute = lexical.resolvePathParts([
                    root,
                    path
                ])

                const slot = probe({
                    index: index.pick([
                        "keys",
                        "buckets"
                    ]),
                    key: bytes.fromText(absolute)
                })

                if (index.buckets[slot] != 0) {
                    index.issue = {
                        row,
                        normalized: is_store ? null : absolute,
                        message: is_store ? duplicate_store : duplicate_path
                    }
                } else {
                    index.keys = index.keys.push(absolute)[0]
                    index.buckets = index.buckets.with(slot, row + 1)
                }
            }
        }
    })
}
