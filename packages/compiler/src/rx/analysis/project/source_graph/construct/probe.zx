import bytes from "std:bytes"
import integers from "std:integer"

import type { Index } from "./model"

export type Input = {
    index: Index,
    key: u8[]
}

export type Output = u64

export default function (in: Input): Output {
    const { index, key } = in
    const { keys, buckets } = index

    const mask = buckets.length - 1

    return loop({
        slot: integers.andBits(bytes.hash(key), mask),
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const row = buckets[state.slot]

            if (
                row == 0 || bytes.equals(bytes.fromText(keys[row - 1]), key)
            ) {
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => state.slot
    })
}
