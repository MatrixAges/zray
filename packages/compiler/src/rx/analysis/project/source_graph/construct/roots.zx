import memory from "memory"

import { missing_entry, missing_root } from "./const"
import locate from "./entry"

import type { RootPaths as Input } from "./model"

export type Output = {
    additional: u64,
    roots: u64[]
}

export default function (in: Input): Output {
    const { ranges } = in

    const lookup = {
        ...in.pick([
            "target",
            "index",
            "root"
        ]),
        allocator: in.temporary
    }

    const entry = locate({
        ...lookup,
        path: in.entry,
        missing: missing_entry
    })

    const rx_count = in.include_rx ? ranges.rx_end - ranges.zx_count : 0
    const additional = rx_count + in.explicit_count
    const store_count = ranges.end - ranges.rx_end

    const initial: u64[] = []
    const with_entry = initial.push(entry)[0]

    const with_rx = loop({
        index: 0,
        roots: with_entry
    }, {
        while: state => state.index < rx_count,
        next: state => {
            state.roots = state.roots.push(ranges.zx_count + state.index)[0]
            state.index += 1
        },
        return: state => state.roots
    })

    const with_explicit = loop({
        row: 0,
        roots: with_rx
    }, {
        while: state => state.row < in.explicit_count,
        next: state => {
            const path = memory.readTextColumn(in.explicit, state.row)
            const root = locate({
                ...lookup,
                path,
                missing: missing_root
            })

            state.roots = state.roots.push(root)[0]
            state.row += 1
        },
        return: state => state.roots
    })

    const roots = loop({
        index: 0,
        roots: with_explicit
    }, {
        while: state => state.index < store_count,
        next: state => {
            state.roots = state.roots.push(ranges.rx_end + state.index)[0]
            state.index += 1
        },
        return: state => state.roots
    })

    return {
        additional,
        roots
    }
}
