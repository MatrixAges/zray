import memory from "memory"

import writeRows from "../root_rows"
import { missing_entry, missing_root } from "./const"
import locate from "./entry"

import type { RootPaths as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { ranges, roots } = in

    const lookup = {
        ...in.pick([
            "target",
            "index",
            "root"
        ]),
        allocator: in.temporary
    }

    const entry = locate({
        ...lookup,
        path: in.entry,
        missing: missing_entry
    })

    const rx_count = in.include_rx ? ranges.rx_end - ranges.zx_count : 0
    const additional = rx_count + in.explicit_count
    const start = 1 + rx_count
    const store_start = 1 + additional
    const store_count = ranges.end - ranges.rx_end

    memory.allocateU64Buffer(in.allocator, roots, store_start + store_count)
    memory.writeU64(roots, 0, entry)

    writeRows({
        roots,
        start: 1,
        first: ranges.zx_count,
        count: rx_count
    })

    writeRows({
        roots,
        start: store_start,
        first: ranges.rx_end,
        count: store_count
    })

    const written = loop(0, {
        while: row => row < in.explicit_count,
        next: row => {
            const path = memory.readTextColumn(in.explicit, row)
            const root = locate({
                ...lookup,
                path,
                missing: missing_root
            })

            memory.writeU64(roots, start + row, root)
            row += 1
        }
    })

    return additional
}
