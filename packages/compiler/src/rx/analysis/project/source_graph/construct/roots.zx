import memory from "memory"

import { missing_entry, missing_root } from "./const"
import locate from "./entry"

import type { RootIssue, RootPaths as Input } from "./model"

export type Output = {
    additional: u64,
    roots: u64[],
    issue?: RootIssue
}

export type Explicit = {
    row: u64,
    roots: u64[],
    issue?: RootIssue
}

export default function (in: Input): Output {
    const { ranges } = in

    const lookup = {
        ...in.pick([
            "index",
            "root"
        ]),
        allocator: in.temporary
    }

    const entry = locate({
        ...lookup,
        path: in.entry,
        missing: missing_entry
    })

    if (entry.issue != null) {
        return {
            additional: 0,
            roots: [],
            issue: entry.issue
        }
    }

    const rx_count = in.include_rx ? ranges.rx_end - ranges.zx_count : 0
    const additional = rx_count + in.explicit_count
    const store_count = ranges.end - ranges.rx_end

    const initial: u64[] = []
    const with_entry = initial.push(entry.row)[0]

    const with_rx = loop({
        index: 0,
        roots: with_entry
    }, {
        while: state => state.index < rx_count,
        next: state => {
            state.roots = state.roots.push(ranges.zx_count + state.index)[0]
            state.index += 1
        },
        return: state => state.roots
    })

    const explicit: Explicit = {
        row: 0,
        roots: with_rx
    }

    const with_explicit = loop(explicit, {
        while: state => state.issue == null && state.row < in.explicit_count,
        next: state => {
            const path = memory.readTextColumn(in.explicit, state.row)
            const root = locate({
                ...lookup,
                path,
                missing: missing_root
            })

            if (root.issue != null) {
                state.issue = root.issue
            } else {
                state.roots = state.roots.push(root.row)[0]
                state.row += 1
            }
        }
    })

    if (with_explicit.issue != null) {
        return {
            additional,
            roots: with_explicit.roots,
            issue: with_explicit.issue
        }
    }

    const roots = loop({
        index: 0,
        roots: with_explicit.roots
    }, {
        while: state => state.index < store_count,
        next: state => {
            state.roots = state.roots.push(ranges.rx_end + state.index)[0]
            state.index += 1
        },
        return: state => state.roots
    })

    return {
        additional,
        roots
    }
}
