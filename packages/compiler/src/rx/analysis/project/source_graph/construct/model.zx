import type { PathAllocator } from "lexical_path"
import type { Allocator, TextColumn } from "memory"
import type { GraphConstruction, GraphVisit } from "rx_graph_host"
import type { Ranges as SourceRanges } from "../source"

export type Ranges = SourceRanges & {
    end: u64
}

export type Registration = {
    target: GraphConstruction,
    ranges: Ranges,
    root: string,
    capacity: u64,
    paths: SourcePaths,
    path_allocator: PathAllocator
}

export type SourcePaths = {
    zx: TextColumn,
    rx: TextColumn,
    stores: TextColumn
}

export type Index = {
    keys: string[],
    buckets: u64[]
}

export type RootPaths = Registration.Pick("target", "ranges", "root") & {
    index: Index,
    explicit: TextColumn,
    explicit_count: u64,
    entry: string,
    temporary: Allocator,
    include_rx: bool
}

export type Input = Registration & RootPaths.Omit("index") & {
    visit: GraphVisit,
    retain_parses: bool,
    retain_dependencies: bool
}

export type Dependencies = {
    starts: u64[],
    ends: u64[],
    targets: u64[]
}

export type Output = {
    entry: u64,
    roots: u64[],
    additional: u64,
    order: u64[],
    count: u64,
    batch_ends: u64[],
    dependencies?: Dependencies,
    retain_parses: bool
}
