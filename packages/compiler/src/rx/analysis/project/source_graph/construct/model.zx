import type { Table } from "core/bytes/index/fixed"
import type { Allocator, TextColumn, U64Buffer } from "memory"
import type { GraphConstruction } from "rx_graph_host"
import type { Ranges as SourceRanges } from "../source"

export type Ranges = SourceRanges & {
    end: u64
}

export type Registration = {
    target: GraphConstruction,
    ranges: Ranges,
    root: string,
    index: Table,
    paths: SourcePaths,
    normalized: string[]
}

export type SourcePaths = {
    zx: TextColumn,
    rx: TextColumn,
    stores: TextColumn
}

export type RootPaths = Registration & {
    explicit: TextColumn,
    explicit_count: u64,
    entry: string,
    roots: U64Buffer,
    allocator: Allocator,
    include_rx: bool
}

export type Input = RootPaths & {
    retain_parses: bool
}
