import type { TextColumn } from "memory"
import type { Cycle } from "../model"
import type { Ranges as SourceRanges } from "../source"

export type Ranges = SourceRanges & {
    end: u64
}

export type Registration = {
    ranges: Ranges,
    root: string,
    capacity: u64,
    paths: SourcePaths
}

export type SourcePaths = {
    zx: TextColumn,
    rx: TextColumn,
    stores: TextColumn
}

export type Index = {
    keys: string[],
    buckets: u64[]
}

export type RootPaths = Registration.Pick("ranges", "root") & {
    index: Index,
    explicit: TextColumn,
    explicit_count: u64,
    entry: string,
    include_rx: bool
}

export type Input = Registration & RootPaths.Omit("index") & {
    setup?: Setup,
    retain_parses: bool,
    retain_dependencies: bool
}

export type Setup = Index & {
    roots: u64[],
    additional: u64
}

export type Dependencies = {
    starts: u64[],
    ends: u64[],
    targets: u64[]
}

export type PathIssue = {
    row: u64,
    normalized?: string,
    message: string
}

export type RootIssue = {
    path: string,
    message: string
}

export type Output = {
    graph?: Graph,
    setup?: Setup,
    path_issue?: PathIssue,
    root_issue?: RootIssue,
    cycle?: Cycle
}

export type Graph = {
    entry: u64,
    roots: u64[],
    additional: u64,
    order: u64[],
    count: u64,
    batch_ends: u64[],
    dependencies?: Dependencies,
    retain_parses: bool
}
