<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Input} out={Graph.Output} />

    <If on={$in.setup != null}>
        <Call
            module="../scan/visit"
            in={{
                ...$in.ranges,
                target: $in.visit,
                roots: $in.setup.roots
            }}
        />

        <Call
            module="../schedule"
            in={{
                offsets: $ctx.visit.starts,
                ends: $ctx.visit.ends,
                targets: $ctx.visit.targets,
                roots: $in.setup.roots
            }}
        />

        <If on={$ctx.schedule.cycle != null}>
            <Return
                value={{
                    cycle: {
                        owner: $ctx.schedule.cycle.owner,
                        edge: $ctx.schedule.cycle.edge -
                            $ctx.visit.starts[$ctx.schedule.cycle.owner]
                    }
                }}
            />
        </If>

        <Return
            value={{
                graph: {
                    entry: $in.setup.roots[0],
                    roots: $in.setup.roots,
                    additional: $in.setup.additional,
                    order: $ctx.schedule.order,
                    count: $ctx.schedule.count,
                    batch_ends: $ctx.schedule.batch_ends,
                    retain_parses: $in.retain_parses,
                    dependencies: $in.retain_dependencies ? $ctx.visit : null
                }
            }}
        />
    </If>

    <Call
        fn="register"
        in={$in.pick([
            "ranges",
            "root",
            "capacity",
            "paths"
        ])}
    />

    <If on={$ctx.register.issue != null}>
        <Return
            value={{
                path_issue: $ctx.register.issue
            }}
        />
    </If>

    <Call
        fn="roots"
        in={{
            ...$in.pick([
                "root",
                "ranges",
                "explicit",
                "explicit_count",
                "entry",
                "include_rx"
            ]),
            index: $ctx.register.pick([
                "keys",
                "buckets"
            ])
        }}
    />

    <If on={$ctx.roots.issue != null}>
        <Return
            value={{
                root_issue: $ctx.roots.issue
            }}
        />
    </If>

    <Return
        value={{
            setup: {
                keys: $ctx.register.keys,
                buckets: $ctx.register.buckets,
                roots: $ctx.roots.roots,
                additional: $ctx.roots.additional
            }
        }}
    />
</Module>
