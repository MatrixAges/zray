<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Input} out={Graph.Output} />

    <Call
        fn="register"
        in={$in.pick([
            "ranges",
            "root",
            "capacity",
            "paths",
            "path_allocator"
        ])}
    />

    <If on={$ctx.register.issue != null}>
        <Return
            value={{
                path_issue: $ctx.register.issue
            }}
        />
    </If>

    <Call
        fn="roots"
        in={{
            ...$in.pick([
                "root",
                "ranges",
                "explicit",
                "explicit_count",
                "entry",
                "temporary",
                "include_rx"
            ]),
            index: $ctx.register.pick([
                "keys",
                "buckets"
            ])
        }}
    />

    <If on={$ctx.roots.issue != null}>
        <Return
            value={{
                root_issue: $ctx.roots.issue
            }}
        />
    </If>

    <Call
        fn="host.openSourceGraphScanner"
        in={[
            $in.visit,
            $ctx.register.keys,
            $ctx.register.buckets
        ]}
    />

    <Call
        module="../scan/visit"
        in={{
            ...$in.ranges,
            target: $in.visit,
            roots: $ctx.roots.roots
        }}
    />

    <Call
        fn="host.finishSourceGraphScan"
        in={[
            $in.visit,
            $in.retain_parses
        ]}
    />

    <Call
        fn="adjacency"
        in={{
            starts: $ctx.visit.starts,
            ends: $ctx.visit.ends,
            targets: $ctx.finishSourceGraphScan
        }}
    />

    <Call
        module="../schedule"
        in={{
            offsets: $ctx.adjacency.starts,
            ends: $ctx.adjacency.ends,
            targets: $ctx.adjacency.targets,
            roots: $ctx.roots.roots
        }}
    />

    <If on={$ctx.schedule.cycle != null}>
        <Return
            value={{
                cycle: {
                    owner: $ctx.schedule.cycle.owner,
                    edge: $ctx.schedule.cycle.edge -
                        $ctx.adjacency.starts[$ctx.schedule.cycle.owner]
                }
            }}
        />
    </If>

    <Return
        value={{
            graph: {
                entry: $ctx.roots.roots[0],
                roots: $ctx.roots.roots,
                additional: $ctx.roots.additional,
                order: $ctx.schedule.order,
                count: $ctx.schedule.count,
                batch_ends: $ctx.schedule.batch_ends,
                retain_parses: $in.retain_parses,
                dependencies: $in.retain_dependencies ? $ctx.adjacency : null
            }
        }}
    />
</Module>
