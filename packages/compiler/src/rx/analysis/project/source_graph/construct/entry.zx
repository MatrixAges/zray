import bytes from "std:bytes"

import resolve from "../resolve_path"
import probe from "./probe"

import type { RootIssue, RootPaths } from "./model"

export type Input = RootPaths.Pick("index", "root") & {
    path: string,
    missing: string
}

export type Output = {
    row: u64,
    issue?: RootIssue
}

export default function (in: Input): Output {
    const path = resolve(in.pick([
        "root",
        "path"
    ]))

    const row = match {
        in.index.buckets.length == 0 => 0,
        _ => in.index
            .buckets[probe({
                index: in.index,
                key: bytes.fromText(path)
            })]
    }

    if (row == 0) {
        return {
            row: 0,
            issue: {
                path,
                message: in.missing
            }
        }
    }

    return {
        row: row - 1
    }
}
