import bytes from "std:bytes"
import memory from "memory"
import { rejectSourceGraphRoot } from "rx_graph_host"

import resolve from "../../../../../zx/modules/project/target/package/path"
import probe from "./probe"

import type { Allocator } from "memory"
import type { RootPaths } from "./model"

export type Input = RootPaths.Pick("target", "index", "root") & {
    allocator: Allocator,
    path: string,
    missing: string
}

export type Output = u64

export default function (in: Input): Output {
    const path = resolve(in.pick([
        "root",
        "path"
    ]))

    const row = match {
        in.index.buckets.length == 0 => 0,
        _ => in.index
            .buckets[probe({
                index: in.index,
                key: bytes.fromText(path)
            })]
    }

    if (row == 0) {
        return rejectSourceGraphRoot(in.target, path, in.missing)
    }

    memory.freeOwnedText(in.allocator, path)

    return row - 1
}
