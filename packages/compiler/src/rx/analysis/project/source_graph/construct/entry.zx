import bytes from "std:bytes"
import memory from "memory"

import resolve from "../../../../../zx/modules/project/target/package/path"
import probe from "./probe"

import type { Allocator } from "memory"
import type { RootIssue, RootPaths } from "./model"

export type Input = RootPaths.Pick("index", "root") & {
    allocator: Allocator,
    path: string,
    missing: string
}

export type Output = {
    row: u64,
    issue?: RootIssue
}

export default function (in: Input): Output {
    const path = resolve(in.pick([
        "root",
        "path"
    ]))

    const row = match {
        in.index.buckets.length == 0 => 0,
        _ => in.index
            .buckets[probe({
                index: in.index,
                key: bytes.fromText(path)
            })]
    }

    if (row == 0) {
        return {
            row: 0,
            issue: {
                path,
                message: in.missing
            }
        }
    }

    memory.freeOwnedText(in.allocator, path)

    return {
        row: row - 1
    }
}
