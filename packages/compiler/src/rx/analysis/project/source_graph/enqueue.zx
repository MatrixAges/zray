import type { Frontier, Queue } from "./frontier/model"

export type Input = Queue

export type Output = Frontier

export default function (in: Input): Output {
    const { targets } = in

    return loop({
        seen: in.seen,
        queue: in.queue,
        cursor: in.first,
        end: in.end
    }, {
        while: state => state.cursor < targets.length,
        next: state => {
            const target = targets[state.cursor]

            if (!state.seen[target]) {
                state.seen[target] = true
                state.queue[state.end] = target
                state.end += 1
            }

            state.cursor += 1
        },
        return: state => ({
            seen: state.seen,
            queue: state.queue,
            end: state.end
        })
    })
}
