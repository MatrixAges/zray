<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.State} out={Visit.State} />

    <Store from="dependencies" as="dependencies" />

    <Call
        fn="../source"
        in={{
            owner: $in.owner ?? 0,
            sources: $in.sources
        }}
    />

    <Call fn="stage" setter={[$store.dependencies.publication]} />

    <Call fn="targets" in={$store.dependencies.publication} />

    <Call
        fn="../frontier/publish"
        in={{
            starts: $in.starts,
            ends: $in.ends,
            owner: $ctx.source.owner,
            edge_start: $in.edge_end,
            edge_end: $ctx.targets.length
        }}
    />

    <Call
        fn="../enqueue"
        in={{
            seen: $in.seen,
            queue: $in.queue,
            end: $in.end,
            targets: $ctx.targets,
            first: $in.edge_end
        }}
    />

    <Call
        fn="../frontier/select"
        in={{
            queue: $ctx.enqueue.queue,
            cursor: $in.cursor,
            end: $ctx.enqueue.end
        }}
    />

    <Return
        value={{
            sources: $in.sources,
            starts: $ctx.publish.starts,
            ends: $ctx.publish.ends,
            ...$ctx.enqueue,
            ...$ctx.select,
            edge_end: $ctx.targets.length
        }}
    />
</Module>
