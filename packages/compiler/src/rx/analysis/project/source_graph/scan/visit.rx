<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.Input} out={Visit.Output} />

    <Call fn="../frontier/init" in={$in.end} />

    <Call
        fn="../enqueue"
        in={{
            seen: $ctx.init.seen,
            queue: $ctx.init.queue,
            end: 0,
            targets: $in.roots,
            first: 0
        }}
    />

    <Call
        fn="../frontier/select"
        in={{
            queue: $ctx.enqueue.queue,
            cursor: 0,
            end: $ctx.enqueue.end
        }}
    />

    <Call fn="../zeroes" in={0} />

    <Loop on={$in.owner != null}>
        <Call
            module="advance"
            in={{
                request: $in.pick([
                    "target",
                    "zx_count",
                    "rx_end"
                ]),
                starts: $ctx.init.starts,
                ends: $ctx.init.ends,
                ...$ctx.enqueue,
                ...$ctx.select,
                targets: $ctx.zeroes
            }}
        />
    </Loop>

    <Return
        value={{
            starts: $ctx.advance.starts,
            ends: $ctx.advance.ends,
            targets: $ctx.advance.targets
        }}
    />
</Module>
