import host from "rx_graph_host"

import type { GraphVisit } from "rx_graph_host"

export type Input = {
    target: GraphVisit,
    zx_count: u64,
    rx_end: u64,
    end: u64
}

export type Output = void

export default function (in: Input): Output {
    const { target } = in

    const visited = loop(host.firstSourceGraphVisit(target), {
        while: owner => owner < in.end,
        next: owner => {
            if (owner < in.zx_count) {
                host.readSourceGraphZX(target, owner)
            } else {
                const is_store = owner >= in.rx_end
                const first = is_store ? in.rx_end : in.zx_count
                host.readSourceGraphRX(target, owner, owner - first, is_store)
            }

            owner = host.finishSourceGraphVisit(target, owner)
        }
    })
}
