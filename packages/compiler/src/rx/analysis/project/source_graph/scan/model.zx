import type { GraphVisit } from "rx_graph_host"
import type { Edges, Frontier, Selection } from "../frontier/model"
import type { Ranges } from "../source"

export type Input = Ranges & {
    end: u64,
    target: GraphVisit,
    roots: u64[]
}

export type Request = Ranges & {
    target: GraphVisit
}

export type State = Frontier & Edges & Selection & {
    request: Request,
    edge_end: u64
}

export type Output = Edges & {
    end: u64
}
