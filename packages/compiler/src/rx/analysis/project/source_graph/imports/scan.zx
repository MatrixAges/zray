import encoding from "std:encoding"
import { GraphReferenceKind } from "rx_graph_host"

import classify from "../../../../../zx/modules/project/target/classify"
import { Route } from "../../../../../zx/modules/project/target/model"
import select from "../../../../../zx/modules/project/target/select"
import { role_dependency } from "../references/const"
import publishImport from "../references/import"
import send from "../references/send"

import type { Imports, Scan } from "../references/model"
import type { Site } from "../references/send"

export type Input = {
    scan: Scan,
    imports: Imports
}

export type Output = void

export default function (in: Input): Output {
    const { scan, imports } = in

    const scanned = loop(0, {
        while: index => index < imports.rows.length,
        next: index => {
            const item = imports.rows[index]
            const span = item.path
            const reference = encoding.sliceBytes(
                imports.source,
                span.start + 1,
                span.end - 1
            )
            const site: Site = {
                offset: item.span.start,
                role: role_dependency
            }

            if (scan.discover) {
                send({
                    target: scan.target,
                    kind: GraphReferenceKind.Import,
                    site,
                    value: reference
                })
            } else {
                const route = classify({
                    path: reference,
                    intrinsic: scan.intrinsic ?? ""
                })

                const selected = match route {
                    Route.Package => select({
                        specifiers: scan.packages,
                        name: reference,
                        check_duplicates: true
                    }),
                    _ => ({
                        first: null,
                        duplicate: false
                    })
                }

                publishImport({
                    target: scan.target,
                    reference,
                    site,
                    route,
                    ...selected
                })
            }

            index += 1
        }
    })
}
