import encoding from "std:encoding"

import { role_dependency } from "../references/const"
import { Kind as DeliveryKind } from "../references/send"
import classifyImport from "./classify"

import type { Imports, Scan } from "../references/model"
import type { ReferenceDelivery, Site } from "../references/send"

export type Input = {
    scan: Scan,
    imports: Imports
}

export type Output = ReferenceDelivery[]

export default function (in: Input): Output {
    const { scan, imports } = in

    const deliveries: ReferenceDelivery[] = []

    return loop({
        index: 0,
        done: false,
        deliveries
    }, {
        while: state => state.index < imports.rows.length && !state.done,
        next: state => {
            const item = imports.rows[state.index]
            const span = item.path
            const reference = encoding.sliceBytes(
                imports.source,
                span.start + 1,
                span.end - 1
            )
            const site: Site = {
                offset: item.span.start,
                role: role_dependency
            }

            const delivery = classifyImport({
                scan,
                reference,
                site
            })

            state.deliveries = state.deliveries.push(delivery)[0]
            state.index += 1
            state.done = delivery.kind == DeliveryKind.Diagnostic
        },
        return: state => state.deliveries
    })
}
