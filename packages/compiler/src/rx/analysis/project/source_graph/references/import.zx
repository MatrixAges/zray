import host from "rx_graph_host"
import { GraphReferenceKind } from "rx_graph_host"

import { Route } from "../../../../../zx/modules/project/target/model"
import { invalid_import } from "./const"
import send from "./send"

import type { GraphEdgeScan } from "rx_graph_host"
import type { Output as Package } from "../../../../../zx/modules/project/target/select"
import type { Selection, Site } from "./send"

export type Input = Package & {
    target: GraphEdgeScan,
    reference: string,
    site: Site,
    route: Route
}

export type Output = void

export default function (in: Input): Output {
    const { target, reference, site, route } = in

    if (route == Route.Invalid) {
        send({
            target,
            kind: GraphReferenceKind.Diagnostic,
            site,
            value: invalid_import
        })

        return
    }

    if (route == Route.Intrinsic || route == Route.Interface) {
        send({
            target,
            kind: GraphReferenceKind.Native,
            site,
            value: reference
        })

        return
    }

    if (route == Route.Package) {
        const internal = host.sourceGraphInternal(target, reference)

        if (internal != null) {
            send({
                target,
                kind: GraphReferenceKind.Native,
                site,
                value: internal
            })

            return
        }
    }

    const selection: Selection? = match {
        route == Route.Package => in.pick([
            "first",
            "duplicate"
        ]),
        _ => null
    }

    send({
        target,
        kind: GraphReferenceKind.Import,
        site,
        value: reference,
        selection
    })
}
