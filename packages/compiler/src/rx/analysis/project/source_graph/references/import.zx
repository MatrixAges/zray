import { Route } from "../../../../../zx/modules/project/target/model"
import findInternal from "../../../../../zx/modules/semantic_cache/discovery/find"
import { invalid_import } from "./const"
import { Kind as DeliveryKind } from "./send"
import send from "./send"

import type { Output as Package } from "../../../../../zx/modules/project/target/select"
import type { Registry } from "../../../../../zx/modules/semantic_cache/discovery/find"
import type { ReferenceDelivery, Selection, Site } from "./send"

export type Input = Package & {
    internal?: Registry,
    reference: string,
    site: Site,
    route: Route
}

export type Output = ReferenceDelivery

export default function (in: Input): Output {
    const { internal, reference, site, route } = in

    if (route == Route.Invalid) {
        return send({
            kind: DeliveryKind.Diagnostic,
            site,
            value: invalid_import
        })
    }

    if (route == Route.Intrinsic || route == Route.Interface) {
        return send({
            kind: DeliveryKind.Native,
            site,
            value: reference
        })
    }

    if (route == Route.Package && internal != null) {
        const name = findInternal({
            registry: internal,
            name: reference
        })

        if (name != null) {
            return send({
                kind: DeliveryKind.Native,
                site,
                value: name
            })
        }
    }

    const selection: Selection? = match {
        route == Route.Package => in.pick([
            "first",
            "duplicate"
        ]),
        _ => null
    }

    return send({
        kind: DeliveryKind.Import,
        site,
        value: reference,
        selection
    })
}
