import type { GraphInternalModules } from "rx_graph_host"
import type { Import } from "../../../../../zx/frontend/parser/imports/model"
import type { Cursor } from "../../../../dependency_graph/reference/tree/model"
import type { Layout } from "../../../../syntax/tree/layout"
import type { Input as Route } from "./route/model"
import type { ReferenceDelivery } from "./send"

export type References = {
    bytes: u8[],
    width: u64,
    node: u64,
    attribute: u64,
    target: u64,
    role: u64,
    package_allowed: u64,
    node_width: u64,
    attribute_width: u64,
    count: u64
}

export type Scan = Route.Pick("packages") & {
    internal?: GraphInternalModules,
    intrinsic?: string,
    discover: bool
}

export type Xml = Route.Pick("directory") & {
    owner: string,
    layout: Layout
}

export type Imports = {
    source: string,
    rows: Import[]
}

export type Input = {
    scan: Scan,
    xml?: Xml,
    indexed?: References,
    cursor?: Cursor,
    imports?: Imports
}

export type Output = ReferenceDelivery[]
