import memory from "memory"
import columns from "memory/columns"

import { Target } from "../../../../dependency_graph/reference/model"
import { target_function, target_module } from "./const"
import deliver from "./deliver"

import type { References, Scan } from "./model"

export type Input = Scan & {
    references: References
}

export type Output = void

export default function (in: Input): Output {
    const { references, workspace } = in

    const scanned = loop({
        next: references.count,
        bytes: workspace.bytes
    }, {
        while: state => state.next != 0,
        next: state => {
            state.next -= 1
            const row = state.next
            const reference =
                columns.readOptionalIndirectTextColumn(references.values, row)
            const code = references.target_codes[row * references.stride]
            const target = match code {
                target_module => Target.Module,
                target_function => Target.Function,
                _ => Target.Store
            }

            state.bytes = deliver({
                directory: in.directory,
                packages: in.packages,
                workspace: {
                    ...workspace,
                    bytes: state.bytes
                },
                target,
                package_allowed: memory.readColumnBool(references.package_allowed, row),
                scan: in.target,
                allocator: in.allocator,
                intrinsic: null,
                delegate_import: in.delegate_import,
                reference,
                site: row
            })
        }
    })
}
