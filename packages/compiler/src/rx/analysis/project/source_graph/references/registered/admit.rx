<Module>
    <Type from="model" as="Registered" />
    <Type from="../../../../../../zx/modules/project/target/scope/check" as="Scope" />

    <Args in={Registered.Input} out={Registered.Output} />

    <Call
        fn="position"
        in={$in.pick([
            "path",
            "index",
            "matched"
        ])}
    />

    <If on={$in.store_start != null}>
        <If on={$ctx.position == null || $ctx.position < $in.store_start}>
            <Return
                value={{
                    row: null,
                    store_missing: true,
                    boundary: Scope.Boundary.Allowed
                }}
            />
        </If>
    </If>

    <Call
        fn="../../../../../../zx/modules/project/target/scope/check"
        in={{
            ...$in.scope,
            path: $in.path
        }}
    />

    <Return
        value={{
            row: $ctx.position,
            store_missing: false,
            boundary: $ctx.check
        }}
    />
</Module>
