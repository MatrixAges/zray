<Module>
    <Type from="model" as="References" />

    <Args in={References.Input} out={References.Output} />

    <If on={$in.xml != null}>
        <If on={$in.indexed != null}>
            <Call
                fn="indexed"
                in={{
                    scan: $in.scan,
                    xml: $in.xml,
                    references: $in.indexed
                }}
            />

            <Return value={$ctx.indexed} />
        </If>

        <If on={$in.cursor != null}>
            <Call
                fn="scan_tree"
                in={{
                    scan: $in.scan,
                    xml: $in.xml,
                    cursor: $in.cursor
                }}
            />

            <Return value={$ctx.scan_tree} />
        </If>

        <Else>
            <If on={$in.imports != null}>
                <Call
                    fn="../imports/scan"
                    in={{
                        scan: $in.scan,
                        imports: $in.imports
                    }}
                />

                <Return value={$ctx.scan} />
            </If>
        </Else>
    </If>

    <Return value={[]} />
</Module>
