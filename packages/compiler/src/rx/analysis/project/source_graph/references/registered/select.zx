import bytes from "std:bytes"

import { module_extension } from "../../../../../../zx/modules/path/const"
import selectSource from "../../../../../../zx/modules/path/select_source"
import resolve from "../../resolve_path"

import type { Allocator } from "memory"
import type { Source } from "./model"

export type Input = {
    source: Source,
    release: Allocator
}

export type Output = {
    path: string,
    matched?: u64,
    named: bool
}

export default function (in: Input): Output {
    const { source, release } = in
    const { root, member_width, selection_index } = source

    if (root == null) {
        return {
            path: source.path,
            matched: source.matched,
            named: false
        }
    }

    const absolute = resolve({
        root,
        path: source.path
    })

    const suffix = match {
        absolute.length < module_extension.length => absolute.length,
        _ => absolute.length - module_extension.length
    }

    const indexed = source.store_start == null &&
        bytes.startsWithText(bytes.fromText(absolute), suffix, module_extension)

    if (member_width == null && !indexed) {
        return {
            path: absolute,
            named: false
        }
    }

    const selected = selectSource({
        path: absolute,
        index: selection_index ?? source.index,
        release,
        member_width
    })

    return {
        path: selected.owned ?? absolute,
        matched: selection_index == null ? selected.row : null,
        named: selected.named
    }
}
