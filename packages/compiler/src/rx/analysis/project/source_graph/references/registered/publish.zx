import {
    crossed_package,
    missing_owner
} from "../../../../../../zx/modules/project/target/const"
import { Boundary } from "../../../../../../zx/modules/project/target/scope/check"
import check from "../../../../../../zx/modules/project/target/scope/check"
import {
    missing_definition,
    missing_source
} from "./const"
import position from "./position"
import select from "./select"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { source } = in

    if (source == null) {
        return {
            ok: true,
            compiled: in.compiled,
            target: null,
            named: false,
            store_error: false,
            message: null
        }
    }

    const selected = select({
        source,
        release: in.release
    })

    const row = position({
        path: selected.path,
        index: source.index,
        matched: selected.matched
    })

    const store_start = source.store_start

    if (store_start != null) {
        if (row == null || row < store_start) {
            return {
                ok: false,
                compiled: false,
                target: null,
                named: false,
                store_error: true,
                message: missing_definition
            }
        }
    }

    const scope = source.scope

    if (scope != null) {
        const boundary = check({
            ...scope,
            path: selected.path
        })

        if (boundary == Boundary.MissingOwner) {
            return {
                ok: false,
                compiled: false,
                target: null,
                named: false,
                store_error: false,
                message: missing_owner
            }
        }

        if (boundary == Boundary.Crossed) {
            return {
                ok: false,
                compiled: false,
                target: null,
                named: false,
                store_error: false,
                message: crossed_package
            }
        }
    }

    if (row == null) {
        return {
            ok: false,
            compiled: false,
            target: null,
            named: false,
            store_error: false,
            message: missing_source
        }
    }

    return {
        ok: true,
        compiled: false,
        target: row,
        named: selected.named,
        store_error: false,
        message: null
    }
}
