import memory from "memory"
import host from "rx_graph_host"

import {
    crossed_package,
    missing_owner
} from "../../../../../../zx/modules/project/target/const"
import { Boundary } from "../../../../../../zx/modules/project/target/scope/check"
import check from "../../../../../../zx/modules/project/target/scope/check"
import {
    missing_definition,
    missing_source
} from "./const"
import position from "./position"
import select from "./select"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { target, source, resources } = in

    if (source == null) {
        const compiled = resources.compiled

        if (compiled != null) {
            memory.writeBool(compiled, 0, true)
        }

        host.appendSourceGraphEdge(target, null, false)

        return
    }

    const selected = select({
        source,
        release: in.release
    })

    const row = position({
        path: selected.path,
        index: source.index,
        matched: selected.matched
    })

    const store_start = source.store_start

    if (store_start != null) {
        if (row == null || row < store_start) {
            host.rejectSourceGraphEdge(target, true, missing_definition)

            return
        }
    }

    const scope = source.scope

    if (scope != null) {
        const boundary = check({
            ...scope,
            path: selected.path
        })

        if (boundary == Boundary.MissingOwner) {
            host.rejectSourceGraphEdge(target, false, missing_owner)

            return
        }

        if (boundary == Boundary.Crossed) {
            host.rejectSourceGraphEdge(target, false, crossed_package)

            return
        }
    }

    if (row == null) {
        host.rejectSourceGraphEdge(target, false, missing_source)

        return
    }

    memory.appendU64(resources.allocator, resources.targets, row)
    host.appendSourceGraphEdge(target, row, selected.named)
}
