import type { Table } from "core/bytes/index/slot"
import type { Allocator, BoolBuffer, TextSlots, U64Storage } from "memory"
import type { GraphEdgePublication } from "rx_graph_host"
import type {
    Input as Scope
} from "../../../../../../zx/modules/project/target/scope/check"

export type Lookup = {
    path: string,
    index: Table,
    matched?: u64
}

export type Source = Lookup & {
    scope?: Scope.Omit("path"),
    store_start?: u64,
    root?: string,
    selection_index?: Table,
    member_width?: u64
}

export type Resources = {
    allocator: Allocator,
    targets: U64Storage,
    compiled?: BoolBuffer
}

export type PathStorage = {
    allocator: Allocator,
    resolved: TextSlots,
    selected: TextSlots
}

export type Input = {
    target: GraphEdgePublication,
    source?: Source,
    resources: Resources,
    owned: PathStorage
}

export type Output = void
