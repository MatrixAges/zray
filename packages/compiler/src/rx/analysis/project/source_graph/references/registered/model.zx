import type { Table } from "core/bytes/index/fixed"
import type { GraphEdgePublication } from "rx_graph_host"
import type {
    Input as Scope
} from "../../../../../../zx/modules/project/target/scope/check"

export type Lookup = {
    path: string,
    index: Table,
    matched?: u64
}

export type Source = Lookup & {
    scope?: Scope.Omit("path"),
    store_start?: u64
}

export type Input = {
    target: GraphEdgePublication,
    source?: Source,
    compiled: bool
}

export type Output = void
