import type { Table } from "core/bytes/index/slot"
import type { Allocator } from "memory"
import type {
    Input as Scope
} from "../../../../../../zx/modules/project/target/scope/check"

export type Lookup = {
    path: string,
    index: Table,
    matched?: u64
}

export type Source = Lookup & {
    scope?: Scope.Omit("path"),
    store_start?: u64,
    root?: string,
    selection_index?: Table,
    member_width?: u64
}

export type Input = {
    source?: Source,
    compiled: bool,
    release: Allocator
}

export type Output = {
    ok: bool,
    compiled: bool,
    target?: u64,
    named: bool,
    store_error: bool,
    message?: string
}
