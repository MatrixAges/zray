import memory from "memory"
import { GraphReferenceKind } from "rx_graph_host"

import classify from "../../../../../zx/modules/project/target/classify"
import { Route as ImportRoute } from "../../../../../zx/modules/project/target/model"
import { Target } from "../../../../dependency_graph/reference/model"
import { invalid_reference, missing_reference, role_call } from "./const"
import publishImport from "./import"
import member from "./member"
import { Kind } from "./route/model"
import resolve from "./route/resolve"
import send from "./send"

import type { Allocator } from "memory"
import type { Scan } from "./model"
import type { Input as Route } from "./route/model"
import type { Site } from "./send"

export type Input = Route.Omit("packages", "reference") & {
    scan: Scan,
    allocator: Allocator,
    owner: string,
    reference?: string,
    site: Site
}

export type Output = u8[]

export default function (in: Input): Output {
    const { scan, reference, site, workspace } = in

    if (reference == null) {
        send({
            target: scan.target,
            kind: GraphReferenceKind.Diagnostic,
            site,
            value: missing_reference
        })

        return workspace.bytes
    }

    const request = {
        ...in.pick([
            "directory",
            "target",
            "package_allowed",
            "workspace"
        ]),
        packages: scan.packages,
        reference
    }

    const first = resolve(request)

    const bytes = match first.kind {
        Kind.NeedSpace => memory.allocateU8Buffer(
            in.allocator,
            workspace.target,
            first.length
        ),
        _ => workspace.bytes
    }

    const route = match first.kind {
        Kind.NeedSpace => resolve({
            ...request,
            workspace: {
                ...workspace,
                bytes
            }
        }),
        _ => first
    }

    switch (route.kind) {
        case Kind.Package:
            const selection = route.pick([
                "first",
                "duplicate"
            ])

            if (scan.discover) {
                send({
                    target: scan.target,
                    kind: GraphReferenceKind.Import,
                    site,
                    value: reference,
                    selection
                })
            } else {
                const intrinsic = scan.intrinsic

                const import_route = match {
                    intrinsic == null => ImportRoute.Package,
                    _ => classify({
                        path: reference,
                        intrinsic
                    })
                }

                publishImport({
                    target: scan.target,
                    reference,
                    site,
                    route: import_route,
                    ...selection
                })
            }
        case Kind.Source:
            const named = site.role == role_call && in.target == Target.Function
            const path = memory.borrowU8Range(bytes, 0, route.length)

            const export_name: string? = match {
                named => member(reference),
                _ => null
            }

            send({
                target: scan.target,
                kind: GraphReferenceKind.Source,
                site,
                path,
                member: export_name
            })
        case Kind.Store:
            send({
                target: scan.target,
                kind: GraphReferenceKind.Store,
                site,
                value: in.owner,
                path: memory.borrowU8Range(bytes, 0, route.length)
            })
        default:
            send({
                target: scan.target,
                kind: GraphReferenceKind.Diagnostic,
                site,
                value: invalid_reference
            })
    }

    return bytes
}
