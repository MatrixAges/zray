import classify from "../../../../../zx/modules/project/target/classify"
import { Route as ImportRoute } from "../../../../../zx/modules/project/target/model"
import { Target } from "../../../../dependency_graph/reference/model"
import { invalid_reference, missing_reference, role_call } from "./const"
import publishImport from "./import"
import member from "./member"
import { Kind } from "./route/model"
import resolve from "./route/resolve"
import { Kind as DeliveryKind } from "./send"
import send from "./send"

import type { Scan } from "./model"
import type { Input as Route } from "./route/model"
import type { ReferenceDelivery, Site } from "./send"

export type Input = Route.Omit("packages", "reference") & {
    scan: Scan,
    owner: string,
    reference?: string,
    site: Site
}

export type Output = ReferenceDelivery

export default function (in: Input): Output {
    const { scan, reference, site } = in

    if (reference == null) {
        return send({
            kind: DeliveryKind.Diagnostic,
            site,
            value: missing_reference
        })
    }

    const route = resolve({
        directory: in.directory,
        target: in.target,
        package_allowed: in.package_allowed,
        packages: scan.packages,
        reference
    })

    switch (route.kind) {
        case Kind.Package:
            const selection = route.pick([
                "first",
                "duplicate"
            ])

            if (scan.discover) {
                return send({
                    kind: DeliveryKind.Import,
                    site,
                    value: reference,
                    selection
                })
            } else {
                const intrinsic = scan.intrinsic

                const import_route = match {
                    intrinsic == null => ImportRoute.Package,
                    _ => classify({
                        path: reference,
                        intrinsic
                    })
                }

                return publishImport({
                    internal: scan.internal,
                    reference,
                    site,
                    route: import_route,
                    ...selection
                })
            }
        case Kind.Source:
            const named = site.role == role_call && in.target == Target.Function

            const export_name: string? = match {
                named => member(reference),
                _ => null
            }

            return send({
                kind: DeliveryKind.Source,
                site,
                path: route.path,
                member: export_name
            })
        case Kind.Store:
            return send({
                kind: DeliveryKind.Store,
                site,
                value: in.owner,
                path: route.path
            })
        default:
            return send({
                kind: DeliveryKind.Diagnostic,
                site,
                value: invalid_reference
            })
    }
}
