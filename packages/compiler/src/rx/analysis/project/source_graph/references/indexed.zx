import memory from "memory"
import columns from "memory/columns"

import { Target } from "../../../../dependency_graph/reference/model"
import { target_function, target_module } from "./const"
import { Kind as DeliveryKind } from "./send"
import deliver from "./xml"

import type { References, Scan, Xml } from "./model"
import type { ReferenceDelivery } from "./send"

export type Input = {
    scan: Scan,
    xml: Xml,
    references: References
}

export type Output = ReferenceDelivery[]

export default function (in: Input): Output {
    const { references, xml, scan } = in

    const deliveries: ReferenceDelivery[] = []

    return loop({
        remaining: references.count,
        done: false,
        deliveries
    }, {
        while: state => state.remaining != 0 && !state.done,
        next: state => {
            const row_index = state.remaining - 1
            const start = row_index * references.width
            const row = memory.borrowU8Range(references.bytes, start, references.width)
            const attribute = columns.readBorrowedRowReference(
                row,
                references.attribute,
                references.attribute_width
            )
            const node: u8[]? = match {
                attribute == null => columns.readBorrowedRowReference(
                    row,
                    references.node,
                    references.node_width
                ),
                _ => null
            }
            const target = match row[references.target] {
                target_module => Target.Module,
                target_function => Target.Function,
                _ => Target.Store
            }

            const delivery = deliver({
                scan,
                xml,
                node,
                attribute,
                target,
                role: row[references.role],
                package_allowed: row[references.package_allowed] != 0
            })

            state.deliveries = state.deliveries.push(delivery)[0]
            state.remaining = row_index
            state.done = delivery.kind == DeliveryKind.Diagnostic
        },
        return: state => state.deliveries
    })
}
