export enum Kind {
    Diagnostic,
    Source,
    Store,
    Import,
    Native
}

export type Site = {
    location?: u8[],
    offset: u64,
    role: u8
}

export type Selection = {
    first?: u64,
    duplicate: bool
}

export type Input = {
    kind: Kind,
    site: Site,
    value?: string,
    member?: string,
    path?: u8[],
    selection?: Selection
}

export type ReferenceDelivery = Input.Omit("site", "selection") & Site & {
    package_route: bool,
    first?: u64,
    duplicate: bool
}

export type Output = ReferenceDelivery

export default function (in: Input): Output {
    const { site, selection } = in

    return {
        ...in.omit([
            "site",
            "selection"
        ]),
        ...site,
        package_route: selection != null,
        first: selection == null ? null : selection.first,
        duplicate: selection != null && selection.duplicate
    }
}
