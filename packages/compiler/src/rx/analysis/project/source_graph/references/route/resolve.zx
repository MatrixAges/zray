import select from "../../../../../../zx/modules/project/target/select"
import resolve from "../../../../../path_segments/reference/resolve"
import { Kind } from "./model"
import pathKind from "./path_kind"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    if (in.package_allowed && in.packages.length != 0) {
        const found = select({
            specifiers: in.packages,
            name: in.reference,
            check_duplicates: true
        })

        if (found.first != null) {
            return {
                kind: Kind.Package,
                first: found.first,
                duplicate: found.duplicate,
                path: []
            }
        }
    }

    const placement = pathKind(in.target)

    const resolved = resolve({
        kind: placement.path,
        directory: in.directory,
        reference: in.reference
    })

    const kind = resolved.valid ? placement.destination : Kind.Invalid

    return {
        kind,
        first: null,
        duplicate: false,
        path: resolved.path
    }
}
