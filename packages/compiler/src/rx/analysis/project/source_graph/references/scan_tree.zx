import { Role } from "../../../../dependency_graph/reference/model"
import next from "../../../../dependency_graph/reference/tree/next"
import { role_call, role_dependency, role_type_import } from "./const"
import { Kind as DeliveryKind } from "./send"
import deliver from "./xml"

import type { Cursor } from "../../../../dependency_graph/reference/tree/model"
import type { Scan, Xml } from "./model"
import type { ReferenceDelivery } from "./send"

export type Input = {
    scan: Scan,
    xml: Xml,
    cursor: Cursor
}

export type Output = ReferenceDelivery[]

export default function (in: Input): Output {
    const { cursor, scan, xml } = in

    const deliveries: ReferenceDelivery[] = []

    return loop({
        pending: cursor.pending,
        done: false,
        deliveries
    }, {
        while: state => !state.done,
        next: state => {
            const step = next({
                cursor: {
                    ...cursor,
                    pending: state.pending
                },
                graph_only: false,
                skip: 0
            })

            state.pending = step.pending
            const item = step.reference

            if (item == null) {
                state.done = true
            } else {
                const role = match item.role {
                    Role.Call => role_call,
                    Role.TypeImport => role_type_import,
                    _ => role_dependency
                }

                const delivery = deliver({
                    scan,
                    xml,
                    node: item.node,
                    attribute: item.attribute,
                    target: item.target,
                    role,
                    package_allowed: item.package_allowed
                })

                state.deliveries = state.deliveries.push(delivery)[0]
                state.done = delivery.kind == DeliveryKind.Diagnostic
            }
        },
        return: state => state.deliveries
    })
}
