import { Role } from "../../../../dependency_graph/reference/model"
import next from "../../../../dependency_graph/reference/tree/next"
import { role_call, role_dependency, role_type_import } from "./const"
import deliver from "./xml"

import type { Cursor } from "../../../../dependency_graph/reference/tree/model"
import type { Scan, Xml } from "./model"

export type Input = {
    scan: Scan,
    xml: Xml,
    cursor: Cursor
}

export type Output = void

export default function (in: Input): Output {
    const { cursor, scan, xml } = in

    const scanned = loop({
        pending: cursor.pending,
        bytes: xml.workspace.bytes,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const step = next({
                cursor: {
                    ...cursor,
                    pending: state.pending
                },
                graph_only: false,
                skip: 0
            })

            state.pending = step.pending
            const item = step.reference

            if (item == null) {
                state.done = true
            } else {
                const role = match item.role {
                    Role.Call => role_call,
                    Role.TypeImport => role_type_import,
                    _ => role_dependency
                }

                state.bytes = deliver({
                    scan,
                    xml,
                    bytes: state.bytes,
                    node: item.node,
                    attribute: item.attribute,
                    target: item.target,
                    role,
                    package_allowed: item.package_allowed
                })
            }
        }
    })
}
