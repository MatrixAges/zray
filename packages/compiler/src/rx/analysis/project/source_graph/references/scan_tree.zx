import columns from "memory/columns"
import host from "rx_graph_host"

import { Role, Target } from "../../../../dependency_graph/reference/model"
import next from "../../../../dependency_graph/reference/tree/next"
import { tree_reference_site } from "./const"
import deliver from "./deliver"

import type { Cursor } from "../../../../dependency_graph/reference/tree/model"
import type { Scan } from "./model"

export type Input = Scan & {
    cursor: Cursor,
    attribute_value: u64,
    intrinsic: string
}

export type Output = void

export default function (in: Input): Output {
    const { cursor, workspace } = in

    const scanned = loop({
        pending: cursor.pending,
        bytes: workspace.bytes,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const step = next({
                cursor: {
                    ...cursor,
                    pending: state.pending
                },
                graph_only: false,
                skip: 0
            })

            state.pending = step.pending
            const item = step.reference

            if (item == null) {
                state.done = true
            } else {
                host.bindSourceGraphTreeReference(
                    in.target,
                    item.node,
                    item.attribute,
                    item.target == Target.Function,
                    item.role == Role.Call,
                    item.role == Role.TypeImport
                )

                const attribute = item.attribute
                const reference: string? = match {
                    attribute == null => null,
                    _ => columns.readBorrowedRowText(attribute, in.attribute_value)
                }

                state.bytes = deliver({
                    directory: in.directory,
                    packages: in.packages,
                    workspace: {
                        ...workspace,
                        bytes: state.bytes
                    },
                    target: item.target,
                    package_allowed: item.package_allowed,
                    scan: in.target,
                    allocator: in.allocator,
                    intrinsic: in.intrinsic,
                    delegate_import: in.delegate_import,
                    reference,
                    site: tree_reference_site
                })
            }
        }
    })
}
