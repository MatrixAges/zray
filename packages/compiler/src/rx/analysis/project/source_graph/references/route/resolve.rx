<Module>
    <Type from="model" as="Route" />
    <Type from="../../../../../path_segments/reference/model" as="Path" />

    <Args in={Route.Input} out={Route.Output} />

    <If on={$in.package_allowed && $in.packages.length != 0}>
        <Call
            fn="../../../../../../zx/modules/project/target/select"
            in={{
                specifiers: $in.packages,
                name: $in.reference,
                check_duplicates: true
            }}
        />

        <If on={$ctx.select.first != null}>
            <Return
                value={{
                    kind: Route.Kind.Package,
                    first: $ctx.select.first,
                    duplicate: $ctx.select.duplicate,
                    length: 0
                }}
            />
        </If>
    </If>

    <Call fn="path_kind" in={$in.target} />

    <Call
        module="../../../../../path_segments/reference/resolve"
        in={{
            ...$in.pick([
                "directory",
                "reference",
                "workspace"
            ]),
            kind: $ctx.path_kind.path
        }}
    />

    <If on={$ctx.resolve.state == Path.State.Invalid}>
        <Return
            value={{
                kind: Route.Kind.Invalid,
                first: null,
                duplicate: false,
                length: 0
            }}
        />
    </If>

    <If on={$ctx.resolve.state == Path.State.NeedSpace}>
        <Return
            value={{
                kind: Route.Kind.NeedSpace,
                first: null,
                duplicate: false,
                length: $ctx.resolve.length
            }}
        />
    </If>

    <Return
        value={{
            kind: $ctx.path_kind.destination,
            first: null,
            duplicate: false,
            length: $ctx.resolve.length
        }}
    />
</Module>
