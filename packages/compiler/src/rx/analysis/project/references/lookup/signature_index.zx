import { i64_positive_magnitude, max_u64 } from "core/const"

import type { Index as Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    if (in.owner >= in.indices.length) {
        return null
    }

    const stored = in.indices[in.owner]

    if (stored == 0) {
        return null
    }

    const has_store = stored > i64_positive_magnitude

    return has_store ? max_u64 - stored : stored - 1
}
