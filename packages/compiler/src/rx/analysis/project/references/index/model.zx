import type { TextColumn } from "memory"
import type { Input as Forward } from "../forward"

export type Signatures = {
    count: u64,
    sources: u64[],
    word_stride: u64,
    byte_stride: u64,
    store: u8[],
    deferred: u8[],
    paths: TextColumn
}

export type ForwardUpdate = {
    row: u64,
    encoded: u64
}

export type Input = {
    modules: Signatures,
    start: u64,
    indices: u64[],
    with_forwards: bool,
    forwarding: Forward.Omit("path")
}

export type Output = {
    row: u64,
    indices: u64[],
    forwards: ForwardUpdate[]
}
