import bytes from "std:bytes"
import probe from "core/bytes/index/slot"

import source from "../source_graph/source"
import { Kind } from "../source_graph/source"

import type { U64View } from "memory"
import type { Ranges } from "../source_graph/source"

export type Input = {
    keys: u8[][],
    buckets: U64View,
    capacity: u64,
    path: string,
    sources: Ranges
}

export type Output = u64?

export default function (in: Input): Output {
    if (in.capacity == 0) {
        return null
    }

    const found = probe({
        keys: in.keys,
        buckets: in.buckets,
        capacity: in.capacity,
        key: bytes.fromText(in.path)
    })

    if (found.entry == 0) {
        return null
    }

    const target = source({
        sources: in.sources,
        owner: found.entry - 1
    })

    return target.kind == Kind.RX ? target.row : null
}
