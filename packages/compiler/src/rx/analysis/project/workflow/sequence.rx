<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Phase} out={Workflow.Step[]} />

    <Switch on={$in}>
        <Case value={Workflow.Phase.Window}>
            <Return
                value={[
                    Workflow.Step.PrepareWindow,
                    Workflow.Step.RestorePrefix,
                    Workflow.Step.DispatchBody,
                    Workflow.Step.RecordBody
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.Finish}>
            <Return
                value={[
                    Workflow.Step.MaterializeOutput,
                    Workflow.Step.PublishExports,
                    Workflow.Step.RetainHistory
                ]}
            />
        </Case>
    </Switch>
</Module>
