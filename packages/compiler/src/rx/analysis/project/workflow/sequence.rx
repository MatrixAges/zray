<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Phase} out={Workflow.Step[]} />

    <Switch on={$in}>
        <Case value={Workflow.Phase.FreshProject}>
            <Return
                value={[
                    Workflow.Step.NormalizeSources,
                    Workflow.Step.DeriveFrame,
                    Workflow.Step.CompileBodies,
                    Workflow.Step.PublishStores
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.RetainedProject}>
            <Return
                value={[
                    Workflow.Step.NormalizeSources,
                    Workflow.Step.RestoreFrame,
                    Workflow.Step.CompileBodies,
                    Workflow.Step.RetainStores
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.Derive}>
            <Return
                value={[
                    Workflow.Step.PrepareModules,
                    Workflow.Step.CollectGraph,
                    Workflow.Step.OrderSignatures,
                    Workflow.Step.ReadSignatures,
                    Workflow.Step.IndexSignatures,
                    Workflow.Step.LoadStores,
                    Workflow.Step.PrepareFlow,
                    Workflow.Step.SolveFlow,
                    Workflow.Step.CompleteShortcuts,
                    Workflow.Step.PublishFrame
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.Solve}>
            <Return
                value={[
                    Workflow.Step.CollectConstraints,
                    Workflow.Step.FinishConstraints,
                    Workflow.Step.ResolveConstraints
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.Window}>
            <Return
                value={[
                    Workflow.Step.PrepareWindow,
                    Workflow.Step.RestorePrefix,
                    Workflow.Step.DispatchBody,
                    Workflow.Step.RecordBody
                ]}
            />
        </Case>

        <Case value={Workflow.Phase.Finish}>
            <Return
                value={[
                    Workflow.Step.MaterializeOutput,
                    Workflow.Step.PublishExports,
                    Workflow.Step.RetainHistory
                ]}
            />
        </Case>
    </Switch>
</Module>
