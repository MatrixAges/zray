<Module>
    <Type from="model" as="Shortcut" />
    <Type from="effect" as="Effect" />

    <Args in={Shortcut.Deferred} out={Shortcut.Deferred} />

    <Store from="derivation" as="derivation" />

    <Call
        fn="columns.readColumnBool"
        in={[
            $in.shortcuts,
            $in.row
        ]}
    />

    <If on={$ctx.readColumnBool}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.CompleteShortcut,
                row: $in.row
            }}
            setter={[$store.derivation.effect]}
        />
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
