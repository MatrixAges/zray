<Module>
    <Type from="model" as="Derivation" />

    <Args in={Derivation.Resolve} out={void} />

    <Call fn="host.solveDerivedFlow" in={$in.state} />
    <Call fn="host.columnLength" in={$in.shortcuts} />

    <Loop on={$in.row < $in.count}>
        <Call
            module="complete"
            in={{
                ...$in.pick([
                    "state",
                    "shortcuts"
                ]),
                count: $ctx.columnLength,
                row: 0
            }}
        />
    </Loop>

    <Call fn="host.publishDerivedFrame" in={$in.state} />
</Module>
