<Module>
    <Type from="../" as="Workflow" />

    <Args in={Workflow.Derivation} out={void} />

    <Call fn="../../workflow.prepareModules" in={$in} />
    <Call fn="../../workflow.collectGraph" in={$in} />
    <Call fn="../../workflow.orderSignatures" in={$in} />
    <Call fn="../../workflow.reuseSignatures" in={$in} />

    <If on={!$ctx.reuseSignatures}>
        <Call fn="../../workflow.loadSignatures" in={$in} />
    </If>

    <Call fn="../../workflow.indexSignatures" in={$in} />
    <Call fn="../../workflow.loadStoreRegistry" in={$in} />
    <Call fn="../../workflow.prepareFlow" in={$in} />
    <Call fn="../../workflow.solveFlow" in={$in} />
    <Call fn="../../workflow.completeShortcuts" in={$in} />
    <Call fn="../../workflow.publishFrame" in={$in} />
</Module>
