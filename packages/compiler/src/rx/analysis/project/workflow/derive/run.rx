<Module>
    <Type from="model" as="Derivation" />

    <Args in={Derivation.Input} out={void} />

    <Call fn="host.prepareDerivedModules" in={$in.state} />
    <Call fn="host.collectDerivedGraph" in={$in.state} />

    <Call module="signatures/read" in={$in.omit(["shortcuts"])} />

    <Call fn="host.loadDerivedStores" in={$in.state} />
    <Call fn="host.prepareDerivedFlow" in={$in.state} />

    <Call module="resolve" in={$in.omit(["retained"])} />
</Module>
