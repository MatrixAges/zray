<Module>
    <Type from="../" as="Workflow" />

    <Args in={Workflow.Derivation} out={void} />

    <Call fn="../" export="prepareModules" in={$in} />
    <Call fn="../" export="collectGraph" in={$in} />
    <Call fn="../" export="orderSignatures" in={$in} />
    <Call fn="../" export="reuseSignatures" in={$in} />

    <If on={!$ctx.reuseSignatures}>
        <Call fn="../" export="loadSignatures" in={$in} />
    </If>

    <Call fn="../" export="indexSignatures" in={$in} />
    <Call fn="../" export="loadStoreRegistry" in={$in} />
    <Call fn="../" export="prepareFlow" in={$in} />
    <Call fn="../" export="solveFlow" in={$in} />
    <Call fn="../" export="completeShortcuts" in={$in} />
    <Call fn="../" export="publishFrame" in={$in} />
</Module>
