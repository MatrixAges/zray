export type Inference = opaque

export type Derivation = opaque

export type Solver = opaque

export type Mixed = opaque

export type MixedPreparation = opaque

export type MixedWorker = opaque

export type MixedCallees = opaque

export type ImportedCallee = {
    function_id?: u32,
    setter: bool,
    has_stores: bool,
    orchestration: bool
}

export type HistoryStores = opaque

export type HistoryParseCache = opaque

export type HistoryFunctionRange = opaque

export type HistoryModuleLink = opaque

export type HistoryXmlNode = opaque

export type HistoryXmlRows = opaque

export type HistoryXmlAttribute = opaque

export type HistoryXmlText = opaque

export enum HistoryXmlPart {
    Attributes,
    Children,
    Text
}

export enum MixedAction {
    Exhausted,
    Skip,
    MissingSignature,
    AnalyzeZX,
    LowerRX
}

export declare function normalizeProjectSources(state: Inference): void
    throws { OutOfMemory, InvalidSource }

export declare function restoreDerivedFrame(state: Inference): void

export declare function deriveProjectFrame(state: Inference, signatures: bool): void
    throws { OutOfMemory, InvalidSource }

export declare function compileProjectBodies(state: Inference): void
    throws { OutOfMemory, InvalidSource }

export declare function publishInferredStores(state: Inference, retained: bool): void
    throws { OutOfMemory, InvalidSource }

export declare function prepareDerivedModules(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function collectDerivedGraph(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function orderDerivedSignatures(state: Derivation): void
    throws { OutOfMemory }

export declare function restoreDerivedSignatures(state: Derivation): bool

export declare function analyzeDerivedSignatures(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function indexDerivedSignatures(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function loadDerivedStores(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function prepareDerivedFlow(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function solveDerivedFlow(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function completeDerivedShortcuts(state: Derivation): void
    throws { OutOfMemory, InvalidSource }

export declare function publishDerivedFrame(state: Derivation): void

export declare function collectFlowConstraints(state: Solver): void
    throws { OutOfMemory, InvalidSource }

export declare function finishFlowConstraints(state: Solver): void
    throws { OutOfMemory, InvalidSource }

export declare function resolveFlowConstraints(state: Solver): void
    throws { OutOfMemory, InvalidSource }

export declare function mixedBatchEnd(state: Mixed, batch: u64): u64

export declare function prefetchMixedWindow(state: Mixed, first: u64, end: u64): u64
    throws { OutOfMemory }

export declare function restoreMixedPrefix(state: Mixed, first: u64, limit: u64): u64
    throws { OutOfMemory }

export declare function selectMixedBody(state: Mixed, first: u64, limit: u64): MixedAction

export declare function rejectMixedBody(state: Mixed): u64
    throws { InvalidSourceGraph }

export declare function linkPreparedMixedZX(state: Mixed): u64?
    throws { OutOfMemory, InvalidSourceGraph }

export declare function analyzeMixedZX(state: Mixed): u64
    throws { OutOfMemory, InvalidSourceGraph }

export declare function linkPreparedMixedRX(state: Mixed): u64?
    throws { OutOfMemory, InvalidSourceGraph }

export declare function lowerMixedRX(state: Mixed): u64
    throws { OutOfMemory, InvalidSourceGraph }

export declare function skipMixedBody(state: Mixed): u64

export declare function recordMixedBody(state: Mixed): void

export declare function materializeMixedModule(state: Mixed): void
    throws { OutOfMemory, InvalidSourceGraph }

export declare function publishMixedExports(state: Mixed): void
    throws { OutOfMemory, InvalidSourceGraph }

export declare function retainMixedHistory(state: Mixed): void

export declare function reserveMixedWorkers(state: MixedPreparation): u64
    throws { OutOfMemory }

export declare function prepareMixedPosition(
    state: MixedPreparation,
    position: u64,
    index: u64,
    is_zx: bool
): bool throws { OutOfMemory }

export declare function preparedMixedPositions(state: MixedPreparation): u64[]

export declare function preparedMixedIsZX(worker: MixedWorker, row: u64): bool

export declare function runPreparedMixedZX(worker: MixedWorker, row: u64): void

export declare function runPreparedMixedRX(worker: MixedWorker, row: u64): void

export declare function importMixedCallee(
    binding: MixedCallees,
    position: u64,
    target: u64
): ImportedCallee throws { OutOfMemory, InvalidSourceGraph }

export declare function compileMixedSetter(
    binding: MixedCallees,
    position: u64,
    target: u64
): u32? throws { OutOfMemory, InvalidSourceGraph }

export declare function restoreMixedCalleeOwner(binding: MixedCallees): void

export declare function rejectMixedCallee(
    binding: MixedCallees,
    position: u64,
    name: bool,
    message: string
): void throws { OutOfMemory, InvalidSourceGraph }

export declare function historyBodyOpening(
    cache: HistoryParseCache,
    path: string,
    text: string
): u64? throws { OutOfMemory }

export declare function matchHistoryLink(link: HistoryModuleLink): bool

export declare function matchHistoryHeaders(range: HistoryFunctionRange): bool

export declare function matchHistoryBodies(range: HistoryFunctionRange): bool

export declare function historyStoreNode(
    stores: HistoryStores,
    index: u64,
    shape: HistoryXmlNode?
): HistoryXmlNode

export declare function historyXmlNodesShare(left: HistoryXmlNode, right: HistoryXmlNode): bool

export declare function historyNodeName(node: HistoryXmlNode): string

export declare function historyNodePosition(node: HistoryXmlNode): u8[]

export declare function historyNodeRows(
    node: HistoryXmlNode,
    part: HistoryXmlPart,
    shape: HistoryXmlRows?
): HistoryXmlRows

export declare function historyNodeAt(
    rows: HistoryXmlRows,
    index: u64,
    shape: HistoryXmlNode?
): HistoryXmlNode

export declare function historyAttributeAt(
    rows: HistoryXmlRows,
    index: u64,
    shape: HistoryXmlAttribute?
): HistoryXmlAttribute

export declare function historyTextAt(
    rows: HistoryXmlRows,
    index: u64,
    shape: HistoryXmlText?
): HistoryXmlText

export declare function historyXmlRowCount(rows: HistoryXmlRows): u64

export declare function historyXmlRowsShare(left: HistoryXmlRows, right: HistoryXmlRows): bool

export declare function historyAttributeIsExpression(attribute: HistoryXmlAttribute): bool

export declare function historyAttributeName(attribute: HistoryXmlAttribute): string

export declare function historyAttributeValue(attribute: HistoryXmlAttribute): string

export declare function historyAttributeRaw(attribute: HistoryXmlAttribute): string?

export declare function historyAttributePosition(
    attribute: HistoryXmlAttribute,
    value: bool
): u8[]

export declare function historyTextValue(text: HistoryXmlText): string

export declare function historyTextPosition(text: HistoryXmlText): u8[]
