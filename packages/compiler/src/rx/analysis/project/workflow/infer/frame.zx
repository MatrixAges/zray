import host from "rx_project_host"

import select from "../history"
import { Reuse } from "../model"

import type { Inference } from "rx_project_host"
import type { History } from "../model"

export type Input = {
    state: Inference,
    history: History
}

export type Output = Reuse

export default function (in: Input): Output {
    const { state, history } = in

    const reuse = select(history)

    host.normalizeProjectSources(state)

    if (reuse == Reuse.Frame) {
        host.restoreDerivedFrame(state)
    } else {
        host.deriveProjectFrame(state, reuse == Reuse.Signatures)
    }

    return reuse
}
