<Module>
    <Type from="../" as="Workflow" />

    <Args in={Workflow.Project} out={void} />

    <Call fn="../../workflow.normalizeSources" in={$in} />
    <Call fn="../../workflow.reuseFrame" in={$in} />

    <If on={!$ctx.reuseFrame}>
        <Call fn="../../workflow.deriveFrame" in={$in} />
    </If>

    <Call fn="../../workflow.compileBodies" in={$in} />

    <If on={$ctx.reuseFrame}>
        <Call fn="../../workflow.retainStores" in={$in} />

        <Else>
            <Call fn="../../workflow.publishStores" in={$in} />
        </Else>
    </If>
</Module>
