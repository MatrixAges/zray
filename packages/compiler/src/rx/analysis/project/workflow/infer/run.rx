<Module>
    <Type from="../" as="Workflow" />

    <Args in={Workflow.Project} out={void} />

    <Call fn="../" export="normalizeSources" in={$in} />
    <Call fn="../" export="reuseFrame" in={$in} />

    <If on={!$ctx.reuseFrame}>
        <Call fn="../" export="deriveFrame" in={$in} />
    </If>

    <Call fn="../" export="compileBodies" in={$in} />

    <If on={$ctx.reuseFrame}>
        <Call fn="../" export="retainStores" in={$in} />

        <Else>
            <Call fn="../" export="publishStores" in={$in} />
        </Else>
    </If>
</Module>
