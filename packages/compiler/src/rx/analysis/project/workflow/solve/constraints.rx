<Module>
    <Type from="model" as="Solver" />
    <Type from="effect" as="Flow" />

    <Args in={Solver.Request} out={void} />

    <Store from="flow" as="flow" />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.OpenPorts
        }}
        setter={[$store.flow.effect]}
    />

    <Call module="../../constraints/ports/run" in={$in.ports} />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.PublishPorts,
            batches: $ctx.run
        }}
        setter={[$store.flow.effect]}
    />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.OpenCollection
        }}
        setter={[$store.flow.effect]}
    />

    <Call module="../../constraints/collection/run" in={$in.collection} />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.ReleaseCollection
        }}
        setter={[$store.flow.effect]}
    />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.OpenSolver
        }}
        setter={[$store.flow.effect]}
    />

    <Call module="../../../inference/solve/run" in={$in.solve} />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.ReleasePending
        }}
        setter={[$store.flow.effect]}
    />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.BindSignatures
        }}
        setter={[$store.flow.effect]}
    />

    <Call module="../../signatures/collect_signatures" in={$in.signatures} />

    <Call
        fn="stage"
        in={{
            flow_step: Flow.Step.PublishSignatures,
            signatures: $ctx.collect_signatures
        }}
        setter={[$store.flow.effect]}
    />
</Module>
