import integers from "std:integer"

import representative from "../../inference/forest/borrowed_root"
import referenced from "./referenced"

import type { Cursor } from "./model"

export type Input = Cursor

export type Output = {
    next: u64,
    input?: u32
}

export default function (in: Input): Output {
    const { columns, parents, marked, protected } = in
    const { edges, fixed, inputs } = columns

    const initial: Output = {
        next: in.next,
        input: null
    }

    return loop(initial, {
        while: state => state.input == null && state.next < inputs.length,
        next: state => {
            const index = state.next

            state.next += 1

            if (!fixed[index]) {
                const value = inputs[index]
                const root = representative({
                    parents,
                    value
                })

                if (marked.length == 0) {
                    const result = referenced({
                        edges,
                        parents,
                        root,
                        index: 0,
                        found: false
                    })

                    if (!result.found) {
                        state.input = value
                    }
                } else if (!marked[integers.widen(root)]) {
                    if (protected == null) {
                        state.input = value
                    } else {
                        const active = representative({
                            parents,
                            value: protected
                        })

                        if (active != root) {
                            state.input = value
                        }
                    }
                }
            }
        },
        return: state => state
    })
}
