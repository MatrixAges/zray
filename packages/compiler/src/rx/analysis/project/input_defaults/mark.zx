import integers from "std:integer"

import representative from "../../inference/forest/root"

import type { Edges } from "../../inference/assignment/model"

export type Input = {
    edges: Edges,
    parents: u32[],
    count: u64
}

export type Output = bool[]

export default function (in: Input): Output {
    const { edges, parents, count } = in

    const initial: bool[] = []

    const marked = loop({
        items: initial
    }, {
        while: state => state.items.length < count,
        next: state => {
            state.items = state.items.push(false)[0]
        },
        return: state => state.items
    })

    return loop({
        row: 0,
        items: marked
    }, {
        while: state => state.row < edges.left.length,
        next: state => {
            const row = state.row
            const left = representative({
                parents,
                value: edges.left[row]
            })
            const right = representative({
                parents,
                value: edges.right[row]
            })

            state.items[integers.widen(left)] = true
            state.items[integers.widen(right)] = true
            state.row += 1
        },
        return: state => state.items
    })
}
