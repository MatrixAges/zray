import integers from "std:integer"
import memory from "memory"

import representative from "../../inference/forest/borrowed_root"

import type { BoolBuffer, U32Buffer } from "memory"
import type { Edges } from "../../inference/assignment/model"

export type Input = {
    edges: Edges,
    parents: U32Buffer,
    marked: BoolBuffer,
    count: u64
}

export type Output = bool[]

export default function (in: Input): Output {
    const { edges, marked, parents, count } = in

    memory.allocateBoolViews(marked, count)

    const first = loop({
        remaining: count
    }, {
        while: state => state.remaining != 0,
        next: state => {
            state.remaining -= 1

            memory.writeBool(marked, state.remaining, false)
        },
        return: state => state.remaining
    })

    return loop({
        row: first
    }, {
        while: state => state.row < edges.left.length,
        next: state => {
            const row = state.row
            const left = representative({
                parents,
                value: edges.left[row]
            })
            const right = representative({
                parents,
                value: edges.right[row]
            })

            memory.writeBool(marked, integers.widen(left), true)
            memory.writeBool(marked, integers.widen(right), true)

            state.row += 1
        },
        return: state => memory.boolViews(marked)
    })
}
