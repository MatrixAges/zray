<Module>
    <Type from="model" as="Defaults" />

    <Args in={Defaults.Cursor} out={Defaults.Cursor} />

    <Call fn="next" in={$in} />

    <If on={$ctx.next.input != null}>
        <Call
            fn="host.defaultConstraintInput"
            in={[
                $in.frame,
                $ctx.next.input
            ]}
        />

        <Return
            value={{
                ...$in,
                parents: $ctx.defaultConstraintInput,
                next: $ctx.next.next
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            next: $ctx.next.next
        }}
    />
</Module>
