import integers from "std:integer"
import { scalar_void } from "core/type_table/const"

import representative from "../../inference/forest/root"
import find from "../../inference/known/find"
import mark from "./mark"

import type { Index } from "./model"

export type Input = Index

export type Output = {
    marked: bool[],
    protected?: u32
}

export default function (in: Input): Output {
    const { columns, unused, parents } = in

    const count = parents.length
    const empty: bool[] = []

    if (unused <= 1 || columns.edges.left.length <= count / (unused - 1)) {
        return {
            marked: empty,
            protected: null
        }
    }

    const marked = mark({
        edges: columns.edges,
        parents,
        count
    })

    const candidate = find({
        known: in.default_known,
        type_id: scalar_void
    })

    if (candidate != null) {
        const root = representative({
            parents,
            value: candidate
        })

        if (marked[integers.widen(root)]) {
            return {
                marked,
                protected: candidate
            }
        }
    }

    return {
        marked,
        protected: null
    }
}
