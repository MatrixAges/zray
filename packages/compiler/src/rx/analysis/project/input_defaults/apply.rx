<Module>
    <Type from="../constraints/collection/model" as="Collection" />
    <Type from="../constraints/collection/effect" as="CollectionEffect" />

    <Args in={Collection.Defaults} out={void} />

    <Store from="../constraints/collection/collection" as="collection" />

    <Call
        fn="../constraints/collection/stage"
        in={{
            collection_step: CollectionEffect.Step.OpenDefaults
        }}
        setter={[$store.collection.effect]}
    />

    <Call fn="../constraints/collection/read_parents" in={$store.collection.effect} />

    <Call
        fn="index_references"
        in={{
            parents: $ctx.read_parents,
            unused: $in.unused,
            default_known: $in.default_known,
            columns: $in.default_columns
        }}
    />

    <Loop on={$in.next < $in.columns.inputs.length}>
        <Call
            module="advance"
            in={{
                parents: $ctx.read_parents,
                columns: $in.default_columns,
                marked: $ctx.index_references.marked,
                protected: $ctx.index_references.protected,
                next: 0
            }}
        />
    </Loop>
</Module>
