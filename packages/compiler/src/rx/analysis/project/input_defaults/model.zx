import type { DefaultColumns, Request } from "../constraints/collection/model"

export type Index = Request.Pick("default_known") & {
    parents: u32[],
    unused: u64,
    columns: DefaultColumns
}

export type Cursor = Request.Pick("frame") & {
    parents: u32[],
    columns: DefaultColumns,
    marked: bool[],
    protected?: u32,
    next: u64
}
