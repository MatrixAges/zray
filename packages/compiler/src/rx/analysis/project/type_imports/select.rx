<Module>
    <Type from="admission" as="Import" />

    <Args in={Import.Request} out={Import.Selection} />

    <If on={!$in.has_alias}>
        <Call fn="diagnostic" in={Import.Status.MissingAlias} />

        <Return
            value={{
                signature: null,
                message: $ctx.diagnostic
            }}
        />
    </If>

    <Call
        module="admit"
        in={{
            target: $in.targets.kinds[$in.edge],
            signature: {
                ...$in.signatures,
                owner: $in.targets.owners[$in.edge]
            }
        }}
    />

    <If on={$ctx.admit.status == Import.Status.Resolved}>
        <Return
            value={{
                signature: $ctx.admit.index,
                message: null
            }}
        />
    </If>

    <Call fn="diagnostic" in={$ctx.admit.status} />

    <Return
        value={{
            signature: null,
            message: $ctx.diagnostic
        }}
    />
</Module>
