import type {
    NamedRowBuffer,
    NamedRows,
    StringBuffer,
    U32Buffer
} from "memory"
import type { TypeBindingTail } from "rx_project_host"

export type Qualified = {
    alias: string,
    rows: NamedRowBuffer
}

export type Values = {
    names: StringBuffer,
    ids: U32Buffer,
    capacity: u64
}

export type Input = {
    rows: NamedRows,
    length: u64,
    kinds: u8[],
    qualified?: Qualified,
    tail: TypeBindingTail,
    values: Values,
}
