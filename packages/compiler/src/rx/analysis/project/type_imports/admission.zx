import type { Target } from "../../call/availability"
import type { Signatures, Targets } from "../declarations/workflow"
import type { Input as Signature } from "../references/lookup/model"

export enum Status {
    Resolved,
    NonSource,
    Native,
    MissingAlias,
    MissingSignature
}

export type Input = {
    target: Target,
    signature: Signature
}

export type Output = {
    status: Status,
    index?: u64
}

export type Request = {
    targets: Targets,
    signatures: Signatures,
    edge: u64,
    has_alias: bool
}

export type Selection = {
    signature?: u64,
    message?: string
}
