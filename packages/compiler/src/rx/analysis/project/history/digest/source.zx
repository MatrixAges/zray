import retain from "./retain"
import write from "./write"

import type { DigestRow, Publication as Input } from "./model"

export type Output = DigestRow[]

export default function (in: Input): Output {
    const { cache, paths, width, retained } = in

    const end = paths.length
    const empty_rows: DigestRow[] = []

    return loop({
        first: 0,
        rows: empty_rows
    }, {
        while: state => state.first < end,
        next: state => {
            const batch = match {
                retained == null => {
                    next: state.first,
                    rows: empty_rows
                },
                _ => retain({
                    retained,
                    width,
                    first: state.first,
                    end
                })
            }

            state.rows = state.rows.concat(batch.rows)[0]

            if (batch.next == end) {
                state.first = end
            } else {
                const entry = write({
                    cache,
                    path: paths[batch.next]
                })

                state.rows = state.rows.push(entry)[0]
                state.first = batch.next + 1
            }
        },
        return: state => state.rows
    })
}
