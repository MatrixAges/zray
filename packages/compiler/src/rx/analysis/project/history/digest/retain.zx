import memory from "memory"

import type { DigestRow, Retained } from "./model"

export type Input = {
    retained: Retained,
    width: u64,
    first: u64,
    end: u64
}

export type Output = {
    next: u64,
    rows: DigestRow[]
}

export default function (in: Input): Output {
    const { retained, width, first, end } = in

    const empty_rows: DigestRow[] = []
    const empty_bytes: u8[] = []

    return loop({
        row: first,
        changed: false,
        rows: empty_rows
    }, {
        while: state => !state.changed && state.row < end,
        next: state => {
            const row = state.row
            const previous = memory.readTextColumn(retained.earlier, row)
            const incoming = memory.readTextColumn(retained.current, row)

            if (previous == incoming) {
                const present = retained.present[row] != 0
                const bytes = match {
                    present => memory.borrowU8Range(retained.data, row * width, width),
                    _ => empty_bytes
                }

                state.rows = state.rows.push({
                    present,
                    bytes
                })[0]
                state.row += 1
            } else {
                state.changed = true
            }
        },
        return: state => ({
            next: state.row,
            rows: state.rows
        })
    })
}
