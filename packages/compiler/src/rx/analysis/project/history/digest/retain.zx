import memory from "memory"

import type { Retained, Target } from "./model"

export type Input = {
    retained: Retained,
    target: Target,
    first: u64,
    end: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { retained, target, first, end } = in

    const next = loop({
        row: first,
        changed: false
    }, {
        while: state => !state.changed && state.row < end,
        next: state => {
            const row = state.row
            const previous = memory.readTextColumn(retained.earlier, row)
            const incoming = memory.readTextColumn(retained.current, row)

            if (previous == incoming) {
                state.row += 1
            } else {
                state.changed = true
            }
        },
        return: state => state.row
    })

    if (next != first) {
        const first_byte = first * target.width
        const end_byte = next * target.width

        const data =
            memory.copyBytes(
                target.data,
                first_byte,
                retained.data,
                first_byte,
                end_byte
            )

        const present =
            memory.copyBytes(target.present, first, retained.present, first, next)
    }

    return next
}
