import memory from "zig:compiler_memory"

import type { TextColumn, U8Buffer } from "zig:compiler_memory"

export type Input = {
    earlier: TextColumn,
    current: TextColumn,
    previous_data: u8[],
    previous_present: u8[],
    data: U8Buffer,
    present: U8Buffer,
    width: u64,
    start: u64,
    end: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { earlier, current, start, end } = in

    const next = loop({
        row: start,
        changed: false
    }, {
        while: state => !state.changed && state.row < end,
        next: state => {
            const row = state.row
            const previous = memory.readTextColumn(earlier, row)
            const incoming = memory.readTextColumn(current, row)

            if (previous == incoming) {
                state.row += 1
            } else {
                state.changed = true
            }
        },
        return: state => state.row
    })

    if (next != start) {
        const first_byte = start * in.width
        const end_byte = next * in.width

        const data =
            memory.copyBytes(
                in.data,
                first_byte,
                in.previous_data,
                first_byte,
                end_byte
            )

        const present =
            memory.copyBytes(in.present, start, in.previous_present, start, next)
    }

    return next
}
