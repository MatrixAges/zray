import bytes from "std:bytes"
import locate from "core/bytes/index/slot"
import columns from "memory/columns"

import type { Cache, DigestRow } from "./model"

export type Input = {
    cache: Cache,
    path: string
}

export type Output = DigestRow

export default function (in: Input): Output {
    const { cache, path } = in

    const entry = match {
        cache.capacity == 0 => 0,
        _ => locate({
            ...cache.pick([
                "keys",
                "buckets",
                "capacity"
            ]),
            key: bytes.fromText(path)
        }).entry
    }

    if (entry == 0) {
        return {
            present: false,
            bytes: []
        }
    }

    return {
        present: true,
        bytes: columns.readReferencedBytes(cache.digests, entry - 1)
    }
}
