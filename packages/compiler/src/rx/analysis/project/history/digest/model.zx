import type { Lookup } from "core/bytes/index/slot"
import type { TextColumn } from "memory"
import type { ReferenceColumn } from "memory/columns"

export type Cache = Lookup.Omit("key") & {
    digests: ReferenceColumn
}

export type DigestRow = {
    present: bool,
    bytes: u8[]
}

export type Retained = {
    earlier: TextColumn,
    current: TextColumn,
    data: u8[],
    present: u8[]
}

export type Publication = {
    cache: Cache,
    paths: string[],
    width: u64,
    retained?: Retained
}
