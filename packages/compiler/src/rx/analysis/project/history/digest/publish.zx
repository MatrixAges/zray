import memory from "zig:compiler_memory"
import find from "core/bytes/index/sorted_text"

import type { TextColumn, U8Buffer } from "zig:compiler_memory"

export type Digests = {
    paths: TextColumn,
    count: u64,
    bytes: u8[],
    first: u64,
    stride: u64
}

export type Input = {
    paths: string[],
    digests: Digests,
    width: u64,
    data: U8Buffer,
    present: U8Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { paths, digests, width, data, present } = in

    const written = loop(0, {
        while: row => row < paths.length,
        next: row => {
            const previous = find({
                path: paths[row],
                paths: digests.paths,
                count: digests.count
            })

            if (previous == null) {
                memory.writeU8(present, row, 0)
            } else {
                const first = digests.first + previous * digests.stride
                const end = first + width
                const copied =
                    memory.copyBytes(data, row * width, digests.bytes, first, end)

                memory.writeU8(present, row, 1)
            }

            row += 1
        }
    })
}
