import find from "core/bytes/index/sorted_text"
import memory from "memory"

import type { TextColumn } from "memory"
import type { DigestRow } from "./model"

export type Digests = {
    paths: TextColumn,
    count: u64,
    bytes: u8[],
    first: u64,
    stride: u64
}

export type Input = {
    paths: string[],
    digests: Digests,
    width: u64
}

export type Output = DigestRow[]

export default function (in: Input): Output {
    const { paths, digests, width } = in

    const empty_rows: DigestRow[] = []
    const empty_bytes: u8[] = []

    return loop({
        row: 0,
        rows: empty_rows
    }, {
        while: state => state.row < paths.length,
        next: state => {
            const previous = find({
                path: paths[state.row],
                paths: digests.paths,
                count: digests.count
            })

            if (previous == null) {
                state.rows = state.rows.push({
                    present: false,
                    bytes: empty_bytes
                })[0]
            } else {
                const first = digests.first + previous * digests.stride

                state.rows = state.rows.push({
                    present: true,
                    bytes: memory.borrowU8Range(digests.bytes, first, width)
                })[0]
            }

            state.row += 1
        },
        return: state => state.rows
    })
}
