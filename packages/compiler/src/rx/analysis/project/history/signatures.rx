<Module>
    <Type from="model" as="History" />

    <Args in={History.Signatures} out={bool} />

    <Call fn="inputs" in={$in.inputs} />

    <If on={!$ctx.inputs}>
        <Return value={false} />
    </If>

    <Call fn="signature_order" in={$in.entries} />

    <Return value={$ctx.signature_order} />
</Module>
