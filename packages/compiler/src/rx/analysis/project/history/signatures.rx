<Module>
    <Type from="model" as="History" />

    <Args in={History.Signatures} out={bool} />

    <Call fn="inputs" in={$in.inputs} />

    <If on={!$ctx.inputs}>
        <Return value={false} />
    </If>

    <Call fn="signature_order" in={$in.entries} />

    <If on={!$ctx.signature_order}>
        <Return value={false} />
    </If>

    <Call
        fn="source"
        in={{
            sources: $in.sources,
            first: 0
        }}
    />

    <Return value={$ctx.source == $in.sources.current_count} />
</Module>
