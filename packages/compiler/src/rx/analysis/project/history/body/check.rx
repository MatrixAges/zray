<Module>
    <Type from="model" as="Edit" />

    <Args in={Edit.Admission} out={u64?} />

    <If on={$in.row != null}>
        <Call
            module="advance"
            in={{
                sources: $in.sources,
                row: $in.row,
                opening: $in.opening
            }}
        />

        <Return value={$ctx.advance} />
    </If>

    <Call fn="../inputs" in={$in.identity} />

    <If on={!$ctx.inputs}>
        <Return value={null} />
    </If>

    <Call
        fn="../source"
        in={{
            sources: $in.sources,
            first: 0
        }}
    />

    <Return value={$ctx.source} />
</Module>
