<Module>
    <Type from="model" as="Edit" />

    <Args in={Edit.Edit} out={u64?} />

    <Call fn="header" in={$in} />

    <If on={!$ctx.header}>
        <Return value={null} />
    </If>

    <Call
        fn="../source"
        in={{
            sources: $in.sources,
            first: $in.row + 1
        }}
    />

    <Return value={$ctx.source} />
</Module>
