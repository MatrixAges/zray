import bytes from "std:bytes"
import memory from "memory"
import host from "rx_project_host"

import type { Edit } from "./model"

export type Input = Edit

export type Output = bool

export default function (in: Input): Output {
    const { context, row } = in

    const before = memory.readTextColumn(context.sources.earlier.texts, row)
    const after = memory.readTextColumn(context.sources.current.texts, row)
    const body = host.historyBodyOpening(context.cache, context.paths[row], after)

    if (body == null) {
        return false
    }

    const earlier = bytes.fromText(before)
    const current = bytes.fromText(after)

    if (body >= earlier.length || body >= current.length) {
        return false
    }

    const length = body + 1
    const earlier_header = earlier.splice(0, length, [])[1]
    const current_header = current.splice(0, length, [])[1]

    return bytes.equals(earlier_header, current_header)
}
