import bytes from "std:bytes"
import memory from "memory"

import type { Edit } from "./model"

export type Input = Edit

export type Output = bool

export default function (in: Input): Output {
    const { sources, row, opening } = in

    if (opening == null) {
        return false
    }

    const before = memory.readTextColumn(sources.earlier.texts, row)
    const after = memory.readTextColumn(sources.current.texts, row)
    const earlier = bytes.fromText(before)
    const current = bytes.fromText(after)

    if (opening >= earlier.length || opening >= current.length) {
        return false
    }

    const length = opening + 1
    const earlier_header = earlier.splice(0, length, [])[1]
    const current_header = current.splice(0, length, [])[1]

    return bytes.equals(earlier_header, current_header)
}
