import bytes from "std:bytes"
import memory from "memory"

import type { Scan } from "./model"

export type Input = Scan

export type Output = u64?

    // Null rejects a changed path or source count. The end row means no text changed.
export default function (in: Input): Output {
    const { earlier, current, earlier_count, current_count } = in.sources

    if (earlier_count != current_count) {
        return null
    }

    return loop({
        row: in.first,
        same_path: true,
        same_text: true
    }, {
        while: state => state.row < current_count && state.same_text,
        next: state => {
            const row = state.row
            const before_path =
                bytes.fromText(memory.readTextColumn(earlier.paths, row))
            const after_path =
                bytes.fromText(memory.readTextColumn(current.paths, row))

            if (!bytes.equals(before_path, after_path)) {
                state.same_path = false
                state.same_text = false
            } else {
                const before =
                    bytes.fromText(memory.readTextColumn(earlier.texts, row))
                const after =
                    bytes.fromText(memory.readTextColumn(current.texts, row))

                if (bytes.equals(before, after)) {
                    state.row += 1
                } else {
                    state.same_text = false
                }
            }
        },
        return: state => state.same_path ? state.row : null
    })
}
