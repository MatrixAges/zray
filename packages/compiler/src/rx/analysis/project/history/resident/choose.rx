<Module>
    <Type from="model" as="Lineage" />

    <Args in={Lineage.Request} out={Lineage.Selection} />

    <Call fn="../inputs" in={$in.shape} />

    <If on={!$ctx.inputs}>
        <Return
            value={{
                parent_count: $in.epochs.count,
                rx_only: false,
                same_input: false
            }}
        />
    </If>

    <Call fn="paths" in={$in.paths} />

    <If on={!$ctx.paths}>
        <Return
            value={{
                parent_count: $in.epochs.count,
                rx_only: false,
                same_input: false
            }}
        />
    </If>

    <Call
        fn="../source"
        in={{
            sources: $in.sources,
            first: 0
        }}
    />

    <If on={$ctx.source != $in.sources.current_count}>
        <Return
            value={{
                parent_count: $in.epochs.count,
                rx_only: false,
                same_input: false
            }}
        />
    </If>

    <Call
        fn="parent"
        in={$in.pick([
            "epochs",
            "digests",
            "frame"
        ])}
    />

    <Return value={$ctx.parent} />
</Module>
