import bytes from "std:bytes"
import memory from "memory"

import type { Change as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { earlier, current, row, width } = in

    const before = memory.readFixedBytes(earlier, row, width)
    const after = memory.readFixedBytes(current, row, width)

    return !bytes.equals(before, after)
}
