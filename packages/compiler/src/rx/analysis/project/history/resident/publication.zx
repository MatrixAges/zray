import type { SelectionPlan as Input, Action as Output } from "./model"

export default function (in: Input): Output {
    if (in.same_input) {
        return {
            restore: true,
            parent_count: in.parent_count,
            capture_edits: false,
            release_history: false,
            slots: in.parent_count
        }
    }

    const parents = in.borrows_previous ? in.parent_count : 0

    return {
        restore: false,
        parent_count: parents,
        capture_edits: in.borrows_previous && in.rx_only,
        release_history: !in.borrows_previous,
        slots: parents + 1
    }
}
