import type { TextColumn } from "memory"

export type Sources = {
    paths: TextColumn,
    texts: TextColumn
}

export type SourcePair = {
    earlier: Sources,
    current: Sources,
    earlier_count: u64,
    current_count: u64
}

export type Scan = {
    sources: SourcePair,
    first: u64
}

export type Inputs = {
    earlier: u8[],
    current: u8[],
    earlier_count: u64,
    current_count: u64
}

export type Signatures = {
    inputs: Inputs,
    entries: Entries,
    sources: SourcePair
}

export type Entries = {
    earlier_order: u64[],
    earlier_paths: string[],
    current_paths: string[],
    current_rows: u64[]
}
