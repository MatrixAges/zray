export enum SourceChange {
    DifferentPath,
    Unchanged,
    Edited
}

export type Inputs = {
    earlier: u8[],
    current: u8[],
    earlier_count: u64,
    current_count: u64
}

export type Signatures = {
    inputs: Inputs,
    entries: Entries
}

export type Entries = {
    earlier_order: u64[],
    earlier_paths: string[],
    current_paths: string[],
    current_rows: u64[]
}
