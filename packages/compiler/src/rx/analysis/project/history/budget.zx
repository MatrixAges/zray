import { retained_limit } from "./const"

export type Input = u64[]

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        available: retained_limit,
        exceeded: false
    }, {
        while: state => !state.exceeded && state.row < in.length,
        next: state => {
            const used = in[state.row]

            if (used > state.available) {
                state.exceeded = true
            } else {
                state.available -= used
            }

            state.row += 1
        },
        return: state => state.exceeded
    })
}
