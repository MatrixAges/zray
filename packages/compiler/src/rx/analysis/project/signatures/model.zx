import type { U32Buffer } from "memory"
import type { SignatureResolver } from "rx_project_host"
import type { Kind } from "../../inference/unification/model"

export enum Stage {
    Bindings,
    Input,
    Output
}

export type Cursor = {
    module: u64,
    binding: u64,
    output: bool
}

export type Nodes = {
    parents: U32Buffer,
    kinds: Kind[],
    arguments: u32[]
}

export type Ports = {
    inputs: u32[],
    outputs: u32[],
    binding_ends: u64[],
    task_ends: u64[]
}

export type Publication = {
    bindings: U32Buffer,
    tasks: U32Buffer,
    inputs: U32Buffer,
    outputs: U32Buffer
}

export type Columns = {
    nodes: Nodes,
    ports: Ports,
    target: Publication
}

export type Input = Columns & {
    cursor: Cursor
}

export type Output = Cursor & {
    unresolved?: u32
}

export type Request = {
    frame: SignatureResolver,
    columns: Columns
}

export type Iteration = Cursor & {
    request: Request
}
