import type { Session as Resolver } from "../../inference/resolve/model"
import type { Kind } from "../../inference/unification/model"

export enum Stage {
    Bindings,
    Input,
    Output
}

export type Cursor = {
    module: u64,
    binding: u64,
    output: bool,
    bindings: u32[],
    tasks: u32[],
    inputs: u32[],
    outputs: u32[]
}

export type Result = Cursor.Pick("bindings", "tasks", "inputs", "outputs")

export type Nodes = {
    parents: u32[],
    kinds: Kind[],
    arguments: u32[]
}

export type Ports = {
    inputs: u32[],
    outputs: u32[],
    binding_ends: u64[],
    task_ends: u64[]
}

export type Table = Ports & {
    binding_values: u32[],
    task_offsets: u32[]
}

export type Columns = {
    nodes: Nodes,
    ports: Table
}

export type Input = Columns & {
    cursor: Cursor
}

export type Output = Cursor & {
    unresolved?: u32
}

export type Request = {
    resolver: Resolver,
    columns: Columns
}

export type Iteration = Cursor & {
    request: Request
}
