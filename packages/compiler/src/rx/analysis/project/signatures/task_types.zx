import integers from "std:integer"

export type Input = {
    bindings: u32[],
    offsets: u32[],
    tasks: u32[],
    first: u64,
    end: u64,
    binding_first: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const { bindings, offsets, binding_first } = in

    return loop({
        row: in.first,
        tasks: in.tasks
    }, {
        while: state => state.row < in.end,
        next: state => {
            const offset = offsets[state.row]
            const type_id = bindings[binding_first + integers.widen(offset)]

            state.tasks = state.tasks.push(type_id)[0]
            state.row += 1
        },
        return: state => state.tasks
    })
}
