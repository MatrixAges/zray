<Module>
    <Type from="model" as="Signatures" />

    <Args in={Signatures.Iteration} out={Signatures.Iteration} />

    <Call
        fn="publish"
        in={{
            ...$in.request.columns,
            cursor: {
                module: $in.module,
                binding: $in.binding,
                output: $in.output,
                bindings: $in.bindings,
                tasks: $in.tasks,
                inputs: $in.inputs,
                outputs: $in.outputs
            }
        }}
    />

    <If on={$ctx.publish.unresolved != null}>
        <Call
            module="../../inference/resolve/run"
            in={{
                resolver: $in.request.resolver,
                node: $ctx.publish.unresolved ?? 0
            }}
        />
    </If>

    <Return
        value={{
            request: $in.request,
            ...$ctx.publish.omit(["unresolved"])
        }}
    />
</Module>
