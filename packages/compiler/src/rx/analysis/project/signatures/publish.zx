import integers from "std:integer"

import { Kind } from "../../inference/unification/model"
import { Stage } from "./model"
import publishTasks from "./task_types"

import type { Input as Request, Output as Progress } from "./model"

export type Input = Request

export type Output = Progress

export default function (in: Input): Output {
    const { nodes, ports } = in

    const unresolved: u32? = null

    const initial: Output = {
        ...in.cursor,
        unresolved
    }

    return loop(initial, {
        while: state => {
            const { module } = state

            return module < ports.inputs.length && state.unresolved == null
        },
        next: state => {
            const { module, binding, output } = state

            const stage = match {
                output => Stage.Output,
                binding < ports.binding_ends[module] => Stage.Bindings,
                _ => Stage.Input
            }

            const value = match stage {
                Stage.Bindings => ports.binding_values[binding],
                Stage.Input => ports.inputs[module],
                _ => ports.outputs[module]
            }
            const root = loop({
                value,
                parent: nodes.parents[integers.widen(value)]
            }, {
                while: current => current.value != current.parent,
                next: current => {
                    current.value = current.parent
                    current.parent = nodes.parents[integers.widen(current.parent)]
                },
                return: current => current.value
            })
            const row = integers.widen(root)

            if (nodes.kinds[row] != Kind.Known) {
                state.unresolved = root
            } else {
                const type_id = nodes.arguments[row]

                switch (stage) {
                    case Stage.Bindings:
                        state.bindings = state.bindings.push(type_id)[0]
                        state.binding += 1
                    case Stage.Input:
                        state.inputs = state.inputs.push(type_id)[0]
                        state.output = true
                    default:
                        const first = module == 0 ? 0 : ports.task_ends[module - 1]
                        const end = ports.task_ends[module]

                        if (first < end) {
                            const ends = ports.binding_ends
                            const binding_first = module == 0 ? 0 : ends[module - 1]

                            state.tasks = publishTasks({
                                bindings: state.bindings,
                                offsets: ports.task_offsets,
                                tasks: state.tasks,
                                first,
                                end,
                                binding_first
                            })
                        }

                        state.outputs = state.outputs.push(type_id)[0]
                        state.module += 1
                        state.output = false
                }
            }
        },
        return: state => state
    })
}
