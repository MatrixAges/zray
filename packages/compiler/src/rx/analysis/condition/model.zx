import type { U64Buffer, U8ListBuffer } from "memory"
import type { ExprNode } from "../../../zx/frontend/parser/expressions/state/model"

export type Scope = {
    source: u8[],
    nodes: ExprNode[],
    names: string[],
    implicit_input: bool,
    target: U8ListBuffer,
    capacity: u64
}

export type Walk = {
    condition: u64,
    truth: bool,
    depth: u64,
    active: bool
}

export enum Action {
    Scan,
    Borrow,
    Render
}

export type Fact = {
    action: Action,
    node: u64,
    start: u64,
    length: u64,
    written: u64
}

export type Input = Scope & Walk & {
    pending: U64Buffer
}

export type Output = Walk & Fact
