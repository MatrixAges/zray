import type { ExprNode } from "../../../zx/frontend/parser/expressions/state/model"

export type Scope = {
    source: u8[],
    nodes: ExprNode[],
    names: string[],
    implicit_input: bool
}

export enum Action {
    Scan,
    Borrow,
    Render
}

export type Fact = {
    action: Action,
    node: u64,
    length: u64,
    view: u8[]
}

export type Render = {
    node: u64,
    length: u64
}

export type Input = Scope & {
    condition: u64,
    truth: bool
}

export type Output = {
    borrowed: u8[][],
    rendered: Render[]
}
