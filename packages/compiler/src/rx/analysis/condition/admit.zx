import memory from "memory"

import layout from "../../../zx/analysis/binding_path/layout"
import { ExprKind } from "../../../zx/frontend/parser/expressions/state/model"
import rooted from "../inference/scope/rooted"
import { Action } from "./model"

import type { Fact as Output, Scope } from "./model"

export type Input = Scope & {
    node: u64
}

export default function (in: Input): Output {
    const { node } = in

    const skip: Output = {
        action: Action.Scan,
        node,
        length: 0,
        view: []
    }

    const kind = in.nodes[node].kind

    if (kind != ExprKind.Identifier && kind != ExprKind.Field) {
        return skip
    }

    const path = layout({
        nodes: in.nodes,
        node
    })

    if (path == null) {
        return skip
    }

    if (!path.contiguous) {
        return {
            action: Action.Render,
            node,
            length: path.length,
            view: []
        }
    }

    const view = memory.borrowU8Range(in.source, path.start, path.length)

    if (!rooted({
        names: in.names,
        implicit_input: in.implicit_input,
        path: view
    })) {
        return skip
    }

    return {
        action: Action.Borrow,
        node,
        length: path.length,
        view
    }
}
