import memory from "memory"
import { readFlowConditionLabel } from "rx_project_host"

import record from "./coverage"

import type { ReadColumn } from "memory"
import type { FlowTraversal } from "rx_project_host"

export type Input = {
    frame: FlowTraversal,
    labels: ReadColumn,
    fallback: u8,
    first: u64,
    end: u64,
    stopped: bool,
    remaining?: bool
}

export type Output = bool?

export default function (in: Input): Output {
    const { frame, labels, fallback, end, stopped, remaining } = in

    return loop({
        row: in.first,
        stopped,
        remaining
    }, {
        while: state => !state.stopped && state.row < end,
        next: state => {
            if (memory.readColumnU8(labels, state.row) != fallback) {
                const coverage = record({
                    remaining: state.remaining,
                    label: readFlowConditionLabel(frame, state.row)
                })

                state.remaining = coverage.remaining
                state.stopped = coverage.stopped
            }

            state.row += 1
        },
        return: state => state.remaining
    })
}
