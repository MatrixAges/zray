export type Input = {
    parts: string[],
    groups: bool[],
    parents: u32?[]
}

export type Output = {
    lengths: u64[],
    bytes: u64,
    routes: u64
}

export enum Issue {
    None,
    Overlap,
    Service
}

export type Conflict = {
    issue: Issue,
    row: u64,
    service_routes: u32[],
    route_services: u32[]
}
