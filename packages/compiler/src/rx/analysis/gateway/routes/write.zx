import integers from "std:integer"
import strings from "std:string"

import type { Input as Rows } from "./model"

export type Input = Rows & {
    lengths: u64[]
}

export type Output = string[]

export default function (in: Input): Output {
    const empty: string[] = []

    return loop({
        row: 0,
        paths: empty
    }, {
        while: state => state.row < in.lengths.length,
        next: state => {
            const row = state.row

            if (in.groups[row]) {
                state.paths = state.paths.push("")[0]
            } else {
                const initial: string[] = []

                const reversed = loop({
                    current: row,
                    parts: initial,
                    active: true
                }, {
                    while: cursor => cursor.active,
                    next: cursor => {
                        const current = cursor.current
                        const parent = in.parents[current]

                        cursor.parts = cursor.parts.push(in.parts[current])[0]

                        if (parent == null) {
                            cursor.active = false
                        } else {
                            cursor.current = integers.widen(parent)
                        }
                    },
                    return: cursor => cursor.parts
                })

                const ordered = loop({
                    index: reversed.length,
                    parts: initial
                }, {
                    while: cursor => cursor.index != 0,
                    next: cursor => {
                        cursor.index -= 1
                        cursor.parts =
                            cursor.parts.push(reversed[cursor.index])[0]
                    },
                    return: cursor => cursor.parts
                })

                state.paths = state.paths.push(strings.join("", ordered))[0]
            }

            state.row += 1
        },
        return: state => state.paths
    })
}
