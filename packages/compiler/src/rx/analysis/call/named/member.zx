import memory from "memory"

import position from "./member_position"

import type { Members } from "./model"

export type Input = {
    members: Members,
    module: u64,
    name: string
}

export type Output = u32?

export default function (in: Input): Output {
    const { members, module, name } = in

    const row = position({
        names: members.names,
        module,
        name
    })

    if (row == null) {
        return null
    }

    return memory.readListOptionalU32(members.ids, module, row)
}
