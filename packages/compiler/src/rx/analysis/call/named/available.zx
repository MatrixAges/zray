import memory from "memory"

import publicPosition from "../../../../zx/modules/binding/public_position"
import signature from "./signature"

import type { Requests } from "./model"

export type Input = Requests.Pick("names", "signature", "ids") & {
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    const { names, name, ids } = in

    const facts = in.signature

    if (facts != null) {
        const selected = signature({
            kinds: facts.kinds,
            stores: facts.stores,
            callable: facts.callable,
            names,
            name
        })

        return selected.row != null && !selected.has_store
    }

    if (ids == null) {
        return true
    }

    const row = publicPosition({
        names,
        name
    })

    return row != null && memory.readColumnOptionalU32(ids, row) != null
}
