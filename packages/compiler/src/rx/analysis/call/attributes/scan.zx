import memory from "memory"

import {
    argument_attribute,
    function_attribute,
    module_attribute,
    setter_attribute
} from "../../../schema/attribute/const"

import type { TextColumn } from "memory"

export type Slots = {
    argument?: u64,
    function?: u64,
    module?: u64,
    setter?: u64
}

export type Input = {
    names: TextColumn,
    count: u64
}

export type Output = Slots

export default function (in: Input): Output {
    const slots: Slots = {
        argument: null,
        function: null,
        module: null,
        setter: null
    }

    return loop({
        slots,
        row: 0
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const name = memory.readTextColumn(in.names, row)

            state.slots = match name {
                argument_attribute => {
                    ...state.slots,
                    argument: state.slots.argument ?? row
                },
                function_attribute => {
                    ...state.slots,
                    function: state.slots.function ?? row
                },
                module_attribute => {
                    ...state.slots,
                    module: state.slots.module ?? row
                },
                setter_attribute => {
                    ...state.slots,
                    setter: state.slots.setter ?? row
                },
                _ => state.slots
            }

            state.row += 1
        },
        return: state => state.slots
    })
}
