export enum Target {
    Source,
    Compiled,
    Native
}

export enum Route {
    Source,
    AuthorizedSource,
    Compiled,
    Native,
    Denied
}

export type Input = {
    target: Target,
    declared_setter: bool,
    setter: bool,
    ambient_store: bool
}

export type Output = Route

export default function (in: Input): Output {
    const explicit = in.declared_setter == in.setter
    const permitted = explicit && !in.ambient_store

    return match in.target {
        Target.Source => in.setter ? Route.AuthorizedSource : Route.Source,
        Target.Compiled => permitted ? Route.Compiled : Route.Denied,
        _ => Route.Native
    }
}
