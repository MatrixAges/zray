import { CallRoute as Route, ReferenceTarget as Target } from "rx_project_host"

import type { CallAdmission } from "rx_project_host"

export { CallRoute as Route, ReferenceTarget as Target } from "rx_project_host"

export type Input = CallAdmission

export type Output = Route

export default function (in: Input): Output {
    const permitted = in.declared_setter == in.setter && !in.ambient_store

    return match {
        in.named && in.target != Target.Source => Route.NamedTarget,
        in.named && in.setter => Route.NamedSetter,
        in.named => Route.NamedSource,
        _ => match in.target {
            Target.Source => in.setter ? Route.AuthorizedSource : Route.Source,
            Target.Compiled => permitted ? Route.Compiled : Route.Denied,
            _ => Route.Native
        }
    }
}
