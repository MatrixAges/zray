import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    source: string[],
    canonical: string[]
}

export type Output = u32[]

export default function (in: Input): Output {
    if (in.source.length == 1 && in.canonical.length == 1) {
        return [0]
    }

    const empty: u32[] = []

    return loop({
        index: 0,
        positions: empty
    }, {
        while: state => state.index < in.source.length,
        next: state => {
            const needle = bytes.fromText(in.source[state.index])

            const position = loop({
                first: 0,
                end: in.canonical.length
            }, {
                while: search => search.first < search.end,
                next: search => {
                    const middle = search.first + (search.end - search.first) / 2
                    const current = bytes.fromText(in.canonical[middle])

                    if (bytes.lessThan(current, needle)) {
                        search.first = middle + 1
                    } else {
                        search.end = middle
                    }
                },
                return: search => integers.narrow(search.first)
            })

            state.positions = state.positions.push(position)[0]
            state.index += 1
        },
        return: state => state.positions
    })
}
