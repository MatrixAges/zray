import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { U32Buffer } from "memory"

export type Input = {
    source: string[],
    canonical: string[],
    positions: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    if (in.source.length == 1 && in.canonical.length == 1) {
        memory.writeU32(in.positions, 0, 0)

        return
    }

    const result = loop(0, {
        while: index => index < in.source.length,
        next: index => {
            const needle = bytes.fromText(in.source[index])

            const position = loop({
                first: 0,
                end: in.canonical.length
            }, {
                while: state => state.first < state.end,
                next: state => {
                    const middle = state.first + (state.end - state.first) / 2
                    const current = bytes.fromText(in.canonical[middle])

                    if (bytes.lessThan(current, needle)) {
                        state.first = middle + 1
                    } else {
                        state.end = middle
                    }
                },
                return: state => integers.narrow(state.first)
            })

            memory.writeU32(in.positions, index, position)
            index += 1
        }
    })
}
