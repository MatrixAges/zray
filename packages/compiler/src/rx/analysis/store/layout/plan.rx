<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call fn="capture" in={$in.omit(["resource"])} />
    <Call fn="names" in={$ctx.capture.expressions} />

    <Call
        module="../../project/contracts/publish"
        in={{
            names: $ctx.names,
            expressions: $ctx.capture.expressions,
            resource: $in.resource
        }}
    />

    <Return
        value={{
            names: $ctx.names,
            expressions: $ctx.capture.expressions,
            fields: $ctx.capture.fields,
            ...$ctx.publish
        }}
    />
</Module>
