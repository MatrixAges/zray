<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call fn="capture" in={$in} />

    <Call fn="names" />

    <Call
        module="../../project/contracts/publish"
        in={{
            names: $ctx.names,
            expressions: $ctx.capture,
            resource: $in.resource
        }}
    />

    <Return
        value={{
            names: $ctx.names,
            expressions: $ctx.capture,
            ...$ctx.publish
        }}
    />
</Module>
