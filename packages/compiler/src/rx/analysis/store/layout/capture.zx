import memory from "memory"
import columns from "memory/columns"

import { type_attribute } from "../../../schema/attribute/const"
import attributeRow from "../../../schema/tree/attribute_row"

import type { FieldRef, Input as LayoutInput } from "./model"

export type { FieldRef } from "./model"

export type Input = LayoutInput.Omit("resource")

export type Output = {
    expressions: string[],
    fields: FieldRef[]
}

export default function (in: Input): Output {
    const { fragments, offsets, layout } = in

    const objects = offsets.length - 1
    const width = layout.node_width
    const empty_expressions: string[] = []
    const empty_fields: FieldRef[] = []

    return loop({
        object: 0,
        expressions: empty_expressions,
        fields: empty_fields
    }, {
        while: state => state.object < objects,
        next: state => {
            const object = state.object
            const fragment = memory.borrowU8Range(fragments, object * width, width)
            const members = columns.readBorrowedRowList(
                fragment,
                layout.node_children,
                width
            )
            const count = offsets[object + 1] - offsets[object]

            const captured = loop({
                row: 0,
                expressions: state.expressions,
                fields: state.fields
            }, {
                while: inner => inner.row < count,
                next: inner => {
                    const row = inner.row
                    const field = memory.borrowU8Range(members, row * width, width)
                    const selected = attributeRow({
                        layout,
                        node: field,
                        key: type_attribute
                    })

                    if (selected != null) {
                        const expression = columns.readBorrowedRowText(
                            selected,
                            layout.attribute_value
                        )

                        inner.expressions = inner.expressions.push(expression)[0]
                        inner.fields = inner.fields.push({
                            object,
                            row
                        })[0]
                    } else {
                        columns.requireColumnBounds(false)
                    }

                    inner.row += 1
                },
                return: inner => ({
                    expressions: inner.expressions,
                    fields: inner.fields
                })
            })

            state.expressions = captured.expressions
            state.fields = captured.fields
            state.object += 1
        },
        return: state => ({
            expressions: state.expressions,
            fields: state.fields
        })
    })
}
