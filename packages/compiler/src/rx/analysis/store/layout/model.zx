import type { Allocator } from "memory"
import type { WriteColumn } from "memory/columns"
import type { Layout } from "../../../schema/tree/model"
import type { Bytes } from "../../project/contracts/model"

export type Input = {
    fragments: u8[],
    offsets: u64[],
    layout: Layout,
    resource: Allocator,
    fields: WriteColumn
}

export type Output = Bytes & {
    names: string[],
    expressions: string[]
}
