import memory from "memory"

import find from "../../inference/known/find"

import type { State as Known } from "core/integer/map/model"
import type { StringBuffer, U32Buffer } from "memory"
import type { Getters } from "./model"

export type Input = {
    getters: Getters,
    known?: Known,
    first: u64,
    names: StringBuffer,
    values: U32Buffer
}

export type Output = u64

export default function (in: Input): Output {
    const { getters, known } = in

    return loop({
        next: in.first,
        missing: false
    }, {
        while: state => state.next < getters.count && !state.missing,
        next: state => {
            const row = state.next
            const type_id = memory.readColumnU32(getters.types, row)
            const value: u32? = match {
                known == null => type_id,
                _ => find({
                    known,
                    type_id
                })
            }

            if (value == null) {
                state.missing = true
            } else {
                memory.writeString(
                    in.names,
                    row,
                    memory.readTextColumn(getters.names, row)
                )
                memory.writeU32(in.values, row, value)
                state.next += 1
            }
        },
        return: state => state.next
    })
}
