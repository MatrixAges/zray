import memory from "memory"

import find from "../../inference/known/find"

import type { State as Known } from "core/integer/map/model"
import type { Getters } from "./model"

export type Input = {
    getters: Getters,
    known?: Known,
    first: u64
}

export type Row = {
    name: string,
    value: u32
}

export type Output = {
    next: u64,
    rows: Row[]
}

export default function (in: Input): Output {
    const { getters, known } = in

    const empty: Row[] = []

    return loop({
        next: in.first,
        missing: false,
        rows: empty
    }, {
        while: state => state.next < getters.count && !state.missing,
        next: state => {
            const row = state.next
            const type_id = memory.readColumnU32(getters.types, row)
            const value: u32? = match {
                known == null => type_id,
                _ => find({
                    known,
                    type_id
                })
            }

            if (value == null) {
                state.missing = true
            } else {
                state.rows = state.rows.push({
                    name: memory.readTextColumn(getters.names, row),
                    value
                })[0]
                state.next += 1
            }
        },
        return: state => ({
            next: state.next,
            rows: state.rows
        })
    })
}
