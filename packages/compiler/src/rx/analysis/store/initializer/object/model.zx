import type { Metadata } from "core/expression_table/append/model"
import type { Allocator, ColumnRanges, U8Buffer } from "memory"
import type { Range } from "../../../program/linking/operands/range"
import type { Allocation } from "../../../program/linking/operands/workflow"
import type { Header } from "../../../program/linking/write_header"
import type { Input as Indices } from "../../layout/field_positions"

export type Values = {
    source: u8[],
    fields: U8Buffer,
    evaluation: U8Buffer
}

export type Input = {
    indices: Indices,
    values: Values,
    fields: Range,
    evaluation: Range
}

export type Work = {
    resource: Allocator,
    expression: ColumnRanges,
    allocation: Allocation,
    write: Input,
    header: Header,
    metadata: Metadata,
    kind: u8
}
