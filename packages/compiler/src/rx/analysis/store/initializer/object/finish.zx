import integers from "std:integer"
import { publish } from "core/column_ranges"
import memory from "memory"

import writeHeader from "../../../program/linking/write_header"

import type { Work } from "./model"

export type Input = Work

export type Output = u32

export default function (in: Input): Output {
    const { header, members, evaluation } = in.allocation

    const payload = integers.narrow(memory.columnRangeLength(header, 0))

    publish(header)

    if (members != null) {
        publish(members)
    }

    if (evaluation != null) {
        publish(evaluation)
    }

    const ranges = in.expression
    const root = integers.narrow(memory.columnRangeLength(ranges, 0))

    writeHeader({
        header: in.header,
        metadata: in.metadata,
        kind: in.kind,
        payload
    })

    publish(ranges)

    return root
}
