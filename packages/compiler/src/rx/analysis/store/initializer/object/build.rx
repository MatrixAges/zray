<Module>
    <Type from="model" as="Object" />

    <Args in={Object.Work} out={u32} />

    <Call
        fn="../../../program/linking/operands/reserve"
        in={{
            resource: $in.resource,
            ranges: $in.expression
        }}
    />

    <Call module="../../../program/linking/operands/reserve" in={$in.allocation} />
    <Call module="publish" in={$in.write} />

    <Call fn="finish" in={$in} />

    <Return value={$ctx.finish} />
</Module>
