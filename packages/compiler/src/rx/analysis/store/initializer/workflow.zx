import type { Fields } from "./fields/attributes"
import type { Layout } from "./fields/model"

export type Request = {
    layout: Layout,
    fields: Fields,
    first: u32
}

export type Scan = Request.Pick("layout", "fields") & {
    row: u64,
    end: u64,
    next?: u32,
    position: u64,
    invalid_link: bool,
    valid: bool
}
