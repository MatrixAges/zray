<Module>
    <Type from="workflow" as="Initializer" />
    <Type from="effect" as="Effect" />

    <Args in={Initializer.Request} out={void} />

    <Store from="initializer" as="initializer" />

    <Call
        module="fields/plan"
        in={{
            layout: $in.layout,
            first: $in.first
        }}
    />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Prepare,
            index: $ctx.plan.count
        }}
        setter={[$store.initializer.effect]}
    />

    <Loop on={$in.valid && ($in.row < $in.end || $in.next != null)}>
        <Call
            module="fields/step"
            in={{
                layout: $in.layout,
                fields: $in.fields,
                row: $ctx.plan.first,
                end: $ctx.plan.end,
                next: $ctx.plan.next,
                position: 0,
                invalid_link: false,
                valid: true
            }}
        />
    </Loop>

    <If on={$ctx.step.valid}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.Resolve
            }}
            setter={[$store.initializer.effect]}
        />

        <If on={$ctx.step.invalid_link}>
            <Call
                fn="stage"
                in={{
                    step: Effect.Step.InvalidLink
                }}
                setter={[$store.initializer.effect]}
            />
        </If>

        <Call fn="read_names" in={$store.initializer.effect} />

        <Call fn="../layout/field_positions" />

        <Call
            fn="stage"
            in={{
                step: Effect.Step.Finish,
                positions: $ctx.field_positions
            }}
            setter={[$store.initializer.effect]}
        />
    </If>
</Module>
