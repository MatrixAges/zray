<Module>
    <Type from="model" as="Fields" />

    <Args in={Fields.Input} out={Fields.Plan} />

    <Call fn="run" in={$in} />

    <If on={$ctx.run.next == null}>
        <Return
            value={{
                ...$ctx.run,
                count: $ctx.run.end - $ctx.run.first
            }}
        />
    </If>

    <Call
        fn="count"
        in={{
            layout: $in.layout,
            first: $ctx.run.next
        }}
    />

    <Return
        value={{
            ...$ctx.run,
            count: $ctx.run.end - $ctx.run.first + $ctx.count
        }}
    />
</Module>
