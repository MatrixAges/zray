<Module>
    <Type from="../workflow" as="Initializer" />
    <Type from="../effect" as="Effect" />

    <Args in={Initializer.Scan} out={Initializer.Scan} />

    <Store from="../initializer" as="initializer" />

    <If on={$in.row == $in.end}>
        <Call
            fn="run"
            in={{
                layout: $in.layout,
                first: $in.next
            }}
        />

        <Return
            value={{
                ...$in,
                row: $ctx.run.first,
                end: $ctx.run.end,
                next: $ctx.run.next
            }}
        />
    </If>

    <Call
        fn="attributes"
        in={$in.pick([
            "fields",
            "row"
        ])}
    />

    <Call
        fn="../stage"
        in={{
            step: Effect.Step.Evaluate,
            index: $in.row,
            name: $ctx.attributes.first ?? [],
            value: $ctx.attributes.second ?? []
        }}
        setter={[$store.initializer.effect]}
    />

    <Call fn="../read_valid" in={$store.initializer.effect} />

    <If on={!$ctx.read_valid}>
        <Call
            fn="../stage"
            in={{
                step: Effect.Step.Release
            }}
            setter={[$store.initializer.effect]}
        />

        <Return
            value={{
                ...$in,
                valid: false
            }}
        />
    </If>

    <Call
        fn="../stage"
        in={{
            step: Effect.Step.Record,
            index: $in.position
        }}
        setter={[$store.initializer.effect]}
    />

    <Call module="link" in={$in} />

    <Call
        fn="../stage"
        in={{
            step: Effect.Step.Release
        }}
        setter={[$store.initializer.effect]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            position: $in.position + 1,
            invalid_link: $ctx.link
        }}
    />
</Module>
