import integers from "std:integer"
import memory from "memory"

import type { NamedRows } from "memory"

export type Input = {
    aliases: NamedRows,
    length: u64,
    type_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < in.length,
        next: state => {
            const id = memory.readRowId(in.aliases, state.row)

            state.valid = integers.widen(id) < in.type_count
            state.row += 1
        },
        return: state => state.valid
    })
}
