import type { Binding, Scope } from "./model"

export type Input = {
    scope: Scope,
    positions: u64[]
}

export type Output = Binding[]

export default function (in: Input): Output {
    const { scope, positions } = in

    const empty: Binding[] = []

    return loop({
        row: 0,
        bindings: empty
    }, {
        while: state => state.row < positions.length,
        next: state => {
            const index = positions[state.row]

            state.bindings = state.bindings.push({
                name: scope.names[index],
                path: scope.paths[index],
                type_id: scope.types[index]
            })[0]

            state.row += 1
        },
        return: state => state.bindings
    })
}
