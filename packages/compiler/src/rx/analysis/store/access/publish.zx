import bytes from "std:bytes"
import { allocateRows } from "core/row_buffer"
import columns from "memory/columns"

import type { FieldBindings } from "./model"

export type Input = FieldBindings.Pick("scope", "output") & {
    positions: u64[]
}

export type Output = void

export default function (in: Input): Output {
    const { scope, positions, output } = in
    const { fields } = output

    allocateRows({
        target: output.rows,
        count: positions.length,
        owner: output.owner
    })

    const written = loop(0, {
        while: row => row < positions.length,
        next: row => {
            const index = positions[row]

            columns.writeColumnBytes(
                fields.name,
                row,
                bytes.fromText(scope.names[index])
            )
            columns.writeColumnBytes(
                fields.path,
                row,
                bytes.fromText(scope.paths[index])
            )
            columns.writeColumnU32(fields.type_id, row, scope.types[index])

            row += 1
        }
    })
}
