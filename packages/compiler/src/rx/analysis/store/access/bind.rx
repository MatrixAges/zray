<Module>
    <Type from="model" as="Access" />

    <Args in={Access.FieldBindings} out={Access.Binding[]} />

    <Call
        module="read"
        in={{
            source: $in.source,
            tree: $in.tree,
            root: $in.root,
            names: $in.scope.names
        }}
    />

    <If on={$ctx.read.length == 0}>
        <Return value={[]} />
    </If>

    <Call
        fn="publish"
        in={{
            scope: $in.scope,
            positions: $ctx.read
        }}
    />

    <Return value={$ctx.publish} />
</Module>
