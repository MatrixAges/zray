import matches from "../../../../zx/analysis/binding_path/match"
import { ExprKind } from "../../../../zx/frontend/parser/expressions/state/model"
import { invalid_setter_list, missing_setter } from "./const"

import type { Binding, Expression, Scope } from "./model"

export type Input = Expression & {
    scope: Scope
}

export type Output = {
    binding?: Binding,
    offset: u64,
    message?: string
}

export default function (in: Input): Output {
    const root = in.tree.nodes[in.root]

    if (root.kind != ExprKind.List || root.count != 1) {
        return {
            offset: 0,
            message: invalid_setter_list
        }
    }

    const path = in.tree.items[root.head - 1].value

    const { names, paths, types } = in.scope

    const position: u64? = null

    const selected = loop({
        position,
        index: 0
    }, {
        while: state => state.position == null && state.index < names.length,
        next: state => {
            if (matches({
                source: in.source,
                nodes: in.tree.nodes,
                native_names: null,
                node: path,
                path: names[state.index],
                rooted: false
            })) {
                state.position = state.index
            }

            state.index += 1
        },
        return: state => state.position
    })

    if (selected == null) {
        return {
            offset: in.tree.nodes[path].span.start,
            message: missing_setter
        }
    }

    return {
        binding: {
            name: names[selected],
            path: paths[selected],
            type_id: types[selected]
        },
        offset: 0
    }
}
