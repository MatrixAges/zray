import memory from "memory"

import next from "./next"

import type { ListColumn } from "memory"
import type { Members, Result as Output, Selected } from "./model"

export type Input = {
    entry: string[],
    members: Members,
    identities: ListColumn,
    definition: u64,
    items: Selected[]
}

export default function (in: Input): Output {
    const count = memory.listLength(in.identities, in.definition)

    return next({
        entry: in.entry,
        members: in.members,
        identities: in.identities,
        definition: in.definition,
        count,
        items: in.items
    })
}
