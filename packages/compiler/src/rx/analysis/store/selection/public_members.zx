import integers from "std:integer"
import find from "core/store_table/find"

import { Choice } from "./model"

import type { Members } from "./model"

export type Input = {
    members: Members,
    identity: string
}

export type Output = Choice

export default function (in: Input): Output {
    const members = in.members
    const identity = in.identity

    return loop({
        position: 0,
        result: Choice.Unused
    }, {
        while: state =>
            state.position < members.ids.length && state.result == Choice.Unused,
        next: state => {
            const row = integers.widen(members.ids[state.position])

            if (row >= members.stores.length) {
                state.result = Choice.InvalidMember
            } else {
                const paths = members.stores[row].paths

                if (find({
                    paths,
                    identity
                }) != null) {
                    state.result = Choice.Needed
                }
            }

            state.position += 1
        },
        return: state => state.result
    })
}
