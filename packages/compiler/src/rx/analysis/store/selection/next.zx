import find from "core/store_table/find"
import memory from "memory"

import { Choice } from "./model"
import publicMembers from "./public_members"

import type { ListColumn } from "memory"
import type { Members, Result as Output, Selected } from "./model"

export type Input = {
    entry: string[],
    members: Members,
    identities: ListColumn,
    definition: u64,
    count: u64,
    items: Selected[]
}

export default function (in: Input): Output {
    return loop({
        next: 0,
        items: in.items,
        valid: true
    }, {
        while: state => state.valid && state.next < in.count,
        next: state => {
            const identity =
                memory.readListText(in.identities, in.definition, state.next)
            const entry = find({
                paths: in.entry,
                identity
            })

            const choice = match {
                entry != null => Choice.Needed,
                _ => publicMembers({
                    members: in.members,
                    identity
                })
            }

            if (choice == Choice.Needed) {
                state.items = state.items.push({
                    definition: in.definition,
                    object: state.next
                })[0]
            }

            state.valid = choice != Choice.InvalidMember
            state.next += 1
        },
        return: state => ({
            valid: state.valid,
            items: state.items
        })
    })
}
