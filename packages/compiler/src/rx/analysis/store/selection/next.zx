import integers from "std:integer"
import memory from "zig:compiler_memory"
import find from "core/store_table/find"

import { Choice } from "./model"
import publicMembers from "./public_members"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    return loop({
        next: in.first,
        written: 0,
        valid: true
    }, {
        while: state =>
            state.valid && state.next < in.count && state.written < in.capacity,
        next: state => {
            const identity = memory.readTextColumn(in.identities, state.next)
            const entry = find({
                paths: in.entry,
                identity
            })

            const choice = match {
                entry != null => Choice.Needed,
                _ => publicMembers({
                    members: in.members,
                    identity
                })
            }

            if (choice == Choice.Needed) {
                memory.writeU32(
                    in.selected,
                    state.written,
                    integers.narrow(state.next)
                )
                state.written += 1
            }

            state.valid = choice != Choice.InvalidMember
            state.next += 1
        },
        return: state => state
    })
}
