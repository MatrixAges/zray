<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Output} />

    <If on={$in.entry.length == 0 && $in.members.ids.length == 0}>
        <Return
            value={{
                next: $in.count,
                written: 0,
                valid: true
            }}
        />
    </If>

    <Call fn="next" in={$in} />

    <Return value={$ctx.next} />
</Module>
