import type { Stores } from "core/store_table/model"
import type { ListColumn } from "memory"

export type Members = {
    ids: u32[],
    stores: Stores[]
}

export type Selected = {
    definition: u64,
    object: u64
}

export type Collection = {
    entry: string[],
    members: Members,
    identities: ListColumn,
    count: u64
}

export type Result = {
    valid: bool,
    items: Selected[]
}

export enum Choice {
    Unused,
    Needed,
    InvalidMember
}
