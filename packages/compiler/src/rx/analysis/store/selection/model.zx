import type { TextColumn, U32Buffer } from "std:memory"
import type { Stores } from "core/store_table/model"

export type Members = {
    ids: u32[],
    stores: Stores[]
}

export type Input = {
    entry: string[],
    members: Members,
    identities: TextColumn,
    count: u64,
    first: u64,
    selected: U32Buffer,
    capacity: u64
}

export enum Choice {
    Unused,
    Needed,
    InvalidMember
}

export type Output = {
    next: u64,
    written: u64,
    valid: bool
}
