import memory from "memory"

import select from "./definition"

import type { Collection as Input, Result as Output, Selected } from "./model"

export default function (in: Input): Output {
    const empty: Selected[] = []

    if (in.entry.length == 0 && in.members.ids.length == 0) {
        return {
            valid: true,
            items: empty
        }
    }

    return loop({
        definition: 0,
        items: empty,
        valid: true
    }, {
        while: state => state.valid && state.definition < in.count,
        next: state => {
            const result = select({
                entry: in.entry,
                members: in.members,
                identities: in.identities,
                definition: state.definition,
                items: state.items
            })

            state.items = result.items
            state.valid = result.valid
            state.definition += 1
        },
        return: state => ({
            valid: state.valid,
            items: state.items
        })
    })
}
