<Module>
    <Type from="model" as="Namespace" />

    <Args in={Namespace.Declaration} out={Namespace.Binding} />

    <Call
        fn="../../result_name/identifier"
        in={{
            name: $in.explicit ?? $in.fallback,
            allow_dollar: false
        }}
    />

    <If on={!$ctx.identifier}>
        <Return
            value={{
                index: $in.index,
                status: Namespace.Status.Invalid,
                name: $in.explicit ?? $in.fallback
            }}
        />
    </If>

    <Call
        fn="claim"
        in={{
            index: $in.index,
            name: $in.explicit ?? $in.fallback
        }}
    />

    <Return
        value={{
            ...$ctx.claim,
            name: $in.explicit ?? $in.fallback
        }}
    />
</Module>
