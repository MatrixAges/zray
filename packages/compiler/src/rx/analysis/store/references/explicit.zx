import columns from "memory/columns"

import type { Prepare } from "./model"

export type Input = Prepare.Pick("alias", "layout")

export type Output = string?

export default function (in: Input): Output {
    const alias = in.alias

    if (alias == null) {
        return null
    }

    return columns.readBorrowedRowText(alias, in.layout.attribute_value)
}
