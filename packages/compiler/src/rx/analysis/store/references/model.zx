import type { Index as NamespaceIndex } from "core/bytes/index/model"
import type { TextColumn } from "memory"
import type { Layout } from "../../../syntax/tree/layout"

export type Index = NamespaceIndex

export type Stores = {
    names: TextColumn,
    first: u64
}

export enum Status {
    Accepted,
    Invalid,
    Duplicate
}

export type Input = {
    index: Index,
    name: string
}

export type Output = {
    index: Index,
    status: Status
}

export type Declaration = {
    index: Index,
    explicit?: string,
    fallback: string
}

export type Binding = Output & {
    name: string
}

export type Prepare = {
    stores: Stores,
    owner: u64,
    alias?: u8[],
    layout: Layout,
    index: Index
}

export type Selection = {
    binding: Binding,
    message?: string
}
