import type { Index as NamespaceIndex } from "core/bytes/index/model"
import type { DeclarationTarget } from "rx_project_host"
import type { Layout } from "../../../syntax/tree/layout"

export type Index = NamespaceIndex

export enum Status {
    Accepted,
    Invalid,
    Duplicate
}

export type Input = {
    index: Index,
    name: string
}

export type Output = {
    index: Index,
    status: Status
}

export type Declaration = {
    index: Index,
    explicit?: string,
    fallback: string
}

export type Binding = Output & {
    name: string
}

export type Prepare = {
    target: DeclarationTarget,
    edge?: u64,
    from: u8[],
    alias?: u8[],
    layout: Layout,
    index: Index
}
