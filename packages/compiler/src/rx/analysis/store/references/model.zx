import type { Index } from "core/bytes/index/model"

export enum Status {
    Accepted,
    Invalid,
    Duplicate
}

export type Input = {
    index: Index,
    name: string
}

export type Output = {
    index: Index,
    status: Status
}

export type Declaration = {
    index: Index,
    explicit?: string,
    fallback: string
}

export type Binding = Output & {
    name: string
}
