import bytes from "std:bytes"
import claim from "core/bytes/index/claim"

import { Status } from "./model"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const claimed = claim({
        index: in.index,
        key: bytes.fromText(in.name),
        value: 0
    })

    return {
        index: claimed.index,
        status: claimed.previous == null ? Status.Accepted : Status.Duplicate
    }
}
