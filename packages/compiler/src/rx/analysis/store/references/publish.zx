import memory from "memory"

import objectName from "./object_name"

import type {
    ReadColumn,
    StringBuffer,
    TextColumn,
    U32Buffer
} from "memory"

export type Objects = {
    names: TextColumn,
    identities: TextColumn,
    ids: ReadColumn,
    count: u64
}

export type Bindings = {
    names: StringBuffer,
    paths: StringBuffer,
    ids: U32Buffer
}

export type Input = {
    scope: string,
    objects: Objects,
    bindings: Bindings
}

export type Output = bool

export default function (in: Input): Output {
    const { objects, bindings, scope } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < objects.count,
        next: state => {
            const row = state.row
            const object = memory.readTextColumn(objects.names, row)
            const name = objectName({
                scope,
                object
            })

            if (name == null) {
                state.valid = false
            } else {
                const identity = memory.readTextColumn(objects.identities, row)
                const id = memory.readColumnU32(objects.ids, row)

                memory.writeString(bindings.names, row, name)
                memory.writeString(bindings.paths, row, identity)
                memory.writeU32(bindings.ids, row, id)
            }

            state.row += 1
        },
        return: state => state.valid
    })
}
