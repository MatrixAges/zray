import memory from "memory"

import objectName from "./object_name"

import type { ReadColumn, TextColumn } from "memory"

export type Objects = {
    names: TextColumn,
    identities: TextColumn,
    ids: ReadColumn,
    count: u64
}

export type Input = {
    scope: string,
    objects: Objects
}

export type Row = {
    name: string,
    path: string,
    type_id: u32
}

export type Output = {
    valid: bool,
    rows: Row[]
}

export default function (in: Input): Output {
    const { objects, scope } = in

    const empty: Row[] = []

    return loop({
        row: 0,
        valid: true,
        rows: empty
    }, {
        while: state => state.valid && state.row < objects.count,
        next: state => {
            const row = state.row
            const object = memory.readTextColumn(objects.names, row)
            const name = objectName({
                scope,
                object
            })

            if (name == null) {
                state.valid = false
            } else {
                const identity = memory.readTextColumn(objects.identities, row)
                const id = memory.readColumnU32(objects.ids, row)

                state.rows = state.rows.push({
                    name,
                    path: identity,
                    type_id: id
                })[0]
            }

            state.row += 1
        },
        return: state => ({
            valid: state.valid,
            rows: state.rows
        })
    })
}
