<Module>
    <Type from="model" as="Namespace" />

    <Args in={Namespace.Prepare} out={Namespace.Selection} />

    <Call
        fn="names"
        in={$in.omit(["index"])}
    />

    <Call
        module="register"
        in={{
            index: $in.index,
            ...$ctx.names
        }}
    />

    <If on={$ctx.register.status == Namespace.Status.Accepted}>
        <Return
            value={{
                binding: $ctx.register,
                message: null
            }}
        />
    </If>

    <Call fn="diagnostic" in={$ctx.register.status} />

    <Return
        value={{
            binding: $ctx.register,
            message: $ctx.diagnostic
        }}
    />
</Module>
