import memory from "memory"

import type { Load } from "./model"

export type Input = Load.Pick("types", "scratch") & {
    view: u8[]
}

export type Output = void

export default function (in: Input): Output {
    memory.copyColumnValue(in.types, 0, in.view)

    const released = memory.resetArenaRetainingCapacity(in.scratch)
}
