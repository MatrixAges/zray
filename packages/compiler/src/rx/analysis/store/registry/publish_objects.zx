import memory from "memory"

import type { Tables } from "./model"

export type Input = {
    tables: Tables,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { tables, count } = in

    const written = loop(0, {
        while: row => row < count,
        next: row => {
            memory.copyColumnValue(tables.types, row, tables.type_view)
            memory.copyColumnValue(tables.natives, row, tables.native_view)

            row += 1
        }
    })
}
