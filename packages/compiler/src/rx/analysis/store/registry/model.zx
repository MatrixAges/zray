export type Load = {
    count: u64,
    row: u64
}

export enum LoadStep {
    BindAliases,
    Compile
}

export type Effect = {
    step: LoadStep,
    row: u64
}

export type Publication = {
    retained: bool,
    count: u64,
    row: u64
}

export type PublishedDefinition = {
    row: u64,
    copy_objects: bool
}
