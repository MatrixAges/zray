<Module>
    <Type from="model" as="Registry" />

    <Args in={Registry.Load} out={Registry.Load} />

    <Store from="loading" as="loading" />

    <Call
        fn="stage_load"
        in={{
            step: Registry.LoadStep.BindAliases,
            row: $in.row
        }}
        setter={[$store.loading.effect]}
    />

    <Call
        fn="stage_load"
        in={{
            step: Registry.LoadStep.Compile,
            row: $in.row
        }}
        setter={[$store.loading.effect]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
