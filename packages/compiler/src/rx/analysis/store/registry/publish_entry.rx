<Module>
    <Type from="model" as="Registry" />

    <Args in={Registry.Publication} out={Registry.Publication} />

    <Store from="publication" as="publication" />

    <Call
        fn="stage_publication"
        in={{
            row: $in.row,
            copy_objects: $in.retained
        }}
        setter={[$store.publication.definition]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
