<Module>
    <Type from="model" as="Registry" />

    <Args in={Registry.Publication} out={Registry.Publication} />

    <Call
        fn="host.openStoreRegistryPublication"
        in={[
            $in.state,
            $in.row
        ]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
