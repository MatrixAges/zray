<Module>
    <Type from="model" as="Definition" />
    <Type from="effect" as="Effect" />

    <Args in={Definition.Objects} out={Definition.Objects} />

    <Store from="definition" as="definition" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.CompileObject,
            row: $in.row
        }}
        setter={[$store.definition.effect]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
