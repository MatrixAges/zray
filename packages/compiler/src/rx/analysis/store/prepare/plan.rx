<Module>
    <Type from="model" as="StorePlan" />

    <Args in={StorePlan.Form} out={StorePlan.Step[]} />

    <Switch on={$in}>
        <Case value={StorePlan.Form.Definition}>
            <Return
                value={[
                    StorePlan.Step.CollectLayout,
                    StorePlan.Step.ResolveTypes,
                    StorePlan.Step.PrepareValues,
                    StorePlan.Step.CompileObjects,
                    StorePlan.Step.PublishDefinition
                ]}
            />
        </Case>

        <Case value={StorePlan.Form.TypeContext}>
            <Return
                value={[
                    StorePlan.Step.CheckTypes,
                    StorePlan.Step.CheckNativeTypes,
                    StorePlan.Step.CheckNominalTypes,
                    StorePlan.Step.CheckAliases
                ]}
            />
        </Case>
    </Switch>
</Module>
