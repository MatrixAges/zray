<Module>
    <Type from="model" as="StorePlan" />

    <Args in={StorePlan.Form} out={StorePlan.Step[]} />

    <Switch on={$in}>
        <Case value={StorePlan.Form.Definition}>
            <Return
                value={[
                    StorePlan.Step.CollectLayout,
                    StorePlan.Step.ResolveTypes,
                    StorePlan.Step.PrepareValues,
                    StorePlan.Step.CompileObjects,
                    StorePlan.Step.PublishDefinition
                ]}
            />
        </Case>

        <Case value={StorePlan.Form.Field}>
            <Return
                value={[
                    StorePlan.Step.ReadFieldAttributes,
                    StorePlan.Step.ParseField,
                    StorePlan.Step.CompileField,
                    StorePlan.Step.RecordField,
                    StorePlan.Step.LinkField
                ]}
            />
        </Case>

        <Case value={StorePlan.Form.Program}>
            <Return
                value={[
                    StorePlan.Step.ResolveObjectType,
                    StorePlan.Step.CheckLinks,
                    StorePlan.Step.BuildProgram,
                    StorePlan.Step.AnalyzeOwnership,
                    StorePlan.Step.VerifyProgram
                ]}
            />
        </Case>

        <Case value={StorePlan.Form.TypeContext}>
            <Return
                value={[
                    StorePlan.Step.CheckTypes,
                    StorePlan.Step.CheckNativeTypes,
                    StorePlan.Step.CheckNominalTypes,
                    StorePlan.Step.CheckAliases
                ]}
            />
        </Case>
    </Switch>
</Module>
