import { compileStoreDefinitionObject } from "rx_project_host"

import type { Objects as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const completed = loop(0, {
        while: row => row < in.count,
        next: row => {
            compileStoreDefinitionObject(in.state, row)

            row += 1
        }
    })
}
