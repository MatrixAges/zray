import memory from "memory"

import type { TypePublication as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const completed = loop(0, {
        while: row => row < in.count,
        next: row => {
            memory.copyColumnValue(in.output_types, row, in.view)

            row += 1
        }
    })
}
