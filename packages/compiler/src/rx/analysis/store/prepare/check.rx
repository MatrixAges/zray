<Module>
    <Type from="model" as="Definition" />
    <Type from="effect" as="Effect" />

    <Args in={Definition.Input} out={void} />

    <Store from="definition" as="definition" />

    <Call module="../../../../zx/modules/project/state/check" in={$in.shared} />

    <Call
        fn="context_issue"
        in={{
            shared: $ctx.check,
            aliases: $in.aliases
        }}
    />

    <If on={$ctx.context_issue != null}>
        <Call
            fn="stage"
            in={{
                step: Effect.Step.RejectContext,
                message: $ctx.context_issue
            }}
            setter={[$store.definition.effect]}
        />
    </If>
</Module>
