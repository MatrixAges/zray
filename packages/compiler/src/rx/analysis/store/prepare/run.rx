<Module>
    <Type from="model" as="Definition" />
    <Type from="effect" as="Effect" />

    <Args in={Definition.Input} out={void} />

    <Store from="definition" as="definition" />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.CollectLayout
        }}
        setter={[$store.definition.effect]}
    />

    <Call module="check" in={$in} />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ResolveTypes
        }}
        setter={[$store.definition.effect]}
    />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.ReserveObjects
        }}
        setter={[$store.definition.effect]}
    />

    <Call fn="read_count" in={$store.definition.effect} />

    <Loop on={$in.row < $in.count}>
        <Call
            module="compile"
            in={{
                count: $ctx.read_count,
                row: 0
            }}
        />
    </Loop>

    <Call
        fn="stage"
        in={{
            step: Effect.Step.FreezeTypes
        }}
        setter={[$store.definition.effect]}
    />

    <Call
        fn="stage"
        in={{
            step: Effect.Step.Publish
        }}
        setter={[$store.definition.effect]}
    />
</Module>
