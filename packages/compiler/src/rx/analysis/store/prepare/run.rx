<Module>
    <Type from="model" as="Definition" />

    <Args in={Definition.Input} out={void} />

    <Call fn="host.collectStoreDefinitionLayout" in={$in.state} />

    <Call module="check" in={$in} />

    <Call fn="host.resolveStoreDefinitionTypes" in={$in.state} />
    <Call fn="host.reserveStoreDefinitionObjects" in={$in.state} />

    <Call
        fn="compile"
        in={{
            state: $in.state,
            count: $ctx.reserveStoreDefinitionObjects
        }}
    />

    <Call fn="host.freezeStoreDefinitionTypes" in={$in.state} />
    <Call fn="host.publishStoreDefinition" in={$in.state} />
</Module>
