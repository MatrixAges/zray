import type { Node } from "./model"

export type Input = {
    nodes: Node[]
}

export type Output = {
    first: u64[],
    next: u64[]
}

export default function (in: Input): Output {
    const empty: u64[] = []

    const zeros = loop(empty, {
        while: out => out.length < in.nodes.length,
        next: out => {
            out = out.push(0)[0]
        }
    })

    return loop({
        row: 0,
        first: zeros,
        next: zeros
    }, {
        while: state => state.row < in.nodes.length,
        next: state => {
            const reversed = loop({
                remaining: in.nodes[state.row].children,
                head: 0,
                next: state.next
            }, {
                while: inner => inner.remaining != 0,
                next: inner => {
                    const child = inner.remaining - 1

                    inner.next = inner.next.splice(child, 1, [inner.head])[0]
                    inner.head = inner.remaining
                    inner.remaining = in.nodes[child].previous_sibling
                }
            })

            state.next = reversed.next
            state.first = state.first.splice(state.row, 1, [reversed.head])[0]
            state.row += 1
        },
        return: state => state.omit(["row"])
    })
}
