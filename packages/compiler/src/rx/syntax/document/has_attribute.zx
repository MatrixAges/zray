import matches from "./name_matches"

import type { Attribute, Node } from "./model"

export type Input = {
    source: u8[],
    attributes: Attribute[],
    node: Node,
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    const { node, source } = in

    const end = node.attribute_start + node.attribute_count

    return loop({
        row: node.attribute_start,
        found: false
    }, {
        while: state => state.row < end && !state.found,
        next: state => {
            const name = in.attributes[state.row].name

            state.found = matches({
                source,
                start: name.start,
                end: name.end,
                name: in.name
            })
            state.row += 1
        },
        return: state => state.found
    })
}
