<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call
        fn="../slots"
        in={{
            nodes: $in.tree.nodes,
            text: $in.tree.text,
            root: $in.root
        }}
    />

    <Call
        fn="attributes"
        in={{
            ...$in.pick([
                "source",
                "decoded",
                "indexed"
            ]),
            rows: $in.tree.attributes,
            target: $in.attributes
        }}
    />

    <Call
        fn="text"
        in={{
            ...$in.pick([
                "source",
                "decoded",
                "indexed"
            ]),
            text_slots: $ctx.slots.text_slots,
            rows: $in.tree.text,
            target: $in.text,
            extent: $ctx.attributes
        }}
    />

    <Call
        fn="nodes"
        in={{
            ...$in.pick([
                "source",
                "storage"
            ]),
            node_slots: $ctx.slots.node_slots,
            rows: $in.tree.nodes,
            target: $in.nodes
        }}
    />

    <Return
        value={{
            extent: $ctx.text,
            node_slots: $ctx.slots.node_slots
        }}
    />
</Module>
