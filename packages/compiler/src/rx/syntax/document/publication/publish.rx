<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call
        fn="../slots"
        in={{
            nodes: $in.tree.nodes,
            text: $in.tree.text,
            root: $in.root
        }}
    />

    <Call
        fn="attributes"
        in={{
            ...$in.pick([
                "source",
                "decoded",
                "indexed"
            ]),
            rows: $in.tree.attributes
        }}
    />

    <Call
        fn="text"
        in={{
            ...$in.pick([
                "source",
                "decoded",
                "indexed"
            ]),
            text_slots: $ctx.slots.text_slots,
            rows: $in.tree.text,
            extent: $ctx.attributes.extent
        }}
    />

    <Call
        fn="nodes"
        in={{
            source: $in.source,
            node_slots: $ctx.slots.node_slots,
            rows: $in.tree.nodes
        }}
    />

    <Return
        value={{
            extent: $ctx.text.extent,
            node_slots: $ctx.slots.node_slots,
            attributes: $ctx.attributes.items,
            text: $ctx.text.items,
            nodes: $ctx.nodes
        }}
    />
</Module>
