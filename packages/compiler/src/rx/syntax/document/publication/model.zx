import type { Location } from "../../model"
import type { Tree } from "../model"

export type PublishedAttribute = {
    kind: u8,
    name: string,
    value: string,
    raw_value: string,
    location: Location,
    value_location: Location
}

export type PublishedText = {
    slot: u64,
    value: string,
    location: Location
}

export type PublishedNode = {
    slot: u64,
    name: string,
    location: Location,
    attribute_start: u64,
    attribute_count: u64,
    child_start: u64,
    child_count: u64,
    text_start: u64,
    text_count: u64
}

export type Input = {
    source: string,
    decoded: string,
    tree: Tree,
    root: u64,
    indexed: bool
}

export type Output = {
    extent: u64,
    node_slots: u64[],
    attributes: PublishedAttribute[],
    text: PublishedText[],
    nodes: PublishedNode[]
}
