import encoding from "std:encoding"

import value from "./value"

import type { Text as Row } from "../model"
import type { Input as Publication, PublishedText } from "./model"

export type Input = Publication.Pick("source", "decoded", "indexed") & {
    text_slots: u64[],
    rows: Row[],
    extent: u64
}

export type Output = {
    extent: u64,
    items: PublishedText[]
}

export default function (in: Input): Output {
    const { source, decoded, indexed, rows, text_slots } = in

    const empty: PublishedText[] = []

    return loop({
        row: 0,
        extent: in.extent,
        items: empty
    }, {
        while: state => state.row < rows.length,
        next: state => {
            const item = rows[state.row]
            const slot = text_slots[state.row]
            const span = item.value.span
            const original = encoding.sliceBytes(source, span.start, span.end)
            const selected = value({
                original,
                decoded,
                ...item.value.pick([
                    "decoded_start",
                    "decoded_end"
                ])
            })
            const { location } = item

            state.items = state.items.push({
                slot,
                value: selected,
                location
            })[0]

            if (indexed) {
                const end = location.offset + selected.length

                if (end > state.extent) {
                    state.extent = end
                }
            }

            state.row += 1
        },
        return: state => state.pick([
            "extent",
            "items"
        ])
    })
}
