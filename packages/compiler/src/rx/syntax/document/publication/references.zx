import { Role, Target } from "../../../dependency_graph/reference/model"
import {
    role_call,
    role_dependency,
    role_type_import,
    target_function,
    target_module,
    target_store
} from "./const"

import type { Reference } from "../../../dependency_graph/reference/model"

export type PublishedReference = {
    node_slot: u64,
    attribute?: u64,
    target: u8,
    role: u8,
    package_allowed: bool,
    graph: bool
}

export type Input = {
    rows: Reference[],
    slots: u64[]
}

export type Output = PublishedReference[]

export default function (in: Input): Output {
    const { rows, slots } = in

    const empty: PublishedReference[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < rows.length,
        next: state => {
            const item = rows[state.row]
            const target = match item.target {
                Target.Function => target_function,
                Target.Store => target_store,
                _ => target_module
            }
            const role = match item.role {
                Role.Call => role_call,
                Role.TypeImport => role_type_import,
                _ => role_dependency
            }

            state.items = state.items.push({
                node_slot: slots[item.node],
                attribute: item.attribute,
                target,
                role,
                package_allowed: item.package_allowed,
                graph: item.graph
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
