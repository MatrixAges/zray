import encoding from "std:encoding"
import memory from "memory/columns"

import { attribute_expression, attribute_string } from "./const"
import value from "./value"

import type { Attribute } from "../model"
import type { Attributes, Input as Publication } from "./model"

export type Input = Publication.Pick("source", "decoded", "indexed") & {
    rows: Attribute[],
    target: Attributes
}

export type Output = u64

export default function (in: Input): Output {
    const { source, decoded, indexed, rows, target } = in

    return loop({
        row: 0,
        extent: 0
    }, {
        while: state => state.row < rows.length,
        next: state => {
            const row = state.row
            const item = rows[row]
            const { location, value_location } = item
            const name = encoding.sliceBytes(source, item.name.start, item.name.end)
            const span = item.value.span
            const original = encoding.sliceBytes(source, span.start, span.end)
            const selected = value({
                original,
                decoded,
                ...item.value.pick([
                    "decoded_start",
                    "decoded_end"
                ])
            })
            const kind = item.expression ? attribute_expression : attribute_string

            memory.writeColumnU8(target.kind, row, kind)
            memory.writeColumnText(target.name, row, name)
            memory.writeColumnText(target.value, row, selected)
            memory.writeColumnOptionalText(target.raw_value, row, original)
            memory.writeColumnIndex(target.offset, row, location.offset)
            memory.writeColumnIndex(target.line, row, location.line)
            memory.writeColumnIndex(target.column, row, location.column)
            memory.writeColumnIndex(
                target.value_offset,
                row,
                value_location.offset
            )
            memory.writeColumnIndex(target.value_line, row, value_location.line)
            memory.writeColumnIndex(
                target.value_column,
                row,
                value_location.column
            )

            if (indexed) {
                const name_end = location.offset + name.length
                const value_end = value_location.offset + original.length
                const end = name_end > value_end ? name_end : value_end

                if (end > state.extent) {
                    state.extent = end
                }
            }

            state.row += 1
        },
        return: state => state.extent
    })
}
