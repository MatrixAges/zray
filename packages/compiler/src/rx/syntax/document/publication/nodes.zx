import encoding from "std:encoding"

import type { Node } from "../model"
import type { Input as Publication, PublishedNode } from "./model"

export type Input = Publication.Pick("source") & {
    node_slots: u64[],
    rows: Node[]
}

export type Output = PublishedNode[]

export default function (in: Input): Output {
    const { source, rows, node_slots } = in

    const empty: PublishedNode[] = []

    return loop({
        row: 0,
        child_start: 1,
        text_start: 0,
        items: empty
    }, {
        while: state => state.row < rows.length,
        next: state => {
            const item = rows[state.row]
            const slot = node_slots[state.row]
            const { location } = item
            const name = encoding.sliceBytes(source, item.name.start, item.name.end)

            state.items = state.items.push({
                slot,
                name,
                location,
                attribute_start: item.attribute_start,
                attribute_count: item.attribute_count,
                child_start: state.child_start,
                child_count: item.child_count,
                text_start: state.text_start,
                text_count: item.text_count
            })[0]

            state.child_start += item.child_count
            state.text_start += item.text_count
            state.row += 1
        },
        return: state => state.items
    })
}
