import bytes from "std:bytes"

import utf8 from "./utf8"

import type { Part } from "../../model"

export type Input = {
    source: u8[],
    parts: Part[]
}

export type Output = u8[]

export default function (in: Input): Output {
    const empty: u8[][] = []

    const chunks = loop({
        index: 0,
        parts: empty
    }, {
        while: state => state.index < in.parts.length,
        next: state => {
            const part = in.parts[state.index]
            const chunk: u8[] = match {
                part.character => utf8(part.codepoint),
                _ => in.source.splice(
                    part.span.start,
                    part.span.end - part.span.start,
                    []
                )[1]
            }

            state.parts = state.parts.push(chunk)[0]
            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join([], chunks)
}
