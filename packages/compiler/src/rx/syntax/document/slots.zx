import type { Node, Text } from "./model"

export type Input = {
    nodes: Node[],
    text: Text[],
    root: u64
}

export type Output = {
    node_slots: u64[],
    text_slots: u64[]
}

export default function (in: Input): Output {
    const empty: u64[] = []

    const zero_nodes = loop(empty, {
        while: out => out.length < in.nodes.length,
        next: out => {
            out = out.push(0)[0]
        }
    })

    const zero_text = loop(empty, {
        while: out => out.length < in.text.length,
        next: out => {
            out = out.push(0)[0]
        }
    })

    return loop({
        index: 0,
        child_end: 1,
        text_end: 0,
        node_slots: zero_nodes.splice(in.root, 1, [0])[0],
        text_slots: zero_text
    }, {
        while: state => state.index < in.nodes.length,
        next: state => {
            const node = in.nodes[state.index]
            const child_end = state.child_end + node.child_count
            const text_end = state.text_end + node.text_count

            const children = loop({
                head: node.children,
                cursor: child_end,
                slots: state.node_slots
            }, {
                while: child => child.head != 0,
                next: child => {
                    const index = child.head - 1

                    child.cursor -= 1
                    child.slots = child.slots.splice(index, 1, [child.cursor])[0]
                    child.head = in.nodes[index].previous_sibling
                }
            })

            const text = loop({
                head: node.text,
                cursor: text_end,
                slots: state.text_slots
            }, {
                while: item => item.head != 0,
                next: item => {
                    const index = item.head - 1

                    item.cursor -= 1
                    item.slots = item.slots.splice(index, 1, [item.cursor])[0]
                    item.head = in.text[index].previous
                }
            })

            state.node_slots = children.slots
            state.text_slots = text.slots
            state.index += 1
            state.child_end = child_end
            state.text_end = text_end
        },
        return: state => state.pick([
            "node_slots",
            "text_slots"
        ])
    })
}
