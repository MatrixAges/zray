import probe from "core/bytes/index/slot"

import { Issue } from "../model"

import type { Output as Edge, Registry } from "./model"

export type Input = {
    registry: Registry,
    path: u8[]
}

export type Output = Edge

export default function (in: Input): Output {
    const found = probe({
        ...in.registry,
        key: in.path
    })

    return {
        included: true,
        target: found.entry == 0 ? 0 : found.entry - 1,
        issue: found.entry == 0 ? Issue.Missing : Issue.None
    }
}
