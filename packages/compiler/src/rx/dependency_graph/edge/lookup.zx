import fixed from "core/bytes/index/fixed"
import memory from "memory"

import { Issue } from "../model"

import type { Output as Edge, Registry } from "./model"

export type Input = {
    registry: Registry,
    bytes: u8[],
    length: u64
}

export type Output = Edge

export default function (in: Input): Output {
    const key = memory.borrowU8Range(in.bytes, 0, in.length)

    const row = fixed({
        ...in.registry,
        key,
        insert: null
    })

    return {
        included: true,
        target: row ?? 0,
        issue: row == null ? Issue.Missing : Issue.None,
        required: 0
    }
}
