import memory from "memory"

import type { U64Buffer } from "memory"

export type Input = {
    offsets: U64Buffer,
    first: u64,
    end: u64,
    edge: u64
}

export type Output = void

export default function (in: Input): Output {
    const { offsets, end, edge } = in

    const written = loop(in.first, {
        while: row => row < end,
        next: row => {
            memory.writeU64(offsets, row, edge)
            row += 1
        }
    })
}
