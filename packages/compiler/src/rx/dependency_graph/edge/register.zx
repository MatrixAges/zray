import memory from "memory"
import columns from "memory/columns"

import { issue_invalid_path, issue_missing, issue_none } from "../const"
import { Issue } from "../model"
import resolve from "./resolve"

import type { Allocator, ReadColumn, U64Buffer, U8Buffer } from "memory"
import type { IndirectTextColumn } from "memory/columns"
import type { Input as Edge } from "./model"

export type Indexed = {
    values: IndirectTextColumn,
    graph: ReadColumn,
    packages: ReadColumn,
    count: u64
}

export type Candidates = {
    references: string[],
    package_allowed: u8[],
    first: u64,
    indexed?: Indexed
}

export type Columns = {
    targets: U64Buffer,
    issues: U8Buffer,
    references: U64Buffer
}

export type Input = Edge.Omit("reference", "package_allowed") & {
    allocator: Allocator,
    candidates: Candidates,
    output: Columns
}

export type Output = u64

export default function (in: Input): Output {
    const { candidates, output, workspace } = in

    const indexed = candidates.indexed

    const count = match {
        indexed == null => candidates.references.length,
        _ => indexed.count - candidates.first
    }

    return loop({
        processed: 0,
        written: 0,
        bytes: workspace.bytes
    }, {
        while: state => state.processed < count,
        next: state => {
            const position = candidates.first + state.processed
            const row = indexed == null ? state.processed : indexed.count - position - 1
            const graph = indexed == null || memory.readColumnBool(indexed.graph, row)

            if (graph) {
                const reference = match {
                    indexed == null => candidates.references[row],
                    _ => columns.readIndirectTextColumn(indexed.values, row)
                }

                const package_allowed = match {
                    indexed == null => candidates.package_allowed[row] != 0,
                    _ => memory.readColumnBool(indexed.packages, row)
                }

                const request = {
                    directory: in.directory,
                    packages: in.packages,
                    registry: in.registry,
                    workspace: {
                        ...workspace,
                        bytes: state.bytes
                    },
                    reference,
                    package_allowed
                }

                const first = resolve(request)

                if (first.required != 0) {
                    state.bytes = memory.allocateU8Buffer(
                        in.allocator,
                        workspace.target,
                        workspace.start + first.required
                    )
                }

                const edge = match first.required {
                    0 => first,
                    _ => resolve({
                        ...request,
                        workspace: {
                            ...request.workspace,
                            bytes: state.bytes
                        }
                    })
                }

                if (edge.included) {
                    const issue = match edge.issue {
                        Issue.InvalidPath => issue_invalid_path,
                        Issue.Missing => issue_missing,
                        _ => issue_none
                    }

                    const original = indexed == null ? position : row

                    memory.writeU64(output.targets, state.written, edge.target)
                    memory.writeU8(output.issues, state.written, issue)
                    memory.writeU64(output.references, state.written, original)

                    state.written += 1
                }
            }

            state.processed += 1
        },
        return: state => state.written
    })
}
