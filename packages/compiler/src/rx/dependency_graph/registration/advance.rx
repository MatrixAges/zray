<Module>
    <Type from="model" as="Registration" />

    <Args in={Registration.Cursor} out={Registration.Cursor} />

    <Call
        fn="path"
        in={{
            paths: $in.request.paths,
            row: $in.row
        }}
    />

    <If on={$ctx.path.issue != null}>
        <Call
            fn="host.rejectGraphModuleRegistration"
            in={[
                $in.request.frame,
                $in.row,
                $ctx.path.issue ?? ""
            ]}
        />
    </If>

    <Call
        fn="host.validateRegisteredGraphModule"
        in={[
            $in.request.frame,
            $in.row,
            $ctx.path.normalized
        ]}
    />

    <Return
        value={{
            request: $in.request,
            row: $in.row + 1
        }}
    />
</Module>
