import { Kind } from "../../path_kind/model"
import normalize from "../../path_segments/normalize"
import write from "../../path_segments/walk"

export type Input = u8[]

export type Output = u8[]?

export default function (in: Input): Output {
    const plan = normalize({
        directory: [],
        path: in,
        kind: Kind.ModuleFile,
        suffix: ""
    })

    if (!plan.valid) {
        return null
    }

    return write({
        directory: [],
        path: in,
        suffix: plan.suffix,
        attached: plan.attached,
        collect: true
    }).text
}
