import bytes from "std:bytes"
import index from "core/bytes/index/fixed"
import memory from "memory"

import { Kind } from "../../path_kind/model"
import normalize from "../../path_segments/normalize"
import write from "../../path_segments/walk"
import { duplicate_path, invalid_path } from "./const"

import type { Paths } from "./model"

export type Input = {
    paths: Paths,
    row: u64
}

export type Output = {
    normalized: u8[],
    issue?: string
}

export default function (in: Input): Output {
    const { paths, row } = in

    const path = bytes.fromText(memory.readTextColumn(paths.source, row))

    const plan = normalize({
        directory: [],
        path,
        kind: Kind.ModuleFile,
        suffix: ""
    })

    if (!plan.valid) {
        return {
            normalized: [],
            issue: invalid_path
        }
    }

    const normalized = memory.allocateU8Buffer(paths.allocator, paths.path, plan.length)

    const written = write({
        directory: [],
        path,
        suffix: plan.suffix,
        attached: plan.attached,
        capacity: plan.length,
        target: paths.path
    })

    const previous = index({
        ...paths.registry,
        key: normalized,
        insert: row
    })

    if (previous != null) {
        return {
            normalized,
            issue: duplicate_path
        }
    }

    memory.writeU8List(paths.slots, row, normalized)

    return {
        normalized,
        issue: null
    }
}
