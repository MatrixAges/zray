import type { Table } from "core/bytes/index/fixed"
import type { TextColumn } from "memory"
import type { GraphModuleRegistration } from "rx_graph_host"

export type Paths = {
    source: TextColumn,
    count: u64,
    registry: Table
}

export type Request = {
    frame: GraphModuleRegistration,
    paths: Paths
}

export type Cursor = {
    request: Request,
    row: u64
}
