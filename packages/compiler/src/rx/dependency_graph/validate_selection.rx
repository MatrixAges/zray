<Module>
    <Type from="model" as="Graph" />
    <Type from="reachable" as="Reachability" />

    <Args
        in={{
            graph: Graph.ValidationInput,
            selection: Reachability.Selection
        }}
        out={
        Graph.Validation & {
            marks: u32[]
        }
        }
    />

    <Call module="validate" in={$in.graph} />

    <If on={$ctx.validate.message == null}>
        <Call
            fn="reachable"
            in={{
                ...$in.graph.pick([
                    "offsets",
                    "targets"
                ]),
                ...$in.selection,
                order: $ctx.validate.order,
                count: $ctx.validate.count
            }}
        />

        <Return
            value={{
                ...$ctx.validate,
                marks: $ctx.reachable
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.validate,
            marks: []
        }}
    />
</Module>
