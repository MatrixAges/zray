import columns from "memory/columns"

import next from "./next"

import type { Cursor } from "./model"

export type Input = {
    cursor: Cursor,
    capacity: u64
}

export type Output = {
    pending: u8[][],
    references: string[],
    packages: u8[]
}

export default function (in: Input): Output {
    const { cursor } = in

    const empty_references: string[] = []
    const empty_packages: u8[] = []

    return loop({
        pending: cursor.pending,
        references: empty_references,
        packages: empty_packages,
        done: false
    }, {
        while: state => !state.done && state.references.length < in.capacity,
        next: state => {
            const step = next({
                cursor: {
                    ...cursor,
                    pending: state.pending
                },
                graph_only: true,
                skip: 0
            })

            state.pending = step.pending
            const item = step.reference

            if (item == null) {
                state.done = true
            } else {
                const value = columns.readBorrowedRowText(
                    item.attribute ?? [],
                    cursor.layout.attribute_value
                )

                state.references = state.references.push(value)[0]
                state.packages = state.packages.push(item.package_allowed ? 1 : 0)[0]
            }
        },
        return: state => state.pick([
            "pending",
            "references",
            "packages"
        ])
    })
}
