import type { ByteViewStorage, ColumnAllocator } from "memory/columns"
import type { Role, Target } from "../model"

export type Layout = {
    node_width: u64,
    node_name: u64,
    node_children: u64,
    node_attributes: u64,
    attribute_width: u64,
    attribute_name: u64
}

export type Cursor = {
    pending: u8[],
    ancestors: ByteViewStorage,
    allocator: ColumnAllocator,
    layout: Layout
}

export type Reference = {
    node: u8[],
    attribute?: u8[],
    target: Target,
    role: Role,
    package_allowed: bool,
    graph: bool
}
