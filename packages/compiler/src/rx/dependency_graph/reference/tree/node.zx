import memory from "memory"
import columns from "memory/columns"

import type { Cursor as Input } from "./model"

export type Output = {
    pending: u8[][],
    node?: u8[]
}

export default function (in: Input): Output {
    const { layout, pending } = in

    if (pending.length == 0) {
        return {
            pending: [],
            node: null
        }
    }

    const last = pending.length - 1
    const available = pending[last]
    const width = layout.node_width
    const node = memory.borrowU8Range(available, 0, width)
    const siblings = memory.borrowU8Range(available, width, available.length - width)
    const children = columns.readBorrowedRowList(node, layout.node_children, width)

    const next = match {
        children.length == 0 && siblings.length == 0 => pending.pop()[0],
        children.length == 0 => pending.with(last, siblings),
        siblings.length == 0 => pending.with(last, children),
        _ => pending.with(last, siblings).push(children)[0]
    }

    return {
        node,
        pending: next
    }
}
