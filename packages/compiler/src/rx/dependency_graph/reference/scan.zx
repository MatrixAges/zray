import bytes from "std:bytes"
import encoding from "std:encoding"
import memory from "memory"

import { Tag } from "../../schema/execution/model"
import classify from "../../schema/execution/tag"
import taskExit from "../flow/task_exit"
import nodeFlow from "./node_flow"
import select from "./select"

import type { View } from "../flow/model"
import type { Reference, Scan as Input, Scanned as Output } from "./model"

export default function (in: Input): Output {
    const source = bytes.fromText(in.source)

    const view: View = {
        nodes: in.nodes,
        siblings: [],
        slots: in.slots,
        facts: in.facts
    }

    const columns = {
        step_rows: in.step_rows,
        unit_firsts: in.unit_firsts,
        unit_counts: in.unit_counts
    }

    const references: Reference[] = []
    const parents: u64[] = []
    const missing_input: u64? = null

    return loop({
        next: in.root + 1,
        finishing: false,
        module_steps: 0,
        parallel_tasks: 0,
        steps: 0,
        calls: 0,
        results: 0,
        tasks: 0,
        groups: 0,
        selections: 0,
        events: 0,
        source_extent: 0,
        graph_references: 0,
        parents,
        missing_input,
        references
    }, {
        while: state => state.next != 0,
        next: state => {
            const row = state.next - 1
            const node = in.nodes[row]

            if (in.project_flow && !state.finishing) {
                state.events = taskExit({
                    source,
                    node,
                    attributes: in.attributes,
                    slot: in.slots[row],
                    facts: in.facts,
                    events: in.events,
                    cursor: state.events
                })
            }

            if (!state.finishing && node.children != 0) {
                state.parents = state.parents.push(state.next)[0]
                state.next = node.children
            } else {
                const name =
                    encoding.sliceBytes(in.source, node.name.start, node.name.end)
                const tag = classify(name)

                const node_end = node.name.end - 1

                if (node_end > state.source_extent) {
                    state.source_extent = node_end
                }

                if (in.project_flow) {
                    const step = nodeFlow({
                        source,
                        nodes: in.nodes,
                        attributes: in.attributes,
                        node,
                        row,
                        slot: in.slots[row],
                        tag,
                        parents: state.parents,
                        facts: in.facts,
                        view,
                        columns,
                        module_steps: state.module_steps,
                        parallel_tasks: state.parallel_tasks,
                        steps: state.steps
                    })

                    if (step.parallel) {
                        state.parallel_tasks += 1
                    }

                    if (step.module_step) {
                        state.module_steps += 1
                    }

                    state.steps = step.steps

                    if (step.event != null) {
                        memory.writeU64(in.events, state.events, step.event)
                        state.events += 1
                    }

                    if (step.missing_input != null) {
                        state.missing_input = step.missing_input
                    }

                    if (step.call) {
                        state.calls += 1
                    } else if (tag == Tag.Return) {
                        state.results += 1
                    } else if (tag == Tag.Task) {
                        state.tasks += 1
                        state.results += step.implicit ? 1 : 0
                    } else if (tag == Tag.Parallel) {
                        state.groups += 1
                    } else if (tag == Tag.Switch || tag == Tag.If) {
                        state.selections += 1
                    }
                }

                const reference = select({
                    source,
                    node,
                    attributes: in.attributes,
                    row,
                    tag
                })

                if (reference != null) {
                    state.references = state.references.push(reference)[0]
                    state.graph_references += reference.graph ? 1 : 0
                }

                if (node.previous_sibling != 0) {
                    state.next = node.previous_sibling
                    state.finishing = false
                } else if (state.parents.length != 0) {
                    const popped = state.parents.pop()

                    state.parents = popped[0]
                    state.next = popped[1] ?? 0
                    state.finishing = true
                } else {
                    state.next = 0
                }
            }
        },
        return: state => ({
            references: state.references,
            graph_references: state.graph_references,
            parallel_tasks: state.parallel_tasks,
            steps: state.steps,
            calls: state.calls,
            results: state.results,
            tasks: state.tasks,
            groups: state.groups,
            selections: state.selections,
            events: state.events,
            missing_input: state.missing_input,
            source_extent: state.source_extent
        })
    })
}
