import bytes from "std:bytes"
import encoding from "std:encoding"
import integers from "std:integer"
import memory from "memory"

import { Tag } from "../../schema/execution/model"
import classify from "../../schema/execution/tag"
import bodyEvent from "../flow/body_event"
import { declaration } from "../flow/const"
import parallelParent from "../flow/parallel_parent"
import project from "../flow/project"
import taskExit from "../flow/task_exit"
import unit from "../flow/unit"
import select from "./select"

import type { U32Buffer, U64Buffer } from "memory"
import type { Attribute, Node } from "../../syntax/document/model"
import type { Reference } from "./model"

export type Input = {
    source: string,
    nodes: Node[],
    attributes: Attribute[],
    root: u64,
    parents: U64Buffer,
    slots: u64[],
    facts: U32Buffer,
    unit_firsts: U32Buffer,
    unit_counts: U32Buffer,
    step_rows: U32Buffer,
    events: U64Buffer,
    project_flow: bool
}

export type Output = {
    references: Reference[],
    graph_references: u64,
    parallel_tasks: u64,
    steps: u64,
    calls: u64,
    results: u64,
    tasks: u64,
    groups: u64,
    selections: u64,
    events: u64,
    source_extent: u64
}

export default function (in: Input): Output {
    const parents = in.parents
    const source = bytes.fromText(in.source)

    const view = {
        nodes: in.nodes,
        slots: in.slots,
        facts: in.facts
    }

    const columns = {
        step_rows: in.step_rows,
        unit_firsts: in.unit_firsts,
        unit_counts: in.unit_counts
    }

    const references: Reference[] = []

    return loop({
        next: in.root + 1,
        depth: 0,
        finishing: false,
        module_steps: 0,
        parallel_tasks: 0,
        steps: 0,
        calls: 0,
        results: 0,
        tasks: 0,
        groups: 0,
        selections: 0,
        events: 0,
        source_extent: 0,
        graph_references: 0,
        references
    }, {
        while: state => state.next != 0,
        next: state => {
            const row = state.next - 1
            const node = in.nodes[row]

            if (in.project_flow && !state.finishing) {
                state.events = taskExit({
                    source,
                    node,
                    attributes: in.attributes,
                    slot: in.slots[row],
                    facts: in.facts,
                    events: in.events,
                    cursor: state.events
                })
            }

            if (!state.finishing && node.children != 0) {
                memory.writeU64(parents, state.depth, state.next)
                state.depth += 1
                state.next = node.children
            } else {
                const name =
                    encoding.sliceBytes(in.source, node.name.start, node.name.end)
                const tag = classify(name)

                const node_end = node.name.end - 1

                if (node_end > state.source_extent) {
                    state.source_extent = node_end
                }

                if (in.project_flow) {
                    const slot = in.slots[row]
                    const parallel = tag == Tag.Task && parallelParent({
                        source,
                        nodes: view.nodes,
                        parents,
                        depth: state.depth
                    })

                    if (parallel) {
                        state.parallel_tasks += 1
                    }

                    const has_output =
                        tag == Tag.Task && memory.readU32(in.facts, slot) != 0
                    const implicit = parallel && has_output

                    const flags = project({
                        view,
                        row,
                        tag
                    })

                    const skipped = integers.andBits(
                        integers.widen(flags),
                        integers.widen(declaration)
                    )

                    if (state.depth == 1 && skipped == 0) {
                        state.module_steps += 1
                    }

                    const root_steps = match state.depth {
                        0 => state.module_steps,
                        _ => node.child_count
                    }

                    state.steps = unit({
                        geometry: {
                            children: {
                                view,
                                head: node.children
                            },
                            node,
                            tag,
                            root_steps,
                            implicit_result: implicit
                        },
                        columns,
                        slot,
                        start: state.steps,
                        flags,
                        task_output: has_output
                    })

                    if (state.depth != 0) {
                        const event = bodyEvent({
                            tag,
                            slot,
                            parallel_rank: parallel ? state.parallel_tasks : null
                        })

                        if (event != null) {
                            memory.writeU64(in.events, state.events, event)
                            state.events += 1
                        }
                    }

                    if (tag == Tag.Call) {
                        state.calls += 1
                    } else if (tag == Tag.Return) {
                        state.results += 1
                    } else if (tag == Tag.Task) {
                        state.tasks += 1
                        state.results += implicit ? 1 : 0
                    } else if (tag == Tag.Parallel) {
                        state.groups += 1
                    } else if (tag == Tag.Switch || tag == Tag.If) {
                        state.selections += 1
                    }
                }

                const reference = select({
                    source,
                    node,
                    attributes: in.attributes,
                    row,
                    tag
                })

                if (reference != null) {
                    state.references = state.references.push(reference)[0]
                    state.graph_references += reference.graph ? 1 : 0
                }

                if (node.previous_sibling != 0) {
                    state.next = node.previous_sibling
                    state.finishing = false
                } else if (state.depth != 0) {
                    state.depth -= 1
                    state.next = memory.readU64(parents, state.depth)
                    state.finishing = true
                } else {
                    state.next = 0
                }
            }
        },
        return: state => ({
            references: state.references,
            graph_references: state.graph_references,
            parallel_tasks: state.parallel_tasks,
            steps: state.steps,
            calls: state.calls,
            results: state.results,
            tasks: state.tasks,
            groups: state.groups,
            selections: state.selections,
            events: state.events,
            source_extent: state.source_extent
        })
    })
}
