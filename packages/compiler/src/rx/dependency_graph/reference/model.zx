import type { U32Buffer, U64Buffer } from "memory"
import type { Attribute, Node } from "../../syntax/document/model"

export enum Target {
    Module,
    Function,
    Store
}

export enum Role {
    Dependency,
    Call,
    TypeImport
}

export type Reference = {
    node: u64,
    attribute?: u64,
    target: Target,
    role: Role,
    package_allowed: bool,
    graph: bool
}

export type Input = {
    source: string,
    start: u64,
    end: u64,
    graph_only: bool
}

export type Output = {
    primary: string,
    fallback: string,
    target: Target,
    fallback_target: Target,
    role: Role,
    required: bool,
    package_allowed: bool,
    graph: bool
}

export type Scan = {
    source: string,
    nodes: Node[],
    attributes: Attribute[],
    root: u64,
    slots: u64[],
    facts: U32Buffer,
    unit_firsts: U32Buffer,
    unit_counts: U32Buffer,
    step_rows: U32Buffer,
    events: U64Buffer,
    project_flow: bool
}

export type Scanned = {
    references: Reference[],
    graph_references: u64,
    parallel_tasks: u64,
    steps: u64,
    calls: u64,
    results: u64,
    tasks: u64,
    groups: u64,
    selections: u64,
    events: u64,
    source_extent: u64,
    missing_input?: u64
}
