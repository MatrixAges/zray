import integers from "std:integer"
import memory from "std:memory"

import { Tag } from "../../schema/execution/model"
import { if_has_else, task_has_output } from "./const"
import layout from "./layout"
import place from "./place"

import type { U32Buffer } from "std:memory"
import type { Input as Geometry } from "./layout"

export type Columns = {
    step_rows: U32Buffer,
    unit_firsts: U32Buffer,
    unit_counts: U32Buffer
}

export type Input = {
    geometry: Geometry,
    columns: Columns,
    slot: u64,
    start: u64,
    flags: u32,
    task_output: bool
}

export type Output = u64

export default function (in: Input): Output {
    const { geometry, columns, slot, start } = in
    const { children, node, tag } = geometry

    const view = children.view
    const count = layout(geometry)
    const has_else = tag == Tag.If && count < node.child_count
    const output_flag = in.task_output ? task_has_output : 0
    const else_flag = has_else ? if_has_else : 0

    memory.writeU32(view.facts, slot, in.flags + output_flag + else_flag)

    const first = match {
        count == 0 => start,
        _ => place({
            view,
            step_rows: columns.step_rows,
            node,
            tag,
            first: start,
            count
        })
    }

    const end = start + count

    memory.writeU32(columns.unit_firsts, slot, integers.narrow(first))
    memory.writeU32(columns.unit_counts, slot, integers.narrow(end - first))

    return end
}
