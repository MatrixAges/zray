import integers from "std:integer"

import { Tag } from "../../schema/execution/model"
import { if_has_else, task_has_output } from "./const"
import layout from "./layout"
import place from "./place"

import type { Input as Geometry } from "./layout"

export type Input = {
    geometry: Geometry,
    step_rows: u32[],
    slot: u64,
    start: u64,
    flags: u32,
    task_output: bool
}

export type Output = {
    end: u64,
    fact: u32,
    first: u32,
    count: u32,
    step_rows: u32[]
}

export default function (in: Input): Output {
    const { geometry, start } = in
    const { children, facts, child_count, tag } = geometry

    const count = layout(geometry)
    const has_else = tag == Tag.If && count < child_count
    const output_flag = in.task_output ? task_has_output : 0
    const else_flag = has_else ? if_has_else : 0
    const fact = in.flags + output_flag + else_flag

    if (count == 0) {
        const end = start

        return {
            end,
            fact,
            first: integers.narrow(start),
            count: 0,
            step_rows: in.step_rows
        }
    }

    const placed = place({
        children,
        facts,
        step_rows: in.step_rows,
        child_count,
        tag,
        first: start,
        count
    })

    const end = start + count

    return {
        end,
        fact,
        first: integers.narrow(placed.position),
        count: integers.narrow(end - placed.position),
        step_rows: placed.step_rows
    }
}
