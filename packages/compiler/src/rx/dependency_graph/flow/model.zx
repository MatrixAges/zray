import type { U32Buffer } from "memory"
import type { Tag } from "../../schema/execution/model"
import type { Node } from "../../syntax/document/model"

export type View = {
    nodes?: Node[],
    siblings: u64[],
    slots: u64[],
    facts: U32Buffer
}

export type Children = {
    view: View,
    head: u64
}

export type Input = {
    view: View,
    head: u64,
    tag: Tag,
}
