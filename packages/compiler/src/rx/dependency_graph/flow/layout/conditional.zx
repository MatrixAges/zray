import integers from "std:integer"

import { alternate } from "../const"

import type { Children } from "../model"

export type Input = {
    children: Children,
    facts: u32[],
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { head, view } = in.children

    if (head == 0) {
        return 0
    }

    const flags = in.facts[view.slots[head - 1]]

    const has_else =
        integers.andBits(integers.widen(flags), integers.widen(alternate))

    return has_else != 0 ? in.count - 1 : in.count
}
