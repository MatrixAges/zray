import { parallel_tag } from "../../schema/execution/const"
import name from "../../syntax/document/name_matches"

import type { Node } from "../../syntax/document/model"

export type Input = {
    source: u8[],
    nodes: Node[],
    parents: u64[]
}

export type Output = bool

export default function (in: Input): Output {
    if (in.parents.length == 0) {
        return false
    }

    const parent = in.parents[in.parents.length - 1] - 1
    const span = in.nodes[parent].name

    return name({
        source: in.source,
        start: span.start,
        end: span.end,
        name: parallel_tag
    })
}
