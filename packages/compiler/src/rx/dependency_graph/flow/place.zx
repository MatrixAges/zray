import integers from "std:integer"
import memory from "memory"

import { Tag } from "../../schema/execution/model"
import { declaration } from "./const"

import type { U32Buffer } from "memory"
import type { Node } from "../../syntax/document/model"
import type { View } from "./model"

export type Input = {
    view: View,
    step_rows: U32Buffer,
    node: Node,
    tag: Tag,
    first: u64,
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const implicit = in.tag == Tag.Task && in.count > in.node.child_count
    const has_else = in.tag == Tag.If && in.count < in.node.child_count

    const head = match {
        has_else => in.view.nodes[in.node.children - 1].previous_sibling,
        _ => in.node.children
    }

    const end = in.first + in.count
    const position = implicit ? end - 1 : end

    return loop({
        row: head,
        position
    }, {
        while: state => state.row != 0 && state.position > in.first,
        next: state => {
            const row = state.row - 1
            const slot = in.view.slots[row]
            const flags = integers.widen(memory.readU32(in.view.facts, slot))
            const skipped = integers.andBits(flags, integers.widen(declaration))

            if (skipped == 0 || in.tag == Tag.Parallel) {
                state.position -= 1
                memory.writeU32(
                    in.step_rows,
                    slot,
                    integers.narrow(state.position)
                )
            }

            state.row = in.view.nodes[row].previous_sibling
        },
        return: state => state.position
    })
}
