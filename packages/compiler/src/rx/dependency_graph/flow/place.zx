import integers from "std:integer"

import { Tag } from "../../schema/execution/model"
import { declaration } from "./const"
import previous from "./previous"

import type { Children } from "./model"

export type Input = {
    children: Children,
    facts: u32[],
    step_rows: u32[],
    child_count: u64,
    tag: Tag,
    first: u64,
    count: u64
}

export type Output = {
    position: u64,
    step_rows: u32[]
}

export default function (in: Input): Output {
    const { view, head } = in.children

    const implicit = in.tag == Tag.Task && in.count > in.child_count
    const has_else = in.tag == Tag.If && in.count < in.child_count

    const last = match {
        has_else => previous([
            view,
            head - 1
        ]),
        _ => head
    }

    const end = in.first + in.count
    const position = implicit ? end - 1 : end

    return loop({
        row: last,
        position,
        step_rows: in.step_rows
    }, {
        while: state => state.row != 0 && state.position > in.first,
        next: state => {
            const row = state.row - 1
            const slot = view.slots[row]
            const flags = integers.widen(in.facts[slot])
            const skipped = integers.andBits(flags, integers.widen(declaration))

            if (skipped == 0 || in.tag == Tag.Parallel) {
                state.position -= 1
                state.step_rows[slot] = integers.narrow(state.position)
            }

            state.row = previous([
                view,
                row
            ])
        },
        return: state => state.pick([
            "position",
            "step_rows"
        ])
    })
}
