import integers from "std:integer"

import { alternate, returns, terminates } from "./const"
import previous from "./previous"
import sequence from "./sequence"

import type { Children } from "./model"

export type Input = Children & {
    facts: u32[]
}

export type Output = {
    flags: u32,
    facts: u32[]
}

export default function (in: Input): Output {
    if (in.head == 0) {
        return {
            flags: 0,
            facts: in.facts
        }
    }

    const row = in.head - 1
    const view = in.view
    const fallback = in.facts[view.slots[row]]

    const has_else =
        integers.andBits(integers.widen(fallback), integers.widen(alternate))

    if (has_else == 0) {
        const body = sequence({
            view,
            head: in.head,
            facts: in.facts
        })

        return {
            flags: integers.narrow(
                integers.andBits(
                    integers.widen(body.flags),
                    integers.widen(returns)
                )
            ),
            facts: body.facts
        }
    }

    const body = sequence({
        view,
        head: previous([
            view,
            row
        ]),
        facts: in.facts
    })

    const either =
        integers.orBits(integers.widen(body.flags), integers.widen(fallback))

    const both =
        integers.andBits(integers.widen(body.flags), integers.widen(fallback))

    const result = integers.andBits(either, integers.widen(returns))
    const end = integers.andBits(both, integers.widen(terminates))

    return {
        flags: integers.narrow(result + end),
        facts: body.facts
    }
}
