<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.ValidationInput} out={Graph.Validation} />

    <Call
        fn="walk"
        in={{
            ...$in,
            ends: null,
            root: null,
            roots: null,
            ranked: false
        }}
    />

    <If on={$ctx.walk.issue != Graph.Issue.None}>
        <Call fn="diagnostic" in={$ctx.walk.issue} />

        <Return
            value={{
                count: 0,
                owner: $ctx.walk.owner,
                edge: $ctx.walk.edge,
                message: $ctx.diagnostic
            }}
        />
    </If>

    <Return
        value={{
            count: $ctx.walk.count,
            owner: 0,
            edge: 0,
            message: null
        }}
    />
</Module>
