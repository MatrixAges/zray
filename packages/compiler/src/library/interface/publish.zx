import integers from "std:integer"
import strings from "std:string"
import memory from "memory"

import {
    input_type_name,
    output_type_name
} from "../../zx/modules/compiled/const"

import type { Input as Interface, Ports, Row } from "./model"

export type { Row } from "./model"

export type Input = Interface.Omit("executable", "input_type", "output_type") & {
    ports: Ports
}

export type Output = Row[]

export default function (in: Input): Output {
    const { source, count, mapping, ports } = in

    const empty: Row[] = []

    const base = loop({
        row: 0,
        rows: empty
    }, {
        while: state => state.row < count,
        next: state => {
            const name = strings.copy(memory.readRowName(source, state.row))
            const id = mapping[integers.widen(memory.readRowId(
                source,
                state.row
            ))]

            state.rows = state.rows.push({
                name,
                type_id: id
            })[0]
            state.row += 1
        },
        return: state => state.rows
    })

    const with_input = match {
        ports.add_input => base.push({
            name: input_type_name,
            type_id: ports.input_type
        })[0],
        _ => base
    }

    return match {
        ports.add_output => with_input.push({
            name: output_type_name,
            type_id: ports.output_type
        })[0],
        _ => with_input
    }
}
