import integers from "std:integer"
import memory from "memory"

import {
    input_type_name,
    output_type_name
} from "../../zx/modules/compiled/const"
import { Status } from "./model"

import type { Input as Interface, Ports as Output } from "./model"

export type Input = Interface.Omit("target")

export default function (in: Input): Output {
    const { source, count, mapping, executable, input_type, output_type } = in

    return loop({
        row: 0,
        status: Status.Valid,
        add_input: executable,
        add_output: executable
    }, {
        while: state => state.row < count && state.status != Status.InvalidModule,
        next: state => {
            const id = integers.widen(memory.readRowId(source, state.row))

            if (id >= mapping.length) {
                state.status = Status.InvalidModule
            } else if (executable) {
                const name = memory.readRowName(source, state.row)
                const mapped = mapping[id]

                if (name == input_type_name) {
                    state.add_input = false

                    if (mapped != input_type) {
                        state.status = Status.ConflictingInterface
                    }
                } else if (name == output_type_name) {
                    state.add_output = false

                    if (mapped != output_type) {
                        state.status = Status.ConflictingInterface
                    }
                }
            }

            state.row += 1
        },
        return: state => ({
            status: state.status,
            count: match {
                state.status == Status.Valid =>
                    count + (state.add_input ? 1 : 0) + (state.add_output ? 1 : 0),
                _ => 0
            },
            add_input: state.add_input,
            add_output: state.add_output
        })
    })
}
