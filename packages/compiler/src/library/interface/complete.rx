<Module>
    <Type from="model" as="Interface" />

    <Args in={Interface.Input} out={Interface.Outcome} />

    <Call fn="ports" in={$in} />

    <If on={$ctx.ports.count != 0}>
        <Call
            fn="publish"
            in={{
                ...$in.omit([
                    "executable",
                    "input_type",
                    "output_type"
                ]),
                ports: $ctx.ports
            }}
        />

        <Return
            value={{
                status: $ctx.ports.status,
                exports: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            status: $ctx.ports.status,
            exports: []
        }}
    />
</Module>
