<Module>
    <Type from="model" as="Interface" />

    <Args in={Interface.Input} out={Interface.Status} />

    <Call fn="ports" in={$in.omit(["target"])} />

    <If on={$ctx.ports.count != 0}>
        <Call
            fn="../../zx/modules/artifact/surface/allocate_exports"
            in={{
                target: $in.target,
                count: $ctx.ports.count
            }}
        />

        <Call
            fn="publish"
            in={{
                ...$in.omit([
                    "executable",
                    "input_type",
                    "output_type"
                ]),
                ports: $ctx.ports
            }}
        />
    </If>

    <Return value={$ctx.ports.status} />
</Module>
