import type { NamedRows } from "memory"

export type Row = {
    name: string,
    type_id: u32
}

export type Input = {
    source: NamedRows,
    count: u64,
    mapping: u32[],
    input_type: u32,
    output_type: u32,
    executable: bool
}

export enum Status {
    Valid,
    InvalidModule,
    ConflictingInterface
}

export type Outcome = {
    status: Status,
    exports: Row[]
}

export type Ports = {
    status: Status,
    count: u64,
    add_input: bool,
    add_output: bool,
    input_type: u32,
    output_type: u32
}
