import type { NamedRows, NamedRowBuffer } from "memory"

export type Input = {
    source: NamedRows,
    count: u64,
    target: NamedRowBuffer,
    mapping: u32[],
    input_type: u32,
    output_type: u32,
    executable: bool
}

export enum Status {
    Valid,
    InvalidModule,
    ConflictingInterface
}

export type Ports = {
    status: Status,
    count: u64,
    add_input: bool,
    add_output: bool
}
