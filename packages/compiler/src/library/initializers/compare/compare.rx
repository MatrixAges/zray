<Module>
    <Type from="model" as="Comparison" />

    <Args in={Comparison.Input} out={Comparison.Output} />

    <Call fn="header" in={$in.header} />

    <If on={!$ctx.header}>
        <Return value={false} />
    </If>

    <Call fn="types" in={$in.types} />

    <If on={!$ctx.types}>
        <Return value={false} />
    </If>

    <Call
        fn="native"
        in={{
            left: $in.header.left.native,
            right: $in.header.right.native
        }}
    />

    <If on={!$ctx.native}>
        <Return value={false} />
    </If>

    <Call fn="../../../zx/ir/compare/columns" in={$in.columns} />

    <If on={!$ctx.columns}>
        <Return value={false} />
    </If>

    <If on={$in.contracts != null}>
        <Call
            fn="../../../zx/ir/compare/referenced/contracts"
            in={{
                ...$in.contracts,
                left_row: 0,
                right_row: 0
            }}
        />

        <Return value={$ctx.contracts} />
    </If>

    <Return value={true} />
</Module>
