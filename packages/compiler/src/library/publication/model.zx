import type {
    Input as Constants,
    Row as ConstantRow
} from "../../zx/modules/artifact/surface/constants"
import type { Row as MemberRow } from "../../zx/modules/link/source/members/model"
import type { Input as Types, Row as ExportRow, Status } from "../interface/model"
import type { Input as Members } from "../members/model"

export type Row = {
    name: string,
    path: string
}

export type Input = {
    types: Types,
    constants: Constants,
    members: Members,
    row: Row
}

export type Output = {
    status: Status,
    name: string,
    path: string,
    exports: ExportRow[],
    constants: ConstantRow[],
    members: MemberRow[]
}
