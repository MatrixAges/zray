<Module>
    <Type from="model" as="Publication" />
    <Type from="../interface/model" as="Interface" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call module="../interface/complete" in={$in.types} />

    <If on={$ctx.complete.status != Interface.Status.Valid}>
        <Return
            value={{
                status: $ctx.complete.status,
                name: "",
                path: "",
                exports: [],
                constants: [],
                members: []
            }}
        />
    </If>

    <Call fn="../../zx/modules/artifact/surface/constants" in={$in.constants} />

    <Call module="../members/build" in={$in.members} />

    <If on={$ctx.build != null}>
        <Call fn="row" in={$in.row} />

        <Return
            value={{
                status: Interface.Status.Valid,
                name: $ctx.row.name,
                path: $ctx.row.path,
                exports: $ctx.complete.exports,
                constants: $ctx.constants,
                members: $ctx.build
            }}
        />
    </If>

    <Return
        value={{
            status: Interface.Status.InvalidModule,
            name: "",
            path: "",
            exports: [],
            constants: [],
            members: []
        }}
    />
</Module>
