<Module>
    <Type from="model" as="Publication" />
    <Type from="../interface/model" as="Interface" />

    <Args in={Publication.Input} out={Publication.Output} />

    <Call module="../interface/complete" in={$in.types} />

    <If on={$ctx.complete != Interface.Status.Valid}>
        <Return
            value={{
                status: $ctx.complete,
                name: "",
                path: ""
            }}
        />
    </If>

    <Call module="../../zx/modules/artifact/surface/own_constants" in={$in.constants} />
    <Call module="../members/build" in={$in.members} />

    <If on={!$ctx.build}>
        <Return
            value={{
                status: Interface.Status.InvalidModule,
                name: "",
                path: ""
            }}
        />
    </If>

    <Call fn="row" in={$in.row} />

    <Return
        value={{
            status: Interface.Status.Valid,
            name: $ctx.row.name,
            path: $ctx.row.path
        }}
    />
</Module>
