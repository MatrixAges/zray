<Module>
    <Type from="model" as="Publication" />
    <Type from="../interface/model" as="Interface" />

    <Args in={Publication.Input} out={Interface.Status} />

    <Call module="../interface/complete" in={$in.types} />

    <If on={$ctx.complete != Interface.Status.Valid}>
        <Return value={$ctx.complete} />
    </If>

    <Call module="../../zx/modules/artifact/surface/own_constants" in={$in.constants} />
    <Call module="../members/build" in={$in.members} />

    <If on={!$ctx.build}>
        <Return value={Interface.Status.InvalidModule} />
    </If>

    <Call
        fn="row"
        in={{
            row: $in.row,
            types: $in.types.target,
            constants: $in.constants.storage,
            members: $in.members.storage
        }}
    />

    <Return value={Interface.Status.Valid} />
</Module>
