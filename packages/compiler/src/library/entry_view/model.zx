import type { Contracts } from "core/contract_table/model"
import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Stores } from "core/store_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { ColumnOwnership, ColumnStoreMode } from "memory/columns"

export type FunctionColumns = {
    files: string[],
    input_types: u32[],
    output_types: u32[],
    ownership: ColumnOwnership[],
    store_modes: ColumnStoreMode[],
    symbols: Symbols[],
    expressions: Expressions[],
    control: Control[],
    roots: u32?[],
    contracts: Contracts[],
    stores: Stores[]
}

export type Body = {
    file: string,
    input_type: u32,
    output_type: u32,
    ownership: ColumnOwnership,
    store_mode: ColumnStoreMode,
    symbols: Symbols,
    expressions: Expressions,
    control: Control,
    root?: u32,
    contracts: Contracts,
    stores: Stores
}

export type Input = {
    functions: FunctionColumns,
    function_id?: u32,
    initializer?: Initializer
}

export type Initializer = {
    file: string,
    store_mode: ColumnStoreMode,
    empty_stores: Stores
}
