<Module>
    <Type from="model" as="Entry" />
    <Type from="../../zx/modules/entry_body/model" as="Body" />

    <Args in={Entry.Input} out={Body.Body?} />

    <If on={$in.function_id != null}>
        <Call
            fn="../../zx/modules/entry_body/read"
            in={{
                functions: $in.functions,
                id: $in.function_id
            }}
        />

        <If on={$in.initializer != null}>
            <Return
                value={{
                    ...$ctx.read,
                    file: $in.initializer.file,
                    store_mode: $in.initializer.store_mode,
                    stores: $in.initializer.empty_stores
                }}
            />
        </If>

        <Return value={$ctx.read} />
    </If>

    <Return value={null} />
</Module>
