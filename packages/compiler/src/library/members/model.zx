import type { ListColumn, TextColumn } from "memory"
import type {
    ListProjection
} from "memory/columns"
import type {
    Input as Publication,
    Source
} from "../../zx/modules/link/source/members/model"

export type Records = {
    paths: TextColumn,
    names: ListColumn,
    count: u64,
    entry_path: string
}

export type Input = {
    public_members: Publication.Omit("rows", "entry"),
    records: Records,
    projection: ListProjection,
    members: Source.Omit("count")
}
