import type { ListColumn, TextColumn } from "memory"
import type {
    ListProjection,
    RowBuffer,
    ListColumn as OptionalList
} from "memory/columns"
import type {
    Input as Publication,
    Source
} from "../../zx/modules/link/source/members/model"

export type Records = {
    paths: TextColumn,
    names: ListColumn,
    intrinsics: OptionalList,
    count: u64,
    entry_path: string
}

export type Range = {
    first: u64,
    end: u64,
    count: u64
}

export type Input = {
    public_members: Publication,
    records: Records,
    projection: ListProjection,
    members: Source.Omit("count"),
    storage: RowBuffer
}
