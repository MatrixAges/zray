import memory from "memory"
import columns from "memory/columns"

import type { Records } from "./model"

export type Input = Records.Pick("names", "intrinsics") & {
    row: u64,
    size: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { names, intrinsics, row, size } = in

    return loop({
        index: 0,
        count: 0
    }, {
        while: item => item.index < size,
        next: item => {
            const name = memory.readListText(names, row, item.index)

            if (
                name != "" ||
                    columns.readListOptionalU8(intrinsics, row, item.index) != null
            ) {
                item.count += 1
            }

            item.index += 1
        },
        return: item => item.count
    })
}
