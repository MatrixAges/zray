import memory from "memory"

import count from "./count"

import type { Records as Input, Range as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        row: 0,
        first: in.count,
        end: 0,
        count: 0
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const size = memory.listLength(in.names, row)

            if (
                size != 0 && memory.readTextColumn(in.paths, row) == in.entry_path
            ) {
                const kept = count({
                    names: in.names,
                    intrinsics: in.intrinsics,
                    row,
                    size
                })

                if (kept != 0) {
                    if (state.count == 0) {
                        state.first = row
                    }

                    state.end = row + 1
                    state.count += kept
                }
            }

            state.row += 1
        },
        return: state => state.omit(["row"])
    })
}
