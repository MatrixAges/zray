import { projectLists } from "core/column_set"
import memory from "memory"

import { Anonymous } from "../../zx/modules/link/source/members/model"
import publish from "../../zx/modules/link/source/members/publish"

import type { Row } from "../../zx/modules/link/source/members/model"
import type { Input as Library } from "./model"

export type Input = Library & {
    rows: Row[]
}

export type Output = Row[]?

export default function (in: Input): Output {
    const { records, members, public_members } = in

    return loop({
        row: 0,
        rows: in.rows,
        valid: true
    }, {
        while: state => state.valid && state.row < records.count,
        next: state => {
            const row = state.row

            if (
                memory.readTextColumn(records.paths, row) == records.entry_path
            ) {
                projectLists([
                    in.projection,
                    row
                ])

                const result = publish({
                    ...public_members,
                    rows: state.rows,
                    anonymous: Anonymous.Skip,
                    source: {
                        ...members,
                        count: memory.listLength(records.names, row)
                    }
                })

                if (result == null) {
                    state.valid = false
                } else {
                    state.rows = result.rows
                }
            }

            state.row += 1
        },
        return: state => match {
            state.valid => state.rows,
            _ => null
        }
    })
}
