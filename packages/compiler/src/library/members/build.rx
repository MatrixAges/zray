<Module>
    <Type from="model" as="Members" />

    <Args in={Members.Input} out={bool} />

    <Call fn="select" in={$in.records} />

    <Call
        fn="../../zx/modules/artifact/surface/allocate_rows"
        in={{
            storage: $in.storage,
            count: $in.public_members.source.count + $ctx.select.count
        }}
    />

    <Call fn="../../zx/modules/link/source/members/publish" in={$in.public_members} />

    <If on={$ctx.publish != null}>
        <Call
            fn="reexports"
            in={{
                ...$in.omit(["storage"]),
                selected: $ctx.select,
                first: $ctx.publish.written
            }}
        />

        <Return value={$ctx.reexports} />
    </If>

    <Return value={false} />
</Module>
