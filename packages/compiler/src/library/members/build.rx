<Module>
    <Type from="model" as="Members" />
    <Type from="../../zx/modules/link/source/members/model" as="Source" />

    <Args in={Members.Input} out={Source.Row[]?} />

    <Call
        fn="../../zx/modules/link/source/members/publish"
        in={{
            ...$in.public_members,
            rows: []
        }}
    />

    <If on={$ctx.publish != null}>
        <Call
            fn="reexports"
            in={{
                ...$in,
                rows: $ctx.publish.rows
            }}
        />

        <Return value={$ctx.reexports} />
    </If>

    <Return value={null} />
</Module>
