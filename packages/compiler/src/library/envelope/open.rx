<Module>
    <Type from="model" as="Envelope" />

    <Args
        in={{
            source: string,
            ir_version: u32
        }}
        out={Envelope.Admission?}
    />

    <Call fn="inspect" in={$in.source} />

    <If on={!$ctx.inspect.accepted}>
        <Return value={null} />
    </If>

    <Call
        fn="../../zx/artifact_codec/content"
        in={{
            source: $in.source,
            start: $ctx.inspect.start,
            digest_start: $ctx.inspect.digest_start
        }}
    />

    <If on={!$ctx.content}>
        <Return value={null} />
    </If>

    <Call
        fn="payload/current"
        in={{
            payload: $in.source,
            start: $ctx.inspect.start,
            expected: $in.ir_version
        }}
    />

    <Return
        value={{
            start: $ctx.inspect.start,
            maximum_depth: $ctx.inspect.maximum_depth,
            legacy: $ctx.inspect.legacy,
            current_ir: $ctx.current
        }}
    />
</Module>
