import integers from "std:integer"

import { Result } from "../binary/model"
import result from "../binary/result"
import { maximum_bit_width } from "../const"
import { Form } from "./model"

import type { Operation as Input, TermSort as Output } from "./model"

export default function (in: Input): Output {
    const { form, left, right, third, extra } = in

    const invalid: Output = {
        width: 0,
        boolean: false
    }

    const boolean: Output = {
        width: 1,
        boolean: true
    }

    if (form == Form.SignExtend || form == Form.ZeroExtend) {
        const maximum = integers.widenShort(maximum_bit_width)

        if (left.boolean || extra > maximum) {
            return invalid
        }

        const width = integers.widenShort(left.width) + extra

        if (width > maximum) {
            return invalid
        }

        return {
            width,
            boolean: false
        }
    }

    if (form == Form.Invert || form == Form.Negate) {
        if (left.boolean != (form == Form.Invert)) {
            return invalid
        }

        return {
            width: integers.widenShort(left.width),
            boolean: left.boolean
        }
    }

    if (form == Form.Select) {
        const same = right.width == third.width && right.boolean == third.boolean

        if (!left.boolean || !same) {
            return invalid
        }

        return {
            width: integers.widenShort(right.width),
            boolean: right.boolean
        }
    }

    return match result({
        family: in.family,
        left,
        right
    }) {
        Result.Boolean => boolean,
        Result.Operand => {
            width: integers.widenShort(left.width),
            boolean: left.boolean
        },
        _ => invalid
    }
}
