<Module>
    <Type from="model" as="Terms" />

    <Args in={Terms.Cursor} out={Terms.Head} />

    <Task name="initial" out={$ctx.token}>
        <Call fn="token" in={$in} />
    </Task>

    <Call fn="prefix" />

    <If on={$ctx.prefix.form != Terms.Form.Open}>
        <Return value={$ctx.prefix} />
    </If>

    <Task name="operator_token" out={$ctx.token}>
        <Call
            fn="token"
            in={{
                source: $in.source,
                offset: $ctx.prefix.next
            }}
        />
    </Task>

    <Call
        fn="operator"
        in={{
            head: $ctx.prefix,
            token: $ctx.task.operator_token
        }}
    />

    <Switch on={$ctx.operator.form}>
        <Case value={Terms.Form.Constant}>
            <Call
                fn="literal"
                in={{
                    source: $in.source,
                    head: $ctx.operator
                }}
            />

            <Return value={$ctx.literal} />
        </Case>

        <Case value={Terms.Form.Indexed}>
            <Call
                fn="extension"
                in={{
                    source: $in.source,
                    head: $ctx.operator
                }}
            />

            <Return value={$ctx.extension} />
        </Case>
    </Switch>

    <Return value={$ctx.operator} />
</Module>
