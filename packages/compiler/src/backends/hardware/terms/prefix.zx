import bytes from "std:bytes"
import { ascii_open_paren } from "core/ascii/const"

import { smt_true, smt_false } from "../../../verification/scalar/const"
import { Form } from "./model"

import type { Token as Input, Head as Output } from "./model"

export default function (in: Input): Output {
    const {start, text} = in

    const form = match {
        text.length == 0 => Form.Invalid,
        text[0] == ascii_open_paren => Form.Open,
        bytes.equals(text, bytes.fromText(smt_true)) => Form.True,
        bytes.equals(text, bytes.fromText(smt_false)) => Form.False,
        _ => Form.Name
    }

    return {
        form,
        start,
        next: start + text.length,
        operator_start: start,
        arity: 0,
        value: 0,
        bits: 0
    }
}
