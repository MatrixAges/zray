import type { Form } from "hardware_graph_host"
import type { Sort, Family } from "../binary/model"

export { Form } from "hardware_graph_host"

export type Cursor = {
    source: u8[],
    offset: u64
}

export type Token = {
    start: u64,
    text: u8[]
}

export type Head = {
    form: Form,
    start: u64,
    next: u64,
    operator_start: u64,
    arity: u8,
    value: u64,
    bits: u64
}

export type ReadHead = {
    source: u8[],
    head: Head
}

export type Operation = {
    form: Form,
    family: Family,
    extra: u64,
    left: Sort,
    right: Sort,
    third: Sort
}

export type TermSort = {
    width: u64,
    boolean: bool
}
