import type { Form, HardwareBuild, NodeOrigin } from "hardware_graph_host"
import type { Cursor, Head, TermSort } from "../model"

export type Input = {
    build: HardwareBuild,
    expression: string,
    origin?: NodeOrigin
}

export type Read = Input & Cursor.Pick("source") & {
    offset: u64,
    depth: u64
}

export type End = Read.Pick("build", "source", "offset") & {
    closing: bool
}

export type Parsed = {
    node: u32,
    offset: u64
}

export type Store = TermSort & {
    build: HardwareBuild,
    key: string,
    form: Form,
    first: u64,
    second: u32,
    third: u32,
    operator?: u8,
    extra: u64,
    origin?: NodeOrigin
}

export type Apply = Read.Omit("depth") & {
    head: Head,
    left: u32,
    right?: u32,
    third?: u32
}
