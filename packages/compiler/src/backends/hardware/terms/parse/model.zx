import type { Form, Node } from "hardware_graph_host"
import type { Cursor, Head, TermSort } from "../model"
import type { Table } from "../table"

export type NodeOrigin = {
    file: string,
    row: u64
}

export type Row = {
    node: Node,
    origin?: NodeOrigin
}

export type Graph = {
    nodes: Row[],
    cache: Table,
    cache_limit: u64
}

export type Input = {
    graph: Graph,
    variables: Table,
    expression: string,
    origin?: NodeOrigin
}

export type Read = Input & Cursor.Pick("source") & {
    offset: u64,
    depth: u64
}

export type End = Read.Pick("source", "offset") & {
    closing: bool
}

export type Term = {
    graph: Graph,
    node: u32
}

export type Parsed = Term & {
    offset: u64
}

export type Store = TermSort & {
    graph: Graph,
    key: string,
    form: Form,
    first: u64,
    second: u32,
    third: u32,
    operator?: u8,
    extra: u64,
    origin?: NodeOrigin
}

export type Apply = Read.Omit("depth", "variables") & {
    head: Head,
    left: u32,
    right?: u32,
    third?: u32
}
