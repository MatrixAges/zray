import host from "hardware_graph_host"

import boundary from "../boundary"

import type { End as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { source, offset, closing } = in

    const end = boundary({
        source,
        offset,
        closing
    })

    if (end == null) {
        host.rejectHardwareTerm()

        return 0
    }

    return end
}
