<Module>
    <Type from="model" as="Term" />

    <Args in={Term.Input} out={Term.Term} />

    <Call fn="begin" in={$in.expression} />

    <Call
        fn="walk"
        in={{
            graph: $in.graph,
            variables: $in.variables,
            expression: $in.expression,
            origin: $in.origin,
            source: $ctx.begin,
            offset: 0,
            depth: 0
        }}
    />

    <Call
        fn="finish"
        in={{
            source: $ctx.begin,
            offset: $ctx.walk.offset,
            closing: false
        }}
    />

    <Return
        value={$ctx.walk.pick([
            "graph",
            "node"
        ])}
    />
</Module>
