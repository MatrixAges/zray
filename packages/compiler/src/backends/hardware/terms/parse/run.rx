<Module>
    <Type from="model" as="Term" />

    <Args in={Term.Input} out={u32} />

    <Call fn="begin" in={$in} />

    <Call
        fn="walk"
        in={{
            build: $in.build,
            expression: $in.expression,
            source: $ctx.begin,
            offset: 0,
            depth: 0
        }}
    />

    <Call
        fn="finish"
        in={{
            build: $in.build,
            source: $ctx.begin,
            offset: $ctx.walk.offset,
            closing: false
        }}
    />

    <Return value={$ctx.walk.node} />
</Module>
