import integers from "std:integer"
import capacity from "core/bytes/map/capacity"
import lookup from "core/bytes/map/lookup"
import slot from "core/bytes/map/slot"
import { Form, Kind } from "hardware_graph_host"

import rehash from "../rehash"
import space from "./space"

import type { Store as Input, Term } from "./model"

export type Output = Term?

export default function (in: Input): Output {
    const { graph, key } = in
    const { nodes, cache, cache_limit } = graph

    const found = lookup({
        keys: cache.keys,
        values: cache.values,
        key,
        full: integers.widen(cache.count) == cache_limit
    })

    if (found.value != null) {
        return {
            graph,
            node: found.value
        }
    }

    const node_count = nodes.length

    if (!space({
        node_count,
        width: in.width
    })) {
        return null
    }

    const size = match found.grow {
        true => capacity(cache.count + 1),
        _ => ({
            capacity: cache.keys.length,
            limit: cache_limit
        })
    }

    const table = match found.grow {
        true => rehash({
            keys: cache.keys,
            values: cache.values,
            capacity: size.capacity
        }),
        _ => cache
    }

    const position = match found.grow {
        true => slot({
            keys: table.keys,
            key
        }),
        _ => found.position
    }

    const kind = match in.form {
        Form.Constant => Kind.Constant,
        Form.Invert => Kind.Invert,
        Form.Negate => Kind.Negate,
        Form.Binary => Kind.Binary,
        Form.Select => Kind.Select,
        _ => Kind.Extend
    }

    const id = integers.narrow(node_count)

    const node = {
        kind,
        width: integers.narrowShort(in.width),
        boolean: in.boolean,
        first: in.first,
        second: in.second,
        third: in.third,
        operator: in.operator ?? 0,
        extra: integers.narrowShort(in.extra),
        signed: in.form == Form.SignExtend
    }

    return {
        graph: {
            nodes: nodes.push({
                node,
                origin: in.origin
            })[0],
            cache: {
                keys: table.keys.with(position, key),
                values: table.values.with(position, id),
                count: table.count + 1
            },
            cache_limit: size.limit
        },
        node: id
    }
}
