import integers from "std:integer"
import lookup from "core/bytes/map/lookup"
import slot from "core/bytes/map/slot"
import host from "hardware_graph_host"
import { Form, Kind } from "hardware_graph_host"

import requireSpace from "./space"

import type { Store as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { build, key } = in

    const found = lookup({
        keys: host.hardwareCacheKeys(build),
        values: host.hardwareCacheValues(build),
        key,
        full: host.hardwareCacheFull(build)
    })

    if (found.value != null) {
        return found.value
    }

    if (found.grow) {
        host.growHardwareCache(build)
    }

    const position = match found.grow {
        true => slot({
            keys: host.hardwareCacheKeys(build),
            key
        }),
        _ => found.position
    }

    requireSpace({
        build,
        width: in.width
    })

    const kind = match in.form {
        Form.Constant => Kind.Constant,
        Form.Invert => Kind.Invert,
        Form.Negate => Kind.Negate,
        Form.Binary => Kind.Binary,
        Form.Select => Kind.Select,
        _ => Kind.Extend
    }

    return host.appendHardwareTerm(
        build,
        position,
        key,
        kind,
        integers.narrowShort(in.width),
        in.boolean,
        in.first,
        in.second,
        in.third,
        in.operator ?? 0,
        integers.narrowShort(in.extra),
        in.form == Form.SignExtend
    )
}
