import integers from "std:integer"
import lookup from "core/bytes/map/lookup"
import slot from "core/bytes/map/slot"
import host from "hardware_graph_host"
import { Form, Kind } from "hardware_graph_host"

import space from "./space"

import type { Store as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { build, key } = in

    const cache = host.readHardwareCache(build)
    const node_count = cache.node_count

    const found = lookup({
        keys: cache.keys,
        values: cache.values,
        key,
        full: cache.full
    })

    if (found.value != null) {
        return found.value
    }

    if (found.grow) {
        host.growHardwareCache(build)
    }

    const position = match found.grow {
        true => slot({
            keys: host.readHardwareCache(build).keys,
            key
        }),
        _ => found.position
    }

    const valid = space({
        node_count,
        width: in.width
    })

    if (!valid) {
        host.rejectHardwareTerm()
    }

    const kind = match in.form {
        Form.Constant => Kind.Constant,
        Form.Invert => Kind.Invert,
        Form.Negate => Kind.Negate,
        Form.Binary => Kind.Binary,
        Form.Select => Kind.Select,
        _ => Kind.Extend
    }

    return host.appendHardwareTerm(
        build,
        position,
        key,
        kind,
        integers.narrowShort(in.width),
        in.boolean,
        in.first,
        in.second,
        in.third,
        in.operator ?? 0,
        integers.narrowShort(in.extra),
        in.form == Form.SignExtend,
        in.origin
    )
}
