
import { maximum_depth } from "../../const"
import { Form } from "../model"
import read from "../read"
import apply from "./application"
import literal from "./literal"

import type { Parsed, Read as Input } from "./model"

export type Output = Parsed?

export default function walk(in: Input): Output {
    const { graph, variables, expression, source, offset, depth } = in

    if (depth >= maximum_depth) {
        return null
    }

    const head = read({
        source,
        offset
    })

    const { form, arity } = head

    if (form == Form.Invalid) {
        return null
    }

    if (arity == 0) {
        const term = literal({
            graph,
            variables,
            expression,
            origin: in.origin,
            head
        })

        if (term == null) {
            return null
        }

        return {
            ...term,
            offset: head.next
        }
    }

    const first = walk({
        ...in,
        offset: head.next,
        depth: depth + 1
    })

    if (first == null) {
        return null
    }

    const second: Output = match arity >= 2 {
        true => walk({
            ...in,
            graph: first.graph,
            offset: first.offset,
            depth: depth + 1
        }),
        _ => null
    }

    if (arity >= 2 && second == null) {
        return null
    }

    const after_second = second ?? first

    const third: Output = match arity == 3 {
        true => walk({
            ...in,
            graph: after_second.graph,
            offset: after_second.offset,
            depth: depth + 1
        }),
        _ => null
    }

    if (arity == 3 && third == null) {
        return null
    }

    const after_args = third ?? after_second
    const right_node: u32? = second == null ? null : second.node
    const third_node: u32? = third == null ? null : third.node

    return apply({
        graph: after_args.graph,
        expression,
        origin: in.origin,
        source,
        head,
        left: first.node,
        right: right_node,
        third: third_node,
        offset: after_args.offset
    })
}
