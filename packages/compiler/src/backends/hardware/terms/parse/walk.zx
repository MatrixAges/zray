import host from "hardware_graph_host"

import { maximum_depth } from "../../const"
import { Form } from "../model"
import read from "../read"
import apply from "./application"
import literal from "./literal"

import type { Parsed as Output, Read as Input } from "./model"

export default function walk(in: Input): Output {
    const { build, expression, source, offset, depth } = in

    if (depth >= maximum_depth) {
        host.rejectHardwareTerm()
    }

    const head = read({
        source,
        offset
    })

    const { form, arity } = head

    if (form == Form.Invalid) {
        host.rejectHardwareTerm()
    }

    if (arity == 0) {
        return {
            node: literal({
                build,
                expression,
                origin: in.origin,
                head
            }),
            offset: head.next
        }
    }

    const first = walk({
        ...in,
        offset: head.next,
        depth: depth + 1
    })

    const second: Output? = match arity >= 2 {
        true => walk({
            ...in,
            offset: first.offset,
            depth: depth + 1
        }),
        _ => null
    }

    const after_second = second == null ? first.offset : second.offset

    const third: Output? = match arity == 3 {
        true => walk({
            ...in,
            offset: after_second,
            depth: depth + 1
        }),
        _ => null
    }

    const after_args = third == null ? after_second : third.offset
    const right_node: u32? = second == null ? null : second.node
    const third_node: u32? = third == null ? null : third.node

    return apply({
        build,
        expression,
        origin: in.origin,
        source,
        head,
        left: first.node,
        right: right_node,
        third: third_node,
        offset: after_args
    })
}
