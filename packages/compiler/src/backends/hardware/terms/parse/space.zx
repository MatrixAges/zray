import integers from "std:integer"

import { maximum_bit_width, maximum_nodes } from "../../const"

export type Input = {
    node_count: u64,
    width: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { node_count, width } = in

    return node_count < maximum_nodes && width != 0 &&
        width <= integers.widenShort(maximum_bit_width)
}
