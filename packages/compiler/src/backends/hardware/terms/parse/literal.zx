import lookup from "core/bytes/map/lookup"
import memory from "memory"

import { Form } from "../model"
import intern from "./intern"

import type { Head } from "../model"
import type { Input as Source, Term } from "./model"

export type Input = Source & {
    head: Head
}

export type Output = Term?

export default function (in: Input): Output {
    const { graph, variables, expression, head } = in
    const { form, start, next } = head

    const key = memory.borrowTextRange(expression, start, next - start)

    if (form != Form.Constant) {
        const binding = lookup({
            keys: variables.keys,
            values: variables.values,
            full: false,
            key
        }).value

        if (binding != null) {
            return {
                graph,
                node: binding
            }
        }

        if (form == Form.Name) {
            return null
        }
    }

    const boolean = form != Form.Constant
    const width: u64 = boolean ? 1 : head.bits

    const first: u64 = match form {
        Form.True => 1,
        Form.False => 0,
        _ => head.value
    }

    return intern({
        graph,
        key,
        form: Form.Constant,
        width,
        boolean,
        first,
        second: 0,
        third: 0,
        operator: null,
        extra: 0,
        origin: in.origin
    })
}
