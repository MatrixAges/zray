import host from "hardware_graph_host"
import memory from "memory"

import { Form } from "../model"
import intern from "./intern"

import type { Head } from "../model"
import type { Input as Source } from "./model"

export type Input = Source & {
    head: Head
}

export type Output = u32

export default function (in: Input): Output {
    const { build, expression, head } = in
    const { form, start, next } = head

    const key = memory.borrowTextRange(expression, start, next - start)

    if (form != Form.Constant) {
        const binding = host.hardwareVariable(build, key)

        if (binding != null) {
            return binding
        }

        if (form == Form.Name) {
            host.rejectHardwareTerm()
        }
    }

    const boolean = form != Form.Constant
    const width: u64 = boolean ? 1 : head.bits

    const first: u64 = match form {
        Form.True => 1,
        Form.False => 0,
        _ => head.value
    }

    return intern({
        build,
        key,
        form: Form.Constant,
        width,
        boolean,
        first,
        second: 0,
        third: 0,
        operator: null,
        extra: 0,
        origin: in.origin
    })
}
