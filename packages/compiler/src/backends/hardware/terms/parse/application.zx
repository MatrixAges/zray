import integers from "std:integer"
import host from "hardware_graph_host"
import memory from "memory"

import fromCode from "../../binary/from_code"
import fromSmt from "../../binary/from_smt"
import { Family } from "../../binary/model"
import traits from "../../binary/traits"
import { Form } from "../model"
import derive from "../sort"
import finish from "./finish"
import intern from "./intern"
import operandSort from "./operand_sort"

import type { Apply as Input, Parsed as Output } from "./model"

export default function (in: Input): Output {
    const { build, expression, source, head, left, right, third, offset } = in
    const { form, start, next, operator_start, bits } = head

    const end = finish({
        build,
        source,
        offset,
        closing: true
    })

    const token = match form {
        Form.Binary => fromSmt(
            memory.borrowTextRange(
                expression,
                operator_start,
                next - operator_start
            )
        ),
        _ => null
    }

    if (form == Form.Binary && token == null) {
        host.rejectHardwareTerm()
    }

    const family = match {
        token == null => Family.Logical,
        _ => traits(fromCode(token)).family
    }

    const extra = bits

    const sort = derive({
        form,
        family,
        extra,
        left: operandSort({
            build,
            node: left
        }),
        right: operandSort({
            build,
            node: right
        }),
        third: operandSort({
            build,
            node: third
        })
    })

    if (sort.width == 0) {
        host.rejectHardwareTerm()
    }

    const key = memory.borrowTextRange(expression, start, end - start)

    return {
        node: intern({
            ...sort,
            build,
            key,
            form,
            first: integers.widen(left),
            second: right ?? 0,
            third: third ?? 0,
            operator: token,
            extra,
            origin: in.origin
        }),
        offset: end
    }
}
