import host from "hardware_graph_host"

import type { HardwareBuild } from "hardware_graph_host"
import type { Sort as Output } from "../../binary/model"

export type Input = {
    build: HardwareBuild,
    node?: u32
}

export default function (in: Input): Output {
    const { build, node } = in

    if (node == null) {
        return {
            width: 0,
            boolean: false
        }
    }

    const sort = host.readHardwareSort(build, node)

    return {
        width: sort.width,
        boolean: sort.boolean
    }
}
