import integers from "std:integer"

import type { Sort as Output } from "../../binary/model"
import type { Row } from "./model"

export type Input = {
    nodes: Row[],
    node?: u32
}

export default function (in: Input): Output {
    const { nodes, node } = in

    if (node == null) {
        return {
            width: 0,
            boolean: false
        }
    }

    const sort = nodes[integers.widen(node)].node

    return {
        width: sort.width,
        boolean: sort.boolean
    }
}
