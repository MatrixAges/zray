import slot from "core/bytes/map/slot"

import empty from "./table"

import type { Table } from "./table"

export type Input = Table.Pick("keys", "values") & {
    capacity: u64
}

export type Output = Table

export default function (in: Input): Output {
    const { capacity, keys, values } = in

    return loop({
        table: empty(capacity),
        row: 0
    }, {
        while: state => state.row < keys.length,
        next: state => {
            const row = state.row
            const key = keys[row]

            if (key != null) {
                const position = slot({
                    keys: state.table.keys,
                    key
                })

                if (state.table.keys[position] == null) {
                    state.table.keys = state.table.keys.with(position, key)
                    state.table.count += 1
                }

                state.table.values = state.table.values.with(position, values[row])
            }

            state.row += 1
        },
        return: state => state.table
    })
}
