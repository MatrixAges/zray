export enum Kind {
    Input,
    Constant,
    Invert,
    Negate,
    Binary,
    Select,
    Extend
}

export type Node = {
    kind: Kind,
    width: u16,
    boolean: bool,
    first: u64,
    second: u32,
    third: u32,
    operator: u8,
    extra: u16,
    signed: bool
}

export enum Form {
    Invalid,
    Open,
    Indexed,
    Name,
    True,
    False,
    Constant,
    Invert,
    Negate,
    Select,
    Binary,
    SignExtend,
    ZeroExtend
}

export declare function rejectHardwareTerm(): void
    throws { InvalidHardwareTerm }
