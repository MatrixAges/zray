import type { Node, Nodes } from "hardware_graph_host"
import type { ReadColumn, TextColumn } from "memory"

export { Kind } from "hardware_graph_host"

export type { Node } from "hardware_graph_host"

export type Sorts = {
    widths: ReadColumn,
    booleans: ReadColumn
}

export type Ports = Sorts & {
    count: u64,
    names: TextColumn,
    nodes: ReadColumn,
    signed: ReadColumn
}

export type Graph = {
    sorts: Sorts,
    count: u64,
    inputs: Ports,
    outputs: Ports,
    safe: u64
}

export type Scan = {
    graph: Graph,
    nodes: Nodes
}

export type Check = {
    graph: Graph,
    index: u64,
    node: Node
}

export type Endpoints = {
    graph: Graph,
    input_nodes?: u64
}

export type Bank = {
    graph: Graph,
    ports: Ports,
    output: bool
}
