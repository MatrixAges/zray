import host from "hardware_graph_host"

import check from "./check"
import { Kind } from "./model"

import type { Scan as Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const { graph, nodes } = in

    const initial_count: u64? = 0

    return loop({
        graph,
        nodes,
        index: 0,
        count: initial_count
    }, {
        while: state => state.count != null && state.index < state.graph.count,
        next: state => {
            const { graph, nodes, index } = state
            const node = host.readHardwareGraphNode(nodes, index)

            const valid = check({
                graph,
                index,
                node
            })

            const added = node.kind == Kind.Input ? 1 : 0
            const count = state.count ?? 0

            state = {
                graph,
                nodes,
                index: index + 1,
                count: valid ? count + added : null
            }
        },
        return: state => state.count
    })
}
