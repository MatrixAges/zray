import ints from "std:integer"
import slot from "core/bytes/map/slot"
import memory from "memory"

import empty from "../terms/table"

import type { Table } from "../terms/table"
import type { Inputs as Input } from "./model"

export type Output = Table

export default function (in: Input): Output {
    return loop({
        row: 0,
        table: empty(in.capacity)
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const key = memory.readTextColumn(in.names, row)
            const position = slot({
                keys: state.table.keys,
                key
            })

            if (state.table.keys[position] == null) {
                state.table.keys = state.table.keys.with(position, key)
                state.table.count += 1
            }

            state.table.values = state.table.values.with(position, ints.narrow(row))
            state.row += 1
        },
        return: state => state.table
    })
}
