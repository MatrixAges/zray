<Module>
    <Type from="model" as="Circuit" />

    <Args in={Circuit.Definition} out={Circuit.Placement?} />

    <Call
        fn="definition_sort"
        in={$in.pick([
            "width",
            "sort"
        ])}
    />

    <If on={!$ctx.definition_sort}>
        <Return value={null} />
    </If>

    <Call
        fn="../../../core/bytes/map/slot"
        in={$in.pick([
            "keys",
            "key"
        ])}
    />

    <Return
        value={{
            slot: $ctx.slot,
            fresh: $in.keys[$ctx.slot] == null
        }}
    />
</Module>
