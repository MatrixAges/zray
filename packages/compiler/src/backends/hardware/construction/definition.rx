<Module>
    <Type from="model" as="Circuit" />

    <Args in={Circuit.Definition} out={bool?} />

    <Call
        fn="definition_sort"
        in={$in.pick([
            "width",
            "sort"
        ])}
    />

    <If on={!$ctx.definition_sort}>
        <Return value={null} />
    </If>

    <Call
        fn="../../../core/bytes/map/bind"
        in={$in.omit([
            "width",
            "sort"
        ])}
    />

    <Return value={$ctx.bind} />
</Module>
