<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.Input} out={u32} />

    <Call
        fn="reserve"
        in={$in.pick([
            "inputs",
            "definitions"
        ])}
    />

    <Call
        fn="host.reserveHardwareGraph"
        in={[
            $in.build,
            $ctx.reserve
        ]}
    />

    <Loop on={$in.row < $in.inputs}>
        <Call
            module="next_input"
            in={{
                ...$in.pick([
                    "build",
                    "inputs",
                    "input_types",
                    "types"
                ]),
                row: 0
            }}
        />
    </Loop>

    <Call fn="host.bindHardwareInputs" in={$in.build} />

    <Call
        module="definitions"
        in={$in.pick([
            "build",
            "rows"
        ])}
    />

    <Call
        module="outputs"
        in={{
            build: $in.build,
            types: $in.types,
            type_id: $in.output_type,
            value: $in.output,
            path: $in.output_path
        }}
    />

    <Call
        module="safety"
        in={{
            build: $in.build,
            expression: $in.safety
        }}
    />

    <Return value={$ctx.safety} />
</Module>
