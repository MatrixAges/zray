<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.Input} out={Hardware.Output?} />

    <Call
        fn="reserve"
        in={$in.pick([
            "inputs",
            "definitions"
        ])}
    />

    <Loop on={$in.valid && $in.row < $in.inputs}>
        <Call
            module="next_input"
            in={{
                ...$in.pick([
                    "inputs",
                    "input_types",
                    "types"
                ]),
                row: 0,
                valid: true,
                ports: [],
                nodes: []
            }}
        />
    </Loop>

    <If on={!$ctx.next_input.valid}>
        <Return value={null} />
    </If>

    <Call
        fn="../inputs"
        in={{
            capacity: $ctx.reserve.symbol_capacity,
            names: $in.input_names,
            count: $in.inputs
        }}
    />

    <Call
        module="definitions"
        in={{
            graph: {
                ...$ctx.reserve.graph,
                nodes: $ctx.next_input.nodes
            },
            variables: $ctx.inputs,
            rows: $in.rows
        }}
    />

    <If on={$ctx.definitions != null}>
        <Call
            module="outputs"
            in={{
                ...$ctx.definitions.pick([
                    "graph",
                    "variables"
                ]),
                types: $in.types,
                type_id: $in.output_type,
                value: $in.output,
                value_layout: $in.value_layout,
                path: $in.output_path
            }}
        />

        <If on={$ctx.outputs != null}>
            <Call
                module="safety"
                in={{
                    graph: $ctx.outputs.graph,
                    variables: $ctx.definitions.variables,
                    expression: $in.safety
                }}
            />

            <If on={$ctx.safety != null}>
                <Return
                    value={{
                        nodes: $ctx.safety.graph.nodes,
                        safe: $ctx.safety.node,
                        inputs: $ctx.next_input.ports,
                        outputs: $ctx.outputs.ports
                    }}
                />
            </If>

            <Return value={null} />
        </If>

        <Return value={null} />
    </If>

    <Return value={null} />
</Module>
