<Module>
    <Type from="model" as="Hardware" />
    <Type from="../../terms/parse/model" as="Term" />

    <Args in={Hardware.Safety} out={Term.Term} />

    <Call
        module="../../terms/parse/run"
        in={{
            ...$in,
            origin: null
        }}
    />

    <Call fn="safety_check" />

    <Return value={$ctx.safety_check} />
</Module>
