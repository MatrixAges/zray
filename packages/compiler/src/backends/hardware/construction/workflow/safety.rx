<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.Safety} out={u32} />

    <Call
        module="../../terms/parse/run"
        in={{
            build: $in.build,
            expression: $in.expression,
            origin: null
        }}
    />

    <Call
        fn="safety_check"
        in={{
            build: $in.build,
            node: $ctx.run
        }}
    />

    <Return value={$ctx.safety_check} />
</Module>
