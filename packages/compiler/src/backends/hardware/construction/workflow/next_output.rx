<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.OutputWalk} out={Hardware.OutputWalk} />

    <Call fn="next_leaf" in={$in} />

    <If on={$ctx.next_leaf.leaf != null}>
        <Call
            module="../../terms/parse/run"
            in={{
                build: $in.build,
                expression: $ctx.next_leaf.leaf.expression
            }}
        />

        <Call
            fn="host.readHardwareSort"
            in={[
                $in.build,
                $ctx.run
            ]}
        />

        <Call
            fn="write_output"
            in={{
                sort: $ctx.readHardwareSort,
                leaf: $ctx.next_leaf.leaf,
                node: $ctx.run,
                index: $in.output_count
            }}
        />

        <Call
            fn="host.writeHardwareOutput"
            in={[
                $in.build,
                $ctx.write_output
            ]}
        />

        <Return
            value={{
                ...$in,
                stack: $ctx.next_leaf.stack,
                output_count: $in.output_count + 1,
                running: $ctx.next_leaf.stack.length != 0
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            stack: $ctx.next_leaf.stack,
            running: $ctx.next_leaf.stack.length != 0
        }}
    />
</Module>
