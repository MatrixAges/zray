import integers from "std:integer"

import name from "../../../../verification/ports/name"

import type { OutputPort } from "hardware_graph_host"
import type { OutputWrite as Input } from "./model"

export type Output = OutputPort?

export default function (in: Input): Output {
    const { sort, leaf, node, index } = in

    const width = integers.widenShort(sort.width)

    if (width != leaf.width || sort.boolean != leaf.boolean) {
        return null
    }

    const symbol = name({
        index,
        output: true
    })

    return {
        symbol,
        path: leaf.path,
        node,
        width: leaf.width,
        boolean: leaf.boolean,
        signed: leaf.signed
    }
}
