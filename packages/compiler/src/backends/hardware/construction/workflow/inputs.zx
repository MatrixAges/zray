import integers from "std:integer"
import { Kind } from "hardware_graph_host"
import memory from "memory"

import space from "../../terms/parse/space"
import portType from "./port_type"

import type { InputPort } from "hardware_graph_host"
import type { InputWalk } from "./model"

export type Input = InputWalk.Pick("input_types", "types", "row")

export type Output = InputPort?

export default function (in: Input): Output {
    const { input_types, types, row } = in

    const port = portType({
        types,
        type_id: memory.readColumnU32(input_types, row)
    })

    const valid = space({
        node_count: row,
        width: port.width
    })

    if (!valid) {
        return null
    }

    return {
        kind: Kind.Input,
        width: integers.narrowShort(port.width),
        boolean: port.boolean,
        signed: port.signed
    }
}
