import memory from "memory"

import type { DefinitionWalk } from "./model"

export type Input = DefinitionWalk.Pick("rows", "row", "origin_file")

export type Output = string

export default function (in: Input): Output {
    const file = memory.readTextColumn(in.rows.files, in.row)
    const previous = in.origin_file

    if (previous != null) {
        if (previous == file) {
            return previous
        }
    }

    return file
}
