import strings from "std:string"
import memory from "memory"

import type { DefinitionWalk as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const file = memory.readTextColumn(in.rows.files, in.row)
    const previous = in.origin_file

    if (previous != null) {
        if (previous == file) {
            return previous
        }
    }

    return strings.copy(file)
}
