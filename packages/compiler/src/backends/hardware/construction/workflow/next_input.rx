<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.InputWalk} out={Hardware.InputWalk} />

    <Call
        fn="inputs"
        in={$in.pick([
            "input_types",
            "types",
            "row"
        ])}
    />

    <If on={$ctx.inputs != null}>
        <Call
            fn="append_input"
            in={{
                walk: $in,
                port: $ctx.inputs
            }}
        />

        <Return value={$ctx.append_input} />
    </If>

    <Return
        value={{
            ...$in,
            valid: false
        }}
    />
</Module>
