import { Kind } from "hardware_graph_host"

import type { Node } from "hardware_graph_host"
import type { InputPort, InputWalk } from "./model"

export type Input = {
    walk: InputWalk,
    port: InputPort
}

export type Output = InputWalk

export default function (in: Input): Output {
    const { walk, port } = in

    const node: Node = {
        kind: Kind.Input,
        width: port.width,
        boolean: port.boolean,
        first: walk.row,
        second: 0,
        third: 0,
        operator: 0,
        extra: 0,
        signed: false
    }

    return {
        ...walk,
        row: walk.row + 1,
        ports: walk.ports.push(port)[0],
        nodes: walk.nodes.push({
            node,
            origin: null
        })[0]
    }
}
