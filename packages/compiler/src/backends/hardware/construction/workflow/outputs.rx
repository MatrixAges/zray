<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.OutputTree} out={void} />

    <Loop on={$in.running}>
        <Call
            module="next_output"
            in={{
                build: $in.build,
                types: $in.types,
                value_layout: $in.value_layout,
                stack: [{
                    type_id: $in.type_id,
                    value: $in.value,
                    path: $in.path,
                    children: null
                }],
                output_count: 0,
                running: true
            }}
        />
    </Loop>
</Module>
