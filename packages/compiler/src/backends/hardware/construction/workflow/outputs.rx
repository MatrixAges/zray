<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.OutputTree} out={Hardware.Outputs?} />

    <Loop on={$in.running}>
        <Call
            module="next_output"
            in={{
                ...$in.pick([
                    "graph",
                    "variables",
                    "types",
                    "value_layout"
                ]),
                stack: [{
                    type_id: $in.type_id,
                    value: $in.value,
                    path: $in.path,
                    children: null
                }],
                ports: [],
                valid: true,
                running: true
            }}
        />
    </Loop>

    <If on={!$ctx.next_output.valid}>
        <Return value={null} />
    </If>

    <Return
        value={$ctx.next_output.pick([
            "graph",
            "ports"
        ])}
    />
</Module>
