<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.Definitions} out={void} />

    <Loop on={$in.running}>
        <Call
            module="next_definition"
            in={{
                ...$in,
                row: 0,
                running: $in.rows.names.length != 0
            }}
        />
    </Loop>

    <Call fn="host.clearHardwareOrigin" in={$in.build} />
</Module>
