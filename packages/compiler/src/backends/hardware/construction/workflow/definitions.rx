<Module>
    <Type from="model" as="Hardware" />

    <Args in={Hardware.Definitions} out={Hardware.Definitions} />

    <Loop on={$in.running}>
        <Call
            module="next_definition"
            in={{
                ...$in,
                row: 0,
                origin_file: null,
                running: $in.rows.names.length != 0
            }}
        />
    </Loop>

    <Return
        value={$ctx.next_definition.pick([
            "graph",
            "rows",
            "variables"
        ])}
    />
</Module>
