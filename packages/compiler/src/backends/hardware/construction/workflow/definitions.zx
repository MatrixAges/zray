import host from "hardware_build_host"

import parse from "../../terms/parse/run.rx"
import preserveOrigin from "./origin"

import type { Input as Request } from "./model"

export type Input = Request.Pick("build", "rows")

export type Output = void

export default function (in: Input): Output {
    const { build, rows } = in

    const published = loop(0, {
        while: row => row < rows.names.length,
        next: row => {
            const file = preserveOrigin({
                build,
                file: host.hardwareDefinitionFile(build, row)
            })

            host.setHardwareOrigin(build, file, row)
            const node = parse({
                build,
                expression: rows.expressions[row]
            })

            host.publishHardwareDefinition(
                build,
                rows.names[row],
                rows.widths[row],
                node
            )
            row += 1
        }
    })

    host.clearHardwareOrigin(build)
}
