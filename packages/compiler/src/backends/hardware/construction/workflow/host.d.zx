export type HardwareBuild = opaque

export enum Form {
    Invalid,
    Open,
    Indexed,
    Name,
    True,
    False,
    Constant,
    Invert,
    Negate,
    Select,
    Binary,
    SignExtend,
    ZeroExtend
}

export declare function reserveHardwareVariables(build: HardwareBuild, count: u64): void
    throws { OutOfMemory }

export declare function reserveHardwareCache(build: HardwareBuild, count: u64): void
    throws { OutOfMemory }

export declare function reserveHardwareInputs(build: HardwareBuild, count: u64): void
    throws { OutOfMemory }

export declare function reserveHardwareNodes(build: HardwareBuild, count: u64): void
    throws { OutOfMemory }

export declare function hardwareInputType(build: HardwareBuild, row: u64): u32

export declare function writeHardwareInput(
    build: HardwareBuild,
    row: u64,
    width: u64,
    boolean: bool,
    signed: bool
): void throws { OutOfMemory }

export declare function bindHardwareInputs(build: HardwareBuild): void
    throws { OutOfMemory, InvalidHardwareTerm }

export declare function hardwareDefinitionFile(build: HardwareBuild, row: u64): string

export declare function hardwareOriginFile(build: HardwareBuild): string?

export declare function retainHardwareOrigin(build: HardwareBuild, file: string): string
    throws { OutOfMemory }

export declare function setHardwareOrigin(build: HardwareBuild, file: string, row: u64): void

export declare function clearHardwareOrigin(build: HardwareBuild): void

export declare function hardwareTermOffset(build: HardwareBuild): u64

export declare function setHardwareTermOffset(build: HardwareBuild, offset: u64): void

export declare function hardwareVariable(build: HardwareBuild, name: string): u32?
    throws { OutOfMemory, InvalidHardwareTerm }

export declare function hardwareCacheKeys(build: HardwareBuild): string?[]

export declare function hardwareCacheValues(build: HardwareBuild): u32[]

export declare function hardwareCacheFull(build: HardwareBuild): bool

export declare function growHardwareCache(build: HardwareBuild): void
    throws { OutOfMemory }

export declare function hardwareNodeCount(build: HardwareBuild): u64

export declare function appendHardwareTerm(
    build: HardwareBuild,
    position: u64,
    key: string,
    form: Form,
    width: u64,
    boolean: bool,
    first: u64,
    second: u32,
    third: u32,
    operator: u8?,
    extra: u64
): u32 throws { OutOfMemory }

export declare function publishHardwareDefinition(
    build: HardwareBuild,
    name: string,
    width: u16,
    node: u32
): void throws { OutOfMemory, InvalidHardwareTerm }

export declare function hardwareNodeWidth(build: HardwareBuild, node: u32): u16

export declare function hardwareNodeIsBoolean(build: HardwareBuild, node: u32): bool

export declare function hardwareOutputCount(build: HardwareBuild): u64

export declare function writeHardwareOutput(
    build: HardwareBuild,
    name: string,
    path: string,
    node: u32,
    width: u64,
    boolean: bool,
    signed: bool
): void throws { OutOfMemory }

export declare function rejectHardwareTerm(): void
    throws { InvalidHardwareTerm }
