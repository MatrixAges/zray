import type { HardwareBuild } from "hardware_graph_host"
import type { ReadColumn, TextColumn } from "memory"
import type { SymbolicValue } from "verification_host"
import type { Ports } from "../../../../verification/execution/program/model"

export type Sizes = {
    build: HardwareBuild,
    inputs: u64,
    definitions: u64
}

export type OutputTree = {
    build: HardwareBuild,
    types: Ports,
    type_id: u32,
    value: SymbolicValue,
    path: string
}

export type Safety = {
    build: HardwareBuild,
    expression: string
}

export type Input = Sizes & {
    types: Ports,
    input_types: ReadColumn,
    rows: DefinitionRows,
    output_path: string,
    output_type: u32,
    output: SymbolicValue,
    safety: string
}

export type DefinitionRows = {
    names: string[],
    expressions: string[],
    widths: u16[],
    files: TextColumn
}

export type Definitions = Input.Pick("build", "rows")

export type DefinitionWalk = Definitions & {
    row: u64,
    origin_file?: string,
    running: bool
}

export type OutputChildren = {
    object: bool,
    first: u64,
    count: u64,
    next: u64
}

export type OutputFrame = OutputTree.Pick("type_id", "value", "path") & {
    children?: OutputChildren
}

export type OutputWalk = OutputTree.Pick("build", "types") & {
    stack: OutputFrame[],
    output_count: u64,
    running: bool
}

export type OutputLeaf = {
    path: string,
    expression: string,
    width: u64,
    boolean: bool,
    signed: bool
}

export type OutputSearch = {
    stack: OutputFrame[],
    leaf?: OutputLeaf
}

export type OutputWrite = {
    build: HardwareBuild,
    leaf: OutputLeaf,
    node: u32,
    index: u64
}
