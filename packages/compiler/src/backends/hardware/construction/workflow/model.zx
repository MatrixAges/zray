import type { ReadColumn, TextColumn } from "memory"
import type { Ports } from "../../../../verification/execution/program/model"
import type { Layout } from "../../../../verification/terms/layout"
import type { Sort } from "../../binary/model"
import type { Graph, Row } from "../../terms/parse/model"
import type { Table } from "../../terms/table"

export type Sizes = {
    inputs: u64,
    definitions: u64
}

export type OutputTree = {
    graph: Graph,
    variables: Table,
    types: Ports,
    type_id: u32,
    value: u8[],
    value_layout: Layout,
    path: string
}

export type Safety = {
    graph: Graph,
    variables: Table,
    expression: string
}

export type Input = Sizes & {
    types: Ports,
    input_types: ReadColumn,
    input_names: TextColumn,
    rows: DefinitionRows,
    output_path: string,
    output_type: u32,
    output: u8[],
    value_layout: Layout,
    safety: string
}

export type InputPort = Sort & {
    signed: bool
}

export type OutputPort = {
    symbol: string,
    path: string,
    node: u32,
    width: u64,
    boolean: bool,
    signed: bool
}

export type InputWalk = Input.Pick("inputs", "input_types", "types") & {
    row: u64,
    valid: bool,
    ports: InputPort[],
    nodes: Row[]
}

export type DefinitionRows = {
    names: string[],
    expressions: string[],
    widths: u16[],
    files: TextColumn
}

export type Definitions = Input.Pick("rows") & {
    graph: Graph,
    variables: Table
}

export type DefinitionWalk = Definitions & {
    row: u64,
    origin_file?: string,
    valid: bool,
    running: bool
}

export type OutputChildren = {
    object: bool,
    first: u64,
    count: u64,
    next: u64
}

export type OutputFrame = OutputTree.Pick("type_id", "value", "path") & {
    children?: OutputChildren
}

export type OutputWalk =
    OutputTree.Pick("graph", "variables", "types", "value_layout") & {
        stack: OutputFrame[],
        ports: OutputPort[],
        valid: bool,
        running: bool
    }

export type OutputLeaf = {
    path: string,
    expression: string,
    width: u64,
    boolean: bool,
    signed: bool
}

export type OutputSearch = {
    valid: bool,
    stack: OutputFrame[],
    leaf?: OutputLeaf
}

export type Outputs = {
    graph: Graph,
    ports: OutputPort[]
}

export type Output = {
    nodes: Row[],
    safe: u32,
    inputs: InputPort[],
    outputs: OutputPort[]
}

export type OutputWrite = {
    sort: Sort,
    leaf: OutputLeaf,
    node: u32,
    ports: OutputPort[]
}
