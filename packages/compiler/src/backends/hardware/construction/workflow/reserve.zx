import { maximum_nodes } from "../../const"

import type { GraphCapacity } from "hardware_graph_host"
import type { Sizes } from "./model"

export type Input = Sizes.Pick("inputs", "definitions")

export type Output = GraphCapacity

export default function (in: Input): Output {
    const { inputs, definitions } = in

    const symbols = inputs + definitions
    const nodes = symbols < maximum_nodes ? symbols : maximum_nodes

    return {
        symbols,
        definitions,
        inputs,
        nodes
    }
}
