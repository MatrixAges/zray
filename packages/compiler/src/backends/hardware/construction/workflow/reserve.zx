import integers from "std:integer"
import capacity from "core/bytes/map/capacity"

import empty from "../../terms/table"

import type { Graph } from "../../terms/parse/model"
import type { Sizes as Input } from "./model"

export type Output = {
    graph: Graph,
    symbol_capacity: u64
}

export default function (in: Input): Output {
    const cache = capacity(integers.narrow(in.definitions))
    const symbols = capacity(integers.narrow(in.inputs + in.definitions))

    return {
        graph: {
            nodes: [],
            cache: empty(cache.capacity),
            cache_limit: cache.limit
        },
        symbol_capacity: symbols.capacity
    }
}
