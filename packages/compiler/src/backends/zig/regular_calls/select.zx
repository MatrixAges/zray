import bytes from "std:bytes"
import memory from "memory"

import { marked } from "./const"

import type { Selection as Input, Selected as Output } from "./model"

export default function (in: Input): Output {
    const { pending, groups } = in.candidates

    return loop({
        read: 0,
        pending: 0,
        ready: 0
    }, {
        while: current => current.read < in.count,
        next: current => {
            const position = memory.readU64(pending, current.read)
            const group = memory.readU64(groups, position)
            const wanted = bytes.loadAtomicCell(in.wanted, 0, group)

            if (wanted == marked) {
                memory.writeColumnBool(in.regular, position, true)
                memory.writeU64(in.positions, current.ready, position)
                current.ready += 1
            } else {
                if (current.pending != current.read) {
                    memory.writeU64(pending, current.pending, position)
                }

                current.pending += 1
            }

            current.read += 1
        },
        return: current => current.pick([
            "pending",
            "ready"
        ])
    })
}
