import { marked } from "./const"
import { Wave } from "./model"

import type { Selection as Input, Selected as Output } from "./model"

export default function (in: Input): Output {
    const empty: u64[] = []

    const result = loop({
        read: 0,
        pending: empty,
        ready: empty
    }, {
        while: current => current.read < in.pending.length,
        next: current => {
            const position = in.pending[current.read]
            const group = in.groups[position]

            if (in.wanted[group] == marked) {
                current.ready = current.ready.push(position)[0]
            } else {
                current.pending = current.pending.push(position)[0]
            }

            current.read += 1
        }
    })

    const wave = match {
        result.ready.length == 0 => Wave.Converged,
        result.pending.length == 0 => Wave.Publish,
        _ => Wave.Rescan
    }

    return {
        pending: result.pending,
        ready: result.ready,
        wave
    }
}
