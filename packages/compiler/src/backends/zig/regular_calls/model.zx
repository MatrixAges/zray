import type { AtomicRows } from "std:bytes"
import type { Table } from "core/bytes/index/fixed"
import type { StringBuffer, TextColumn, U64Buffer, WriteColumn } from "memory"
import type { View } from "../function_units/model"

export type Candidates = {
    pending: U64Buffer,
    groups: U64Buffer
}

export type Indexed = {
    table: Table,
    candidates: Candidates,
    units: View,
    values: bool[]
}

export type Sources = {
    roots: string[],
    initializers: TextColumn,
    initializer_count: u64,
    functions: string[]
}

export type Scan = {
    source: string,
    table: Table,
    wanted: AtomicRows
}

export type Selection = {
    candidates: Candidates,
    wanted: AtomicRows,
    count: u64,
    regular: WriteColumn,
    positions: U64Buffer
}

export type Selected = {
    pending: u64,
    ready: u64
}

export type Publication = {
    positions: u64[],
    sources: string[],
    target: StringBuffer
}
