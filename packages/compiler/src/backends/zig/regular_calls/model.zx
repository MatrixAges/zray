import type { TextColumn } from "memory"
import type { View } from "../function_units/model"

export type Lookup = {
    keys: u8[][],
    buckets: u64[],
    capacity: u64
}

export type Indexed = {
    keys: u8[][],
    capacity: u64,
    units: View,
    values: bool[]
}

export type Built = {
    buckets: u64[],
    pending: u64[],
    groups: u64[]
}

export type Sources = {
    roots: string[],
    initializers: TextColumn,
    initializer_count: u64,
    functions: string[]
}

export type Ranges = {
    roots: u64,
    initializers: u64,
    end: u64
}

export type Scan = {
    source: string,
    table: Lookup
}

export type Selection = {
    pending: u64[],
    groups: u64[],
    wanted: u8[]
}

export enum Wave {
    Converged,
    Publish,
    Rescan
}

export type Selected = {
    pending: u64[],
    ready: u64[],
    wave: Wave
}
