import bytes from "std:bytes"
import encoding from "std:encoding"

import { call_marker, quote } from "./const"
import probe from "./probe"

import type { Scan as Input } from "./model"

export type Output = u64[]

export default function (in: Input): Output {
    const source = bytes.fromText(in.source)
    const empty: u64[] = []

    return loop({
        cursor: 0,
        done: false,
        hits: empty
    }, {
        while: current => !current.done,
        next: current => {
            const at = bytes.indexOfText(source, current.cursor, call_marker)

            if (at == null) {
                current.done = true
            } else {
                current.cursor = at + call_marker.length

                const prefix = encoding.sliceBytes(in.source, 0, at)
                const open = bytes.lastIndexOfScalar(bytes.fromText(prefix), quote)

                if (open != null) {
                    const key =
                        bytes.fromText(encoding.sliceBytes(
                            in.source,
                            open + 1,
                            at
                        ))
                    const found = probe({
                        table: in.table,
                        key
                    })

                    if (found != null) {
                        current.hits = current.hits.push(found)[0]
                    }
                }
            }
        },
        return: current => current.hits
    })
}
