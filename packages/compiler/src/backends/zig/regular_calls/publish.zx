import memory from "memory"

import type { Publication as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const result = loop({
        index: 0
    }, {
        while: current => current.index < in.positions.length,
        next: current => {
            const { index } = current

            memory.writeString(
                in.target,
                in.positions[index],
                in.sources[index]
            )
            current.index += 1
        }
    })
}
