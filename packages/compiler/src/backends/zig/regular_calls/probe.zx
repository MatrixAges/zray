import bytes from "std:bytes"
import integers from "std:integer"

import type { Lookup } from "./model"

export type Input = {
    table: Lookup,
    key: u8[]
}

export type Output = u64?

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in.table

    const mask = capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(in.key), mask),
        found: 0,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const row = buckets[state.slot]

            if (row == 0) {
                state.done = true
            } else if (bytes.equals(keys[row - 1], in.key)) {
                state.found = row
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => match state.found {
            0 => null,
            _ => state.found - 1
        }
    })
}
