import memory from "memory"

import type { Ranges, Scan, Sources } from "./model"

export type Input = Scan.Omit("source") & {
    sources: Sources,
    ranges: Ranges,
    position: u64
}

export type Output = string

export default function (in: Input): Output {
    const { sources, position, ranges } = in

    if (position < ranges.roots) {
        return sources.roots[position]
    }

    if (position < ranges.initializers) {
        return memory.readTextColumn(sources.initializers, position - ranges.roots)
    }

    return sources.functions[position - ranges.initializers]
}
