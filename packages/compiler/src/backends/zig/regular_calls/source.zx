import memory from "memory"

import type { Scan, Sources } from "./model"

export type Input = Scan.Omit("source") & {
    sources: Sources,
    position: u64
}

export type Output = string

export default function (in: Input): Output {
    const { sources, position } = in

    const first = sources.roots.length

    if (position < first) {
        return sources.roots[position]
    }

    const later = position - first

    if (later < sources.initializer_count) {
        return memory.readTextColumn(sources.initializers, later)
    }

    return sources.functions[later - sources.initializer_count]
}
