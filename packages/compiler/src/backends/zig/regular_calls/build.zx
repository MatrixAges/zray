import integers from "std:integer"
import find from "core/bytes/index/fixed"
import memory from "memory"

import type { Indexed as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in.table
    const { pending, groups } = in.candidates
    const { units, values } = in

    return loop({
        position: 0,
        count: 0
    }, {
        while: current => current.position < units.length,
        next: current => {
            const id = units[current.position]

            if (id != null && values[integers.widen(id)]) {
                const index = integers.widen(id)
                const group = find({
                    keys,
                    buckets,
                    capacity,
                    key: keys[index],
                    insert: index
                })

                memory.writeU64(groups, current.position, group ?? index)
                memory.writeU64(pending, current.count, current.position)
                current.count += 1
            }

            current.position += 1
        },
        return: current => current.count
    })
}
