import integers from "std:integer"
import find from "core/bytes/index/fixed"
import memory from "memory"

import type { Indexed as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { keys, buckets, capacity } = in.table
    const { pending, groups } = in.candidates
    const { units, values } = in

    return loop({
        position: 0,
        count: 0
    }, {
        while: current => current.position < units.count,
        next: current => {
            const row = current.position
            current.position += 1

            if (!memory.readColumnBool(units.regular, row)) {
                const index = integers.widen(memory.readColumnU32(units.ids, row))

                if (values[index]) {
                    const group = find({
                        keys,
                        buckets,
                        capacity,
                        key: keys[index],
                        insert: index
                    })

                    memory.writeU64(groups, row, group ?? index)
                    memory.writeU64(pending, current.count, row)
                    current.count += 1
                }
            }
        },
        return: current => current.count
    })
}
