import integers from "std:integer"
import memory from "memory"

import insert from "./insert"
import zeroBuckets from "./zero_buckets"

import type { Built, Indexed as Input } from "./model"

export type Output = Built

export default function (in: Input): Output {
    const { keys, capacity, units, values } = in

    const empty_pending: u64[] = []
    const empty_groups: u64[] = []

    return loop({
        position: 0,
        buckets: zeroBuckets(capacity),
        pending: empty_pending,
        groups: empty_groups
    }, {
        while: current => current.position < units.count,
        next: current => {
            const row = current.position
            const regular = memory.readColumnBool(units.regular, row)
            const index = integers.widen(memory.readColumnU32(units.ids, row))
            const wanted = !regular && values[index]

            if (wanted) {
                const inserted = insert({
                    keys,
                    buckets: current.buckets,
                    capacity,
                    key: keys[index],
                    insert: index
                })

                current.buckets = inserted.buckets
                current.groups = current.groups.push(inserted.group ?? index)[0]
                current.pending = current.pending.push(row)[0]
            } else {
                current.groups = current.groups.push(0)[0]
            }

            current.position += 1
        },
        return: current => current.pick([
            "buckets",
            "pending",
            "groups"
        ])
    })
}
