import type { ReadColumn } from "memory"

export type Disk = {
    kinds: ReadColumn,
    stored: u8,
    invalid: u8,
    failed: u8,
    writer_active: bool
}

export type Input = {
    count: u64,
    sources: ReadColumn,
    collect_lookup: bool,
    disk?: Disk
}

export type Output = {
    reused: u64[],
    pending: u64[],
    pending_count: u64,
    offsets: u64[],
    stored: u64[],
    size: u64,
    held: u64,
    discarded: u64,
    failures: u64,
    last_failure?: u64,
    ordered: bool
}

export type CopyEntry = {
    position: u64,
    offset: u64,
    source: string
}

export type Copy = {
    items: ReadColumn,
    contiguous: bool,
    positions?: u64[],
    offsets: u64[],
    first: u64,
    end: u64
}

export type CopyOutput = {
    valid: bool,
    entries: CopyEntry[]
}
