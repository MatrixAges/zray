import type { ReadColumn, StringBuffer, U8Buffer, U64Buffer } from "memory"

export type Disk = {
    kinds: ReadColumn,
    stored: u8,
    invalid: u8,
    failed: u8,
    writer_active: bool
}

export type Lookup = {
    disk?: Disk,
    reused: U64Buffer,
    pending: U64Buffer
}

export type Input = {
    count: u64,
    sources: ReadColumn,
    offsets: U64Buffer,
    lookup?: Lookup
}

export type Output = {
    reused: u64,
    pending: u64,
    size: u64,
    stored: u64,
    held: u64,
    discarded: u64,
    failures: u64,
    last_failure?: u64,
    ordered: bool
}

export type Copy = {
    items: ReadColumn,
    contiguous: bool,
    positions?: u64[],
    offsets: u64[],
    data: string,
    buffer: U8Buffer,
    target: StringBuffer,
    first: u64,
    end: u64
}
