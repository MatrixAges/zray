import type { ReadColumn, StringBuffer, U8Buffer, U64Buffer } from "memory"

export type Lookup = {
    kinds: ReadColumn,
    absent: u8,
    reused: U64Buffer,
    pending: U64Buffer
}

export type Input = {
    count: u64,
    sources: ReadColumn,
    offsets: U64Buffer,
    lookup?: Lookup
}

export type Output = {
    reused: u64,
    pending: u64,
    size: u64,
    record_first?: u64,
    record_end: u64
}

export type Copy = {
    items: ReadColumn,
    contiguous: bool,
    positions?: u64[],
    offsets: u64[],
    data: string,
    buffer: U8Buffer,
    target: StringBuffer,
    first: u64,
    end: u64
}
