<Module>
    <Type from="model" as="Sources" />

    <Args in={Sources.Input} out={Sources.Output} />

    <If on={$in.count == 0}>
        <Return
            value={{
                steps: []
            }}
        />
    </If>

    <If on={$in.reuse != null}>
        <Call module="../updates/record" in={$in.reuse} />

        <Call fn="cached" in={$in.reuse} />

        <Return
            value={{
                steps: $ctx.cached,
                record: $ctx.record
            }}
        />
    </If>

    <If on={$in.cached}>
        <Return
            value={{
                steps: [Sources.Step.Fetch]
            }}
        />
    </If>

    <Return
        value={{
            steps: [
                Sources.Step.Generate,
                Sources.Step.Publish
            ]
        }}
    />
</Module>
