<Module>
    <Type from="model" as="Sources" />

    <Args in={Sources.Input} out={bool} />

    <If on={$in.count == 0}>
        <Return value={true} />
    </If>

    <Call fn="read" in={$in} />

    <If on={$ctx.read != null}>
        <Call
            fn="restore"
            in={{
                batch: $in.batch,
                hits: $ctx.read.hits
            }}
        />

        <Call
            fn="../updates/record"
            in={$ctx.read.omit([
                "hits",
                "pending"
            ])}
        />

        <If on={!$ctx.record}>
            <Return value={false} />
        </If>

        <If on={$ctx.read.pending == 0}>
            <Return value={true} />
        </If>
    </If>

    <Call fn="emit" in={$in.batch} />

    <Return value={true} />
</Module>
