<Module>
    <Type from="model" as="Sources" />

    <Args in={Sources.Input} out={bool} />

    <If on={$in.count == 0}>
        <Return value={true} />
    </If>

    <If on={$in.cached}>
        <Call fn="index.readFunctionSources" in={$in.batch} />

        <If on={$ctx.readFunctionSources.hits != 0}>
            <Call fn="index.restoreFunctionSources" in={$in.batch} />
        </If>

        <Call
            module="../updates/record"
            in={{
                ...$ctx.readFunctionSources.omit([
                    "hits",
                    "pending"
                ]),
                batch: $in.batch
            }}
        />

        <If on={!$ctx.record}>
            <Return value={false} />
        </If>

        <If on={$ctx.readFunctionSources.pending == 0}>
            <Return value={true} />
        </If>
    </If>

    <Call fn="index.generateFunctionSources" in={$in.batch} />
    <Call fn="index.publishFunctionSources" in={$in.batch} />

    <Return value={true} />
</Module>
