import memory from "memory"

import copy from "./copy"

import type { AtomicIndex, U32Buffer } from "memory"
import type { Copy } from "./model"

export type Input = Copy.Omit("first", "end") & {
    cursor: AtomicIndex,
    width: u64,
    failure: U32Buffer
}

export type Output = bool

export default function (in: Input): Output {
    const { items, contiguous, positions, offsets, data, buffer, target } = in
    const { cursor, width, failure } = in

    const count = offsets.length

    return loop({
        running: true,
        valid: true
    }, {
        while: state =>
            state.running && state.valid && memory.loadU32Relaxed(failure, 0) == 0,
        next: state => {
            const first = memory.fetchAddIndexRelaxed(cursor, width)

            if (first >= count) {
                state.running = false
            } else {
                const remaining = count - first
                const length = width < remaining ? width : remaining
                state.valid = copy({
                    items,
                    contiguous,
                    positions,
                    offsets,
                    data,
                    buffer,
                    target,
                    first,
                    end: first + length
                })

            }
        },
        return: state => state.valid
    })
}
