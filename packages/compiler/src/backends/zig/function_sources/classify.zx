import memory from "memory"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { disk, collect_lookup } = in

    const first_failure: u64? = null
    const empty: u64[] = []

    const result = loop({
        index: 0,
        reused: empty,
        pending: empty,
        pending_count: 0,
        offsets: empty,
        stored: empty,
        size: 0,
        discarded: 0,
        failures: 0,
        last_failure: first_failure
    }, {
        while: state => state.index < in.count,
        next: state => {
            const { index } = state
            const source = memory.readOptionalTextColumn(in.sources, index)

            if (source == null) {
                if (collect_lookup) {
                    state.pending = state.pending.push(index)[0]
                }

                state.pending_count += 1
            } else {
                if (collect_lookup) {
                    state.reused = state.reused.push(index)[0]
                }

                state.offsets = state.offsets.push(state.size)[0]
                state.size += source.length
            }

            if (disk != null) {
                const kind = memory.readColumnU8(disk.kinds, index)

                if (kind == disk.stored && collect_lookup) {
                    state.stored = state.stored.push(index)[0]
                } else if (kind == disk.invalid) {
                    state.discarded += 1
                } else if (kind == disk.failed) {
                    state.failures += 1
                    state.last_failure = index
                }
            }

            state.index += 1
        }
    })

    const has_ordered_error = (
        - result.stored.length != 0
        - and result.last_failure != null
    )

    const ordered = disk != null && disk.writer_active && has_ordered_error

    return {
        reused: result.reused,
        pending: result.pending,
        pending_count: result.pending_count,
        offsets: result.offsets,
        stored: result.stored,
        size: result.size,
        held: result.reused.length - result.stored.length,
        discarded: result.discarded,
        failures: result.failures,
        last_failure: result.last_failure,
        ordered
    }
}
