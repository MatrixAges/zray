import memory from "zig:compiler_memory"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    return loop({
        index: 0,
        reused: 0,
        pending: 0,
        size: 0
    }, {
        while: current => current.index < in.count,
        next: current => {
            const { index } = current
            const source = memory.readOptionalTextColumn(in.sources, index)

            if (source == null) {
                memory.writeU64(in.pending, current.pending, index)
                current.pending += 1
            } else {
                memory.writeU64(in.reused, current.reused, index)
                memory.writeU64(in.offsets, current.reused, current.size)
                current.reused += 1
                current.size += source.length
            }

            current.index += 1
        },
        return: current => {
            reused: current.reused,
            pending: current.pending,
            size: current.size
        }
    })
}
