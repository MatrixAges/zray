import memory from "memory"

import type { Disk, Input, Output } from "./model"

export default function (in: Input): Output {
    const { lookup } = in

    const disk: Disk? = match {
        lookup != null => lookup.disk,
        _ => null
    }

    const first_failure: u64? = null

    return loop({
        index: 0,
        reused: 0,
        pending: 0,
        size: 0,
        stored: 0,
        discarded: 0,
        failures: 0,
        last_failure: first_failure
    }, {
        while: state => state.index < in.count,
        next: state => {
            const { index } = state
            const source = memory.readOptionalTextColumn(in.sources, index)

            if (source == null) {
                if (lookup != null) {
                    memory.writeU64(lookup.pending, state.pending, index)
                }

                state.pending += 1
            } else {
                if (lookup != null) {
                    memory.writeU64(lookup.reused, state.reused, index)
                }

                memory.writeU64(in.offsets, state.reused, state.size)
                state.reused += 1
                state.size += source.length
            }

            if (disk != null) {
                const kind = memory.readColumnU8(disk.kinds, index)

                if (kind == disk.stored && lookup != null) {
                    state.stored += 1
                    const tail = in.count - state.stored

                    memory.writeU64(lookup.pending, tail, index)
                } else if (kind == disk.invalid) {
                    state.discarded += 1
                } else if (kind == disk.failed) {
                    state.failures += 1
                    state.last_failure = index
                }
            }

            state.index += 1
        },
        return: state => ({
            reused: state.reused,
            pending: state.pending,
            size: state.size,
            stored: state.stored,
            discarded: state.discarded,
            failures: state.failures,
            last_failure: state.last_failure
        })
    })
}
