import memory from "memory"

import type { Disk, Input, Output } from "./model"

export default function (in: Input): Output {
    const { lookup } = in

    const disk: Disk? = match {
        lookup != null => lookup.disk,
        _ => null
    }

    const first_failure: u64? = null

    const result = loop({
        index: 0,
        reused: 0,
        pending: 0,
        size: 0,
        stored: 0,
        discarded: 0,
        failures: 0,
        last_failure: first_failure
    }, {
        while: state => state.index < in.count,
        next: state => {
            const { index } = state
            const source = memory.readOptionalTextColumn(in.sources, index)

            if (source == null) {
                if (lookup != null) {
                    memory.writeU64(lookup.pending, state.pending, index)
                }

                state.pending += 1
            } else {
                if (lookup != null) {
                    memory.writeU64(lookup.reused, state.reused, index)
                }

                memory.writeU64(in.offsets, state.reused, state.size)
                state.reused += 1
                state.size += source.length
            }

            if (disk != null) {
                const kind = memory.readColumnU8(disk.kinds, index)

                if (kind == disk.stored && lookup != null) {
                    state.stored += 1
                    const tail = in.count - state.stored

                    memory.writeU64(lookup.pending, tail, index)
                } else if (kind == disk.invalid) {
                    state.discarded += 1
                } else if (kind == disk.failed) {
                    state.failures += 1
                    state.last_failure = index
                }
            }

            state.index += 1
        }
    })

    const has_ordered_error = (
        - result.stored != 0
        - and result.last_failure != null
    )

    const ordered = disk != null && disk.writer_active && has_ordered_error

    return {
        reused: result.reused,
        pending: result.pending,
        size: result.size,
        stored: result.stored,
        held: result.reused - result.stored,
        discarded: result.discarded,
        failures: result.failures,
        last_failure: result.last_failure,
        ordered
    }
}
