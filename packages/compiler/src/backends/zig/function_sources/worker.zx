import host from "output_host"

import job from "./job"

import type { FunctionSourceWorker } from "output_host"
import type { Jobs } from "./job"

export type Input = {
    jobs: Jobs,
    row: u64,
    position: u64,
    search: bool,
    worker: FunctionSourceWorker
}

export type Output = u32

export default function (in: Input): Output {
    const route = job({
        jobs: in.jobs,
        position: in.position
    })

    return match in.search {
        true => host.findFunctionSource(in.worker, in.row, route.kind, route.index),
        _ => host.renderFunctionSource(in.worker, in.row, route.kind, route.index)
    }
}
