<Module>
    <Type from="model" as="Sources" />

    <Args in={Sources.Reuse} out={Sources.Record} />

    <If on={$in.ordered}>
        <Return
            value={{
                order: Sources.Order.All,
                stored: []
            }}
        />
    </If>

    <Return
        value={{
            order: Sources.Order.StoredDescending,
            stored: $in.stored
        }}
    />
</Module>
