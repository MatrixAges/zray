import host from "output_host"

import type { Pending as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { target, positions } = in

    const published = loop(0, {
        while: index => index < positions.length,
        next: index => {
            host.commitGeneratedSource(target, positions[index], index)

            index += 1
        }
    })
}
