<Module>
    <Type from="model" as="Sources" />

    <Args in={Sources.Adoption} out={Sources.Adoption} />

    <Call
        fn="host.recordCachedRows"
        in={[
            $in.batch,
            $in.stored[$in.remaining - 1],
            $in.stored[$in.remaining - 1] + 1
        ]}
    />

    <Return
        value={{
            ...$in,
            remaining: $in.remaining - 1,
            failure: $ctx.recordCachedRows ? null : $in.stored[$in.remaining - 1]
        }}
    />
</Module>
