import host from "output_host"

import type { CachedSourceRows } from "output_host"

export type Input = {
    target: CachedSourceRows,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { target, count } = in

    const recorded = loop(0, {
        while: row => row < count,
        next: row => {
            host.recordCachedSource(target, row)

            row += 1
        }
    })
}
