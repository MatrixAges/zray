import integers from "std:integer"
import memory from "memory"
import { FunctionSourceKind as Kind } from "output_host"

import type { View } from "../function_units/model"

export type Jobs = {
    entries: u64,
    types: bool,
    functions: View,
    selected?: u64[]
}

export type Input = {
    jobs: Jobs,
    position: u64
}

export type Output = {
    kind: Kind,
    index: u64
}

export default function (in: Input): Output {
    const { jobs, position } = in

    if (position < jobs.entries) {
        return {
            kind: Kind.Entry,
            index: position
        }
    }

    const offset = position - jobs.entries

    if (jobs.types && offset == 0) {
        return {
            kind: Kind.Types,
            index: 0
        }
    }

    const row = offset - (jobs.types ? 1 : 0)

    const { selected } = jobs

    const index = selected == null ? row : selected[row]
    const regular = memory.readColumnBool(jobs.functions.regular, index)
    const id = memory.readColumnU32(jobs.functions.ids, index)

    return {
        kind: regular ? Kind.Regular : Kind.Function,
        index: integers.widen(id)
    }
}
