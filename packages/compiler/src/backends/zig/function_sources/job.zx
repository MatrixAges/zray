import integers from "std:integer"
import memory from "memory"

import type { View } from "../function_units/model"

export enum Kind {
    Entry,
    Types,
    Function,
    Regular
}

export type Input = {
    entries: u64,
    types: bool,
    functions: View,
    selected?: u64[],
    position: u64
}

export type Output = {
    kind: Kind,
    index: u64
}

export default function (in: Input): Output {
    if (in.position < in.entries) {
        return {
            kind: Kind.Entry,
            index: in.position
        }
    }

    const offset = in.position - in.entries

    if (in.types && offset == 0) {
        return {
            kind: Kind.Types,
            index: 0
        }
    }

    const row = offset - (in.types ? 1 : 0)

    const { selected } = in

    const index = selected == null ? row : selected[row]
    const regular = memory.readColumnBool(in.functions.regular, index)
    const id = memory.readColumnU32(in.functions.ids, index)

    return {
        kind: regular ? Kind.Regular : Kind.Function,
        index: integers.widen(id)
    }
}
