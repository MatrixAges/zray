import memory from "memory"

import type { Copy as Input, CopyEntry, CopyOutput as Output } from "./model"

export default function (in: Input): Output {
    const { positions } = in

    const empty: CopyEntry[] = []

    return loop({
        index: in.first,
        valid: true,
        entries: empty
    }, {
        while: current => current.valid && current.index < in.end,
        next: current => {
            const { index } = current
            const position = positions == null ? index : positions[index]
            const row = in.contiguous ? index : position
            const source = memory.readOptionalTextColumn(in.items, row)

            if (source == null) {
                current.valid = false
            } else {
                current.entries = current.entries.push({
                    position,
                    offset: in.offsets[index],
                    source
                })[0]
            }

            current.index += 1
        },
        return: current => current.pick([
            "valid",
            "entries"
        ])
    })
}
