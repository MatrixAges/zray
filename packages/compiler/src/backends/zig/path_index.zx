import integers from "std:integer"
import {
    initial_capacity,
    capacity_growth,
    load_numerator,
    load_denominator
} from "core/bytes/index/const"
import probe from "core/bytes/index/probe"

import type { Index as Output } from "core/bytes/index/model"

export type Input = u8[][]

export default function (in: Input): Output {
    const keys = in
    const count = keys.length

    if (count == 0) {
        return {
            keys,
            values: [],
            buckets: []
        }
    }

    const capacity = loop({
        capacity: initial_capacity
    }, {
        while: current =>
            current.capacity * load_numerator / load_denominator < count,
        next: current => {
            current.capacity *= capacity_growth
        },
        return: current => current.capacity
    })

    const empty_values: u32[] = []

    const values = loop({
        position: 0,
        items: empty_values
    }, {
        while: current => current.position < count,
        next: current => {
            current.items = current.items.push(integers.narrow(current.position))[0]
            current.position += 1
        },
        return: current => current.items
    })

    const absent: u32? = null
    const empty_buckets: u32?[] = []

    const empty_table = loop({
        position: 0,
        items: empty_buckets
    }, {
        while: current => current.position < capacity,
        next: current => {
            current.items = current.items.push(absent)[0]
            current.position += 1
        },
        return: current => current.items
    })

    const buckets = loop({
        position: 0,
        items: empty_table
    }, {
        while: current => current.position < count,
        next: current => {
            const position = current.position
            const row = integers.narrow(position)
            const slot = probe({
                index: {
                    keys,
                    values,
                    buckets: current.items
                },
                key: keys[position]
            })

            current.items[slot] = row
            current.position += 1
        },
        return: current => current.items
    })

    return {
        keys,
        values,
        buckets
    }
}
