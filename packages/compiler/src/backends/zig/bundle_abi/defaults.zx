import bytes from "std:bytes"
import memory from "memory"

import contains from "../source_abi/contains"
import append from "./append"

import type { Alias } from "genz/abi/model"
import type { Defaults as Output } from "./model"
import type { Input } from "./model"

export default function (
    in: Input
): Output {
    const aliases: Alias[] = []
    const conflicts: bool[] = []

    const defaults = loop({
        modules: in.modules,
        state: {
            aliases,
            conflicts
        },
        index: 0
    }, {
        while: current => current.index < current.modules.specifiers.length,
        next: current => {
            if (current.modules.identities[current.index] == null) {
                const name = current.modules.specifiers[current.index]

                current.state = append({
                    state: current.state,
                    alias: {
                        name,
                        identity: name
                    }
                })
            }

            current.index += 1
        }
    })

    return loop({
        source: in,
        state: defaults.state,
        index: 0,
        count: in.scopes.count
    }, {
        while: current => current.index < current.count,
        next: current => {
            const { scopes } = current.source
            const root = memory.readTextColumn(scopes.roots, current.index)

            if (
                bytes.equals(
                    bytes.fromText(root),
                    bytes.fromText(current.source.root)
                )
            ) {
                const first =
                    memory.listLength(scopes.interfaces.specifiers, current.index)
                const last =
                    memory.listLength(scopes.externals.specifiers, current.index)
                const entries = loop({
                    scopes,
                    scope: current.index,
                    first,
                    modules: current.source.modules,
                    state: current.state,
                    index: 0,
                    count: first + last
                }, {
                    while: entry => entry.index < entry.count,
                    next: entry => {
                        const { first } = entry
                        const external = entry.index >= first
                        const source = match {
                            external => entry.scopes.externals,
                            _ => entry.scopes.interfaces
                        }
                        const index = external ? entry.index - first : entry.index
                        const name =
                            memory.readListText(
                                source.specifiers,
                                entry.scope,
                                index
                            )
                        const identity =
                            memory.readListOptionalText(
                                source.identities,
                                entry.scope,
                                index
                            ) ?? name

                        if (contains({
                            modules: entry.modules,
                            identity
                        })) {
                            entry.state = append({
                                state: entry.state,
                                alias: {
                                    name,
                                    identity
                                }
                            })
                        }

                        entry.index += 1
                    }
                })

                current.state = entries.state
            }

            current.index += 1
        },
        return: state => state.state
    })
}
