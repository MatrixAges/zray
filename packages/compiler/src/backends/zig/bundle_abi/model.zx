import type { Alias } from "genz/abi/model"
import type { TextColumn } from "memory"
import type { Bindings, Scopes } from "../source_abi/model"

export enum Status {
    Valid,
    ConflictingAlias,
    NameConflict
}

export type AliasRows = {
    count: u64,
    names: TextColumn,
    identities: TextColumn
}

export type Native = {
    name: string,
    aliases?: AliasRows
}

export type Settings = {
    count: u64,
    names: TextColumn,
    roots: TextColumn
}

export type Input = {
    modules: Bindings,
    root: string,
    scopes: Scopes,
    natives: Native[],
    settings: Settings,
    file_count: u64,
    files: TextColumn
}

export type ViewInput = {
    source: Input,
    native: Native,
    aliases: AliasRows
}

export type Resolved = {
    status: Status,
    aliases: Alias[],
    explicit: Alias[]
}

export type View = {
    module: string,
    name: string,
    path: string,
    aliases: Alias[]
}

export type ViewResult = {
    status: Status,
    view: View,
    roots: Alias[]
}

export type Defaults = {
    aliases: Alias[],
    conflicts: bool[]
}

export type ViewsInput = {
    source: Input,
    defaults: Defaults
}

export type Views = {
    status: Status,
    views: View[],
    defaults: Defaults
}

export type Output = {
    status: Status,
    aliases: Alias[],
    views: View[]
}

export type Traversal = Views & {
    source: Input,
    index: u64,
    running: bool
}

export type ViewWrite = {
    state: Traversal,
    selected: ViewResult
}
