import bytes from "std:bytes"
import memory from "memory"

import type { ViewInput as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        settings: in.source.settings,
        name: bytes.fromText(in.native.name),
        root: bytes.fromText(in.source.root),
        count: in.source.settings.count,
        selected: false,
        index: 0
    }, {
        while: current => current.index < current.count,
        next: current => {
            if (
                bytes.equals(
                    bytes.fromText(
                        memory.readTextColumn(
                            current.settings.names,
                            current.index
                        )
                    ),
                    current.name
                )
            ) {
                current.selected = bytes.equals(
                    bytes.fromText(
                        memory.readTextColumn(
                            current.settings.roots,
                            current.index
                        )
                    ),
                    current.root
                )
            }

            current.index += 1
        },
        return: state => state.selected
    })
}
