import type { Traversal as Input, ViewInput } from "./model"

export type Output = ViewInput?

export default function (in: Input): Output {
    const native = in.source.natives[in.index]
    const aliases = native.aliases

    if (aliases == null) {
        return null
    }

    return {
        source: in.source,
        native,
        aliases
    }
}
