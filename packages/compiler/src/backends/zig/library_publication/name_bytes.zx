import { zig_suffix } from "./const"

export type Input = string[]

export type Output = u64

export default function (in: Input): Output {
    return loop({
        row: 0,
        total: 0
    }, {
        while: state => state.row < in.length,
        next: state => {
            state.total += in[state.row].length + zig_suffix.length
            state.row += 1
        },
        return: state => state.total
    })
}
