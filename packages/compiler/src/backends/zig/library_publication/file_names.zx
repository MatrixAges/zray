import { zig_suffix } from "./const"

export type Input = string[]

export type Output = string[]

export default function (in: Input): Output {
    const empty: string[] = []

    return loop({
        row: 0,
        paths: empty
    }, {
        while: state => state.row < in.length,
        next: state => {
            state.paths = state.paths.push(`${in[state.row]}${zig_suffix}`)[0]
            state.row += 1
        },
        return: state => state.paths
    })
}
