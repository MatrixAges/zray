import memory from "memory"

import type { Input, Member, Output } from "./model"

export default function (in: Input): Output {
    const { source } = in

    const empty_ids: u32[] = []
    const empty_members: Member[] = []
    const empty_ends: u64[] = []

    return loop({
        module: 0,
        roots: empty_ids,
        member_ids: empty_ids,
        members: empty_members,
        ends: empty_ends
    }, {
        while: current => current.module < source.count,
        next: current => {
            const module = current.module
            const entry = memory.readColumnOptionalU32(source.defaults, module)

            if (entry != null) {
                current.roots = current.roots.push(entry)[0]
            }

            const count = memory.listLength(source.member_ids, module)
            const selected = loop({
                row: 0,
                roots: current.roots,
                member_ids: current.member_ids,
                members: current.members
            }, {
                while: member => member.row < count,
                next: member => {
                    const id = memory.readListOptionalU32(
                        source.member_ids,
                        module,
                        member.row
                    )

                    if (id != null) {
                        const name = memory.readListText(
                            source.member_names,
                            module,
                            member.row
                        )

                        member.roots = member.roots.push(id)[0]
                        member.member_ids = member.member_ids.push(id)[0]
                        member.members = member.members.push({
                            name,
                            function: id
                        })[0]
                    }

                    member.row += 1
                },
                return: member => member.pick([
                    "roots",
                    "member_ids",
                    "members"
                ])
            })

            current.roots = selected.roots
            current.member_ids = selected.member_ids
            current.members = selected.members
            current.ends = current.ends.push(current.members.length)[0]
            current.module += 1
        },
        return: current => current.pick([
            "roots",
            "member_ids",
            "members",
            "ends"
        ])
    })
}
