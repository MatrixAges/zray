import memory from "memory"

import type { Completed as Input } from "./model"

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    return loop({
        row: 0,
        flags: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const row = state.row
            const constant_only = match {
                !in.type_only => false,
                memory.readColumnOptionalU32(in.defaults, row) != null => false,
                memory.listLength(in.constants, row) == 0 => false,
                memory.listLength(in.types, row) != 0 => false,
                _ => memory.listLength(in.member_ids, row) == 0
            }

            state.flags = state.flags.push(constant_only)[0]
            state.row += 1
        },
        return: state => state.flags
    })
}
