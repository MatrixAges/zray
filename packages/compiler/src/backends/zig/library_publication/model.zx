import type { ListColumn, ReadColumn } from "memory"

export type Exports = {
    count: u64,
    defaults: ReadColumn,
    member_ids: ListColumn,
    member_names: ListColumn
}

export type Input = {
    source: Exports
}

export type Member = {
    name: string,
    function: u32
}

export type Output = {
    roots: u32[],
    member_ids: u32[],
    members: Member[],
    ends: u64[]
}

export type CapacityInput = Exports.Pick("count", "member_ids")

export type Capacity = {
    roots: u64,
    members: u64
}

export type Completed = CapacityInput & {
    defaults: ReadColumn,
    types: ListColumn,
    constants: ListColumn,
    type_only: bool
}
