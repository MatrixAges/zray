import type {
    ListColumn,
    NamedRowBuffer,
    ReadColumn,
    U32Buffer,
    U64Buffer,
    U8Buffer,
    WriteColumn
} from "memory"

export type Exports = {
    count: u64,
    defaults: ReadColumn,
    member_ids: ListColumn,
    member_names: ListColumn
}

export type Buffers = {
    roots: U32Buffer,
    member_ids: U32Buffer,
    members: NamedRowBuffer,
    ends: U64Buffer,
    regular: U8Buffer
}

export type Input = {
    source: Exports,
    target: Buffers
}

export type Output = {
    roots: u64,
    members: u64
}

export type CapacityInput = Exports.Pick("count", "member_ids")

export type Capacity = {
    roots: u64,
    members: u64
}

export type Completed = CapacityInput & {
    defaults: ReadColumn,
    types: ListColumn,
    constants: ListColumn,
    type_only: bool,
    sources: string[],
    source_files: WriteColumn,
    constants_only: WriteColumn
}
