import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"

export type Input = string?

export type Output = u8[]

export default function (in: Input): Output {
    if (in == null) {
        return [
            0
        ]
    }

    const present: u8[] = [
        1
    ]

    return bytes.join(
        bytes.fromText(""),
        [
            present,
            text(in)
        ]
    )
}
