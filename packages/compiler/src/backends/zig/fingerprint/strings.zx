import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"

import type { Writer } from "std:bytes"

export type Input = {
    out: Writer,
    values: string[]
}

export type Output = void

export default function (in: Input): Output {
    const { out, values } = in

    bytes.writeU64Le(out, values.length)

    const result = loop(0, {
        while: index => index < values.length,
        next: index => {
            text({
                out,
                text: values[index]
            })

            index += 1
        }
    })
}
