import bytes from "std:bytes"

import type { Plan as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            in.flags,
            bytes.encodeU64Le(in.transfers.length),
            in.transfers,
            bytes.encodeU64Le(in.slot_first.length),
            in.slot_first,
            bytes.encodeU64Le(in.keys.length)
        ]
    )
}
