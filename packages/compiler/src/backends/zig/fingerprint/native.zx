import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"

import optionalText from "./optional_text"
import strings from "./strings"

import type { Native as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            text(in.specifier),
            optionalText(in.identity),
            text(in.import_name),
            strings(in.namespace)
        ]
    )
}
