import text from "core/ir/fingerprint/text"

import optionalText from "./optional_text"
import strings from "./strings"

import type { Native as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out, identity } = in

    text({
        out,
        text: in.specifier
    })

    optionalText({
        out,
        value: identity
    })

    text({
        out,
        text: in.import_name
    })

    strings({
        out,
        values: in.namespace
    })
}
