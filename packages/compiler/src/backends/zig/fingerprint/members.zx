import bytes from "std:bytes"
import crypto from "std:crypto"
import integers from "std:integer"
import memory from "memory"

import length from "./member_length"

import type { PublicMembers as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { word_width, little_endian } = in

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                in.digest
            ]
        },
        {
            while: state => state.index < in.count,
            next: state => {
                const name = memory.readRowName(in.members, state.index)
                const id = memory.readRowId(in.members, state.index)
                const target = in.names[integers.widen(id)]

                state.parts = state.parts.push(
                    length({
                        size: name.length,
                        width: word_width,
                        little_endian
                    })
                )[0]
                state.parts = state.parts.push(bytes.fromText(name))[0]
                state.parts = state.parts.push(
                    length({
                        size: target.length,
                        width: word_width,
                        little_endian
                    })
                )[0]
                state.parts = state.parts.push(bytes.fromText(target))[0]
                state.index += 1
            }
        }
    )

    return crypto.sha256Parts(parts)
}
