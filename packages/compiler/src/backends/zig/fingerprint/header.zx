import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"

import { domain, entry, function_unit, types, regular } from "./const"
import { Unit } from "./model"

import type { Header as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out } = in

    const label = match in.unit {
        Unit.Entry => entry,
        Unit.Function => function_unit,
        Unit.Types => types,
        _ => regular
    }

    text({
        out,
        text: domain
    })

    text({
        out,
        text: label
    })

    bytes.writeU64Le(out, integers.widen(in.version))

    if (in.unit == Unit.Entry) {
        bytes.write(out, in.entry_flags)
    }
}
