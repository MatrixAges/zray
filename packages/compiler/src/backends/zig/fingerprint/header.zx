import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"

import { domain, entry, function_unit, types, regular } from "./const"
import { Unit } from "./model"

import type { Header as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { value_function } = in

    const label = match in.unit {
        Unit.Entry => entry,
        Unit.Function => function_unit,
        Unit.Types => types,
        _ => regular
    }

    const base = [
        text(domain),
        text(label),
        bytes.encodeU64Le(integers.widen(in.version))
    ]

    const with_entry = match in.unit == Unit.Entry {
        true => base.push(in.entry_flags)[0],
        _ => base
    }

    if (value_function == null) {
        return bytes.join(bytes.fromText(""), with_entry)
    }

    const flag_byte: u8 = value_function ? 1 : 0

    return bytes.join(
        bytes.fromText(""),
        with_entry.push([
            flag_byte
        ])[0]
    )
}
