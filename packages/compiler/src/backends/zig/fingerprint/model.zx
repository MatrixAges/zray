import type { NamedRows } from "memory"

export enum Unit {
    Entry,
    Function,
    Types,
    Regular
}

export type Header = {
    unit: Unit,
    version: u32,
    entry_flags: u8[],
    value_function?: bool
}

export type Plan = {
    flags: u8[],
    transfers: u8[],
    slot_first: u8[],
    keys: u64[],
    paths: u32[][]
}

export type TypePrefix = {
    key_count: u64,
    keys: u8[],
    names: string[]
}

export type Native = {
    specifier: string,
    identity?: string,
    import_name: string,
    namespace: string[]
}

export type PublicMembers = {
    digest: u8[],
    count: u64,
    members: NamedRows,
    names: string[],
    word_width: u64,
    little_endian: bool
}
