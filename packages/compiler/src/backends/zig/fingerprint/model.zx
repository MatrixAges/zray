import type { Writer } from "std:bytes"
import type { Stores } from "core/store_table/model"
import type { NamedRows } from "memory"

export enum Unit {
    Entry,
    Function,
    Types,
    Regular
}

export type Header = {
    out: Writer,
    unit: Unit,
    version: u32,
    entry_flags: u8[]
}

export type Plan = {
    out: Writer,
    flags: u8[],
    transfers: u8[],
    slot_first: u8[],
    keys: u64[],
    paths: u32[][]
}

export type TypePrefix = {
    out: Writer,
    key_count: u64,
    keys: u8[],
    names: string[]
}

export type TypeIdentity = {
    name: string,
    digest: u8[]
}

export type Reference = {
    out: Writer,
    earlier?: bool,
    name: string,
    stores: Stores,
    errors?: string[],
    input: TypeIdentity,
    output: TypeIdentity,
    value: bool,
    pure: bool,
    local: bool,
    io: bool,
    process: bool,
    tasks: bool,
    identity_free: bool,
    fresh: bool,
    constructed: bool
}

export type Native = {
    out: Writer,
    specifier: string,
    identity?: string,
    import_name: string,
    namespace: string[]
}

export type PublicMembers = {
    out: Writer,
    digest: u8[],
    count: u64,
    members: NamedRows,
    names: string[],
    word_width: u64,
    little_endian: bool
}
