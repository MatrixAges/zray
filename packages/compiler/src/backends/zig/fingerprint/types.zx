import bytes from "std:bytes"

import strings from "./strings"

import type { TypePrefix as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            bytes.encodeU64Le(in.key_count),
            in.keys,
            strings(in.names)
        ]
    )
}
