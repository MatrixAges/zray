import bytes from "std:bytes"
import integers from "std:integer"

import type { Writer } from "std:bytes"

export type Input = {
    out: Writer,
    values: u32[]
}

export type Output = void

export default function (in: Input): Output {
    const { out, values } = in

    bytes.writeU64Le(out, values.length)

    const result = loop(0, {
        while: index => index < values.length,
        next: index => {
            bytes.writeU64Le(out, integers.widen(values[index]))
            index += 1
        }
    })
}
