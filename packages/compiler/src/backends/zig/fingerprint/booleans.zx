import bytes from "std:bytes"

export type Input = bool[]

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0
    const empty_flags: u8[] = []

    const { flags } = loop(
        {
            index: start_index,
            flags: empty_flags
        },
        {
            while: state => state.index < in.length,
            next: state => {
                state.flags = state.flags.push(in[state.index] ? 1 : 0)[0]
                state.index += 1
            }
        }
    )

    return bytes.join(
        bytes.fromText(""),
        [
            bytes.encodeU64Le(in.length),
            flags
        ]
    )
}
