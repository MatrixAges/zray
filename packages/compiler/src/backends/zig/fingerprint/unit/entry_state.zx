import bytes from "std:bytes"

import state from "./state"

import type { State } from "./model"

export type Input = State & {
    type_only: bool
}

export type Output = u8[]

export default function (in: Input): Output {
    const flag: u8 = in.type_only ? 1 : 0

    return bytes.join(
        bytes.fromText(""),
        [
            state({
                stores: in.stores,
                mode: in.mode
            }),
            [
                flag
            ]
        ]
    )
}
