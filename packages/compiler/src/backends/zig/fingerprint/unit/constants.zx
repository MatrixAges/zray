import bytes from "std:bytes"
import floats from "std:float"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import text from "core/ir/fingerprint/text"

import {
    expression_integer,
    expression_negative_integer,
    expression_float,
    expression_string,
    expression_boolean
} from "../body/const"
import typeKey from "../types_bundle/type_key"
import { constant_enumeration } from "./const"

import type { Constants as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { prefix, values, total } = in
    const { out } = prefix

    if (total != null) {
        bytes.writeU64Le(out, total)
    }

    const result = loop(0, {
        while: index => index < values.names.length,
        next: index => {
            const value = values.values[index]

            text({
                out,
                text: values.names[index]
            })
            typeKey({
                prefix,
                id: value.type_id
            })

            switch (value.kind) {
                case ExpressionKind.Integer:
                    const tag = match value.negative {
                        true => expression_negative_integer,
                        _ => expression_integer
                    }

                    bytes.writeU64Le(out, tag)
                    bytes.writeU64Le(out, value.integer)
                case ExpressionKind.Float:
                    bytes.writeU64Le(out, expression_float)
                    bytes.writeU64Le(out, floats.bits(value.floating))
                case ExpressionKind.String:
                    bytes.writeU64Le(out, expression_string)
                    text({
                        out,
                        text: value.text
                    })
                case ExpressionKind.Boolean:
                    bytes.writeU64Le(out, expression_boolean)
                    bytes.writeByte(out, value.boolean ? 1 : 0)
                default:
                    bytes.writeU64Le(out, constant_enumeration)
                    bytes.writeU64Le(out, integers.widen(value.enumeration))
            }

            index += 1
        }
    })
}
