import bytes from "std:bytes"
import floats from "std:float"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import text from "core/ir/fingerprint/text"

import {
    expression_integer,
    expression_negative_integer,
    expression_float,
    expression_string,
    expression_boolean
} from "../body/const"
import typeKey from "../types_bundle/type_key"
import { constant_enumeration } from "./const"

import type { Constants as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { prefix, values, total } = in

    const start_index: u64 = 0
    const empty_parts: u8[][] = []

    const { parts } = loop(
        {
            index: start_index,
            parts: empty_parts
        },
        {
            while: state => state.index < values.names.length,
            next: state => {
                const value = values.values[state.index]

                const with_head = state.parts
                    .push(text(values.names[state.index]))[0]
                    .push(
                        typeKey({
                            prefix,
                            id: value.type_id
                        })
                    )[0]

                switch (value.kind) {
                    case ExpressionKind.Integer:
                        const tag = match value.negative {
                            true => expression_negative_integer,
                            _ => expression_integer
                        }

                        state.parts = with_head.push(
                            bytes.encodeU64sLe([
                                tag,
                                value.integer
                            ])
                        )[0]
                    case ExpressionKind.Float:
                        state.parts = with_head.push(
                            bytes.encodeU64sLe([
                                expression_float,
                                floats.bits(value.floating)
                            ])
                        )[0]
                    case ExpressionKind.String:
                        state.parts = with_head
                            .push(bytes.encodeU64Le(expression_string))[0]
                            .push(
                                text(
                                    value.text
                                )
                            )[0]
                    case ExpressionKind.Boolean:
                        const flag_byte: u8 = value.boolean ? 1 : 0

                        state.parts = with_head
                            .push(bytes.encodeU64Le(expression_boolean))[0]
                            .push(
                                [
                                    flag_byte
                                ]
                            )[0]
                    default:
                        state.parts = with_head.push(
                            bytes.encodeU64sLe([
                                constant_enumeration,
                                integers.widen(value.enumeration)
                            ])
                        )[0]
                }

                state.index += 1
            }
        }
    )

    const body = bytes.join(bytes.fromText(""), parts)

    if (total != null) {
        return bytes.join(
            bytes.fromText(""),
            [
                bytes.encodeU64Le(total),
                body
            ]
        )
    }

    return body
}
