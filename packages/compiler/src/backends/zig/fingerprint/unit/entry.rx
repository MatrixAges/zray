<Module>
    <Type from="model" as="Unit" />

    <Args in={Unit.Entry} out={u8[]} />

    <Call fn="ports" in={$in.ports} />

    <Call
        module="../body/build"
        in={$in.pick([
            "context",
            "symbols",
            "expressions",
            "control",
            "root"
        ])}
    />

    <Call fn="exports" in={$in.exported} />

    <Call
        fn="../body/contracts"
        in={$in.pick([
            "context",
            "contracts"
        ])}
    />

    <Call
        fn="entry_state"
        in={{
            stores: $in.stores,
            mode: $in.mode,
            type_only: $in.type_only
        }}
    />

    <Call
        fn="../join"
        in={[
            $ctx.ports,
            $ctx.build,
            $ctx.exports,
            $ctx.contracts,
            $ctx.entry_state
        ]}
    />

    <Return value={$ctx.join} />
</Module>
