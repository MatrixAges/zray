import bytes from "std:bytes"
import { StoreMode } from "core/function_table/complete"

import stores from "../stores"

import type { State as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            stores(in.stores),
            bytes.encodeU64Le(in.mode == StoreMode.transaction ? 0 : 1)
        ]
    )
}
