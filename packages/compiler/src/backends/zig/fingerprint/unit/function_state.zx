import bytes from "std:bytes"
import { Ownership } from "core/symbol_table/model"

import { ownership_copy, ownership_borrowed, ownership_owned } from "../body/const"
import state from "./state"

import type { FunctionState as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const ownership = match in.ownership {
        Ownership.Copy => ownership_copy,
        Ownership.Borrowed => ownership_borrowed,
        _ => ownership_owned
    }

    return bytes.join(
        bytes.fromText(""),
        [
            state({
                stores: in.stores,
                mode: in.mode
            }),
            bytes.encodeU64Le(ownership)
        ]
    )
}
