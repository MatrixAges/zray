import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"
import memory from "memory"

import typeKey from "../types_bundle/type_key"

import type { Exported as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { prefix, rows, count } = in

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(count)
            ]
        },
        {
            while: state => state.index < count,
            next: state => {
                state.parts = state.parts
                    .push(text(memory.readRowName(
                        rows,
                        state.index
                    )))[0]
                    .push(
                        typeKey({
                            prefix,
                            id: memory.readRowId(rows, state.index)
                        })
                    )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
