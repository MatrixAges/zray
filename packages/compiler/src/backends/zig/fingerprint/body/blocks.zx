import bytes from "std:bytes"
import integers from "std:integer"
import block from "core/ir/fingerprint/block"

import type { Block as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { control, root } = in

    if (root == null) {
        return bytes.encodeU64Le(0)
    }

    const row = integers.widen(root)

    return block({
        control,
        symbolic: false,
        first: integers.widen(control.block_first[row]),
        count: integers.widen(control.block_count[row])
    })
}
