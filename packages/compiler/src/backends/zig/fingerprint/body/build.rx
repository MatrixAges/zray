<Module>
    <Type from="model" as="Body" />

    <Args in={Body.Body} out={u8[]} />

    <Call
        fn="symbols"
        in={{
            prefix: $in.context.prefix,
            symbols: $in.symbols
        }}
    />

    <Call
        fn="expressions/rows"
        in={$in.pick([
            "context",
            "expressions"
        ])}
    />

    <Call
        fn="blocks"
        in={{
            control: $in.control,
            root: $in.root
        }}
    />

    <Call
        fn="../join"
        in={[
            $ctx.symbols,
            $ctx.rows,
            $ctx.blocks
        ]}
    />

    <Return value={$ctx.join} />
</Module>
