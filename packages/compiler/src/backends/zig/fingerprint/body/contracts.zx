import bytes from "std:bytes"
import integers from "std:integer"
import { ContractKind } from "core/contract_table/model"

import { contract_requires, contract_ensures } from "./const"
import rows from "./expressions/rows"
import symbols from "./symbols"

import type { Predicates as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { context, contracts } = in
    const { prefix } = context

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(contracts.kinds.length)
            ]
        },
        {
            while: state => state.index < contracts.kinds.length,
            next: state => {
                const kind = match contracts.kinds[state.index] {
                    ContractKind.Requires => contract_requires,
                    _ => contract_ensures
                }

                state.parts = state.parts
                    .push(bytes.encodeU64Le(kind))[0]
                    .push(
                        symbols({
                            prefix,
                            symbols: contracts.symbols[state.index]
                        })
                    )[0]
                    .push(
                        rows({
                            context,
                            expressions: contracts.expressions[state.index]
                        })
                    )[0]
                    .push(
                        bytes.encodeU64Le(
                            integers.widen(
                                contracts.predicates[state.index]
                            )
                        )
                    )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
