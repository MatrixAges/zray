import bytes from "std:bytes"
import integers from "std:integer"
import { ContractKind } from "core/contract_table/model"

import { contract_requires, contract_ensures } from "./const"
import rows from "./expressions/rows"
import symbols from "./symbols"

import type { Predicates as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { context, contracts } = in
    const { prefix } = context
    const { out } = prefix

    bytes.writeU64Le(out, contracts.kinds.length)

    const result = loop(0, {
        while: index => index < contracts.kinds.length,
        next: index => {
            const kind = match contracts.kinds[index] {
                ContractKind.Requires => contract_requires,
                _ => contract_ensures
            }

            bytes.writeU64Le(out, kind)
            symbols({
                prefix,
                symbols: contracts.symbols[index]
            })
            rows({
                context,
                expressions: contracts.expressions[index]
            })
            bytes.writeU64Le(out, integers.widen(contracts.predicates[index]))
            index += 1
        }
    })
}
