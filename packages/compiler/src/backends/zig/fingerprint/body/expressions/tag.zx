import { ExpressionKind } from "core/expression_table/kinds"

import {
    expression_integer,
    expression_negative_integer,
    expression_float,
    expression_string,
    expression_boolean,
    expression_none,
    expression_unit,
    expression_some,
    expression_capture,
    expression_task,
    expression_await_task,
    expression_cancel_task,
    expression_parallel,
    expression_optional_value,
    expression_enum_value,
    expression_error_value,
    expression_reference,
    expression_store_get,
    expression_field,
    expression_index,
    expression_length,
    expression_list,
    expression_tuple,
    expression_tuple_field,
    expression_template,
    expression_list_operation,
    expression_transform,
    expression_scope,
    expression_iteration,
    expression_list_update,
    expression_call,
    expression_unary,
    expression_binary,
    expression_conditional,
    expression_match,
    expression_object
} from "../const"

export type Input = ExpressionKind

export type Output = u64

export default function (in: Input): Output {
    return match in {
        ExpressionKind.Integer => expression_integer,
        ExpressionKind.NegativeInteger => expression_negative_integer,
        ExpressionKind.Float => expression_float,
        ExpressionKind.String => expression_string,
        ExpressionKind.Boolean => expression_boolean,
        ExpressionKind.None => expression_none,
        ExpressionKind.Unit => expression_unit,
        ExpressionKind.Some => expression_some,
        ExpressionKind.Capture => expression_capture,
        ExpressionKind.Task => expression_task,
        ExpressionKind.AwaitTask => expression_await_task,
        ExpressionKind.CancelTask => expression_cancel_task,
        ExpressionKind.Parallel => expression_parallel,
        ExpressionKind.OptionalValue => expression_optional_value,
        ExpressionKind.EnumValue => expression_enum_value,
        ExpressionKind.ErrorValue => expression_error_value,
        ExpressionKind.Reference => expression_reference,
        ExpressionKind.StoreGet => expression_store_get,
        ExpressionKind.Field => expression_field,
        ExpressionKind.Index => expression_index,
        ExpressionKind.Length => expression_length,
        ExpressionKind.List => expression_list,
        ExpressionKind.Tuple => expression_tuple,
        ExpressionKind.TupleField => expression_tuple_field,
        ExpressionKind.Template => expression_template,
        ExpressionKind.ListOperation => expression_list_operation,
        ExpressionKind.Transform => expression_transform,
        ExpressionKind.Scope => expression_scope,
        ExpressionKind.Iteration => expression_iteration,
        ExpressionKind.ListUpdate => expression_list_update,
        ExpressionKind.Call => expression_call,
        ExpressionKind.Unary => expression_unary,
        ExpressionKind.Binary => expression_binary,
        ExpressionKind.Conditional => expression_conditional,
        ExpressionKind.Match => expression_match,
        _ => expression_object
    }
}
