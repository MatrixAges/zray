import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import payloadBytes from "core/ir/fingerprint/payload"

import typeKey from "../../types_bundle/type_key"
import call from "./call"
import tag from "./tag"

import type { ExpressionRows as Input } from "../model"

export type Output = u8[]

export default function (in: Input): Output {
    const { context, expressions } = in

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(expressions.kinds.length)
            ]
        },
        {
            while: state => state.index < expressions.kinds.length,
            next: state => {
                const kind = expressions.kinds[state.index]
                const payload = integers.widen(expressions.payloads[state.index])

                const tail = match kind == ExpressionKind.Call {
                    true => call({
                        context,
                        expressions,
                        payload
                    }),
                    _ => payloadBytes({
                        expressions,
                        kind,
                        payload
                    })
                }

                state.parts = state.parts
                    .push(
                        typeKey({
                            prefix: context.prefix,
                            id: expressions.types[state.index]
                        })
                    )[0]
                    .push(
                        bytes.encodeU64Le(
                            tag(
                                kind
                            )
                        )
                    )[0]
                    .push(
                        tail
                    )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
