import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import payloadBytes from "core/ir/fingerprint/payload"

import typeKey from "../../types_bundle/type_key"
import call from "./call"
import tag from "./tag"

import type { ExpressionRows as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { context, expressions } = in
    const { out } = context.prefix

    bytes.writeU64Le(out, expressions.kinds.length)

    const result = loop(0, {
        while: index => index < expressions.kinds.length,
        next: index => {
            const kind = expressions.kinds[index]
            const payload = integers.widen(expressions.payloads[index])
            typeKey({
                prefix: context.prefix,
                id: expressions.types[index]
            })
            bytes.writeU64Le(out, tag(kind))

            if (kind == ExpressionKind.Call) {
                call({
                    context,
                    expressions,
                    payload
                })
            } else {
                payloadBytes({
                    out,
                    expressions,
                    kind,
                    payload
                })
            }

            index += 1
        }
    })
}
