import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"
import { Ownership } from "core/symbol_table/model"

import typeKey from "../types_bundle/type_key"
import { ownership_copy, ownership_borrowed, ownership_owned } from "./const"

import type { Symbols } from "core/symbol_table/model"
import type { TypePrefix } from "../model"

export type Input = {
    prefix: TypePrefix,
    symbols: Symbols
}

export type Output = u8[]

export default function (in: Input): Output {
    const { prefix, symbols } = in

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(symbols.names.length)
            ]
        },
        {
            while: state => state.index < symbols.names.length,
            next: state => {
                const ownership = match symbols.ownership[state.index] {
                    Ownership.Copy => ownership_copy,
                    Ownership.Borrowed => ownership_borrowed,
                    _ => ownership_owned
                }

                state.parts = state.parts
                    .push(text(symbols.names[state.index]))[0]
                    .push(
                        typeKey({
                            prefix,
                            id: symbols.types[state.index]
                        })
                    )[0]
                    .push(
                        bytes.encodeU64Le(
                            ownership
                        )
                    )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
