import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"
import { Ownership } from "core/symbol_table/model"

import typeKey from "../types_bundle/type_key"
import { ownership_copy, ownership_borrowed, ownership_owned } from "./const"

import type { Symbols } from "core/symbol_table/model"
import type { TypePrefix } from "../model"

export type Input = {
    prefix: TypePrefix,
    symbols: Symbols
}

export type Output = void

export default function (in: Input): Output {
    const { prefix, symbols } = in
    const { out } = prefix

    bytes.writeU64Le(out, symbols.names.length)

    const result = loop(0, {
        while: index => index < symbols.names.length,
        next: index => {
            text({
                out,
                text: symbols.names[index]
            })
            typeKey({
                prefix,
                id: symbols.types[index]
            })

            const ownership = match symbols.ownership[index] {
                Ownership.Copy => ownership_copy,
                Ownership.Borrowed => ownership_borrowed,
                _ => ownership_owned
            }

            bytes.writeU64Le(out, ownership)
            index += 1
        }
    })
}
