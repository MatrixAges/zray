import bytes from "std:bytes"
import integers from "std:integer"

import booleans from "./booleans"
import strings from "./strings"

import type { Writer } from "std:bytes"
import type { Stores } from "core/store_table/model"

export type Input = {
    out: Writer,
    value: Stores
}

export type Output = void

export default function (in: Input): Output {
    const { out, value } = in

    strings({
        out,
        values: value.handles
    })

    strings({
        out,
        values: value.paths
    })

    booleans({
        out,
        values: value.readable
    })

    bytes.writeU64Le(out, value.types.length)

    const result = loop(0, {
        while: index => index < value.types.length,
        next: index => {
            bytes.writeU64Le(out, integers.widen(value.types[index]))
            index += 1
        }
    })

    booleans({
        out,
        values: value.writable
    })
}
