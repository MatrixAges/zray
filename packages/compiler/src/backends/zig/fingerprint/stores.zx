import bytes from "std:bytes"
import words from "core/ir/fingerprint/words"

import booleans from "./booleans"
import strings from "./strings"

import type { Stores } from "core/store_table/model"

export type Input = Stores

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            strings(in.handles),
            strings(in.paths),
            booleans(in.readable),
            words(in.types),
            booleans(in.writable)
        ]
    )
}
