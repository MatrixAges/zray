import booleans from "./booleans"
import strings from "./strings"
import words from "./words"

import type { Writer } from "std:bytes"
import type { Stores } from "core/store_table/model"

export type Input = {
    out: Writer,
    value: Stores
}

export type Output = void

export default function (in: Input): Output {
    const { out, value } = in

    strings({
        out,
        values: value.handles
    })

    strings({
        out,
        values: value.paths
    })

    booleans({
        out,
        values: value.readable
    })

    words({
        out,
        values: value.types
    })

    booleans({
        out,
        values: value.writable
    })
}
