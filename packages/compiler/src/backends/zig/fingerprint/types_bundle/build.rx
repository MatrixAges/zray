<Module>
    <Type from="model" as="Bundle" />

    <Args in={Bundle.Input} out={u8[]} />

    <Call fn="../types" in={$in.prefix} />
    <Call fn="columns" in={$in.table} />

    <Call
        fn="modules"
        in={$in.pick([
            "prefix",
            "modules"
        ])}
    />

    <Call
        fn="signatures"
        in={$in.pick([
            "prefix",
            "modules",
            "functions"
        ])}
    />

    <Call
        fn="../join"
        in={[
            $ctx.types,
            $ctx.columns,
            $ctx.modules,
            $ctx.signatures
        ]}
    />

    <Return value={$ctx.join} />
</Module>
