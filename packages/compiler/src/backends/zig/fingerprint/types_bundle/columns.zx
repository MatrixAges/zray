import bytes from "std:bytes"

import strings from "../strings"
import words from "../words"

import type { Writer } from "std:bytes"
import type { Table } from "core/type_table/model"

export type Input = {
    out: Writer,
    table: Table
}

export type Output = void

export default function (in: Input): Output {
    const { out, table } = in

    bytes.writeU64Le(out, table.kinds.length)
    bytes.write(out, table.kinds)

    words({
        out,
        values: table.first
    })

    words({
        out,
        values: table.second
    })

    strings({
        out,
        values: table.labels
    })

    words({
        out,
        values: table.children
    })

    words({
        out,
        values: table.field_types
    })

    strings({
        out,
        values: table.field_names
    })

    strings({
        out,
        values: table.names
    })
}
