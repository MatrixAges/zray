import bytes from "std:bytes"
import words from "core/ir/fingerprint/words"

import strings from "../strings"

import type { Table } from "core/type_table/model"

export type Input = Table

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            bytes.encodeU64Le(in.kinds.length),
            in.kinds,
            words(in.first),
            words(in.second),
            strings(in.labels),
            words(in.children),
            words(in.field_types),
            strings(in.field_names),
            strings(in.names)
        ]
    )
}
