import bytes from "std:bytes"
import integers from "std:integer"

import native from "../native"
import optionalText from "../optional_text"
import strings from "../strings"

import type { External as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out, functions, modules, index } = in

    const id = functions.native_modules[index]

    if (in.optional) {
        bytes.writeByte(out, id == null ? 0 : 1)
    }

    if (id == null) {
        return
    }

    const module = integers.widen(id)
    const input = functions.native_inputs[index]
    const errors = functions.native_errors[index]

    bytes.writeByte(out, input == null ? 0 : 1)

    if (input != null) {
        bytes.writeU64Le(out, input.length)

        const names = loop(0, {
            while: index => index < input.length,
            next: index => {
                optionalText({
                    out,
                    value: input[index]
                })
                index += 1
            }
        })
    }

    native({
        out,
        specifier: modules.specifiers[module],
        identity: modules.identities[module],
        import_name: modules.import_names[module],
        namespace: modules.type_namespaces[module]
    })

    strings({
        out,
        values: functions.native_members[index]
    })

    optionalText({
        out,
        value: functions.native_exports[index]
    })

    bytes.writeByte(out, functions.native_allocators[index] ? 1 : 0)
    bytes.writeByte(out, functions.native_io[index] ? 1 : 0)
    bytes.writeByte(out, functions.native_process[index] ? 1 : 0)
    bytes.writeByte(out, functions.native_tuples[index] ? 1 : 0)
    bytes.writeByte(out, functions.native_fallible[index] ? 1 : 0)
    bytes.writeByte(out, errors == null ? 0 : 1)

    if (errors != null) {
        strings({
            out,
            values: errors
        })
    }

    bytes.writeByte(out, functions.native_concurrent[index] ? 1 : 0)
}
