import bytes from "std:bytes"
import integers from "std:integer"

import native from "../native"
import optionalStrings from "../optional_strings"
import optionalText from "../optional_text"
import strings from "../strings"
import optionalTexts from "./optional_texts"

import type { External as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { functions, modules, index } = in

    const id = functions.native_modules[index]

    if (id == null) {
        if (in.optional) {
            return [
                0
            ]
        }

        return []
    }

    const module = integers.widen(id)
    const empty_parts: u8[][] = []

    const head = match in.optional {
        true => empty_parts.push([
            1
        ])[0],
        _ => empty_parts
    }

    const flags: u8[] = [
        functions.native_allocators[index] ? 1 : 0,
        functions.native_io[index] ? 1 : 0,
        functions.native_process[index] ? 1 : 0,
        functions.native_tuples[index] ? 1 : 0,
        functions.native_fallible[index] ? 1 : 0
    ]

    const concurrent: u8[] = [
        functions.native_concurrent[index] ? 1 : 0
    ]

    const parts = head
        .push(optionalTexts(functions.native_inputs[index]))[0]
        .push(
            native({
                specifier: modules.specifiers[module],
                identity: modules.identities[module],
                import_name: modules.import_names[module],
                namespace: modules.type_namespaces[module]
            })
        )[0]
        .push(
            strings(
                functions.native_members[index]
            )
        )[0]
        .push(
            optionalText(
                functions.native_exports[index]
            )
        )[0]
        .push(
            flags
        )[0]
        .push(
            optionalStrings(
                functions.native_errors[index]
            )
        )[0]
        .push(
            concurrent
        )[0]

    return bytes.join(bytes.fromText(""), parts)
}
