import type { Complete } from "core/function_table/complete"
import type { Modules } from "core/native_module_table/model"
import type { Table } from "core/type_table/model"
import type { TypePrefix } from "../model"

export type Input = {
    prefix: TypePrefix,
    table: Table,
    modules: Modules,
    functions: Complete
}

export type TypeKey = {
    prefix: TypePrefix,
    id: u32
}

export type NativeModules = {
    prefix: TypePrefix,
    modules: Modules
}

export type NativeFunctions = {
    prefix: TypePrefix,
    modules: Modules,
    functions: Complete
}

export type External = {
    modules: Modules,
    functions: Complete,
    index: u64,
    optional: bool
}
