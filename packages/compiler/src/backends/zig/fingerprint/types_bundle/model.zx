import type { Writer } from "std:bytes"
import type { Modules } from "core/native_module_table/model"
import type { Names, Table as Signatures } from "core/signature_table/model"
import type { Table } from "core/type_table/model"
import type { TypePrefix } from "../model"

export type NativeSignatures = Signatures.Omit("files", "ownership")

export type Input = {
    prefix: TypePrefix,
    table: Table,
    modules: Modules,
    signatures: NativeSignatures
}

export type TypeKey = {
    prefix: TypePrefix,
    id: u32
}

export type NativeModules = {
    prefix: TypePrefix,
    modules: Modules
}

export type NativeFunctions = {
    prefix: TypePrefix,
    modules: Modules,
    signatures: NativeSignatures
}

export type Declaration = {
    input?: Names,
    module: u32,
    member: string[],
    export_name?: string,
    allocator_argument: bool,
    io_argument: bool,
    process_argument: bool,
    expand_tuple: bool,
    fallible: bool,
    errors?: string[],
    concurrent: bool
}

export type External = {
    out: Writer,
    modules: Modules,
    declaration: Declaration
}
