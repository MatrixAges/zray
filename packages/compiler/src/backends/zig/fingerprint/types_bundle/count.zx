export type Input = u32?[]

export type Output = u64

export default function (in: Input): Output {
    return loop({
        index: 0,
        count: 0
    }, {
        while: current => current.index < in.length,
        next: current => {
            if (in[current.index] != null) {
                current.count += 1
            }

            current.index += 1
        },
        return: current => current.count
    })
}
