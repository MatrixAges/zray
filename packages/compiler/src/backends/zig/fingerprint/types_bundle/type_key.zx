import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { digest_width } from "../../../../inputs/fingerprint/const"
import text from "../../../../inputs/fingerprint/field"

import type { TypeKey as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out, keys, names } = in.prefix

    const index = integers.widen(in.id)
    const digest = memory.borrowU8Range(keys, index * digest_width, digest_width)

    text({
        out,
        text: names[index]
    })

    bytes.write(out, digest)
}
