import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"
import memory from "memory"

import { digest_width } from "../../../../inputs/fingerprint/const"

import type { TypeKey as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { keys, names } = in.prefix

    const index = integers.widen(in.id)
    const digest = memory.borrowU8Range(keys, index * digest_width, digest_width)

    return bytes.join(
        bytes.fromText(""),
        [
            text(names[index]),
            digest
        ]
    )
}
