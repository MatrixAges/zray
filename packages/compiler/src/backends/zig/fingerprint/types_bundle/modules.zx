import bytes from "std:bytes"
import text from "core/ir/fingerprint/text"

import optionalText from "../optional_text"
import strings from "../strings"
import typeKey from "./type_key"

import type { NativeModules as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { modules, prefix } = in
    const { out } = prefix

    bytes.writeU64Le(out, modules.specifiers.length)

    const result = loop(0, {
        while: index => index < modules.specifiers.length,
        next: index => {
            text({
                out,
                text: modules.specifiers[index]
            })
            text({
                out,
                text: modules.import_names[index]
            })
            optionalText({
                out,
                value: modules.identities[index]
            })
            strings({
                out,
                values: modules.type_namespaces[index]
            })

            const names = modules.type_names[index]
            const ids = modules.type_ids[index]

            bytes.writeU64Le(out, names.length)

            const bindings = loop(0, {
                while: slot => slot < names.length,
                next: slot => {
                    text({
                        out,
                        text: names[slot]
                    })
                    typeKey({
                        prefix,
                        id: ids[slot]
                    })

                    slot += 1
                }
            })

            index += 1
        }
    })
}
