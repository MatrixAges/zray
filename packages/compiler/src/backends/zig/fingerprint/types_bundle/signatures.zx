import bytes from "std:bytes"

import count from "./count"
import external from "./external"
import typeKey from "./type_key"

import type { NativeFunctions as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { functions, modules, prefix } = in
    const { out } = prefix

    bytes.writeU64Le(out, count(functions.native_modules))

    const result = loop(0, {
        while: index => index < functions.native_modules.length,
        next: index => {
            const module = functions.native_modules[index]

            if (module != null) {
                typeKey({
                    prefix,
                    id: functions.input_types[index]
                })
                typeKey({
                    prefix,
                    id: functions.output_types[index]
                })
                external({
                    out,
                    modules,
                    functions,
                    index,
                    optional: false
                })
            }

            index += 1
        }
    })
}
