import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"

import stores from "./stores"
import strings from "./strings"
import typeKey from "./types_bundle/type_key"

import type { Context } from "./body/model"

export type Input = {
    context: Context,
    id: u32
}

export type Output = void

export default function (in: Input): Output {
    const { calls, prefix } = in.context
    const { owner } = calls
    const { out } = prefix

    const index = integers.widen(in.id)
    const errors = calls.errors[index]

    if (owner != null) {
        bytes.writeByte(out, in.id < owner ? 1 : 0)
    }

    text({
        out,
        text: calls.names[index]
    })

    stores({
        out,
        value: calls.stores[index]
    })

    bytes.writeByte(out, calls.value[index] ? 1 : 0)
    bytes.writeByte(out, calls.pure[index] ? 1 : 0)
    bytes.writeByte(out, calls.local[index] ? 1 : 0)
    bytes.writeByte(out, calls.io[index] ? 1 : 0)
    bytes.writeByte(out, calls.process[index] ? 1 : 0)
    bytes.writeByte(out, calls.tasks[index] ? 1 : 0)
    bytes.writeByte(out, errors == null ? 0 : 1)

    if (errors != null) {
        strings({
            out,
            values: errors
        })
    }

    bytes.writeByte(out, calls.identity_free[index] ? 1 : 0)

    typeKey({
        prefix,
        id: calls.input_types[index]
    })

    typeKey({
        prefix,
        id: calls.output_types[index]
    })

    bytes.writeByte(out, calls.fresh[index] ? 1 : 0)
    bytes.writeByte(out, calls.constructed[index] ? 1 : 0)
}
