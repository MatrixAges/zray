import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"

import optionalStrings from "./optional_strings"
import stores from "./stores"
import typeKey from "./types_bundle/type_key"

import type { Context } from "./body/model"

export type Input = {
    context: Context,
    id: u32
}

export type Output = u8[]

export default function (in: Input): Output {
    const { calls, prefix } = in.context
    const { owner } = calls

    const index = integers.widen(in.id)

    const head_flags: u8[] = [
        calls.value[index] ? 1 : 0,
        calls.pure[index] ? 1 : 0,
        calls.local[index] ? 1 : 0,
        calls.io[index] ? 1 : 0,
        calls.process[index] ? 1 : 0,
        calls.tasks[index] ? 1 : 0
    ]

    const tail_flags: u8[] = [
        calls.fresh[index] ? 1 : 0,
        calls.constructed[index] ? 1 : 0
    ]

    const id_free: u8[] = [
        calls.identity_free[index] ? 1 : 0
    ]

    const body = bytes.join(
        bytes.fromText(""),
        [
            text(calls.names[index]),
            stores(calls.stores[index]),
            head_flags,
            optionalStrings(calls.errors[index]),
            id_free,
            typeKey({
                prefix,
                id: calls.input_types[index]
            }),
            typeKey({
                prefix,
                id: calls.output_types[index]
            }),
            tail_flags
        ]
    )

    if (owner == null) {
        return body
    }

    const owner_flag: u8 = in.id < owner ? 1 : 0

    const prefix_bytes: u8[] = [
        owner_flag
    ]

    return bytes.join(
        bytes.fromText(""),
        [
            prefix_bytes,
            body
        ]
    )
}
