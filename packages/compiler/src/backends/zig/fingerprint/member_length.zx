import bytes from "std:bytes"
import integers from "std:integer"

import { byte_bits, byte_radix, narrow_word } from "./const"

export type Input = {
    size: u64,
    width: u64,
    little_endian: bool
}

export type Output = u8[]

export default function (in: Input): Output {
    const { size, width } = in

    if (in.little_endian) {
        if (width == narrow_word) {
            return bytes.encodeU32Le(integers.narrow(size))
        }

        return bytes.encodeU64Le(size)
    }

    const empty_out: u8[] = []

    const { out } = loop(
        {
            remaining: width,
            out: empty_out
        },
        {
            while: state => state.remaining > 0,
            next: state => {
                state.remaining -= 1

                const divisor = integers.bitMask(state.remaining * byte_bits)
                const byte = integers.narrowByte(size / divisor % byte_radix)

                state.out = state.out.push(byte)[0]
            }
        }
    )

    return out
}
