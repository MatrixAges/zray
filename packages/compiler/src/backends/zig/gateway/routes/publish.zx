import integers from "std:integer"
import memory from "memory"

import type { ReadColumn, TextColumn } from "memory"

export type Input = {
    count: u64,
    paths: TextColumn,
    methods: ReadColumn,
    services: ReadColumn,
    method_names: string[]
}

export type Route = {
    path: string,
    method?: string,
    service: u64
}

export type Output = Route[]

export default function (in: Input): Output {
    const empty: Route[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const { row } = state
            const method = memory.readColumnOptionalU8(in.methods, row)
            const name: string? = match {
                method == null => null,
                _ => in.method_names[integers.widenByte(method)]
            }

            state.items = state.items.push({
                path: memory.readTextColumn(in.paths, row),
                method: name,
                service: integers.widen(memory.readColumnU32(
                    in.services,
                    row
                ))
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
