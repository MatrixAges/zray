import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { TextColumn } from "zig:compiler_memory"

export type Input = {
    routes: TextColumn,
    first_routes: u32[],
    exports: TextColumn,
    export_count: u64
}

export type Output = bool

export default function (in: Input): Output {
    if (in.first_routes.length != in.export_count) {
        return false
    }

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < in.export_count,
        next: state => {
            const route = integers.widen(in.first_routes[state.row])
            const name = memory.readTextColumn(in.routes, route)

            state.valid = name == memory.readTextColumn(in.exports, state.row)
            state.row += 1
        },
        return: state => state.valid
    })
}
