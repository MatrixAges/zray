import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { WriteColumn } from "zig:compiler_memory"

export type Input = {
    indices: u64[],
    writable: bool[],
    wide: bool,
    slot: WriteColumn,
    access: WriteColumn
}

export type Output = void

export default function (in: Input): Output {
    const count = loop(0, {
        while: row => row < in.indices.length,
        next: row => {
            const index = in.indices[row]

            if (in.wide) {
                memory.writeColumnU64(in.slot, row, index)
            } else {
                memory.writeColumnU32(in.slot, row, integers.narrow(index))
            }

            memory.writeColumnU8(in.access, row, in.writable[row] ? 1 : 0)
            row += 1
        }
    })
}
