import memory from "zig:compiler_memory"

import type { Descriptors } from "./model"

export type Input = {
    target: Descriptors,
    position: u64,
    output_type: u32,
    requires_io?: bool,
    requires_process: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { target, position, requires_io } = in

    if (requires_io == null) {
        return false
    }

    memory.writeU32(target.output_types, position, in.output_type)
    memory.writeU8(target.requires_io, position, requires_io ? 1 : 0)
    memory.writeU8(target.requires_process, position, in.requires_process ? 1 : 0)

    return true
}
