import { Status } from "./model"

import type { State } from "./model"

export type Input = {
    state: State,
    input_type: u32,
    output_type: u32,
    requires_io?: bool,
    requires_process: bool
}

export type Output = State

export default function (in: Input): Output {
    const { state, requires_io } = in

    if (requires_io == null) {
        return {
            ...state,
            status: Status.InvalidModule
        }
    }

    return {
        ...state,
        input_types: state.input_types.push(in.input_type)[0],
        output_types: state.output_types.push(in.output_type)[0],
        requires_io: state.requires_io.push(requires_io)[0],
        requires_process: state.requires_process.push(in.requires_process)[0]
    }
}
