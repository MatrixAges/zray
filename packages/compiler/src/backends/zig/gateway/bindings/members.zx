import service from "compiler/gateway_state_service"
import memory from "memory"

import { Status } from "./model"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const members = in.source.members

    return loop({
        state: in,
        position: 0
    }, {
        while: current => current.state.status == Status.Valid &&
            current.position < members.count,
        next: current => {
            const position = current.position

            current.state = service({
                state: current.state,
                member: {
                    export_name: memory.readTextColumn(members.export_names, position),
                    name: memory.readTextColumn(members.names, position),
                    function_id:
                        memory.readColumnOptionalU32(members.functions, position),
                    requires_io:
                        memory.readColumnOptionalBool(
                            members.requires_io,
                            position
                        ),
                    requires_process:
                        memory.readColumnBool(
                            members.requires_process,
                            position
                        )
                },
                position
            })
            current.position += 1
        },
        return: current => current.state
    })
}
