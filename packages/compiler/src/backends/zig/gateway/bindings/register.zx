import bytes from "std:bytes"
import integers from "std:integer"
import insert from "core/bytes/index/insert"

import find from "../../store_initializers/find"
import { Status as Initializer } from "../../store_initializers/model"
import { Status } from "./model"

import type { Binding as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const path = in.stores.paths[in.position]
    const type_id = in.stores.types[in.position]

    const initial = find({
        initializers: in.state.source.initializers,
        path,
        type_id,
        type_names: in.state.source.type_names
    })

    const module_name = initial.module_name

    if (module_name == null) {
        return {
            ...in.state,
            status: match initial.status {
                Initializer.Missing => Status.MissingInitializer,
                _ => Status.InvalidInitializer
            }
        }
    }

    return {
        ...in.state,
        index: insert({
            index: in.state.index,
            key: bytes.fromText(path),
            value: integers.narrow(in.state.modules.length)
        }),
        types: in.state.types.push(type_id)[0],
        modules: in.state.modules.push(module_name)[0],
        writable: in.state.writable.push(false)[0]
    }
}
