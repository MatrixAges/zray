<Module>
    <Type from="model" as="Bindings" />

    <Args in={Bindings.Input} out={Bindings.Output} />

    <Call
        fn="../../store_initializers/index_slots"
        in={{
            keys: $in.initializers.keys,
            count: $in.initializers.count > 1 ? $in.initializers.count : 0
        }}
    />

    <Call
        fn="initialize"
        in={{
            ...$in,
            initializers: {
                ...$in.initializers,
                buckets: $ctx.index_slots
            }
        }}
    />

    <Call module="members" />

    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
