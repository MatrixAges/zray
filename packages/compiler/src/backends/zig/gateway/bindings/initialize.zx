import { Status } from "./model"

import type { Prepared as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        source: in,
        status: Status.Valid,
        index: {
            keys: [],
            values: [],
            buckets: []
        },
        types: [],
        modules: [],
        writable: [],
        indices: [],
        access: [],
        ends: [],
        input_types: [],
        output_types: [],
        requires_io: [],
        requires_process: []
    }
}
