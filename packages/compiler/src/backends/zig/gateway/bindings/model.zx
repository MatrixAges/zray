import type { Index } from "core/bytes/index/model"
import type { Stores } from "core/store_table/model"
import type { Table } from "core/type_table/model"
import type { ReadColumn, TextColumn, U8Buffer, U32Buffer } from "memory"
import type { Initializers } from "../../store_initializers/model"

export enum Status {
    Valid,
    InvalidModule,
    UnsupportedHostReference,
    ConflictingStore,
    MissingInitializer,
    InvalidInitializer
}

export type Member = {
    export_name: string,
    name: string,
    function_id?: u32,
    requires_io?: bool,
    requires_process: bool
}

export type Members = {
    export_names: TextColumn,
    names: TextColumn,
    functions: ReadColumn,
    requires_io: ReadColumn,
    requires_process: ReadColumn,
    count: u64
}

export type Descriptors = {
    input_types: U32Buffer,
    output_types: U32Buffer,
    requires_io: U8Buffer,
    requires_process: U8Buffer
}

export type Functions = {
    input_types: u32[],
    output_types: u32[],
    stores: Stores[]
}

export type Input = {
    types: Table,
    type_names: string[],
    functions: Functions,
    members: Members,
    initializers: Initializers,
    independent: bool,
    descriptors: Descriptors
}

export type State = {
    source: Input,
    status: Status,
    index: Index,
    types: u32[],
    modules: string[],
    writable: bool[],
    indices: u64[],
    access: bool[],
    ends: u64[]
}

export type Service = {
    state: State,
    member: Member,
    position: u64
}

export type Binding = {
    state: State,
    stores: Stores,
    position: u64
}

export type Output = State.Omit("types", "source", "index")

export type Traversal = {
    state: State,
    position: u64,
    running: bool
}
