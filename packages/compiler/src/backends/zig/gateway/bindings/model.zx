import type { Index } from "core/bytes/index/model"
import type { Stores } from "core/store_table/model"
import type { Table } from "core/type_table/model"
import type { ReadColumn, TextColumn } from "memory"
import type { Indexed, Initializers } from "../../store_initializers/model"

export enum Status {
    Valid,
    InvalidModule,
    UnsupportedHostReference,
    ConflictingStore,
    MissingInitializer,
    InvalidInitializer
}

export type Member = {
    export_name: string,
    name: string,
    function_id?: u32,
    requires_io?: bool,
    requires_process: bool
}

export type Members = {
    export_names: TextColumn,
    names: TextColumn,
    functions: ReadColumn,
    requires_io: ReadColumn,
    requires_process: ReadColumn,
    count: u64
}

export type Functions = {
    input_types: u32[],
    output_types: u32[],
    stores: Stores[]
}

export type Input = {
    types: Table,
    type_names: string[],
    functions: Functions,
    members: Members,
    initializers: Initializers,
    independent: bool
}

export type Prepared = Input.Omit("initializers") & {
    initializers: Indexed
}

export type State = {
    source: Prepared,
    status: Status,
    index: Index,
    types: u32[],
    modules: string[],
    writable: bool[],
    indices: u64[],
    access: bool[],
    ends: u64[],
    input_types: u32[],
    output_types: u32[],
    requires_io: bool[],
    requires_process: bool[]
}

export type Service = {
    state: State,
    member: Member,
    position: u64
}

export type Binding = {
    state: State,
    stores: Stores,
    position: u64
}

export type Output = State.Omit("types", "source", "index")

export type Traversal = {
    state: State,
    position: u64,
    running: bool
}
