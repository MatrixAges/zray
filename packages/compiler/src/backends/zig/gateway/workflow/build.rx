<Module>
    <Type from="model" as="Gateway" />

    <Args in={Gateway.Input} out={Gateway.Output} />

    <Call
        fn="reserve"
        in={$in.pick([
            "modules",
            "public_modules"
        ])}
    />

    <If on={$in.has_library}>
        <Return
            value={{
                capacity: $ctx.reserve,
                steps: [
                    Gateway.Step.BindState,
                    Gateway.Step.ReserveFiles,
                    Gateway.Step.AppendModules,
                    Gateway.Step.AppendFacades,
                    Gateway.Step.PublishContract,
                    Gateway.Step.PublishState,
                    Gateway.Step.PublishApplication
                ]
            }}
        />
    </If>

    <Return
        value={{
            capacity: $ctx.reserve,
            steps: [
                Gateway.Step.ReserveFiles,
                Gateway.Step.PublishContract,
                Gateway.Step.PublishState,
                Gateway.Step.PublishApplication
            ]
        }}
    />
</Module>
