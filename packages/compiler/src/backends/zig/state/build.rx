<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Input} out={Plan.Output} />

    <Call
        fn="../store_initializers/index_slots"
        in={{
            keys: $in.initializers.keys,
            count: $in.initializers.count > 1 ? $in.initializers.count : 0
        }}
    />

    <Call
        fn="initialize"
        in={{
            ...$in,
            initializers: {
                ...$in.initializers,
                buckets: $ctx.index_slots
            }
        }}
    />

    <Call fn="bindings" />

    <If on={$ctx.bindings.result.status != Plan.Status.Ready}>
        <Return value={$ctx.bindings.result} />
    </If>

    <If on={!$in.has_requirements}>
        <Return
            value={{
                ...$ctx.bindings.result,
                status: Plan.Status.InvalidAnalysis
            }}
        />
    </If>

    <Return value={$ctx.bindings.result} />
</Module>
