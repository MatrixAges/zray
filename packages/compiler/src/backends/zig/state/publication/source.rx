<Module>
    <Type from="model" as="Publish" />

    <Args in={Publish.Input} out={u8[]} />

    <If on={!$in.cached}>
        <Call fn="index.renderStateSource" in={$in.frame} />

        <Return value={$ctx.renderStateSource} />
    </If>

    <Call fn="fingerprint" in={$in.key} />

    <Call
        fn="index.lookupStateSource"
        in={{
            frame: $in.frame,
            name: $in.name,
            key: $ctx.fingerprint
        }}
    />

    <If on={$ctx.lookupStateSource != null}>
        <Return value={$ctx.lookupStateSource} />
    </If>

    <Call fn="index.renderStateSource" in={$in.frame} />

    <Call
        fn="index.cacheStateSource"
        in={{
            frame: $in.frame,
            name: $in.name,
            key: $ctx.fingerprint,
            source: $ctx.renderStateSource
        }}
    />

    <Return value={$ctx.renderStateSource} />
</Module>
