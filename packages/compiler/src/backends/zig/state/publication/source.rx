<Module>
    <Type from="model" as="Publish" />

    <Args in={Publish.Input} out={Publish.Source} />

    <If on={!$in.cached}>
        <Call fn="index.renderStateSource" in={$in.frame} />

        <Return
            value={{
                source: $ctx.renderStateSource,
                cache_key: null
            }}
        />
    </If>

    <Call fn="fingerprint" in={$in.key} />

    <Call
        fn="index.lookupStateSource"
        in={{
            frame: $in.frame,
            name: $in.name,
            key: $ctx.fingerprint
        }}
    />

    <If on={$ctx.lookupStateSource != null}>
        <Return
            value={{
                source: $ctx.lookupStateSource,
                cache_key: null
            }}
        />
    </If>

    <Call fn="index.renderStateSource" in={$in.frame} />

    <Return
        value={{
            source: $ctx.renderStateSource,
            cache_key: $ctx.fingerprint
        }}
    />
</Module>
