<Module>
    <Type from="model" as="Publish" />

    <Args in={Publish.Input} out={Publish.Source} />

    <If on={!$in.cached}>
        <Return
            value={{
                action: Publish.Action.Render
            }}
        />
    </If>

    <If on={$in.lookup != null}>
        <If on={$in.lookup.source != null}>
            <Return
                value={{
                    action: Publish.Action.Reuse,
                    source: $in.lookup.source
                }}
            />
        </If>

        <Return
            value={{
                action: Publish.Action.Render,
                cache_key: $in.lookup.key
            }}
        />
    </If>

    <Call fn="fingerprint" in={$in.key} />

    <Return
        value={{
            action: Publish.Action.Lookup,
            cache_key: $ctx.fingerprint
        }}
    />
</Module>
