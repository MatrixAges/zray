import type { StatePublication } from "state_publication_host"

export type Key = {
    imports: string[],
    writable: bool[],
    independent: bool,
    io: bool,
    process: bool
}

export type Input = {
    frame: StatePublication,
    name: string,
    key: Key,
    cached: bool
}

export type Source = {
    source: u8[],
    cache_key?: u8[]
}

export type Output = Source & {
    name: string,
    imports: string[]
}
