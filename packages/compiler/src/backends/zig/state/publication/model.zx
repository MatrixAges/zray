import type { Lookup } from "state_publication_host"

export enum Action {
    Lookup,
    Reuse,
    Render
}

export type Key = {
    imports: string[],
    writable: bool[],
    independent: bool,
    io: bool,
    process: bool
}

export type Input = {
    name: string,
    key: Key,
    cached: bool,
    lookup?: Lookup
}

export type Source = {
    action: Action,
    source?: u8[],
    cache_key?: u8[]
}

export type Output = Source & {
    name: string,
    imports: string[]
}
