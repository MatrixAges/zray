<Module>
    <Type from="model" as="Publish" />

    <Args in={Publish.Input} out={Publish.Output} />

    <Call module="source" in={$in} />

    <Return
        value={{
            name: $in.name,
            imports: $in.key.imports,
            source: $ctx.source.source,
            cache_key: $ctx.source.cache_key
        }}
    />
</Module>
