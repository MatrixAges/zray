import bytes from "std:bytes"
import crypto from "std:crypto"

import {
    false_value,
    fingerprint_close,
    fingerprint_prefix,
    first_initializer,
    independent_object,
    object_separator,
    process_field,
    readonly_object_end,
    requirements_open,
    shared_object,
    true_value,
    writable_object_end
} from "./const"
import jsonParts from "./json_parts"

import type { Key as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { imports, writable } = in

    const object = in.independent ? independent_object : shared_object

    const initial: u8[][] = [
        bytes.fromText(fingerprint_prefix)
    ]

    const body = loop({
        row: first_initializer,
        parts: initial
    }, {
        while: state => state.row < imports.length,
        next: state => {
            const row = state.row

            if (row != first_initializer) {
                state.parts = state.parts.push(bytes.fromText(object_separator))[0]
            }

            const obj_parts = state.parts.push(bytes.fromText(object))[0]

            const text_parts = jsonParts({
                text: imports[row],
                parts: obj_parts
            })

            const can_write = writable[row - first_initializer]
            const end = can_write ? writable_object_end : readonly_object_end

            state.parts = text_parts.push(bytes.fromText(end))[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const io_value = in.io ? true_value : false_value
    const process_value = in.process ? true_value : false_value

    const parts = body
        .push(bytes.fromText(requirements_open))[0]
        .push(
            bytes.fromText(
                io_value
            )
        )[0]
        .push(
            bytes.fromText(
                process_field
            )
        )[0]
        .push(
            bytes.fromText(
                process_value
            )
        )[0]
        .push(
            bytes.fromText(
                fingerprint_close
            )
        )[0]

    return crypto.sha256Parts(parts)
}
