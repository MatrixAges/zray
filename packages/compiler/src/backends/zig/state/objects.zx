export type Object = {
    module_name: string,
    writable: u8,
    independent: u8
}

export type Input = {
    modules: string[],
    writable: bool[],
    independent: bool
}

export type Output = Object[]

export default function (in: Input): Output {
    const independent: u8 = in.independent ? 1 : 0
    const empty: Object[] = []

    return loop({
        row: 0,
        objects: empty
    }, {
        while: state => state.row < in.modules.length,
        next: state => {
            const row = state.row
            const writable: u8 = in.writable[row] ? 1 : 0

            state.objects = state.objects.push({
                module_name: in.modules[row],
                writable,
                independent
            })[0]
            state.row += 1
        },
        return: state => state.objects
    })
}
