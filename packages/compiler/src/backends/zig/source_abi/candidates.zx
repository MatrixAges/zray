import memory from "memory"

import contains from "./contains"

import type { Bindings, Sources, Candidates } from "./model"

export type Input = Sources & {
    modules: Bindings,
    scope: u64
}

export type Output = Candidates

export default function (in: Input): Output {
    const names: string[] = []
    const identities: string[] = []

    const defaults = loop({
        modules: in.modules,
        names,
        identities,
        index: 0
    }, {
        while: current => current.index < current.modules.specifiers.length,
        next: current => {
            if (current.modules.identities[current.index] == null) {
                const name = current.modules.specifiers[current.index]

                current.names = current.names.push(name)[0]
                current.identities = current.identities.push(name)[0]
            }

            current.index += 1
        }
    })

    const first = memory.listLength(in.interfaces.specifiers, in.scope)
    const last = memory.listLength(in.externals.specifiers, in.scope)

    const result = loop({
        modules: in.modules,
        interfaces: in.interfaces,
        externals: in.externals,
        scope: in.scope,
        names: defaults.names,
        identities: defaults.identities,
        index: 0,
        first,
        count: first + last
    }, {
        while: current => current.index < current.count,
        next: current => {
            const { first } = current
            const external = current.index >= first
            const source = match {
                external => current.externals,
                _ => current.interfaces
            }
            const index = external ? current.index - first : current.index
            const name = memory.readListText(source.specifiers, current.scope, index)
            const identity =
                memory.readListOptionalText(source.identities, current.scope, index) ??
                name

            if (contains({
                modules: current.modules,
                identity
            })) {
                current.names = current.names.push(name)[0]
                current.identities = current.identities.push(identity)[0]
            }

            current.index += 1
        }
    })

    return {
        names: result.names,
        identities: result.identities
    }
}
