import bytes from "std:bytes"
import memory from "memory"

import type { ScopeRoots } from "./model"

export type Input = ScopeRoots & {
    root: string
}

export type Output = u64?

export default function (in: Input): Output {
    const empty: u64? = null

    return loop({
        roots: in.roots,
        count: in.count,
        root: bytes.fromText(in.root),
        selected: empty,
        index: 0,
        found: false
    }, {
        while: current => !current.found && current.index < current.count,
        next: current => {
            if (
                bytes.equals(
                    bytes.fromText(
                        memory.readTextColumn(
                            current.roots,
                            current.index
                        )
                    ),
                    current.root
                )
            ) {
                current.selected = current.index
                current.found = true
            }

            current.index += 1
        },
        return: state => state.selected
    })
}
