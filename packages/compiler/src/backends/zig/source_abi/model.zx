import type { Alias } from "genz/abi/model"
import type { ListColumn, TextColumn } from "memory"

export type Bindings = {
    specifiers: string[],
    identities: string?[]
}

export type BindingLists = {
    specifiers: ListColumn,
    identities: ListColumn
}

export type Sources = {
    interfaces: BindingLists,
    externals: BindingLists
}

export type ScopeRoots = {
    count: u64,
    roots: TextColumn
}

export type Scopes = ScopeRoots & Sources

export type Input = {
    modules: Bindings,
    scopes: Scopes,
    fallback: Sources,
    root: string
}

export type Candidates = {
    names: string[],
    identities: string[]
}

export type Output = Alias[]?
