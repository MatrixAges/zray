import type { Alias } from "genz/abi/model"
import type { ListColumn, ReadColumn, TextColumn } from "memory"

export type Bindings = {
    specifiers: string[],
    identities: string?[]
}

export type BindingRows = {
    count: u64,
    specifiers: TextColumn,
    identities: ReadColumn
}

export type BindingLists = {
    specifiers: ListColumn,
    identities: ListColumn
}

export type Scopes = {
    count: u64,
    roots: TextColumn,
    interfaces: BindingLists,
    externals: BindingLists
}

export type Sources = {
    interfaces: BindingRows,
    externals: BindingRows
}

export type PlanInput = {
    count: u64,
    identities: string?[],
    roots: TextColumn,
    root: string
}

export type Plan = {
    scoped: bool,
    scope?: u64
}

export type Input = {
    modules: Bindings,
    sources: Sources
}

export type Candidates = {
    names: string[],
    identities: string[]
}

export type Output = Alias[]
