export type LibraryEntries = opaque

export declare function analyzeLibraryExport(
    entries: LibraryEntries,
    index: u64,
    first: u64,
    end: u64
): void throws {
    OutOfMemory,
    InvalidModule
}

export declare function publishLibraryExport(
    entries: LibraryEntries,
    index: u64,
    first: u64,
    end: u64
): void throws { OutOfMemory }
