import type { Allocator, ColumnRanges, U8Buffer, WriteColumn } from "memory"
import type { CacheWriter, GenerationCacheRecord } from "output_host"
import type { Input as WriteSchedule } from "../writes/model"
import type { Input as Replacement } from "./replace"

export type Queue = {
    ranges: ColumnRanges,
    tail: U8Buffer,
    bytes: u8[],
    retired: WriteColumn,
    retired_offset: u64
}

export type Input = Replacement &
    WriteSchedule.Pick("active", "threaded") & {
        cache: CacheWriter,
        target: GenerationCacheRecord,
        resource: Allocator,
        destination: Queue
    }
