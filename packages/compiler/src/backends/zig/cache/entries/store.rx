<Module>
    <Type from="store_model" as="Store" />

    <Args in={Store.Input} out={Store.Outcome} />

    <Call
        fn="replace"
        in={$in.pick([
            "previous",
            "queue",
            "count",
            "persistent",
            "needs_write"
        ])}
    />

    <Call
        fn="../writes/complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Call
        fn="../writes/workflow/finish"
        in={{
            cache: $in.cache,
            action: $ctx.complete
        }}
    />

    <If on={$in.previous != null && $ctx.replace.retire == null}>
        <Call
            fn="index.freeOwnedText"
            in={[
                $in.previous.owner,
                $in.previous.source
            ]}
        />
    </If>

    <Call
        fn="index.writeGenerationCacheRecord"
        in={[
            $in.target,
            $ctx.replace.append
        ]}
    />

    <Return
        value={{
            append: $ctx.replace.append != null,
            retire: $ctx.replace.retire
        }}
    />
</Module>
