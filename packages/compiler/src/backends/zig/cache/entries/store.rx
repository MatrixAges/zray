<Module>
    <Type from="store_model" as="Store" />

    <Args in={Store.Input} out={Store.Outcome} />

    <Call
        fn="replace"
        in={$in.pick([
            "previous",
            "queue",
            "count",
            "persistent",
            "needs_write"
        ])}
    />

    <Call
        fn="../writes/complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Return
        value={{
            ...$ctx.replace,
            finish: $ctx.complete,
            release: $in.previous != null && $ctx.replace.retire == null
        }}
    />
</Module>
