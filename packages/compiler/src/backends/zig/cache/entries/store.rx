<Module>
    <Type from="store_model" as="Store" />

    <Args in={Store.Input} out={bool} />

    <Call
        fn="replace"
        in={$in.pick([
            "previous",
            "queue",
            "count",
            "persistent",
            "needs_write"
        ])}
    />

    <If on={$ctx.replace.append != null}>
        <Call
            fn="index.reserveColumnRange"
            in={[
                $in.resource,
                $in.destination.ranges,
                0,
                null,
                false
            ]}
        />
    </If>

    <Call
        fn="../writes/complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Call
        fn="../writes/workflow/finish"
        in={{
            cache: $in.cache,
            action: $ctx.complete
        }}
    />

    <If on={$in.previous != null}>
        <If on={$ctx.replace.retire != null}>
            <Call
                fn="retire_queue"
                in={{
                    ...$in.destination.pick([
                        "ranges",
                        "retired",
                        "retired_offset"
                    ]),
                    row: $ctx.replace.retire
                }}
            />

            <Else>
                <Call
                    fn="index.freeOwnedText"
                    in={[
                        $in.previous.owner,
                        $in.previous.source
                    ]}
                />
            </Else>
        </If>
    </If>

    <Call
        fn="index.writeGenerationCacheRecord"
        in={[
            $in.target,
            $ctx.replace.append
        ]}
    />

    <If on={$ctx.replace.append != null}>
        <Call
            fn="append_queue"
            in={$in.destination.pick([
                "ranges",
                "tail",
                "bytes"
            ])}
        />
    </If>

    <Return value={$in.previous != null && $ctx.replace.retire != null} />
</Module>
