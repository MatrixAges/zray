import bytes from "std:bytes"
import integers from "std:integer"

import { header_width, length_width, newline, word_radix } from "./const"
import hexWord from "./hex_word"

export type Input = {
    header: u8[],
    payload_size: u64
}

export type Output = bool

export default function (in: Input): Output {
    const start = header_width - length_width - 1
    const last = header_width - 1

    const upper = hexWord(in.payload_size / word_radix)
    const lower = hexWord(in.payload_size % word_radix)
    const high_first = integers.widen(bytes.readU32(in.header, start, true))
    const high_last = integers.widen(bytes.readU32(in.header, start + 4, true))
    const low_first = integers.widen(bytes.readU32(in.header, start + 8, true))
    const low_last = integers.widen(bytes.readU32(in.header, start + 12, true))

    const high = high_first + high_last * word_radix
    const low = low_first + low_last * word_radix

    return high == upper && low == lower && in.header[last] == newline
}
