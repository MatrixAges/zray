export type Frame = {
    compiler: u8[],
    key: u8[],
    size: u64,
    reading: bool
}

export type Request = {
    size: u64,
    reading: bool
}

export type Layout = {
    accepted: bool,
    payload_size: u64
}

export type Prefix = Frame.Pick("compiler", "key")

export type Header = {
    bytes: u8[],
    payload_size: u64
}

export type Parts = {
    prefix: u8[],
    length: u8[],
    payload_size: u64
}

export type Recorded = Frame.Pick("compiler", "key") & {
    header: u8[],
    payload_size: u64
}
