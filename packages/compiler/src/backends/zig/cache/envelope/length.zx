import bytes from "std:bytes"

import { word_radix } from "./const"
import hexWord from "./hex_word"

export type Input = u64

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        bytes.encodeU64Le(hexWord(in / word_radix)),
        bytes.encodeU64Le(hexWord(in % word_radix)),
        bytes.fromText("\n")
    ])
}
