import bytes from "std:bytes"

import { marker } from "./const"

import type { Prefix as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        bytes.fromText(marker),
        in.compiler,
        bytes.fromText("\n"),
        in.key,
        bytes.fromText("\n")
    ])
}
