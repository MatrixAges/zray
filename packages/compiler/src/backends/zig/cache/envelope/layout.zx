import { header_width, maximum_payload } from "./const"

import type { Layout as Output, Request as Input } from "./model"

export default function (in: Input): Output {
    if (in.reading && in.size < header_width) {
        return {
            accepted: false,
            payload_size: 0
        }
    }

    const payload_size = in.reading ? in.size - header_width : in.size

    return {
        accepted: payload_size <= maximum_payload,
        payload_size
    }
}
