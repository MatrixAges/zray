import bytes from "std:bytes"

import { cache_suffix } from "./const"

export type Input = {
    directory: u8[],
    key: u8[]
}

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        in.directory,
        bytes.fromText("/"),
        in.key,
        bytes.fromText(cache_suffix)
    ])
}
