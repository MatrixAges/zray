import bytes from "std:bytes"

import { digest_text_width, header_width, marker, newline } from "./const"

import type { Recorded } from "./model"

export type Input = Recorded.Omit("payload_size")

export type Output = bool

export default function (in: Input): Output {
    const { header, compiler, key } = in

    if (header.length != header_width) {
        return false
    }

    const compiler_start = marker.length
    const compiler_end = compiler_start + digest_text_width
    const key_start = compiler_end + 1
    const key_end = key_start + digest_text_width

    const version_ok = bytes.startsWithText(header, 0, marker)
    const compiler_ok = bytes.startsWith(header, compiler_start, compiler)
    const key_ok = bytes.startsWith(header, key_start, key)
    const separators = header[compiler_end] == newline && header[key_end] == newline

    const identity = (
        - version_ok
        - and compiler_ok
        - and key_ok
        - and separators
    )

    return identity
}
