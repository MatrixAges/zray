<Module>
    <Type from="model" as="Envelope" />

    <Args in={Envelope.Frame} out={Envelope.Header?} />

    <Call
        fn="layout"
        in={$in.pick([
            "size",
            "reading"
        ])}
    />

    <If on={!$ctx.layout.accepted}>
        <Return value={null} />
    </If>

    <Call
        fn="prefix"
        in={$in.pick([
            "compiler",
            "key"
        ])}
    />

    <Call fn="length" in={$ctx.layout.payload_size} />

    <Call
        fn="assemble"
        in={{
            prefix: $ctx.prefix,
            length: $ctx.length,
            payload_size: $ctx.layout.payload_size
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
