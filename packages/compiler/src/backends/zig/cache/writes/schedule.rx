<Module>
    <Type from="model" as="Writes" />

    <Args in={Writes.Input} out={Writes.Output} />

    <Call
        fn="complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Call
        fn="start"
        in={$in.pick([
            "mode",
            "waiting"
        ])}
    />

    <Return
        value={{
            finish: $ctx.complete,
            start: $ctx.start
        }}
    />
</Module>
