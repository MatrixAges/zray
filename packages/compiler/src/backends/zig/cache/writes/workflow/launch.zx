import host from "output_host"

import { Action } from "../model"

import type { Transition as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    if (in.action == Action.Idle) {
        return
    }

    const started = host.startCacheWriting(in.cache, in.action == Action.Spawn)

    if (!started) {
        host.finishCacheWriting(in.cache, false)
    }
}
