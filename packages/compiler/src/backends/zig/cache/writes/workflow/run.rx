<Module>
    <Type from="model" as="Writing" />

    <Args in={Writing.Input} out={void} />

    <Call
        fn="../complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Call
        fn="finish"
        in={{
            cache: $in.cache,
            action: $ctx.complete
        }}
    />

    <Call
        fn="../start"
        in={$in.pick([
            "mode",
            "waiting"
        ])}
    />

    <Call
        fn="launch"
        in={{
            cache: $in.cache,
            action: $ctx.start
        }}
    />
</Module>
