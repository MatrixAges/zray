<Module>
    <Type from="../model" as="Schedule" />
    <Type from="model" as="Writing" />

    <Args in={Schedule.Input} out={Writing.Output} />

    <Call
        fn="../complete"
        in={$in.pick([
            "active",
            "threaded"
        ])}
    />

    <Call
        fn="../start"
        in={$in.pick([
            "mode",
            "waiting"
        ])}
    />

    <Return
        value={{
            finish: $ctx.complete,
            start: $ctx.start
        }}
    />
</Module>
