import memory from "memory"

import type { Allocator, ReadColumn, TextColumn } from "memory"

export type Input = {
    flags: ReadColumn,
    sources: TextColumn,
    owners: ReadColumn,
    count: u64,
    local: Allocator,
    shared: Allocator,
    shared_owner: u8
}

export type Output = void

export default function (in: Input): Output {
    const { count, flags, sources, owners, local, shared, shared_owner } = in

    const released = loop(0, {
        while: row => row < count,
        next: row => {
            if (memory.readColumnBool(flags, row)) {
                const owner = memory.readColumnU8(owners, row)
                const allocator = owner == shared_owner ? shared : local

                memory.freeOwnedText(
                    allocator,
                    memory.readTextColumn(sources, row)
                )
            }

            row += 1
        }
    })
}
