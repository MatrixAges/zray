import memory from "memory"

import type { ReadColumn } from "memory"

export type Input = {
    flags: ReadColumn,
    first: u64,
    count: u64
}

export type Output = u64?

export default function (in: Input): Output {
    const none: u64? = null

    return loop({
        row: in.first,
        retired: none
    }, {
        while: state => state.row < in.count && state.retired == null,
        next: state => {
            if (memory.readColumnBool(in.flags, state.row)) {
                state.retired = state.row
            }

            state.row += 1
        },
        return: state => state.retired
    })
}
