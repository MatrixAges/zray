import memory from "memory"
import host from "output_host"

import type { AtomicIndex, U32Buffer, U64Buffer } from "memory"
import type { GenerationCacheFiles } from "output_host"

export type Input = {
    files: GenerationCacheFiles,
    cursor: AtomicIndex,
    count: u64,
    participant: u64,
    written: U64Buffer,
    failures: U64Buffer,
    last_error: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const { files, cursor, count, participant, written, failures, last_error } = in

    const totals = loop({
        running: true,
        written: 0,
        failures: 0
    }, {
        while: state => state.running,
        next: state => {
            const row = memory.fetchAddIndexRelaxed(cursor, 1)

            if (row >= count) {
                state.running = false
            } else {
                const code = host.writeGenerationCacheFile(files, row)

                if (code == 0) {
                    state.written += 1
                } else if (code != null) {
                    state.failures += 1
                    memory.storeU32Relaxed(last_error, 0, code)
                }
            }
        }
    })

    memory.writeU64(written, participant, totals.written)
    memory.writeU64(failures, participant, totals.failures)
}
