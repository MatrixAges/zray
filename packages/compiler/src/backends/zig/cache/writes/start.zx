import { Action, Mode } from "./model"

import type { Input as Request } from "./model"

export type Input = Request.Pick("mode", "waiting")

export type Output = Action

export default function (in: Input): Output {
    if (!in.waiting) {
        return Action.Idle
    }

    return match in.mode {
        Mode.Synchronous => Action.Drain,
        Mode.Background => Action.Spawn,
        _ => Action.Idle
    }
}
