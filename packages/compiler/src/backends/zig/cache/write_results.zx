import memory from "memory"

import { failure_slot, written_slot } from "./writes/const"

import type { ColumnLengths } from "memory"

export type Input = {
    written: u64[],
    failures: u64[],
    counters: ColumnLengths
}

export type Output = void

export default function (in: Input): Output {
    const totals = loop({
        index: 0,
        written: 0,
        failures: 0
    }, {
        while: state => state.index < in.written.length,
        next: state => {
            const { index } = state

            state.written += in.written[index]
            state.failures += in.failures[index]
            state.index += 1
        }
    })

    memory.advanceLengthSlot(in.counters, written_slot, totals.written)
    memory.advanceLengthSlot(in.counters, failure_slot, totals.failures)
}
