import integers from "std:integer"

import type { Input, Unit } from "./model"

export type Output = Unit[]

export default function (in: Input): Output {
    const { needed, regular, count } = in

    const units: Unit[] = []

    if (count == 0) {
        return units
    }

    return loop({
        index: 0,
        units
    }, {
        while: state => state.units.length < count,
        next: state => {
            const index = state.index

            if (needed[index]) {
                const marked = regular.length != 0 && regular[index] != 0

                state.units = state.units.push({
                    id: integers.narrow(index),
                    regular: marked
                })[0]
            }

            state.index += 1
        },
        return: state => state.units
    })
}
