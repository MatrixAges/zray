import type { Index } from "core/bytes/index/model"
import type { TextColumn } from "memory"

export enum Status {
    Valid,
    UnterminatedImport,
    UnsupportedFunctionReference,
    MissingFunctionFile
}

export type Input = {
    source: string,
    index: Index
}

export type Match = {
    status: Status,
    cursor: u64,
    callee: u32,
    variant: u8[]
}

export type Located = {
    source: Input,
    at: u64
}

export type References = {
    status: Status,
    callees: u32[],
    variants: u8[][]
}

export type Row = {
    callees: u32[],
    variants: u8[][],
    inline_names: u8[][]
}

export type Batch = {
    sources: TextColumn,
    index: Index,
    count: u64,
    need_inline_names: bool
}

export type BatchOutput = {
    status: Status,
    rows: Row[]
}
