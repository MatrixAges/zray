import type { Index } from "core/bytes/index/model"
import type { TextColumn, U32ListBuffer } from "memory"
import type { WriteColumn } from "memory/columns"

export enum Status {
    Valid,
    UnterminatedImport,
    UnsupportedFunctionReference,
    MissingFunctionFile
}

export type Input = {
    source: string,
    index: Index
}

export type Match = {
    status: Status,
    cursor: u64,
    callee: u32,
    variant: u8[]
}

export type Located = {
    source: Input,
    at: u64
}

export type References = {
    status: Status,
    callees: u32[],
    variants: u8[][]
}

export type Batch = {
    sources: TextColumn,
    index: Index,
    count: u64,
    callees: U32ListBuffer,
    variants: WriteColumn,
    inline_names?: WriteColumn
}
