import memory from "memory"

import inlineNames from "./inline_names"
import { Status } from "./model"
import references from "./references"

import type { Batch as Input, BatchOutput, Row } from "./model"

export type Output = BatchOutput

export default function (in: Input): Output {
    const { sources, index, count, need_inline_names } = in

    const empty: Row[] = []
    const empty_inline: u8[][] = []

    return loop({
        row: 0,
        status: Status.Valid,
        rows: empty
    }, {
        while: state => state.row < count && state.status == Status.Valid,
        next: state => {
            const source = memory.readTextColumn(sources, state.row)
            const scanned = references({
                source,
                index
            })

            state.status = scanned.status

            if (scanned.status == Status.Valid) {
                const inlined = match need_inline_names {
                    true => inlineNames(source),
                    _ => empty_inline
                }

                state.rows = state.rows.push({
                    callees: scanned.callees,
                    variants: scanned.variants,
                    inline_names: inlined
                })[0]
            }

            state.row += 1
        },
        return: state => state.pick([
            "status",
            "rows"
        ])
    })
}
