import integers from "std:integer"

import { root_file, functions_file } from "./const"

import type { Job, RootsOutput } from "./model"

export type Input = {
    prefixes: string[],
    first: u64
}

export type Output = RootsOutput

export default function (in: Input): Output {
    const empty_paths: string[] = []
    const empty_jobs: Job[] = []
    const empty_variants: u8[][] = []

    return loop({
        scope: 0,
        paths: empty_paths,
        jobs: empty_jobs
    }, {
        while: state => state.scope < in.prefixes.length,
        next: state => {
            const scope = state.scope
            const prefix = in.prefixes[scope]
            const row = in.first + scope * 2

            state.paths = state.paths.push(`${prefix}${root_file}`)[0]
                .push(
                    `${prefix}${functions_file}`
                )[0]
            state.jobs = state.jobs.push({
                destination: row,
                index: integers.narrow(scope),
                root: true,
                variants: empty_variants,
                comptime_entry: false
            })[0]
            state.scope += 1
        },
        return: state => state.pick([
            "paths",
            "jobs"
        ])
    })
}
