import integers from "std:integer"

import { root_file, functions_file } from "./const"

import type { Output as Publication } from "./model"

export type Input = Publication & {
    prefixes: string[]
}

export type Output = Publication

export default function (in: Input): Output {
    const empty_variants: u8[][] = []

    return loop({
        scope: 0,
        files: in.files,
        jobs: in.jobs
    }, {
        while: state => state.scope < in.prefixes.length,
        next: state => {
            const scope = state.scope
            const prefix = in.prefixes[scope]
            const destination = state.files.length

            state.files = state.files.push({
                path: `${prefix}${root_file}`,
                source: ""
            })[0].push({
                path: `${prefix}${functions_file}`,
                source: ""
            })[0]
            state.jobs = state.jobs.push({
                destination,
                index: integers.narrow(scope),
                root: true,
                variants: empty_variants,
                comptime_entry: false
            })[0]
            state.scope += 1
        },
        return: state => state.pick([
            "files",
            "jobs"
        ])
    })
}
