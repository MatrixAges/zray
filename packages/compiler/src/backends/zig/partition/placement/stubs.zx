import stubScope from "./stub_scope"

import type { Scope } from "../demand/model"
import type { Job, State, StubsOutput } from "./model"

export type Input = {
    files: State,
    prefixes: string[],
    scopes: Scope[],
    first: u64
}

export type Output = StubsOutput

export default function (in: Input): Output {
    const empty_paths: string[] = []
    const empty_jobs: Job[] = []

    return loop({
        scope: 0,
        paths: empty_paths,
        jobs: empty_jobs
    }, {
        while: state => state.scope < in.scopes.length,
        next: state => {
            const use_prefix = state.scope < in.prefixes.length
            const prefix = use_prefix ? in.prefixes[state.scope] : ""

            const updated = stubScope({
                files: in.files,
                scope: in.scopes[state.scope],
                prefix,
                use_prefix,
                first_destination: in.first + state.jobs.length,
                paths: state.paths,
                jobs: state.jobs
            })

            state.paths = updated.paths
            state.jobs = updated.jobs
            state.scope += 1
        },
        return: state => state.pick([
            "paths",
            "jobs"
        ])
    })
}
