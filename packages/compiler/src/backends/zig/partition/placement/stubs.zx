import stubScope from "./stub_scope"

import type { Scope } from "../demand/model"
import type { File, Job, Output as Publication, State } from "./model"

export type Input = {
    files: State,
    copies: File[],
    prefixes: string[],
    scopes: Scope[]
}

export type Output = Publication

export default function (in: Input): Output {
    const empty_jobs: Job[] = []

    return loop({
        scope: 0,
        files: in.copies,
        jobs: empty_jobs
    }, {
        while: state => state.scope < in.scopes.length,
        next: state => {
            const use_prefix = state.scope < in.prefixes.length
            const prefix = use_prefix ? in.prefixes[state.scope] : ""

            const updated = stubScope({
                originals: in.files,
                scope: in.scopes[state.scope],
                prefix,
                use_prefix,
                files: state.files,
                jobs: state.jobs
            })

            state.files = updated.files
            state.jobs = updated.jobs
            state.scope += 1
        },
        return: state => state.pick([
            "files",
            "jobs"
        ])
    })
}
