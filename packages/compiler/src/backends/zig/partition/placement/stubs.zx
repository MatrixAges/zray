import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import type { Scope } from "../demand/model"
import type { State, StubTargets } from "./model"

export type Input = {
    files: State,
    prefixes: string[],
    scopes: Scope[],
    targets: StubTargets,
    first: u64
}

export type Output = void

export default function (in: Input): Output {
    const placed = loop({
        scope: 0,
        position: in.first
    }, {
        while: state => state.scope < in.scopes.length,
        next: state => {
            const demand = in.scopes[state.scope].stubs
            const use_prefix = state.scope < in.prefixes.length
            const prefix = use_prefix ? in.prefixes[state.scope] : ""

            const written = loop(0, {
                while: index => index < demand.callees.length,
                next: index => {
                    const callee = demand.callees[index]
                    const name = in.files.paths[integers.widen(callee)]
                    const path = match use_prefix {
                        true => `${prefix}${name}`,
                        _ => name
                    }

                    const row = state.position + index
                    const job = row - in.first

                    memory.writeColumnBytes(
                        in.files.target_paths,
                        row,
                        bytes.fromText(path)
                    )
                    memory.writeColumnU32(in.targets.callees, job, callee)
                    columns.writeColumnByteList(
                        in.targets.variants,
                        job,
                        demand.variants[index]
                    )
                    memory.writeColumnBool(
                        in.targets.comptime_entries,
                        job,
                        !use_prefix
                    )
                    index += 1
                }
            })

            state.position += written
            state.scope += 1
        }
    })
}
