import integers from "std:integer"
import memory from "memory"

import type { BodyGroup as Input, File } from "./model"

export type Output = File[]

export default function (in: Input): Output {
    const empty: File[] = []

    return loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < in.rows.length,
        next: state => {
            const callee = integers.widen(in.rows[state.index])
            const name = in.files.paths[callee]
            const path = match in.prefix.length {
                0 => name,
                _ => `${in.prefix}${name}`
            }
            const source = memory.readTextColumn(in.files.bodies, callee)

            state.items = state.items.push({
                path,
                source
            })[0]
            state.index += 1
        },
        return: state => state.items
    })
}
