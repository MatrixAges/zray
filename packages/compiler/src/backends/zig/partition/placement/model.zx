import type { TextColumn, WriteColumn } from "memory"
import type { WriteColumn as ListColumn } from "memory/columns"
import type { Scope } from "../demand/model"
import type { Placement } from "../layout/model"

export type State = {
    paths: string[],
    bodies: TextColumn,
    target_paths: WriteColumn,
    target_sources: WriteColumn
}

export type Input = {
    files: State,
    members: u32[][],
    scopes: Scope[],
    placement: Placement,
    stub_targets: StubTargets
}

export type StubTargets = {
    callees: WriteColumn,
    variants: ListColumn,
    comptime_entries: WriteColumn
}

export type BodyGroup = {
    files: State,
    rows: u32[],
    prefix: string,
    first: u64
}
