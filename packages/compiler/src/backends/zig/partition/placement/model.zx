import type { TextColumn } from "memory"
import type { Scope } from "../demand/model"

export type State = {
    paths: string[],
    bodies: TextColumn
}

export type File = {
    path: string,
    source: string
}

export type Job = {
    destination: u64,
    index: u32,
    root: bool,
    variants: u8[][],
    comptime_entry: bool
}

export type Input = {
    files: State,
    members: u32[][],
    scopes: Scope[]
}

export type Output = {
    files: File[],
    jobs: Job[]
}

export type BodyGroup = {
    files: State,
    output: File[],
    rows: u32[],
    prefix: string
}
