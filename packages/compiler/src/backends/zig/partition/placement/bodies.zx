import appendFiles from "./append_files"
import bodyGroup from "./body_group"

import type { File, State } from "./model"

export type Input = {
    files: State,
    prefixes: string[],
    members: u32[][]
}

export type Output = File[]

export default function (in: Input): Output {
    const empty: File[] = []

    return loop({
        scope: 0,
        files: empty
    }, {
        while: state => state.scope < in.members.length,
        next: state => {
            const items = bodyGroup({
                files: in.files,
                rows: in.members[state.scope],
                prefix: in.prefixes[state.scope]
            })

            state.files = appendFiles({
                target: state.files,
                items
            })
            state.scope += 1
        },
        return: state => state.files
    })
}
