import type { File } from "./model"

export type Input = {
    target: File[],
    items: File[]
}

export type Output = File[]

export default function (in: Input): Output {
    return loop({
        index: 0,
        target: in.target
    }, {
        while: state => state.index < in.items.length,
        next: state => {
            state.target = state.target.push(in.items[state.index])[0]
            state.index += 1
        },
        return: state => state.target
    })
}
