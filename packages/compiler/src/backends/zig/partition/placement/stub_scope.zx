import integers from "std:integer"

import type { Scope } from "../demand/model"
import type { Output as Publication, State } from "./model"

export type Input = Publication & {
    originals: State,
    scope: Scope,
    prefix: string,
    use_prefix: bool
}

export type Output = Publication

export default function (in: Input): Output {
    const demand = in.scope.stubs

    return loop({
        index: 0,
        files: in.files,
        jobs: in.jobs
    }, {
        while: state => state.index < demand.callees.length,
        next: state => {
            const index = state.index
            const callee = demand.callees[index]
            const name = in.originals.paths[integers.widen(callee)]
            const path = match in.use_prefix {
                true => `${in.prefix}${name}`,
                _ => name
            }
            const destination = state.files.length

            state.files = state.files.push({
                path,
                source: ""
            })[0]
            state.jobs = state.jobs.push({
                destination,
                index: callee,
                root: false,
                variants: demand.variants[index],
                comptime_entry: !in.use_prefix
            })[0]
            state.index += 1
        },
        return: state => state.pick([
            "files",
            "jobs"
        ])
    })
}
