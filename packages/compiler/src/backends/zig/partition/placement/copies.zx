import appendFiles from "./append_files"
import bodyGroup from "./body_group"

import type { Scope } from "../demand/model"
import type { File, State } from "./model"

export type Input = {
    files: State,
    prefixes: string[],
    scopes: Scope[]
}

export type Output = File[]

export default function (in: Input): Output {
    const empty: File[] = []

    return loop({
        scope: 0,
        files: empty
    }, {
        while: state => state.scope < in.scopes.length,
        next: state => {
            const present = state.scope < in.prefixes.length
            const prefix = present ? in.prefixes[state.scope] : ""

            const items = bodyGroup({
                files: in.files,
                rows: in.scopes[state.scope].copies,
                prefix
            })

            state.files = appendFiles({
                target: state.files,
                items
            })
            state.scope += 1
        },
        return: state => state.files
    })
}
