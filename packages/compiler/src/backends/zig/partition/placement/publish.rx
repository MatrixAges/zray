<Module>
    <Type from="model" as="Placement" />

    <Args in={Placement.Input} out={Placement.Output} />

    <Call fn="prefixes" in={$in.members} />

    <Call
        fn="bodies"
        in={{
            files: $in.files,
            prefixes: $ctx.prefixes,
            members: $in.members
        }}
    />

    <Call
        fn="copies"
        in={{
            files: $in.files,
            prefixes: $ctx.prefixes,
            scopes: $in.scopes
        }}
    />

    <Call
        fn="stubs"
        in={{
            files: $in.files,
            prefixes: $ctx.prefixes,
            scopes: $in.scopes,
            first: $in.placement.first_stub
        }}
    />

    <Call
        fn="roots"
        in={{
            prefixes: $ctx.prefixes,
            first: $in.placement.first_root
        }}
    />

    <Return
        value={{
            bodies: $ctx.bodies,
            copies: $ctx.copies,
            stub_paths: $ctx.stubs.paths,
            root_paths: $ctx.roots.paths,
            stub_jobs: $ctx.stubs.jobs,
            root_jobs: $ctx.roots.jobs
        }}
    />
</Module>
