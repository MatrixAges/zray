<Module>
    <Type from="model" as="Placement" />

    <Args in={Placement.Input} out={Placement.Output} />

    <Call fn="prefixes" in={$in.members} />

    <Call
        fn="bodies"
        in={{
            files: $in.files,
            prefixes: $ctx.prefixes,
            members: $in.members
        }}
    />

    <Call
        fn="copies"
        in={{
            files: $in.files,
            bodies: $ctx.bodies,
            prefixes: $ctx.prefixes,
            scopes: $in.scopes
        }}
    />

    <Call
        fn="stubs"
        in={{
            files: $in.files,
            copies: $ctx.copies,
            prefixes: $ctx.prefixes,
            scopes: $in.scopes
        }}
    />

    <Call
        fn="roots"
        in={{
            ...$ctx.stubs,
            prefixes: $ctx.prefixes
        }}
    />

    <Return value={$ctx.roots} />
</Module>
