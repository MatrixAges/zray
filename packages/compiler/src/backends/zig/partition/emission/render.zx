import host from "output_host"
import { PartitionFile } from "output_host"

import type { BootstrapPartitionJobs } from "output_host"

export type Input = {
    target: BootstrapPartitionJobs,
    row: u64,
    root: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { target, row } = in

    if (!in.root) {
        return host.renderPartitionFile(target, row, PartitionFile.Stub)
    }

    const error_code = host.renderPartitionFile(target, row, PartitionFile.Exports)

    if (error_code != 0) {
        return error_code
    }

    return host.renderPartitionFile(target, row, PartitionFile.Modules)
}
