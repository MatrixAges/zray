import { PartitionFile } from "output_host"

export type Input = {
    destination: u64,
    root: bool
}

export type File = {
    destination: u64,
    kind: PartitionFile
}

export type Output = File[]

export default function (in: Input): Output {
    const { destination, root } = in

    if (!root) {
        return [{
            destination,
            kind: PartitionFile.Stub
        }]
    }

    return [
        {
            destination,
            kind: PartitionFile.Exports
        },
        {
            destination: destination + 1,
            kind: PartitionFile.Modules
        }
    ]
}
