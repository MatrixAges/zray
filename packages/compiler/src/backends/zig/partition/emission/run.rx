<Module>
    <Type from="model" as="Partition" />

    <Args in={Partition.Input} out={Partition.Output} />

    <Call fn="../scanning/batch" in={$in.support} />

    <If on={$ctx.batch.status != Partition.Status.Valid}>
        <Return
            value={{
                status: $ctx.batch.status
            }}
        />
    </If>

    <Call fn="support" in={$ctx.batch.rows} />

    <Call
        module="../layout/plan"
        in={{
            ...$ctx.support,
            ...$in.omit([
                "files",
                "support"
            ])
        }}
    />

    <Call
        module="../placement/publish"
        in={{
            files: $in.files,
            ...$ctx.plan.omit(["roots"])
        }}
    />

    <Return
        value={{
            status: Partition.Status.Valid,
            roots: $ctx.plan.roots,
            files: $ctx.publish
        }}
    />
</Module>
