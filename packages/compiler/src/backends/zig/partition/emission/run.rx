<Module>
    <Type from="model" as="Partition" />

    <Args in={Partition.Input} out={bool} />

    <Call fn="host.scanPartitionBodies" in={$in} />
    <Call fn="host.scanPartitionSupport" in={$in} />
    <Call fn="host.planPartitionLayout" in={$in} />
    <Call fn="host.placePartitionFiles" in={$in} />

    <Return value={$ctx.placePartitionFiles != 0} />
</Module>
