import type { Scope } from "../demand/model"
import type { Placement as Output } from "./model"

export type Input = {
    members: u32[][],
    scopes: Scope[]
}

export default function (in: Input): Output {
    const bodies: u64 =
        in.members.reduce((count, group) => count + group.length, 0)[1]

    const counted = loop({
        first_stub: bodies,
        stubs: 0,
        index: 0
    }, {
        while: state => state.index < in.scopes.length,
        next: state => {
            const scope = in.scopes[state.index]

            state.first_stub += scope.copies.length
            state.stubs += scope.stubs.callees.length
            state.index += 1
        }
    })

    const first_root = counted.first_stub + counted.stubs

    return {
        first_stub: counted.first_stub,
        first_root,
        length: first_root + in.members.length * 2
    }
}
