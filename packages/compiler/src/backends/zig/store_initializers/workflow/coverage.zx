import memory from "memory"

import probe from "../index_slots/probe"
import { Status } from "./model"

import type { Coverage as Input, Status as Output } from "./model"

export default function (in: Input): Output {
    const { plan, paths, types, values, buckets } = in

    return loop({
        row: 0,
        status: Status.Ready
    }, {
        while: state => state.status == Status.Ready && state.row < paths.length,
        next: state => {
            const key = paths[state.row]
            const found: u64? = match {
                buckets.length != 0 => probe({
                    keys: plan.keys,
                    buckets,
                    key
                }).row,
                plan.count == 0 => null,
                memory.readTextColumn(plan.keys, 0) == key => 0,
                _ => null
            }

            if (found == null) {
                state.status = Status.MissingInitializer
            } else if (values[found] != types[state.row]) {
                state.status = Status.InvalidInitializer
            }

            state.row += 1
        },
        return: state => state.status
    })
}
