<Module>
    <Type from="model" as="Application" />

    <Args in={Application.Input} out={Application.Status} />

    <Call fn="emit" in={$in} />

    <If on={$ctx.emit != Application.Status.Ready}>
        <Return value={$ctx.emit} />
    </If>

    <Call fn="coverage" in={$in} />

    <Return value={$ctx.coverage} />
</Module>
