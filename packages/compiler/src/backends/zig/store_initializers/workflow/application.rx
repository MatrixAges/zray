<Module>
    <Type from="model" as="Application" />

    <Args in={Application.Input} out={Application.Output} />

    <Switch on={$in.phase}>
        <Case value={Application.Phase.Prepare}>
            <Call fn="capacity" in={$in.plan.count} />

            <Return
                value={{
                    status: Application.Status.Ready,
                    capacity: $ctx.capacity
                }}
            />
        </Case>

        <Case value={Application.Phase.Select}>
            <Call
                fn="select"
                in={$in.pick([
                    "plan",
                    "row"
                ])}
            />

            <Return
                value={{
                    status: Application.Status.Ready,
                    capacity: 0,
                    request: $ctx.select
                }}
            />
        </Case>

        <Case value={Application.Phase.Admit}>
            <Call
                fn="admit"
                in={$in.pick([
                    "plan",
                    "buckets",
                    "candidate"
                ])}
            />

            <Return value={$ctx.admit} />
        </Case>

        <Default>
            <Call
                fn="coverage"
                in={$in.pick([
                    "plan",
                    "paths",
                    "types",
                    "values",
                    "buckets"
                ])}
            />

            <Return
                value={{
                    status: $ctx.coverage,
                    capacity: 0
                }}
            />
        </Default>
    </Switch>
</Module>
