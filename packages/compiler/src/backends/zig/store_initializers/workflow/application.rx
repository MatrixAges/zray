<Module>
    <Type from="model" as="Application" />

    <Args in={Application.Input} out={Application.Status} />

    <Call fn="emit" in={$in} />

    <If on={$ctx.emit.status != Application.Status.Ready}>
        <Return value={$ctx.emit.status} />
    </If>

    <Call
        fn="coverage"
        in={{
            ...$in,
            values: $ctx.emit.values
        }}
    />

    <Return value={$ctx.coverage} />
</Module>
