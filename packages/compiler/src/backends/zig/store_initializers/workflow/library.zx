import host from "output_host"

import type { LibraryInitializers } from "output_host"

export type Input = {
    target: LibraryInitializers,
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { target, count } = in

    return loop(0, {
        while: row => row < count,
        next: row => {
            host.emitLibraryInitializer(target, row)
            row += 1
        }
    })
}
