import digest from "../../../../zx/artifact_codec/digest"
import { store_prefix } from "../../publication/const"

export type Initializer = {
    function: u32,
    identity: string,
    schema_version: u32
}

export type Prepared = Initializer & {
    prefix: string,
    digest: string
}

export type Input = Initializer[]

export type Output = Prepared[]

export default function (in: Input): Output {
    return in.map(initializer => ({
        ...initializer,
        prefix: store_prefix,
        digest: digest({
            source: initializer.identity,
            start: 0
        })
    }))[0]
}
