import type { TextColumn } from "memory"

export enum Status {
    Ready,
    DuplicateInitializer,
    MissingInitializer,
    InvalidInitializer
}

export enum Phase {
    Prepare,
    Select,
    Admit,
    Coverage
}

export enum Origin {
    Owned,
    Borrowed,
    Linked
}

export type Plan = {
    count: u64,
    owned: u64,
    source_end: u64,
    linked: u64[],
    expected: u8[][],
    keys: TextColumn
}

export type Request = {
    origin: Origin,
    index: u64
}

export type Candidate = {
    identity: string,
    type_id: u32,
    names: u8[][]
}

export type Input = {
    plan: Plan,
    paths: string[],
    types: u32[],
    phase: Phase,
    row: u64,
    candidate?: Candidate,
    values: u32[],
    buckets: u64[]
}

export type Output = {
    status: Status,
    capacity: u64,
    request?: Request,
    slot?: u64
}

export type Coverage = Input.Pick("plan", "paths", "types", "values", "buckets")
