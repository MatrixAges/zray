import type { TextColumn } from "memory"
import type { ApplicationInitializers } from "output_host"

export enum Status {
    Ready,
    DuplicateInitializer,
    MissingInitializer,
    InvalidInitializer
}

export type Plan = {
    count: u64,
    owned: u64,
    source_end: u64,
    linked: u64[],
    expected: u8[][],
    keys: TextColumn
}

export type Input = {
    target: ApplicationInitializers,
    plan: Plan,
    paths: string[],
    types: u32[]
}

export type Emitted = {
    status: Status,
    values: u32[],
    buckets: u64[]
}

export type Coverage = Input.Omit("target") & Emitted.Omit("status")
