import type { TextColumn, U32Buffer, U64Buffer } from "memory"
import type { ApplicationInitializers } from "output_host"

export enum Status {
    Ready,
    DuplicateInitializer,
    MissingInitializer,
    InvalidInitializer
}

export type Plan = {
    count: u64,
    owned: u64,
    source_end: u64,
    linked: u64[],
    expected: u8[][],
    keys: TextColumn,
    buckets: U64Buffer,
    capacity: u64,
    values: U32Buffer
}

export type Input = {
    target: ApplicationInitializers,
    plan: Plan,
    paths: string[],
    types: u32[]
}
