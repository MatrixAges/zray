import indexSlot from "core/bytes/index/column"
import host from "output_host"
import { InitializerOrigin } from "output_host"

import compatible from "../validation/names"
import { invalid_candidate, duplicate_identity } from "./const"
import { Status } from "./model"

import type { Emitted as Output, Input } from "./model"

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        row: 0,
        values: empty
    }, {
        while: state => state.row < in.plan.count,
        next: state => {
            const { target, plan } = in
            const row = state.row
            const origin = match {
                row < plan.owned => InitializerOrigin.Owned,
                row < plan.source_end => InitializerOrigin.Borrowed,
                _ => InitializerOrigin.Linked
            }
            const index = match origin {
                InitializerOrigin.Owned => row,
                InitializerOrigin.Borrowed => row - plan.owned,
                _ => plan.linked[row - plan.source_end]
            }
            const candidate = host.readApplicationInitializer(target, origin, index)

            if (candidate == null) {
                state.row = invalid_candidate
            } else if (!compatible({
                actual: candidate.names,
                expected: plan.expected
            })) {
                state.row = invalid_candidate
            } else {
                const { identity, type_id } = candidate
                const previous = match {
                    plan.capacity != 0 => indexSlot({
                        ...plan.pick([
                            "keys",
                            "buckets",
                            "capacity"
                        ]),
                        key: identity,
                        insert: row
                    }),
                    _ => null
                }

                if (previous == null) {
                    state.values = state.values.push(type_id)[0]
                    host.emitApplicationInitializer(target, row)
                    state.row += 1
                } else {
                    state.row = duplicate_identity
                }
            }
        },
        return: state => ({
            status: match state.row {
                invalid_candidate => Status.InvalidInitializer,
                duplicate_identity => Status.DuplicateInitializer,
                _ => Status.Ready
            },
            values: state.values
        })
    })
}
