import integers from "std:integer"
import memory from "memory"

import probe from "./index_slots/probe"
import { Status } from "./model"

import type { Indexed } from "./model"

export type Input = {
    initializers: Indexed,
    path: string,
    type_names: string[],
    type_id: u32
}

export type Output = {
    status: Status,
    module_name?: string
}

export default function (in: Input): Output {
    const { initializers, path } = in

    const row = match {
        initializers.buckets.length != 0 => probe({
            keys: initializers.keys,
            buckets: initializers.buckets,
            key: path
        }).row,
        initializers.count == 0 => null,
        memory.readTextColumn(initializers.keys, 0) == path => 0,
        _ => null
    }

    if (row == null) {
        return {
            status: Status.Missing
        }
    }

    const requested = in.type_names[integers.widen(in.type_id)]

    if (memory.readTextColumn(initializers.types, row) != requested) {
        return {
            status: Status.InvalidType
        }
    }

    return {
        status: Status.Found,
        module_name: memory.readTextColumn(initializers.modules, row)
    }
}
