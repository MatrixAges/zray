import capacityFor from "core/bytes/index/fixed_capacity"
import memory from "memory"

import probe from "./index_slots/probe"

import type { TextColumn } from "memory"

export type Input = {
    keys: TextColumn,
    count: u64
}

export type Output = u64[]

export default function (in: Input): Output {
    const capacity = capacityFor(in.count)
    const zero: u64 = 0
    const empty: Output = []

    const buckets = loop({
        items: empty
    }, {
        while: state => state.items.length < capacity,
        next: state => {
            state.items = state.items.push(zero)[0]
        },
        return: state => state.items
    })

    return loop({
        row: 0,
        buckets
    }, {
        while: state => state.row < in.count,
        next: state => {
            const key = memory.readTextColumn(in.keys, state.row)
            const slot = probe({
                keys: in.keys,
                buckets: state.buckets,
                key
            })

            if (slot.row == null) {
                state.buckets[slot.index] = state.row + 1
            }

            state.row += 1
        },
        return: state => state.buckets
    })
}
