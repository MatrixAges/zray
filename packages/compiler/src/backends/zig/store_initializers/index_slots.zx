import exchange from "core/bytes/index/column"
import memory from "memory"

import type { Table } from "core/bytes/index/column"

export type Input = Table & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    if (in.capacity == 0) {
        return
    }

    const position = loop(0, {
        while: row => row < in.count,
        next: row => {
            const previous = exchange({
                keys: in.keys,
                buckets: in.buckets,
                capacity: in.capacity,
                key: memory.readTextColumn(in.keys, row),
                insert: row
            })

            row += 1
        }
    })
}
