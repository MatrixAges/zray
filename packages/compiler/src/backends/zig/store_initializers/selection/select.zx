import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import { Mode } from "./model"
import needed from "./needed"

import type { Candidates, MarkedSearch, Selected as Output } from "./model"

export type Input = {
    candidates: Candidates,
    search: MarkedSearch
}

export default function (in: Input): Output {
    const { candidates, search } = in

    const selected: u64[] = []

    if (search.mode == Mode.Empty) {
        return {
            valid: true,
            indices: selected
        }
    }

    return loop({
        row: 0,
        valid: true,
        indices: selected
    }, {
        while: state => state.valid && state.row < candidates.count,
        next: state => {
            const row = state.row

            if (needed({
                ...search,
                identity: memory.readTextColumn(candidates.keys, row)
            })) {
                const function_id = columns.readColumnU32(candidates.functions, row)
                const index = integers.widen(function_id)
                const modules = candidates.native_modules

                if (
                    index >= candidates.function_count || modules[index] != null
                ) {
                    state.valid = false
                } else {
                    state.indices = state.indices.push(row)[0]
                }
            }

            state.row += 1
        },
        return: state => state.omit(["row"])
    })
}
