import probe from "../index_slots/probe"

import type { Mark as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    if (!in.active || in.count == 0) {
        return []
    }

    const zero: u8 = 0
    const empty: u8[] = []

    const blank = loop({
        position: 0,
        items: empty
    }, {
        while: state => state.position < in.count,
        next: state => {
            state.items = state.items.push(zero)[0]
            state.position += 1
        },
        return: state => state.items
    })

    return loop({
        row: 0,
        found: 0,
        marks: blank
    }, {
        while: state => state.row < in.paths.length && state.found < in.count,
        next: state => {
            const entry = probe({
                ...in.index,
                key: in.paths[state.row]
            }).row

            if (entry != null && state.marks[entry] == 0) {
                state.marks[entry] = 1
                state.found += 1
            }

            state.row += 1
        },
        return: state => state.marks
    })
}
