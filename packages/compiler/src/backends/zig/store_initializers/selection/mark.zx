import lookup from "core/bytes/index/column"
import memory from "memory"

import type { Mark as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const result = loop({
        row: 0,
        found: 0
    }, {
        while: state => state.row < in.paths.length && state.found < in.count,
        next: state => {
            const entry = lookup({
                ...in.index,
                key: in.paths[state.row]
            })

            if (entry != null && memory.readU8(in.marks, entry) == 0) {
                memory.writeU8(in.marks, entry, 1)
                state.found += 1
            }

            state.row += 1
        }
    })
}
