import type { Table } from "core/bytes/index/column"
import type { TextColumn } from "memory"
import type { ReadColumn } from "memory/columns"

export enum Mode {
    Empty,
    Scan,
    Paths,
    Candidates
}

export type Counts = {
    initializers: u64,
    paths: u64
}

export type Strategy = {
    mode: Mode,
    indexed: u64,
    marks: u64
}

export type Candidates = {
    keys: TextColumn,
    functions: ReadColumn,
    count: u64,
    function_count: u64,
    native_modules: u32?[]
}

export type Search = {
    paths: string[],
    index: Table,
    mode: Mode
}

export type MarkedSearch = Search & {
    marks: u8[]
}

export type Sources = {
    owned: u64,
    borrowed: u64,
    files: u64,
    maximum: u64
}

export type Input = {
    candidates: Candidates,
    search: Search,
    indexed: u64,
    sources: Sources
}

export type Selected = {
    valid: bool,
    indices: u64[]
}

export type Mark = Search.Omit("mode") & {
    count: u64,
    active: bool
}

export enum Status {
    Ready,
    Invalid,
    Overflow
}

export type Output = {
    status: Status,
    indices: u64[],
    source_end: u64,
    count: u64,
    file_count: u64
}
