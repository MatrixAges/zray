<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Output} />

    <If on={$in.indexed != 0}>
        <Call
            fn="../index_slots"
            in={{
                ...$in.search.index,
                count: $in.indexed
            }}
        />
    </If>

    <Call
        fn="mark"
        in={{
            paths: $in.search.paths,
            index: $in.search.index,
            count: $in.indexed,
            active: $in.search.mode == Selection.Mode.Candidates
        }}
    />

    <Call
        fn="select"
        in={{
            candidates: $in.candidates,
            search: {
                ...$in.search,
                marks: $ctx.mark
            }
        }}
    />

    <Call
        fn="layout"
        in={{
            sources: $in.sources,
            selected: $ctx.select
        }}
    />

    <Return value={$ctx.layout} />
</Module>
