<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Output} />

    <If on={$in.indexed != 0}>
        <Call
            fn="../index_slots"
            in={{
                ...$in.search.index,
                count: $in.indexed
            }}
        />
    </If>

    <If on={$in.search.mode == Selection.Mode.Candidates}>
        <Call
            fn="mark"
            in={{
                ...$in.search.omit(["mode"]),
                count: $in.indexed
            }}
        />
    </If>

    <Call
        fn="select"
        in={$in.pick([
            "candidates",
            "search"
        ])}
    />

    <Call
        fn="layout"
        in={{
            sources: $in.sources,
            selected: $ctx.select
        }}
    />

    <Return value={$ctx.layout} />
</Module>
