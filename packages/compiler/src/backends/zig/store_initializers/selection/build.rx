<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Output} />

    <Call
        fn="../index_slots"
        in={{
            keys: $in.search.keys,
            count: $in.indexed
        }}
    />

    <Call
        fn="mark"
        in={{
            paths: $in.search.paths,
            index: {
                keys: $in.search.keys,
                buckets: $ctx.index_slots
            },
            count: $in.indexed,
            active: $in.search.mode == Selection.Mode.Candidates
        }}
    />

    <Call
        fn="select"
        in={{
            candidates: $in.candidates,
            search: {
                paths: $in.search.paths,
                mode: $in.search.mode,
                index: {
                    keys: $in.search.keys,
                    buckets: $ctx.index_slots
                },
                marks: $ctx.mark
            }
        }}
    />

    <Call
        fn="layout"
        in={{
            sources: $in.sources,
            selected: $ctx.select
        }}
    />

    <Return value={$ctx.layout} />
</Module>
