import probe from "../index_slots/probe"
import { Mode } from "./model"

import type { MarkedSearch } from "./model"

export type Input = MarkedSearch & {
    identity: string
}

export type Output = bool

export default function (in: Input): Output {
    if (in.mode == Mode.Scan) {
        return loop({
            row: 0,
            found: false
        }, {
            while: state => !state.found && state.row < in.paths.length,
            next: state => {
                state.found = in.paths[state.row] == in.identity
                state.row += 1
            },
            return: state => state.found
        })
    }

    const row = probe({
        ...in.index,
        key: in.identity
    }).row

    if (row == null) {
        return false
    }

    return in.mode == Mode.Paths || in.marks[row] != 0
}
