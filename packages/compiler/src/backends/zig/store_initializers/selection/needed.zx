import lookup from "core/bytes/index/column"
import memory from "memory"

import { Mode } from "./model"

import type { Search } from "./model"

export type Input = Search & {
    identity: string
}

export type Output = bool

export default function (in: Input): Output {
    if (in.mode == Mode.Scan) {
        return loop({
            row: 0,
            found: false
        }, {
            while: state => !state.found && state.row < in.paths.length,
            next: state => {
                state.found = in.paths[state.row] == in.identity
                state.row += 1
            },
            return: state => state.found
        })
    }

    const row = lookup({
        ...in.index,
        key: in.identity
    })

    if (row == null) {
        return false
    }

    return in.mode == Mode.Paths || memory.readU8(in.marks, row) != 0
}
