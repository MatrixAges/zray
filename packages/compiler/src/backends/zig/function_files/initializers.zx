import memory from "memory"

import type { File, FileList as Output, Initializers } from "./model"

export type Input = {
    source: Initializers,
    files: File[]
}

export default function (in: Input): Output {
    const { source } = in

    return loop({
        row: 0,
        files: in.files
    }, {
        while: state => state.row < source.count,
        next: state => {
            const { row } = state

            state.files = state.files.push({
                name: memory.readTextColumn(source.names, row),
                source: memory.readTextColumn(source.sources, row),
                imports: memory.readTextListColumn(source.imports, row)
            })[0]
            state.row += 1
        },
        return: state => state.files
    })
}
