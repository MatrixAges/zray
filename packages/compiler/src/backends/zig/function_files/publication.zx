import bytes from "std:bytes"
import integers from "std:integer"
import imports from "genz/reference_imports"
import memory from "memory"
import columns from "memory/columns"

import type { Assembly } from "./model"

export type Input = Assembly & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { registry, functions, target, destination } = in

    columns.allocateRowsWithAllocator(
        destination.owner,
        in.storage,
        in.count + in.initializers.count
    )

    const published = loop(0, {
        while: row => row < in.count,
        next: row => {
            const position = memory.readU64(registry.selected, row)
            const id = integers.widen(memory.readColumnU32(registry.ids, position))
            const native = in.native_ids[id]
            const dependencies = match {
                native != null =>
                    memory.borrowStringRange(
                        in.native_names,
                        integers.widen(native),
                        1
                    ),
                _ => imports({
                    expressions: functions.expressions[id],
                    contracts: functions.contracts[id],
                    names: in.names,
                    members: [],
                    destination,
                    native: null
                })
            }

            memory.writeColumnBytes(
                target.name,
                row,
                bytes.fromText(in.names[id])
            )
            memory.writeColumnBytes(
                target.source,
                row,
                registry.sources[position]
            )
            columns.writeColumnTextList(target.imports, row, dependencies)
            row += 1
        }
    })
}
