<Module>
    <Type from="model" as="Files" />

    <Args in={Files.Publication} out={void} />

    <Call
        fn="columns.allocateRows"
        in={{
            owner: $in.destination.owner,
            target: $in.storage,
            count: $in.count + $in.initializers.count
        }}
    />

    <Loop on={$in.running}>
        <Call
            module="publish_next"
            in={{
                source: $in,
                row: 0,
                running: $in.count != 0
            }}
        />
    </Loop>
</Module>
