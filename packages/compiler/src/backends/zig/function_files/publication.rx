<Module>
    <Type from="model" as="Files" />

    <Args in={Files.Publication} out={Files.FileList} />

    <If on={$in.selected.length == 0}>
        <Return value={[]} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="publish_next"
            in={{
                source: $in,
                row: 0,
                running: true,
                files: []
            }}
        />
    </Loop>

    <Return value={$ctx.publish_next.files} />
</Module>
