import bytes from "std:bytes"
import integers from "std:integer"
import probe from "core/bytes/index/slot"
import memory from "memory"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    return loop({
        valid: true,
        count: 0,
        index: 0
    }, {
        while: current => current.valid && current.index < in.sources.length,
        next: current => {
            const { index } = current
            const id = memory.readColumnU32(in.ids, index)
            const found = probe({
                ...in.pick([
                    "keys",
                    "buckets",
                    "capacity"
                ]),
                rows: in.ids,
                key: in.keys[integers.widen(id)]
            })

            if (found.entry == 0) {
                memory.writeU64(in.buckets, found.slot, index + 1)
                memory.writeU64(in.selected, current.count, index)
                current.count += 1
            } else {
                current.valid =
                    bytes.equals(in.sources[found.entry - 1], in.sources[index])
            }

            current.index += 1
        },
        return: current => {
            valid: current.valid,
            count: current.count
        }
    })
}
