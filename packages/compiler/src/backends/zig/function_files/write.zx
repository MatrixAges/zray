import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import type { Write as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { source, selected, row, dependencies } = in
    const { registry, target } = source

    memory.writeColumnBytes(
        target.name,
        row,
        bytes.fromText(source.names[selected.id])
    )

    memory.writeColumnBytes(target.source, row, registry.sources[selected.position])
    columns.writeColumnTextList(target.imports, row, dependencies)
}
