import integers from "std:integer"
import memory from "memory"

import type { Selected as Output, Traversal as Input } from "./model"

export default function (in: Input): Output {
    const { registry, native_ids } = in.source

    const position = in.source.selected[in.row]
    const id = integers.widen(memory.readColumnU32(registry.ids, position))
    const native = native_ids[id]

    return {
        id,
        position,
        native: native == null ? null : integers.widen(native)
    }
}
