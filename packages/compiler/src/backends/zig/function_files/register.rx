<Module>
    <Type from="model" as="Files" />

    <Args in={Files.Assembly} out={Files.Result} />

    <Call fn="collect" in={$in.registry} />

    <If on={!$ctx.collect.valid}>
        <Return
            value={{
                valid: false,
                files: []
            }}
        />
    </If>

    <Call
        module="publication"
        in={{
            ...$in,
            selected: $ctx.collect.selected
        }}
    />

    <If on={$in.initializers.count != 0}>
        <Call
            fn="initializers"
            in={{
                source: $in.initializers,
                files: $ctx.publication
            }}
        />

        <Return
            value={{
                valid: true,
                files: $ctx.initializers
            }}
        />
    </If>

    <Return
        value={{
            valid: true,
            files: $ctx.publication
        }}
    />
</Module>
