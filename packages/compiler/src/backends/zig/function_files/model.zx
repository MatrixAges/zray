import type { Table } from "core/bytes/index/fixed"
import type { Destination, Functions } from "genz/reference_model"
import type { ReadColumn, TextColumn, U64Buffer, WriteColumn } from "memory"
import type { RowBuffer, WriteColumn as ListColumn } from "memory/columns"

export type Input = Table & {
    ids: ReadColumn,
    sources: u8[][],
    selected: U64Buffer
}

export type Output = {
    valid: bool,
    count: u64
}

export type Target = {
    name: WriteColumn,
    source: WriteColumn,
    imports: ListColumn
}

export type Initializers = {
    names: TextColumn,
    sources: TextColumn,
    imports: ReadColumn,
    count: u64
}

export type Assembly = {
    registry: Input,
    initializers: Initializers,
    functions: Functions,
    names: string[],
    native_ids: u32?[],
    native_names: string[],
    destination: Destination,
    storage: RowBuffer,
    target: Target
}

export type Publication = Assembly & {
    count: u64
}

export type Traversal = {
    source: Publication,
    row: u64,
    running: bool
}

export type Selected = {
    id: u64,
    position: u64,
    native?: u64
}

export type Write = {
    source: Publication,
    selected: Selected,
    row: u64,
    dependencies: string[]
}

export type Dependencies = Write.Pick("source", "selected")
