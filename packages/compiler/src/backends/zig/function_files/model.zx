import type { Destination, Functions } from "genz/reference_model"
import type { ReadColumn, TextColumn } from "memory"

export type File = {
    name: string,
    source: string,
    imports: string[]
}

export type FileList = File[]

export type Input = {
    keys: string[],
    ids: ReadColumn,
    sources: string[],
    capacity: u64
}

export type Output = {
    valid: bool,
    selected: u64[]
}

export type Result = {
    valid: bool,
    files: File[]
}

export type Initializers = {
    names: TextColumn,
    sources: TextColumn,
    imports: ReadColumn,
    count: u64
}

export type Assembly = {
    registry: Input,
    initializers: Initializers,
    functions: Functions,
    names: string[],
    native_ids: u32?[],
    native_names: string[],
    destination: Destination
}

export type Publication = Assembly & {
    selected: u64[]
}

export type Traversal = {
    source: Publication,
    row: u64,
    running: bool,
    files: File[]
}

export type Selected = {
    id: u64,
    position: u64,
    native?: u64
}

export type Write = {
    source: Publication,
    selected: Selected,
    files: File[],
    dependencies: string[]
}

export type Dependencies = Write.Pick("source", "selected")
