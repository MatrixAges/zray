import memory from "memory"

import { zig_suffix } from "./const"

import type { File, Module, Public, PublicOutput } from "./model"

export type Input = Public

export type Output = PublicOutput

export default function (in: Input): Output {
    const empty_adapters: string[] = []
    const empty_files: File[] = []
    const empty_modules: Module[] = []

    return loop({
        index: 0,
        adapters: empty_adapters,
        public_files: empty_files,
        modules: empty_modules
    }, {
        while: state => state.index < in.count,
        next: state => {
            const index = state.index
            const source = memory.readTextColumn(in.bodies, index)
            const stem = memory.readTextColumn(in.paths, index)
            const name = memory.readTextColumn(in.names, index)
            const path = `${stem}${zig_suffix}`
            const adapter = `${name}${zig_suffix}`

            state.adapters = state.adapters.push(adapter)[0]
            state.public_files = state.public_files.push({
                path,
                source
            })[0]
            state.modules = state.modules.push({
                name,
                file: path
            })[0]
            state.index += 1
        },
        return: state => state.pick([
            "adapters",
            "public_files",
            "modules"
        ])
    })
}
