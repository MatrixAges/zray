import bytes from "std:bytes"
import memory from "memory"

import { zig_suffix } from "./const"

import type { Input as Assembly } from "./model"

export type Input = Assembly.Pick("sections", "public", "files", "modules")

export type Output = void

export default function (in: Input): Output {
    const { files, modules, sections } = in

    const written = loop(0, {
        while: index => index < in.public.count,
        next: index => {
            const source = memory.readTextColumn(in.public.bodies, index)
            const stem = memory.readTextColumn(in.public.paths, index)
            const name = memory.readTextColumn(in.public.names, index)
            const path = bytes.fromText(`${stem}${zig_suffix}`)
            const adapter = `${name}${zig_suffix}`
            const target = sections.public_files + index

            memory.writeColumnBytes(files.paths, target, path)
            memory.writeColumnBytes(files.bodies, target, bytes.fromText(source))
            memory.writeColumnBytes(
                files.paths,
                sections.adapters + index,
                bytes.fromText(adapter)
            )
            memory.writeColumnBytes(modules.names, index, bytes.fromText(name))
            memory.writeColumnBytes(modules.files, index, path)

            index += 1
        }
    })
}
