import memory from "memory"

import type { File, Sources } from "./model"

export type Input = Sources

export type Output = File[]

export default function (in: Input): Output {
    const empty: File[] = []

    return loop({
        index: 0,
        files: empty
    }, {
        while: state => state.index < in.count,
        next: state => {
            const index = state.index
            const path = memory.readTextColumn(in.paths, index)
            const source = memory.readTextColumn(in.bodies, index)

            state.files = state.files.push({
                path,
                source
            })[0]
            state.index += 1
        },
        return: state => state.files
    })
}
