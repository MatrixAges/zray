import type { TextColumn } from "memory"

export type Counts = {
    public_count: u64,
    support_count: u64,
    function_count: u64,
    partitioned: bool
}

export type Sections = {
    adapters: u64,
    support: u64,
    public_files: u64,
    signatures: u64,
    originals: u64,
    original_root: u64,
    root: u64,
    length: u64
}

export type Sources = {
    paths: TextColumn,
    bodies: TextColumn,
    count: u64
}

export type Public = Sources & {
    names: TextColumn
}

export type File = {
    path: string,
    source: string
}

export type Module = {
    name: string,
    file: string
}

export type Headers = {
    types_file: File,
    root_path: string
}

export type Partition = {
    signatures_file: File,
    original_root_path: string
}

export type PublicOutput = {
    adapters: string[],
    public_files: File[],
    modules: Module[]
}

export type Input = {
    partitioned: bool,
    public: Public,
    support: Sources,
    types: string,
    signatures: string
}

export type Output = {
    types_file: File,
    root_path: string,
    adapters: string[],
    public_files: File[],
    modules: Module[],
    support: File[],
    signatures_file?: File,
    original_root_path?: string
}
