import bytes from "std:bytes"
import memory from "memory"

import { hash_batch } from "./const"

import type { Hash } from "../parallel/model"

export type Input = {
    plan: Hash,
    block: u64
}

export type Output = void

export default function (in: Input): Output {
    const { plan, block } = in
    const { head, functions } = plan.sections
    const { names, hashes, head_blocks } = plan

    const in_head = block < head_blocks
    const source = in_head ? head : functions
    const local = in_head ? block : block - head_blocks
    const offset = in_head ? 0 : head.count
    const first = local * hash_batch
    const remaining = source.count - first
    const end = first + (remaining < hash_batch ? remaining : hash_batch)

    const written = loop(first, {
        while: row => row < end,
        next: row => {
            const path = memory.readTextColumn(source.paths, row)
            const body = memory.readTextColumn(source.bodies, row)
            const target = offset + row

            memory.writeString(names, target, path)
            memory.writeU64(hashes, target, bytes.hash(bytes.fromText(body)))

            row += 1
        }
    })
}
