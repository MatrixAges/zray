import bytes from "std:bytes"
import memory from "memory"

import { hash_batch } from "./const"

import type { Hash, Marked } from "../parallel/model"

export type Input = {
    plan: Hash,
    block: u64
}

export type Output = Marked

export default function (in: Input): Output {
    const { plan, block } = in
    const { head, functions } = plan.sections
    const { head_blocks } = plan

    const in_head = block < head_blocks
    const source = in_head ? head : functions
    const local = in_head ? block : block - head_blocks
    const offset = in_head ? 0 : head.count
    const first = local * hash_batch
    const remaining = source.count - first
    const end = first + (remaining < hash_batch ? remaining : hash_batch)
    const empty_paths: string[] = []
    const empty_hashes: u64[] = []

    return loop({
        row: first,
        paths: empty_paths,
        hashes: empty_hashes
    }, {
        while: state => state.row < end,
        next: state => {
            const path = memory.readTextColumn(source.paths, state.row)
            const body = memory.readTextColumn(source.bodies, state.row)

            state.paths = state.paths.push(path)[0]
            state.hashes =
                state.hashes.push(bytes.hash(bytes.fromText(body)))[0]
            state.row += 1
        },
        return: state => ({
            offset: offset + first,
            paths: state.paths,
            hashes: state.hashes
        })
    })
}
