<Module>
    <Type from="model" as="Assembly" />

    <Args in={Assembly.Input} out={void} />

    <Call
        fn="headers"
        in={{
            sections: $in.sections,
            files: $in.files,
            types: $in.types
        }}
    />

    <Call
        fn="public_files"
        in={{
            sections: $in.sections,
            public: $in.public,
            files: $in.files,
            modules: $in.modules
        }}
    />

    <Call
        fn="support"
        in={{
            sections: $in.sections,
            support: $in.support,
            files: $in.files
        }}
    />

    <If on={$in.partitioned}>
        <Call
            fn="partition"
            in={{
                sections: $in.sections,
                files: $in.files,
                signatures: $in.signatures
            }}
        />
    </If>
</Module>
