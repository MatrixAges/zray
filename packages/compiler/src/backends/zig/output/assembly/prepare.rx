<Module>
    <Type from="model" as="Assembly" />

    <Args in={Assembly.Input} out={Assembly.Output} />

    <Call fn="headers" in={$in.types} />
    <Call fn="public_files" in={$in.public} />
    <Call fn="support" in={$in.support} />

    <If on={$in.partitioned}>
        <Call fn="partition" in={$in.signatures} />

        <Return
            value={{
                ...$ctx.headers,
                ...$ctx.public_files,
                support: $ctx.support,
                signatures_file: $ctx.partition.signatures_file,
                original_root_path: $ctx.partition.original_root_path
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.headers,
            ...$ctx.public_files,
            support: $ctx.support,
            signatures_file: null,
            original_root_path: null
        }}
    />
</Module>
