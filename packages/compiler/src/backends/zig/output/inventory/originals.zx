import bytes from "std:bytes"
import path from "std:path"
import memory from "memory"

import { original_directory } from "../const"

import type { Originals as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const prefix = `${original_directory}${in.separator}`

    const completed = loop(0, {
        while: row => row < in.length,
        next: row => {
            const file = memory.readTextColumn(in.names, row)
            const source = memory.readTextColumn(in.bodies, row)
            const base = path.basename(file)
            const size = base.length - path.extname(file).length
            const name = memory.borrowTextRange(base, 0, size)
            const target = `${prefix}${file}`

            memory.writeColumnBytes(in.root_names, row, bytes.fromText(name))
            memory.writeColumnBytes(in.root_paths, row, bytes.fromText(file))
            memory.writeColumnBytes(in.paths, row, bytes.fromText(target))
            memory.writeColumnBytes(in.sources, row, bytes.fromText(source))
            row += 1
        }
    })
}
