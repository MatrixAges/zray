import type { TextColumn } from "memory"

export type Input = {
    names: TextColumn,
    bodies: TextColumn,
    length: u64
}

export type File = {
    path: string,
    source: string
}

export type Grouped = {
    functions: File[],
    support: File[]
}

export type Originals = Input & {
    separator: string
}

export type OriginalsOutput = {
    files: File[],
    paths: string[],
    names: string[],
    sizes: u64[]
}
