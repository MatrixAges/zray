import type { StringBuffer, TextColumn, U64Buffer, WriteColumn } from "memory"

export type Input = {
    names: TextColumn,
    bodies: TextColumn,
    paths: WriteColumn,
    sources: WriteColumn,
    length: u64
}

export type Count = Input.Pick("names", "length")

export type Split = Input & {
    functions: u64
}

export type Originals = Input & {
    separator: string,
    function_paths: StringBuffer,
    function_names: StringBuffer,
    function_sizes: U64Buffer
}
