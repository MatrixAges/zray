import bytes from "std:bytes"
import memory from "memory"

import isFunction from "./is_function"

import type { Split as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    return loop({
        row: 0,
        function_row: 0,
        support_row: in.functions
    }, {
        while: state => state.row < in.length,
        next: state => {
            const name = memory.readTextColumn(in.names, state.row)
            const source = memory.readTextColumn(in.bodies, state.row)
            const function_file = isFunction(name)

            const target = function_file ? state.function_row : state.support_row

            memory.writeColumnBytes(in.paths, target, bytes.fromText(name))
            memory.writeColumnBytes(in.sources, target, bytes.fromText(source))

            if (function_file) {
                state.function_row += 1
            } else {
                state.support_row += 1
            }

            state.row += 1
        },
        return: state => state.function_row
    })
}
