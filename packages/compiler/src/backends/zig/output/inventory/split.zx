import memory from "memory"

import isFunction from "./is_function"

import type { File, Grouped, Input } from "./model"

export type Output = Grouped

export default function (in: Input): Output {
    const empty: File[] = []

    return loop({
        row: 0,
        functions: empty,
        support: empty
    }, {
        while: state => state.row < in.length,
        next: state => {
            const path = memory.readTextColumn(in.names, state.row)
            const source = memory.readTextColumn(in.bodies, state.row)
            const file: File = {
                path,
                source
            }

            if (isFunction(path)) {
                state.functions = state.functions.push(file)[0]
            } else {
                state.support = state.support.push(file)[0]
            }

            state.row += 1
        },
        return: state => state.pick([
            "functions",
            "support"
        ])
    })
}
