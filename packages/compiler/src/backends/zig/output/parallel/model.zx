import type { Index } from "core/bytes/index/model"
import type { TextColumn } from "memory"
import type { BatchOutput } from "../../partition/scanning/model"
import type { Sources } from "../assembly/model"

export type Sections = {
    head: Sources,
    functions: Sources
}

export type Scan = {
    sources: TextColumn,
    index: Index,
    length: u64
}

export type Scanned = BatchOutput & {
    offset: u64
}

export type Hash = {
    sections: Sections,
    head_blocks: u64
}

export type Marked = {
    offset: u64,
    paths: string[],
    hashes: u64[]
}

export type Write = {
    sections: Sections,
    changed: u32[]
}

export type File = {
    path: string,
    body: string
}

export type Work = {
    count: u64,
    scan?: Scan,
    hash?: Hash,
    write?: Write
}
