import type { ReadColumn, StringBuffer, U64Buffer } from "memory"
import type {
    BootstrapPartitionJobs,
    BootstrapPartitionScan,
    BootstrapWriter
} from "output_host"
import type { Sources } from "../assembly/model"

export type Sections = {
    head: Sources,
    functions: Sources
}

export type Scan = {
    target: BootstrapPartitionScan,
    length: u64
}

export type Render = {
    target: BootstrapPartitionJobs,
    roots: ReadColumn
}

export type Hash = {
    sections: Sections,
    head_blocks: u64,
    names: StringBuffer,
    hashes: U64Buffer
}

export type Write = {
    sections: Sections,
    changed: u32[],
    target: BootstrapWriter
}

export type Work = {
    count: u64,
    scan?: Scan,
    render?: Render,
    hash?: Hash,
    write?: Write
}
