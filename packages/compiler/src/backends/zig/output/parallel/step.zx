import integers from "std:integer"
import memory from "memory"

import render from "../../partition/emission/render"
import scanBatch from "../../partition/scanning/batch"
import { batch_size } from "../../partition/scanning/const"
import mark from "../assembly/mark"

import type {
    File as PartitionFile,
    Input as Render
} from "../../partition/emission/render"
import type { File, Marked, Scanned, Work } from "./model"

export type Input = {
    jobs: Work,
    row: u64,
    render?: Render
}

export type Output = {
    marked?: Marked,
    scanned?: Scanned,
    file?: File,
    partition?: PartitionFile[]
}

export default function (in: Input): Output {
    const { jobs, row } = in
    const { scan, hash, write } = jobs

    const rendering = in.render

    if (hash != null) {
        return {
            marked: mark({
                plan: hash,
                block: row
            })
        }
    }

    if (rendering != null) {
        return {
            partition: render(rendering)
        }
    }

    if (scan != null) {
        const first = row * batch_size
        const remaining = scan.length - first
        const end = first + (remaining < batch_size ? remaining : batch_size)

        const batch = scanBatch({
            sources: scan.sources,
            index: scan.index,
            first,
            end,
            need_inline_names: true
        })

        return {
            scanned: {
                ...batch,
                offset: first
            }
        }
    }

    if (write == null) {
        return {
            marked: null
        }
    }

    const { head, functions } = write.sections

    const selected = integers.widen(write.changed[row])
    const in_head = selected < head.count
    const source = in_head ? head : functions
    const index = in_head ? selected : selected - head.count
    const path = memory.readTextColumn(source.paths, index)
    const body = memory.readTextColumn(source.bodies, index)

    return {
        file: {
            path,
            body
        }
    }
}
