<Module>
    <Type from="model" as="Mirror" />

    <Args in={Mirror.Trimming} out={string[]} />

    <Call fn="../../path_index" in={$in.paths} />

    <If on={$in.previous_paths != null}>
        <Call
            fn="trim"
            in={{
                index: $ctx.path_index,
                files: $in.previous_paths,
                preserve_fingerprint: false
            }}
        />

        <Return value={$ctx.trim} />
    </If>

    <Call fn="host.listBootstrapFiles" in={$in.target} />

    <Call
        fn="trim"
        in={{
            index: $ctx.path_index,
            files: $ctx.listBootstrapFiles,
            preserve_fingerprint: true
        }}
    />

    <Return value={$ctx.trim} />
</Module>
