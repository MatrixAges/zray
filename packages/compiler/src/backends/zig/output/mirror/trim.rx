<Module>
    <Type from="model" as="Mirror" />

    <Args in={Mirror.Trimming} out={string[]} />

    <Call fn="../../path_index" in={$in.paths} />

    <Call
        fn="trim"
        in={{
            index: $ctx.path_index,
            ...$in.omit(["paths"])
        }}
    />

    <Return value={$ctx.trim} />
</Module>
