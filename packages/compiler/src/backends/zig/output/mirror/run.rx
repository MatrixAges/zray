<Module>
    <Type from="model" as="Mirror" />

    <Args in={Mirror.Input} out={Mirror.Output} />

    <If on={$in.trimming != null}>
        <Call
            module="trim"
            in={{
                ...$in.trimming,
                paths: $in.path_bytes
            }}
        />

        <Return
            value={{
                folders: [],
                changed: [],
                prune: Mirror.Prune.None,
                stale: $ctx.trim
            }}
        />
    </If>

    <Call
        fn="../select"
        in={{
            paths: $in.path_bytes,
            ...$in.pick([
                "hashes",
                "previous_hashes",
                "present"
            ]),
            previous_paths: $in.previous_bytes
        }}
    />

    <Call
        fn="prune"
        in={{
            aligned: $ctx.select.aligned,
            present: $in.present
        }}
    />

    <If on={$ctx.select.changed.length != 0}>
        <Call
            fn="../parents"
            in={{
                paths: $in.paths,
                changed: $ctx.select.changed
            }}
        />

        <Return
            value={{
                folders: $ctx.parents,
                changed: $ctx.select.changed,
                prune: $ctx.prune,
                stale: []
            }}
        />
    </If>

    <Return
        value={{
            folders: [],
            changed: [],
            prune: $ctx.prune,
            stale: []
        }}
    />
</Module>
