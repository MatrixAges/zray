<Module>
    <Type from="model" as="Mirror" />

    <Args in={Mirror.Input} out={void} />

    <Call fn="host.hashBootstrapFiles" in={$in.target} />
    <Call fn="host.compareBootstrapFiles" in={$in.target} />

    <If on={$ctx.compareBootstrapFiles.changed.length != 0}>
        <Call fn="create_parents" in={$ctx.compareBootstrapFiles} />
        <Call fn="host.writeBootstrapChanges" in={$in.target} />
    </If>

    <If on={!$ctx.compareBootstrapFiles.aligned}>
        <Call
            fn="trim"
            in={{
                plan: $ctx.compareBootstrapFiles,
                cleanup: $in.cleanup
            }}
        />
    </If>

    <Call fn="host.commitBootstrapManifest" in={$in.target} />
</Module>
