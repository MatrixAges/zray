<Module>
    <Type from="model" as="Mirror" />

    <Args in={Mirror.Input} out={void} />

    <Call fn="host.hashBootstrapFiles" in={$in.target} />

    <Call
        fn="../select"
        in={{
            paths: $ctx.hashBootstrapFiles.path_bytes,
            hashes: $ctx.hashBootstrapFiles.hashes,
            previous_paths: $in.previous_bytes,
            previous_hashes: $in.previous_hashes,
            present: $in.previous_paths != null
        }}
    />

    <If on={$ctx.select.changed.length != 0}>
        <Call
            fn="../parents"
            in={{
                paths: $ctx.hashBootstrapFiles.paths,
                changed: $ctx.select.changed
            }}
        />

        <Call
            fn="host.createBootstrapFolders"
            in={[
                $in.target,
                $ctx.parents
            ]}
        />

        <Call
            fn="host.writeBootstrapChanges"
            in={[
                $in.target,
                $ctx.select.changed
            ]}
        />
    </If>

    <If on={!$ctx.select.aligned}>
        <Call
            module="trim"
            in={{
                target: $in.target,
                paths: $ctx.hashBootstrapFiles.path_bytes,
                previous_paths: $in.previous_paths
            }}
        />

        <Call
            fn="host.deleteBootstrapFiles"
            in={[
                $in.target,
                $ctx.trim
            ]}
        />
    </If>

    <Call fn="host.commitBootstrapManifest" in={$in.target} />
</Module>
