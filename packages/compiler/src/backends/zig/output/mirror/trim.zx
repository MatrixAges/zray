import integers from "std:integer"
import memory from "memory"
import host from "output_host"

import pathIndex from "../../path_index"
import staleRows from "../stale_rows"
import unrecorded from "./unrecorded"

import type { U8ListBuffer } from "memory"
import type { Plan } from "./model"

export type Input = {
    plan: Plan,
    paths: U8ListBuffer
}

export type Output = void

export default function (in: Input): Output {
    const { plan, paths } = in

    const index = pathIndex(memory.u8ListViews(paths))

    const { previous_paths, target } = plan

    if (previous_paths != null) {
        const stale = staleRows({
            index,
            paths: previous_paths
        })

        const recorded = loop(0, {
            while: row => row < stale.length,
            next: row => {
                host.deleteBootstrapFile(
                    target,
                    previous_paths[integers.widen(stale[row])]
                )

                row += 1
            }
        })

        return
    }

    const files = host.listBootstrapFiles(target)

    const stale = unrecorded({
        files,
        index
    })

    const removed = loop(0, {
        while: row => row < stale.length,
        next: row => {
            host.deleteBootstrapFile(target, stale[row])

            row += 1
        }
    })
}
