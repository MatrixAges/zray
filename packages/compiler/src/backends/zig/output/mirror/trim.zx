import bytes from "std:bytes"

import { stamp_name } from "../../../../inputs/generation/const"
import stale from "../stale"

import type { Index } from "core/bytes/index/model"

export type Input = {
    files: string[],
    index: Index,
    preserve_fingerprint: bool
}

export type Output = string[]

export default function (in: Input): Output {
    const fingerprint = bytes.fromText(stamp_name)
    const paths: string[] = []

    return loop({
        index: 0,
        paths
    }, {
        while: state => state.index < in.files.length,
        next: state => {
            const path = in.files[state.index]

            const selected = stale({
                index: in.index,
                path: bytes.fromText(path),
                fingerprint,
                preserve_fingerprint: in.preserve_fingerprint
            })

            if (selected) {
                state.paths = state.paths.push(path)[0]
            }

            state.index += 1
        },
        return: state => state.paths
    })
}
