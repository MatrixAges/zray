<Module>
    <Type from="model" as="Tree" />

    <Args in={Tree.Input} out={Tree.Output} />

    <If on={$in.partitioned}>
        <Return
            value={[
                Tree.Step.Adapters,
                Tree.Step.Originals,
                Tree.Step.PartitionedRoot,
                Tree.Step.Place
            ]}
        />
    </If>

    <Return
        value={[
            Tree.Step.Adapters,
            Tree.Step.Root
        ]}
    />
</Module>
