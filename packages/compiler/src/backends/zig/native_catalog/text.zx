import bytes from "std:bytes"
import memory from "memory"

import type { Text } from "./model"

export type Input = {
    target: Text,
    start: u64,
    name: string
}

export type Output = string

export default function (in: Input): Output {
    const { target, start, name } = in

    const length =
        memory.copyBytes(target.bytes, start, bytes.fromText(name), 0, name.length)

    return memory.borrowTextRange(target.data, start, length)
}
