import type { Names as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    return loop({
        index: 0,
        size: 0
    }, {
        while: state => state.index < in.specifiers.length,
        next: state => {
            const { index } = state

            state.size += in.specifiers[index].length
            state.size += in.import_names[index].length

            const identity = in.identities[index]

            if (identity != null) {
                state.size += identity.length
            }

            state.index += 1
        },
        return: state => state.size
    })
}
