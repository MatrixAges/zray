import type { Names as Input, Packed as Output } from "./model"

export default function (in: Input): Output {
    const data: u8[] = []
    const specifier_lens: u64[] = []
    const import_lens: u64[] = []
    const identity_lens: u64?[] = []

    return loop({
        index: 0,
        data,
        specifier_lens,
        import_lens,
        identity_lens
    }, {
        while: state => state.index < in.specifiers.length,
        next: state => {
            const { index } = state
            const specifier = in.specifiers[index]
            const imported = in.import_names[index]
            const identity = in.identities[index]

            state.data = state.data.concatText(specifier)[0]
            state.data = state.data.concatText(imported)[0]
            state.specifier_lens = state.specifier_lens.push(specifier.length)[0]
            state.import_lens = state.import_lens.push(imported.length)[0]

            if (identity != null) {
                state.data = state.data.concatText(identity)[0]
                state.identity_lens = state.identity_lens.push(identity.length)[0]
            } else {
                state.identity_lens = state.identity_lens.push(null)[0]
            }

            state.index += 1
        },
        return: state => ({
            data: state.data,
            specifier_lens: state.specifier_lens,
            import_lens: state.import_lens,
            identity_lens: state.identity_lens
        })
    })
}
