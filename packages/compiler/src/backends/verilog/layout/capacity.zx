import bytes from "std:bytes"

import {
    wire_width,
    wire_index,
    wire_assign,
    expression_start,
    wire_end
} from "../node/const"
import {
    core_header,
    core_fault,
    end_core,
    end_file,
    wire_input,
    wire_output,
    range_separator,
    port_end,
    assign_start,
    node_assignment,
    statement_end
} from "./const"

export type Input = {
    nodes: u64,
    inputs: u64,
    outputs: u64,
    clocked: bool
}

export type Output = u64

export default function (in: Input): Output {
    const declaration =
        bytes.fromText(wire_width).length + bytes.fromText(wire_index).length

    const assignment =
        bytes.fromText(wire_assign).length + bytes.fromText(expression_start).length

    const wire = declaration + assignment + bytes.fromText(wire_end).length

    const range =
        bytes.fromText(range_separator).length + bytes.fromText(port_end).length

    const input = bytes.fromText(wire_input).length + range
    const output = bytes.fromText(wire_output).length + range

    const connection =
        bytes.fromText(assign_start).length + bytes.fromText(node_assignment).length +
        bytes.fromText(statement_end).length

    const header =
        bytes.fromText(core_header).length + bytes.fromText(core_fault).length

    const footer = bytes.fromText(end_core).length + bytes.fromText(end_file).length

    const core =
        header + footer + in.nodes * wire + in.inputs * input +
        in.outputs * (output + connection)

    if (!in.clocked) {
        return core
    }

    return core + in.inputs * input + in.outputs * output
}
