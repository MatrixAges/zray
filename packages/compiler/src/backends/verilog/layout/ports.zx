import integers from "std:integer"
import strings from "std:string"
import memory from "memory"

import { range_separator, port_end } from "./const"

import type { Declaration as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { ports, prefix } = in

    const initial: string[] = []

    const collected = loop({
        row: 0,
        parts: initial
    }, {
        while: state => state.row < ports.count,
        next: state => {
            const width =
                integers.widenShort(memory.readColumnU16(
                    ports.widths,
                    state.row
                ))
            const name = memory.readTextColumn(ports.names, state.row)
            const line = `${prefix}${width - 1}${range_separator}${name}${port_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    return strings.join("", collected)
}
