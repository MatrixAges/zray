import strings from "std:string"

import { wire_input, reg_output } from "./const"
import ports from "./ports"

import type { Interface as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { inputs, outputs } = in

    return strings.join("", [
        templateFile("./templates/clocked_header.tpl"),
        ports({
            ports: inputs,
            prefix: wire_input
        }),
        ports({
            ports: outputs,
            prefix: reg_output
        }),
        templateFile("./templates/clocked_fault.tpl")
    ])
}
