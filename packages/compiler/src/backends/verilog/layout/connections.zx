import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import {
    wire_range,
    core_range,
    statement_end,
    port_binding,
    open_paren,
    binding_end,
    core_binding
} from "./const"

import type { Interface as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { inputs, outputs, writer } = in

    const wires = loop(0, {
        while: row => row < outputs.count,
        next: row => {
            const width =
                integers.widenShort(memory.readColumnU16(outputs.widths, row))
            bytes.write(writer, bytes.fromText(wire_range))
            bytes.writeDecimalU64(writer, width - 1)
            bytes.write(writer, bytes.fromText(core_range))
            bytes.write(
                writer,
                bytes.fromText(memory.readTextColumn(outputs.names, row))
            )
            bytes.write(writer, bytes.fromText(statement_end))

            row += 1
        }
    })

    bytes.write(writer, bytes.fromText(templateFile("./templates/instance.tpl")))

    const bound_inputs = loop(0, {
        while: row => row < inputs.count,
        next: row => {
            const name = memory.readTextColumn(inputs.names, row)
            bytes.write(writer, bytes.fromText(port_binding))
            bytes.write(writer, bytes.fromText(name))
            bytes.write(writer, bytes.fromText(open_paren))
            bytes.write(writer, bytes.fromText(name))
            bytes.write(writer, bytes.fromText(binding_end))

            row += 1
        }
    })

    const bound_outputs = loop(0, {
        while: row => row < outputs.count,
        next: row => {
            const name = memory.readTextColumn(outputs.names, row)
            bytes.write(writer, bytes.fromText(port_binding))
            bytes.write(writer, bytes.fromText(name))
            bytes.write(writer, bytes.fromText(core_binding))
            bytes.write(writer, bytes.fromText(name))
            bytes.write(writer, bytes.fromText(binding_end))

            row += 1
        }
    })
}
