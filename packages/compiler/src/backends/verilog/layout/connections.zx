import integers from "std:integer"
import strings from "std:string"
import memory from "memory"

import {
    wire_range,
    core_range,
    statement_end,
    port_binding,
    open_paren,
    binding_end,
    core_binding
} from "./const"

import type { Interface as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { inputs, outputs } = in

    const initial: string[] = []

    const with_wires = loop({
        row: 0,
        parts: initial
    }, {
        while: state => state.row < outputs.count,
        next: state => {
            const width =
                integers.widenShort(memory.readColumnU16(
                    outputs.widths,
                    state.row
                ))
            const name = memory.readTextColumn(outputs.names, state.row)
            const line = `${wire_range}${width - 1}${core_range}${name}${statement_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const with_instance =
        with_wires.push(templateFile("./templates/instance.tpl"))[0]

    const with_inputs = loop({
        row: 0,
        parts: with_instance
    }, {
        while: state => state.row < inputs.count,
        next: state => {
            const name = memory.readTextColumn(inputs.names, state.row)
            const line = `${port_binding}${name}${open_paren}${name}${binding_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const with_outputs = loop({
        row: 0,
        parts: with_inputs
    }, {
        while: state => state.row < outputs.count,
        next: state => {
            const name = memory.readTextColumn(outputs.names, state.row)
            const line = `${port_binding}${name}${core_binding}${name}${binding_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    return strings.join("", with_outputs)
}
