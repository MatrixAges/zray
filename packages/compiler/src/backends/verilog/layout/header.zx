import strings from "std:string"

import { core_header, kernel_header, wire_input, wire_output, core_fault } from "./const"
import ports from "./ports"

import type { Module as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { inputs, outputs, clocked } = in

    const header = clocked ? core_header : kernel_header

    return strings.join("", [
        header,
        ports({
            ports: inputs,
            prefix: wire_input
        }),
        ports({
            ports: outputs,
            prefix: wire_output
        }),
        core_fault
    ])
}
