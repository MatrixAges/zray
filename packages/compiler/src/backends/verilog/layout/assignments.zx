import integers from "std:integer"
import strings from "std:string"
import memory from "memory"

import {
    assign_start,
    node_assignment,
    statement_end,
    fault_assignment,
    end_core,
    end_file
} from "./const"

import type { Module as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { outputs } = in

    const initial: string[] = []

    const collected = loop({
        row: 0,
        parts: initial
    }, {
        while: state => state.row < outputs.count,
        next: state => {
            const name = memory.readTextColumn(outputs.names, state.row)
            const node =
                integers.widen(memory.readColumnU32(outputs.nodes, state.row))
            const line = `${assign_start}${name}${node_assignment}${node}${statement_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const tail = `${fault_assignment}${in.safe}${end_core}`
    const parts = collected.push(tail)[0]
    const final = in.clocked ? parts : parts.push(end_file)[0]

    return strings.join("", final)
}
