import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import {
    assign_start,
    node_assignment,
    statement_end,
    fault_assignment,
    end_core,
    end_file
} from "./const"

import type { Module as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { outputs, writer } = in

    const assigned = loop(0, {
        while: row => row < outputs.count,
        next: row => {
            bytes.write(writer, bytes.fromText(assign_start))
            bytes.write(
                writer,
                bytes.fromText(memory.readTextColumn(outputs.names, row))
            )
            bytes.write(writer, bytes.fromText(node_assignment))
            bytes.writeDecimalU64(
                writer,
                integers.widen(memory.readColumnU32(outputs.nodes, row))
            )
            bytes.write(writer, bytes.fromText(statement_end))

            row += 1
        }
    })

    bytes.write(writer, bytes.fromText(fault_assignment))
    bytes.writeDecimalU64(writer, in.safe)
    bytes.write(writer, bytes.fromText(end_core))

    if (!in.clocked) {
        bytes.write(writer, bytes.fromText(end_file))
    }
}
