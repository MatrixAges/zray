import integers from "std:integer"
import strings from "std:string"
import memory from "memory"

import {
    reset_indent,
    reset_assignment,
    zero_literal,
    capture_indent,
    capture_assignment,
    statement_end,
    end_file
} from "./const"

import type { Interface as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { outputs } = in

    const with_cleared = loop({
        row: 0,
        parts: [templateFile("./templates/always.tpl")]
    }, {
        while: state => state.row < outputs.count,
        next: state => {
            const name = memory.readTextColumn(outputs.names, state.row)

            const width = integers.widenShort(
                memory.readColumnU16(
                    outputs.widths,
                    state.row
                )
            )

            const line =
                `${reset_indent}${name}${reset_assignment}${width}${zero_literal}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const with_latched = loop({
        row: 0,
        parts: with_cleared.push(templateFile("./templates/accept.tpl"))[0]
    }, {
        while: state => state.row < outputs.count,
        next: state => {
            const name = memory.readTextColumn(outputs.names, state.row)

            const line =
                `${capture_indent}${name}${capture_assignment}${name}${statement_end}`

            state.parts = state.parts.push(line)[0]
            state.row += 1
        },
        return: state => state.parts
    })

    const final = with_latched
        .push(templateFile("./templates/end_registers.tpl"))[0]
        .push(
            end_file
        )[0]

    return strings.join("", final)
}
