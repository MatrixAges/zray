import host from "hardware_graph_host"

import write from "../node/write"

import type { Nodes as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const written = loop(0, {
        while: index => index < in.circuit.graph.count,
        next: index => {
            const { graph, nodes } = in.circuit
            const node = host.readHardwareGraphNode(nodes, index)

            write({
                writer: in.layout.writer,
                index,
                node,
                input_names: graph.inputs.names,
                widths: graph.sorts.widths
            })

            index += 1
        }
    })
}
