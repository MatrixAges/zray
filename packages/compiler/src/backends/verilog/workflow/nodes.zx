import strings from "std:string"

import readNode from "../../hardware/graph/read_node"
import write from "../node/write"

import type { Scan as Input } from "../../hardware/graph/model"

export type Output = string

export default function (in: Input): Output {
    const { graph, nodes } = in

    const initial: string[] = []

    const collected = loop({
        index: 0,
        parts: initial
    }, {
        while: state => state.index < graph.count,
        next: state => {
            const node = readNode({
                nodes,
                index: state.index
            })

            const line = write({
                index: state.index,
                node,
                input_names: graph.inputs.names,
                widths: graph.sorts.widths
            })

            state.parts = state.parts.push(line)[0]
            state.index += 1
        },
        return: state => state.parts
    })

    return strings.join("", collected)
}
