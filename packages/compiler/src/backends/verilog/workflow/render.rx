<Module>
    <Type from="model" as="Verilog" />

    <Args in={Verilog.Input} out={string?} />

    <Call module="../../hardware/graph/validate" in={$in.circuit} />

    <If on={!$ctx.validate}>
        <Return value={null} />
    </If>

    <Call fn="../layout/header" in={$in.layout} />
    <Call fn="nodes" in={$in.circuit} />

    <Call module="../layout/finish" in={$in.layout} />

    <Call
        fn="../layout/join"
        in={[
            $ctx.header,
            $ctx.nodes,
            $ctx.finish
        ]}
    />

    <Return value={$ctx.join} />
</Module>
