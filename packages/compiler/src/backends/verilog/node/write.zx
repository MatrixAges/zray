import bytes from "std:bytes"
import host from "hardware_graph_host"

import { Kind } from "../../hardware/graph/model"
import binary from "./binary"
import { wire_end } from "./const"
import declaration from "./declaration"
import extend from "./extend"
import scalar from "./scalar"

import type { Wire as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    declaration(in)

    const kind = host.hardwareGraphNodeKind(in.node)

    if (kind == Kind.Binary) {
        binary(in)
    } else if (kind == Kind.Extend) {
        extend(in)
    } else {
        scalar(in)
    }

    bytes.write(in.writer, bytes.fromText(wire_end))
}
