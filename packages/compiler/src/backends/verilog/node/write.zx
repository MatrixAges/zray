import { Kind } from "../../hardware/graph/model"
import binary from "./binary"
import { wire_end } from "./const"
import declaration from "./declaration"
import extend from "./extend"
import scalar from "./scalar"

import type { Wire as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const head = declaration(in)
    const kind = in.node.kind

    const body = match (kind) {
        Kind.Binary => binary(in),
        Kind.Extend => extend(in),
        _ => scalar(in)
    }

    return `${head}${body}${wire_end}`
}
