import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import {
    wire_name,
    replicate,
    replicate_wire,
    bit_select,
    replicate_end,
    concat_end,
    concat_start,
    zero_prefix
} from "./const"

import type { Wire as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { writer, node } = in

    const operand = node.first
    const extra = node.extra

    if (extra == 0) {
        bytes.write(writer, bytes.fromText(wire_name))
        bytes.writeDecimalU64(writer, operand)

        return
    }

    if (node.signed) {
        const width = memory.readColumnU16(in.widths, operand)

        bytes.write(writer, bytes.fromText(replicate))
        bytes.writeDecimalU64(writer, integers.widenShort(extra))
        bytes.write(writer, bytes.fromText(replicate_wire))
        bytes.writeDecimalU64(writer, operand)
        bytes.write(writer, bytes.fromText(bit_select))
        bytes.writeDecimalU64(writer, integers.widenShort(width) - 1)
        bytes.write(writer, bytes.fromText(replicate_end))
        bytes.writeDecimalU64(writer, operand)
        bytes.write(writer, bytes.fromText(concat_end))

        return
    }

    bytes.write(writer, bytes.fromText(concat_start))
    bytes.writeDecimalU64(writer, integers.widenShort(extra))
    bytes.write(writer, bytes.fromText(zero_prefix))
    bytes.writeDecimalU64(writer, operand)
    bytes.write(writer, bytes.fromText(concat_end))
}
