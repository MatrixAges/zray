import integers from "std:integer"
import memory from "memory"

import {
    wire_name,
    replicate,
    replicate_wire,
    bit_select,
    replicate_end,
    concat_end,
    concat_start,
    zero_prefix
} from "./const"

import type { Wire as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { node } = in

    const operand = node.first
    const extra = node.extra

    if (extra == 0) {
        return `${wire_name}${operand}`
    }

    const added = integers.widenShort(extra)

    if (node.signed) {
        const width = memory.readColumnU16(in.widths, operand)
        const high = integers.widenShort(width) - 1

        const prefix =
            `${replicate}${added}${replicate_wire}${operand}${bit_select}${high}`

        return `${prefix}${replicate_end}${operand}${concat_end}`
    }

    return `${concat_start}${added}${zero_prefix}${operand}${concat_end}`
}
