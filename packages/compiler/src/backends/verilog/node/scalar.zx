import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { Kind } from "../../hardware/graph/model"
import {
    invert_wire,
    negate_wire,
    decimal_literal,
    wire_name,
    choice_yes,
    choice_no
} from "./const"

import type { Wire as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { writer, node } = in

    const kind = node.kind
    const first = node.first

    if (kind == Kind.Input) {
        bytes.write(
            writer,
            bytes.fromText(memory.readTextColumn(in.input_names, first))
        )

        return
    }

    if (kind == Kind.Constant) {
        const width = node.width

        bytes.writeDecimalU64(writer, integers.widenShort(width))
        bytes.write(writer, bytes.fromText(decimal_literal))
        bytes.writeDecimalU64(writer, first)

        return
    }

    if (kind == Kind.Select) {
        bytes.write(writer, bytes.fromText(wire_name))
        bytes.writeDecimalU64(writer, first)
        bytes.write(writer, bytes.fromText(choice_yes))
        bytes.writeDecimalU64(writer, integers.widen(node.second))
        bytes.write(writer, bytes.fromText(choice_no))
        bytes.writeDecimalU64(writer, integers.widen(node.third))

        return
    }

    const prefix = kind == Kind.Invert ? invert_wire : negate_wire

    bytes.write(writer, bytes.fromText(prefix))
    bytes.writeDecimalU64(writer, first)
}
