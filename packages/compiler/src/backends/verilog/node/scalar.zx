import integers from "std:integer"
import memory from "memory"

import { Kind } from "../../hardware/graph/model"
import {
    invert_wire,
    negate_wire,
    decimal_literal,
    wire_name,
    choice_yes,
    choice_no
} from "./const"

import type { Wire as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { node } = in

    const kind = node.kind
    const first = node.first

    if (kind == Kind.Input) {
        return memory.readTextColumn(in.input_names, first)
    }

    if (kind == Kind.Constant) {
        const width = integers.widenShort(node.width)

        return `${width}${decimal_literal}${first}`
    }

    if (kind == Kind.Select) {
        const yes = integers.widen(node.second)
        const no = integers.widen(node.third)

        return `${wire_name}${first}${choice_yes}${yes}${choice_no}${no}`
    }

    const prefix = kind == Kind.Invert ? invert_wire : negate_wire

    return `${prefix}${first}`
}
