import integers from "std:integer"
import memory from "memory"

import fromCode from "../../hardware/binary/from_code"
import { Rendering } from "../../hardware/binary/model"
import traits from "../../hardware/binary/traits"
import {
    wire_name,
    bit_select,
    signed_concat,
    sign_repeat,
    remainder_join,
    signed_end,
    signed_wire,
    signed_operator,
    signed_right,
    close_paren,
    space,
    right_wire
} from "./const"

import type { Wire as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { node } = in

    const left = node.first
    const right = integers.widen(node.second)
    const info = traits(fromCode(node.operator))
    const rendering = info.rendering

    if (rendering == Rendering.SignedRemainder) {
        const width = memory.readColumnU16(in.widths, left)
        const high = integers.widenShort(width) - 1

        const numerator =
            `${signed_concat}${left}${bit_select}${high}${sign_repeat}${left}`

        const denominator =
            `${remainder_join}${right}${bit_select}${high}${sign_repeat}${right}`

        return `${numerator}${denominator}${signed_end}`
    }

    const token = info.token

    if (rendering == Rendering.Signed) {
        return `${signed_wire}${left}${signed_operator}${token}${signed_right}${right}${close_paren}`
    }

    return `${wire_name}${left}${space}${token}${right_wire}${right}`
}
