import integers from "std:integer"

import { wire_width, wire_index, wire_assign, expression_start } from "./const"

import type { Wire as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { index, node } = in

    const high = integers.widenShort(node.width) - 1

    return `${wire_width}${high}${wire_index}${index}${wire_assign}${index}${expression_start}`
}
