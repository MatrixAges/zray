export type GraphRegistration = mutable_opaque

export type QueryAssembly = mutable_opaque

export declare function reserveSymbolicDefinition(graph: GraphRegistration): void
    throws { OutOfMemory }

export declare function allocateSymbolicIndex(graph: GraphRegistration, capacity: u64): void
    throws { OutOfMemory }

export declare function commitSymbolicDefinition(
    graph: GraphRegistration,
    name: string,
    file: string,
    resized: bool
): void

export declare function rejectSymbolicDefinition(
    graph: GraphRegistration,
    message: string?
): string throws { InvalidSource }

export declare function appendQueryDefinitions(query: QueryAssembly, first: u64, end: u64): void
    throws { OutOfMemory, InvalidSource }

export declare function publishAssembledQuery(
    query: QueryAssembly,
    prefix: u64,
    feasibility: string
): void throws { OutOfMemory }
