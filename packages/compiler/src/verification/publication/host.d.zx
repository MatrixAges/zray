export type GraphRegistration = opaque

export type QueryAssembly = opaque

export declare function reserveSymbolicDefinition(graph: GraphRegistration): void
    throws { OutOfMemory }

export declare function allocateSymbolicIndex(graph: GraphRegistration, capacity: u64): void
    throws { OutOfMemory }

export declare function writeSymbolicDefinition(
    graph: GraphRegistration,
    position: u64,
    resized: bool
): string throws { OutOfMemory }

export declare function installSymbolicIndex(graph: GraphRegistration): void

export declare function rejectSymbolicDefinition(
    graph: GraphRegistration,
    message: string?
): string throws { InvalidSource }

export declare function reserveQueryBuffer(query: QueryAssembly, capacity: u64): void
    throws { OutOfMemory }

export declare function appendQueryText(query: QueryAssembly, text: string): void
    throws { OutOfMemory }

export declare function appendQueryDefinitions(query: QueryAssembly, first: u64, end: u64): void
    throws { OutOfMemory, InvalidSource }

export declare function queryWrittenLength(query: QueryAssembly): u64

export declare function publishCorrectnessQuery(query: QueryAssembly): void
    throws { OutOfMemory }

export declare function publishFeasibilityQuery(
    query: QueryAssembly,
    prefix: u64,
    suffix: string
): void throws { OutOfMemory }
