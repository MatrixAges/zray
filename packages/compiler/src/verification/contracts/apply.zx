import host from "verification_host"

import conjunction from "../scalar/conjunction"
import require from "./require"

import type { ContractKind as Kind } from "core/contract_table/model"
import type { ContractSource, ContractValue, SymbolicPath } from "verification_host"

export enum Mode {
    Entry,
    Called,
    Returned
}

export type Input = SymbolicPath & {
    source: ContractSource,
    output?: ContractValue,
    kinds: Kind[],
    selected: Kind,
    mode: Mode
}

export type Output = SymbolicPath

export default function (in: Input): Output {
    return loop({
        row: 0,
        path: in.path,
        violations: in.violations
    }, {
        while: state => state.row < in.kinds.length,
        next: state => {
            const { source, output, kinds, selected, mode } = in

            if (kinds[state.row] == selected) {
                const path = state.path
                const clause = host.evaluateClause(source, state.row, output)
                const only_safety = mode == Mode.Entry

                if (only_safety) {
                    const violation = require({
                        left: path,
                        right: clause.safe
                    })

                    if (violation != null) {
                        const obligation = host.bindSymbolicBoolean(source, violation)
                        state.violations = state.violations.push(obligation)[0]
                    }
                }

                const checked = conjunction({
                    left: clause.safe,
                    right: clause.predicate
                })
                const valid = host.bindSymbolicBoolean(source, checked)

                if (!only_safety) {
                    const violation = require({
                        left: path,
                        right: valid
                    })

                    if (violation != null) {
                        const obligation = host.bindSymbolicBoolean(source, violation)
                        state.violations = state.violations.push(obligation)[0]
                    }
                }

                const combined = conjunction({
                    left: path,
                    right: valid
                })

                state.path = host.bindSymbolicBoolean(source, combined)
            }

            state.row += 1
        },
        return: state => ({
            path: state.path,
            violations: state.violations
        })
    })
}
