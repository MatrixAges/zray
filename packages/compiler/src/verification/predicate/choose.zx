import { smt_true, smt_false } from "../scalar/const"

import type { Choice as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const a = in.condition

    const { yes, no } = in

    return match {
        a == smt_true || yes == no => yes,
        a == smt_false => no,
        _ => templateFile("../scalar/templates/guard.tpl")
    }
}
