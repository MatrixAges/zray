import conjunction from "../scalar/conjunction"
import disjunction from "../scalar/disjunction"
import { Operator } from "./model"

import type { Connection as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const a = in.left
    const b = in.right

    return match in.operator {
        Operator.And => conjunction(in.omit(["operator"])),
        Operator.Or => disjunction(in.omit(["operator"])),
        _ => templateFile("../scalar/templates/equal.tpl")
    }
}
