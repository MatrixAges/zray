import { smt_true, smt_false } from "../scalar/const"

import type { Input as Pair } from "../scalar/conjunction"

export type Input = Pair

export type Output = string

export default function (in: Input): Output {
    const { left, right: operand } = in

    return match {
        left == smt_false || operand == smt_true => smt_false,
        operand == smt_false => left,
        left == smt_true => templateFile("../scalar/templates/not.tpl"),
        _ => templateFile("./templates/exclude.tpl")
    }
}
