import integers from "std:integer"

import conjunction from "./conjunction"

import type { Unary, Result } from "./model"

export type Input = Unary

export type Output = Result

export default function (in: Input): Output {
    const operand = in.operand.value

    if (in.invert) {
        return {
            value: templateFile("./templates/not.tpl"),
            safe: in.operand.safe
        }
    }

    if (in.width == 0) {
        return {
            value: null,
            safe: in.operand.safe
        }
    }

    const minimum = integers.bitMask(in.width - 1)
    const fits = templateFile("./templates/negation.tpl")

    return {
        value: templateFile("./templates/negative.tpl"),
        safe: conjunction({
            left: in.operand.safe,
            right: fits
        })
    }
}
