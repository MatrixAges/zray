export type Input = u64

export type Output = u64

export default function (in: Input): Output {
    if (in <= 2) {
        return 1
    }

    return loop({
        bits: 1,
        remaining: in - 1
    }, {
        while: state => state.remaining > 1,
        next: state => {
            state.remaining = state.remaining / 2
            state.bits += 1
        },
        return: state => state.bits
    })
}
