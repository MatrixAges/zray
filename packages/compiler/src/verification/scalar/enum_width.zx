import integers from "std:integer"

export type Input = u32

export type Output = u64

export default function (in: Input): Output {
    if (in <= 2) {
        return 1
    }

    const target = integers.widen(in)

    return loop({
        bits: 1,
        limit: 2
    }, {
        while: state => state.limit < target,
        next: state => {
            state.limit = state.limit * 2
            state.bits += 1
        },
        return: state => state.bits
    })
}
