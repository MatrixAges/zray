import { BinaryOperator } from "core/expression_table/kinds"

import conjunction from "./conjunction"
import { smt_true } from "./const"

import type { Binary, Result } from "./model"

export type Input = Binary

export type Output = Result

export default function (in: Input): Output {
    const { left, right } = in

    const both = in.operator == BinaryOperator.LogicalAnd
    const a = left.value
    const b = right.value
    const yes = both ? right.safe : smt_true
    const no = both ? smt_true : right.safe
    const guarded = templateFile("./templates/guard.tpl")

    const value = match {
        both => conjunction({
            left: a,
            right: b
        }),
        _ => templateFile("./templates/or.tpl")
    }

    return {
        value,
        safe: conjunction({
            left: left.safe,
            right: guarded
        })
    }
}
