import { BinaryOperator } from "core/expression_table/kinds"

import choose from "../predicate/choose"
import conjunction from "./conjunction"
import { smt_true } from "./const"
import disjunction from "./disjunction"

import type { Binary, Result } from "./model"

export type Input = Binary

export type Output = Result

export default function (in: Input): Output {
    const { left, right } = in

    const both = in.operator == BinaryOperator.LogicalAnd
    const yes = both ? right.safe : smt_true
    const no = both ? smt_true : right.safe

    const guarded = choose({
        condition: left.value,
        yes,
        no
    })

    const operands = {
        left: left.value,
        right: right.value
    }

    const value = both ? conjunction(operands) : disjunction(operands)

    return {
        value,
        safe: conjunction({
            left: left.safe,
            right: guarded
        })
    }
}
