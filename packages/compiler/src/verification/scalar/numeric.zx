import {
    scalar_u8,
    scalar_u16,
    scalar_u32,
    scalar_u64,
    scalar_i32,
    scalar_i64
} from "core/type_table/const"

import { bits_byte, bits_short, bits_word, bits_long } from "./const"

import type { Numeric } from "./model"

export type Input = u32

export type Output = Numeric

export default function (in: Input): Output {
    const width = match in {
        scalar_u8 => bits_byte,
        scalar_u16 => bits_short,
        scalar_u32 => bits_word,
        scalar_i32 => bits_word,
        scalar_u64 => bits_long,
        scalar_i64 => bits_long,
        _ => 0
    }

    return {
        width,
        signed: in == scalar_i32 || in == scalar_i64
    }
}
