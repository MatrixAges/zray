import integers from "std:integer"
import { max_u64 } from "core/const"

import enumWidth from "./enum_width"
import symbolicWidth from "./symbolic_width"

export type Input = {
    scalar?: u32,
    members?: u64
}

export type Output = u16?

export default function (in: Input): Output {
    const { scalar, members } = in

    const bits = match {
        members != null => enumWidth(members),
        scalar != null => symbolicWidth(scalar),
        _ => max_u64
    }

    return bits == max_u64 ? null : integers.narrowShort(bits)
}
