import host from "verification_host"

import digest from "./digest"
import traverse from "./traverse"

import type { SymbolicCallKey, SymbolicValue } from "verification_host"

export type Input = {
    key: SymbolicCallKey,
    argument: SymbolicValue,
    target: u32,
    start: u64
}

export type Output = void

export default function (in: Input): Output {
    const { key, start, target } = in

    traverse({
        key,
        value: in.argument
    })

    const terms = host.symbolicCallKeyTerms(key, start)

    const hash = digest({
        target,
        terms
    })

    if (host.probeSymbolicCallKey(key, target, start, terms.length, hash)) {
        host.rewindSymbolicCallKey(key, start)
    }
}
