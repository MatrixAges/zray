import digest from "./digest"
import traverse from "./traverse"

import type { SymbolicValue } from "verification_host"
import type { Digest as Output } from "./model"

export type Input = {
    argument: SymbolicValue,
    target: u32
}

export default function (in: Input): Output {
    const { target } = in

    const terms = traverse({
        value: in.argument,
        terms: []
    })

    const hash = digest({
        target,
        terms
    })

    return {
        target,
        terms,
        digest: hash
    }
}
