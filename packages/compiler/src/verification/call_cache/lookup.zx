import digest from "./digest"
import traverse from "./traverse"

import type { Layout } from "../terms/layout"
import type { Digest as Output } from "./model"

export type Input = {
    argument: u8[],
    layout: Layout,
    target: u32
}

export default function (in: Input): Output {
    const { target } = in

    const terms = traverse({
        value: in.argument,
        layout: in.layout,
        terms: []
    })

    const hash = digest({
        target,
        terms
    })

    return {
        target,
        terms,
        digest: hash
    }
}
