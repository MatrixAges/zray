import host from "verification_host"

import digest from "./digest"
import traverse from "./traverse"

import type { SymbolicCallKey, SymbolicValue } from "verification_host"

export type Input = {
    key: SymbolicCallKey,
    argument: SymbolicValue,
    target: u32
}

export type Output = void

export default function (in: Input): Output {
    const { key, target } = in

    const terms = traverse({
        value: in.argument,
        terms: []
    })

    const hash = digest({
        target,
        terms
    })

    host.probeSymbolicCallKey(key, target, terms, hash)
}
