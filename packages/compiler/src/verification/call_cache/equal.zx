import type { Key } from "./model"

export type Input = {
    left: Key,
    right: Key
}

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (left.target != right.target || left.terms.length != right.terms.length) {
        return false
    }

    return loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < left.terms.length,
        next: state => {
            state.equal = left.terms[state.index] == right.terms[state.index]
            state.index += 1
        },
        return: state => state.equal
    })
}
