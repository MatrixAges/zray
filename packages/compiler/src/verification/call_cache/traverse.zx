import host from "verification_host"

import type { SymbolicValue } from "verification_host"

export type Input = {
    value: SymbolicValue,
    terms: string[]
}

export type Output = string[]

export default function traverse(in: Input): Output {
    const { value } = in

    const text = host.symbolicText(value)

    if (text != null) {
        return in.terms.push(text)[0]
    }

    const count = host.symbolicFieldCount(value)

    return loop({
        index: 0,
        terms: in.terms
    }, {
        while: state => state.index < count,
        next: state => {
            state.terms = traverse({
                value: host.symbolicField(value, state.index),
                terms: state.terms
            })

            state.index += 1
        },
        return: state => state.terms
    })
}
