import memory from "memory"
import columns from "memory/columns"

import type { Layout } from "../terms/layout"

export type Input = {
    value: u8[],
    layout: Layout,
    terms: string[]
}

export type Output = string[]

export default function traverse(in: Input): Output {
    const { value, layout } = in

    const text = columns.readBorrowedRowOptionalText(value, layout.text)

    if (text != null) {
        return in.terms.push(text)[0]
    }

    const width = layout.width
    const children = columns.readBorrowedRowList(value, layout.children, width)

    return loop({
        offset: 0,
        terms: in.terms
    }, {
        while: state => state.offset < children.length,
        next: state => {
            state.terms = traverse({
                value: memory.borrowU8Range(children, state.offset, width),
                layout,
                terms: state.terms
            })

            state.offset += width
        },
        return: state => state.terms
    })
}
