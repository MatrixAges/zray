import bytes from "std:bytes"

import type { FileWrite } from "./model"

export type Input = {
    path: string,
    status: string
}

export type Output = FileWrite?

export default function (in: Input): Output {
    if (in.status == "") {
        return null
    }

    return {
        path: bytes.fromText(in.path),
        data: bytes.fromText(in.status),
        make_path: true
    }
}
