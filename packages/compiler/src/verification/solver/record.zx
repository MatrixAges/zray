import bytes from "std:bytes"
import fs from "std:fs"

export type Input = {
    path: string,
    status: string
}

export type Output = void

export default function (in: Input): Output {
    if (in.status != "") {
        fs.writeFileAtomic({
            path: bytes.fromText(in.path),
            data: bytes.fromText(in.status),
            make_path: true
        })
    }
}
