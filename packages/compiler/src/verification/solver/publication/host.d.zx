export type EvidenceSources = opaque

export type EvidenceInputs = opaque

export type EvidenceProgram = opaque

export enum EvidenceFieldKind {
    Sources,
    Entry,
    Version,
    Types,
    Inputs,
    Program
}

export type EvidenceField = {
    kind: EvidenceFieldKind,
    name: string
}

export declare function writeEvidence(
    allocator,
    sources: EvidenceSources,
    entry: string,
    version: u32,
    inputs: EvidenceInputs,
    program: EvidenceProgram,
    fields: EvidenceField[]
): u8[] throws { OutOfMemory }
