export type EvidenceProgram = opaque

export type EvidenceTemplate = {
    path: string,
    source: string
}

export type EvidenceSpan = {
    start: u64,
    end: u64
}

export type EvidenceOrigin = {
    expanded: EvidenceSpan,
    reference: EvidenceSpan,
    path: string,
    source: string
}

export type EvidenceSource = {
    path: string,
    source: string,
    templates: EvidenceTemplate[],
    original?: string,
    template_origins: EvidenceOrigin[]
}

export type EvidenceInput = {
    symbol: string,
    path: string,
    type_id: u32
}

export enum EvidenceFieldKind {
    Sources,
    Entry,
    Version,
    Types,
    Inputs,
    Program
}

export type EvidenceField = {
    kind: EvidenceFieldKind,
    name: string
}

export declare function writeEvidence(
    allocator,
    sources: EvidenceSource[],
    entry: string,
    version: u32,
    inputs: EvidenceInput[],
    program: EvidenceProgram,
    fields: EvidenceField[]
): u8[] throws { OutOfMemory }
