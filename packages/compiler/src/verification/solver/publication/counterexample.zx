import bytes from "std:bytes"
import memory from "memory"

import { binding_separator, counterexample_header, line_end } from "./const"

import type { Counterexample as Input } from "./model"

export type Output = u8[][]

export default function (in: Input): Output {
    const { model, bindings } = in
    const { symbols, paths, count } = bindings

    const newline = bytes.fromText(line_end)
    const separator = bytes.fromText(binding_separator)

    const header: Output = [
        bytes.fromText(counterexample_header),
        model,
        newline
    ]

    return loop({
        index: 0,
        fragments: header
    }, {
        while: state => state.index < count,
        next: state => {
            const symbol = memory.readTextColumn(symbols, state.index)
            const path = memory.readTextColumn(paths, state.index)

            state.fragments = state.fragments.push(bytes.fromText(symbol))[0]
            state.fragments = state.fragments.push(separator)[0]
            state.fragments = state.fragments.push(bytes.fromText(path))[0]
            state.fragments = state.fragments.push(newline)[0]
            state.index += 1
        },
        return: state => state.fragments
    })
}
