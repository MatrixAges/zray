import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"
import strings from "zig:string"

import { proof_path_prefix, proof_path_suffix } from "./const"

import type { Path as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const digest = crypto.sha256Parts([
        in.evidence,
        bytes.fromText(in.feasibility),
        bytes.fromText(in.correctness)
    ])

    const hex = encoding.encodeHex(digest)

    return strings.join("", [
        proof_path_prefix,
        hex,
        proof_path_suffix
    ])
}
