<Module>
    <Type from="model" as="Publication" />
    <Type from="../model" as="Solver" />

    <Args in={Publication.Input} out={Publication.Output} />

    <If on={$in.diagnostic != null}>
        <Call fn="unsupported" in={$in.diagnostic} />

        <Return
            value={{
                verdict: Solver.Verdict.Unsupported,
                fragments: $ctx.unsupported
            }}
        />
    </If>

    <Call fn="evidence/write" in={$in.evidence} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "output",
                "solver",
                "feasibility",
                "correctness"
            ]),
            evidence: $ctx.write
        }}
    />

    <Call module="../check" />

    <Switch on={$ctx.check.verdict}>
        <Case value={Solver.Verdict.Proved}>
            <Call fn="proved" in={$ctx.prepare.path} />

            <Return
                value={{
                    verdict: $ctx.check.verdict,
                    fragments: $ctx.proved
                }}
            />
        </Case>

        <Case value={Solver.Verdict.Counterexample}>
            <Call
                fn="counterexample"
                in={{
                    model: $ctx.check.model,
                    bindings: $in.bindings
                }}
            />

            <Return
                value={{
                    verdict: $ctx.check.verdict,
                    fragments: $ctx.counterexample
                }}
            />
        </Case>

        <Case value={Solver.Verdict.Infeasible}>
            <Call
                fn="unproved"
                in={{
                    text: $ctx.check.status,
                    preconditions: true
                }}
            />

            <Return
                value={{
                    verdict: $ctx.check.verdict,
                    fragments: $ctx.unproved
                }}
            />
        </Case>

        <Case value={Solver.Verdict.Unknown}>
            <Call
                fn="unproved"
                in={{
                    text: $ctx.check.status,
                    preconditions: false
                }}
            />

            <Return
                value={{
                    verdict: $ctx.check.verdict,
                    fragments: $ctx.unproved
                }}
            />
        </Case>
    </Switch>

    <Return
        value={{
            verdict: $ctx.check.verdict,
            fragments: []
        }}
    />
</Module>
