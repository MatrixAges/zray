import { default_solver } from "./const"
import path from "./path"

import type { Proof as Output } from "../model"
import type { Prepare as Input } from "./model"

export default function (in: Input): Output {
    const { evidence, feasibility, correctness } = in

    const output = in.output ?? path({
        evidence,
        feasibility,
        correctness
    })

    return {
        solver: in.solver ?? default_solver,
        path: output,
        evidence,
        feasibility,
        correctness
    }
}
