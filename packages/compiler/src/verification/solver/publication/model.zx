import type { TextColumn } from "memory"
import type { VerificationPublication } from "verification_report_host"
import type { Proof } from "../model"
import type { Input as Evidence } from "./evidence/write"

export type Bindings = {
    symbols: TextColumn,
    paths: TextColumn,
    count: u64
}

export type Input = Proof.Pick("feasibility", "correctness") & {
    context: VerificationPublication,
    diagnostic?: string,
    output?: string,
    solver?: string,
    bindings: Bindings,
    evidence: Evidence
}

export type Prepare =
    Proof.Pick("evidence", "feasibility", "correctness") &
    Input.Pick("solver", "output")

export type Path = Proof.Pick("feasibility", "correctness", "evidence")

export type Message = {
    context: VerificationPublication,
    text: string
}

export type Failure = Message & {
    preconditions: bool
}

export type Counterexample = Message.Pick("context") & {
    model: u8[],
    bindings: Bindings
}
