import type { TextColumn } from "memory"
import type { Proof, Verdict } from "../model"
import type { Input as Evidence } from "./evidence/write"

export type Bindings = {
    symbols: TextColumn,
    paths: TextColumn,
    count: u64
}

export type Input = Proof.Pick("feasibility", "correctness") & {
    diagnostic?: string,
    output?: string,
    solver?: string,
    bindings: Bindings,
    evidence: Evidence
}

export type Prepare =
    Proof.Pick("evidence", "feasibility", "correctness") &
    Input.Pick("solver", "output")

export type Path = Proof.Pick("feasibility", "correctness", "evidence")

export type Counterexample = {
    model: u8[],
    bindings: Bindings
}

export type Output = {
    verdict: Verdict,
    fragments: u8[][]
}
