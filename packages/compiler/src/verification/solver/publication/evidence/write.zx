import bytes from "std:bytes"
import strings from "std:string"

export type Input = {
    sources: string,
    entry: string,
    version: string,
    types: string,
    inputs: string,
    program: string
}

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.fromText(strings.join("", [
        "{\n  \"sources\": ",
        in.sources,
        ",\n  \"entry\": ",
        in.entry,
        ",\n  \"ir_version\": ",
        in.version,
        ",\n  \"types\": ",
        in.types,
        ",\n  \"inputs\": ",
        in.inputs,
        ",\n  \"ir\": ",
        in.program,
        "\n}"
    ]))
}
