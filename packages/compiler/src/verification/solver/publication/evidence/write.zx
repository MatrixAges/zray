import json from "verification_report_host"
import { EvidenceFieldKind as Kind } from "verification_report_host"

import type {
    EvidenceField,
    EvidenceInput,
    EvidenceProgram,
    EvidenceSource
} from "verification_report_host"

export type Input = {
    sources: EvidenceSource[],
    entry: string,
    version: u32,
    inputs: EvidenceInput[],
    program: EvidenceProgram
}

export type Output = u8[]

export default function (in: Input): Output {
    const fields: EvidenceField[] = [
        {
            kind: Kind.Sources,
            name: "sources"
        },
        {
            kind: Kind.Entry,
            name: "entry"
        },
        {
            kind: Kind.Version,
            name: "ir_version"
        },
        {
            kind: Kind.Types,
            name: "types"
        },
        {
            kind: Kind.Inputs,
            name: "inputs"
        },
        {
            kind: Kind.Program,
            name: "ir"
        }
    ]

    return json.writeEvidence(
        in.sources,
        in.entry,
        in.version,
        in.inputs,
        in.program,
        fields
    )
}
