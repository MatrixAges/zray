import bytes from "std:bytes"

import { infeasible_prefix, line_end, unfounded_prefix } from "./const"

export type Input = {
    text: string,
    preconditions: bool
}

export type Output = u8[][]

export default function (in: Input): Output {
    const prefix = bytes.fromText(unfounded_prefix)
    const text = bytes.fromText(in.text)
    const newline = bytes.fromText(line_end)

    if (in.preconditions) {
        return [
            prefix,
            bytes.fromText(infeasible_prefix),
            text,
            newline
        ]
    }

    return [
        prefix,
        text,
        newline
    ]
}
