import {
    ascii_space,
    ascii_tab,
    ascii_line_feed,
    ascii_carriage_return
} from "core/ascii/const"

export type Input = u8

export type Output = bool

export default function (in: Input): Output {
    return match in {
        ascii_space => true,
        ascii_tab => true,
        ascii_line_feed => true,
        ascii_carriage_return => true,
        _ => false
    }
}
