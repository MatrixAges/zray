import bytes from "std:bytes"
import child from "std:child_process"
import { max_u64 } from "core/const"

import { smt_mode } from "./const"

import type { Result as Output } from "std:child_process"
import type { Query } from "./model"

export type Input = Query.Pick("solver", "path")

export default function (in: Input): Output {
    return child.spawnSyncBytes({
        argv: [
            bytes.fromText(in.solver),
            bytes.fromText(smt_mode),
            bytes.fromText(in.path)
        ],
        max_stdout_bytes: max_u64,
        max_stderr_bytes: max_u64
    })
}
