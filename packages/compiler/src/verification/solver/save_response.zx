import bytes from "std:bytes"
import { TerminationKind } from "std:child_process"
import fs from "std:fs"

import type { Result } from "std:child_process"

export type Input = {
    path: string,
    result: Result
}

export type Output = bool

export default function (in: Input): Output {
    const { path, result } = in

    fs.writeFileAtomic({
        path: bytes.fromText(path),
        data: result.stdout,
        make_path: true
    })

    return result.kind == TerminationKind.Exited && result.code == 0
}
