import bytes from "std:bytes"

import { unproved } from "./const"

import type { FileWrite, Proof, Paths } from "./model"

export type Input = {
    proof: Proof,
    paths: Paths
}

export type Output = {
    correctness: FileWrite,
    feasibility: FileWrite,
    source: FileWrite,
    result: FileWrite,
    model: FileWrite
}

export default function (in: Input): Output {
    const { proof, paths } = in

    return {
        correctness: {
            path: bytes.fromText(proof.path),
            data: bytes.fromText(proof.correctness),
            make_path: true
        },
        feasibility: {
            path: bytes.fromText(paths.feasibility),
            data: bytes.fromText(proof.feasibility),
            make_path: true
        },
        source: {
            path: bytes.fromText(paths.source),
            data: proof.evidence,
            make_path: true
        },
        result: {
            path: bytes.fromText(paths.result),
            data: bytes.fromText(unproved),
            make_path: true
        },
        model: {
            path: bytes.fromText(paths.model),
            data: [],
            make_path: true
        }
    }
}
