import type { QueryAssembly } from "verification_publication_host"

export type Input = {
    query: QueryAssembly,
    header: string,
    correctness: string,
    feasibility: string,
    capacity: u64,
    precondition_count: u64,
    definition_count: u64
}

export type Finish = {
    query: QueryAssembly,
    prefix: u64,
    feasibility: string
}
