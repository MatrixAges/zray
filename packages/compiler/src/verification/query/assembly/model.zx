import type { ColumnLengths, StreamWriter } from "memory"
import type { QueryAssembly } from "verification_publication_host"

export type Input = {
    query: QueryAssembly,
    writer: StreamWriter,
    written: ColumnLengths,
    header: string,
    correctness: string,
    feasibility: string,
    precondition_count: u64,
    definition_count: u64
}

export type Finish = {
    query: QueryAssembly,
    prefix: u64,
    feasibility: string
}
