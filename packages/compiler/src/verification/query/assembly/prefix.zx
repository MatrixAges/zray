import memory from "memory"
import host from "verification_publication_host"

import type { Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { query, writer, written, header, precondition_count } = in

    memory.writeStreamText(writer, header)
    host.appendQueryDefinitions(query, 0, precondition_count)

    return memory.readLengthSlot(written, 0)
}
