import memory from "memory"
import host from "verification_publication_host"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { query, writer, precondition_count, definition_count, correctness } = in

    host.appendQueryDefinitions(query, precondition_count, definition_count)
    memory.writeStreamText(writer, correctness)
}
