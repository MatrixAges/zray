<Module>
    <Type from="model" as="Query" />

    <Args in={Query.Input} out={void} />

    <Call fn="prefix" in={$in} />
    <Call fn="body" in={$in} />

    <Call
        fn="model.publishAssembledQuery"
        in={[
            $in.query,
            $ctx.prefix,
            $in.feasibility
        ]}
    />
</Module>
