<Module>
    <Args
        in={{
            declarations: string[],
            precondition: string,
            violations: string[]
        }}
        out={{
            header: string,
            correctness: string,
            feasibility: string
        }}
    />

    <Call fn="declarations" in={$in.declarations} />

    <Call fn="header" />

    <Call module="failures" in={$in.violations} />

    <Task name="feasibility" out={$ctx.assertion}>
        <Call fn="assertion" in={$in.precondition} />
    </Task>

    <Task name="correctness" out={$ctx.assertion}>
        <Call fn="assertion" in={$ctx.failures} />
    </Task>

    <Return
        value={{
            header: $ctx.header,
            feasibility: $ctx.task.feasibility,
            correctness: $ctx.task.correctness
        }}
    />
</Module>
