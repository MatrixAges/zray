<Module>
    <Args
        in={{
            declarations: string[],
            precondition: string,
            violations: string[],
            names: string[],
            expressions: string[],
            widths: u16[],
            precondition_count: u64
        }}
        out={{
            feasibility: string,
            correctness: string
        }}
    />

    <Task name="preamble" out={$ctx.declarations}>
        <Call fn="declarations" in={$in.declarations} />
    </Task>

    <Call fn="header" />

    <Call module="failures" in={$in.violations} />

    <Task name="feasibility" out={$ctx.assertion}>
        <Call fn="assertion" in={$in.precondition} />
    </Task>

    <Task name="correctness" out={$ctx.assertion}>
        <Call fn="assertion" in={$ctx.failures} />
    </Task>

    <Task name="prefix_defs" out={$ctx.declarations}>
        <Call
            fn="../graph/declarations"
            in={{
                names: $in.names,
                expressions: $in.expressions,
                widths: $in.widths,
                first: 0,
                end: $in.precondition_count
            }}
        />
    </Task>

    <Task name="body_defs" out={$ctx.declarations}>
        <Call
            fn="../graph/declarations"
            in={{
                names: $in.names,
                expressions: $in.expressions,
                widths: $in.widths,
                first: $in.precondition_count,
                end: $in.names.length
            }}
        />
    </Task>

    <Call
        fn="assemble"
        in={{
            header: $ctx.header,
            prefix_defs: $ctx.task.prefix_defs,
            body_defs: $ctx.task.body_defs,
            feasibility: $ctx.task.feasibility,
            correctness: $ctx.task.correctness
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
