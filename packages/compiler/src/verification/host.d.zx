export type SelectionGraph = opaque

export type SymbolicValue = opaque

export type SymbolicTarget = opaque

export type SymbolicSession = opaque

export type SymbolicBlock = opaque

export type ClauseTerm = {
    safe: string,
    predicate: string
}

export declare function symbolicText(value: SymbolicValue): string?

export declare function symbolicFieldCount(value: SymbolicValue): u64

export declare function sameSymbolicFields(left: SymbolicValue, right: SymbolicValue): bool

export declare function symbolicField(value: SymbolicValue, index: u64): SymbolicValue

export declare function targetSymbolicField(value: SymbolicTarget, index: u64): SymbolicTarget

export declare function reuseSymbolicFields(target: SymbolicTarget, source: SymbolicValue): void

export declare function reserveSymbolicFields(
    graph: SelectionGraph,
    target: SymbolicTarget,
    count: u64
): void throws { OutOfMemory }

export declare function publishSymbolicText(
    graph: SelectionGraph,
    target: SymbolicTarget,
    type_id: u32,
    text: string
): void throws { OutOfMemory, InvalidSource }


export declare function evaluateClause(session: SymbolicSession, row: u64): ClauseTerm
    throws { OutOfMemory, InvalidSource }

export declare function bindSymbolicBoolean(session: SymbolicSession, term: string): string
    throws { OutOfMemory, InvalidSource }

export declare function publishClauseViolation(session: SymbolicSession, term: string): void
    throws { OutOfMemory }

export declare function selectSymbolicReturn(session: SymbolicSession, row: u64): string
    throws { OutOfMemory, InvalidSource }

export declare function evaluateSymbolicStatement(block: SymbolicBlock, expression: u32?): string
    throws { OutOfMemory, InvalidSource }

export declare function symbolicStatementText(block: SymbolicBlock): string

export declare function bindSymbolicStatement(block: SymbolicBlock, symbol: u32): void

export declare function bindSymbolicStatementField(block: SymbolicBlock, symbol: u32, field: u64): void

export declare function publishSymbolicStatementReturn(block: SymbolicBlock, path: string): void
    throws { OutOfMemory, InvalidSource }

export declare function runSymbolicChild(block: SymbolicBlock, body: u32, path: string): string
    throws { OutOfMemory, InvalidSource }

export declare function runSymbolicParallel(block: SymbolicBlock, payload: u64, path: string): string
    throws { OutOfMemory, InvalidSource }

export declare function reserveSymbolicParallel(block: SymbolicBlock, count: u64): void
    throws { OutOfMemory }

export declare function saveSymbolicParallel(block: SymbolicBlock, index: u64): void

export declare function bindSymbolicParallel(block: SymbolicBlock, index: u64, symbol: u32): void

export declare function rejectSymbolicStatement(block: SymbolicBlock): string?
    throws { InvalidSource }
