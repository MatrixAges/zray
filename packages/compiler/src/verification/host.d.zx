export type SelectionGraph = opaque

export type SymbolicValue = opaque

export type SymbolicTarget = mutable_opaque

export type SymbolicSession = mutable_opaque

export type SymbolicBlock = mutable_opaque

export type SymbolicExpression = mutable_opaque

export type SymbolicInvocation = mutable_opaque

export type SymbolicCallKey = mutable_opaque

export enum SymbolicOperand {
    First,
    Second,
    Third,
    Result
}

export type SymbolicCallDescription = {
    calls: u32[],
    target: u32,
    stores: u64,
    external: bool,
    depth: u64
}

export type ClauseTerm = {
    safe: string,
    predicate: string
}

export declare function symbolicText(value: SymbolicValue): string?

export declare function symbolicFieldCount(value: SymbolicValue): u64

export declare function sameSymbolicFields(left: SymbolicValue, right: SymbolicValue): bool

export declare function symbolicField(value: SymbolicValue, index: u64): SymbolicValue

export declare function targetSymbolicField(value: SymbolicTarget, index: u64): SymbolicTarget

export declare function reuseSymbolicFields(target: SymbolicTarget, source: SymbolicValue): void

export declare function reserveSymbolicFields(
    graph: SelectionGraph,
    target: SymbolicTarget,
    count: u64
): void throws { OutOfMemory }

export declare function publishSymbolicText(
    graph: SelectionGraph,
    target: SymbolicTarget,
    type_id: u32,
    text: string
): void throws { OutOfMemory, InvalidSource }


export declare function evaluateClause(session: SymbolicSession, row: u64): ClauseTerm
    throws { OutOfMemory, InvalidSource }

export declare function bindSymbolicBoolean(session: SymbolicSession, term: string): string
    throws { OutOfMemory, InvalidSource }

export declare function publishClauseViolation(session: SymbolicSession, term: string): void
    throws { OutOfMemory }

export declare function selectSymbolicReturn(session: SymbolicSession, row: u64): string
    throws { OutOfMemory, InvalidSource }

export declare function evaluateSymbolicStatement(block: SymbolicBlock, expression: u32?): string
    throws { OutOfMemory, InvalidSource }

export declare function symbolicStatementText(block: SymbolicBlock): string

export declare function bindSymbolicStatement(block: SymbolicBlock, symbol: u32): void

export declare function bindSymbolicStatementField(block: SymbolicBlock, symbol: u32, field: u64): void

export declare function publishSymbolicStatementReturn(block: SymbolicBlock, path: string): void
    throws { OutOfMemory, InvalidSource }

export declare function runSymbolicChild(block: SymbolicBlock, body: u32, path: string): string
    throws { OutOfMemory, InvalidSource }

export declare function runSymbolicParallel(block: SymbolicBlock, payload: u64, path: string): string
    throws { OutOfMemory, InvalidSource }

export declare function reserveSymbolicParallel(block: SymbolicBlock, count: u64): void
    throws { OutOfMemory }

export declare function saveSymbolicParallel(block: SymbolicBlock, index: u64): void

export declare function bindSymbolicParallel(block: SymbolicBlock, index: u64, symbol: u32): void

export declare function rejectSymbolicStatement(block: SymbolicBlock): string?
    throws { InvalidSource }

export declare function rejectSymbolicExpression(frame: SymbolicExpression, message: string): void
    throws { InvalidSource }

export declare function loadSymbolicReference(frame: SymbolicExpression, symbol: u32): void
    throws { InvalidSource }

export declare function symbolicLiteralWidth(frame: SymbolicExpression, enumeration: bool): u64

export declare function writeSymbolicLiteral(frame: SymbolicExpression, value: string): void

export declare function evaluateSymbolicOperand(
    frame: SymbolicExpression,
    slot: SymbolicOperand,
    expression: u32
): string throws { OutOfMemory, InvalidSource }

export declare function symbolicOperandText(
    frame: SymbolicExpression,
    slot: SymbolicOperand
): string

export declare function symbolicOperandSafety(
    frame: SymbolicExpression,
    slot: SymbolicOperand
): string

export declare function projectSymbolicOperand(frame: SymbolicExpression, index: u32): void

export declare function writeSymbolicUnary(frame: SymbolicExpression, invert: bool): bool
    throws { OutOfMemory, InvalidSource }

export declare function writeSymbolicBinary(frame: SymbolicExpression, left: u32): bool
    throws { OutOfMemory, InvalidSource }

export declare function selectSymbolicExpression(
    frame: SymbolicExpression,
    condition: string,
    yes: SymbolicOperand,
    no: SymbolicOperand
): void throws { OutOfMemory, InvalidSource }

export declare function retainSymbolicExpression(frame: SymbolicExpression): void
    throws { OutOfMemory, InvalidSource }

export declare function bindSymbolicExpressionSafety(frame: SymbolicExpression, safe: string): string
    throws { OutOfMemory, InvalidSource }

export declare function writeSymbolicSafety(frame: SymbolicExpression, safe: string): void

export declare function reserveSymbolicAggregate(frame: SymbolicExpression, count: u32): void
    throws { OutOfMemory }

export declare function writeSymbolicAggregateField(frame: SymbolicExpression, index: u32): void

export declare function runSymbolicExpressionCall(
    frame: SymbolicExpression,
    target: u32,
    argument: u32
): void throws { OutOfMemory, InvalidSource }

export declare function describeSymbolicCall(call: SymbolicInvocation): SymbolicCallDescription

export declare function rejectSymbolicCall(call: SymbolicInvocation, message: string): void
    throws { InvalidSource }

export declare function evaluateSymbolicCallArgument(call: SymbolicInvocation): string
    throws { OutOfMemory, InvalidSource }

export declare function findSymbolicCallee(call: SymbolicInvocation): bool
    throws { OutOfMemory }

export declare function evaluateSymbolicCallee(call: SymbolicInvocation): void
    throws { OutOfMemory, InvalidSource }

export declare function publishSymbolicCallee(call: SymbolicInvocation): void
    throws { OutOfMemory }

export declare function symbolicCalleeSafety(call: SymbolicInvocation): string

export declare function writeSymbolicCallSafety(call: SymbolicInvocation, safe: string): void

export declare function appendSymbolicCallKey(key: SymbolicCallKey, text: string): void
    throws { OutOfMemory }

export declare function symbolicCallKeyTerms(key: SymbolicCallKey, start: u64): string[]

export declare function probeSymbolicCallKey(
    key: SymbolicCallKey,
    target: u32,
    start: u64,
    count: u64,
    digest: u64
): bool

export declare function rewindSymbolicCallKey(key: SymbolicCallKey, start: u64): void
