export type ContractSource = opaque

export type ContractValue = {
    text?: string,
    fields: u8[]
}

export type SymbolicPath = {
    path: string,
    violations: string[]
}

export type ClauseTerm = {
    safe: string,
    predicate: string
}

export declare function evaluateClause(
    allocator,
    source: ContractSource,
    row: u64,
    output: ContractValue?
): ClauseTerm throws { OutOfMemory, InvalidSource }

export declare function bindSymbolicBoolean(source: ContractSource, term: string): string
    throws { OutOfMemory, InvalidSource }
