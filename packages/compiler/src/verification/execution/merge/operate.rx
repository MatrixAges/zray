<Module>
    <Type from="model" as="Merge" />

    <Args in={Merge.Operation} out={string} />

    <Store from="selection" as="selection" />

    <Call
        fn="submit"
        in={{
            operation: $in,
            previous: $store.selection.state
        }}
        setter={[$store.selection.state]}
    />

    <Call fn="read" in={$store.selection.state} />

    <Return value={$ctx.read} />
</Module>
