<Module>
    <Type from="model" as="Parallel" />
    <Type from="../block/effect/model" as="Operation" />

    <Args in={Parallel.Bindings} out={Parallel.Bindings} />

    <Call
        module="../block/effect/run"
        in={{
            step: Operation.Step.Bind,
            row: $in.symbols[$in.first + $in.index],
            value: $in.values[$in.index]
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
