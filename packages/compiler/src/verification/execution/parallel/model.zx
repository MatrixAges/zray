import type { Path } from "../block/effect/model"
import type { Payload, Scope } from "../block/model"
import type { Value } from "../expression/effect/model"

export type Input = Payload

export type Output = Path

export type Parameters = Path & {
    scope: Scope,
    row: u64,
    end: u64
}

export type Calls = Path & {
    rows: u32[],
    next: u64,
    end: u64,
    launch: string,
    values: Value[]
}

export type Bindings = {
    symbols: u32?[],
    first: u64,
    values: Value[],
    index: u64
}
