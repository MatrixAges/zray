import integers from "std:integer"

import type { Input, Parameters as Output } from "./model"

export default function (in: Input): Output {
    const { scope, payload, path, violations } = in

    const first = integers.widen(scope.control.parallel_first[payload])
    const count = integers.widen(scope.control.parallel_count[payload])

    return {
        scope,
        row: first,
        end: first + count,
        path,
        violations
    }
}
