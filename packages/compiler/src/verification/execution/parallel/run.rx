<Module>
    <Type from="model" as="Parallel" />

    <Args in={Parallel.Input} out={Parallel.Output} />

    <Call fn="parameters" in={$in} />

    <Loop on={$in.row < $in.end}>
        <Call module="next_parameter" />
    </Loop>

    <Call
        fn="calls"
        in={{
            ...$ctx.next_parameter,
            row: $ctx.parameters.row
        }}
    />

    <Loop on={$in.next < $in.end}>
        <Call module="next_call" />
    </Loop>

    <Loop on={$in.index < $in.values.length}>
        <Call
            module="next_binding"
            in={{
                symbols: $in.scope.control.parallel_symbols,
                first: $ctx.parameters.row,
                values: $ctx.next_call.values,
                index: 0
            }}
        />
    </Loop>

    <Return
        value={$ctx.next_call.pick([
            "path",
            "violations"
        ])}
    />
</Module>
