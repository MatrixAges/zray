<Module>
    <Type from="model" as="Parallel" />

    <Args in={Parallel.Input} out={Parallel.Output} />

    <Call fn="parameters" in={$in} />

    <Call
        fn="calls"
        in={{
            ...$in,
            violations: $ctx.parameters.violations,
            launch: $ctx.parameters.path
        }}
    />

    <Loop on={$in.index < $in.values.length}>
        <Call
            module="next_binding"
            in={{
                block: $in.block,
                symbols: $in.scope.control.parallel_symbols,
                first: $ctx.calls.first,
                values: $ctx.calls.values,
                index: 0
            }}
        />
    </Loop>

    <Return
        value={$ctx.calls.pick([
            "path",
            "violations"
        ])}
    />
</Module>
