import integers from "std:integer"
import host from "verification_host"

import require from "../../contracts/require"
import conjunction from "../../scalar/conjunction"

import type { SymbolicOutcome } from "verification_host"
import type { Calls as Input, Completed as Output } from "./model"

export default function (in: Input): Output {
    const { block, session, scope, payload, launch } = in

    const control = scope.control
    const first = integers.widen(control.parallel_first[payload])
    const count = integers.widen(control.parallel_count[payload])

    const values: SymbolicOutcome[] = []

    const completed = loop({
        index: 0,
        path: launch,
        values
    }, {
        while: state => state.index < count,
        next: state => {
            const outcome = host.evaluateSymbolicStatement(
                block,
                control.parallel_values[first + state.index]
            )

            const { safe } = outcome

            state.values = state.values.push({
                safe,
                text: outcome.text,
                fields: outcome.fields
            })[0]
            const violation = require({
                left: launch,
                right: safe
            })

            if (violation != null) {
                const obligation = host.bindSymbolicBoolean(session, violation)
                host.publishClauseViolation(session, obligation)
            }

            const joined = conjunction({
                left: state.path,
                right: safe
            })
            state.path = host.bindSymbolicBoolean(session, joined)
            state.index += 1
        },
        return: state => state
    })

    return {
        path: completed.path,
        first,
        values: completed.values
    }
}
