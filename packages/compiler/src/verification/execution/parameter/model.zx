import type { Parameter } from "verification_program_host"
import type { Ports } from "../program/model"

export type Input = {
    types: Ports,
    type_id: u32,
    path: string,
    index: u64,
    proof: bool,
    rows: Parameter[]
}

export type Walked = {
    rows: Parameter[],
    index: u64,
    diagnostic?: string
}

export type Leaf = Input.Pick("type_id", "path", "index", "proof") & {
    width: u64,
    members: u64
}

export type Publication = Leaf.Pick("type_id", "path") & {
    symbol: string,
    declaration?: string,
    domain?: string
}
