import type { SymbolicProgram, ParameterTarget } from "verification_program_host"
import type { Ports } from "../program/model"

export type Input = {
    program: SymbolicProgram,
    target: ParameterTarget,
    types: Ports,
    type_id: u32,
    path: string,
    index: u64,
    proof: bool
}

export type Leaf = Input.Pick("type_id", "path", "index", "proof") & {
    width: u64,
    members: u64
}

export type Publication = Leaf.Pick("type_id", "path") & {
    symbol: string,
    declaration?: string,
    domain?: string
}
