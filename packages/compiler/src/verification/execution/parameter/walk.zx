import integers from "std:integer"
import { max_u64 } from "core/const"
import { scalar_void } from "core/type_table/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import fieldPath from "../../ports/path"
import enumWidth from "../../scalar/enum_width"
import symbolicWidth from "../../scalar/symbolic_width"
import { invalid_parameter_type } from "../program/const"
import leaf from "./leaf"

import type { Input, Walked } from "./model"

export type Output = Walked

export default function walk(in: Input): Output {
    const { types, type_id, path, index, proof } = in

    const row = integers.widen(type_id)
    const shape = kind(types.kinds[row])
    const start = types.first[row]

    if (shape == Kind.Object || shape == Kind.Tuple) {
        const first = integers.widen(start)
        const count = integers.widen(types.second[row])
        const object = shape == Kind.Object
        const children = object ? types.field_types : types.children

        const initial: Walked = {
            rows: in.rows.push({
                type_id,
                fields: count
            })[0],
            index
        }

        return loop({
            field: 0,
            walked: initial
        }, {
            while: state => state.field < count && state.walked.diagnostic == null,
            next: state => {
                const label: string? = match object {
                    true => types.field_names[first + state.field],
                    _ => null
                }
                const child_path = fieldPath({
                    parent: path,
                    field: label,
                    index: state.field
                })

                state.walked = walk({
                    types,
                    type_id: children[first + state.field],
                    path: child_path,
                    index: state.walked.index,
                    proof,
                    rows: state.walked.rows
                })
                state.field += 1
            },
            return: state => state.walked
        })
    }

    if (shape == Kind.Scalar && start == scalar_void) {
        return {
            rows: in.rows.push({
                type_id,
                fields: 0
            })[0],
            index
        }
    }

    const publication = leaf({
        type_id,
        path,
        index,
        proof,
        width: match shape {
            Kind.Enumeration => enumWidth(integers.widen(types.second[row])),
            Kind.Scalar => symbolicWidth(start),
            _ => max_u64
        },
        members: match shape {
            Kind.Enumeration => integers.widen(types.second[row]),
            _ => 0
        }
    })

    if (publication == null) {
        return {
            rows: in.rows,
            index,
            diagnostic: invalid_parameter_type
        }
    }

    return {
        rows: in.rows.push({
            ...publication,
            fields: 0
        })[0],
        index: index + 1
    }
}
