import { max_u64 } from "core/const"

import name from "../../ports/name"
import parameter from "../../ports/parameter"

import type { Leaf as Input, Publication } from "./model"

export type Output = Publication?

export default function (in: Input): Output {
    const { type_id, path, index, proof, width, members } = in

    if (width == max_u64) {
        return null
    }

    if (proof) {
        const declared = parameter({
            index,
            width,
            members
        })

        return {
            type_id,
            path,
            symbol: declared.symbol,
            declaration: declared.declaration,
            domain: declared.domain
        }
    }

    return {
        type_id,
        path,
        symbol: name({
            index,
            output: false
        }),
        declaration: null,
        domain: null
    }
}
