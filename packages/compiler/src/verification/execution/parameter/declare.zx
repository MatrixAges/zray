import host from "verification_program_host"

import parameter from "../../ports/parameter.rx"

import type { Declaration as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { program } = in

    const result = parameter(in.omit(["program"]))

    host.appendSymbolicDeclaration(program, result.declaration)

    const domain = result.domain

    if (domain != null) {
        host.appendSymbolicDeclaration(program, domain)
    }

    return result.symbol
}
