import { smt_false } from "../../scalar/const"

import type { Traversal } from "./model"

export type Input = {
    current: Traversal,
    next?: string
}

export type Output = Traversal

export default function (in: Input): Output {
    const next_row = in.current.row + 1

    if (in.next == null) {
        return {
            ...in.current,
            path: smt_false,
            row: next_row,
            running: false
        }
    }

    return {
        ...in.current,
        path: in.next,
        row: next_row,
        running: next_row < in.current.end
    }
}
