import { smt_false } from "../../scalar/const"

import type { Step, Traversal } from "./model"

export type Input = {
    current: Traversal,
    next: Step
}

export type Output = Traversal

export default function (in: Input): Output {
    const next_row = in.current.row + 1

    if (in.next.path == null) {
        return {
            ...in.current,
            path: smt_false,
            violations: in.next.violations,
            row: next_row,
            running: false,
            unsupported: in.next.unsupported
        }
    }

    return {
        ...in.current,
        path: in.next.path,
        violations: in.next.violations,
        row: next_row,
        running: next_row < in.current.end
    }
}
