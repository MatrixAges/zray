import host from "verification_host"

import guard from "./guard"

import type { SymbolicBlock, SymbolicPath, SymbolicSession } from "verification_host"

export type Input = SymbolicPath & {
    block: SymbolicBlock,
    session: SymbolicSession,
    expression?: u32
}

export type Output = string[]

export default function (in: Input): Output {
    const { block, session, path, expression } = in

    const outcome = host.evaluateSymbolicStatement(block, expression)

    const completed = guard({
        session,
        path,
        violations: in.violations,
        safe: outcome.safe
    })

    return host.publishSymbolicStatementReturn(block, completed, outcome)
}
