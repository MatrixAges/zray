import type { Control, StatementKind } from "core/control_table/model"
import type { SymbolicBlock, SymbolicSession } from "verification_host"

export { StatementKind } from "core/control_table/model"

export type Scope = {
    control: Control,
    expression_payloads: u32[],
    call_arguments: u32[]
}

export type Path = {
    block: SymbolicBlock,
    session: SymbolicSession,
    scope: Scope,
    path: string
}

export type Input = Path & {
    first: u64,
    count: u64
}

export type Statement = Path & {
    row: u64
}

export type Payload = Path & {
    payload: u64
}

export type Prepared = {
    kind: StatementKind,
    payload: u64,
    expression?: u32,
    symbol?: u32
}

export type Step = {
    path?: string,
    unsupported?: bool
}

export type Traversal = Path & {
    row: u64,
    end: u64,
    running: bool,
    unsupported?: bool
}

export type Cases = {
    row: u64,
    unmatched: string,
    continuation: string,
    fallback?: u32
}
