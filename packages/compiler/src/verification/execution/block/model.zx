import type { Control, StatementKind } from "core/control_table/model"
import type { Layout } from "../../terms/layout"
import type { Path as SymbolicPath } from "./effect/model"

export type Outcome = SymbolicPath

export { StatementKind } from "core/control_table/model"

export type Scope = {
    control: Control,
    layout: Layout,
    expression_payloads: u32[],
    call_arguments: u32[]
}

export type Path = SymbolicPath & {
    scope: Scope
}

export type Input = Path & {
    first: u64,
    count: u64
}

export type Statement = Path & {
    row: u64
}

export type Payload = Path & {
    payload: u64
}

export type Prepared = {
    kind: StatementKind,
    payload: u64,
    expression?: u32,
    symbol?: u32
}

export type Step = {
    path?: string,
    violations: string[],
    unsupported?: bool
}

export type Traversal = Path & {
    row: u64,
    end: u64,
    running: bool,
    unsupported?: bool
}

export type Guard = SymbolicPath & {
    safe: string
}

export type Result = SymbolicPath & {
    expression?: u32
}

export type Binding = Result & {
    symbol?: u32
}
