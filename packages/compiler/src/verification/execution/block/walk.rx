<Module>
    <Type from="model" as="Block" />

    <Args in={Block.Input} out={Block.Outcome?} />

    <Call fn="initialize" in={$in} />

    <Loop on={$in.running}>
        <Call module="next" />
    </Loop>

    <If on={$ctx.next.unsupported == true}>
        <Return value={null} />
    </If>

    <Return
        value={$ctx.next.pick([
            "path",
            "violations"
        ])}
    />
</Module>
