import type { Input, Traversal } from "./model"

export type Output = Traversal

export default function (in: Input): Output {
    const end = in.first + in.count

    return {
        scope: in.scope,
        path: in.path,
        violations: in.violations,
        row: in.first,
        end,
        running: in.first < end
    }
}
