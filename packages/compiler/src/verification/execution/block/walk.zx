import { smt_false } from "../../scalar/const"
import step from "./step"

import type { Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const end = in.first + in.count

    const request = in.omit([
        "first",
        "count",
        "path"
    ])

    return loop({
        row: in.first,
        path: in.path,
        returned: false
    }, {
        while: state => !state.returned && state.row < end,
        next: state => {
            const next = step({
                ...request,
                row: state.row,
                path: state.path
            })

            state.path = match {
                next == null => smt_false,
                _ => next
            }
            state.returned = next == null
            state.row += 1
        },
        return: state => state.path
    })
}
