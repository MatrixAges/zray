import integers from "std:integer"

import type { Layout } from "../../terms/layout"
import type { Value } from "../expression/effect/model"
import type { Payload } from "./model"

export type Input = Payload.Pick("scope", "payload") & {
    value: Value
}

export type Output = {
    symbols: u32?[],
    value: Value,
    layout: Layout,
    first: u64,
    field: u64,
    count: u64
}

export default function (in: Input): Output {
    const { scope, payload, value } = in

    const control = scope.control

    return {
        symbols: control.destructure_symbols,
        value,
        layout: scope.layout,
        first: integers.widen(control.destructure_first[payload]),
        field: 0,
        count: integers.widen(control.destructure_count[payload])
    }
}
