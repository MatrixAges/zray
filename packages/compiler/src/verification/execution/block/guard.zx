import host from "verification_host"

import require from "../../contracts/require"
import conjunction from "../../scalar/conjunction"

import type { SymbolicSession } from "verification_host"

export type Input = {
    session: SymbolicSession,
    path: string,
    safe: string
}

export type Output = string

export default function (in: Input): Output {
    const { session, path, safe } = in

    const violation = require({
        left: path,
        right: safe
    })

    if (violation != null) {
        const obligation = host.bindSymbolicBoolean(session, violation)

        host.publishClauseViolation(session, obligation)
    }

    const checked = conjunction({
        left: path,
        right: safe
    })

    return host.bindSymbolicBoolean(session, checked)
}
