import host from "verification_host"

import require from "../../contracts/require"
import conjunction from "../../scalar/conjunction"

import type { SymbolicPath, SymbolicSession } from "verification_host"

export type Input = SymbolicPath & {
    session: SymbolicSession,
    safe: string
}

export type Output = SymbolicPath

export default function (in: Input): Output {
    const { session, path, safe } = in

    const violation = require({
        left: path,
        right: safe
    })

    const violations = match {
        violation != null =>
            in.violations.push(host.bindSymbolicBoolean(session, violation))[0],
        _ => in.violations
    }

    const checked = conjunction({
        left: path,
        right: safe
    })

    return {
        path: host.bindSymbolicBoolean(session, checked),
        violations
    }
}
