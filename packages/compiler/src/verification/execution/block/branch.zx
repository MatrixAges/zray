import host from "verification_host"

import exclude from "../../predicate/exclude"
import conjunction from "../../scalar/conjunction"
import disjunction from "../../scalar/disjunction"
import guard from "./guard"

import type { SymbolicPath } from "verification_host"
import type { Payload as Input } from "./model"

export type Output = SymbolicPath

export default function (in: Input): Output {
    const { block, session, scope, payload } = in

    const control = scope.control

    const outcome =
        host.evaluateSymbolicStatement(block, control.branch_conditions[payload])

    const condition = outcome.text == null ? "" : outcome.text

    const checked = guard({
        session,
        path: in.path,
        violations: in.violations,
        safe: outcome.safe
    })

    const { path, violations } = checked

    const positive = conjunction({
        left: path,
        right: condition
    })

    const yes_entry = host.bindSymbolicBoolean(session, positive)

    const yes = host.runSymbolicChild(block, control.branch_yes[payload], {
        path: yes_entry,
        violations
    })

    const negative = exclude({
        left: path,
        right: condition
    })

    const no_entry = host.bindSymbolicBoolean(session, negative)

    const no = host.runSymbolicChild(block, control.branch_no[payload], {
        path: no_entry,
        violations: yes.violations
    })

    if (yes.path == yes_entry && no.path == no_entry) {
        return {
            path,
            violations: no.violations
        }
    }

    const joined = disjunction({
        left: yes.path,
        right: no.path
    })

    return {
        path: host.bindSymbolicBoolean(session, joined),
        violations: no.violations
    }
}
