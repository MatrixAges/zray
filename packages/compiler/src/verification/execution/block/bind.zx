import host from "verification_host"

import guard from "./guard"

import type { SymbolicBlock, SymbolicSession } from "verification_host"

export type Input = {
    block: SymbolicBlock,
    session: SymbolicSession,
    path: string,
    expression?: u32,
    symbol?: u32
}

export type Output = string

export default function (in: Input): Output {
    const { block, session, path, expression, symbol } = in

    const safe = host.evaluateSymbolicStatement(block, expression).safe

    const next = guard({
        session,
        path,
        safe
    })

    if (symbol != null) {
        host.bindSymbolicStatement(block, symbol)
    }

    return next
}
