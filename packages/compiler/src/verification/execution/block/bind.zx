import host from "verification_host"

import guard from "./guard"

import type { SymbolicBlock, SymbolicPath, SymbolicSession } from "verification_host"

export type Input = SymbolicPath & {
    block: SymbolicBlock,
    session: SymbolicSession,
    expression?: u32,
    symbol?: u32
}

export type Output = SymbolicPath

export default function (in: Input): Output {
    const { block, session, path, expression, symbol } = in

    const outcome = host.evaluateSymbolicStatement(block, expression)

    const next = guard({
        session,
        path,
        violations: in.violations,
        safe: outcome.safe
    })

    if (symbol != null) {
        host.bindSymbolicStatement(block, symbol, outcome, null)
    }

    return next
}
