<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Called} out={void} />

    <Call
        fn="preconditions"
        in={{
            program: $in.program,
            called: true
        }}
    />

    <Call
        fn="body"
        in={{
            program: $in.program,
            called: true,
            returns_unit: $in.returns_unit,
            path: $ctx.preconditions
        }}
    />

    <Call
        fn="publish"
        in={{
            program: $in.program,
            called: true,
            path: $ctx.preconditions
        }}
    />
</Module>
