<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Called} out={Program.Diagnostic?} />

    <Call fn="index.ensureSymbolicGraph" in={$in.program} />
    <Call fn="index.beginSymbolicCall" in={$in.program} />

    <Call
        fn="index.symbolicProgramPreconditions"
        in={[
            $in.program,
            true
        ]}
    />

    <Call
        fn="index.runSymbolicProgramBody"
        in={[
            $in.program,
            $ctx.symbolicProgramPreconditions.path
        ]}
    />

    <If on={$in.returns_unit}>
        <Call
            fn="index.checkSymbolicUnit"
            in={[
                $in.program,
                $ctx.runSymbolicProgramBody
            ]}
        />

        <Call
            fn="index.appendSymbolicUnit"
            in={[
                $in.program,
                $ctx.runSymbolicProgramBody
            ]}
        />
    </If>

    <Call fn="index.publishSymbolicProgramResult" in={$in.program} />

    <If on={!$ctx.publishSymbolicProgramResult}>
        <Return
            value={{
                message: "verified call has no return value",
                unsupported: false
            }}
        />
    </If>

    <Return value={null} />
</Module>
