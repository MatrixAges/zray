<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Called} out={Program.Plan} />

    <If on={$in.returned != null}>
        <If on={$in.returned == 0}>
            <Return
                value={{
                    steps: [],
                    diagnostic: {
                        message: "verified call has no return value",
                        unsupported: false
                    }
                }}
            />
        </If>

        <Return
            value={{
                steps: [Program.Step.Merge]
            }}
        />
    </If>

    <Call fn="call_steps" in={$in.returns_unit} />

    <Return
        value={{
            steps: $ctx.call_steps
        }}
    />
</Module>
