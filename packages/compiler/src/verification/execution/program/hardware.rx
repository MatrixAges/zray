<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Entry} out={void} />

    <If on={$in.type_only || $in.stores != 0}>
        <Call
            fn="index.rejectSymbolicProgram"
            in={[
                $in.program,
                "symbolic execution requires a pure executable function without Store capabilities"
            ]}
        />
    </If>

    <Call
        fn="../parameter/walk"
        in={{
            types: $in.types,
            type_id: $in.input,
            path: "in",
            index: 0,
            proof: false,
            rows: []
        }}
    />

    <If on={$ctx.walk.diagnostic != null}>
        <Call
            fn="index.rejectSymbolicProgram"
            in={[
                $in.program,
                $ctx.walk.diagnostic
            ]}
        />
    </If>

    <Call
        fn="index.publishSymbolicParameter"
        in={[
            $in.program,
            $ctx.walk.rows
        ]}
    />

    <Call
        module="call"
        in={{
            program: $in.program,
            returns_unit: $in.returns_unit
        }}
    />
</Module>
