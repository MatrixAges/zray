<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Entry} out={void} />

    <Call
        fn="prepare"
        in={{
            ...$in,
            proof: false
        }}
    />

    <Call
        module="call"
        in={{
            program: $in.program,
            returns_unit: $in.returns_unit
        }}
    />
</Module>
