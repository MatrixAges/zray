<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Entry} out={Program.Admission} />

    <If on={$in.type_only || $in.stores != 0}>
        <Return
            value={{
                steps: [],
                diagnostic: {
                    message:
                        "symbolic execution requires a pure executable function without Store capabilities",
                    unsupported: true
                }
            }}
        />
    </If>

    <Call
        fn="../parameter/walk"
        in={{
            types: $in.types,
            type_id: $in.input,
            path: "in",
            index: 0,
            proof: false,
            rows: []
        }}
    />

    <If on={$ctx.walk.diagnostic != null}>
        <Return
            value={{
                steps: [],
                diagnostic: {
                    message: $ctx.walk.diagnostic,
                    unsupported: true
                }
            }}
        />
    </If>

    <Call fn="hardware_steps" in={$in.returns_unit} />

    <Return
        value={{
            steps: $ctx.hardware_steps,
            rows: $ctx.walk.rows
        }}
    />
</Module>
