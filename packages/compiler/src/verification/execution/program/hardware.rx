<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Entry} out={Program.Diagnostic?} />

    <If on={$in.type_only || $in.stores != 0}>
        <Return
            value={{
                message:
                    "symbolic execution requires a pure executable function without Store capabilities",
                unsupported: true
            }}
        />
    </If>

    <Call
        fn="../parameter/walk"
        in={{
            types: $in.types,
            type_id: $in.input,
            path: "in",
            index: 0,
            proof: false,
            rows: []
        }}
    />

    <If on={$ctx.walk.diagnostic != null}>
        <Return
            value={{
                message: $ctx.walk.diagnostic,
                unsupported: true
            }}
        />
    </If>

    <Call
        fn="index.publishSymbolicParameter"
        in={[
            $in.program,
            $ctx.walk.rows
        ]}
    />

    <Call
        module="call"
        in={{
            program: $in.program,
            returns_unit: $in.returns_unit
        }}
    />

    <Return value={$ctx.call} />
</Module>
