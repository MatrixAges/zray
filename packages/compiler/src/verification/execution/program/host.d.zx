export type SymbolicProgram = mutable_opaque

export type Parameter = {
    type_id: u32,
    fields: u64,
    path?: string,
    symbol?: string,
    declaration?: string,
    domain?: string
}

export declare function ensureSymbolicGraph(program: SymbolicProgram): void
    throws { OutOfMemory }

export declare function beginSymbolicCall(program: SymbolicProgram): void

export declare function rejectSymbolicProgram(program: SymbolicProgram, message: string): void
    throws { InvalidSource }

export declare function symbolicProgramPreconditions(
    program: SymbolicProgram,
    called: bool
): string throws { OutOfMemory, InvalidSource }

export declare function markSymbolicQueryPrefix(program: SymbolicProgram): void

export declare function runSymbolicProgramBody(program: SymbolicProgram, path: string): string
    throws { OutOfMemory, InvalidSource }

export declare function checkSymbolicUnit(program: SymbolicProgram, path: string): void
    throws { OutOfMemory, InvalidSource }

export declare function appendSymbolicUnit(program: SymbolicProgram, path: string): void
    throws { OutOfMemory }

export declare function publishSymbolicQuery(program: SymbolicProgram, path: string): void
    throws { OutOfMemory, InvalidSource }

export declare function rejectSymbolicReturn(program: SymbolicProgram, message: string): void
    throws { InvalidSource }

export declare function publishSymbolicProgramResult(program: SymbolicProgram): bool
    throws { OutOfMemory, InvalidSource }

export declare function publishSymbolicParameter(
    program: SymbolicProgram,
    rows: Parameter[]
): void throws { OutOfMemory }
