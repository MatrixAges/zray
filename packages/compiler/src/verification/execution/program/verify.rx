<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Entry} out={Program.Verification} />

    <Call fn="index.ensureSymbolicGraph" in={$in.program} />

    <If on={$in.type_only || $in.stores != 0}>
        <Return
            value={{
                diagnostic: {
                    message:
                        "verification requires an executable pure function without Store capabilities",
                    unsupported: true
                }
            }}
        />
    </If>

    <Call
        fn="../parameter/walk"
        in={{
            types: $in.types,
            type_id: $in.input,
            path: "in",
            index: 0,
            proof: true,
            rows: []
        }}
    />

    <If on={$ctx.walk.diagnostic != null}>
        <Return
            value={{
                diagnostic: {
                    message: $ctx.walk.diagnostic,
                    unsupported: true
                }
            }}
        />
    </If>

    <Call
        fn="index.publishSymbolicParameter"
        in={[
            $in.program,
            $ctx.walk.rows
        ]}
    />

    <Call
        fn="index.symbolicProgramPreconditions"
        in={[
            $in.program,
            false
        ]}
    />

    <Call fn="index.symbolicQueryPrefix" in={$in.program} />

    <Call
        fn="index.runSymbolicProgramBody"
        in={[
            $in.program,
            $ctx.symbolicProgramPreconditions
        ]}
    />

    <If on={$in.returns_unit}>
        <Call
            fn="index.checkSymbolicUnit"
            in={[
                $in.program,
                $ctx.runSymbolicProgramBody
            ]}
        />
    </If>

    <Return
        value={{
            query: {
                path: $ctx.symbolicProgramPreconditions,
                prefix: $ctx.symbolicQueryPrefix
            }
        }}
    />
</Module>
