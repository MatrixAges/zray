import type { Table } from "core/type_table/model"
import type { Parameter } from "verification_program_host"

export type Ports = Table.Pick(
    "kinds",
    "first",
    "second",
    "children",
    "field_types",
    "field_names"
)

export enum Step {
    EnsureGraph,
    BeginCall,
    PublishParameter,
    EntryPreconditions,
    CallPreconditions,
    RunBody,
    CheckUnit,
    AppendUnit,
    Resolve,
    Merge
}

export type Entry = {
    types: Ports,
    input: u32,
    type_only: bool,
    stores: u64,
    returns_unit: bool,
    graph_ready: bool
}

export type Called = {
    returns_unit: bool,
    returned?: u64
}

export type Diagnostic = {
    message: string,
    unsupported: bool
}

export type Plan = {
    steps: Step[],
    diagnostic?: Diagnostic
}

export type Admission = Plan & {
    rows?: Parameter[]
}
