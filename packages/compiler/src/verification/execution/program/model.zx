import type { Table } from "core/type_table/model"
import type { SymbolicProgram } from "verification_program_host"

export type Ports = Table.Pick(
    "kinds",
    "first",
    "second",
    "children",
    "field_types",
    "field_names"
)

export type Entry = {
    program: SymbolicProgram,
    types: Ports,
    input: u32,
    type_only: bool,
    stores: u64,
    returns_unit: bool
}

export type Called = {
    program: SymbolicProgram,
    returns_unit: bool
}
