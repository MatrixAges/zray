import host from "verification_program_host"

import type { Body as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { program, path, called, returns_unit } = in

    const remaining = host.runSymbolicProgramBody(program, path)

    if (returns_unit) {
        host.checkSymbolicUnit(program, remaining)

        if (called) {
            host.appendSymbolicUnit(program, remaining)
        }
    }
}
