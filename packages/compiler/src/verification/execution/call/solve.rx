<Module>
    <Type from="model" as="Call" />
    <Type from="../expression/effect/model" as="Operation" />

    <Args in={Call.Solve} out={Operation.Value} />

    <Task name="probe" out={$ctx.run}>
        <Call
            module="../expression/effect/run"
            in={{
                step: Operation.Step.FindCall,
                row: $in.target,
                value: $in.argument
            }}
        />
    </Task>

    <If on={$ctx.task.probe.key == null}>
        <Return value={$ctx.task.probe.value} />
    </If>

    <Task name="execution" out={$ctx.run}>
        <Call
            module="../expression/effect/run"
            in={{
                step: Operation.Step.ExecuteCall,
                row: $in.target,
                value: $in.argument
            }}
        />
    </Task>

    <Task name="publish">
        <Call
            module="../expression/effect/run"
            in={{
                step: Operation.Step.PublishCall,
                key: $ctx.task.probe.key,
                value: $ctx.task.execution.value
            }}
        />
    </Task>

    <Return value={$ctx.task.execution.value} />
</Module>
