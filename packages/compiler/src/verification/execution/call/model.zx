import type { CallSafety, SymbolicExpression } from "verification_host"
import type { Input as Description } from "../../graph/call"

export type Input = Description & {
    frame: SymbolicExpression,
    argument: u32
}

export type Safety = CallSafety

export type Solve = {
    frame: SymbolicExpression,
    target: u32,
    argument_safe: string
}

export type Outcome = {
    safety?: CallSafety,
    diagnostic?: string
}
