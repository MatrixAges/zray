import host from "verification_host"

import admission from "../../graph/call"

import type { Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const rejection = admission(
        in.omit(
            [
                "call",
                "frame"
            ]
        )
    )

    if (rejection != null) {
        host.rejectSymbolicExpression(in.frame, rejection)
    }

    return host.evaluateSymbolicCallArgument(in.call)
}
