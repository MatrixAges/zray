import host from "verification_host"

import admission from "../../graph/call"

import type { Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const rejection = admission(in.omit(["call"]))

    if (rejection != null) {
        host.rejectSymbolicCall(in.call, rejection)
    }

    return host.evaluateSymbolicCallArgument(in.call)
}
