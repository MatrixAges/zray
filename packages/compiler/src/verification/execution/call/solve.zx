import host from "verification_host"

import type { CallSafety as Output } from "verification_host"
import type { Solve as Input } from "./model"

export default function (in: Input): Output {
    const { call, argument_safe } = in

    const cached = host.findSymbolicCallee(call)

    if (cached != null) {
        return {
            argument: argument_safe,
            callee: cached
        }
    }

    const evaluated = host.evaluateSymbolicCallee(call)

    host.publishSymbolicCallee(call)

    return {
        argument: argument_safe,
        callee: evaluated
    }
}
