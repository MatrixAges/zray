<Module>
    <Type from="model" as="Call" />
    <Type from="../expression/model" as="Expression" />
    <Type from="../expression/effect/model" as="Operation" />

    <Args in={Call.Input} out={Expression.Outcome} />

    <Call
        module="../expression/effect/run"
        in={{
            step: Operation.Step.DescribeCall,
            row: $in.target
        }}
    />

    <Call fn="../../graph/call" in={$ctx.run.description} />

    <If on={$ctx.call != null}>
        <Return
            value={{
                diagnostic: $ctx.call
            }}
        />
    </If>

    <Call module="../expression/evaluate" in={$in.argument} />

    <Call
        module="solve"
        in={{
            target: $in.target,
            argument: $ctx.evaluate
        }}
    />

    <Call
        fn="../../scalar/conjunction"
        in={{
            left: $ctx.evaluate.safe,
            right: $ctx.solve.safe
        }}
    />

    <Return
        value={{
            value: $ctx.solve,
            safe: $ctx.conjunction
        }}
    />
</Module>
