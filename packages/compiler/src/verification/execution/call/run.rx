<Module>
    <Type from="model" as="Call" />
    <Type from="host" as="Host" />

    <Args in={Call.Input} out={Call.Outcome} />

    <Call fn="prepare" in={$in} />

    <If on={$ctx.prepare != null}>
        <Return
            value={{
                diagnostic: $ctx.prepare
            }}
        />
    </If>

    <Call
        fn="host.evaluateSymbolicOperand"
        in={[
            $in.frame,
            Host.SymbolicOperand.First,
            $in.argument
        ]}
    />

    <Call
        module="solve"
        in={{
            frame: $in.frame,
            target: $in.target,
            argument_safe: $ctx.evaluateSymbolicOperand.safe
        }}
    />

    <Return
        value={{
            safety: $ctx.solve
        }}
    />
</Module>
