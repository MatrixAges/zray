import { ExpressionKind } from "core/expression_table/kinds"

import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { Layout } from "../../terms/layout"
import type { Value } from "./effect/model"

export { ExpressionKind } from "core/expression_table/kinds"

export type Types = Table.Pick("kinds", "first", "second")

export type Columns = Expressions.Pick(
    "kinds",
    "payloads",
    "types",
    "integers",
    "negative_integers",
    "enumerations",
    "booleans",
    "references",
    "projection_targets",
    "projection_indices",
    "unary_operators",
    "unary_operands",
    "binary_operators",
    "binary_left",
    "binary_right",
    "conditional_conditions",
    "conditional_yes",
    "conditional_no",
    "call_functions",
    "call_arguments",
    "match_first",
    "match_count",
    "match_subjects",
    "match_fallbacks",
    "match_conditions",
    "match_results",
    "sequence_first",
    "sequence_count",
    "sequence_items",
    "object_first",
    "object_count",
    "object_evaluation_first",
    "object_evaluation_count",
    "object_evaluation_values",
    "object_field_indices",
    "object_field_values"
)

export type Input = {
    columns: Columns,
    types: Types,
    id: u64,
    depth: u64,
    environment: Environment,
    layout: Layout
}

export type Environment = Value?[]

export type Payload = {
    columns: Columns,
    payload: u64
}

export type TypedPayload = Payload & {
    types: Types,
    type_id: u32
}

export type Selection = {
    condition: string,
    yes: Value,
    no: Value
}

export type Prepared = {
    kind: ExpressionKind,
    payload: u64,
    type_id: u32,
    first: u32,
    second: u32
}

export type Outcome = {
    scalar?: string,
    safe?: string,
    value?: Value,
    diagnostic?: string,
    contract?: string,
    fields?: AggregateField[]
}

export type AggregateField = {
    index: u32,
    text?: string,
    fields: u8[]
}
