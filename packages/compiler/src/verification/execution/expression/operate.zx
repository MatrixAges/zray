import { UnaryOperator } from "core/expression_table/kinds"
import host from "verification_host"
import { SymbolicOperand } from "verification_host"

import { unsupported_message } from "./const"

import type { Payload } from "./model"

export type Input = Payload & {
    unary: bool
}

export type Output = void

export default function (in: Input): Output {
    const { frame, columns, payload } = in

    if (in.unary) {
        const safe =
            host.evaluateSymbolicOperand(
                frame,
                SymbolicOperand.First,
                columns.unary_operands[payload]
            )

        if (
            !host.writeSymbolicUnary(
                frame,
                columns.unary_operators[payload] == UnaryOperator.Not
            )
        ) {
            host.rejectSymbolicExpression(frame, unsupported_message)
        }

        return
    }

    const left = columns.binary_left[payload]
    const left_safe = host.evaluateSymbolicOperand(frame, SymbolicOperand.First, left)

    const right_safe =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.Second,
            columns.binary_right[payload]
        )

    if (!host.writeSymbolicBinary(frame, left)) {
        host.rejectSymbolicExpression(frame, unsupported_message)
    }
}
