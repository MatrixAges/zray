<Module>
    <Type from="model" as="Operation" />

    <Args in={Operation.Effect} out={Operation.Result} />

    <Store from="operation" as="operation" />

    <Call
        fn="submit"
        in={{
            request: $in,
            previous: $store.operation.exchange
        }}
        setter={[$store.operation.exchange]}
    />

    <Call fn="read" in={$store.operation.exchange} />

    <Return value={$ctx.read} />
</Module>
