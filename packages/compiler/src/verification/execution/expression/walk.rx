<Module>
    <Type from="model" as="Expression" />

    <Args in={Expression.Input} out={Expression.Outcome} />

    <Call fn="depth" in={$in.depth} />

    <If on={$ctx.depth != null}>
        <Return
            value={{
                diagnostic: $ctx.depth
            }}
        />
    </If>

    <Call fn="prepare" in={$in} />

    <If
        on={
        $ctx.prepare.kind == Expression.ExpressionKind.Field ||
            $ctx.prepare.kind == Expression.ExpressionKind.TupleField
        }
    >
        <Call
            fn="project"
            in={{
                columns: $in.columns,
                payload: $ctx.prepare.payload
            }}
        />

        <Call
            fn="index.evaluateSymbolicOperand"
            in={[
                $in.frame,
                $ctx.project.slot,
                $ctx.project.expression
            ]}
        />

        <Return
            value={{
                scalar: null,
                safe: $ctx.evaluateSymbolicOperand.safe,
                projection: $ctx.project.index
            }}
        />
    </If>

    <Switch on={$ctx.prepare.kind}>
        <Case value={Expression.ExpressionKind.Reference}>
            <Call
                fn="index.loadSymbolicReference"
                in={[
                    $in.frame,
                    $ctx.prepare.first
                ]}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Integer}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.Integer
                }}
            />

            <Return value={$ctx.literal} />
        </Case>

        <Case value={Expression.ExpressionKind.NegativeInteger}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.NegativeInteger
                }}
            />

            <Return value={$ctx.literal} />
        </Case>

        <Case value={Expression.ExpressionKind.EnumValue}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.EnumValue
                }}
            />

            <Return value={$ctx.literal} />
        </Case>

        <Case value={Expression.ExpressionKind.Boolean}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.Boolean
                }}
            />

            <Return value={$ctx.literal} />
        </Case>

        <Case value={Expression.ExpressionKind.Unit}>
            <Call
                fn="index.reserveSymbolicAggregate"
                in={[
                    $in.frame,
                    0
                ]}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Unary}>
            <Call
                fn="unary"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id
                }}
            />

            <Return value={$ctx.unary} />
        </Case>

        <Case value={Expression.ExpressionKind.Binary}>
            <Call
                fn="binary_prepare"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id
                }}
            />

            <If on={$ctx.binary_prepare.operands != null}>
                <Call module="../../scalar/binary" in={$ctx.binary_prepare.operands} />

                <Call fn="binary_finish" />

                <Return value={$ctx.binary_finish} />
            </If>

            <Return
                value={{
                    diagnostic: $ctx.binary_prepare.diagnostic
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Call}>
            <Call
                fn="index.runSymbolicExpressionCall"
                in={[
                    $in.frame,
                    $ctx.prepare.first,
                    $ctx.prepare.second
                ]}
            />

            <Call
                fn="../../scalar/conjunction"
                in={{
                    left: $ctx.runSymbolicExpressionCall.argument,
                    right: $ctx.runSymbolicExpressionCall.callee
                }}
            />

            <Return
                value={{
                    safe: $ctx.conjunction
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Conditional}>
            <Call
                fn="conditional"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />

            <Return value={$ctx.conditional} />
        </Case>

        <Case value={Expression.ExpressionKind.Match}>
            <Call
                fn="match_value"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />

            <Return value={$ctx.match_value} />
        </Case>

        <Case value={Expression.ExpressionKind.Tuple}>
            <Call
                fn="aggregate"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    object: false
                }}
            />

            <Return value={$ctx.aggregate} />
        </Case>

        <Case value={Expression.ExpressionKind.Object}>
            <Call
                fn="aggregate"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    object: true
                }}
            />

            <Return value={$ctx.aggregate} />
        </Case>

        <Default>
            <Return
                value={{
                    diagnostic: "formal verification does not yet model this expression"
                }}
            />
        </Default>
    </Switch>

    <Return
        value={{
            scalar: null,
            safe: null
        }}
    />
</Module>
