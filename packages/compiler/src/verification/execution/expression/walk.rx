<Module>
    <Type from="model" as="Expression" />

    <Args in={Expression.Input} out={void} />

    <Call fn="prepare" in={$in} />

    <Switch on={$ctx.prepare.kind}>
        <Case value={Expression.ExpressionKind.Reference}>
            <Call
                fn="index.loadSymbolicReference"
                in={[
                    $in.frame,
                    $ctx.prepare.first
                ]}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Integer}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.Integer
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.NegativeInteger}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.NegativeInteger
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.EnumValue}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.EnumValue
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Boolean}>
            <Call
                fn="literal"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id,
                    kind: Expression.ExpressionKind.Boolean
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Unit}>
            <Call
                fn="index.reserveSymbolicAggregate"
                in={[
                    $in.frame,
                    0
                ]}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Field}>
            <Call
                fn="project"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.TupleField}>
            <Call
                fn="project"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Unary}>
            <Call
                fn="unary"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Binary}>
            <Call
                fn="binary_prepare"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    types: $in.types,
                    type_id: $ctx.prepare.type_id
                }}
            />

            <Call module="../../scalar/binary" />

            <Call
                fn="binary_finish"
                in={{
                    frame: $in.frame,
                    result: $ctx.binary
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Call}>
            <Call
                fn="index.runSymbolicExpressionCall"
                in={[
                    $in.frame,
                    $ctx.prepare.first,
                    $ctx.prepare.second
                ]}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Conditional}>
            <Call
                fn="conditional"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Match}>
            <Call
                fn="match_value"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Tuple}>
            <Call
                fn="aggregate"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    object: false
                }}
            />
        </Case>

        <Case value={Expression.ExpressionKind.Object}>
            <Call
                fn="aggregate"
                in={{
                    frame: $in.frame,
                    columns: $in.columns,
                    payload: $ctx.prepare.payload,
                    object: true
                }}
            />
        </Case>

        <Default>
            <Call
                fn="index.rejectSymbolicExpression"
                in={[
                    $in.frame,
                    "formal verification does not yet model this expression"
                ]}
            />
        </Default>
    </Switch>
</Module>
