import integers from "std:integer"
import host from "verification_host"
import { SymbolicOperand } from "verification_host"

import connect from "../../predicate/connect"
import guarded from "../../predicate/guard"
import { Operator } from "../../predicate/model"
import conjunction from "../../scalar/conjunction"
import { unsupported_message } from "./const"

import type { SymbolicOutcome } from "verification_host"
import type { Outcome as Output, Payload as Input } from "./model"

export default function (in: Input): Output {
    const { frame, columns, payload } = in

    const subject = columns.match_subjects[payload]

    const subject_value: SymbolicOutcome? = match {
        subject == null => null,
        _ => host.evaluateSymbolicOperand(frame, SymbolicOperand.Third, subject)
    }

    if (subject_value != null && subject_value.text == null) {
        return {
            diagnostic: unsupported_message
        }
    }

    const subject_text: string? = subject_value == null ? null : subject_value.text

    const fallback =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.Result,
            columns.match_fallbacks[payload]
        )

    const first = integers.widen(columns.match_first[payload])
    const end = first + integers.widen(columns.match_count[payload])

    const combined = loop({
        row: end,
        no_safe: fallback.safe,
        supported: true
    }, {
        while: state => state.supported && state.row > first,
        next: state => {
            state.row -= 1

            const test =
                host.evaluateSymbolicOperand(
                    frame,
                    SymbolicOperand.First,
                    columns.match_conditions[state.row]
                )
            const yes =
                host.evaluateSymbolicOperand(
                    frame,
                    SymbolicOperand.Second,
                    columns.match_results[state.row]
                )
            const test_text = test.text

            if (test_text != null) {
                const condition = match {
                    subject_text == null => test_text,
                    _ => connect({
                        operator: Operator.Equal,
                        left: subject_text,
                        right: test_text
                    })
                }

                host.selectSymbolicExpression(
                    frame,
                    condition,
                    SymbolicOperand.Second,
                    SymbolicOperand.Result
                )
                const safe = guarded({
                    condition,
                    safe: test.safe,
                    yes: yes.safe,
                    no: state.no_safe
                })

                state.no_safe = host.retainSymbolicExpression(frame, safe)
            } else {
                state.supported = false
            }
        }
    })

    if (!combined.supported) {
        return {
            diagnostic: unsupported_message
        }
    }

    if (subject_value != null) {
        return {
            scalar: null,
            safe: conjunction({
                left: subject_value.safe,
                right: combined.no_safe
            })
        }
    }

    return {
        scalar: null,
        safe: combined.no_safe
    }
}
