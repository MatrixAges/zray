import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import host from "verification_host"

import aggregate from "./aggregate"
import choose from "./conditional"
import { depth_message, max_depth, unsupported_message } from "./const"
import literal from "./literal"
import matchValue from "./match_value"
import operate from "./operate"
import project from "./project"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { frame, columns, id } = in

    if (in.depth >= max_depth) {
        host.rejectSymbolicExpression(frame, depth_message)

        return
    }

    const payload = integers.widen(columns.payloads[id])

    const row = {
        frame,
        columns,
        payload
    }

    const kind = columns.kinds[id]

    return match kind {
        ExpressionKind.Reference =>
            host.loadSymbolicReference(frame, columns.references[payload]),
        ExpressionKind.Integer => literal({
            ...row,
            kind
        }),
        ExpressionKind.NegativeInteger => literal({
            ...row,
            kind
        }),
        ExpressionKind.EnumValue => literal({
            ...row,
            kind
        }),
        ExpressionKind.Boolean => literal({
            ...row,
            kind
        }),
        ExpressionKind.Unit => host.reserveSymbolicAggregate(frame, 0),
        ExpressionKind.Field => project(row),
        ExpressionKind.TupleField => project(row),
        ExpressionKind.Unary => operate({
            ...row,
            unary: true
        }),
        ExpressionKind.Binary => operate({
            ...row,
            unary: false
        }),
        ExpressionKind.Call => host.runSymbolicExpressionCall(
            frame,
            columns.call_functions[payload],
            columns.call_arguments[payload]
        ),
        ExpressionKind.Conditional => choose(row),
        ExpressionKind.Match => matchValue(row),
        ExpressionKind.Tuple => aggregate({
            ...row,
            object: false
        }),
        ExpressionKind.Object => aggregate({
            ...row,
            object: true
        }),
        _ => host.rejectSymbolicExpression(frame, unsupported_message)
    }
}
