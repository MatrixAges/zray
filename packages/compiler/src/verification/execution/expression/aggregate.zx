import integers from "std:integer"
import host from "verification_host"
import { SymbolicOperand } from "verification_host"

import conjunction from "../../scalar/conjunction"
import { smt_true } from "../../scalar/const"
import watch from "./watch"

import type { Outcome as Output, Payload } from "./model"

export type Input = Payload & {
    object: bool
}

export default function (in: Input): Output {
    const { frame, columns, payload, object } = in

    const count = match object {
        true => columns.object_count[payload],
        _ => columns.sequence_count[payload]
    }

    host.reserveSymbolicAggregate(frame, count)

    const safe = match object {
        true => watch({
            frame,
            values: columns.object_evaluation_values,
            first: columns.object_evaluation_first[payload],
            count: columns.object_evaluation_count[payload]
        }),
        _ => smt_true
    }

    const first = integers.widen(
        match object {
            true => columns.object_first[payload],
            _ => columns.sequence_first[payload]
        }
    )

    const completed = loop({
        field: 0,
        safe
    }, {
        while: state => state.field < integers.widen(count),
        next: state => {
            const row = first + state.field
            const value = match object {
                true => columns.object_field_values[row],
                _ => columns.sequence_items[row]
            }
            const index = match object {
                true => columns.object_field_indices[row],
                _ => integers.narrow(state.field)
            }
            const safe =
                host.evaluateSymbolicOperand(frame, SymbolicOperand.First, value).safe

            host.writeSymbolicAggregateField(frame, index)

            const checked = conjunction({
                left: state.safe,
                right: safe
            })
            state.safe = host.bindSymbolicExpressionSafety(frame, checked)
            state.field += 1
        },
        return: state => state.safe
    })

    return {
        scalar: null,
        safe: completed
    }
}
