import type { Value } from "../effect/model"
import type { Walk } from "./model"

export type Input = {
    walk: Walk,
    index?: u32,
    value: Value,
    safe: string
}

export type Output = Walk

export default function (in: Input): Output {
    const { walk, index, value, safe } = in

    const fields = match {
        index == null => walk.fields,
        _ => walk.fields.push({
            index,
            text: value.text,
            fields: value.fields
        })[0]
    }

    return {
        ...walk,
        fields,
        safe,
        field: walk.field + 1
    }
}
