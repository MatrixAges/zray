import host from "verification_host"
import { SymbolicOperand } from "verification_host"

import type { Payload as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { frame, columns, payload } = in

    const safe =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.First,
            columns.projection_targets[payload]
        ).safe

    host.projectSymbolicOperand(frame, columns.projection_indices[payload])
}
