import integers from "std:integer"

import type { Payload } from "./model"

export type Input = Payload.Pick("columns", "payload")

export type Output = {
    expression: u32,
    index: u64,
}

export default function (in: Input): Output {
    const { columns, payload } = in

    return {
        expression: columns.projection_targets[payload],
        index: integers.widen(columns.projection_indices[payload])
    }
}
