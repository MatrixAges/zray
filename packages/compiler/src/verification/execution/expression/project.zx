import { SymbolicOperand } from "verification_host"

import type { Payload } from "./model"

export type Input = Payload.Pick("columns", "payload")

export type Output = {
    expression: u32,
    index: u32,
    slot: SymbolicOperand
}

export default function (in: Input): Output {
    const { columns, payload } = in

    return {
        expression: columns.projection_targets[payload],
        index: columns.projection_indices[payload],
        slot: SymbolicOperand.First
    }
}
