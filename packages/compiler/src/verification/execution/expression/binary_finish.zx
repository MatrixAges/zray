import host from "verification_host"

import { unsupported_message } from "./const"

import type { BinaryFinish as Input, Outcome as Output } from "./model"

export default function (in: Input): Output {
    const { frame, result } = in

    const value = result.value

    if (value == null) {
        host.rejectSymbolicExpression(frame, unsupported_message)

        return {
            scalar: null,
            safe: null
        }
    }

    return {
        scalar: value,
        safe: result.safe
    }
}
