import { unsupported_message } from "./const"

import type { Result as Input } from "../../scalar/model"
import type { Outcome as Output } from "./model"

export default function (in: Input): Output {
    const { value, safe } = in

    if (value == null) {
        return {
            diagnostic: unsupported_message
        }
    }

    return {
        scalar: value,
        safe
    }
}
