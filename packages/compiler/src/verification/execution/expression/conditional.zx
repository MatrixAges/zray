import host from "verification_host"
import { SymbolicOperand } from "verification_host"

import guarded from "../../predicate/guard"
import { unsupported_message } from "./const"

import type { Outcome as Output, Payload as Input } from "./model"

export default function (in: Input): Output {
    const { frame, columns, payload } = in

    const first =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.First,
            columns.conditional_conditions[payload]
        )

    const yes =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.Second,
            columns.conditional_yes[payload]
        )

    const no =
        host.evaluateSymbolicOperand(
            frame,
            SymbolicOperand.Third,
            columns.conditional_no[payload]
        )

    const condition = first.text

    if (condition == null) {
        host.rejectSymbolicExpression(frame, unsupported_message)

        return {
            scalar: null,
            safe: null
        }
    }

    host.selectSymbolicExpression(
        frame,
        condition,
        SymbolicOperand.Second,
        SymbolicOperand.Third
    )

    return {
        scalar: null,
        safe: guarded({
            condition,
            safe: first.safe,
            yes: yes.safe,
            no: no.safe
        })
    }
}
