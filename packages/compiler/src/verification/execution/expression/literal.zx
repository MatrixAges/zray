import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import encode from "../../predicate/literal"
import { smt_false, smt_true } from "../../scalar/const"
import enumWidth from "../../scalar/enum_width"
import numeric from "../../scalar/numeric"

import type { Outcome as Output, TypedPayload } from "./model"

export type Input = TypedPayload & {
    kind: ExpressionKind
}

export default function (in: Input): Output {
    const { columns, payload, types, type_id, kind } = in

    if (kind == ExpressionKind.Boolean) {
        return {
            scalar: columns.booleans[payload] ? smt_true : smt_false,
            safe: null
        }
    }

    const enumeration = kind == ExpressionKind.EnumValue
    const type_row = integers.widen(type_id)

    const width = match enumeration {
        true => enumWidth(types.second[type_row]),
        _ => numeric(types.first[type_row]).width
    }

    const value = match kind {
        ExpressionKind.EnumValue => integers.widen(columns.enumerations[payload]),
        ExpressionKind.NegativeInteger => columns.negative_integers[payload],
        _ => columns.integers[payload]
    }

    const text = encode({
        value,
        width,
        negative: kind == ExpressionKind.NegativeInteger
    })

    return {
        scalar: text,
        safe: null
    }
}
