import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import memory from "memory"
import columns from "memory/columns"
import host from "verification_host"

import choose from "../../predicate/choose"

import type { Table } from "core/type_table/model"
import type { SelectionGraph, SymbolicTarget } from "verification_host"
import type { Layout } from "../../terms/layout"

export type Input = {
    graph: SelectionGraph,
    types: Table,
    type_id: u32,
    condition: string,
    yes: u8[],
    no: u8[],
    layout: Layout,
    result: SymbolicTarget
}

export type Output = bool

export default function select(in: Input): Output {
    const { graph, types, type_id, condition, yes, no, layout, result } = in

    const yes_text = columns.readBorrowedRowOptionalText(yes, layout.text)
    const no_text = columns.readBorrowedRowOptionalText(no, layout.text)

    if (yes_text != null && no_text != null) {
        const text = choose({
            condition,
            yes: yes_text,
            no: no_text
        })

        host.publishSymbolicText(graph, result, type_id, text)

        return true
    }

    if (yes_text != null || no_text != null) {
        return false
    }

    const width = layout.width
    const left = columns.readBorrowedRowList(yes, layout.children, width)
    const right = columns.readBorrowedRowList(no, layout.children, width)
    const count = left.length / width

    if (left.length != right.length) {
        return false
    }

    if (count == 0 || columns.sameBorrowedBytes(left, right)) {
        host.reuseSymbolicFields(result, yes)

        return true
    }

    host.reserveSymbolicFields(graph, result, count)

    const row = integers.widen(type_id)
    const object = kind(types.kinds[row]) == Kind.Object
    const first = integers.widen(types.first[row])
    const children = object ? types.field_types : types.children

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            const index = state.index
            const offset = index * width

            state.valid = select({
                graph,
                types,
                type_id: children[first + index],
                condition,
                yes: memory.borrowU8Range(left, offset, width),
                no: memory.borrowU8Range(right, offset, width),
                layout,
                result: host.targetSymbolicField(result, index)
            })
            state.index += 1
        },
        return: state => state.valid
    })
}
