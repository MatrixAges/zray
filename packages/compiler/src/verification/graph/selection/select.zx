import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import memory from "memory"
import columns from "memory/columns"

import choose from "../../predicate/choose"
import { Action } from "./model"

import type { Input, Output, Step } from "./model"

export type { Input, Output } from "./model"

export default function select(in: Input): Output {
    const { types, type_id, condition, yes, no, layout } = in

    const steps: Step[] = in.steps ?? []

    const destination = in.destination ?? {
        parent: null,
        member: 0
    }

    const yes_text = columns.readBorrowedRowOptionalText(yes, layout.text)
    const no_text = columns.readBorrowedRowOptionalText(no, layout.text)

    if (yes_text != null && no_text != null) {
        const text = choose({
            condition,
            yes: yes_text,
            no: no_text
        })

        return {
            steps: steps.push({
                destination,
                action: Action.Text,
                type_id,
                text: match {
                    text == yes_text => yes_text,
                    text == no_text => no_text,
                    _ => text
                },
                transient: text != yes_text && text != no_text,
                count: 0
            })[0],
            valid: true
        }
    }

    if (yes_text != null || no_text != null) {
        return {
            steps,
            valid: false
        }
    }

    const width = layout.width
    const left = columns.readBorrowedRowList(yes, layout.children, width)
    const right = columns.readBorrowedRowList(no, layout.children, width)
    const count = left.length / width

    if (left.length != right.length) {
        return {
            steps,
            valid: false
        }
    }

    if (count == 0 || columns.sameBorrowedBytes(left, right)) {
        return {
            steps: steps.push({
                destination,
                action: Action.Reuse,
                type_id,
                source: yes,
                count
            })[0],
            valid: true
        }
    }

    const parent = steps.length
    const row = integers.widen(type_id)
    const object = kind(types.kinds[row]) == Kind.Object
    const first = integers.widen(types.first[row])
    const children = object ? types.field_types : types.children

    return loop({
        index: 0,
        valid: true,
        steps: steps.push({
            destination,
            action: Action.Allocate,
            type_id,
            count
        })[0]
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            const index = state.index
            const offset = index * width

            const planned = select({
                types,
                type_id: children[first + index],
                condition,
                yes: memory.borrowU8Range(left, offset, width),
                no: memory.borrowU8Range(right, offset, width),
                layout,
                destination: {
                    parent,
                    member: index
                },
                steps: state.steps
            })

            state.steps = planned.steps
            state.valid = planned.valid
            state.index += 1
        },
        return: state => state.pick([
            "steps",
            "valid"
        ])
    })
}
