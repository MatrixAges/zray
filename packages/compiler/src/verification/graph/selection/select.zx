import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import host from "verification_host"

import choose from "../../predicate/choose"

import type { Table } from "core/type_table/model"
import type { SelectionGraph, SymbolicValue, SymbolicTarget } from "verification_host"

export type Input = {
    graph: SelectionGraph,
    types: Table,
    type_id: u32,
    condition: string,
    yes: SymbolicValue,
    no: SymbolicValue,
    result: SymbolicTarget
}

export type Output = bool

export default function select(in: Input): Output {
    const { graph, types, type_id, condition, yes, no, result } = in

    const yes_text = host.symbolicText(yes)
    const no_text = host.symbolicText(no)

    if (yes_text != null && no_text != null) {
        const text = choose({
            condition,
            yes: yes_text,
            no: no_text
        })

        host.publishSymbolicText(graph, result, type_id, text)

        return true
    }

    if (yes_text != null || no_text != null) {
        return false
    }

    const count = host.symbolicFieldCount(yes)

    if (count != host.symbolicFieldCount(no)) {
        return false
    }

    if (count == 0 || host.sameSymbolicFields(yes, no)) {
        host.reuseSymbolicFields(result, yes)

        return true
    }

    host.reserveSymbolicFields(graph, result, count)

    const row = integers.widen(type_id)
    const object = kind(types.kinds[row]) == Kind.Object
    const first = integers.widen(types.first[row])
    const children = object ? types.field_types : types.children

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            const index = state.index

            state.valid = select({
                graph,
                types,
                type_id: children[first + index],
                condition,
                yes: host.symbolicField(yes, index),
                no: host.symbolicField(no, index),
                result: host.targetSymbolicField(result, index)
            })
            state.index += 1
        },
        return: state => state.valid
    })
}
