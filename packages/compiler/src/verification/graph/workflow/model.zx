import type { DefinitionFailure } from "verification_publication_host"
import type { CommitResult, Identity, Lookup, Origin, Selection } from "../model"

export type Input = {
    lookup: Lookup,
    origin: Origin,
    expression: string,
    names: string[]
}

export type Bind = Input & {
    selected: Selection
}

export type Definition = Identity & CommitResult & {
    resized: bool
}

export type Output = {
    name?: string,
    definition?: Definition,
    failure?: DefinitionFailure
}
