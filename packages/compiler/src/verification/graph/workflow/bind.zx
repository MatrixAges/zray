import commit from "../commit"
import { definition_limit_message } from "../const"
import identity from "../identity"
import { Action } from "../model"

import type { Bind as Input, Output } from "./model"

export default function (in: Input): Output {
    const { lookup, names, selected } = in

    if (selected.action == Action.Atom || selected.action == Action.Reuse) {
        const name = match selected.action {
            Action.Atom => in.expression,
            _ => names[selected.position]
        }

        return {
            name
        }
    }

    if (selected.action != Action.Append) {
        return {
            failure: {
                message: selected.action == Action.Limit ? definition_limit_message : null
            }
        }
    }

    const resized = selected.capacity != lookup.capacity
    const created = identity(in.origin)

    const committed = commit({
        keys: lookup.keys,
        key: lookup.key,
        capacity: selected.capacity,
        position: selected.position,
        resized
    })

    return {
        name: created.name,
        definition: {
            ...created,
            ...committed,
            resized
        }
    }
}
