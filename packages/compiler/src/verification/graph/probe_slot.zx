import bytes from "std:bytes"
import integers from "std:integer"

export type Input = {
    buckets: u64[],
    keys: u8[][],
    capacity: u64,
    key: u8[]
}

export type Output = u64

export default function (in: Input): Output {
    const { buckets, keys, capacity, key } = in

    const mask = capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(key), mask),
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const row = buckets[state.slot]

            if (row == 0 || bytes.equals(keys[row - 1], key)) {
                state.done = true
            } else {
                state.slot = integers.andBits(state.slot + 1, mask)
            }
        },
        return: state => state.slot
    })
}
