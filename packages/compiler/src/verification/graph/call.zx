import recursive from "../../zx/modules/forward_entry/recursive"
import {
    max_call_depth,
    store_call_message,
    external_call_message,
    recursive_call_message,
    call_limit_message
} from "./const"

export type Input = {
    calls: u32[],
    target: u32,
    stores: u64,
    external: bool,
    depth: u64
}

export type Output = string?

export default function (in: Input): Output {
    if (in.stores != 0) {
        return store_call_message
    }

    if (in.external) {
        return external_call_message
    }

    const candidate = recursive({
        calls: in.calls,
        candidate: in.target
    })

    return match {
        candidate != null => recursive_call_message,
        in.depth >= max_call_depth => call_limit_message,
        _ => null
    }
}
