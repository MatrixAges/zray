import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

export type Input = {
    kinds: ExpressionKind[],
    payloads: u32[],
    functions: u32[],
    target: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { kinds, payloads, functions, target } = in

    if (functions.length == 0) {
        return false
    }

    return loop({
        index: 0,
        recursive: false
    }, {
        while: state => !state.recursive && state.index < kinds.length,
        next: state => {
            if (kinds[state.index] == ExpressionKind.Call) {
                const payload = integers.widen(payloads[state.index])

                state.recursive = functions[payload] == target
            }

            state.index += 1
        },
        return: state => state.recursive
    })
}
