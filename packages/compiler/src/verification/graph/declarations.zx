import bytes from "std:bytes"
import integers from "std:integer"
import { ascii_space, ascii_close_paren } from "core/ascii/const"

import { declaration_end } from "./const"

import type { Writer } from "std:bytes"

export type Input = {
    names: string[],
    expressions: string[],
    widths: u16[],
    writer: Writer
}

export type Output = void

export default function (in: Input): Output {
    const { names, expressions, widths, writer } = in

    const written = loop({
        index: 0
    }, {
        while: state => state.index < names.length,
        next: state => {
            const name = names[state.index]
            const expression = expressions[state.index]
            const width = widths[state.index]

            const prefix = templateFile("./templates/declaration.tpl")
            const boolean = templateFile("./templates/boolean.tpl")
            const bitvector = templateFile("./templates/bitvector.tpl")

            bytes.write(writer, bytes.fromText(prefix))
            bytes.writeByte(writer, ascii_space)
            bytes.write(writer, bytes.fromText(name))

            if (width == 0) {
                bytes.write(writer, bytes.fromText(boolean))
            } else {
                bytes.write(writer, bytes.fromText(bitvector))
                bytes.writeByte(writer, ascii_space)
                bytes.writeDecimalU64(writer, integers.widenShort(width))
                bytes.writeByte(writer, ascii_close_paren)
            }

            bytes.writeByte(writer, ascii_space)
            bytes.write(writer, bytes.fromText(expression))
            bytes.write(writer, bytes.fromText(declaration_end))

            state.index += 1
        }
    })
}
