import strings from "std:string"

export type Input = {
    names: string[],
    expressions: string[],
    widths: u16[],
    first: u64,
    end: u64
}

export type Output = string

export default function (in: Input): Output {
    const { names, expressions, widths } = in

    const lines: string[] = []

    const collected = loop({
        index: in.first,
        lines
    }, {
        while: state => state.index < in.end,
        next: state => {
            const name = names[state.index]
            const expression = expressions[state.index]
            const width = widths[state.index]

            const line = match width {
                0 => templateFile("./templates/boolean.tpl"),
                _ => templateFile("./templates/bitvector.tpl")
            }

            state.lines = state.lines.push(line)[0]
            state.index += 1
        },
        return: state => state.lines
    })

    if (collected.length == 0) {
        return ""
    }

    return strings.join("\n", collected.push("")[0])
}
