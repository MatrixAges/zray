import probeSlot from "./probe_slot"

import type { Commit as Input, CommitResult as Output } from "./model"

export default function (in: Input): Output {
    const { keys, key, capacity } = in

    if (!in.resized) {
        return {
            buckets: [],
            slot: in.position,
            value: keys.length + 1
        }
    }

    const empty: u64[] = []

    const initialized = loop(empty, {
        while: buckets => buckets.length < capacity,
        next: buckets => {
            buckets = buckets.push(0)[0]
        }
    })

    const rebuilt = loop({
        row: 0,
        buckets: initialized
    }, {
        while: state => state.row < keys.length,
        next: state => {
            const row = state.row
            const slot = probeSlot({
                buckets: state.buckets,
                keys,
                capacity,
                key: keys[row]
            })

            state.buckets[slot] = row + 1
            state.row += 1
        },
        return: state => state.buckets
    })

    const located = probeSlot({
        buckets: rebuilt,
        keys,
        capacity,
        key
    })

    const buckets = rebuilt.splice(located, 1, [keys.length + 1])[0]

    return {
        buckets,
        slot: located,
        value: keys.length + 1
    }
}
