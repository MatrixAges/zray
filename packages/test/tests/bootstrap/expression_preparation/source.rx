<Module>
    <Call module="../../zx/frontend/lexical" in={$in} />

    <Call
        fn="../../zx/frontend/parser/expressions/prepare/scan"
        in={$ctx.lexical.lexed.tokens}
    />

    <Call
        fn="../../zx/frontend/parser/expressions/prepare/interpolations"
        in={$ctx.lexical.interpolations}
    />

    <Return
        value={{
            source: $in,
            lexical: $ctx.lexical,
            hints: $ctx.scan,
            interpolation_hints: $ctx.interpolations
        }}
    />
</Module>
