<Module>
    <Switch on={$in.enabled}>
        <Case value={true}>
            <Task name="once">
                <Call module="./leaf.rx" in={$in.values} />

                <Call fn="pop_values" />

                <Return value={$ctx.pop_values} />
            </Task>
        </Case>

        <Default>
            <Task name="twice">
                <Call module="./leaf.rx" in={$in.values} />

                <Call module="./leaf_again.rx" />

                <Call fn="pop_values" />

                <Return value={$ctx.pop_values} />
            </Task>
        </Default>
    </Switch>
</Module>
