<Module>
    <Type from="model" as="Range" />

    <Args in={Range.Input} out={u8[][]?} />

    <Call
        fn="count"
        in={{
            first: $in.source.first,
            available: $in.source.declarations.tags.length,
            count: $in.count
        }}
    />

    <If on={$ctx.count != null}>
        <Call
            fn="../chunks"
            in={{
                ...$in.source,
                count: $ctx.count
            }}
        />

        <Return value={$ctx.chunks} />
    </If>

    <Return value={null} />
</Module>
