<Module>
    <Type from="model" as="Range" />

    <Args in={Range.Input} out={u8[][]?} />

    <Call
        fn="count"
        in={{
            first: $in.first,
            available: $in.ast[0].declarations.tags.length,
            count: $in.count
        }}
    />

    <If on={$ctx.count != null}>
        <Call
            fn="../chunks"
            in={{
                ast: $in.ast,
                first: $in.first,
                count: $ctx.count
            }}
        />

        <Return value={$ctx.chunks} />
    </If>

    <Return value={null} />
</Module>
