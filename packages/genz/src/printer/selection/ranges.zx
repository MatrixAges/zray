import columns from "memory/columns"

import one from "./one"

import type { Destination, Ranges } from "./model"

export type Input = Destination & {
    ranges: Ranges
}

export type Output = u8[][]

export default function (in: Input): Output {
    const { ast, ranges } = in

    const chunks: u8[][] = []

    return loop({
        index: 0,
        chunks
    }, {
        while: state => state.index < ranges.count,
        next: state => {
            const first = columns.readColumnU32(ranges.starts, state.index)
            const count = columns.readColumnU32(ranges.lengths, state.index)

            const range = loop({
                row: first,
                chunks: state.chunks
            }, {
                while: current => current.row - first < count,
                next: current => {
                    const chunk = one({
                        ast,
                        row: current.row
                    })

                    current.chunks = current.chunks.push(chunk)[0]
                    current.row += 1
                },
                return: current => current.chunks
            })

            state.chunks = range
            state.index += 1
        },
        return: state => state.chunks
    })
}
