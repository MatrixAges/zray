import bytes from "std:bytes"

import chunks from "../chunks"

import type { Destination } from "./model"

export type Input = Destination & {
    row: u32
}

export type Output = u8[]

export default function (in: Input): Output {
    const rendered = chunks({
        ast: in.ast,
        first: in.row,
        count: 1
    })

    return bytes.join([], rendered)
}
