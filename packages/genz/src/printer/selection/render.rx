<Module>
    <Type from="model" as="Printer" />

    <Args in={Printer.SourceSelection} out={u8[][]?} />

    <If on={$in.ranges != null}>
        <Call
            fn="ranges"
            in={{
                target: {
                    source: $in.source
                },
                ranges: $in.ranges
            }}
        />

        <Return value={$ctx.ranges} />
    </If>

    <If on={$in.indices != null}>
        <Call
            fn="indices"
            in={{
                target: {
                    source: $in.source
                },
                indices: $in.indices
            }}
        />

        <Return value={$ctx.indices} />
    </If>

    <Return value={[]} />
</Module>
