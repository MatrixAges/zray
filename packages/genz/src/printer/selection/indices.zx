import integers from "std:integer"

import one from "./one"

import type { Destination } from "./model"

export type Input = Destination & {
    indices: u32[]
}

export type Output = u8[][]?

export default function (in: Input): Output {
    const { ast, indices } = in

    const count = ast[0].declarations.tags.length

    const valid = loop({
        position: 0,
        valid: true
    }, {
        while: state => state.position < indices.length && state.valid,
        next: state => {
            state.valid = integers.widen(indices[state.position]) < count
            state.position += 1
        },
        return: state => state.valid
    })

    if (!valid) {
        return null
    }

    return indices.map(row => one({
        ast,
        row
    }))[0]
}
