import integers from "std:integer"

import one from "./one"

import type { Destination } from "./model"

export type Input = {
    target: Destination,
    indices: u32[]
}

export type Output = bool

export default function (in: Input): Output {
    const { target, indices } = in

    const count = target.source.declarations.tags.length

    const valid = loop({
        position: 0,
        valid: true
    }, {
        while: state => state.position < indices.length && state.valid,
        next: state => {
            state.valid = integers.widen(indices[state.position]) < count
            state.position += 1
        },
        return: state => state.valid
    })

    if (!valid) {
        return false
    }

    const rendered = loop(0, {
        while: position => position < indices.length,
        next: position => {
            one({
                ...target,
                row: indices[position]
            })

            position += 1
        }
    })

    return true
}
