import type { ByteWriter } from "memory"
import type { Source, State } from "./model"

export type Input = {
    source: Source,
    output: ByteWriter
}

export type Output = State

export default function (in: Input): Output {
    return {
        source: in.source,
        stack: [],
        output: in.output,
        depth: 0,
        next: 0
    }
}
