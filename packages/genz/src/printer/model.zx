import type { Declarations } from "./model/declarations"
import type { Expressions } from "./model/expressions"
import type { Fields, Arms } from "./model/members"
import type { Statements } from "./model/statements"
import type { Token } from "./model/token"

export type Ast = {
    expressions: Expressions
    statements: Statements
    declarations: Declarations
    fields: Fields
    arms: Arms
}

export type Range = {
    first: u32
    count: u32
}

export type Source = Ast & Range

export type Render = {
    source: Source
}

export type Published = Source & {
    valid: bool
}

export enum Action {
    Text,
    Identifier,
    BindingIdentifier,
    Quoted,
    Integer,
    Expression,
    Statement,
    Block,
    Declaration,
    Field,
    Parameter,
    ObjectField,
    Arm,
    Indent,
    Enter,
    Leave
}

export enum ByteSource {
    None,
    ExpressionIdentifier,
    ExpressionString,
    EnumLiteral,
    ErrorValue,
    FieldName,
    BlockLabel,
    CatchCapture,
    CatchLabel,
    CatchScopeCapture,
    ConditionalCapture,
    ConditionalErrorCapture,
    EnumMember,
    ErrorMember,
    ErrorUnionMember,
    MemberName,
    ArmCapture,
    StatementConstant,
    StatementVariable,
    DeclarationConstant,
    DeclarationVariable,
    DeclarationField,
    FunctionName,
    ForCapture,
    ForIndexCapture,
    WhileCapture,
    BranchCapture,
    BranchErrorCapture,
    BreakLabel
}

export type Frame = {
    action: Action
    id: u32
    count: u32
    token: Token
    bytes: ByteSource
    index: u64
    number: u64
}

// The slice shares one read-only AST table across all frames.
export type Step = {
    ast: Ast[],
    frame: Frame
}
