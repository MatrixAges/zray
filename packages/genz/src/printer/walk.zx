import { ascii_at } from "core/ascii/const"
import { ascii_underscore } from "core/const"
import memory from "memory"

import { indentation } from "../const"
import block from "./block"
import declaration from "./declaration"
import expression from "./expression"
import member from "./member"
import { Action, ByteSource } from "./model"
import { Token } from "./model/token"
import statement from "./statement"
import identifier from "./text/identifier"
import quoted from "./text/quoted"
import source from "./text/source"
import token from "./text/token"
import integer from "./text/write_integer"

import type { Frame, State } from "./model"

export type Input = State

export type Output = void

export default function (in: Input): Output {
    const result = loop(in, {
        while: current =>
            current.next < current.source.count || current.stack.length != 0,
        next: current => {
            const root = current.stack.length == 0
            const frame: Frame = match {
                root => {
                    action: Action.Declaration,
                    token: Token.Empty,
                    bytes: ByteSource.None,
                    id: current.source.first + current.next,
                    count: 0,
                    index: 0,
                    number: 0
                },
                _ => current.stack[current.stack.length - 1]
            }

            if (root) {
                if (current.next != 0) {
                    memory.appendText(current.output, token(Token.Newline))
                }

                current.next += 1
            } else {
                current.stack = current.stack.pop()[0]
            }

            if (frame.action == Action.Text) {
                memory.appendText(current.output, token(frame.token))
            } else {
                const condition = (
                    match frame.action {
                        Action.Identifier => true,
                        Action.BindingIdentifier => true,
                        Action.Quoted => true,
                        _ => false
                    }
                )

                if (condition) {
                    const bytes = source({
                        source: current.source,
                        frame
                    })

                    if (frame.action == Action.Quoted) {
                        quoted({
                            output: current.output,
                            bytes
                        })
                    } else {
                        const discard =
                            frame.action == Action.BindingIdentifier &&
                            bytes.length == 1 && bytes[0] == ascii_underscore

                        if (discard || identifier(bytes)) {
                            memory.appendBytes(current.output, bytes)
                        } else {
                            memory.appendByte(current.output, ascii_at)
                            quoted({
                                output: current.output,
                                bytes
                            })
                        }
                    }
                } else if (frame.action == Action.Integer) {
                    integer({
                        output: current.output,
                        value: frame.number
                    })
                } else if (frame.action == Action.Enter) {
                    current.depth += 1
                } else if (frame.action == Action.Leave) {
                    current.depth -= 1
                } else if (frame.action == Action.Indent) {
                    const indented = loop(current.depth, {
                        while: remaining => remaining != 0,
                        next: remaining => {
                            memory.appendText(in.output, indentation)
                            remaining -= 1
                        }
                    })
                } else {
                    const step = {
                        source: current.source,
                        frame
                    }
                    const frames = match frame.action {
                        Action.Expression => expression(step),
                        Action.Statement => statement(step),
                        Action.Declaration => declaration(step),
                        Action.Block => block(step),
                        _ => member(step),
                    }
                    const expanded = loop({
                        stack: current.stack,
                        remaining: frames.length,
                        frames
                    }, {
                        while: pending => pending.remaining != 0,
                        next: pending => {
                            pending.remaining -= 1
                            pending.stack =
                                pending.stack.push(
                                    pending.frames[pending.remaining]
                                )[0]
                        }
                    })

                    current.stack = expanded.stack
                }
            }
        }
    })

    if (in.source.count != 0) {
        memory.appendText(in.output, token(Token.Newline))
    }
}
