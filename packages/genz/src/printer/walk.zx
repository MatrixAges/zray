import memory from "memory"

import type { ByteWriter } from "memory"

export type Input = {
    output: ByteWriter,
    chunks: u8[][]
}

export type Output = void

export default function (in: Input): Output {
    const { output, chunks } = in

    const written = loop(0, {
        while: index => index < chunks.length,
        next: index => {
            memory.appendBytes(output, chunks[index])
            index += 1
        }
    })
}
