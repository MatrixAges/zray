import bytes from "std:bytes"
import integers from "std:integer"
import { ascii_at, ascii_space } from "core/ascii/const"
import { ascii_underscore } from "core/const"

import { indentation } from "../const"
import block from "./block"
import declaration from "./declaration"
import expression from "./expression"
import member from "./member"
import { Action, ByteSource } from "./model"
import { Token } from "./model/token"
import statement from "./statement"
import identifier from "./text/identifier"
import integer from "./text/integer"
import quoted from "./text/quoted"
import source from "./text/source"
import token from "./text/token"

import type { Frame, Source } from "./model"

export type Input = Source

export type Output = u8[][]

export default function (in: Input): Output {
    const ast = in
    const at: u8[] = [ascii_at]
    const chunks: u8[][] = []
    const stack: Frame[] = []
    const zero: u32 = 0

    const result = loop({
        stack,
        chunks,
        depth: zero,
        next: zero
    }, {
        while: current => current.next < ast.count || current.stack.length != 0,
        next: current => {
            const root = current.stack.length == 0
            const frame: Frame = match {
                root => {
                    action: Action.Declaration,
                    token: Token.Empty,
                    bytes: ByteSource.None,
                    id: ast.first + current.next,
                    count: 0,
                    index: 0,
                    number: 0
                },
                _ => current.stack[current.stack.length - 1]
            }

            if (root) {
                if (current.next != 0) {
                    current.chunks =
                        current.chunks.push(bytes.fromText(
                            token(
                                Token.Newline
                            )
                        ))[0]
                }

                current.next += 1
            } else {
                current.stack = current.stack.pop()[0]
            }

            if (frame.action == Action.Text) {
                current.chunks =
                    current.chunks.push(bytes.fromText(token(
                        frame.token
                    )))[0]
            } else {
                const condition = (
                    match frame.action {
                        Action.Identifier => true,
                        Action.BindingIdentifier => true,
                        Action.Quoted => true,
                        _ => false
                    }
                )

                if (condition) {
                    const name = source({
                        source: ast,
                        frame
                    })

                    if (frame.action == Action.Quoted) {
                        current.chunks = current.chunks.push(quoted(name))[0]
                    } else {
                        const discard =
                            frame.action == Action.BindingIdentifier &&
                            name.length == 1 && name[0] == ascii_underscore

                        if (discard || identifier(name)) {
                            current.chunks = current.chunks.push(name)[0]
                        } else {
                            current.chunks = current.chunks.push(at)[0]
                            current.chunks = current.chunks.push(quoted(name))[0]
                        }
                    }
                } else if (frame.action == Action.Integer) {
                    const digits = integer({
                        output: [],
                        value: frame.number
                    })

                    current.chunks = current.chunks.push(digits)[0]
                } else if (frame.action == Action.Enter) {
                    current.depth += 1
                } else if (frame.action == Action.Leave) {
                    current.depth -= 1
                } else if (frame.action == Action.Indent) {
                    if (current.depth != 0) {
                        const depth = integers.widen(current.depth)
                        const padding =
                            bytes.repeat(
                                depth * indentation.length,
                                ascii_space
                            )

                        current.chunks = current.chunks.push(padding)[0]
                    }
                } else {
                    const step = {
                        source: ast,
                        frame
                    }
                    const frames = match frame.action {
                        Action.Expression => expression(step),
                        Action.Statement => statement(step),
                        Action.Declaration => declaration(step),
                        Action.Block => block(step),
                        _ => member(step),
                    }
                    const expanded = loop({
                        stack: current.stack,
                        remaining: frames.length,
                        frames
                    }, {
                        while: pending => pending.remaining != 0,
                        next: pending => {
                            pending.remaining -= 1
                            pending.stack =
                                pending.stack.push(
                                    pending.frames[pending.remaining]
                                )[0]
                        }
                    })

                    current.stack = expanded.stack
                }
            }
        }
    })

    if (ast.count != 0) {
        return result.chunks.push(bytes.fromText(token(Token.Newline)))[0]
    }

    return result.chunks
}
