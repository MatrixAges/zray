<Module>
    <Type from="model" as="Printer" />

    <Args in={Printer.Published} out={u8[][]?} />

    <If on={!$in.valid}>
        <Return value={null} />
    </If>

    <Call
        module="render"
        in={{
            source: $in.omit(["valid"])
        }}
    />

    <Return value={$ctx.render} />
</Module>
