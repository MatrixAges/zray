import integers from "std:integer"
import {
    ascii_backslash,
    ascii_carriage_return,
    ascii_double_quote,
    ascii_line_feed,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_lower_x,
    ascii_printable_last,
    ascii_space,
    ascii_tab
} from "core/ascii/const"
import { hexadecimal_radix } from "core/const"
import memory from "memory"

import { hexadecimal_digits } from "../../const"

import type { ByteWriter } from "memory"

export type Input = {
    output: ByteWriter,
    bytes: u8[]
}

export type Output = void

export default function (in: Input): Output {
    memory.appendByte(in.output, ascii_double_quote)

    const written = loop(0, {
        while: index => index < in.bytes.length,
        next: index => {
            const byte = in.bytes[index]

            if (byte == ascii_double_quote || byte == ascii_backslash) {
                memory.appendBytes(in.output, [
                    ascii_backslash,
                    byte
                ])
            } else {
                const condition = (
                    - byte == ascii_line_feed
                    - or byte == ascii_carriage_return
                    - or byte == ascii_tab
                )

                if (condition) {
                    const escape = match byte {
                        ascii_line_feed => ascii_lower_n,
                        ascii_carriage_return => ascii_lower_r,
                        _ => ascii_lower_t
                    }

                    memory.appendBytes(in.output, [
                        ascii_backslash,
                        escape
                    ])
                } else if (byte >= ascii_space && byte <= ascii_printable_last) {
                    memory.appendByte(in.output, byte)
                } else {
                    const value = integers.widenByte(byte)

                    memory.appendBytes(in.output, [
                        ascii_backslash,
                        ascii_lower_x,
                        hexadecimal_digits[value / hexadecimal_radix],
                        hexadecimal_digits[value % hexadecimal_radix]
                    ])
                }
            }

            index += 1
        }
    })

    memory.appendByte(in.output, ascii_double_quote)
}
