import bytes from "std:bytes"
import integers from "std:integer"
import {
    ascii_backslash,
    ascii_carriage_return,
    ascii_double_quote,
    ascii_line_feed,
    ascii_lower_n,
    ascii_lower_r,
    ascii_lower_t,
    ascii_lower_x,
    ascii_tab
} from "core/ascii/const"
import { hexadecimal_radix } from "core/const"

import { hexadecimal_digits } from "../../const"
import width from "./quoted/width"

export type Input = u8[]

export type Output = u8[]

export default function (in: Input): Output {
    const measured = loop({
        index: 0,
        size: 2
    }, {
        while: state => state.index < in.length,
        next: state => {
            state.size += width(in[state.index])
            state.index += 1
        }
    })

    const output = bytes.repeat(measured.size, ascii_double_quote)

    return loop({
        output,
        index: 0,
        offset: 1
    }, {
        while: state => state.index < in.length,
        next: state => {
            const byte = in[state.index]
            const offset = state.offset
            const size = width(byte)

            if (size == 1) {
                state.output[offset] = byte
            } else {
                state.output[offset] = ascii_backslash

                if (size == 2) {
                    state.output[offset + 1] = match byte {
                        ascii_line_feed => ascii_lower_n,
                        ascii_carriage_return => ascii_lower_r,
                        ascii_tab => ascii_lower_t,
                        _ => byte
                    }
                } else {
                    const value = integers.widenByte(byte)

                    state.output[offset + 1] = ascii_lower_x
                    state.output[offset + 2] =
                        hexadecimal_digits[value / hexadecimal_radix]
                    state.output[offset + 3] =
                        hexadecimal_digits[value % hexadecimal_radix]
                }
            }

            state.offset += size
            state.index += 1
        },
        return: state => state.output
    })
}
