import { decimal_radix } from "core/const"
import memory from "memory"

import { decimal_digits } from "../../const"

import type { ByteWriter } from "memory"

export type Input = {
    output: ByteWriter,
    value: u64
}

export type Output = void

export default function (in: Input): Output {
    const first = memory.byteWriterLength(in.output)

    const remaining = loop(in.value, {
        do: value => {
            memory.appendByte(in.output, decimal_digits[value % decimal_radix])
            value = value / decimal_radix
        },
        while: value => value != 0
    })

    memory.reverseByteWriterTail(in.output, first)
}
