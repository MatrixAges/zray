import integers from "std:integer"

import { ByteSource } from "../model"

import type { Step } from "../model"

export type Input = Step

export type Output = u8[]

export default function (in: Input): Output {
    const id = integers.widen(in.frame.id)

    return match in.frame.bytes {
        ByteSource.ExpressionIdentifier => in.ast[0].expressions.identifier[id],
        ByteSource.ExpressionString => in.ast[0].expressions.string[id],
        ByteSource.EnumLiteral => in.ast[0].expressions.enum_literal[id],
        ByteSource.ErrorValue => in.ast[0].expressions.error_value[id],
        ByteSource.FieldName => in.ast[0].expressions.field_name[id],
        ByteSource.BlockLabel => in.ast[0].expressions.block_label[id],
        ByteSource.CatchCapture => in.ast[0].expressions.catch_value_capture[id],
        ByteSource.CatchLabel => in.ast[0].expressions.catch_value_label[id],
        ByteSource.CatchScopeCapture =>
            in.ast[0].expressions.catch_scope_capture[id] ?? [],
        ByteSource.ConditionalCapture =>
            in.ast[0].expressions.conditional_capture[id] ?? [],
        ByteSource.ConditionalErrorCapture =>
            in.ast[0].expressions.conditional_error_capture[id] ?? [],
        ByteSource.EnumMember =>
            in.ast[0].expressions.enum_type_members[id][in.frame.index],
        ByteSource.ErrorMember =>
            in.ast[0].expressions.error_set[id][in.frame.index],
        ByteSource.ErrorUnionMember =>
            (
                in.ast[0].expressions.error_union_errors[id] ?? []
            )[in.frame.index],
        ByteSource.MemberName => in.ast[0].fields.name[id],
        ByteSource.ArmCapture => in.ast[0].arms.capture[id] ?? [],
        ByteSource.StatementConstant => in.ast[0].statements.constant_name[id],
        ByteSource.StatementVariable => in.ast[0].statements.variable_name[id],
        ByteSource.DeclarationConstant => in.ast[0].declarations.constant_name[id],
        ByteSource.DeclarationVariable => in.ast[0].declarations.variable_name[id],
        ByteSource.DeclarationField => in.ast[0].declarations.field_name[id],
        ByteSource.FunctionName => in.ast[0].declarations.function_name[id],
        ByteSource.ForCapture => in.ast[0].statements.for_loop_capture[id],
        ByteSource.ForIndexCapture =>
            in.ast[0].statements.for_loop_index_capture[id] ?? [],
        ByteSource.WhileCapture => in.ast[0].statements.while_loop_capture[id] ?? [],
        ByteSource.BranchCapture => in.ast[0].statements.branch_capture[id] ?? [],
        ByteSource.BranchErrorCapture =>
            in.ast[0].statements.branch_error_capture[id] ?? [],
        ByteSource.BreakLabel => in.ast[0].statements.break_value_label[id],
        _ => [],
    }
}
