<Module>
    <Type from="model" as="Names" />

    <Args in={Names.Input} out={Names.Output} />

    <Call
        module="type_names"
        in={$in.pick([
            "types",
            "modules",
            "origins"
        ])}
    />

    <If on={$ctx.type_names.status != Names.Status.Valid}>
        <Return
            value={{
                ...$ctx.type_names,
                functions: []
            }}
        />
    </If>

    <Call module="capabilities" in={$in} />

    <Call
        fn="functions"
        in={{
            source: $in,
            capabilities: $ctx.capabilities
        }}
    />

    <Return
        value={{
            ...$ctx.type_names,
            functions: $ctx.functions
        }}
    />
</Module>
