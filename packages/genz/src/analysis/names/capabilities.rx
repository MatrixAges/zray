<Module>
    <Type from="model" as="Names" />

    <Args in={Names.Input} out={Names.Capabilities} />

    <If on={$in.known}>
        <Return
            value={{
                io: $in.io,
                process: $in.process
            }}
        />
    </If>

    <Call
        fn="../capability/io"
        in={{
            functions: $in.functions,
            allocator: $in.allocator
        }}
    />

    <Call
        fn="../capability/process"
        in={{
            functions: $in.functions,
            allocator: $in.allocator
        }}
    />

    <Return
        value={{
            io: $ctx.io,
            process: $ctx.process
        }}
    />
</Module>
