import { TransformKind } from "core/expression_table/kinds"

import add from "./add"

import type { Index as Output } from "core/integer/index/model"
import type { Parameters as Input } from "./model"

export default function (in: Input): Output {
    if (in.kind != TransformKind.Reduce) {
        return in.index
    }

    return add({
        facts: in.facts,
        index: in.index,
        symbol: in.parameters[0]
    })
}
