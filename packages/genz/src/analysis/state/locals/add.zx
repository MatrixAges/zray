import integers from "std:integer"

import insert from "../../members/add"
import { Property } from "../queries/model"
import read from "../queries/read"

import type { Index as Output } from "core/integer/index/model"
import type { Candidate as Input } from "./model"

export default function (in: Input): Output {
    const type_id = in.facts.symbol_types[integers.widen(in.symbol)]

    const represented = read({
        value: in.facts.queries[integers.widen(type_id)],
        property: Property.Represented
    })

    if (!represented) {
        return in.index
    }

    return insert({
        index: in.index,
        key: in.symbol
    })
}
