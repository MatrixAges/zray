import add from "./add"

import type { Index as Output } from "core/integer/index/model"
import type { Scope as Input } from "./model"

export default function (in: Input): Output {
    if (!in.active) {
        return in.index
    }

    const facts = in.facts
    const symbols = in.symbols

    return loop({
        index: in.index,
        position: 0
    }, {
        while: current => current.position < symbols.length,
        next: current => {
            const symbol = symbols[current.position]

            if (symbol != null) {
                current.index = add({
                    facts,
                    index: current.index,
                    symbol
                })
            }

            current.position += 1
        },
        return: current => current.index
    })
}
