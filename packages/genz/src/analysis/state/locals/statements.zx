import integers from "std:integer"
import { StatementKind } from "core/control_table/model"

import add from "./add"

import type { Index as Output } from "core/integer/index/model"
import type { Statements as Input } from "./model"

export default function (in: Input): Output {
    if (!in.active) {
        return in.index
    }

    const facts = in.facts
    const control = in.control
    const end = in.first + in.count

    return loop({
        index: in.index,
        position: in.first
    }, {
        while: current => current.position < end,
        next: current => {
            const position = current.position
            const payload = integers.widen(control.statement_payloads[position])

            current.index = match control.statement_kinds[position] {
                StatementKind.Constant => add({
                    facts,
                    index: current.index,
                    symbol: control.constant_symbols[payload]
                }),
                StatementKind.Destructure => loop({
                    index: current.index,
                    position: integers.widen(control.destructure_first[payload]),
                    remaining: integers.widen(control.destructure_count[payload])
                }, {
                    while: item => item.remaining != 0,
                    next: item => {
                        const symbol = control.destructure_symbols[item.position]

                        if (symbol != null) {
                            item.index = add({
                                facts,
                                index: item.index,
                                symbol
                            })
                        }

                        item.position += 1
                        item.remaining -= 1
                    },
                    return: item => item.index
                }),
                _ => current.index
            }
            current.position += 1
        },
        return: current => current.index
    })
}
