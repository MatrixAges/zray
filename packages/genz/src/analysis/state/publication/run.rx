<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call fn="model.requireAllocation" in={$in.valid} />

    <Call
        fn="expressions"
        in={$in.pick([
            "target",
            "segments"
        ])}
    />

    <Call
        fn="attachments"
        in={$in.pick([
            "target",
            "helper"
        ])}
    />

    <If on={$in.body}>
        <Call fn="body" in={$in.target} />
    </If>

    <Call
        fn="finish"
        in={$in.pick([
            "target",
            "fields",
            "serial",
            "uses_allocator"
        ])}
    />
</Module>
