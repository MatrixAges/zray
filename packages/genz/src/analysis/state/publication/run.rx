<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call fn="model.requireAllocation" in={$in.valid} />

    <Call
        fn="expressions"
        in={$in.pick([
            "target",
            "segments"
        ])}
    />

    <Call
        fn="attachments"
        in={$in.pick([
            "target",
            "helper"
        ])}
    />

    <Call fn="body" in={$in.target} />

    <Call
        fn="model.finishGeneratedAst"
        in={[
            $in.lower,
            $in.serial,
            false
        ]}
    />
</Module>
