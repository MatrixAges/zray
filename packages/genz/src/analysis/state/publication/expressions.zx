import host from "lowering_host"

import type { Input as Publication } from "./model"

export type Input = Publication.Pick("target", "segments")

export type Output = void

export default function (in: Input): Output {
    const rendered = loop(0, {
        while: index => index < in.segments,
        next: index => {
            host.appendAstExpressions(in.target, index)

            index += 1
        }
    })
}
