import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import publicRoots from "./public_roots"

import type { Table } from "core/type_table/model"
import type { Boundaries, Functions } from "../model"

export type Input = {
    types: Table,
    functions: Functions,
    source: Boundaries
}

export type Output = u32[]

export default function (in: Input): Output {
    const inputs = publicRoots({
        types: in.types,
        exported: in.source.exported,
        ports: in.functions.input_types,
        entry: in.source.input_type
    })

    const outputs = publicRoots({
        types: in.types,
        exported: in.source.exported,
        ports: in.functions.output_types,
        entry: in.source.output_type
    })

    const roots: u32[] = []

    return loop({
        roots,
        index: 0
    }, {
        while: state => state.index < in.types.kinds.length,
        next: state => {
            const index = state.index
            const target = kind(in.types.kinds[index])
            const product = target == Kind.Object || target == Kind.Tuple
            const condition = (
                - product
                - and inputs[index]
                - and outputs[index]
            )

            if (condition) {
                state.roots = state.roots.push(integers.narrow(index))[0]
            }

            state.index += 1
        },
        return: state => state.roots
    })
}
