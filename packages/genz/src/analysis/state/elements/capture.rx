<Module>
    <Type from="workflow" as="Elements" />

    <Args in={Elements.Input} out={u8[]} />

    <If on={$in.choice.discard}>
        <Return value={$in.choice.discard_name} />
    </If>

    <If on={!$in.choice.passthrough}>
        <Call
            fn="layout"
            in={{
                lower: $in.lower,
                type_id: $in.choice.type_id,
                stored: $in.choice.stored
            }}
        />

        <Call
            fn="workflow.emitElement"
            in={[
                $in.frame,
                $in.value,
                $ctx.layout
            ]}
        />

        <Return value={$ctx.emitElement.name} />
    </If>

    <Return value={$in.name} />
</Module>
