import bytes from "std:bytes"

import conditional from "../../../ast/context/conditional"
import field from "../../../ast/context/field"
import { items_field } from "../../types/state/const"
import { Operation, Storage } from "../list/const"
import construct from "../list/construct"
import permission from "../list/permission"
import tag from "../list/tag"

import type { Work as Input, Work as Output } from "./model"

export default function (in: Input): Output {
    const items = field({
        state: in.state.context,
        target: in.root,
        name: bytes.fromText(items_field)
    })

    const header = permission({
        state: items.state,
        value: in.root,
        operation: Operation.Headered
    })

    const yes = tag({
        state: header.state,
        storage: Storage.Shared
    })

    const no = tag({
        state: yes.state,
        storage: Storage.Plain
    })

    const storage = conditional({
        state: no.state,
        condition: header.id,
        yes: yes.id,
        no: no.id
    })

    const result = construct({
        context: storage.state,
        fields: in.state.fields,
        first: in.source.field_base,
        layout: in.source.layout,
        value: items.id,
        storage: storage.id
    })

    return {
        ...in,
        state: {
            ...in.state,
            context: result.context,
            fields: result.fields
        },
        root: result.root
    }
}
