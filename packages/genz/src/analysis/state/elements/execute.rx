<Module>
    <Type from="execute_model" as="Element" />

    <Args in={Element.Execute} out={Element.Published} />

    <If on={$in.choice.discard}>
        <Return
            value={{
                root: $in.value,
                name: $in.choice.discard_name
            }}
        />
    </If>

    <If on={$in.choice.passthrough}>
        <Return
            value={{
                root: $in.value,
                name: $in.name
            }}
        />
    </If>

    <Call fn="prepare_input" in={$in} />

    <Call module="build" />

    <Call
        fn="../conversion/emit/publish_ast"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            binding: $in.body,
            body: $in.body,
            output: $ctx.build.result
        }}
    />

    <If on={$in.choice.capture}>
        <Call
            fn="execute_model.retainLoweringText"
            in={[
                $in.frame,
                $ctx.build.name
            ]}
        />

        <Return
            value={{
                root: $ctx.publish_ast,
                name: $ctx.retainLoweringText
            }}
        />
    </If>

    <Return
        value={{
            root: $ctx.publish_ast,
            name: $in.name
        }}
    />
</Module>
