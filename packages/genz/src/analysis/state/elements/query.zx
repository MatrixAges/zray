import bytes from "std:bytes"
import integers from "std:integer"
import { Kind } from "core/type_table/model"

import { Mode } from "../conversion/model"
import { Property } from "../queries/model"
import read from "../queries/read"
import { Resource } from "../resources/model"
import { discard_name } from "./const"
import { Operation } from "./model"
import storage from "./storage"

import type { Query as Input, Choice as Output } from "./model"

export default function (in: Input): Output {
    const initial: Output = {
        passthrough: true,
        discard: false,
        discard_name: [],
        stored: false,
        bind: false,
        capture: false,
        type_id: 0,
        mode: Mode.Value,
        table: Resource.AbiType
    }

    const capture = in.operation == Operation.Capture

    if (capture && !in.used) {
        return {
            ...initial,
            discard: true,
            discard_name: bytes.fromText(discard_name)
        }
    }

    if (!in.active && in.operation != Operation.Type) {
        return initial
    }

    const source = in.source

    const element = storage({
        ...source.pick([
            "types",
            "selected",
            "element_storage"
        ]),
        list: source.root,
        active: in.active
    })

    const { child, selected, table } = element

    if (in.operation == Operation.Type) {
        return {
            ...initial,
            type_id: child,
            table
        }
    }

    if (capture && !selected) {
        return initial
    }

    const represented = read({
        value: source.queries[integers.widen(child)],
        property: Property.Represented
    })

    const input = in.operation != Operation.Write

    return {
        passthrough: !represented && !selected,
        discard: false,
        discard_name: [],
        stored: selected && element.kind == Kind.List,
        bind: input && selected,
        capture,
        type_id: child,
        mode: match {
            input && selected => Mode.RowValue,
            input => Mode.Value,
            selected => Mode.RowLayout,
            _ => Mode.Pointer
        },
        table
    }
}
