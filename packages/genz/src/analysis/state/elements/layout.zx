import host from "lowering_host"

import type { ElementRepresentation } from "lowering_host"

export type Input = {
    frame: ElementRepresentation,
    stored: bool
}

export type Output = u32?

export default function (in: Input): Output {
    if (in.stored) {
        return host.elementStoredLayout(in.frame)
    }

    return null
}
