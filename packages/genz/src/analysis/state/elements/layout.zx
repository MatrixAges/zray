import host from "lowering_host"
import { StoredType } from "lowering_host"

import type { Lowering } from "lowering_host"

export type Input = {
    lower: Lowering,
    type_id: u32,
    stored: bool
}

export type Output = u32?

export default function (in: Input): Output {
    if (in.stored) {
        return host.materializeType(in.lower, in.type_id, StoredType.StateType)
    }

    return null
}
