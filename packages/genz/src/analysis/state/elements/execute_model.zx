import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as Conversion } from "../conversion/emit/model"
import type { Choice } from "./model"

export { retainLoweringText } from "lowering_host"

export type Execute = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body: AstSequence,
    choice: Choice,
    conversion?: Conversion,
    value: u32,
    name: u8[]
}

export type Published = {
    root: u32,
    name: u8[]
}
