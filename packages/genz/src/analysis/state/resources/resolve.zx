import integers from "std:integer"
import { retainLoweringText } from "lowering_host"

import describeOrigin from "../../construction/origin/describe"
import resolve from "./cache"
import select from "./conversion"
import { Resource } from "./model"

import type { Table } from "core/type_table/model"
import type { Lowering } from "lowering_host"
import type { Plan } from "../conversion/model"
import type { Types } from "./cache"

export type Input = {
    frame: Lowering,
    plan: Plan,
    types: Types,
    table: Table,
    referenced: bool[]
}

export type Output = {
    layouts: u32[],
    targets: u32[],
    elements: u32[],
    origins: u8[][]
}

export default function (in: Input): Output {
    const { frame, plan, types, table, referenced } = in

    const layouts: u32[] = []
    const targets: u32[] = []
    const elements: u32[] = []
    const origins: u8[][] = []

    return loop({
        row: 0,
        layouts,
        targets,
        elements,
        origins
    }, {
        while: state => state.row < plan.types.length,
        next: state => {
            const row = state.row
            const id = plan.types[row]
            const type_index = integers.widen(id)
            const resource = select({
                mode: plan.modes[row],
                operation: plan.kinds[row],
                referenced: type_index < referenced.length && referenced[type_index],
                has_children: plan.count[row] != 0
            })

            const layout = resolve({
                frame,
                types,
                id,
                kind: resource.layout
            })

            const target = match resource.target {
                Resource.None => layout,
                _ => resolve({
                    frame,
                    types,
                    id,
                    kind: resource.target
                }),
            }

            const element = match resource.element {
                Resource.None => 0,
                _ => resolve({
                    frame,
                    types,
                    id: table.first[type_index],
                    kind: resource.element
                }),
            }

            if (resource.origin) {
                const origin = describeOrigin({
                    types: table,
                    id
                })

                const name = match {
                    origin.owned => retainLoweringText(frame, origin.name),
                    _ => origin.name
                }

                state.origins = state.origins.push(name)[0]
            } else {
                state.origins = state.origins.push([])[0]
            }

            state.layouts = state.layouts.push(layout)[0]
            state.targets = state.targets.push(target)[0]
            state.elements = state.elements.push(element)[0]
            state.row += 1
        },
        return: state => ({
            layouts: state.layouts,
            targets: state.targets,
            elements: state.elements,
            origins: state.origins
        })
    })
}
