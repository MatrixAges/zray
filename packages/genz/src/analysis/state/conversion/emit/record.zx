import integers from "std:integer"

import { Storage } from "../../list/const"
import construct from "../../list/construct"
import tag from "../../list/tag"

import type { Record, Recorded as Output } from "../../list/model"

export type Input = Record.Omit("storage", "first") & {
    field_base: u32,
    shared: bool
}

export default function (in: Input): Output {
    const storage = tag({
        state: in.context,
        storage: in.shared ? Storage.Shared : Storage.Plain
    })

    return construct({
        context: storage.state,
        fields: in.fields,
        first: in.field_base + integers.narrow(in.fields.name.length),
        layout: in.layout,
        value: in.value,
        storage: storage.id
    })
}
