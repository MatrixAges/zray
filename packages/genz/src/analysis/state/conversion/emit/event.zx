import integers from "std:integer"

import { Operation } from "../model"
import aggregate from "./aggregate"
import borrowed from "./borrowed"
import enter from "./enter"
import optional from "./optional"
import rows from "./rows/exit"

import type { Event as Output, Traversal as Input } from "./model"

export default function (in: Input): Output {
    const { source, state } = in

    const node = integers.widen(source.plan.events[state.index])

    const step = {
        source,
        state,
        node
    }

    const entering = source.plan.entering[state.index]
    const kind = source.plan.kinds[node]

    const prepared = match {
        entering => enter(step),
        kind == Operation.Optional => optional(step),
        kind == Operation.Object => aggregate(step),
        kind == Operation.Tuple => aggregate(step),
        kind == Operation.Borrowed => borrowed(step),
        kind == Operation.Rows => rows(step),
        _ => state
    }

    return {
        step: {
            ...step,
            state: prepared
        },
        enter_rows: entering && kind == Operation.Rows
    }
}
