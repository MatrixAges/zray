import ast from "ast_rows"
import { AstPayloadOwnership, AstSequenceMode } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import type { PublishAst as Input } from "./execute_model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, binding, body, output } = in

    requireAllocation(output.valid)

    ast.appendExpressionRows(
        writer,
        output.expressions,
        output.forms,
        AstPayloadOwnership.Owned
    )

    ast.appendStatementRows(
        writer,
        output.statements,
        output.variables,
        AstPayloadOwnership.Selected
    )

    ast.hoistStatementRows(writer, output.storage, output.variables)

    if (body != null) {
        if (binding != null) {
            ast.appendStatementSequence(
                writer,
                binding,
                output.borrow_storage,
                output.variables,
                AstSequenceMode.SelectedOwned
            )

            ast.appendStatementSequence(
                writer,
                body,
                output.body,
                output.variables,
                AstSequenceMode.SelectedOwned
            )
        }
    }

    ast.appendAstFields(writer, output.fields)
    host.finishGeneratedAst(frame, output.serial, output.uses_allocator)

    return output.root
}
