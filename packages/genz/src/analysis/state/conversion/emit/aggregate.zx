import integers from "std:integer"

import builtin from "../../../../ast/context/builtin"
import object from "../../../../ast/context/object"
import tuple from "../../../../ast/context/tuple"
import append from "../../../../ast/fields/append"
import { ExpressionsBuiltinName } from "../../../../printer/model/expressions"
import isInput from "../is_input"
import isView from "../is_view"
import { Operation, Mode } from "../model"
import borrow from "./borrow"
import origin from "./origin"
import outbound from "./outbound"
import reference from "./reference"

import type { Step as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const values: u32[] = []
    const category = in.source.plan.kinds[in.node]

    const children = loop({
        fields: in.state.fields,
        values,
        index: 0
    }, {
        while: current => current.index < in.source.plan.count[in.node],
        next: current => {
            const position = in.source.plan.first[in.node] + current.index
            const child = integers.widen(in.source.plan.children[position])
            const value = in.state.nodes[child].result

            if (category == Operation.Object) {
                current.fields = append({
                    table: current.fields,
                    name: in.source.plan.names[child],
                    value,
                    default_value: null,
                    comptime_parameter: false
                })
            } else {
                current.values = current.values.push(value)[0]
            }

            current.index += 1
        }
    })

    const mode = in.source.plan.modes[in.node]
    const view = isView(mode)
    const input = isInput(mode)
    const provenance_field = input || view

    const provenance = match {
        provenance_field => origin(in),
        _ => {
            state: in.state.context,
            id: in.state.nodes[in.node].input
        }
    }

    const members = match {
        provenance_field && category == Operation.Object => append({
            table: children.fields,
            name: in.source.origins[in.node],
            value: provenance.id,
            default_value: null,
            comptime_parameter: false
        }),
        _ => children.fields
    }

    const items = match {
        provenance_field && category == Operation.Tuple =>
            children.values.push(provenance.id)[0],
        _ => children.values
    }

    const product = match category {
        Operation.Object => object({
            state: provenance.state,
            type_expr: in.source.layouts[in.node],
            first: in.source.field_base + integers.narrow(in.state.fields.name.length),
            count: integers.narrow(
                members.name.length - in.state.fields.name.length
            )
        }),
        _ => tuple({
            state: provenance.state,
            values: items
        })
    }

    const result = match category {
        Operation.Object => product,
        _ => builtin({
            state: product.state,
            name: ExpressionsBuiltinName.As,
            arguments: [
                in.source.layouts[in.node],
                product.id
            ]
        })
    }

    const state = {
        ...in.state,
        context: result.state,
        fields: members,
        body: in.state.body,
        nodes: in.state.nodes.with(in.node, {
            ...in.state.nodes[in.node],
            result: result.id
        })
    }

    if (view) {
        const joined = {
            ...state,
            body: {
                tags: state.nodes[in.node].outer.tags.concat(state.body.tags)[0],
                offsets:
                    state.nodes[in.node].outer.offsets.concat(state.body.offsets)[0]
            }
        }

        return match mode {
            Mode.ViewValue => reference({
                ...in,
                state: joined
            }),
            _ => joined
        }
    }

    if (in.source.plan.modes[in.node] == Mode.Borrow) {
        return borrow({
            ...in,
            state
        })
    }

    if (!input) {
        return outbound({
            ...in,
            state
        })
    }

    return reference({
        ...in,
        state: {
            ...state,
            body: {
                tags: state.nodes[in.node].outer.tags.concat(state.body.tags)[0],
                offsets:
                    state.nodes[in.node].outer.offsets.concat(state.body.offsets)[0]
            }
        }
    })
}
