<Module>
    <Type from="model" as="Emission" />

    <Args in={Emission.Walk} out={Emission.State} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                ...$in,
                running:
                    $in.state.index < $in.source.plan.events.length &&
                    $in.state.context.valid
            }}
        />
    </Loop>

    <Return value={$ctx.advance.state} />
</Module>
