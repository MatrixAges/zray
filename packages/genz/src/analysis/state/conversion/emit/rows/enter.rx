<Module>
    <Type from="../model" as="Emission" />

    <Args in={Emission.Step} out={Emission.State} />

    <Call fn="prepare" in={$in} />

    <Call module="reserve" in={$ctx.prepare.reserve} />

    <Call
        fn="finish"
        in={{
            step: $in,
            plan: $ctx.prepare,
            target: $ctx.reserve
        }}
    />

    <Return value={$ctx.finish} />
</Module>
