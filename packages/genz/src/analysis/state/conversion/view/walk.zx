import advance from "./advance"
import enter from "./enter"
import initialize from "./initialize"
import satisfy from "./satisfy"

import type { Lowering } from "lowering_host"
import type { Plan as Output } from "../model"
import type { Input as Source } from "./model"

export type Input = {
    frame: Lowering,
    source: Source
}

export default function (in: Input): Output {
    const source = in.source

    const initial = initialize(source.source.pick([
        "root",
        "mode"
    ]))

    return loop(initial, {
        while: state => !state.complete,
        next: state => {
            if (state.waiting) {
                const decision = satisfy({
                    frame: in.frame,
                    source,
                    type_id: state.pending.type_id,
                    mode: state.pending.mode
                })

                state = enter({
                    step: {
                        source,
                        state
                    },
                    decision
                })
            } else {
                state = advance({
                    source,
                    state
                })
            }
        },
        return: state => state.plan
    })
}
