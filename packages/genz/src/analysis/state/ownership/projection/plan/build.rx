<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Input} out={Plan.Output} />

    <If on={!$in.required}>
        <Call fn="../../needed" in={$in.source.source} />

        <If on={!$ctx.needed}>
            <Return value={null} />
        </If>
    </If>

    <Call fn="qualified" in={$in.serial} />
    <Call fn="../../outlined" in={$in.source} />

    <If on={$ctx.outlined}>
        <Call fn="name_input" in={$in} />

        <Call module="../../helper/name/build" />

        <Call
            fn="register"
            in={{
                names: $in.existing_names,
                name: $ctx.build
            }}
        />

        <Return
            value={{
                qualified: $ctx.qualified,
                helper: $ctx.register,
                clear_plan: null
            }}
        />

        <Else>
            <Call module="../../clear/plan" in={$in.source} />

            <Return
                value={{
                    qualified: $ctx.qualified,
                    clear_plan: $ctx.plan
                }}
            />
        </Else>
    </If>
</Module>
