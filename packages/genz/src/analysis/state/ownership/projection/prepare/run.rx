<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Input} out={Preparation.Output} />

    <Call module="../plan/build" in={$in.plan} />

    <If on={$ctx.build != null}>
        <Call
            fn="model.retainLoweringText"
            in={[
                $in.frame,
                $ctx.build.qualified.name
            ]}
        />

        <Call
            fn="retain_helper"
            in={{
                frame: $in.frame,
                helper: $ctx.build.helper
            }}
        />

        <Call
            fn="model.finishGeneratedAst"
            in={[
                $in.frame,
                $ctx.build.qualified.serial,
                false
            ]}
        />

        <Call
            fn="model.materializeType"
            in={[
                $in.frame,
                $in.plan.source.source.type_id,
                Preparation.StoredType.StateType
            ]}
        />

        <If on={$ctx.build.clear_plan != null}>
            <Loop on={$in.running}>
                <Call
                    module="layout_row"
                    in={{
                        frame: $in.frame,
                        references: $ctx.build.clear_plan.references,
                        layouts: $in.layouts,
                        row: 0,
                        running: $ctx.build.clear_plan.references.length != 0
                    }}
                />
            </Loop>
        </If>

        <Return
            value={{
                name: $ctx.retainLoweringText,
                helper: $ctx.retain_helper,
                clear_plan: $ctx.build.clear_plan,
                type_expr: $ctx.materializeType
            }}
        />
    </If>

    <Return value={null} />
</Module>
