import initialize from "../../../../ast/context/initialize"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    return {
        context: initialize({
            capture: null,
            expression_base: in.expression_base,
            statement_base: in.statement_base,
            field_base: 0,
            serial: in.serial
        }),
        body: {
            tags: [],
            offsets: []
        },
        storage: {
            tags: [],
            offsets: []
        },
        values: [],
        targets: [],
        bodies: [],
        index: 0,
        layout_index: 0
    }
}
