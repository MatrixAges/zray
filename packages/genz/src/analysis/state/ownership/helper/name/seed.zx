import bytes from "std:bytes"

import { helper_separator } from "../../const"

export type Input = string

export type Output = u8[]

export default function (in: Input): Output {
    const separator: u8[] = [
        helper_separator
    ]

    return bytes.join(
        bytes.fromText(""),
        [
            bytes.fromText(in),
            separator
        ]
    )
}
