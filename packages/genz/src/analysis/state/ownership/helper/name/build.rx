<Module>
    <Type from="model" as="Name" />

    <Args in={Name.Input} out={Name.Output} />

    <Call
        fn="../../../../types/state/name"
        in={$in.pick([
            "names",
            "index",
            "key"
        ])}
    />

    <Call fn="seed" />

    <Call
        fn="slots"
        in={$in.pick([
            "source",
            "count"
        ])}
    />

    <Call
        fn="format"
        in={{
            seed: $ctx.seed,
            slots: $ctx.slots
        }}
    />

    <Return value={$ctx.format} />
</Module>
