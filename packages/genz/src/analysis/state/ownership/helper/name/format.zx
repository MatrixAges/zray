import crypto from "std:crypto"
import encoding from "std:encoding"
import strings from "std:string"

import { helper_prefix } from "../../const"

import type { Format as Input, Output } from "./model"

export default function (in: Input): Output {
    return strings.join(
        "",
        [
            helper_prefix,
            encoding.encodeHex(
                crypto.sha256Parts([
                    in.seed,
                    in.slots
                ])
            )
        ]
    )
}
