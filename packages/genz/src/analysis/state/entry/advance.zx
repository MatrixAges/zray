import integers from "std:integer"
import next from "core/integer/map/next"
import put from "core/integer/map/put"

import { Property } from "../queries/model"
import read from "../queries/read"

import type { Input, Walk as Output } from "./model"

export default function (in: Input): Output {
    const work = in.state.work

    const cache = match {
        work != null && in.converted != null => put({
            state: in.state.cache,
            key: work.key,
            value: in.converted
        }),
        _ => in.state.cache
    }

    const found = next({
        metadata: in.source.metadata,
        count: in.source.count,
        start: in.state.cursor
    })

    const position = found.position

    if (position == null) {
        return {
            cache,
            cursor: found.next,
            work: null
        }
    }

    const key = in.source.keys[position]
    const type_id = in.source.types[integers.widen(key)]

    const represented = read({
        value: in.source.queries[integers.widen(type_id)],
        property: Property.Represented
    })

    return {
        cache,
        cursor: found.next,
        work: {
            key,
            value: in.source.values[position],
            layout: represented ? type_id : null
        }
    }
}
