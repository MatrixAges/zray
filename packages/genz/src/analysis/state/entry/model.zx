import type { State as Cache } from "core/integer/map/model"
import type { Query } from "../queries/model"

export type Facts = {
    count: u64,
    metadata: u8[],
    keys: u32[],
    values: u32[],
    types: u32[],
    queries: Query[]
}

export type Conversion = {
    key: u32,
    value: u32,
    layout?: u32
}

export type Walk = {
    cache: Cache,
    cursor: u64,
    work?: Conversion
}

export type Input = {
    source: Facts,
    state: Walk,
    converted?: u32
}
