<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Output} />

    <If on={$in.borrowed}>
        <Return
            value={{
                previous: $in.current,
                next: {
                    ...$in.target,
                    active: false
                },
                jobs: {
                    slots: [],
                    layouts: []
                },
                replace_cache: false
            }}
        />
    </If>

    <If on={$in.current.active}>
        <Return
            value={{
                previous: null,
                next: $in.current,
                jobs: {
                    slots: [],
                    layouts: []
                },
                replace_cache: false
            }}
        />
    </If>

    <Call fn="schedule" in={$in.source} />

    <Return
        value={{
            previous: $in.current,
            next: {
                ...$in.target,
                active: true
            },
            jobs: $ctx.schedule,
            replace_cache: true
        }}
    />
</Module>
