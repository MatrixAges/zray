import host from "lowering_host"

import type { RepresentedCache } from "lowering_host"

export type Input = {
    cache: RepresentedCache,
    slots: u64[],
    layouts: u32?[]
}

export type Output = void

export default function (in: Input): Output {
    const { cache, slots, layouts } = in

    const converted = loop({
        index: 0
    }, {
        while: state => state.index < slots.length,
        next: state => {
            const index = state.index

            host.convertRepresentedCache(
                cache,
                index,
                slots[index],
                layouts[index]
            )
            state.index = index + 1
        },
        return: state => state.index
    })
}
