import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import nestedAppend from "./nested_append"

import type { Allocator } from "memory"
import type { Program } from "../model"

export type Input = {
    program: Program,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { program } = in

    const tables = [program.expressions].concat(program.functions.expressions)[0]
    const initial_values: bool[] = program.types.kinds.map(item => false)[0]

    const values = loop({
        index: 0,
        values: initial_values
    }, {
        while: state => state.index < tables.length,
        next: state => {
            const expressions = tables[state.index]

            state.values = loop({
                node: 0,
                values: state.values
            }, {
                while: row => row.node < expressions.update_targets.length,
                next: row => {
                    if (nestedAppend({
                        expressions,
                        value: expressions.update_values[row.node]
                    })) {
                        const target = integers.widen(
                            expressions.update_targets[row.node]
                        )

                        row.values[integers.widen(
                            expressions.types[target]
                        )] = true
                    }

                    row.node += 1
                },
                return: row => row.values
            })

            state.index += 1
        },
        return: state => state.values
    })

    const readonly_types = program.types

    return loop({
        index: 0,
        values
    }, {
        while: state => state.index < readonly_types.kinds.length,
        next: state => {
            if (kind(readonly_types.kinds[state.index]) == Kind.List) {
                const child = integers.widen(readonly_types.first[state.index])

                if (
                    kind(readonly_types.kinds[child]) == Kind.List &&
                        state.values[child]
                ) {
                    state.values[state.index] = true
                }
            }

            state.index += 1
        },
        return: state => state.values
    })
}
