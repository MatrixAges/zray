import construct from "./construct"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const record = construct({
        context: in.context,
        fields: in.fields,
        first: in.source.field_base,
        layout: in.source.layout,
        value: in.source.value,
        storage: in.root
    })

    return {
        source: in.source,
        ...record
    }
}
