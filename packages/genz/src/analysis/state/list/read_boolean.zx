import integers from "std:integer"

import { ExpressionsKind } from "../../../printer/model/expressions"

import type { Ast } from "./model"

export type Input = {
    ast: Ast,
    value: u32
}

export type Output = bool?

export default function (in: Input): Output {
    const index = integers.widen(in.value)

    if (in.ast.tags[index] == ExpressionsKind.Boolean) {
        return in.ast.boolean[integers.widen(in.ast.offsets[index])]
    }

    return null
}
