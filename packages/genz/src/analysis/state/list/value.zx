import bytes from "std:bytes"

import conditional from "../../../ast/context/conditional"
import field from "../../../ast/context/field"
import { items_field } from "../../types/state/const"
import chooseKnown from "./choose_known"
import { Operation, Storage } from "./const"
import permission from "./permission"
import tag from "./tag"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source
    const operation = source.operation

    if (operation == Operation.Weakened) {
        const header = permission({
            state: in.context,
            value: in.root,
            operation: Operation.Headered
        })

        const value = chooseKnown({
            state: header.state,
            condition: header.id,
            known: null,
            yes: Storage.Shared,
            no: Storage.Plain
        })

        return {
            ...in,
            context: value.state,
            root: value.id
        }
    }

    if (operation == Operation.Owned) {
        const value = chooseKnown({
            state: in.context,
            condition: source.condition,
            known: source.known.condition,
            yes: Storage.Exclusive,
            no: Storage.Owned
        })

        return {
            ...in,
            context: value.state,
            root: value.id
        }
    }

    if (operation == Operation.Proven) {
        if (source.known.condition != null) {
            const value = chooseKnown({
                state: in.context,
                condition: source.unique,
                known: source.known.unique,
                yes: source.known.condition ? Storage.Exclusive : Storage.Owned,
                no: source.known.condition ? Storage.Shared : Storage.Plain
            })

            return {
                ...in,
                context: value.state,
                root: value.id
            }
        }

        if (source.condition == source.unique) {
            const value = chooseKnown({
                state: in.context,
                condition: source.condition,
                known: null,
                yes: Storage.Exclusive,
                no: Storage.Plain
            })

            return {
                ...in,
                context: value.state,
                root: value.id
            }
        }

        const yes = chooseKnown({
            state: in.context,
            condition: source.unique,
            known: source.known.unique,
            yes: Storage.Exclusive,
            no: Storage.Shared
        })

        const no = chooseKnown({
            state: yes.state,
            condition: source.unique,
            known: source.known.unique,
            yes: Storage.Owned,
            no: Storage.Plain
        })

        const value = conditional({
            state: no.state,
            condition: source.condition,
            yes: yes.id,
            no: no.id
        })

        return {
            ...in,
            context: value.state,
            root: value.id
        }
    }

    const root = match operation {
        Operation.Items => field({
            state: in.context,
            target: in.root,
            name: bytes.fromText(items_field)
        }),
        Operation.Tag => tag({
            state: in.context,
            storage: source.storage
        }),
        Operation.Headered => permission({
            state: in.context,
            value: in.root,
            operation
        }),
        Operation.Exclusive => permission({
            state: in.context,
            value: in.root,
            operation
        }),
        Operation.Writable => permission({
            state: in.context,
            value: in.root,
            operation
        }),
        Operation.Create => chooseKnown({
            state: in.context,
            condition: source.condition,
            known: source.known.condition,
            yes: Storage.Shared,
            no: Storage.Plain
        }),
        _ => tag({
            state: in.context,
            storage: source.flag ? Storage.Shared : Storage.Plain
        })
    }

    return {
        ...in,
        context: root.state,
        root: root.id
    }
}
