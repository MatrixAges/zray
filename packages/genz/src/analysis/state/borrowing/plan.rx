<Module>
    <Type from="collect" as="Collect" />
    <Type from="../../facts/allocators" as="Allocators" />

    <Args
        in={Collect.Input & {
            allocator: Allocators.Resource
        }}
        out={bool[]}
    />

    <Call
        fn="collect"
        in={{
            program: $in.program,
            boxed: $in.boxed
        }}
    />

    <Call fn="../../types/unmarked" in={$in.program.types} />

    <Call
        fn="../../types/closure"
        in={{
            types: $in.program.types,
            boxed: $ctx.unmarked,
            roots: $ctx.collect.roots
        }}
    />

    <Call
        fn="select"
        in={{
            types: $in.program.types,
            boxed: $in.boxed,
            counts: $ctx.collect.counts,
            escaped: $ctx.closure,
            allocator: $in.allocator
        }}
    />

    <Return value={$ctx.select} />
</Module>
