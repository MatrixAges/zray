import {
    appendAstBindingRows,
    appendAstIdentifierRows,
    readAstOrigin
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import operandRows from "../binding/operand_rows"
import reference from "../binding/reference"

import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    sequence: AstSequence,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, origin, sequence, value } = in

    const current = readAstOrigin(writer, origin)

    const bound = reference({
        expression_base: current.expression_base,
        serial: current.serial
    })

    requireAllocation(bound.valid)

    const name = host.retainLoweringText(frame, bound.name)

    const rows = operandRows({
        name,
        value
    })

    appendAstBindingRows(writer, sequence, rows.statements)
    appendAstIdentifierRows(writer, rows.expressions)
    host.finishGeneratedAst(frame, bound.serial, false)

    return bound.root
}
