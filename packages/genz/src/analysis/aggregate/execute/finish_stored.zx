import integers from "std:integer"
import {
    appendAstBlockRows,
    appendAstLeafStatements,
    readAstOrigin
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import unpackSpan from "../../tasks/worker/execute/reference"
import blockRows from "../binding/block_rows"
import breakRows from "../binding/break_rows"
import plan from "../binding/plan"
import resultInput from "../binding/result_input"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Guard } from "../binding/model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    span: u64,
    value: u32,
    guard?: Guard
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, span, value, guard } = in

    const unpacked = unpackSpan(span)
    const current = readAstOrigin(writer)

    const planned = plan(
        resultInput({
            frame,
            writer,
            block: {
                value,
                expression_base: current.expression_base,
                statement_base: unpacked.start,
                body_count: integers.widen(unpacked.count),
                serial: current.serial
            },
            guard
        })
    )

    requireAllocation(planned.valid)

    const name = host.retainLoweringText(frame, planned.name)

    const break_statements = breakRows({
        name,
        value: planned.value
    })

    const block_expressions = blockRows({
        plan: planned,
        name,
        guard
    })

    appendAstLeafStatements(writer, break_statements)
    appendAstBlockRows(writer, block_expressions.block, block_expressions.conditionals)
    host.finishGeneratedAst(frame, planned.serial, false)

    return planned.root
}
