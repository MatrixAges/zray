import bytes from "std:bytes"
import {
    appendExpressionRows,
    appendStatementRows,
    AstPayloadOwnership,
    readAstOrigin
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import addressColumns from "../../../ast/rows/address_columns"
import emptyStatements from "../../../ast/statements/empty"
import discard from "../../statements/basic/discard"
import blockRows from "../binding/block_rows"
import breakRows from "../binding/break_rows"
import plan from "../binding/plan"
import pointer from "../layout/borrowed/pointer"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    seed: u32,
    name: string,
    evaluated: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, seed, name, evaluated } = in

    const current = readAstOrigin(writer)

    const address = pointer({
        seed,
        name: bytes.fromText(name),
        base: current.expression_base
    })

    const discarded = discard({
        value: evaluated
    })

    const planned = plan({
        statement_base: current.statement_base,
        serial: current.serial,
        value: address.root,
        expression_base: address.next,
        body_count: discarded.tags.length
    })

    requireAllocation(planned.valid)

    const label = host.retainLoweringText(frame, planned.name)

    const columns = addressColumns(address.nodes)

    appendExpressionRows(
        writer,
        columns.rows,
        columns.forms,
        AstPayloadOwnership.Borrowed
    )

    const break_statements = breakRows({
        name: label,
        value: planned.value
    })

    const block_expressions = blockRows({
        plan: planned,
        name: label,
        guard: null
    })

    appendStatementRows(
        writer,
        {
            ...emptyStatements({}),
            ...discarded.pick([
                "tags",
                "offsets",
                "discard"
            ])
        },
        null,
        AstPayloadOwnership.Borrowed
    )

    appendStatementRows(writer, break_statements, null, AstPayloadOwnership.Borrowed)

    appendExpressionRows(
        writer,
        block_expressions.block,
        block_expressions.conditionals,
        AstPayloadOwnership.Borrowed
    )

    host.finishGeneratedAst(frame, planned.serial, false)

    return planned.root
}
