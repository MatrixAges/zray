import { finishAstSequence } from "ast_rows"

import finishStored from "./finish_stored"

import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, sequence, value } = in

    return finishStored({
        frame,
        writer,
        span: finishAstSequence(writer, sequence),
        value,
        guard: null
    })
}
