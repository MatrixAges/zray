import {
    appendAstObjectFields,
    appendExpressionRows,
    AstPayloadOwnership,
    astExpressionCount,
    astFieldCount
} from "ast_rows"

import operandsColumns from "../../../ast/rows/operands_columns"
import objectExpression from "../object/expression"
import selectFields from "../object/fields"

import type { AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    type_expr: u32,
    names: string[],
    indices: u32[],
    values: u32[]
}

export type Output = u32

export default function (in: Input): Output {
    const { writer, type_expr, names, indices, values } = in

    const base = astExpressionCount(writer)
    const first = astFieldCount(writer)

    const fields = selectFields({
        names,
        first: 0,
        indices,
        values
    })

    const expression = objectExpression({
        type_expr,
        first,
        count: fields.name.length
    })

    appendAstObjectFields(writer, fields)

    const columns = operandsColumns({
        ...expression,
        tuple: [],
        builtin_name: [],
        builtin_arguments: [],
        identifier: [],
        address_of: []
    })

    appendExpressionRows(
        writer,
        columns.rows,
        columns.forms,
        AstPayloadOwnership.Borrowed
    )

    return base
}
