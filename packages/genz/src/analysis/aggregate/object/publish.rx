<Module>
    <Type from="publication" as="Object" />

    <Args in={Object.Input} out={u32} />

    <Call
        module="build"
        in={$in.pick([
            "type_expr",
            "first",
            "selection"
        ])}
    />

    <Call
        fn="publication.appendAstObjectFields"
        in={[
            $in.writer,
            $ctx.build.fields
        ]}
    />

    <Call
        fn="publication.appendAstObjectRows"
        in={[
            $in.writer,
            $ctx.build.expression
        ]}
    />

    <Return value={$in.base} />
</Module>
