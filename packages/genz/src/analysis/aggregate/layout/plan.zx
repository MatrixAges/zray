import fields from "./fields"
import { Route } from "./fields"

import type { Output as Fields } from "./fields"

export type Input = {
    expression: u64,
    loop_states?: bool[],
    state_active: bool,
    selected: bool,
    layout_only: bool,
    updated: bool,
    indices: u32[],
    borrowed?: bool[]
}

export type Output = Fields & {
    project: bool,
    construct: bool
}

export default function (in: Input): Output {
    if (in.updated) {
        return {
            project: false,
            plain: Route.Direct,
            routes: [],
            construct: !in.layout_only && !in.selected
        }
    }

    const states = in.loop_states

    const project = match {
        states == null => false,
        _ => states[in.expression]
    }

    const routes = fields({
        indices: in.indices,
        borrowed: project ? in.borrowed : null,
        convert: in.state_active && !in.selected
    })

    return {
        ...routes,
        project,
        construct: !in.layout_only && !project
    }
}
