<Module>
    <Type from="model" as="Borrowed" />

    <Args in={Borrowed.Input} out={u32} />

    <Call
        fn="pointer"
        in={{
            seed: $in.seed,
            name: $in.name,
            base: $in.expression_base
        }}
    />

    <Call
        fn="../../../statements/basic/discard"
        in={{
            value: $in.evaluated
        }}
    />

    <Call
        fn="../../binding/plan"
        in={{
            ...$in.pick([
                "statement_base",
                "serial"
            ]),
            value: $ctx.pointer.root,
            expression_base: $ctx.pointer.next,
            body_count: $ctx.discard.tags.length
        }}
    />

    <Call fn="../../binding/rows.requireAllocation" in={$ctx.plan.valid} />

    <Call
        fn="../../binding/rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.plan.name
        ]}
    />

    <Call
        fn="../../binding/rows.appendAstFieldAddresses"
        in={[
            $in.writer,
            $ctx.pointer.nodes
        ]}
    />

    <Call
        module="../../binding/publish"
        in={{
            ...$in.pick([
                "writer",
                "frame"
            ]),
            plan: {
                ...$ctx.plan,
                name: $ctx.retainLoweringText
            },
            body: {
                ...$ctx.discard.pick([
                    "tags",
                    "offsets",
                    "discard"
                ]),
                expression: [],
                constant_name: [],
                constant_type_expr: [],
                constant_value: [],
                constant_exported: []
            },
            guard: null,
            uses_allocator: false
        }}
    />

    <Return value={$ctx.publish} />
</Module>
