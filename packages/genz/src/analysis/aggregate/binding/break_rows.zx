import empty from "../../../ast/statements/empty"
import { StatementsKind } from "../../../printer/model/statements"

import type { StatementRows as Output } from "ast_rows"

export type Input = {
    name: u8[],
    value: u32
}

export default function (in: Input): Output {
    return {
        ...empty({}),
        tags: [StatementsKind.BreakValue],
        offsets: [0],
        break_value_label: [in.name],
        break_value_value: [in.value]
    }
}
