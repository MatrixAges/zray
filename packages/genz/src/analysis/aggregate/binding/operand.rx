<Module>
    <Type from="publication" as="Binding" />
    <Type from="rows" as="AST" />

    <Args in={Binding.Operand} out={u32} />

    <Call
        fn="reference"
        in={$in.pick([
            "expression_base",
            "serial"
        ])}
    />

    <Call fn="rows.requireAllocation" in={$ctx.reference.valid} />

    <Call
        fn="rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.reference.name
        ]}
    />

    <Call
        fn="operand_rows"
        in={{
            name: $ctx.retainLoweringText,
            value: $in.value
        }}
    />

    <Call
        fn="rows.appendAstBindingRows"
        in={[
            $in.writer,
            $in.sequence,
            $ctx.operand_rows.statements
        ]}
    />

    <Call
        fn="rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.operand_rows.expressions,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="rows.finishGeneratedAst"
        in={[
            $in.frame,
            $ctx.reference.serial,
            false
        ]}
    />

    <Return value={$ctx.reference.root} />
</Module>
