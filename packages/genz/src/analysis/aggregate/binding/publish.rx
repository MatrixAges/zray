<Module>
    <Type from="publication" as="Binding" />
    <Type from="rows" as="AST" />

    <Args in={Binding.Publication} out={u32} />

    <Call
        fn="break_rows"
        in={{
            name: $in.plan.name,
            value: $in.plan.value
        }}
    />

    <Call
        fn="block_rows"
        in={{
            ...$in.pick([
                "plan",
                "guard"
            ]),
            name: $in.plan.name
        }}
    />

    <If on={$in.body != null}>
        <Call fn="../../../ast/statements/empty" in={{}} />

        <Call
            fn="rows.appendStatementRows"
            in={[
                $in.writer,
                {
                    ...$ctx.empty,
                    ...$in.body
                },
                null,
                AST.AstPayloadOwnership.Borrowed
            ]}
        />
    </If>

    <Call
        fn="rows.appendStatementRows"
        in={[
            $in.writer,
            $ctx.break_rows,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="rows.appendAstBlockRows"
        in={[
            $in.writer,
            $ctx.block_rows.block,
            $ctx.block_rows.conditionals
        ]}
    />

    <Call
        fn="rows.finishGeneratedAst"
        in={[
            $in.frame,
            $in.plan.serial,
            $in.uses_allocator
        ]}
    />

    <Return value={$in.plan.root} />
</Module>
