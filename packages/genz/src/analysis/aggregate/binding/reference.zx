import { max_u32 } from "core/const"

import { operand_prefix } from "../../../ast/context/const"
import fresh from "../../../ast/fresh"

export type Input = {
    expression_base: u32,
    serial: u64
}

export type Output = {
    name: u8[],
    serial: u64,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    const name = fresh({
        serial: in.serial,
        prefix: operand_prefix
    })

    return {
        name: name.name,
        serial: name.serial,
        root: in.expression_base,
        valid: in.expression_base < max_u32
    }
}
