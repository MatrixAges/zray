export type Input = {
    value: u32,
    expression_base: u32,
    statement_base: u32,
    body_count: u64,
    serial: u64
}

export type Plan = Input.Pick("value", "statement_base") & {
    name: u8[],
    count: u32,
    serial: u64,
    root: u32,
    valid: bool
}

export type Guard = {
    condition: u32,
    yes: u32,
    no: u32
}
