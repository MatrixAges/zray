import header from "../../../ast/statements/header"
import { StatementsKind } from "../../../printer/model/statements"
import read from "./read"

import type { Statements } from "./model"
import type { Input as Read } from "./read"

export type Rows = Statements.Pick("tags", "offsets", "discard")

export type Output = Rows & {
    valid: bool
}

export type Input = Output & Read.Omit("key") & {
    evaluation: u32[],
    prior: u64[],
    references: u32[]
}

export default function (in: Input): Output {
    return loop({
        ...in.pick([
            "tags",
            "offsets",
            "discard",
            "valid"
        ]),
        index: 0
    }, {
        while: current => current.valid && current.index < in.evaluation.length,
        next: current => {
            const index = current.index

            const count = read({
                key: in.evaluation[index],
                dense: in.dense,
                sparse: in.sparse
            })

            if (count == in.prior[index]) {
                const value = header({
                    tags: current.tags,
                    offsets: current.offsets,
                    base: 0,
                    kind: StatementsKind.Discard,
                    offset: current.discard.length
                })

                current.tags = value.tags
                current.offsets = value.offsets
                current.valid = value.valid
                current.discard = current.discard.push(in.references[index])[0]
            }

            current.index += 1
        },
        return: state => state.omit(["index"])
    })
}
