import type { AstSequence, AstWriter } from "ast_rows"
import type { Input as Bind } from "./bindings"
import type { Input as Retire } from "./retire"

export type Target = {
    writer: AstWriter,
    sequence: AstSequence
}

export type Binding = Target & Bind

export type Retirement = Target & Retire.Pick("evaluation", "prior", "references") & {
    dense: u64[]
}

export { appendAstBindingRows } from "ast_rows"
export { requireAllocation } from "memory"
