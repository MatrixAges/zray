<Module>
    <Type from="publication" as="Operands" />

    <Args in={Operands.Retirement} out={void} />

    <If on={$in.evaluation.length != 0}>
        <Call
            fn="retire"
            in={{
                ...$in.pick([
                    "dense",
                    "evaluation",
                    "prior",
                    "references"
                ]),
                tags: [],
                offsets: [],
                discard: [],
                sparse: null,
                valid: true
            }}
        />

        <Call fn="publication.requireAllocation" in={$ctx.retire.valid} />

        <If on={$ctx.retire.tags.length != 0}>
            <Call
                fn="publication.appendAstBindingRows"
                in={[
                    $in.writer,
                    $in.sequence,
                    {
                        ...$ctx.retire.omit(["valid"]),
                        constant_name: [],
                        constant_type_expr: [],
                        constant_value: [],
                        constant_exported: [],
                        variable_name: [],
                        variable_type_expr: [],
                        variable_value: [],
                        variable_exported: [],
                        break_value_label: [],
                        break_value_value: []
                    }
                ]}
            />
        </If>
    </If>
</Module>
