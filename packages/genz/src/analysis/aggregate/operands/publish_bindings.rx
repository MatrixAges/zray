<Module>
    <Type from="publication" as="Operands" />

    <Args in={Operands.Binding} out={void} />

    <If on={$in.names.length != 0}>
        <Call
            fn="bindings"
            in={$in.pick([
                "names",
                "values"
            ])}
        />

        <Call
            fn="publication.appendAstBindingRows"
            in={[
                $in.writer,
                $in.sequence,
                {
                    ...$ctx.bindings,
                    variable_name: [],
                    variable_type_expr: [],
                    variable_value: [],
                    variable_exported: [],
                    break_value_label: [],
                    break_value_value: []
                }
            ]}
        />
    </If>
</Module>
