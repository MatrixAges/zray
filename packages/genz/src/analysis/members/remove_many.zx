import remove from "core/integer/index/remove"

import type { Mutable } from "core/integer/index/model"

export type Input = {
    index: Mutable,
    keys: u32[]
}

export type Output = u64

export default function (in: Input): Output {
    return loop({
        count: in.index.count,
        position: 0
    }, {
        while: state => state.position < in.keys.length,
        next: state => {
            const removed = remove({
                ...in.index,
                count: state.count,
                key: in.keys[state.position]
            })

            if (removed != null) {
                state.count -= 1
            }

            state.position += 1
        },
        return: state => state.count
    })
}
