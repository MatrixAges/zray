import insert from "core/integer/index/insert"

import type { Index } from "core/integer/index/model"

export type Output = {
    index: Index,
    added: u32[]
}

export type Input = Output & {
    symbol: u32
}

export default function (in: Input): Output {
    const added = in.added.push(in.symbol)[0]

    const registered = insert({
        index: in.index,
        key: in.symbol
    })

    return {
        index: registered.index,
        added
    }
}
