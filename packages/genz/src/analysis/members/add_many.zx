import insert from "core/integer/index/insert"

import type { Index as Output } from "core/integer/index/model"

export type Input = {
    index: Output,
    keys: u32[]
}

export default function (in: Input): Output {
    return loop({
        index: in.index,
        position: 0
    }, {
        while: state => state.position < in.keys.length,
        next: state => {
            state.index = insert({
                index: state.index,
                key: in.keys[state.position]
            }).index
            state.position += 1
        },
        return: state => state.index
    })
}
