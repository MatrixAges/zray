import integers from "std:integer"
import { max_u32 } from "core/const"
import probe from "core/integer/index/probe"
import reserve from "core/integer/index/reserve"
import memory from "memory"

import add from "./add"

import type { Index as Output } from "core/integer/index/model"
import type { U32Buffer } from "memory"

export type Input = {
    index: Output,
    keys: u32[],
    key_buffer: U32Buffer,
    bucket_buffer: U32Buffer
}

export default function (in: Input): Output {
    if (in.keys.length == 0) {
        return in.index
    }

    if (in.keys.length == 1) {
        return add({
            index: in.index,
            key: in.keys[0]
        })
    }

    const index = reserve({
        ...in.index,
        additional: in.keys.length
    })

    memory.bindU32Views(in.key_buffer, index.keys)
    memory.bindU32Views(in.bucket_buffer, index.buckets)

    const count = loop({
        count: index.count,
        position: 0
    }, {
        while: state => state.position < in.keys.length,
        next: state => {
            const key = in.keys[state.position]
            const bucket = probe({
                keys: index.keys,
                buckets: index.buckets,
                key
            })

            if (memory.readU32(in.bucket_buffer, bucket) == max_u32) {
                memory.writeU32(in.key_buffer, state.count, key)
                memory.writeU32(
                    in.bucket_buffer,
                    bucket,
                    integers.narrow(state.count)
                )
                state.count += 1
            }

            state.position += 1
        },
        return: state => state.count
    })

    return {
        ...index,
        count
    }
}
