import ast from "ast_rows"
import { AstSequenceMode } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import emptyVariables from "../../../../ast/statements/empty_variables"
import cache from "../../resources/cache"

import type { PublishAst as Input } from "./execute_model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, body, context, output } = in

    requireAllocation(output.valid)
    ast.appendLayoutExpressions(writer, output.expressions, output.layouts)
    ast.appendOwnedAstFields(writer, output.fields)

    ast.appendStatementSequence(
        writer,
        body,
        output.statements,
        emptyVariables({}),
        AstSequenceMode.Owned
    )

    cache({
        frame: context,
        types: output.cache_types,
        values: output.cache_values
    })

    host.finishGeneratedAst(frame, output.serial, false)

    return output.root
}
