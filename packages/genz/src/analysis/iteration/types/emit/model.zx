import type { ExpressionLayouts as Layouts } from "ast_rows"
import type { Table } from "core/type_table/model"
import type { Columns as Expressions } from "../../../../ast/expressions/model"
import type { Columns as Fields } from "../../../../ast/fields/model"
import type { Columns as Statements } from "../../../../ast/statements/model"
import type { Plan } from "../model"

export type { ExpressionLayouts as Layouts } from "ast_rows"

export type Input = {
    types: Table,
    plan: Plan,
    prepared: u32[],
    expression_base: u32,
    field_base: u32,
    serial: u64
}

export type State = {
    source: Input,
    index: u64,
    expressions: Expressions,
    layouts: Layouts,
    fields: Fields,
    statements: Statements,
    values: u32[],
    cache_types: u32[],
    cache_values: u32[],
    serial: u64,
    valid: bool
}

export type Node = {
    state: State,
    id: u32
}

export type Output = {
    expressions: Expressions,
    layouts: Layouts,
    fields: Fields,
    statements: Statements,
    cache_types: u32[],
    cache_values: u32[],
    root: u32,
    serial: u64,
    valid: bool
}
