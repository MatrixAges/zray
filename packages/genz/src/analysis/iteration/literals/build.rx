<Module>
    <Type from="publication" as="Publication" />

    <Args in={Publication.Input} out={u32} />

    <Call
        module="emit"
        in={$in.omit([
            "frame",
            "writer"
        ])}
    />

    <Call fn="publication.requireAllocation" in={$ctx.emit.valid} />

    <Call
        fn="block_input"
        in={{
            bases: $in.bases,
            literal: $ctx.emit
        }}
    />

    <Call fn="../../aggregate/binding/plan" />

    <Call fn="publication.requireAllocation" in={$ctx.plan.valid} />

    <Call
        fn="publication.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.emit.expressions,
            $ctx.emit.forms,
            Publication.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="publication.appendAstObjectFields"
        in={[
            $in.writer,
            $ctx.emit.fields
        ]}
    />

    <Call
        fn="../../aggregate/binding/rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.plan.name
        ]}
    />

    <Call
        module="../../aggregate/binding/publish"
        in={{
            ...$in.pick([
                "frame",
                "writer"
            ]),
            plan: {
                ...$ctx.plan,
                name: $ctx.retainLoweringText
            },
            body: {
                ...$ctx.emit.statements,
                expression: []
            },
            guard: null,
            uses_allocator: $ctx.emit.uses_allocator
        }}
    />

    <Return value={$ctx.publish} />
</Module>
