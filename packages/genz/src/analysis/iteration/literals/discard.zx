import retire from "../../aggregate/operands/retire"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const source = in.source

    const rows = retire({
        tags: in.statements.tags,
        offsets: in.statements.offsets,
        discard: in.statements.discard,
        valid: in.context.valid,
        dense: null,
        sparse: source.reads,
        evaluation: source.evaluation,
        prior: source.prior,
        references: source.bindings.references
    })

    return {
        ...in,
        statements: {
            ...in.statements,
            ...rows.omit(["valid"])
        },
        context: {
            ...in.context,
            valid: rows.valid
        }
    }
}
