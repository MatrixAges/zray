import projection from "../../consumer/projection"
import scalar from "../../consumer/scalar"
import primitive from "../../types/primitive"
import { Mode } from "./model"

import type { Input, Decision as Output } from "./model"

export default function (in: Input): Output {
    if (in.mode == Mode.Eligible && in.capture) {
        return {
            traverse: false,
            primitive: false,
            valid: false
        }
    }

    const type_id = in.table.types[in.result]

    const is_primitive = primitive({
        types: in.types,
        id: type_id
    })

    if (in.mode == Mode.Candidate) {
        const direct = scalar({
            types: in.types,
            id: type_id
        })

        if (direct) {
            return {
                traverse: false,
                primitive: is_primitive,
                valid: projection(in.pick([
                    "table",
                    "symbol",
                    "result"
                ]))
            }
        }
    }

    const returning = in.mode == Mode.Plan || in.mode == Mode.Buffered

    if (returning && is_primitive) {
        return {
            traverse: false,
            primitive: true,
            valid: true
        }
    }

    if (is_primitive) {
        return {
            traverse: false,
            primitive: is_primitive,
            valid: false
        }
    }

    return {
        traverse: true,
        primitive: is_primitive,
        valid: true
    }
}
