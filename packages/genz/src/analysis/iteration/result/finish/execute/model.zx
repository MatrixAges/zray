import type { LoopResultFrame } from "lowering_host"
import type { Completion, Input as Facts, Preparation } from "../model"

export type Input = {
    target: LoopResultFrame,
    state: u32,
    facts: Facts
}

export type Actions = {
    target: LoopResultFrame,
    state: u32,
    preparation: Preparation,
    completion: Completion
}

export type Complete = Actions.Pick("target", "state", "completion") & {
    prepared: u32
}
