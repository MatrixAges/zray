import type { AstSequence, AstWriter } from "ast_rows"
import type { IterationResourceFrame, LoopConsumer, Lowering } from "lowering_host"
import type { Completion, Input as Facts, Preparation } from "../model"

export type Input = {
    context: IterationResourceFrame,
    consumer?: LoopConsumer,
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    wrap: AstSequence,
    changed_name: u8[],
    type_id: u32,
    state: u32,
    initial: u32,
    renewals: u64,
    declarations: u64,
    frame_span: u64,
    facts: Facts
}

export type Actions =
    Input.Pick(
        "context",
        "consumer",
        "frame",
        "writer",
        "body",
        "wrap",
        "state",
        "type_id"
    ) & {
        preparation: Preparation,
        completion: Completion
    }

export type Complete =
    Input.Pick(
        "context",
        "frame",
        "writer",
        "body",
        "changed_name",
        "type_id",
        "state",
        "initial",
        "renewals",
        "declarations",
        "frame_span"
    ) & {
        completion: Completion,
        prepared: u32
    }
