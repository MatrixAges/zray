import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { LoopResultFrame, Lowering } from "lowering_host"
import type { Completion, Input as Facts, Preparation } from "../model"

export type Input = {
    target: LoopResultFrame,
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body: AstSequence,
    changed_name: u8[],
    state: u32,
    initial: u32,
    renewals: u64,
    declarations: u64,
    frame_span: u64,
    facts: Facts
}

export type Actions =
    Input.Pick("target", "frame", "writer", "origin", "state") & {
        preparation: Preparation,
        completion: Completion
    }

export type Complete =
    Input.Pick(
        "target",
        "frame",
        "writer",
        "origin",
        "body",
        "changed_name",
        "state",
        "initial",
        "renewals",
        "declarations",
        "frame_span"
    ) & {
        completion: Completion,
        prepared: u32
    }
