import integers from "std:integer"
import {
    convertStateValue,
    readAstOrigin,
    StateValueMode,
    takeAstSequence
} from "ast_rows"
import host from "lowering_host"

import bindOperand from "../../../../aggregate/execute/bind_operand"
import finishStored from "../../../../aggregate/execute/finish_stored"
import emitUnit from "../../../../collections/workflow/emit_unit"
import { word_radix } from "../../../../node_headers/block/const"
import { Preparation } from "../model"

import type { Actions as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { consumer, frame, writer, body, wrap, state, type_id } = in

    if (in.preparation == Preparation.Reserve) {
        const current = readAstOrigin(writer)

        host.finishGeneratedAst(frame, current.serial + 1, false)

        return state
    }

    if (in.preparation == Preparation.Block) {
        const current = readAstOrigin(writer)

        return finishStored({
            frame,
            writer,
            span: integers.widen(current.statement_base) * word_radix,
            value: state,
            guard: null
        })
    }

    if (consumer != null) {
        const buffered = in.preparation == Preparation.BufferedConsumer
        const planned = buffered || in.preparation == Preparation.DeepConsumer
        const row: u32? = planned ? null : consumer.result

        const projected =
            host.projectIterationResult(frame, buffered, consumer, state, row)

        if (in.preparation == Preparation.ConvertedConsumer) {
            const bound = bindOperand({
                frame,
                writer,
                sequence: body,
                value: projected
            })

            return convertStateValue(
                writer,
                body,
                consumer.result_type,
                bound,
                StateValueMode.Pointer,
                false
            )
        }

        return projected
    }

    if (in.preparation == Preparation.Unit) {
        return emitUnit(writer)
    }

    const mode = match in.preparation {
        Preparation.Layout => StateValueMode.Layout,
        _ => StateValueMode.Pointer
    }

    const value = convertStateValue(writer, wrap, type_id, state, mode, false)

    return finishStored({
        frame,
        writer,
        value,
        span: takeAstSequence(writer, wrap, true),
        guard: null
    })
}
