import integers from "std:integer"
import {
    appendAstSequenceSpan,
    convertStateValue,
    readAstOrigin,
    StateValueMode,
    takeAstSequence
} from "ast_rows"
import host from "lowering_host"

import finishStored from "../../../../aggregate/execute/finish_stored"
import emitUnit from "../../../../collections/workflow/emit_unit"
import { word_radix } from "../../../../node_headers/block/const"
import { Preparation } from "../model"

import type { Actions as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { context, consumer, frame, writer, body, wrap, state, type_id } = in

    if (in.preparation == Preparation.Reserve) {
        const current = readAstOrigin(writer)

        host.finishGeneratedAst(frame, current.serial + 1, false)

        return state
    }

    if (in.preparation == Preparation.Block) {
        const current = readAstOrigin(writer)

        return finishStored({
            frame,
            writer,
            span: integers.widen(current.statement_base) * word_radix,
            value: state,
            guard: null
        })
    }

    if (consumer != null) {
        if (in.preparation == Preparation.DeepConsumer) {
            return host.consumeDeepLoopResult(frame, consumer, state)
        }

        const consumed = match in.preparation {
            Preparation.BufferedConsumer =>
                host.consumeBufferedLoopResult(context, consumer, state),
            _ =>
                host.consumeLoopProjection(
                    frame,
                    consumer,
                    state,
                    in.preparation == Preparation.ConvertedConsumer
                )
        }

        const appended = loop(0, {
            while: row => row < consumed.spans.length,
            next: row => {
                appendAstSequenceSpan(body, consumed.spans[row])

                row += 1
            }
        })

        appendAstSequenceSpan(body, consumed.tail)

        return consumed.value
    }

    if (in.preparation == Preparation.Unit) {
        return emitUnit(writer)
    }

    const mode = match in.preparation {
        Preparation.Layout => StateValueMode.Layout,
        _ => StateValueMode.Pointer
    }

    const value = convertStateValue(writer, wrap, type_id, state, mode, false)

    return finishStored({
        frame,
        writer,
        value,
        span: takeAstSequence(writer, wrap, true),
        guard: null
    })
}
