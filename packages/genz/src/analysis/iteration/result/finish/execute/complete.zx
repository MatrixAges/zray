import {
    AstPayloadOwnership,
    appendExpressionRows,
    astExpressionCount,
    statementSequenceBlock,
    tailAstPackedStatements
} from "ast_rows"
import host from "lowering_host"

import identifierRows from "../../../../aggregate/binding/identifier_rows"
import finishStored from "../../../../aggregate/execute/finish_stored"
import { Completion } from "../model"

import type { Guard } from "../../../../aggregate/binding/model"
import type { Complete as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const {
        context,
        frame,
        writer,
        body,
        changed_name,
        type_id,
        completion,
        state,
        initial,
        renewals,
        declarations,
        frame_span,
        prepared
    } = in

    const needs_guard = match completion {
        Completion.Prepared => false,
        Completion.State => false,
        _ => true
    }

    const guard: u32? = match {
        needs_guard => astExpressionCount(writer),
        _ => null
    }

    if (needs_guard) {
        appendExpressionRows(
            writer,
            identifierRows(changed_name),
            null,
            AstPayloadOwnership.Borrowed
        )
    }

    const value = match completion {
        Completion.Prepared => prepared,
        Completion.GuardPrepared => prepared,
        Completion.GuardDeep => host.convertLoopResult(context, type_id, state, true),
        Completion.GuardConstruct => host.constructValue(frame, type_id, state, null),
        _ => state
    }

    const appended = statementSequenceBlock(writer, body)

    const span = tailAstPackedStatements(writer, [
        renewals,
        declarations,
        frame_span,
        appended
    ])

    const checked: Guard? = match {
        guard == null => null,
        _ => {
            condition: guard,
            yes: value,
            no: initial
        }
    }

    return finishStored({
        frame,
        writer,
        span,
        value,
        guard: checked
    })
}
