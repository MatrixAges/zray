import {
    appendAstIdentifierRows,
    astExpressionCount,
    statementSequenceBlock,
    tailAstPackedStatements
} from "ast_rows"
import host from "lowering_host"

import { ExpressionsKind } from "../../../../../printer/model/expressions"
import finishStored from "../../../../aggregate/execute/finish_stored"
import { Completion } from "../model"

import type { Guard } from "../../../../aggregate/binding/model"
import type { Complete as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const {
        target,
        frame,
        writer,
        origin,
        body,
        changed_name,
        completion,
        state,
        initial,
        renewals,
        declarations,
        frame_span,
        prepared
    } = in

    const needs_guard = match completion {
        Completion.Prepared => false,
        Completion.State => false,
        _ => true
    }

    const guard: u32? = match {
        needs_guard => astExpressionCount(writer),
        _ => null
    }

    if (needs_guard) {
        appendAstIdentifierRows(writer, {
            tags: [ExpressionsKind.Identifier],
            offsets: [0],
            identifier: [changed_name]
        })
    }

    const value = match completion {
        Completion.Prepared => prepared,
        Completion.GuardPrepared => prepared,
        Completion.GuardDeep => host.convertLoopResult(target, true),
        Completion.GuardConstruct => host.convertLoopResult(target, false),
        _ => state
    }

    const appended = statementSequenceBlock(writer, body)

    const span = tailAstPackedStatements(writer, [
        renewals,
        declarations,
        frame_span,
        appended
    ])

    const checked: Guard? = match {
        guard == null => null,
        _ => {
            condition: guard,
            yes: value,
            no: initial
        }
    }

    return finishStored({
        frame,
        writer,
        origin,
        span,
        value,
        guard: checked
    })
}
