<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={u32} />

    <Call module="../plan" in={$in.facts} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "target",
                "frame",
                "writer",
                "origin",
                "state"
            ]),
            ...$ctx.plan
        }}
    />

    <Call
        fn="complete"
        in={{
            ...$in.pick([
                "target",
                "writer",
                "changed_name",
                "state"
            ]),
            completion: $ctx.plan.completion,
            prepared: $ctx.prepare
        }}
    />

    <Return value={$ctx.complete} />
</Module>
