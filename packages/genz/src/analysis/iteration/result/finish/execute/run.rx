<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Input} out={u32} />

    <Call module="../plan" in={$in.facts} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "context",
                "consumer",
                "frame",
                "writer",
                "body",
                "state",
                "type_id"
            ]),
            ...$ctx.plan
        }}
    />

    <Call
        fn="complete"
        in={{
            ...$in.pick([
                "context",
                "frame",
                "writer",
                "body",
                "changed_name",
                "type_id",
                "state",
                "initial",
                "renewals",
                "declarations",
                "frame_span"
            ]),
            completion: $ctx.plan.completion,
            prepared: $ctx.prepare
        }}
    />

    <Return value={$ctx.complete} />
</Module>
