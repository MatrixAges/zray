<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.TransferCursor} out={Flow.TransferCursor} />

    <Call
        fn="model.projectIterationResult"
        in={[
            $in.lower,
            true,
            $in.consumer,
            $in.state,
            $in.plan.transfers[$in.row]
        ]}
    />

    <If on={$in.plan.reuse[$in.row]}>
        <Call
            fn="model.cacheLoweredOperand"
            in={[
                $in.lower,
                $in.plan.transfers[$in.row],
                $in.slots[$in.plan.slots[$in.row]]
            ]}
        />

        <Return
            value={{
                ...$in,
                row: $in.row + 1,
                running: $in.row + 1 < $in.plan.transfers.length
            }}
        />
    </If>

    <Call
        fn="model.transferIterationResult"
        in={[
            $in.lower,
            $in.plan.transfers[$in.row],
            $ctx.projectIterationResult
        ]}
    />

    <Call
        fn="model.cacheLoweredOperand"
        in={[
            $in.lower,
            $in.plan.transfers[$in.row],
            $ctx.transferIterationResult.root
        ]}
    />

    <Call
        fn="append_slot"
        in={{
            slots: $in.slots,
            cached: $ctx.transferIterationResult.cached
        }}
    />

    <Return
        value={{
            ...$in,
            slots: $ctx.append_slot,
            row: $in.row + 1,
            running: $in.row + 1 < $in.plan.transfers.length
        }}
    />
</Module>
