<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.ReadCursor} out={Flow.ReadCursor} />

    <Call
        fn="model.projectIterationResult"
        in={[
            $in.lower,
            $in.context,
            $in.consumer,
            $in.state,
            $in.ids[$in.row]
        ]}
    />

    <Call
        fn="model.cacheLoweredOperand"
        in={[
            $in.lower,
            $in.ids[$in.row],
            $ctx.projectIterationResult
        ]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            running: $in.row + 1 < $in.ids.length
        }}
    />
</Module>
