<Module>
    <Type from="model" as="Application" />

    <Args in={Application.Input} out={u32} />

    <If on={$in.plan.primitive}>
        <Call
            fn="model.projectIterationResult"
            in={[
                $in.lower,
                $in.buffered,
                $in.consumer,
                $in.state,
                $in.consumer.result
            ]}
        />

        <Return value={$ctx.projectIterationResult} />
    </If>

    <If on={$in.buffered}>
        <Loop on={$in.running}>
            <Call
                module="transfer_row"
                in={{
                    ...$in.pick([
                        "lower",
                        "consumer",
                        "state",
                        "plan"
                    ]),
                    slots: [],
                    row: 0,
                    running: $in.plan.transfers.length != 0
                }}
            />
        </Loop>
    </If>

    <Call fn="reads" in={$in.pick(["plan"])} />

    <Loop on={$in.running}>
        <Call
            module="read_row"
            in={{
                ...$in.pick([
                    "lower",
                    "consumer",
                    "state"
                ]),
                buffered: $in.buffered,
                ids: $ctx.reads,
                row: 0,
                running: $ctx.reads.length != 0
            }}
        />
    </Loop>

    <If on={$in.consumer.layout}>
        <Call
            fn="model.lowerValueExpression"
            in={[
                $in.lower,
                $in.consumer.result
            ]}
        />

        <Return value={$ctx.lowerValueExpression} />
    </If>

    <Call
        fn="model.lowerExpression"
        in={[
            $in.lower,
            $in.consumer.result,
            false,
            null
        ]}
    />

    <Return value={$ctx.lowerExpression} />
</Module>
