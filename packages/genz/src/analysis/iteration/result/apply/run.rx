<Module>
    <Type from="model" as="Application" />

    <Args in={Application.Input} out={u32} />

    <If on={$in.plan.primitive}>
        <Call
            fn="model.projectIterationResult"
            in={[
                $in.frame,
                $in.result
            ]}
        />

        <Return value={$ctx.projectIterationResult} />
    </If>

    <If on={$in.buffered}>
        <Loop on={$in.running}>
            <Call
                module="transfer_row"
                in={{
                    frame: $in.frame,
                    plan: $in.plan,
                    slots: $in.slots,
                    row: 0,
                    running: $in.plan.transfers.length != 0
                }}
            />
        </Loop>
    </If>

    <Call fn="reads" in={$in.pick(["plan"])} />

    <Loop on={$in.running}>
        <Call
            module="read_row"
            in={{
                frame: $in.frame,
                ids: $ctx.reads,
                row: 0,
                running: $ctx.reads.length != 0
            }}
        />
    </Loop>

    <If on={$in.layout}>
        <Call
            fn="model.lowerValueExpression"
            in={[
                $in.lower,
                $in.result
            ]}
        />

        <Return value={$ctx.lowerValueExpression} />
    </If>

    <Call
        fn="model.lowerExpression"
        in={[
            $in.lower,
            $in.result,
            false,
            null
        ]}
    />

    <Return value={$ctx.lowerExpression} />
</Module>
