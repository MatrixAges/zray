import type { LoopConsumer, Lowering } from "lowering_host"
import type { Output as Plan } from "../model"

export {
    cacheLoweredOperand,
    lowerExpression,
    lowerValueExpression,
    projectIterationResult,
    transferIterationResult
} from "lowering_host"

export type Projection = {
    lower: Lowering,
    consumer: LoopConsumer,
    state: u32
}

export type Input = Projection & {
    plan: Plan,
    buffered: bool
}

export type Reads = Input.Pick("plan")

export type ReadCursor = Projection & {
    buffered: bool,
    ids: u32[],
    row: u64,
    running: bool
}

export type TransferCursor = Projection & {
    plan: Plan,
    slots: u32[],
    row: u64,
    running: bool
}
