import host from "lowering_host"
import { StoredType } from "lowering_host"

import { Layout } from "../../parameters/layout"

import type { Declaration } from "./update_model"

export type Input = Declaration.Pick("frame", "type_id", "layout")

export type Output = u32

export default function (in: Input): Output {
    return match in.layout {
        Layout.Plain => host.lowerType(in.frame, in.type_id, false),
        Layout.Deep => host.materializeType(
            in.frame,
            in.type_id,
            StoredType.IterationType
        ),
        _ => host.materializeType(in.frame, in.type_id, StoredType.Layout)
    }
}
