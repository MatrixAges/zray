import { LoopParameterLayout } from "lowering_host"

import { Layout } from "../../parameters/layout"

export type Input = Layout

export type Output = LoopParameterLayout

export default function (in: Input): Output {
    return match in {
        Layout.Plain => LoopParameterLayout.Plain,
        Layout.Stack => LoopParameterLayout.Stack,
        Layout.State => LoopParameterLayout.State,
        _ => LoopParameterLayout.Deep
    }
}
