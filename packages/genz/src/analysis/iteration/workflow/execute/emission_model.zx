import type { AstSequence } from "ast_rows"
import type { LoopProjection } from "lowering_host"
import type { Facts as OwnershipFacts } from "../../../state/ownership/model"
import type { Output as RenewalPlan } from "../../deferred/model"
import type { Mode } from "../../fields/projection/model"
import type { Assignment as AssignmentKind, Output as StepPlan } from "../../step/model"
import type { GuardInfo, Input } from "./model"
import type { Update } from "./update_model"

export type Emit =
    Input.Pick(
        "frame",
        "writer",
        "body_seq",
        "loop_seq",
        "projected_seq",
        "skipped_seq",
        "wrap_seq",
        "consumer",
        "discard",
        "body",
        "initial_plan",
        "type_id",
        "assignment_facts",
        "ownership_facts",
        "renewal_source",
        "growth_facts",
        "state_active"
    ) & {
        guard_info?: GuardInfo,
        schedule: StepPlan,
        renewals: RenewalPlan,
        projected: bool,
        fields?: LoopProjection,
        name: u8[],
        seed: u32,
        state: u32,
        initial_value: u32,
        update: Update
    }

export type Growth = Emit.Pick(
    "frame",
    "writer",
    "type_id",
    "renewals",
    "schedule",
    "renewal_source",
    "growth_facts",
    "projected",
    "seed",
    "state"
)

export type Assignment = Emit.Pick(
    "frame",
    "writer",
    "loop_seq",
    "body",
    "schedule",
    "update",
    "state",
    "type_id",
    "assignment_facts",
    "ownership_facts",
    "fields",
    "state_active"
)

export type AssignmentValue =
    Assignment.Pick(
        "frame",
        "writer",
        "loop_seq",
        "body",
        "type_id",
        "ownership_facts",
        "fields"
    ) & {
        assignment: AssignmentKind,
        value: u32
    }

export type FieldValue =
    Emit.Pick("frame", "writer", "type_id") & {
        sequence: AstSequence,
        facts: OwnershipFacts,
        fields: LoopProjection,
        value: u32,
        origin?: u32
    }

export type Projection =
    FieldValue.Pick("frame", "writer", "type_id", "fields", "value") & {
        facts: OwnershipFacts.Pick("types", "selected"),
        layout: u32,
        mode: Mode,
        fields_update: {
            values: u32[],
            changed: u32[],
            replacements: u32[]
        }
    }

export type Assigned = {
    prefix: u64,
    count: u32
}

export type Recovery =
    Emit.Pick(
        "frame",
        "writer",
        "state",
        "type_id",
        "projected_seq",
        "assignment_facts",
        "fields"
    ) & {
        restore: bool
    }

export type Spans = {
    renewals: u64,
    declarations: u64,
    frame: u64
}

export type Finish =
    Emit.Omit(
        "schedule",
        "renewals",
        "loop_seq",
        "body",
        "assignment_facts",
        "ownership_facts",
        "renewal_source",
        "growth_facts",
        "fields",
        "name",
        "seed",
        "state_active"
    ) & {
        changed_name?: u8[],
        seed: u32,
        spans: Spans
    }
