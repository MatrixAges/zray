import integers from "std:integer"

import unpackSpan from "../../../tasks/worker/execute/reference"

import type { Input as Frame } from "../../frame/model"

export type Input = Frame.Omit(
    "prefix_start",
    "prefix_count",
    "body_start",
    "body_count"
) & {
    prefix: u64,
    body: u64
}

export type Output = Frame

export default function (in: Input): Output {
    const prefix = unpackSpan(in.prefix)
    const body = unpackSpan(in.body)

    return {
        ...in.omit([
            "prefix",
            "body"
        ]),
        prefix_start: prefix.start,
        prefix_count: integers.widen(prefix.count),
        body_start: body.start,
        body_count: integers.widen(body.count)
    }
}
