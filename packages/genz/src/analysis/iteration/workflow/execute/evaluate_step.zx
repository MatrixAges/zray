import host from "lowering_host"
import { LoopUpdateScope } from "lowering_host"

import { Assignment } from "../../step/model"
import firstCondition from "./first_condition"

import type { Evaluation as Input, Update } from "./update_model"

export type Output = Update.Omit("mark")

export default function (in: Input): Output {
    const { frame, loop_frame, schedule, renewals } = in

    const first = firstCondition(in)

    const scope = match {
        schedule.assignment == Assignment.Projected => LoopUpdateScope.Projected,
        _ => LoopUpdateScope.Ordinary
    }

    host.enterLoopUpdate(loop_frame, scope, renewals.delayed)

    const condition = host.lowerExpression(frame, schedule.condition, false, null)

    const value = match {
        schedule.by_value => host.lowerValueExpression(frame, schedule.step),
        _ => host.lowerExpression(frame, schedule.step, false, null)
    }

    host.closeLoopUpdate(loop_frame, scope)

    return {
        condition,
        value,
        first
    }
}
