<Module>
    <Type from="emission_model" as="Loop" />
    <Type from="../../step/model" as="Step" />

    <Args in={Loop.Assignment} out={Loop.Assigned} />

    <Call
        module="assignment_value"
        in={{
            ...$in.pick([
                "loop_frame",
                "writer",
                "loop_seq",
                "body"
            ]),
            assignment: $in.schedule.assignment,
            value: $in.update.value
        }}
    />

    <Call
        fn="index.finishAstSequence"
        in={[
            $in.writer,
            $in.loop_seq
        ]}
    />

    <Call fn="index.readAstOrigin" in={$in.writer} />

    <Call
        module="../../assignment/build"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            facts: $in.assignment_facts,
            active: $in.schedule.assignment == Step.Assignment.State &&
                $in.state_active,
            type_id: $in.type_id,
            target: $in.state,
            value: $ctx.assignment_value,
            mark: $in.update.mark,
            base: $ctx.readAstOrigin.expression_base,
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Return
        value={{
            prefix: $ctx.finishAstSequence,
            count: $ctx.build
        }}
    />
</Module>
