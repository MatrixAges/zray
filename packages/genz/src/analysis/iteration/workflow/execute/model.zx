import type { AstSequence, AstWriter } from "ast_rows"
import type {
    IterationResourceFrame,
    LoopConsumer,
    LoopFrame,
    Lowering
} from "lowering_host"
import type { Facts as AssignmentFacts } from "../../assignment/model"
import type { Source as RenewalSource } from "../../deferred/model"
import type { Output as InitialPlan } from "../../initial/model"
import type { Membership, View } from "../../parameters/model"

export enum Admission {
    Proceed,
    Dereference,
    Reject
}

export type LoopState = {
    name: u8[],
    reference: u32,
    forwarded?: u32
}

export type GuardInfo = {
    body: u64,
    condition: u32,
    fallback: u32
}

export type Input = {
    admission: Admission,
    frame: Lowering,
    writer: AstWriter,
    body_seq: AstSequence,
    loop_seq: AstSequence,
    projected_seq: AstSequence,
    skipped_seq: AstSequence,
    wrap_seq: AstSequence,
    consumer?: LoopConsumer,
    loop_frame: LoopFrame,
    context: IterationResourceFrame,
    assignment_facts: AssignmentFacts,
    state_active: bool,
    loop_state: LoopState,
    guard_info: GuardInfo,
    id: u32,
    type_id: u32,
    initial: u32,
    parameters: View,
    initial_plan: InitialPlan,
    condition: u32,
    body: u32,
    postcondition: bool,
    discard: bool,
    renewal_source?: RenewalSource
}

export type InitialValue = {
    name: u8[],
    value: u32
}

export type Parameters =
    Input.Pick(
        "frame",
        "writer",
        "loop_frame",
        "parameters",
        "initial_plan"
    ) & {
        name: u8[],
        membership: Membership
    }

export type ParametersOutcome = {
    seed_name: u8[],
    projected: bool
}

export type Output = {
    expression?: u32
}
