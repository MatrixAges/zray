import type { LoopAdmission, LoopFrame, LoopOperands, Lowering } from "lowering_host"
import type { View } from "../../parameters/model"

export type Admission = LoopAdmission

export type Frame = LoopFrame

export type Input = {
    frame: Lowering,
    loop_frame: LoopFrame,
    id: u32,
    initial: u32,
    parameters: View,
    operands: LoopOperands
}

export type Parameters = Input.Pick("loop_frame", "parameters")

export type Output = u32?
