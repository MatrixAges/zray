import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { LoopAdmission, LoopFrame, Lowering } from "lowering_host"
import type {
    Output as RenewalPlan,
    Source as RenewalSource
} from "../../deferred/model"
import type { Output as InitialPlan } from "../../initial/model"
import type { View } from "../../parameters/model"
import type { Output as StepPlan } from "../../step/model"

export type Admission = LoopAdmission

export type LoopState = {
    name: u8[],
    forwarded?: u32
}

export type GuardInfo = {
    body: u64,
    condition: u32,
    fallback: u32
}

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body_seq: AstSequence,
    loop_frame: LoopFrame,
    loop_state: LoopState,
    guard_info: GuardInfo,
    id: u32,
    initial: u32,
    parameters: View,
    initial_plan: InitialPlan,
    condition: u32,
    body: u32,
    postcondition: bool,
    discard: bool,
    renewal_source?: RenewalSource
}

export type InitialOutcome = {
    admission: Admission,
    name: u8[],
    initial_value: u32
}

export type Parameters =
    Input.Pick(
        "frame",
        "writer",
        "origin",
        "loop_frame",
        "parameters",
        "initial_plan"
    ) & {
        name: u8[]
    }

export type ParametersOutcome = {
    seed_name: u8[],
    projected: bool
}

export type StorageInput = Input.Pick("loop_frame", "writer", "initial_plan") & {
    initial_value: u32
}

export type Update = {
    condition: u32,
    value: u32,
    first?: u32
}

export type Renewals = Input.Pick("loop_frame", "renewal_source") & {
    owner: u32,
    schedule: StepPlan
}

export type Evaluate =
    Input.Pick("frame", "loop_frame", "parameters", "initial_plan") & {
        schedule: StepPlan,
        renewals: RenewalPlan,
        name: u8[],
        seed_name: u8[],
        initial_state: u32
    }

export type Emit =
    Input.Pick(
        "frame",
        "writer",
        "origin",
        "body_seq",
        "loop_frame",
        "guard_info",
        "initial_plan"
    ) & {
        schedule: StepPlan,
        renewals: RenewalPlan,
        projected: bool,
        initial_value: u32,
        update: Update
    }

export type Finish = Emit.Omit("schedule", "renewals")

export type Output = {
    expression?: u32
}
