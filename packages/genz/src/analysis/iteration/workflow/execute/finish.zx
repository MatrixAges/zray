import host from "lowering_host"

import finishBlock from "../../../aggregate/execute/finish_block"
import { Guard } from "../../initial/model"

import type { Finish as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const {
        frame,
        writer,
        origin,
        body_seq,
        loop_frame,
        initial_plan,
        projected,
        initial_value,
        update
    } = in

    const result = host.completeLoopResult(loop_frame, initial_value)

    if (projected) {
        const first = update.first

        if (first != null) {
            return host.finishSkippedLoop(loop_frame, initial_value, result, first)
        }

        return finishBlock({
            frame,
            writer,
            origin,
            sequence: body_seq,
            value: result
        })
    }

    const guarded = initial_plan.guard != Guard.None

    return guarded ? host.finishGuardedLoop(loop_frame, result) : result
}
