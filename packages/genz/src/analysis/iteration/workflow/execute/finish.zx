import { tailAstPackedStatements } from "ast_rows"
import host from "lowering_host"

import finishBlock from "../../../aggregate/execute/finish_block"
import finishStored from "../../../aggregate/execute/finish_stored"
import { Guard } from "../../initial/model"

import type { Finish as Input } from "./emission_model"

export type Output = u32

export default function (in: Input): Output {
    const {
        frame,
        writer,
        body_seq,
        loop_frame,
        guard_info,
        initial_plan,
        projected,
        initial_value,
        changed_name,
        update
    } = in

    const result = host.completeLoopResult(
        loop_frame,
        initial_value,
        in.state,
        in.spans,
        changed_name
    )

    if (projected) {
        const first = update.first

        if (first != null) {
            return host.finishSkippedLoop(
                loop_frame,
                initial_value,
                result,
                first,
                changed_name
            )
        }

        return finishBlock({
            frame,
            writer,
            sequence: body_seq,
            value: result
        })
    }

    if (initial_plan.guard == Guard.None) {
        return result
    }

    const span = tailAstPackedStatements(writer, [guard_info.body])

    return finishStored({
        frame,
        writer,
        span,
        value: result,
        guard: {
            condition: guard_info.condition,
            yes: result,
            no: guard_info.fallback
        }
    })
}
