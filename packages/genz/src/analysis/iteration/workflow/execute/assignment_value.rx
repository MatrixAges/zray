<Module>
    <Type from="emission_model" as="Loop" />
    <Type from="../../step/model" as="Step" />

    <Args in={Loop.AssignmentValue} out={u32} />

    <If on={$in.assignment == Step.Assignment.Projected && $in.fields != null}>
        <Call
            module="bind_field_value"
            in={{
                ...$in.pick([
                    "frame",
                    "writer",
                    "type_id",
                    "value"
                ]),
                fields: $in.fields,
                sequence: $in.loop_seq,
                facts: $in.ownership_facts,
                origin: $in.body
            }}
        />

        <Return value={$ctx.bind_field_value} />
    </If>

    <If on={$in.assignment == Step.Assignment.State}>
        <Call
            fn="index.clipCollectionTarget"
            in={[
                $in.writer,
                $in.loop_seq,
                $in.body,
                $in.value
            ]}
        />

        <Return value={$ctx.clipCollectionTarget} />
    </If>

    <Return value={$in.value} />
</Module>
