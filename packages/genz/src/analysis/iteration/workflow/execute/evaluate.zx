import host from "lowering_host"
import { LoopParameterLayout, LoopUpdateScope } from "lowering_host"

import { Assignment } from "../../step/model"
import firstCondition from "./first_condition"
import parameterLayout from "./parameter_layout"

import type { Evaluate as Input, Update as Output } from "./model"

export default function (in: Input): Output {
    const { frame, loop_frame, initial_plan, schedule, renewals, initial_state } = in

    const projected = schedule.assignment == Assignment.Projected

    if (projected) {
        const mutable = renewals.first != renewals.end

        host.declareLoopState(
            loop_frame,
            LoopParameterLayout.State,
            true,
            mutable,
            initial_state
        )
    }

    const first = firstCondition(in)

    const scope = match {
        projected => LoopUpdateScope.Projected,
        _ => LoopUpdateScope.Ordinary
    }

    host.enterLoopUpdate(loop_frame, scope, renewals.delayed)

    const condition = host.lowerExpression(frame, schedule.condition, false, null)

    const value = match {
        schedule.by_value => host.lowerValueExpression(frame, schedule.step),
        _ => host.lowerExpression(frame, schedule.step, false, null)
    }

    host.closeLoopUpdate(loop_frame, scope)

    if (!projected) {
        host.declareLoopState(
            loop_frame,
            parameterLayout(initial_plan.parameters),
            false,
            true,
            initial_state
        )
    }

    const update: Output = {
        condition,
        value,
        first
    }

    return update
}
