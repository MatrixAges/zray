import host from "lowering_host"
import { LoopParameterLayout } from "lowering_host"

import closeUpdate from "./close_update"
import firstCondition from "./first_condition"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { frame, loop_frame } = in

    const projected = host.loopProjects(loop_frame)

    if (projected) {
        host.declareLoopState(loop_frame, LoopParameterLayout.State, true)
    }

    const first = firstCondition(in)
    const operands = host.enterLoopUpdate(loop_frame, projected)
    const condition = host.lowerExpression(frame, operands.condition, false, null)

    const value = match {
        operands.by_value => host.lowerValueExpression(frame, operands.body),
        _ => host.lowerExpression(frame, operands.body, false, null)
    }

    closeUpdate(loop_frame)
    host.saveLoopUpdate(loop_frame, condition, value, first)

    if (!projected) {
        const layout = host.loopParameterLayout(loop_frame)

        host.declareLoopState(loop_frame, layout, false)
    }
}
