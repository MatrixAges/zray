import host from "lowering_host"

import { Assignment } from "../../step/model"

import type { LoopFrame } from "lowering_host"

export type Input = {
    loop_frame: LoopFrame,
    assignment: Assignment,
    value: u32
}

export type Output = void

export default function (in: Input): Output {
    const { loop_frame, assignment, value } = in

    const assigned = match assignment {
        Assignment.Projected => host.projectLoopAssignment(loop_frame, value),
        Assignment.State => host.clipLoopAssignment(loop_frame, value),
        _ => value
    }

    host.commitLoopUpdate(loop_frame, assigned, assignment == Assignment.State)
}
