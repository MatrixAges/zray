<Module>
    <Type from="model" as="Loop" />
    <Type from="index" as="Native" />

    <Args in={Loop.Parameters} out={Loop.ParametersOutcome} />

    <If on={$in.initial_plan.state_scope}>
        <Call fn="index.enterLoopRepresentation" in={$in.loop_frame} />
    </If>

    <Call fn="index.createLoopSeed" in={$in.loop_frame} />

    <Call
        fn="prepare_fields"
        in={{
            loop_frame: $in.loop_frame,
            project_fields: $in.initial_plan.project_fields
        }}
    />

    <If on={$in.initial_plan.track}>
        <Call fn="index.trackLoopChange" in={$in.loop_frame} />
    </If>

    <Call fn="parameter_layout" in={$in.initial_plan.parameters} />

    <Call
        module="../../parameters/plan"
        in={{
            ...$in.parameters.pick([
                "condition",
                "step",
                "state",
                "stack"
            ]),
            layout: $ctx.parameter_layout
        }}
    />

    <Call
        fn="../../parameters/capture"
        in={{
            ...$in.parameters.omit([
                "state",
                "stack"
            ]),
            name: $in.name,
            removal: $ctx.plan.omit([
                "add_condition",
                "add_step"
            ])
        }}
    />

    <If on={$ctx.parameter_layout != Native.LoopParameterLayout.Plain}>
        <Call
            fn="index.addLoopParameterMembers"
            in={[
                $in.loop_frame,
                $ctx.plan.add_condition,
                $ctx.plan.add_step
            ]}
        />
    </If>

    <If on={$ctx.parameter_layout == Native.LoopParameterLayout.Deep}>
        <Call fn="index.openLoopParameterContext" in={$in.loop_frame} />
    </If>

    <Return
        value={{
            seed_name: $ctx.createLoopSeed,
            projected: $ctx.prepare_fields
        }}
    />
</Module>
