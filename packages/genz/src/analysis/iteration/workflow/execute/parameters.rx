<Module>
    <Type from="model" as="Loop" />

    <Args in={Loop.Parameters} out={Loop.ParametersOutcome} />

    <Store from="state" as="loop_state" />

    <If on={$in.initial_plan.state_scope}>
        <Call
            fn="set_representation"
            in={true}
            setter={[$store.loop_state.representation]}
        />
    </If>

    <Call
        fn="create_seed"
        in={$in.pick([
            "frame",
            "writer",
        ])}
    />

    <Call
        fn="set_state"
        in={{
            seed: $ctx.create_seed.expression
        }}
        setter={[$store.loop_state.state]}
    />

    <Call
        fn="prepare_fields"
        in={{
            frame: $in.frame,
            project_fields: $in.initial_plan.project_fields
        }}
    />

    <If on={$in.initial_plan.track}>
        <Call
            fn="track_change"
            in={$in.pick([
                "frame",
                "writer",
            ])}
        />

        <Call
            fn="set_state"
            in={{
                seed: $ctx.create_seed.expression,
                changed_name: $ctx.track_change
            }}
            setter={[$store.loop_state.state]}
        />
    </If>

    <Call
        module="../../parameters/plan"
        in={{
            ...$in.parameters.pick([
                "condition",
                "step"
            ]),
            ...$in.membership,
            layout: $in.initial_plan.parameters
        }}
    />

    <Call
        fn="../../parameters/capture"
        in={$in.parameters.pick([
            "names",
            "condition",
            "step"
        ])}
    />

    <Call
        fn="set_parameters"
        in={{
            name: $in.name,
            ...$ctx.capture,
            ...$ctx.plan
        }}
        setter={[$store.loop_state.parameters]}
    />

    <Return
        value={{
            seed_name: $ctx.create_seed.name,
            fields: $ctx.prepare_fields
        }}
    />
</Module>
