<Module>
    <Type from="model" as="Loop" />

    <Args in={Loop.Parameters} out={void} />

    <Call fn="close_update" in={$in.loop_frame} />
    <Call fn="index.closeLoopInitial" in={$in.loop_frame} />
    <Call fn="index.releaseLoopScratch" in={$in.loop_frame} />
    <Call fn="index.restoreLoopParameterContext" in={$in.loop_frame} />
    <Call fn="../../parameters/restore" in={$in.parameters} />
    <Call fn="index.closeLoopRepresentation" in={$in.loop_frame} />
    <Call fn="index.releaseLoopStatements" in={$in.loop_frame} />
</Module>
