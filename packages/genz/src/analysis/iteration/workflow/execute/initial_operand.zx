import host from "lowering_host"

import { Evaluation } from "../../initial/model"

import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    initial: u32,
    evaluation: Evaluation
}

export type Output = u32

export default function (in: Input): Output {
    return match in.evaluation {
        Evaluation.Value => host.lowerValueExpression(in.frame, in.initial),
        _ => host.lowerExpression(in.frame, in.initial, false, null)
    }
}
