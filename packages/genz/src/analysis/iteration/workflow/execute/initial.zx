import host from "lowering_host"

import bindOperand from "../../../aggregate/execute/bind_operand"
import { Guard } from "../../initial/model"

import type { Input as Loop } from "./model"

export type Input =
    Loop.Pick("frame", "writer", "body_seq", "loop_frame", "initial_plan") & {
        value: u32
    }

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, body_seq, loop_frame, value } = in

    const saved = match {
        in.initial_plan.local => bindOperand({
            frame,
            writer,
            sequence: body_seq,
            value
        }),
        _ => value
    }

    if (in.initial_plan.guard != Guard.None) {
        host.guardLoopInitial(loop_frame, saved)
    }

    return saved
}
