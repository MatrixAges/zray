import host from "lowering_host"
import { LoopAdmission } from "lowering_host"

import bindOperand from "../../../aggregate/execute/bind_operand"
import { Evaluation, Guard } from "../../initial/model"

import type { InitialOutcome as Outcome, Input } from "./model"

export type Output = Outcome

export default function (in: Input): Output {
    const { frame, writer, origin, body_seq, loop_frame, initial } = in

    const admission = host.beginLoweredLoop(loop_frame)

    if (admission != LoopAdmission.Proceed) {
        return {
            admission,
            name: "",
            initial_value: 0
        }
    }

    const name = host.prepareLoopInitial(loop_frame)
    const route = in.initial_plan.evaluation
    const deep = route == Evaluation.Deep

    if (deep) {
        host.setLoopInitialScope(loop_frame, true)
    }

    const value = match route {
        Evaluation.Value => host.lowerValueExpression(frame, initial),
        _ => host.lowerExpression(frame, initial, false, null)
    }

    if (deep) {
        host.setLoopInitialScope(loop_frame, false)
    }

    const saved = match {
        in.initial_plan.local => bindOperand({
            frame,
            writer,
            origin,
            sequence: body_seq,
            value
        }),
        _ => value
    }

    if (in.initial_plan.guard != Guard.None) {
        host.guardLoopInitial(loop_frame, saved)
    }

    return {
        admission,
        name,
        initial_value: saved
    }
}
