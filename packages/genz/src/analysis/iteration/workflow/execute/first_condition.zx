import host from "lowering_host"

import type { Evaluate as Input } from "./update_model"

export type Output = u32?

export default function (in: Input): Output {
    const { frame, loop_frame, name, seed_name } = in

    const first = in.schedule.first_test

    if (first == null) {
        return null
    }

    host.renameIterationParameters(loop_frame, seed_name)

    const value = host.lowerExpression(frame, first, false, null)

    host.renameIterationParameters(loop_frame, name)

    return value
}
