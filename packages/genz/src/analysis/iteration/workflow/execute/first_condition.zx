import host from "lowering_host"

import rename from "../../parameters/rename"

import type { Input } from "./model"

export type Output = u32?

export default function (in: Input): Output {
    const { frame, loop_frame, parameters } = in
    const { target, condition, step } = parameters

    const first = host.loopFirstCondition(loop_frame)

    if (first == null) {
        return null
    }

    const seed_name = host.loopSeedName(loop_frame)

    rename({
        target,
        condition,
        step,
        condition_name: seed_name,
        step_name: seed_name
    })

    const value = host.lowerExpression(frame, first, false, null)
    const name = host.loopParameterName(loop_frame)

    rename({
        target,
        condition,
        step,
        condition_name: name,
        step_name: name
    })

    return value
}
