<Module>
    <Type from="update_model" as="Loop" />
    <Type from="../../step/model" as="Step" />

    <Args in={Loop.Evaluation} out={Loop.Evaluated} />

    <Store from="state" as="loop_state" />

    <Call
        module="first_condition"
        in={$in.pick([
            "frame",
            "schedule",
            "name",
            "seed_name"
        ])}
    />

    <Call
        fn="update_scope"
        in={{
            projected: $in.schedule.assignment == Step.Assignment.Projected,
            delayed: $in.renewals.delayed
        }}
        setter={[$store.loop_state.update_scope]}
    />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.frame,
            $in.schedule.condition,
            false,
            null
        ]}
    />

    <Call
        fn="evaluate_value"
        in={{
            frame: $in.frame,
            step: $in.schedule.step,
            by_value: $in.schedule.by_value
        }}
    />

    <Call
        fn="clear_update_scope"
        in={{}}
        setter={[$store.loop_state.update_scope]}
    />

    <Return
        value={{
            condition: $ctx.lowerExpression,
            value: $ctx.evaluate_value,
            first: $ctx.first_condition
        }}
    />
</Module>
