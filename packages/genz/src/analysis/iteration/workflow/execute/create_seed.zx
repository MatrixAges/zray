import { AstPayloadOwnership, appendExpressionRows, readAstOrigin } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import fresh from "../../../../ast/fresh"
import identifierRows from "../../../aggregate/binding/identifier_rows"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
}

export type Output = {
    name: u8[],
    expression: u32
}

export default function (in: Input): Output {
    const { frame, writer } = in

    const current = readAstOrigin(writer)

    const generated = fresh({
        serial: current.serial,
        prefix: "loop_seed_"
    })

    requireAllocation(true)

    const name = host.retainLoweringText(frame, generated.name)

    appendExpressionRows(
        writer,
        identifierRows(name),
        null,
        AstPayloadOwnership.Borrowed
    )

    host.finishGeneratedAst(frame, generated.serial, false)

    return {
        name,
        expression: current.expression_base
    }
}
