import { appendAstIdentifierRows, readAstOrigin } from "ast_rows"
import host from "lowering_host"
import memory from "memory"
import { requireAllocation } from "memory"

import fresh from "../../../../ast/fresh"
import identifierRows from "../../../aggregate/binding/identifier_rows"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { U32Buffer } from "memory"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    seed_slot: U32Buffer
}

export type Output = u8[]

export default function (in: Input): Output {
    const { frame, writer, origin, seed_slot } = in

    const current = readAstOrigin(writer, origin)

    const generated = fresh({
        serial: current.serial,
        prefix: "loop_seed_"
    })

    requireAllocation(true)

    const name = host.retainLoweringText(frame, generated.name)

    appendAstIdentifierRows(writer, identifierRows(name))
    host.finishGeneratedAst(frame, generated.serial, false)
    memory.writeU32(seed_slot, 0, current.expression_base)

    return name
}
