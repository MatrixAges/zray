import host from "lowering_host"

import type { LoopProjection, Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    project_fields: bool
}

export type Output = LoopProjection?

export default function (in: Input): Output {
    return in.project_fields ? host.prepareLoopFields(in.frame) : null
}
