<Module>
    <Type from="emission_model" as="Loop" />
    <Type from="../../initial/model" as="Initial" />
    <Type from="../../fields/projection/model" as="Projection" />

    <Args in={Loop.Emit} out={u32} />

    <Store from="state" as="loop_state" />

    <Call
        module="growth"
        in={$in.pick([
            "frame",
            "writer",
            "type_id",
            "renewals",
            "schedule",
            "renewal_source",
            "growth_facts",
            "projected",
            "seed",
            "state"
        ])}
    />

    <If on={$in.fields != null}>
        <Call
            module="bind_field_value"
            in={{
                ...$in.pick([
                    "frame",
                    "writer",
                    "type_id"
                ]),
                fields: $in.fields,
                sequence: $in.projected_seq,
                facts: $in.ownership_facts,
                value: $in.seed
            }}
        />

        <Call
            module="project_fields"
            in={{
                ...$in.pick([
                    "frame",
                    "writer",
                    "type_id"
                ]),
                fields: $in.fields,
                facts: $in.assignment_facts,
                value: $ctx.bind_field_value,
                layout: $in.fields.layout,
                mode: Projection.Mode.Initial,
                fields_update: {
                    values: [],
                    changed: [],
                    replacements: []
                }
            }}
        />

        <Call fn="index.astExpressionCount" in={$in.writer} />

        <Call
            module="../../state/build"
            in={{
                writer: $in.writer,
                body: $in.projected_seq,
                declaration: {
                    name: $in.name,
                    layout: $in.fields.layout,
                    initial: $ctx.project_fields,
                    mutable: true
                },
                tracking: null,
                expression_base: $ctx.astExpressionCount
            }}
        />
    </If>

    <Call
        fn="index.takeAstSequence"
        in={[
            $in.writer,
            $in.projected ? $in.projected_seq : $in.body_seq,
            false
        ]}
    />

    <Call
        module="assignment"
        in={$in.pick([
            "frame",
            "writer",
            "loop_seq",
            "body",
            "schedule",
            "update",
            "state",
            "type_id",
            "assignment_facts",
            "ownership_facts",
            "fields",
            "state_active"
        ])}
    />

    <Call fn="index.astExpressionCount" in={$in.writer} />
    <Call fn="index.astStatementCount" in={$in.writer} />

    <Call
        fn="frame_input"
        in={{
            writer: $in.writer,
            condition: $in.update.condition,
            expression_base: $ctx.astExpressionCount,
            statement_base: $ctx.astStatementCount,
            prefix: $in.projected ? 0 : $ctx.growth,
            body: $ctx.assignment,
            after_step: $in.schedule.after_step,
            guarded_initial:
                !$in.projected && $in.initial_plan.guard != Initial.Guard.None
        }}
    />

    <Call module="../../frame/build" />

    <Call
        module="recover"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "state",
                "type_id",
                "projected_seq",
                "assignment_facts",
                "fields"
            ]),
            restore: $in.schedule.restore_projected
        }}
    />

    <Call
        module="finish"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body_seq",
                "projected_seq",
                "skipped_seq",
                "wrap_seq",
                "consumer",
                "discard",
                "type_id",
                "guard_info",
                "initial_plan",
                "projected",
                "initial_value",
                "update"
            ]),
            state: $ctx.recover,
            changed_name: $store.loop_state.state.changed_name,
            seed: $store.loop_state.state.seed,
            spans: {
                renewals: $in.projected ? $ctx.growth : 0,
                declarations: $ctx.takeAstSequence,
                frame: $ctx.build
            }
        }}
    />

    <Return value={$ctx.finish} />
</Module>
