<Module>
    <Type from="model" as="Loop" />
    <Type from="../../step/model" as="Step" />

    <Args in={Loop.Emit} out={u32} />

    <If on={$in.renewals.emit}>
        <Call
            fn="index.emitLoopRenewals"
            in={[
                $in.loop_frame,
                $in.renewals.first,
                $in.renewals.end,
                $in.schedule.inline_lists
            ]}
        />
    </If>

    <If on={$in.schedule.assignment == Step.Assignment.Projected}>
        <Call fn="index.maskLoopBorrowedFields" in={$in.loop_frame} />
        <Call fn="index.declareProjectedLoopState" in={$in.loop_frame} />
    </If>

    <Call fn="index.publishLoopDeclarations" in={$in.loop_frame} />

    <Call
        fn="assignment"
        in={{
            loop_frame: $in.loop_frame,
            assignment: $in.schedule.assignment,
            value: $in.update.value
        }}
    />

    <Call
        fn="index.frameLoweredLoop"
        in={[
            $in.loop_frame,
            $in.update.condition,
            $in.schedule.after_step
        ]}
    />

    <If on={$in.schedule.restore_projected}>
        <Call fn="index.restoreLoopFields" in={$in.loop_frame} />
    </If>

    <Call
        fn="finish"
        in={$in.omit([
            "schedule",
            "renewals"
        ])}
    />

    <Return value={$ctx.finish} />
</Module>
