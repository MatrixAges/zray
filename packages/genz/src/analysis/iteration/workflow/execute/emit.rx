<Module>
    <Type from="model" as="Loop" />
    <Type from="../../step/model" as="Step" />

    <Args in={Loop.Emit} out={u32} />

    <If on={$in.renewals.emit}>
        <Call
            fn="index.emitLoopRenewals"
            in={[
                $in.loop_frame,
                $in.renewals.first,
                $in.renewals.end,
                $in.renewals.skipped,
                $in.schedule.inline_lists
            ]}
        />
    </If>

    <If on={$in.schedule.assignment == Step.Assignment.Projected}>
        <Call fn="index.maskLoopBorrowedFields" in={$in.loop_frame} />
        <Call fn="index.declareProjectedLoopState" in={$in.loop_frame} />
    </If>

    <Call fn="index.publishLoopDeclarations" in={$in.loop_frame} />

    <If on={$in.schedule.assignment == Step.Assignment.Projected}>
        <Call
            fn="index.projectLoopAssignment"
            in={[
                $in.loop_frame,
                $in.update.value
            ]}
        />

        <Call
            fn="index.commitLoopUpdate"
            in={[
                $in.loop_frame,
                $ctx.projectLoopAssignment,
                false
            ]}
        />

        <Else>
            <If on={$in.schedule.assignment == Step.Assignment.State}>
                <Call
                    fn="index.clipCollectionTarget"
                    in={[
                        $in.writer,
                        $in.loop_seq,
                        $in.body,
                        $in.update.value
                    ]}
                />

                <Call
                    fn="index.commitLoopUpdate"
                    in={[
                        $in.loop_frame,
                        $ctx.clipCollectionTarget,
                        true
                    ]}
                />

                <Else>
                    <Call
                        fn="index.commitLoopUpdate"
                        in={[
                            $in.loop_frame,
                            $in.update.value,
                            false
                        ]}
                    />
                </Else>
            </If>
        </Else>
    </If>

    <Call
        fn="index.frameLoweredLoop"
        in={[
            $in.loop_frame,
            $in.update.condition,
            $in.schedule.after_step
        ]}
    />

    <If on={$in.schedule.restore_projected}>
        <Call fn="index.restoreLoopFields" in={$in.loop_frame} />
    </If>

    <Call
        fn="finish"
        in={$in.omit([
            "schedule",
            "renewals",
            "loop_seq",
            "body"
        ])}
    />

    <Return value={$ctx.finish} />
</Module>
