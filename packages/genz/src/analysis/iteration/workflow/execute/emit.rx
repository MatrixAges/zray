<Module>
    <Type from="emission_model" as="Loop" />
    <Type from="../../initial/model" as="Initial" />

    <Args in={Loop.Emit} out={u32} />

    <Store from="state" as="loop_state" />

    <Call
        module="growth"
        in={$in.pick([
            "loop_frame",
            "renewals",
            "schedule"
        ])}
    />

    <If on={$in.projected}>
        <Call fn="index.maskLoopBorrowedFields" in={$in.loop_frame} />
        <Call fn="index.declareProjectedLoopState" in={$in.loop_frame} />
    </If>

    <Call
        fn="index.takeAstSequence"
        in={[
            $in.writer,
            $in.projected ? $in.projected_seq : $in.body_seq,
            false
        ]}
    />

    <Call
        module="assignment"
        in={$in.pick([
            "frame",
            "writer",
            "loop_frame",
            "loop_seq",
            "body",
            "schedule",
            "update",
            "state",
            "type_id",
            "assignment_facts",
            "state_active"
        ])}
    />

    <Call fn="index.astExpressionCount" in={$in.writer} />
    <Call fn="index.astStatementCount" in={$in.writer} />

    <Call
        fn="frame_input"
        in={{
            writer: $in.writer,
            condition: $in.update.condition,
            expression_base: $ctx.astExpressionCount,
            statement_base: $ctx.astStatementCount,
            prefix: $in.projected ? 0 : $ctx.growth,
            body: $ctx.assignment,
            after_step: $in.schedule.after_step,
            guarded_initial:
                !$in.projected && $in.initial_plan.guard != Initial.Guard.None
        }}
    />

    <Call module="../../frame/build" />

    <Call
        module="recover"
        in={{
            loop_frame: $in.loop_frame,
            state: $in.state,
            restore: $in.schedule.restore_projected
        }}
    />

    <Call
        fn="finish"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body_seq",
                "loop_frame",
                "guard_info",
                "initial_plan",
                "projected",
                "initial_value",
                "update"
            ]),
            state: $ctx.recover,
            changed_name: $store.loop_state.state.changed_name,
            spans: {
                renewals: $in.projected ? $ctx.growth : 0,
                declarations: $ctx.takeAstSequence,
                frame: $ctx.build
            }
        }}
    />

    <Return value={$ctx.finish} />
</Module>
