<Module>
    <Type from="model" as="Loop" />

    <Args in={Loop.Input} out={Loop.Output} />

    <Call fn="initial" in={$in} />

    <If on={$ctx.initial == Loop.Admission.Reject}>
        <Return
            value={{
                expression: null
            }}
        />
    </If>

    <If on={$ctx.initial == Loop.Admission.Dereference}>
        <Call fn="dereference" in={$in} />

        <Return
            value={{
                expression: $ctx.dereference
            }}
        />
    </If>

    <Call
        module="parameters"
        in={$in.pick([
            "loop_frame",
            "parameters"
        ])}
    />

    <Call fn="storage" in={$in.loop_frame} />
    <Call fn="index.loopForwardedCall" in={$in.loop_frame} />
    <Call fn="index.loopProjects" in={$in.loop_frame} />

    <Call
        module="../../step/plan"
        in={{
            ...$in.pick([
                "condition",
                "body",
                "postcondition",
                "discard"
            ]),
            ...$in.initial_plan.pick([
                "selected_state",
                "layout",
                "buffered"
            ]),
            forwarded: $ctx.loopForwardedCall,
            projected: $ctx.loopProjects
        }}
    />

    <Call
        module="renewals"
        in={{
            loop_frame: $in.loop_frame,
            renewal_source: $in.renewal_source,
            owner: $in.id,
            schedule: $ctx.plan
        }}
    />

    <Call
        fn="evaluate"
        in={{
            ...$in.pick([
                "frame",
                "loop_frame",
                "parameters"
            ]),
            schedule: $ctx.plan,
            renewals: $ctx.renewals
        }}
    />

    <Call
        module="emit"
        in={{
            loop_frame: $in.loop_frame,
            schedule: $ctx.plan,
            renewals: $ctx.renewals
        }}
    />

    <Return
        value={{
            expression: $ctx.emit
        }}
    />
</Module>
