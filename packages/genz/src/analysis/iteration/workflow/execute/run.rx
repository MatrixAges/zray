<Module>
    <Type from="model" as="Loop" />

    <Args in={Loop.Input} out={Loop.Output} />

    <Call fn="initial" in={$in} />

    <If on={$ctx.initial.admission == Loop.Admission.Reject}>
        <Return
            value={{
                expression: null
            }}
        />
    </If>

    <If on={$ctx.initial.admission == Loop.Admission.Dereference}>
        <Call fn="dereference" in={$in} />

        <Return
            value={{
                expression: $ctx.dereference
            }}
        />
    </If>

    <Call
        module="parameters"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "loop_frame",
                "parameters",
                "initial_plan"
            ]),
            name: $ctx.initial.name
        }}
    />

    <Call
        fn="storage"
        in={{
            ...$in.pick([
                "loop_frame",
                "writer",
                "initial_plan"
            ]),
            initial_value: $ctx.initial.initial_value
        }}
    />

    <Call
        module="../../step/plan"
        in={{
            ...$in.pick([
                "condition",
                "body",
                "postcondition",
                "discard"
            ]),
            ...$in.initial_plan.pick([
                "selected_state",
                "layout",
                "buffered"
            ]),
            forwarded: $in.loop_state.forwarded,
            projected: $ctx.parameters.projected
        }}
    />

    <Call
        module="renewals"
        in={{
            loop_frame: $in.loop_frame,
            renewal_source: $in.renewal_source,
            owner: $in.id,
            schedule: $ctx.plan
        }}
    />

    <Call
        fn="evaluate"
        in={{
            ...$in.pick([
                "frame",
                "loop_frame",
                "parameters",
                "initial_plan"
            ]),
            schedule: $ctx.plan,
            renewals: $ctx.renewals,
            name: $ctx.initial.name,
            seed_name: $ctx.parameters.seed_name,
            initial_state: $ctx.storage
        }}
    />

    <Call
        module="emit"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body_seq",
                "loop_frame",
                "guard_info",
                "initial_plan"
            ]),
            schedule: $ctx.plan,
            renewals: $ctx.renewals,
            projected: $ctx.parameters.projected,
            initial_value: $ctx.initial.initial_value,
            update: $ctx.evaluate
        }}
    />

    <Return
        value={{
            expression: $ctx.emit
        }}
    />
</Module>
