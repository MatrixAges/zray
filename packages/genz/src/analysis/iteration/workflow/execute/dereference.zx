import host from "lowering_host"

import emitDereference from "../../../expressions/read/emit_dereference"

import type { Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const value = host.lowerIteration(in.frame, in.id, false)

    return emitDereference({
        writer: in.writer,
        value
    })
}
