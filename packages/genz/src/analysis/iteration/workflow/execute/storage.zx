import { clipCollectionTarget, convertStateValue, StateValueMode } from "ast_rows"
import host from "lowering_host"

import emitDereference from "../../../expressions/read/emit_dereference"
import { Storage } from "../../initial/model"

import type { StorageInput as Input } from "./update_model"

export type Output = u32

export default function (in: Input): Output {
    const { loop_frame, writer, body_seq, initial_plan, initial_value } = in

    return match initial_plan.storage {
        Storage.Dereference => emitDereference({
            writer,
            value: initial_value
        }),
        Storage.Deep => host.deepenLoopInitial(loop_frame, initial_value),
        Storage.State => convertStateValue(
            writer,
            body_seq,
            in.type_id,
            initial_value,
            StateValueMode.Value,
            false
        ),
        Storage.StateValue =>
            convertStateValue(
                writer,
                body_seq,
                in.type_id,
                initial_value,
                StateValueMode.ValueLayout,
                false
            ),
        Storage.Clip =>
            clipCollectionTarget(writer, body_seq, in.initial, initial_value),
        _ => initial_value
    }
}
