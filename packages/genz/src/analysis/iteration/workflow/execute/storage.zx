import host from "lowering_host"

import { Storage } from "../../initial/model"
import emitDereference from "./emit_dereference"

import type { StorageInput as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { loop_frame, writer, initial_plan, initial_value } = in

    return match initial_plan.storage {
        Storage.Dereference => emitDereference({
            writer,
            value: initial_value
        }),
        Storage.Deep => host.deepenLoopInitial(loop_frame, initial_value),
        Storage.State => host.representLoopInitial(loop_frame, initial_value, false),
        Storage.StateValue =>
            host.representLoopInitial(loop_frame, initial_value, true),
        Storage.Clip => host.clipLoopInitial(loop_frame, initial_value),
        _ => initial_value
    }
}
