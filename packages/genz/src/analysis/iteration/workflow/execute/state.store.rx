<Store name="iteration_execute_state" version={1}>
    <Object name="state">
        <Field name="has_seed" type={bool} value={false} />
        <Field name="seed" type={u32} value={0} />
        <Field name="changed_name" type={u8[]?} value={null} />
    </Object>

    <Object name="parameters">
        <Field name="name" type={u8[]} value={[]} />
        <Field name="active" type={bool} value={false} />
        <Field name="add_condition" type={bool} value={false} />
        <Field name="add_step" type={bool} value={false} />
        <Field name="previous_condition" type={u8[]} value={[]} />
        <Field name="previous_step" type={u8[]} value={[]} />
        <Field name="remove_state_condition" type={bool} value={false} />
        <Field name="remove_state_step" type={bool} value={false} />
        <Field name="remove_stack_condition" type={bool} value={false} />
        <Field name="remove_stack_step" type={bool} value={false} />
    </Object>

    <Object name="initial_scope">
        <Field name="active" type={bool} value={false} />
    </Object>

    <Object name="representation">
        <Field name="active" type={bool} value={false} />
    </Object>

    <Object name="update_scope">
        <Field name="projected" type={bool?} value={null} />
        <Field name="delayed" type={bool} value={false} />
    </Object>

    <Object name="binding">
        <Field name="name" type={u8[]?} value={null} />
    </Object>
</Store>
