<Module>
    <Type from="model" as="Evaluation" />

    <Args in={Evaluation.Input} out={Evaluation.Output} />

    <Call fn="cached" in={$in} />

    <If on={$ctx.cached.route != Evaluation.Route.Inspect}>
        <Return value={$ctx.cached} />
    </If>

    <Call
        fn="select"
        in={{
            source: $in,
            regular: $ctx.cached.probe.value != null
        }}
    />

    <If on={$ctx.select == Evaluation.Route.Call}>
        <Call fn="callee" in={$in} />

        <Return
            value={{
                ...$ctx.cached,
                route: $ctx.select,
                value_call: $ctx.callee
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.cached,
            route: $ctx.select
        }}
    />
</Module>
