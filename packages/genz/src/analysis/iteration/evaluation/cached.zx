import read from "core/integer/map/read"

import { Route } from "./model"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    if (in.argument == in.id) {
        return {
            route: Route.Argument,
            value: null,
            probe: in.probe,
            value_call: false
        }
    }

    const local = read({
        state: in.cache,
        key: in.id
    })

    if (local != null) {
        return {
            route: Route.Cached,
            value: local,
            probe: in.probe,
            value_call: false
        }
    }

    const regular = match {
        in.probe.checked => in.probe.value,
        _ => read({
            state: in.regular,
            key: in.id
        })
    }

    return {
        route: Route.Inspect,
        value: null,
        probe: {
            checked: true,
            value: regular
        },
        value_call: false
    }
}
