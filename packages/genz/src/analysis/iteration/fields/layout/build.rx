<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="fields" />
    <Call fn="origin" />
    <Call fn="finish" />

    <Call
        fn="publish"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body"
            ]),
            built: $ctx.finish
        }}
    />

    <Return value={$ctx.publish} />
</Module>
