<Module>
    <Type from="model" as="Ownership" />

    <Args in={Ownership.Prepare} out={Ownership.Prepared?} />

    <Call
        fn="field_slots"
        in={$in.pick([
            "facts",
            "type_id",
            "borrowed",
            "origin"
        ])}
    />

    <If on={$ctx.field_slots.reads == 0}>
        <Return value={null} />
    </If>

    <Call
        fn="read"
        in={{
            source: $in,
            selection: $ctx.field_slots
        }}
    />

    <Return value={$ctx.read} />
</Module>
