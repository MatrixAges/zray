import integers from "std:integer"
import host from "lowering_host"

import type { FieldProjection } from "lowering_host"
import type { Requests } from "./model"

export type Input = {
    target: FieldProjection,
    requests: Requests,
    values: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const { target, requests, values } = in

    const empty: u32[] = []

    return loop({
        row: 0,
        replacements: empty
    }, {
        while: state => state.row < requests.fields.length,
        next: state => {
            const field = integers.widen(requests.fields[state.row])
            const value = host.projectLoopField(
                target,
                requests.types[state.row],
                values[field],
                requests.slots[state.row]
            )

            state.replacements = state.replacements.push(value)[0]
            state.row += 1
        },
        return: state => state.replacements
    })
}
