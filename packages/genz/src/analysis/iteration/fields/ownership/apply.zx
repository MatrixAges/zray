import integers from "std:integer"
import { projectLoopField } from "ast_rows"

import type { Input as Execution } from "./execute_model"

export type Input = Execution.Pick("writer", "body", "origin", "requests", "values")

export type Output = u32[]

export default function (in: Input): Output {
    const { writer, body, origin, requests, values } = in

    const empty: u32[] = []

    return loop({
        row: 0,
        replacements: empty
    }, {
        while: state => state.row < requests.fields.length,
        next: state => {
            const field = integers.widen(requests.fields[state.row])
            const value = projectLoopField(
                writer,
                body,
                origin,
                requests.types[state.row],
                values[field],
                requests.slots[state.row]
            )

            state.replacements = state.replacements.push(value)[0]
            state.row += 1
        },
        return: state => state.replacements
    })
}
