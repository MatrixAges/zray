import type { ExpressionsKind } from "../../../../printer/model/expressions"
import type { Facts } from "../../../state/ownership/model"

export type Requests = {
    fields: u32[],
    types: u32[],
    slots: u32[]
}

export type Selection = {
    reads: u64,
    requests: Requests
}

export type Prepare = {
    facts: Facts,
    type_id: u32,
    borrowed: bool[],
    origin?: u32,
    value: u32,
    expression_base: u32
}

export type Query = Prepare.Pick(
    "facts",
    "type_id",
    "borrowed",
    "origin"
)

export type Read = {
    source: Prepare,
    selection: Selection
}

export type Expressions = {
    tags: ExpressionsKind[],
    offsets: u32[],
    field_target: u32[],
    field_name: u8[][]
}

export type Prepared = {
    expressions: Expressions,
    values: u32[],
    requests: Requests,
    origin: u32,
    valid: bool
}
