import host from "lowering_host"
import { StoredType } from "lowering_host"

import type { Input as Execution, Output as Rebuilt } from "./execute_model"

export type Input = Execution.Pick("frame", "type_id", "layout") & {
    replacements: u32[]
}

export type Output = Rebuilt

export default function (in: Input): Output {
    const layout =
        in.layout ?? host.materializeType(in.frame, in.type_id, StoredType.Layout)

    return {
        layout,
        replacements: in.replacements
    }
}
