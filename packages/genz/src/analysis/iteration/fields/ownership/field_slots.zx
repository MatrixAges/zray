import integers from "std:integer"
import { max_u32 } from "core/const"

import needed from "../../../state/ownership/needed"

import type { Query as Input, Request, Selection as Output } from "./model"

export default function (in: Input): Output {
    const { facts, type_id, borrowed, origin } = in

    const mask = origin == null
    const node = origin ?? max_u32
    const first = integers.widen(facts.types.first[integers.widen(type_id)])
    const requests: Request[] = []
    const offset: u32 = 0

    const selected = loop({
        index: 0,
        offset,
        requests
    }, {
        while: state => state.index < borrowed.length,
        next: state => {
            const child = facts.types.field_types[first + state.index]
            const slot = mask ? 0 : state.offset

            const eligible = mask == borrowed[state.index]

            if (eligible && needed({
                facts,
                node,
                type_id: child,
                slot
            })) {
                state.requests = state.requests.push({
                    field: integers.narrow(state.index),
                    type_id: child,
                    slot
                })[0]
            }

            if (!mask) {
                state.offset += facts.counts[integers.widen(child)]
            }

            state.index += 1
        },
        return: state => state.requests
    })

    const reads = match {
        mask && selected.length == 0 => 0,
        _ => borrowed.length
    }

    return {
        reads,
        requests: selected
    }
}
