<Module>
    <Type from="execute_model" as="Projection" />
    <Type from="../../../statements/rows" as="AST" />

    <Args in={Projection.Input} out={Projection.Output} />

    <Call fn="publish" in={$in.expressions} />

    <Call
        fn="../../../statements/rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.publish,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="apply"
        in={$in.pick([
            "writer",
            "body",
            "origin",
            "requests",
            "values"
        ])}
    />

    <Call
        fn="rebuild"
        in={{
            ...$in.pick([
                "frame",
                "type_id",
                "layout"
            ]),
            replacements: $ctx.apply
        }}
    />

    <Return value={$ctx.rebuild} />
</Module>
