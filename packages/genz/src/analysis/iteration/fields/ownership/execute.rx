<Module>
    <Type from="execute_model" as="Projection" />

    <Args in={Projection.Input} out={u32} />

    <Call
        fn="publish"
        in={$in.pick([
            "writer",
            "expressions"
        ])}
    />

    <Call
        fn="apply"
        in={{
            target: $in.projection,
            requests: $in.requests,
            values: $in.values
        }}
    />

    <Call
        fn="rebuild"
        in={{
            ...$in.pick([
                "target",
                "frame",
                "type_id",
                "layout"
            ]),
            replacements: $ctx.apply
        }}
    />

    <Return value={$ctx.rebuild} />
</Module>
