<Module>
    <Type from="execute_model" as="Projection" />

    <Args in={Projection.Input} out={Projection.Output} />

    <Call fn="publish" in={$in.expressions} />

    <Call
        fn="../../../statements/rows.appendAstProjectionRows"
        in={[
            $in.writer,
            $ctx.publish
        ]}
    />

    <Call
        fn="apply"
        in={{
            target: $in.projection,
            requests: $in.requests,
            values: $in.values
        }}
    />

    <Call
        fn="rebuild"
        in={{
            ...$in.pick([
                "frame",
                "type_id",
                "layout"
            ]),
            replacements: $ctx.apply
        }}
    />

    <Return value={$ctx.rebuild} />
</Module>
