<Module>
    <Type from="execute_model" as="Projection" />

    <Args in={Projection.Input} out={u32} />

    <Call
        fn="publish"
        in={$in.pick([
            "writer",
            "expressions"
        ])}
    />

    <If on={$in.requests.fields.length != 0}>
        <Call
            fn="apply"
            in={{
                target: $in.projection,
                requests: $in.requests,
                values: $in.values,
                replacements: $in.replacements
            }}
        />
    </If>

    <Call fn="rebuild" in={$in} />

    <Return value={$ctx.rebuild} />
</Module>
