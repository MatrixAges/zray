import type { AstWriter } from "ast_rows"
import type { FieldProjection, Lowering } from "lowering_host"
import type { Expressions, Requests } from "./model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    projection: FieldProjection,
    expressions: Expressions,
    requests: Requests,
    values: u32[],
    type_id: u32,
    layout?: u32
}

export type Output = {
    layout: u32,
    replacements: u32[]
}
