import host from "lowering_host"

import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    types: u32[]
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < in.types.length,
        next: state => {
            const value = host.lowerType(in.frame, in.types[state.index], false)

            state.values = state.values.push(value)[0]
            state.index += 1
        },
        return: state => state.values
    })
}
