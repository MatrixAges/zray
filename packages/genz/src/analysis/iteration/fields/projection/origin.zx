import host from "lowering_host"

import append from "../../../../ast/fields/append"
import describe from "../../../construction/origin/describe"
import field from "./field"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const name = describe({
        types: in.source.types,
        id: in.source.type_id
    })

    const origin_name = match {
        name.owned => host.retainLoweringText(in.source.frame, name.name),
        _ => name.name
    }

    const value = field({
        state: in,
        target: in.source.value,
        name: origin_name
    })

    return {
        ...value.state,
        fields: append({
            table: value.state.fields,
            name: origin_name,
            value: value.id,
            default_value: null,
            comptime_parameter: false
        })
    }
}
