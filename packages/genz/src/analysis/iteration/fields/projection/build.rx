<Module>
    <Type from="model" as="Projection" />

    <Args in={Projection.Input} out={Projection.Output} />

    <If on={$in.mode == Projection.Mode.Minimum}>
        <Call
            module="minimum"
            in={$in.pick([
                "writer",
                "types",
                "type_id",
                "value",
                "capacity",
                "operation",
                "active",
                "selected"
            ])}
        />

        <Return value={$ctx.minimum} />
    </If>

    <Call fn="initialize" in={$in} />

    <Call fn="fields" />
    <Call fn="origin" />
    <Call fn="finish" />

    <Call
        fn="publish"
        in={{
            writer: $in.writer,
            result: $ctx.finish
        }}
    />

    <Return value={$ctx.publish} />
</Module>
