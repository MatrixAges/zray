import bytes from "std:bytes"

import { owner_field, items_field, owned_field } from "../types/const"

import type { Columns as Output } from "../../../ast/fields/model"

export type Input = {
    owner: u32,
    items: u32,
    owned: u32
}

export default function (in: Input): Output {
    return {
        name: [
            bytes.fromText(owner_field),
            bytes.fromText(items_field),
            bytes.fromText(owned_field)
        ],
        value: [
            in.owner,
            in.items,
            in.owned
        ],
        default_value: [
            null,
            null,
            null
        ],
        comptime_parameter: [
            false,
            false,
            false
        ]
    }
}
