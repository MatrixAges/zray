import ast from "ast_rows"
import { AstPayloadOwnership, AstSequenceMode } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import emptyVariables from "../../../ast/statements/empty_variables"

import type { PublishPrepare as Input } from "./execute_model"

export type Output = void

export default function (in: Input): Output {
    const { frame, writer, body, output } = in

    requireAllocation(output.valid)

    ast.appendExpressionRows(
        writer,
        output.expressions,
        output.forms,
        AstPayloadOwnership.BorrowingText
    )

    ast.appendStatementRows(
        writer,
        output.statements,
        null,
        AstPayloadOwnership.BorrowingText
    )

    ast.appendStatementSequence(
        writer,
        body,
        output.roots,
        emptyVariables({}),
        AstSequenceMode.Owned
    )

    host.finishGeneratedAst(frame, null, true)
}
