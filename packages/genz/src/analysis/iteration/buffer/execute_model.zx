import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Output, Prepare, Redirect, View } from "./model"

export type ExecuteView = {
    writer: AstWriter,
    view: View
}

export type ExecuteRedirect = {
    writer: AstWriter,
    redirect: Redirect
}

export type PublishObject = {
    writer: AstWriter,
    output: Output
}

export type ExecutePrepare = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    prepare: Prepare
}
