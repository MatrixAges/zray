import integers from "std:integer"
import ast from "ast_rows"
import { AstPayloadOwnership } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import emptyStatements from "../../../ast/statements/empty"
import { StatementsKind } from "../../../printer/model/statements"

import type { Assignments, Publication as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, state, mark } = in

    requireAllocation(state.valid)

    const { snapshots, assignments } = state

    const writes: Assignments = match {
        mark != null => {
            tags: assignments.tags.push(StatementsKind.Assignment)[0],
            offsets: assignments.offsets.push(
                integers.narrow(
                    assignments.assignment_target.length
                )
            )[0],
            assignment_target: assignments.assignment_target.push(mark.target)[0],
            assignment_value: assignments.assignment_value.push(mark.value)[0]
        },
        _ => assignments
    }

    const tags = match {
        snapshots.tags.length == 0 => writes.tags,
        _ => snapshots.tags.concat(writes.tags)[0]
    }

    const offsets = match {
        snapshots.offsets.length == 0 => writes.offsets,
        _ => snapshots.offsets.concat(writes.offsets)[0]
    }

    const empty_names: u8[][] = []

    const names = loop({
        items: empty_names,
        row: 0
    }, {
        while: current => current.row < state.expressions.identifier.length,
        next: current => {
            const retained = host.retainLoweringText(
                frame,
                state.expressions.identifier[current.row]
            )

            current.items = current.items.push(retained)[0]
            current.row += 1
        },
        return: current => current.items
    })

    const fields = loop({
        items: empty_names,
        row: 0
    }, {
        while: current => current.row < state.field_name_source.length,
        next: current => {
            const origin = state.field_name_source[current.row]
            const raw = state.expressions.field_name[current.row]
            const retained: u8[] = match {
                origin == null => raw,
                origin == current.row => host.retainLoweringText(frame, raw),
                _ => current.items[origin ?? current.row]
            }

            current.items = current.items.push(retained)[0]
            current.row += 1
        },
        return: current => current.items
    })

    ast.appendAstProjectionRows(writer, {
        tags: state.expressions.tags,
        offsets: state.expressions.offsets,
        identifier: names,
        field_target: state.expressions.field_target,
        field_name: fields,
        dereference: [],
        binary_operator: [],
        binary_left: [],
        binary_right: []
    })

    ast.appendStatementRows(
        writer,
        {
            ...emptyStatements({}),
            tags,
            offsets,
            constant_name: names,
            constant_type_expr: snapshots.constant_type_expr,
            constant_value: snapshots.constant_value,
            constant_exported: snapshots.constant_exported,
            assignment_target: writes.assignment_target,
            assignment_value: writes.assignment_value
        },
        null,
        AstPayloadOwnership.Borrowed
    )

    host.setLoweringSerial(frame, state.serial)

    return integers.narrow(tags.length)
}
