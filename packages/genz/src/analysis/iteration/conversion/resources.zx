import { Operation } from "./model"
import { Requirement } from "./output/model"

export enum Resource {
    None,
    IterationType,
    IterationItem,
    NativeLayout,
    NativeType,
    StateLayout,
    Invalid
}

export type Input = {
    operation: Operation,
    requirement?: Requirement
}

export type Output = {
    base: Resource,
    replacement: Resource,
    operand: Resource
}

export default function (in: Input): Output {
    const requirement = in.requirement

    if (requirement == null) {
        return {
            base: Resource.IterationType,
            replacement: Resource.None,
            operand: match in.operation {
                Operation.Buffer => Resource.IterationItem,
                _ => Resource.None
            }
        }
    }

    const operand = match requirement {
        Requirement.HeapType => Resource.NativeType,
        Requirement.ReferenceLayout => Resource.StateLayout,
        Requirement.Unsupported => Resource.Invalid,
        _ => Resource.None
    }

    return {
        base: Resource.NativeLayout,
        replacement: match requirement {
            Requirement.OptionalType => Resource.NativeType,
            _ => Resource.None
        },
        operand
    }
}
