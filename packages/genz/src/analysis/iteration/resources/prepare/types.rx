<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Types} out={Preparation.TypesOutput} />

    <Call fn="../../types/operation" in={$in.source.omit(["cached"])} />

    <If on={$ctx.operation == Preparation.TypeOperation.Native}>
        <Return value={null} />
    </If>

    <Call module="../../types/plan" in={$in.source} />

    <Call
        fn="../resolve"
        in={{
            frame: $in.frame,
            mode: Preparation.Mode.Leaves,
            root: 0,
            types: $ctx.plan.leaves,
            borrowed: [],
            operations: [],
            requirements: [],
            with_operands: false
        }}
    />

    <Return
        value={{
            plan: $ctx.plan,
            layouts: $ctx.resolve.layouts
        }}
    />
</Module>
