<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Returned} out={Preparation.ReturnedOutput} />

    <Call fn="../../conversion/operation" in={$in.source.source} />

    <If on={$ctx.operation == Preparation.ConversionOperation.Value}>
        <Return value={null} />
    </If>

    <Call module="../../conversion/output/plan" in={$in.source} />

    <Call
        fn="../resolve"
        in={{
            frame: $in.frame,
            mode: Preparation.Mode.Returned,
            root: $in.root,
            types: $ctx.plan.plan.types,
            borrowed: [],
            operations: [],
            requirements: $ctx.plan.requirements,
            with_operands: true
        }}
    />

    <Return
        value={{
            plan: $ctx.plan,
            ...$ctx.resolve
        }}
    />
</Module>
