import memory from "memory"

import type { Fill as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { buffers, types } = in

    const count = types.length

    memory.allocateU32Views(buffers.layouts, count)

    if (buffers.operands != null) {
        memory.allocateU32Views(buffers.operands, count)
    }
}
