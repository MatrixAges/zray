import type { Lowering } from "lowering_host"
import type { Input as BorrowInput, Plan as BorrowPlan } from "../../borrow/model"
import type {
    Input as ConversionInput,
    Plan as ConversionPlan
} from "../../conversion/model"
import type { Prepare, Prepared } from "../../conversion/output/model"
import type { Input as TypeInput, Plan as TypePlan } from "../../types/model"

export { Operation as BorrowOperation } from "../../borrow/model"
export { Operation as ConversionOperation } from "../../conversion/model"
export { Operation as TypeOperation } from "../../types/model"
export { Mode } from "../model"

export type Root = {
    frame: Lowering,
    root: u32
}

export type Borrow = Root & {
    source: BorrowInput
}

export type Input = Root & {
    source: ConversionInput
}

export type Returned = Root & {
    source: Prepare
}

export type Types = {
    source: TypeInput,
    frame: Lowering
}

export type BorrowPrepared = {
    plan: BorrowPlan,
    layouts: u32[]
}

export type InputPrepared = {
    plan: ConversionPlan,
    layouts: u32[],
    operands: u32[]
}

export type ReturnedPrepared = {
    plan: Prepared,
    layouts: u32[],
    operands: u32[]
}

export type TypesPrepared = {
    plan: TypePlan,
    layouts: u32[]
}

export type BorrowOutput = BorrowPrepared?

export type InputOutput = InputPrepared?

export type ReturnedOutput = ReturnedPrepared?

export type TypesOutput = TypesPrepared?
