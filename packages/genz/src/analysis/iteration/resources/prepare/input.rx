<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Input} out={Preparation.InputOutput} />

    <Call fn="../../conversion/operation" in={$in.source} />

    <If on={$ctx.operation == Preparation.ConversionOperation.Value}>
        <Return value={null} />
    </If>

    <Call module="../../conversion/plan" in={$in.source} />

    <Call
        fn="../resolve"
        in={{
            frame: $in.frame,
            mode: Preparation.Mode.Input,
            root: $in.root,
            types: $ctx.plan.types,
            borrowed: [],
            operations: $ctx.plan.kinds,
            requirements: [],
            with_operands: true
        }}
    />

    <Return
        value={{
            plan: $ctx.plan,
            ...$ctx.resolve
        }}
    />
</Module>
