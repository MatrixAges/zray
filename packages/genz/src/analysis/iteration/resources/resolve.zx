import host from "lowering_host"
import { StoredType } from "lowering_host"

import { Operation as Borrow } from "../borrow/model"
import { Operation } from "../conversion/model"
import { Requirement } from "../conversion/output/model"
import { Mode } from "./model"

import type { Input, Resolved as Output } from "./model"

export default function (in: Input): Output {
    const { frame, mode, with_operands } = in

    const empty: u32[] = []

    return loop({
        row: 0,
        layouts: empty,
        operands: empty
    }, {
        while: state => state.row < in.types.length,
        next: state => {
            const row = state.row
            const id = in.types[row]
            const base = match {
                row == 0 && mode != Mode.Leaves => in.root,
                mode == Mode.Input =>
                    host.materializeType(frame, id, StoredType.IterationType),
                mode == Mode.Leaves => host.lowerType(frame, id, false),
                _ => host.materializeType(frame, id, StoredType.Layout)
            }

            const optional = match mode {
                Mode.Borrow => in.borrowed[row] == Borrow.Optional,
                Mode.Returned => in.requirements[row] == Requirement.OptionalType,
                _ => false
            }

            const layout = match {
                optional =>
                    host.lowerType(frame, id, false),
                _ => base
            }

            state.layouts = state.layouts.push(layout)[0]

            if (with_operands) {
                const value = match mode {
                    Mode.Input => match in.operations[row] {
                        Operation.Buffer => host.materializeType(
                            frame,
                            id,
                            StoredType.IterationItem
                        ),
                        _ => 0
                    },
                    _ => match in.requirements[row] {
                        Requirement.HeapType => host.lowerType(frame, id, false),
                        Requirement.ReferenceLayout => host.materializeType(
                            frame,
                            id,
                            StoredType.StateLayout
                        ),
                        Requirement.Unsupported => host.invalidLowering(),
                        _ => 0
                    }
                }

                state.operands = state.operands.push(value)[0]
            }

            state.row += 1
        },
        return: state => ({
            layouts: state.layouts,
            operands: state.operands
        })
    })
}
