import host from "lowering_host"
import { IterationResource } from "lowering_host"

import { Operation as Borrow } from "../borrow/model"
import { Operation } from "../conversion/model"
import { Requirement } from "../conversion/output/model"
import { Mode } from "./model"

import type { Input, Resolved as Output } from "./model"

export default function (in: Input): Output {
    const { frame, mode, with_operands } = in

    const base_kind = match mode {
        Mode.Input => IterationResource.IterationType,
        Mode.Leaves => IterationResource.NativeType,
        _ => IterationResource.NativeLayout
    }

    const empty: u32[] = []

    return loop({
        row: 0,
        layouts: empty,
        operands: empty
    }, {
        while: state => state.row < in.types.length,
        next: state => {
            const row = state.row
            const id = in.types[row]
            const base = match {
                row == 0 && mode != Mode.Leaves => in.root,
                _ => host.materializeIterationResource(frame, id, base_kind)
            }

            const optional = match mode {
                Mode.Borrow => in.borrowed[row] == Borrow.Optional,
                Mode.Returned => in.requirements[row] == Requirement.OptionalType,
                _ => false
            }

            const layout = match {
                optional =>
                    host.materializeIterationResource(
                        frame,
                        id,
                        IterationResource.NativeType
                    ),
                _ => base
            }

            state.layouts = state.layouts.push(layout)[0]

            if (with_operands) {
                const kind = match mode {
                    Mode.Input => match in.operations[row] {
                        Operation.Buffer => IterationResource.IterationItem,
                        _ => IterationResource.None
                    },
                    _ => match in.requirements[row] {
                        Requirement.HeapType => IterationResource.NativeType,
                        Requirement.ReferenceLayout => IterationResource.StateLayout,
                        Requirement.Unsupported => IterationResource.Invalid,
                        _ => IterationResource.None
                    }
                }

                const value = match kind {
                    IterationResource.None => 0,
                    _ => host.materializeIterationResource(frame, id, kind)
                }

                state.operands = state.operands.push(value)[0]
            }

            state.row += 1
        },
        return: state => ({
            layouts: state.layouts,
            operands: state.operands
        })
    })
}
