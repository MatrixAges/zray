<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.CacheCursor} out={Cache.CacheCursor} />

    <Store from="cache" as="cache" />

    <Call
        fn="set_cache_entry"
        in={{
            type_id: $in.types[$in.row],
            value: $in.values[$in.row]
        }}
        setter={[$store.cache.entry]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            running: $in.row + 1 < $in.types.length
        }}
    />
</Module>
