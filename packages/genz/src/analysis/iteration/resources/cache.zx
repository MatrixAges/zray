import host from "lowering_host"

import type { Cache as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const published = loop(0, {
        while: row => row < in.types.length,
        next: row => {
            host.cacheIterationType(in.frame, in.types[row], in.values[row])

            row += 1
        }
    })
}
