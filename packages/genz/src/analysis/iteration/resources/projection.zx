import { readAstOrigin } from "ast_rows"
import host from "lowering_host"
import { StoredType } from "lowering_host"

import { Requirement } from "../projection/model"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Plan } from "../projection/model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    history_count: u64,
    plan: Plan
}

export type Output = {
    prepared: u32[],
    serials: u64[],
    history_count: u64[]
}

export default function (in: Input): Output {
    const empty_u32: u32[] = []
    const empty_u64: u64[] = []

    return loop({
        row: 0,
        prepared: empty_u32,
        serials: empty_u64,
        history_count: empty_u64
    }, {
        while: state => state.row < in.plan.operations.length,
        next: state => {
            const { frame, writer, plan } = in
            const id = plan.values[state.row]
            const value = match plan.requirements[state.row] {
                Requirement.None => 0,
                Requirement.Expression => host.lowerExpression(frame, id, false, null),
                Requirement.IterationType =>
                    host.materializeType(
                        frame,
                        id,
                        StoredType.IterationType
                    ),
                _ =>
                    host.lowerType(frame, id, false),
            }

            const origin = readAstOrigin(writer)
            const next_serial = origin.serial + plan.fresh[state.row]

            host.finishGeneratedAst(frame, next_serial, false)

            state.prepared = state.prepared.push(value)[0]
            state.serials = state.serials.push(origin.serial)[0]
            state.history_count = state.history_count.push(in.history_count)[0]
            state.row += 1
        },
        return: state => ({
            prepared: state.prepared,
            serials: state.serials,
            history_count: state.history_count
        })
    })
}
