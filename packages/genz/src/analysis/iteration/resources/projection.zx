import host from "lowering_host"
import { IterationResource } from "lowering_host"
import memory from "memory"

import { Requirement } from "../projection/model"

import type {
    IterationProjectionFrame,
    IterationResourceFrame,
    Lowering
} from "lowering_host"
import type { U32Buffer, U64Buffer } from "memory"
import type { Plan } from "../projection/model"

export type Input = {
    frame: Lowering,
    context: IterationResourceFrame,
    history: IterationProjectionFrame,
    plan: Plan,
    prepared: U32Buffer,
    serials: U64Buffer,
    history_count: U64Buffer
}

export type Output = void

export default function (in: Input): Output {
    const count = in.plan.operations.length

    memory.allocateU32Views(in.prepared, count)
    memory.allocateU64Views(in.serials, count)
    memory.allocateU64Views(in.history_count, count)

    const resolved = loop(0, {
        while: row => row < in.plan.operations.length,
        next: row => {
            const { frame, context, history, plan, prepared } = in
            const { serials, history_count } = in
            const id = plan.values[row]
            const value = match plan.requirements[row] {
                Requirement.None => 0,
                Requirement.Expression => host.lowerExpression(frame, id, false, null),
                Requirement.IterationType =>
                    host.materializeIterationResource(
                        context,
                        id,
                        IterationResource.IterationType
                    ),
                _ =>
                    host.materializeIterationResource(
                        context,
                        id,
                        IterationResource.NativeType
                    ),
            }

            memory.writeU32(prepared, row, value)
            const stamp = host.reserveIterationProjection(history, plan.fresh[row])

            memory.writeU64(serials, row, stamp.serial)
            memory.writeU64(history_count, row, stamp.history_count)

            row += 1
        }
    })
}
