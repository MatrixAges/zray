import host from "lowering_host"
import { IterationResource } from "lowering_host"

import { Requirement } from "../projection/model"

import type {
    IterationProjectionFrame,
    IterationResourceFrame,
    Lowering
} from "lowering_host"
import type { Plan } from "../projection/model"

export type Input = {
    frame: Lowering,
    context: IterationResourceFrame,
    history: IterationProjectionFrame,
    plan: Plan
}

export type Output = {
    prepared: u32[],
    serials: u64[],
    history_count: u64[]
}

export default function (in: Input): Output {
    const empty_u32: u32[] = []
    const empty_u64: u64[] = []

    return loop({
        row: 0,
        prepared: empty_u32,
        serials: empty_u64,
        history_count: empty_u64
    }, {
        while: state => state.row < in.plan.operations.length,
        next: state => {
            const { frame, context, history, plan } = in
            const id = plan.values[state.row]
            const value = match plan.requirements[state.row] {
                Requirement.None => 0,
                Requirement.Expression => host.lowerExpression(frame, id, false, null),
                Requirement.IterationType =>
                    host.materializeIterationResource(
                        context,
                        id,
                        IterationResource.IterationType
                    ),
                _ =>
                    host.materializeIterationResource(
                        context,
                        id,
                        IterationResource.NativeType
                    ),
            }

            const stamp =
                host.reserveIterationProjection(history, plan.fresh[state.row])

            state.prepared = state.prepared.push(value)[0]
            state.serials = state.serials.push(stamp.serial)[0]
            state.history_count = state.history_count.push(stamp.history_count)[0]
            state.row += 1
        },
        return: state => ({
            prepared: state.prepared,
            serials: state.serials,
            history_count: state.history_count
        })
    })
}
