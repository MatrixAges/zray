import host from "lowering_host"

import { Mode } from "./model"

import type { Rows as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { fragment, mode } = in

    const borrowed = match mode {
        Mode.Mutation => true,
        Mode.Buffer => true,
        Mode.PrepareBuffer => true,
        _ => false
    }

    host.appendFragmentExpressions(fragment, borrowed)
}
