<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Input} out={void} />

    <Call fn="index.requireAllocation" in={$in.valid} />

    <If on={$in.rows.mode == Publication.Mode.Types}>
        <Call fn="index.appendFragmentLayoutExpressions" in={$in.rows.fragment} />

        <Else>
            <Call fn="expressions" in={$in.rows} />
        </Else>
    </If>

    <Switch on={$in.rows.mode}>
        <Case value={Publication.Mode.Borrow}>
            <Call fn="fields" in={$in.rows} />

            <Call
                fn="index.appendFragmentBody"
                in={[
                    $in.rows.fragment,
                    Publication.FragmentBody.Roots
                ]}
            />
        </Case>

        <Case value={Publication.Mode.Types}>
            <Call fn="fields" in={$in.rows} />

            <Call
                fn="index.appendFragmentBody"
                in={[
                    $in.rows.fragment,
                    Publication.FragmentBody.Roots
                ]}
            />

            <If on={$in.context != null}>
                <Call
                    fn="../resources/cache"
                    in={{
                        frame: $in.context,
                        types: $in.cache_types,
                        values: $in.cache_values
                    }}
                />
            </If>
        </Case>

        <Case value={Publication.Mode.Transfer}>
            <Call fn="statements" in={$in.rows} />

            <Call
                fn="index.appendFragmentBody"
                in={[
                    $in.rows.fragment,
                    Publication.FragmentBody.RootsWithVariables
                ]}
            />

            <Call fn="index.recordIterationTransfer" in={$in.target} />
        </Case>

        <Case value={Publication.Mode.PrepareBuffer}>
            <Call fn="statements" in={$in.rows} />

            <Call
                fn="index.appendFragmentBody"
                in={[
                    $in.rows.fragment,
                    Publication.FragmentBody.Roots
                ]}
            />
        </Case>

        <Case value={Publication.Mode.Buffer}>
            <Call fn="fields" in={$in.rows} />
        </Case>

        <Default>
            <Call fn="statements" in={$in.rows} />
            <Call fn="fields" in={$in.rows} />
        </Default>
    </Switch>

    <If
        on={$in.rows.mode != Publication.Mode.Buffer &&
            $in.rows.mode != Publication.Mode.Projection}
    >
        <Call
            fn="index.finishGeneratedAst"
            in={[
                $in.lower,
                $in.serial,
                $in.uses_allocator || $in.rows.mode == Publication.Mode.Transfer ||
                    $in.rows.mode == Publication.Mode.PrepareBuffer
            ]}
        />
    </If>

    <If on={$in.rows.mode == Publication.Mode.Input}>
        <Call
            fn="index.appendFragmentBody"
            in={[
                $in.rows.fragment,
                Publication.FragmentBody.RootsWithVariables
            ]}
        />
    </If>

    <If on={$in.rows.mode == Publication.Mode.Returned}>
        <Call fn="index.appendFragmentStorage" in={$in.rows.fragment} />
    </If>
</Module>
