import host from "lowering_host"
import { LoopNameStorage } from "lowering_host"

import type { Assignment as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { target, identifiers, field_origins } = in

    const names = loop(0, {
        while: row => row < identifiers,
        next: row => {
            host.ownLoopAssignmentIdentifier(target, row)

            row += 1
        }
    })

    const fields = loop(0, {
        while: row => row < field_origins.length,
        next: row => {
            const origin = field_origins[row]

            const storage = match {
                origin == null => LoopNameStorage.Borrow,
                origin == row => LoopNameStorage.Own,
                _ => LoopNameStorage.Reuse
            }

            host.writeLoopAssignmentField(target, row, origin ?? row, storage)

            row += 1
        }
    })
}
