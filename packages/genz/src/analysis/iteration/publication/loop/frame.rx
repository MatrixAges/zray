<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Frame} out={void} />

    <If on={$in.guarded}>
        <Call fn="index.appendLoopGuard" in={$in.target} />
    </If>

    <Call fn="index.appendLoopPrefix" in={$in.target} />
    <Call fn="index.appendLoopBody" in={$in.target} />

    <If on={$in.entry}>
        <Call fn="index.appendLoopEntry" in={$in.target} />
    </If>
</Module>
