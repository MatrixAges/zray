<Module>
    <Type from="model" as="Publication" />

    <Args in={Publication.Fields} out={void} />

    <If on={$in.layout}>
        <Call fn="index.ownLoopBindingName" in={$in.target} />
    </If>

    <If on={$in.origin}>
        <Call fn="index.ownLoopOriginName" in={$in.target} />
    </If>

    <Call fn="index.appendLoopFieldExpressions" in={$in.target} />
    <Call fn="index.appendLoopFields" in={$in.target} />

    <If on={$in.layout}>
        <Call fn="index.finishLoopFieldLayout" in={$in.target} />
    </If>
</Module>
