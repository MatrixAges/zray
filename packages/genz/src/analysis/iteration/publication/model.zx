import type { FragmentPublication, IterationPublication, Lowering } from "lowering_host"

export { FragmentBody } from "lowering_host"

export enum Mode {
    Borrow,
    Types,
    Input,
    Returned,
    Projection,
    Mutation,
    Transfer,
    Buffer,
    PrepareBuffer
}

export type Input = {
    target: IterationPublication,
    lower: Lowering,
    rows: Rows,
    valid: bool,
    serial?: u64,
    uses_allocator: bool
}

export type Rows = {
    fragment: FragmentPublication,
    mode: Mode
}
