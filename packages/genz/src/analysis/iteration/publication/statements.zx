import host from "lowering_host"
import { FragmentStatements } from "lowering_host"

import { Mode } from "./model"

import type { Rows as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const mode = match in.mode {
        Mode.PrepareBuffer => FragmentStatements.BorrowingText,
        _ => FragmentStatements.Dense
    }

    host.appendFragmentStatements(in.fragment, mode)
}
