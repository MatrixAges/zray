<Module>
    <Type from="model" as="Parameters" />
    <Type from="layout" as="Layouts" />

    <Args in={Parameters.Plan} out={Parameters.Output} />

    <If on={$in.layout == Layouts.Layout.State}>
        <Call
            fn="state"
            in={$in.pick([
                "state",
                "stack"
            ])}
        />

        <Return value={$ctx.state} />
    </If>

    <If on={$in.layout == Layouts.Layout.Stack}>
        <Return
            value={{
                add_condition: $in.stack.condition,
                add_step: $in.stack.step,
                remove_state_condition: false,
                remove_state_step: false,
                remove_stack_condition: $in.stack.condition,
                remove_stack_step: $in.stack.step
            }}
        />
    </If>

    <Return
        value={{
            add_condition: $in.layout == Layouts.Layout.Deep,
            add_step:
                $in.layout == Layouts.Layout.Deep &&
                $in.condition != $in.step,
            remove_state_condition: false,
            remove_state_step: false,
            remove_stack_condition: false,
            remove_stack_step: false
        }}
    />
</Module>
