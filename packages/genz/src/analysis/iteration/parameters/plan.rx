<Module>
    <Type from="model" as="Parameters" />
    <Type from="../workflow/execute/index" as="Native" />

    <Args in={Parameters.Input} out={Parameters.Output} />

    <If on={$in.layout == Native.LoopParameterLayout.State}>
        <Call fn="state" in={$in} />

        <Return value={$ctx.state} />
    </If>

    <If on={$in.layout == Native.LoopParameterLayout.Stack}>
        <Call
            fn="missing"
            in={{
                index: $in.stack,
                condition: $in.condition,
                step: $in.step
            }}
        />

        <Return
            value={{
                add_condition: $ctx.missing.condition,
                add_step: $ctx.missing.step,
                remove_state_condition: false,
                remove_state_step: false,
                remove_stack_condition: $ctx.missing.condition,
                remove_stack_step: $ctx.missing.step
            }}
        />
    </If>

    <Return
        value={{
            add_condition: $in.layout == Native.LoopParameterLayout.Deep,
            add_step:
                $in.layout == Native.LoopParameterLayout.Deep &&
                $in.condition != $in.step,
            remove_state_condition: false,
            remove_state_step: false,
            remove_stack_condition: false,
            remove_stack_step: false
        }}
    />
</Module>
