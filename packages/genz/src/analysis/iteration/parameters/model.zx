import type { LoopParameterLayout } from "lowering_host"
import type { BoolBuffer, U32Buffer, U64Buffer, U8ListBuffer } from "memory"

export type Layout = LoopParameterLayout

export type LiveIndex = {
    count: U64Buffer,
    keys: U32Buffer,
    buckets: U32Buffer
}

export type Slots = {
    condition: u32,
    step: u32
}

export type Input = Slots & {
    layout: Layout,
    state: LiveIndex,
    stack: LiveIndex
}

export type View = Input.Omit("layout") & {
    target: U8ListBuffer,
    previous: U8ListBuffer,
    flags: BoolBuffer
}

export type Pair = Slots & {
    index: LiveIndex
}

export type Missing = {
    condition: bool,
    step: bool
}

export type Output = {
    add_condition: bool,
    add_step: bool,
    remove_state_condition: bool,
    remove_state_step: bool,
    remove_stack_condition: bool,
    remove_stack_step: bool
}

export type Names = {
    condition_name: u8[],
    step_name: u8[]
}

export type Target = Slots & {
    target: U8ListBuffer
}

export type Rename = Target & Names

export type Removal = Slots & {
    index: LiveIndex,
    remove_condition: bool,
    remove_step: bool
}

export type RemovalFlags = Output.Pick(
    "remove_state_condition",
    "remove_state_step",
    "remove_stack_condition",
    "remove_stack_step"
)
