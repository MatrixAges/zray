import type { LoopParameterLayout } from "lowering_host"
import type { U32Buffer } from "memory"

export type Layout = LoopParameterLayout

export type LiveIndex = {
    keys: U32Buffer,
    buckets: U32Buffer
}

export type Slots = {
    condition: u32,
    step: u32
}

export type Input = Slots & {
    layout: Layout,
    state: LiveIndex,
    stack: LiveIndex
}

export type View = Input.Omit("layout") & {
    names: u8[][]
}

export type Captured = {
    previous_condition: u8[],
    previous_step: u8[]
}

export type Pair = Slots & {
    index: LiveIndex
}

export type Missing = {
    condition: bool,
    step: bool
}

export type Output = {
    add_condition: bool,
    add_step: bool,
    remove_state_condition: bool,
    remove_state_step: bool,
    remove_stack_condition: bool,
    remove_stack_step: bool
}

export type RemovalFlags = Output.Pick(
    "remove_state_condition",
    "remove_state_step",
    "remove_stack_condition",
    "remove_stack_step"
)
