import type { Index } from "core/integer/index/model"
import type { StringBuffer } from "memory"

export enum Layout {
    Plain,
    Stack,
    State,
    Deep
}

export type Input = {
    layout: Layout,
    condition: u32,
    step: u32,
    state: Index,
    stack: Index
}

export type Pair = {
    index: Index,
    condition: u32,
    step: u32
}

export type Missing = {
    condition: bool,
    step: bool
}

export type Output = {
    add_condition: bool,
    add_step: bool,
    remove_state_condition: bool,
    remove_state_step: bool,
    remove_stack_condition: bool,
    remove_stack_step: bool
}

export type Slots = Input.Pick("condition", "step")

export type Names = {
    condition_name: string,
    step_name: string
}

export type Target = Slots & {
    target: StringBuffer
}

export type Change = Target & {
    name: string
}

export type Enter = Input & Change

export type Scope = Output & Names

export type Rename = Target & Names
