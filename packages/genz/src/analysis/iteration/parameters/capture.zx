import integers from "std:integer"
import memory from "memory"

import rename from "./rename"

import type { Captured, View } from "./model"

export type Input = View.Omit("state", "stack") & {
    name: u8[]
}

export type Output = Captured

export default function (in: Input): Output {
    const { target, condition, step, name } = in

    const names = memory.u8ListViews(target)
    const previous_condition = names[integers.widen(condition)]
    const previous_step = names[integers.widen(step)]

    rename({
        target,
        condition,
        step,
        condition_name: name,
        step_name: name
    })

    return {
        previous_condition,
        previous_step
    }
}
