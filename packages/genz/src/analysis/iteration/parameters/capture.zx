import integers from "std:integer"
import memory from "memory"

import {
    active_slot,
    condition_slot,
    stack_condition_slot,
    stack_step_slot,
    state_condition_slot,
    state_step_slot,
    step_slot
} from "./const"
import rename from "./rename"

import type { RemovalFlags, View } from "./model"

export type Input = View.Omit("state", "stack") & {
    name: u8[],
    removal: RemovalFlags
}

export type Output = void

export default function (in: Input): Output {
    const { target, previous, flags, condition, step, removal, name } = in

    const names = memory.u8ListViews(target)

    memory.writeU8List(previous, condition_slot, names[integers.widen(condition)])
    memory.writeU8List(previous, step_slot, names[integers.widen(step)])

    memory.writeBool(flags, state_condition_slot, removal.remove_state_condition)
    memory.writeBool(flags, state_step_slot, removal.remove_state_step)
    memory.writeBool(flags, stack_condition_slot, removal.remove_stack_condition)
    memory.writeBool(flags, stack_step_slot, removal.remove_stack_step)
    memory.writeBool(flags, active_slot, true)

    rename({
        target,
        condition,
        step,
        condition_name: name,
        step_name: name
    })
}
