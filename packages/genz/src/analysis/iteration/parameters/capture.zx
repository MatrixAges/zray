import integers from "std:integer"

import type { Captured, View } from "./model"

export type Input = View.Pick("names", "condition", "step")

export type Output = Captured

export default function (in: Input): Output {
    const { names, condition, step } = in

    return {
        previous_condition: names[integers.widen(condition)],
        previous_step: names[integers.widen(step)]
    }
}
