import lookup from "core/integer/index/lookup"
import memory from "memory"

import type { Pair as Input, Missing as Output } from "./model"

export default function (in: Input): Output {
    const keys = memory.u32Views(in.index.keys)
    const buckets = memory.u32Views(in.index.buckets)

    const condition = lookup({
        keys,
        buckets,
        key: in.condition
    }) == null

    const step = in.step != in.condition && lookup({
        keys,
        buckets,
        key: in.step
    }) == null

    return {
        condition,
        step
    }
}
