import remove from "core/integer/index/remove"
import memory from "memory"

import { count_slot } from "./const"

import type { Removal as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { index, condition, step } = in
    const { keys, buckets } = index

    const before = memory.readU64(index.count, count_slot)

    const after_condition = match {
        in.remove_condition => remove({
            count: before,
            keys,
            buckets,
            key: condition
        }),
        _ => null
    }

    const count = after_condition == null ? before : before - 1

    const after_step = match {
        in.remove_step => remove({
            count,
            keys,
            buckets,
            key: step
        }),
        _ => null
    }

    memory.writeU64(index.count, count_slot, after_step == null ? count : count - 1)
}
