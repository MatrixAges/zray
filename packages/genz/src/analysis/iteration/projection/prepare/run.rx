<Module>
    <Type from="model" as="Preparation" />

    <Args in={Preparation.Input} out={Preparation.Output} />

    <Call module="../plan" in={$in.source} />

    <If on={!$ctx.plan.valid || $ctx.plan.operations.length == 0}>
        <Return
            value={{
                plan: $ctx.plan,
                prepared: [],
                serials: [],
                history_count: []
            }}
        />
    </If>

    <Call
        fn="../../resources/projection"
        in={{
            ...$in.resources,
            plan: $ctx.plan
        }}
    />

    <Return
        value={{
            plan: $ctx.plan,
            ...$ctx.projection
        }}
    />
</Module>
