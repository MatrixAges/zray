import host from "lowering_host"
import { LayoutAction } from "lowering_host"

import type { LoopLayout } from "lowering_host"

export type Input = LoopLayout

export type Output = LayoutAction

export default function (in: Input): Output {
    return loop({
        action: host.chooseLoopLayout(in)
    }, {
        while: state => match state.action {
            LayoutAction.Dereference => false,
            LayoutAction.Reject => false,
            LayoutAction.Plain => false,
            LayoutAction.Stack => false,
            LayoutAction.State => false,
            LayoutAction.Deep => false,
            LayoutAction.Buffered => false,
            _ => true
        },
        next: state => {
            host.checkLoopLayout(in, state.action)
            state.action = host.chooseLoopLayout(in)
        },
        return: state => state.action
    })
}
