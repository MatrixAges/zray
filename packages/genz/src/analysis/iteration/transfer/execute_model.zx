import type { AstSequence, AstWriter } from "ast_rows"
import type { IterationResourceFrame, Lowering } from "lowering_host"
import type { Input, Output } from "./model"

export type Execute = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    context: IterationResourceFrame,
    request: Input
}

export type PublishAst = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    context: IterationResourceFrame,
    output: Output
}

export type Published = {
    root: u32,
    cached: u32
}
