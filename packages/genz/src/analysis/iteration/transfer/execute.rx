<Module>
    <Type from="execute_model" as="Transfer" />

    <Args in={Transfer.Execute} out={Transfer.Published} />

    <Store from="history/publication" as="history" />

    <Call module="build" in={$in.request} />

    <Call
        fn="publish_ast"
        in={{
            ...$in.pick([
                "writer",
                "body"
            ]),
            output: $ctx.build
        }}
    />

    <Call
        fn="history/publish"
        in={$ctx.build.record}
        setter={[$store.history.record]}
    />

    <Call
        fn="../../statements/rows.finishGeneratedAst"
        in={[
            $in.frame,
            $ctx.build.serial,
            true
        ]}
    />

    <Return value={$ctx.publish_ast} />
</Module>
