<Module>
    <Type from="model" as="State" />

    <Args in={State.Input} out={State.Output} />

    <Call fn="declare" in={$in.declaration} />

    <Call
        fn="../../statements/rows.appendAstBindingRows"
        in={[
            $in.writer,
            $in.body,
            $ctx.declare
        ]}
    />

    <If on={$in.tracking != null}>
        <Call
            fn="track"
            in={{
                writer: $in.writer,
                body: $in.body,
                name: $in.tracking,
                expression_base: $in.expression_base
            }}
        />

        <Return value={$ctx.track} />
    </If>

    <Return value={null} />
</Module>
