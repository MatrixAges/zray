import ast from "ast_rows"

import { StatementsKind } from "../../../printer/model/statements"
import binding from "../../binding/emit"

import type { Declare as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { declaration } = in

    const kind = match {
        declaration.mutable => StatementsKind.Variable,
        _ => StatementsKind.Constant
    }

    const rows = binding({
        kind,
        name: declaration.name,
        type_expr: declaration.layout,
        value: declaration.initial
    })

    ast.appendAstBindingRows(in.writer, in.body, rows)
}
