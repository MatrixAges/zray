import { StatementsKind } from "../../../printer/model/statements"
import binding from "../../binding/emit"

import type { BindingRows } from "ast_rows"
import type { Declaration as Input } from "./model"

export type Output = BindingRows

export default function (in: Input): Output {
    const kind = match {
        in.mutable => StatementsKind.Variable,
        _ => StatementsKind.Constant
    }

    return binding({
        kind,
        name: in.name,
        type_expr: in.layout,
        value: in.initial
    })
}
