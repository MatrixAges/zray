import type { AstSequence, AstWriter } from "ast_rows"

export type Declaration = {
    name: u8[],
    layout: u32,
    initial: u32,
    mutable: bool
}

export type Input = {
    writer: AstWriter,
    body: AstSequence,
    declaration: Declaration,
    tracking?: u8[],
    expression_base: u32
}

export type Tracking = {
    writer: AstWriter,
    body: AstSequence,
    name: u8[],
    expression_base: u32
}

export type Tracker = {
    target: u32,
    value: u32
}

export type Output = Tracker?
