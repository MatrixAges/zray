import {
    AstPayloadOwnership,
    appendAstFields,
    appendExpressionRows,
    appendStatementRows
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import type { Publication as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { lower, writer, built } = in

    requireAllocation(built.valid)

    const label = host.retainLoweringText(lower, built.expressions.block_label[0])

    appendExpressionRows(
        writer,
        {
            ...built.expressions,
            block_label: [label]
        },
        built.forms,
        AstPayloadOwnership.BorrowingText
    )

    appendStatementRows(
        writer,
        {
            ...built.statements,
            break_value_label: [label]
        },
        null,
        AstPayloadOwnership.Borrowed
    )

    appendAstFields(writer, built.fields)
    host.finishGeneratedAst(lower, built.serial, built.uses_allocator)

    return built.root
}
