import type { AstWriter } from "ast_rows"
import type { Expressions } from "core/expression_table/model"
import type { IterationResourceFrame, Lowering } from "lowering_host"
import type { Output as Built } from "../model"

export type Operands = Expressions.Pick(
    "kinds",
    "payloads",
    "types",
    "update_targets",
    "update_indices",
    "update_values",
    "collection_targets",
    "collection_kinds",
    "collection_arguments",
    "collection_first"
)

export type Input = {
    lower: Lowering,
    writer: AstWriter,
    context: IterationResourceFrame,
    expressions: Operands,
    id: u32
}

export type Publication = {
    lower: Lowering,
    writer: AstWriter,
    built: Built
}
