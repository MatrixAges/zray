<Module>
    <Type from="model" as="Mutation" />

    <Args in={Mutation.Input} out={u32} />

    <Call fn="prepare" in={$in} />

    <Call module="../build" />

    <Call
        fn="publish"
        in={{
            ...$in.pick([
                "lower",
                "writer"
            ]),
            built: $ctx.build
        }}
    />

    <Return value={$ctx.publish} />
</Module>
