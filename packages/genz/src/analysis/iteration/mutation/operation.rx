<Module>
    <Type from="model" as="Mutation" />

    <Args in={Mutation.Input} out={Mutation.State} />

    <Call fn="initialize" in={$in} />

    <Call fn="project" />

    <Switch on={$in.mode}>
        <Case value={Mutation.Mode.Update}>
            <Call fn="bounds" in={$ctx.project} />

            <Call fn="value" />
            <Call fn="prepare" />
            <Call fn="update" />

            <Return value={$ctx.update} />
        </Case>

        <Case value={Mutation.Mode.Push}>
            <Call fn="value" in={$ctx.project} />

            <Call fn="overflow" />
            <Call fn="prepare" />
            <Call fn="append" />
            <Call fn="cast" />

            <Return value={$ctx.cast} />
        </Case>

        <Case value={Mutation.Mode.Pop}>
            <Call fn="pop" in={$ctx.project} />

            <Call fn="cast" />

            <Return value={$ctx.cast} />
        </Case>
    </Switch>
</Module>
