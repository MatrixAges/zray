import type { BlockBody, Target } from "../../aggregate/binding/publication"

export type Bindings = {
    symbols: u32?[],
    values: u32?[],
    types: u32?[],
    names: u8[][]
}

export type Input = Target & {
    bindings: Bindings,
    result: u32,
    expression_base: u32,
    statement_base: u32,
    serial: u64
}

export type Rows = BlockBody
