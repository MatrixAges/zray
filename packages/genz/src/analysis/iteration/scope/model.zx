import type { IterationScopeBindings as Bindings } from "lowering_host"
import type { BlockBody, Target } from "../../aggregate/binding/publication"

export type Input = Target & {
    bindings: Bindings,
    result: u32,
    expression_base: u32,
    statement_base: u32,
    serial: u64
}

export type Rows = BlockBody
