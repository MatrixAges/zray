import type { AstLeafStatements, AstWriter } from "ast_rows"
import type { IterationScopeBindings as Bindings, Lowering } from "lowering_host"

export type Input = {
    writer: AstWriter,
    frame: Lowering,
    bindings: Bindings,
    result: u32,
    expression_base: u32,
    statement_base: u32,
    serial: u64
}

export type Rows = AstLeafStatements.Omit("break_value_label", "break_value_value")
