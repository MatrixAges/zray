import integers from "std:integer"

import { Action } from "./model"

export type Input = {
    symbol?: u32,
    used: bool[],
    names: u8[][],
    types: u32[]
}

export type Output = {
    action: Action,
    name: u8[],
    type_id?: u32
}

export default function (in: Input): Output {
    const symbol = in.symbol

    if (symbol == null) {
        return {
            action: Action.Expression,
            name: [],
            type_id: null
        }
    }

    const row = integers.widen(symbol)

    if (!in.used[row]) {
        return {
            action: Action.Discard,
            name: [],
            type_id: null
        }
    }

    return {
        action: Action.Constant,
        name: in.names[row],
        type_id: in.types[row]
    }
}
