<Module>
    <Type from="model" as="Scope" />

    <Args in={Scope.Input} out={u32} />

    <Call fn="collect" in={$in.pick(["bindings"])} />

    <Call
        fn="../../aggregate/binding/finish"
        in={{
            ...$in.pick([
                "expression_base",
                "statement_base",
                "serial"
            ]),
            value: $in.result,
            body_count: $ctx.collect.tags.length
        }}
    />

    <Call fn="rows.requireAllocation" in={$ctx.finish.valid} />

    <Call
        fn="rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.finish.name
        ]}
    />

    <Call
        fn="rows.appendAstLeafStatements"
        in={[
            $in.writer,
            {
                ...$ctx.collect,
                break_value_label: [],
                break_value_value: []
            }
        ]}
    />

    <Call
        fn="rows.appendAstLeafStatements"
        in={[
            $in.writer,
            {
                ...$ctx.finish.statements,
                expression: [],
                discard: [],
                break_value_label: [$ctx.retainLoweringText]
            }
        ]}
    />

    <Call
        fn="rows.appendAstBlockRows"
        in={[
            $in.writer,
            {
                ...$ctx.finish.expressions.omit(["identifier"]),
                block_label: [$ctx.retainLoweringText]
            }
        ]}
    />

    <Call
        fn="rows.setLoweringSerial"
        in={[
            $in.frame,
            $ctx.finish.serial
        ]}
    />

    <Return value={$ctx.finish.root} />
</Module>
