<Module>
    <Type from="model" as="Scope" />

    <Args in={Scope.Input} out={u32} />

    <Call fn="collect" in={$in.pick(["bindings"])} />

    <Call
        fn="../../aggregate/binding/plan"
        in={{
            ...$in.pick([
                "expression_base",
                "statement_base",
                "serial"
            ]),
            value: $in.result,
            body_count: $ctx.collect.tags.length
        }}
    />

    <Call fn="../../aggregate/binding/rows.requireAllocation" in={$ctx.plan.valid} />

    <Call
        fn="../../aggregate/binding/rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.plan.name
        ]}
    />

    <Call
        module="../../aggregate/binding/publish"
        in={{
            ...$in.pick([
                "writer",
                "frame"
            ]),
            plan: {
                ...$ctx.plan,
                name: $ctx.retainLoweringText
            },
            body: $ctx.collect,
            guard: null,
            uses_allocator: false
        }}
    />

    <Return value={$ctx.publish} />
</Module>
