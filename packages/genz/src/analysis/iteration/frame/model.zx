import type { AstWriter } from "ast_rows"
import type { StatementsKind } from "../../../printer/model/statements"

export type Input = {
    writer: AstWriter,
    condition: u32,
    expression_base: u32,
    statement_base: u32,
    prefix_start: u32,
    body_start: u32,
    body_count: u64,
    prefix_count: u64,
    after_step: bool,
    guarded_initial: bool
}

export type Loop = {
    condition: u32,
    start: u32,
    count: u64
}

export type Branch = {
    tags: StatementsKind[],
    offsets: u32[],
    branch_condition: u32[],
    branch_yes_start: u32[],
    branch_yes_len: u32[],
    branch_no_start: u32[],
    branch_no_len: u32[],
    branch_capture: u8[]?[],
    branch_capture_reference: bool[],
    branch_error_capture: u8[]?[]
}

export type Guard = {
    exit: Branch,
    loop: Loop
}

export type Parts = {
    guard?: Guard,
    loop: Loop,
    entry?: Branch
}

export type Publication = Parts & {
    source: Input
}

export type Output = u64
