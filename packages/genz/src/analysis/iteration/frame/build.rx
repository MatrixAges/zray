<Module>
    <Type from="model" as="Loop" />

    <Args in={Loop.Input} out={Loop.Output} />

    <If on={$in.after_step || $in.prefix_count > 0 || $in.guarded_initial}>
        <Call fn="guard" in={$in} />

        <If on={!$in.after_step && $in.prefix_count > 0}>
            <Call
                fn="entry"
                in={{
                    condition: $in.condition,
                    statement_base: $in.statement_base,
                    prefix_count: $in.prefix_count
                }}
            />

            <Call
                fn="publish"
                in={{
                    source: $in,
                    guard: $ctx.guard,
                    loop: $ctx.guard.loop,
                    entry: $ctx.entry
                }}
            />

            <Return value={$ctx.publish} />
        </If>

        <Call
            fn="publish"
            in={{
                source: $in,
                guard: $ctx.guard,
                loop: $ctx.guard.loop
            }}
        />

        <Return value={$ctx.publish} />
    </If>

    <Call
        fn="publish"
        in={{
            source: $in,
            loop: {
                condition: $in.condition,
                start: $in.body_start,
                count: $in.body_count
            }
        }}
    />

    <Return value={$ctx.publish} />
</Module>
