import integers from "std:integer"

import branch from "./branch"

import type { Guard as Output, Input } from "./model"

export default function (in: Input): Output {
    const condition = integers.narrow(integers.widen(in.expression_base) + 1)
    const stop = integers.narrow(integers.widen(in.statement_base) + 1)

    return {
        exit: branch({
            condition: in.expression_base,
            start: stop,
            count: 1
        }),
        loop: {
            condition,
            start: in.body_start,
            count: in.body_count + 1
        }
    }
}
