import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { CallArgument, CallFrame, Lowering } from "lowering_host"

export { Representation } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body: AstSequence,
    call: CallFrame,
    operand: u32,
    operand_type: u32,
    argument: CallArgument,
    adapt: bool,
    clip: bool,
    stores: bool,
    convert: bool,
    finish: bool,
    unwrap_empty: bool
}

export type Output = u32

export type Emission =
    Input.Pick(
        "frame",
        "writer",
        "origin",
        "body",
        "call",
        "stores",
        "convert",
        "finish",
        "unwrap_empty"
    ) & {
        value: u32
    }
