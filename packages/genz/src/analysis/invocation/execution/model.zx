import type { AstSequence, AstWriter, CallTarget, StateValueMode } from "ast_rows"
import type {
    CallArgument,
    Lowering
} from "lowering_host"

export { Representation } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    target: CallTarget,
    operand: u32,
    operand_type: u32,
    input_type: u32,
    output_type: u32,
    argument: CallArgument,
    adapt?: StateValueMode,
    clip: bool,
    mapping?: u32[],
    convert?: StateValueMode,
    finish: bool,
    unwrap_empty: bool
}

export type Output = u32

export type Emission =
    Input.Pick(
        "frame",
        "writer",
        "body",
        "target",
        "operand",
        "output_type",
        "mapping",
        "convert",
        "finish",
        "unwrap_empty"
    ) & {
        value: u32
    }

export type Iteration = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    call_id: u32,
    operand: u32,
    operand_type: u32,
    result_type: u32,
    value_call: bool
}
