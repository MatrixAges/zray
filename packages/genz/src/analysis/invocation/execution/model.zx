import type { AstSequence, AstWriter } from "ast_rows"
import type {
    CallArgument,
    CallFrame,
    IterationResourceFrame,
    Lowering
} from "lowering_host"

export { Representation } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    call: CallFrame,
    operand: u32,
    operand_type: u32,
    argument: CallArgument,
    adapt: bool,
    clip: bool,
    stores: bool,
    convert: bool,
    finish: bool,
    unwrap_empty: bool
}

export type Output = u32

export type Emission =
    Input.Pick(
        "frame",
        "writer",
        "body",
        "call",
        "stores",
        "convert",
        "finish",
        "unwrap_empty"
    ) & {
        value: u32
    }

export type Iteration = {
    frame: Lowering,
    context: IterationResourceFrame,
    writer: AstWriter,
    body: AstSequence,
    call_id: u32,
    operand: u32,
    operand_type: u32,
    result_type: u32,
    value_call: bool
}
