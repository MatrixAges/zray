<Module>
    <Type from="model" as="Call" />

    <Args in={Call.Iteration} out={Call.Output} />

    <Store from="argument" as="argument" />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.frame,
            $in.operand,
            false,
            null
        ]}
    />

    <Call
        fn="../../aggregate/execute/bind_operand"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            sequence: $in.body,
            value: $ctx.lowerExpression
        }}
    />

    <Call
        fn="set_argument"
        in={{
            operand: $in.operand,
            operand_type: $in.operand_type,
            value: $ctx.bind_operand
        }}
        setter={[$store.argument.binding]}
    />

    <If on={$in.value_call}>
        <Call
            fn="index.lowerCall"
            in={[
                $in.frame,
                $in.call_id,
                Call.Representation.Value,
                false
            ]}
        />

        <Call
            fn="convert"
            in={{
                ...$in.pick([
                    "frame",
                    "writer",
                    "body",
                    "result_type"
                ]),
                value: $ctx.lowerCall
            }}
        />

        <Return value={$ctx.convert} />
    </If>

    <Call
        fn="index.lowerRegular"
        in={[
            $in.frame,
            $in.call_id,
            false,
            null
        ]}
    />

    <Call
        fn="convert"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body",
                "result_type"
            ]),
            value: $ctx.lowerRegular
        }}
    />

    <Return value={$ctx.convert} />
</Module>
