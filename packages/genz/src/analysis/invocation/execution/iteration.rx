<Module>
    <Type from="model" as="Call" />

    <Args in={Call.Iteration} out={Call.Output} />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.frame,
            $in.operand,
            false,
            null
        ]}
    />

    <Call
        fn="index.openIterationCall"
        in={[
            $in.call,
            $ctx.lowerExpression
        ]}
    />

    <If on={$in.value_call}>
        <Call
            fn="index.lowerCall"
            in={[
                $in.frame,
                $in.call_id,
                Call.Representation.Value,
                false
            ]}
        />

        <Call
            fn="convert"
            in={{
                call: $in.call,
                value: $ctx.lowerCall
            }}
        />

        <Return value={$ctx.convert} />
    </If>

    <Call
        fn="index.lowerRegular"
        in={[
            $in.frame,
            $in.call_id,
            false,
            null
        ]}
    />

    <Call
        fn="convert"
        in={{
            call: $in.call,
            value: $ctx.lowerRegular
        }}
    />

    <Return value={$ctx.convert} />
</Module>
