<Module>
    <Type from="model" as="Call" />

    <Args in={Call.Input} out={Call.Output} />

    <Call fn="prepare" in={$in} />

    <Call
        fn="emit"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "origin",
                "body",
                "call",
                "stores",
                "convert",
                "finish",
                "unwrap_empty"
            ]),
            value: $ctx.prepare
        }}
    />

    <Return value={$ctx.emit} />
</Module>
