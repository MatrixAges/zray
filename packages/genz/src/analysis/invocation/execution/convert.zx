import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"
import finishBlock from "../../aggregate/execute/finish_block"

import type { Iteration } from "./model"

export type Input =
    Iteration.Pick("frame", "writer", "body", "result_type") & {
        value: u32
    }

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, body, result_type, value } = in

    const bound = bindOperand({
        frame,
        writer,
        sequence: body,
        value
    })

    return finishBlock({
        frame,
        writer,
        sequence: body,
        value: host.convertIterationCall(frame, result_type, bound)
    })
}
