import { clipCollectionTarget, convertStateValue, lowerBorrowedOperand } from "ast_rows"
import host from "lowering_host"
import { StoredType } from "lowering_host"
import { CallArgument, Representation } from "lowering_host"

import emitCast from "../../collections/workflow/emit_cast"
import bindAddress from "./bind_address"

import type { Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, body, operand } = in

    const value = match in.argument {
        CallArgument.Tuple =>
            bindAddress({
                frame,
                writer: in.writer,
                sequence: in.body,
                value: emitCast({
                    writer: in.writer,
                    layout:
                        host.materializeType(
                            frame,
                            in.operand_type,
                            StoredType.Layout
                        ),
                    value: host.lowerAggregate(
                        frame,
                        operand,
                        Representation.Value
                    )
                })
            }),
        CallArgument.Borrow => lowerBorrowedOperand(writer, body, operand),
        CallArgument.Stack =>
            bindAddress({
                frame,
                writer: in.writer,
                sequence: in.body,
                value: host.lowerAggregate(frame, operand, Representation.Value)
            }),
        _ => host.lowerExpression(frame, operand, false, null)
    }

    const adapted = match {
        in.adapt != null => convertStateValue(
            writer,
            body,
            in.input_type,
            value,
            in.adapt,
            true
        ),
        _ => value
    }

    return match {
        in.clip => clipCollectionTarget(writer, body, operand, adapted),
        _ => adapted
    }
}
