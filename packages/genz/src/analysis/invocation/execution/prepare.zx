import host from "lowering_host"
import { CallArgument, Representation } from "lowering_host"

import emitCast from "../../collections/workflow/emit_cast"
import bindAddress from "./bind_address"

import type { Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, call, operand } = in

    const value = match in.argument {
        CallArgument.Tuple =>
            bindAddress({
                frame,
                writer: in.writer,
                origin: in.origin,
                sequence: in.body,
                value: emitCast({
                    writer: in.writer,
                    layout: host.lowerLayout(frame, in.operand_type),
                    value: host.lowerAggregate(
                        frame,
                        operand,
                        Representation.Value
                    )
                })
            }),
        CallArgument.Borrow => host.lowerCallBorrow(call),
        CallArgument.Stack =>
            bindAddress({
                frame,
                writer: in.writer,
                origin: in.origin,
                sequence: in.body,
                value: host.lowerAggregate(frame, operand, Representation.Value)
            }),
        _ => host.lowerExpression(frame, operand, false, null)
    }

    const adapted = match {
        in.adapt => host.adaptCallArgument(call, value),
        _ => value
    }

    return match {
        in.clip => host.clipCallArgument(call, adapted),
        _ => adapted
    }
}
