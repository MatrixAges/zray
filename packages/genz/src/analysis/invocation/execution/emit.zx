import { convertStateValue, emitLoweredCall, finishAstSequence } from "ast_rows"
import host from "lowering_host"

import finishStored from "../../aggregate/execute/finish_stored"
import unpackSpan from "../../tasks/worker/execute/reference"

import type { Emission as Input, Output } from "./model"

export default function (in: Input): Output {
    const { frame, writer, body, target, unwrap_empty } = in

    const state: u32? = match {
        in.mapping != null => host.lowerCallStore(
            frame,
            target.function_id,
            in.operand,
            in.mapping
        ),
        _ => null
    }

    const value = emitLoweredCall(writer, body, target, in.value, state)

    const converted = match {
        in.convert != null => convertStateValue(
            writer,
            body,
            in.output_type,
            value,
            in.convert,
            target.value == null
        ),
        _ => value
    }

    if (!in.finish) {
        return converted
    }

    const span = finishAstSequence(writer, body)

    if (unwrap_empty && unpackSpan(span).count == 0) {
        return converted
    }

    return finishStored({
        frame,
        writer,
        span,
        value: converted,
        guard: null
    })
}
