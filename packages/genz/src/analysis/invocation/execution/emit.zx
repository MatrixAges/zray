import { finishAstSequence } from "ast_rows"
import host from "lowering_host"

import finishStored from "../../aggregate/execute/finish_stored"
import unpackSpan from "../../tasks/worker/execute/reference"

import type { Emission as Input, Output } from "./model"

export default function (in: Input): Output {
    const { frame, writer, origin, body, call, unwrap_empty } = in

    const state: u32? = match {
        in.stores => host.lowerCallStore(call),
        _ => null
    }

    const value = host.emitLoweredCall(call, in.value, state)

    const converted = match {
        in.convert => host.convertCallResult(call, value),
        _ => value
    }

    if (!in.finish) {
        return converted
    }

    const span = finishAstSequence(writer, body)

    if (unwrap_empty && unpackSpan(span).count == 0) {
        return converted
    }

    return finishStored({
        frame,
        writer,
        origin,
        span,
        value: converted
    })
}
