import host from "lowering_host"

import type { Emission as Input, Output } from "./model"

export default function (in: Input): Output {
    const { call } = in

    const state: u32? = match {
        in.stores => host.lowerCallStore(call),
        _ => null
    }

    const value = host.emitLoweredCall(call, in.value, state)

    const converted = match {
        in.convert => host.convertCallResult(call, value),
        _ => value
    }

    return match {
        in.finish => host.finishLoweredCall(call, converted),
        _ => converted
    }
}
