import { appendAstFieldAddresses, astExpressionCount } from "ast_rows"

import { ExpressionsKind } from "../../../printer/model/expressions"
import bindOperand from "../../aggregate/execute/bind_operand"

import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { writer } = in

    const bound = bindOperand({
        frame: in.frame,
        writer,
        sequence: in.sequence,
        value: in.value
    })

    const address = astExpressionCount(writer)

    appendAstFieldAddresses(writer, {
        tags: [ExpressionsKind.AddressOf],
        offsets: [0],
        field_target: [],
        field_name: [],
        address_of: [bound]
    })

    return address
}