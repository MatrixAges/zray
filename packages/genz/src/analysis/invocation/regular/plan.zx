import type { Plan as Output, Argument } from "./model"

export type Input = {
    argument: Argument,
    active: bool,
    represented: bool,
    io: bool,
    process: bool,
    stores: u64
}

export default function (in: Input): Output {
    return {
        argument: in.argument,
        convert_output: in.active && in.represented,
        stores: in.stores > 0,
        io: in.io,
        process: in.process
    }
}
