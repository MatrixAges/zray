import type { Argument, Input as Source, Output, Route } from "./model"

export type Input = {
    source: Source,
    route: Route,
    argument: Argument,
    represented: bool
}

export default function (in: Input): Output {
    const { argument, represented, route, source } = in

    return {
        route,
        argument,
        convert_output: source.active && represented,
        stores: source.stores > 0,
        io: source.io_functions[source.function],
        process: source.process_functions[source.function]
    }
}
