import host from "lowering_host"

import type { RegularCallArgument, RegularCallFrame } from "lowering_host"
import type { Input as Source } from "./model"

export type Input = {
    call: RegularCallFrame,
    source: Source,
    argument: RegularCallArgument,
    represented: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { argument, call, represented, source } = in

    return host.invokePlannedRegularCall(
        call,
        argument,
        source.active && represented,
        source.stores > 0,
        source.io_functions[source.function],
        source.process_functions[source.function]
    )
}
