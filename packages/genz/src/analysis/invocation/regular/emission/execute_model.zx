import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input, Output } from "./model"

export type Execute = Input & {
    frame: Lowering,
    writer: AstWriter
}

export type Publish = Execute.Pick(
    "frame",
    "writer",
    "target",
    "io",
    "process"
) & {
    output: Output
}
