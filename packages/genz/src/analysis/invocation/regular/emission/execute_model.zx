import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input, Output } from "./model"

export { readAstOrigin } from "ast_rows"

export type Execute = Input.Omit("base", "capture") & {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer
}

export type Publish = Execute.Pick(
    "frame",
    "writer",
    "target",
    "io",
    "process"
) & {
    output: Output
}
