<Module>
    <Type from="execute_model" as="Emission" />

    <Args in={Emission.Execute} out={u32} />

    <Call
        module="build"
        in={$in.omit([
            "frame",
            "writer"
        ])}
    />

    <Call
        fn="publish"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "target",
                "io",
                "process"
            ]),
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish} />
</Module>
