import bytes from "std:bytes"

import { ExpressionsKind } from "../../../../printer/model/expressions"
import { io_name, process_name } from "../../../functions/signature/const"

import type { ResourceInput as Input, Resources as Output } from "./model"

export default function (in: Input): Output {
    const io_value: u32? = in.io ? in.base : null
    const next = in.base + (in.io ? 1 : 0)
    const process_value: u32? = in.process ? next : null
    const base = next + (in.process ? 1 : 0)

    const names: u8[][] = match {
        in.io && in.process => [
            bytes.fromText(io_name),
            bytes.fromText(process_name)
        ],
        in.io => [bytes.fromText(io_name)],
        in.process => [bytes.fromText(process_name)],
        _ => []
    }

    const count = names.length

    const offsets: u32[] = match count {
        2 => [
            0,
            1
        ],
        1 => [0],
        _ => []
    }

    return {
        tags: names.map(name => ExpressionsKind.Identifier)[0],
        offsets,
        identifier: names,
        base,
        io: io_value,
        process: process_value
    }
}
