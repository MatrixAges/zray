<Module>
    <Type from="model" as="Invocation" />

    <Args in={Invocation.Input} out={Invocation.Output} />

    <Call fn="route" in={$in} />

    <If
        on={$ctx.route == Invocation.Route.Value ||
            $ctx.route == Invocation.Route.Pointer}
    >
        <Return
            value={{
                route: $ctx.route,
                argument: Invocation.Argument.Value,
                convert_output: false,
                stores: false,
                io: false,
                process: false
            }}
        />
    </If>

    <Call
        fn="argument"
        in={{
            source: $in,
            represented: $ctx.route == Invocation.Route.RegularRepresented
        }}
    />

    <Call
        fn="plan"
        in={{
            source: $in,
            route: $ctx.route,
            argument: $ctx.argument,
            represented: $ctx.route == Invocation.Route.RegularRepresented
        }}
    />

    <Return value={$ctx.plan} />
</Module>
