<Module>
    <Type from="model" as="Invocation" />

    <Args in={Invocation.Invocation} out={Invocation.Output} />

    <Call fn="route" in={$in.source} />

    <If on={$ctx.route == Invocation.Route.Value}>
        <Call fn="index.invokePlannedValueCall" in={$in.frame} />

        <Return value={$ctx.invokePlannedValueCall} />
    </If>

    <If on={$ctx.route == Invocation.Route.Pointer}>
        <Call fn="index.invokePlannedPointerCall" in={$in.frame} />

        <Return value={$ctx.invokePlannedPointerCall} />
    </If>

    <Call
        fn="argument"
        in={{
            source: $in.source,
            represented: $ctx.route == Invocation.Route.RegularRepresented
        }}
    />

    <Call
        fn="plan"
        in={{
            call: $in.frame,
            source: $in.source,
            argument: $ctx.argument,
            represented: $ctx.route == Invocation.Route.RegularRepresented
        }}
    />

    <Return value={$ctx.plan} />
</Module>
