<Module>
    <Type from="model" as="Growth" />

    <Args in={Growth.Input} out={Growth.Output} />

    <Call fn="prepare" in={$in} />

    <Call fn="header" />
    <Call fn="reserve_layout" />
    <Call fn="reserve" />
    <Call fn="bounded" />
    <Call fn="allocation_layout" />
    <Call fn="allocation_size" />
    <Call fn="allocate" />
    <Call fn="allocation_finish" />
    <Call fn="retract" />
    <Call fn="renew_layout" />
    <Call fn="renew_optional" />
    <Call fn="renew_pointer" />
    <Call fn="renew_fields" />
    <Call fn="renew_wrapped" />
    <Call fn="renew" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
