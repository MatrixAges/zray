import boolean from "../../../ast/context/boolean"
import { Storage } from "../../state/list/const"
import construct from "../../state/list/construct"
import tag from "../../state/list/tag"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const header = boolean({
        state: in.context,
        value: true
    })

    const unique = boolean({
        state: header.state,
        value: true
    })

    const storage = tag({
        state: unique.state,
        storage: Storage.Exclusive
    })

    const result = construct({
        context: storage.state,
        fields: in.fields,
        first: in.source.field_base,
        layout: in.source.layout,
        value: in.root,
        storage: storage.id
    })

    return {
        ...in,
        ...result
    }
}
