<Module>
    <Type from="model" as="Value" />
    <Type from="../model" as="Growth" />

    <Args in={Value.Input} out={Growth.Output} />

    <Call
        fn="../../uniqueness/renewals/range"
        in={{
            keys: $in.records.keys,
            owner: $in.owner,
            value: true
        }}
    />

    <Call
        module="../renew/entry/build"
        in={{
            ...$in.omit(["owner"]),
            range: $ctx.range,
            skipped: [],
            name: null,
            entry_rows: false,
            filtered_inline: false
        }}
    />

    <Return value={$ctx.build} />
</Module>
