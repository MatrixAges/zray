<Module>
    <Type from="model" as="Renew" />

    <Args in={Renew.State} out={Renew.State} />

    <Loop on={$in.running}>
        <Call
            module="next"
            in={{
                ...$in,
                applied: false,
                index: $in.source.range.first,
                skip_index: 0,
                running: $in.source.range.first < $in.source.range.end
            }}
        />
    </Loop>

    <Return
        value={{
            ...$in,
            growth: $ctx.next.growth,
            applied: $ctx.next.applied
        }}
    />
</Module>
