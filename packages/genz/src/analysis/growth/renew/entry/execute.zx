import { Operation } from "../../const"
import append from "../append.rx"
import buffered from "../buffered"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    return loop({
        growth: in.growth,
        applied: false,
        index: in.source.range.first,
        skip_index: 0
    }, {
        while: state => state.index < in.source.range.end,
        next: state => {
            const source = in.source
            const index = state.index
            const type_id = source.type_id
            const types = source.types

            const skip = state.skip_index < source.skipped.length &&
                source.skipped[state.skip_index] == index - source.range.first

            if (skip) {
                state.skip_index += 1
            } else {
                const path = source.records.paths[index]
                const filter_inline = source.inline_lists && !source.filtered_inline

                const inline = filter_inline && buffered({
                    types,
                    type_id,
                    path,
                    inline_lists: true
                })

                if (!inline) {
                    state.growth = append({
                        source: {
                            types,
                            type_id,
                            path,
                            source: {
                                ...source.source,
                                value: in.value,
                                operation: match {
                                    source.entry_rows &&
                                        source.records.keys[index] % 2 == 1 =>
                                        Operation.RenewWritable,
                                    _ => source.source.operation
                                }
                            }
                        },
                        growth: state.growth
                    })
                    state.applied = true
                }
            }

            state.index += 1
        },
        return: state => ({
            ...in,
            ...state.pick([
                "growth",
                "applied"
            ])
        })
    })
}
