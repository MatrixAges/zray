<Module>
    <Type from="model" as="Root" />

    <Args in={Root.Indexed} out={Root.Output} />

    <Call fn="initialize" in={{}} />

    <Call
        fn="indexed_modules"
        in={{
            state: $ctx.initialize,
            source: $in
        }}
    />

    <Call fn="assemble" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
