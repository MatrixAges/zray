import item from "./item"

import type { Entry, State as Output } from "./model"

export type Input = {
    state: Output,
    entries: Entry[]
}

export default function (in: Input): Output {
    return loop({
        state: in.state,
        index: 0
    }, {
        while: current => current.state.valid &&
            current.state.expressions.valid &&
            current.index < in.entries.length,
        next: current => {
            current.state = item({
                ...in.entries[current.index],
                state: current.state
            })
            current.index += 1
        },
        return: current => current.state
    })
}
