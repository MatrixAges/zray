import bytes from "std:bytes"
import integers from "std:integer"

import type { Member } from "./selection/model"

export type Input = {
    paths: string[],
    hashes: u64[],
    members: Member[]
}

export type Output = u8[]

export default function (in: Input): Output {
    const { paths, hashes, members } = in

    const parts: u8[][] = []

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < members.length,
        next: state => {
            const index = state.index
            const row = integers.widen(members[index].row)
            const path = paths[row]
            const next = index + 1

            if (
                next == members.length ||
                    paths[integers.widen(members[next].row)] != path
            ) {
                const raw = bytes.fromText(path)

                const entry = bytes.join(bytes.fromText(""), [
                    bytes.encodeU64Le(raw.length),
                    raw,
                    bytes.encodeU64Le(hashes[row])
                ])

                state.parts = state.parts.push(entry)[0]
            }

            state.index = next
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
