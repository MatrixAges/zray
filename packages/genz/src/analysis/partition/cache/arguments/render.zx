import integers from "std:integer"
import strings from "std:string"

import { index_marker } from "./const"

import type { Prepared } from "./model"

export type Input = Prepared & {
    index: u32
}

export type Output = string[]

export default function (in: Input): Output {
    const number = `${in.index}`

    return loop({
        row: 0,
        values: in.values
    }, {
        while: state => state.row < in.indexed.length,
        next: state => {
            const position = integers.widen(in.indexed[state.row])
            const argument =
                strings.replaceAll(in.values[position], index_marker, number)

            state.values[position] = argument
            state.row += 1
        },
        return: state => state.values
    })
}
