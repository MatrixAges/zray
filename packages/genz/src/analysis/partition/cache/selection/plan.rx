<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Manifest} out={Cache.Selection} />

    <Call fn="select" in={$in} />

    <Call
        fn="order"
        in={{
            paths: $in.paths,
            selected: $ctx.select.members
        }}
    />

    <Call
        fn="offsets"
        in={{
            members: $ctx.order,
            count: $in.count
        }}
    />

    <Return
        value={{
            types: $ctx.select.types,
            signatures: $ctx.select.signatures,
            members: $ctx.order,
            offsets: $ctx.offsets
        }}
    />
</Module>
