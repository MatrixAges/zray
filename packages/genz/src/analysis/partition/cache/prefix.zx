import bytes from "std:bytes"

import { domain } from "./const"

export type Input = {
    executable: string,
    size: u64,
    modified: u64,
    arguments: string[],
    types: u64,
    signatures: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    const { arguments } = in

    const tag = bytes.fromText(domain)
    const executable = bytes.fromText(in.executable)

    const parts: u8[][] = [
        bytes.encodeU64Le(tag.length),
        tag,
        bytes.encodeU64Le(executable.length),
        executable,
        bytes.encodeU64Le(in.size),
        bytes.encodeU64Le(in.modified)
    ]

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < arguments.length,
        next: state => {
            const argument = bytes.fromText(arguments[state.index])

            state.parts = state.parts.push(bytes.encodeU64Le(argument.length))[0]
            state.parts = state.parts.push(argument)[0]
            state.index += 1
        },
        return: state => state.parts
    })

    const tail = collected.push(bytes.encodeU64Le(in.types))[0]

    return bytes.join(
        bytes.fromText(""),
        tail.push(bytes.encodeU64Le(in.signatures))[0]
    )
}
