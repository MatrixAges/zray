<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Input} out={bool} />

    <Store from="state" as="state" />

    <Call
        fn="../prefix"
        in={{
            executable: $in.zig,
            size: $in.size,
            modified: $in.modified,
            arguments: $in.arguments,
            types: $in.types,
            signatures: $in.signatures
        }}
    />

    <Call fn="effects.blake3Init" />

    <Loop on={$in.row < $in.paths.length}>
        <Call
            module="external_step"
            in={{
                paths: $in.external,
                prefix: $ctx.blake3Init,
                row: 0
            }}
        />
    </Loop>

    <Loop on={$in.row + 1 < $in.files.offsets.length}>
        <Call
            module="key_step"
            in={{
                files: $in.pick([
                    "paths",
                    "hashes",
                    "members",
                    "offsets"
                ]),
                prefix: $ctx.external_step.prefix,
                digests: [],
                row: 0
            }}
        />
    </Loop>

    <Call
        fn="append_path"
        in={{
            parent: $in.objects,
            child: "state"
        }}
    />

    <Call fn="effects.readFileOptional" />

    <Call fn="effects.fromText" in={$ctx.append_path} />

    <Call
        fn="effects.mkdir"
        in={{
            path: $in.objects,
            recursive: true
        }}
    />

    <Call
        fn="../request/object_paths"
        in={{
            objects: $in.objects,
            count: $ctx.key_step.digests.length
        }}
    />

    <Loop on={$in.row < $in.paths.length}>
        <Call
            module="presence_step"
            in={{
                paths: $ctx.object_paths,
                present: [],
                row: 0
            }}
        />
    </Loop>

    <Call
        module="../state/schedule"
        in={{
            state: {
                previous: $ctx.readFileOptional ?? [],
                digests: $ctx.key_step.digests,
                present: $ctx.presence_step.present
            },
            options: $in.pick([
                "arguments",
                "generated",
                "objects"
            ])
        }}
    />

    <If on={$ctx.schedule.pending.length == 0}>
        <Return value={false} />
    </If>

    <Call
        fn="update_valid"
        in={{
            valid: $ctx.schedule.valid ?? $ctx.presence_step.present,
            completed: []
        }}
        setter={[$store.state.objects]}
    />

    <If on={$ctx.schedule.invalidate}>
        <Call
            module="publish"
            in={{
                path: $ctx.fromText,
                digests: $ctx.key_step.digests
            }}
        />
    </If>

    <Call
        fn="commands"
        in={{
            zig: $in.zig,
            pending: $ctx.schedule.pending,
            arguments: $ctx.schedule.arguments.values,
            indexed: $ctx.schedule.arguments.indexed
        }}
    />

    <Call fn="effects.spawnBatchSync" />

    <Call
        fn="../state/complete"
        in={{
            pending: $ctx.schedule.pending,
            failures: $ctx.spawnBatchSync
        }}
    />

    <Call
        fn="update_valid"
        in={{
            valid: $store.state.objects.valid,
            completed: $ctx.complete.completed
        }}
        setter={[$store.state.objects]}
    />

    <Loop on={$in.row < $in.failures.length}>
        <Call
            module="report_step"
            in={{
                pending: $ctx.schedule.pending,
                failures: $ctx.spawnBatchSync,
                row: 0
            }}
        />
    </Loop>

    <Call
        module="publish"
        in={{
            path: $ctx.fromText,
            digests: $ctx.key_step.digests
        }}
    />

    <Return value={$ctx.complete.failed} />
</Module>
