<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Diagnostics} out={Cache.Diagnostics} />

    <Call
        fn="diagnostic"
        in={{
            partition: $in.pending[$in.row],
            failure: $in.failures[$in.row]
        }}
    />

    <If on={$ctx.diagnostic != null}>
        <Call fn="effects.writeStderr" in={$ctx.diagnostic} />
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
