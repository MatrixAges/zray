<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Diagnostics} out={Cache.Diagnostics} />

    <Call fn="diagnostic" in={$in.messages[$in.row]} />

    <If on={$ctx.diagnostic != null}>
        <Call fn="host.writeStderr" in={$ctx.diagnostic} />
    </If>

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
