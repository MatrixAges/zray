import type { BatchFailure } from "std:child_process"
import type { Blake3State as State } from "std:crypto/blake3"
import type { File } from "../external_order"
import type { Member } from "../selection/model"

export { Kind } from "std:fs"

export type Files = {
    paths: string[],
    hashes: u64[],
    members: Member[],
    offsets: u64[]
}

export type Input = Files & {
    zig: string,
    generated: string,
    objects: string,
    arguments: string[],
    external: string[],
    size: u64,
    modified: u64,
    types: u64,
    signatures: u64
}

export type External = {
    paths: string[],
    prefix: State,
    row: u64
}

export type Keys = {
    files: Files,
    prefix: State,
    digests: u8[][],
    row: u64
}

export type Presence = {
    paths: string[],
    present: bool[],
    row: u64
}

export type Diagnostics = {
    pending: u32[],
    failures: BatchFailure?[],
    row: u64
}

export type Publish = {
    path: u8[],
    digests: u8[][]
}

export type FileHash = {
    prefix: State,
    path: string,
    name: string,
    size?: u64
}

export type FileSize = FileHash.Pick("path", "size")

export type DirectoryHash = {
    root: string,
    prefix: State
}

export type DirectoryScan = {
    root: string,
    directories: string[],
    files: File[],
    row: u64
}

export type DirectoryFiles = {
    root: string,
    files: File[],
    prefix: State,
    row: u64
}

export type HashState = State
