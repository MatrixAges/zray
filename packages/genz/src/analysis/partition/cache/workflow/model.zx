import type { PartitionHash } from "partition_host"
import type { Member } from "../selection/model"

export type Files = {
    paths: string[],
    hashes: u64[],
    members: Member[],
    offsets: u64[]
}

export type Input = Files & {
    prefix: PartitionHash,
    zig: string,
    generated: string,
    objects: string,
    arguments: string[],
    external: string[],
    size: u64,
    modified: u64,
    types: u64,
    signatures: u64
}

export type External = {
    paths: string[],
    prefix: PartitionHash,
    row: u64
}

export type Keys = {
    files: Files,
    prefix: PartitionHash,
    digests: u8[][],
    row: u64
}

export type Presence = {
    paths: string[],
    present: bool[],
    row: u64
}

export type Diagnostics = {
    messages: string?[],
    row: u64
}

export type Publish = {
    path: u8[],
    digests: u8[][]
}
