<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Keys} out={Cache.Keys} />

    <Call
        fn="../members"
        in={{
            paths: $in.files.paths,
            hashes: $in.files.hashes,
            members: $in.files.members,
            first: $in.files.offsets[$in.row],
            end: $in.files.offsets[$in.row + 1]
        }}
    />

    <Call
        fn="effects.blake3Update"
        in={{
            state: $in.prefix,
            data: $ctx.members
        }}
    />

    <Call fn="effects.blake3FinalHex" />

    <Call
        fn="keys"
        in={{
            keys: $in,
            digest: $ctx.blake3FinalHex
        }}
    />

    <Return value={$ctx.keys} />
</Module>
