<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Presence} out={Cache.Presence} />

    <Call fn="object_exists" in={$in.paths[$in.row]} />

    <Call
        fn="presence"
        in={{
            state: $in,
            present: $ctx.object_exists
        }}
    />

    <Return value={$ctx.presence} />
</Module>
