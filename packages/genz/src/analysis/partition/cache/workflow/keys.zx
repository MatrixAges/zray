import host from "partition_host"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const count = in.offsets.length - 1

    host.allocatePartitionKeys(in.target, count)

    const position = loop(0, {
        while: row => row < count,
        next: row => {
            host.hashPartitionMembers(
                in.target,
                row,
                in.offsets[row],
                in.offsets[row + 1]
            )
            row += 1
        }
    })
}
