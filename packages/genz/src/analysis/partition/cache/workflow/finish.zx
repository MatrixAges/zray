import host from "partition_host"

import type { PartitionResults as Input } from "partition_host"

export type Output = bool

export default function (in: Input): Output {
    const position = loop(0, {
        while: row => row < in.diagnostics.length,
        next: row => {
            const diagnostic = in.diagnostics[row]

            if (diagnostic != null) {
                host.reportPartitionDiagnostic(in.target, diagnostic)
            }

            row += 1
        }
    })

    host.publishPartitionState(in.target)

    return in.failed
}
