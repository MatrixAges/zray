import type { U8Buffer } from "memory"
import type { Input as Options, Prepared as Arguments } from "../arguments/model"

export type Lookup = {
    previous: u8[],
    digests: u8[][]
}

export type Build = Lookup & {
    present: bool[],
    target: U8Buffer
}

export type Publish = {
    digests: u8[][],
    valid: bool[]
}

export type ScheduleInput = {
    state: Build,
    options: Options
}

export type Schedule = {
    pending: u32[],
    arguments: Arguments,
    invalidate: bool
}
