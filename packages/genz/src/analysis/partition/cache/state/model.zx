import type { Writer } from "std:bytes"
import type { U8Buffer } from "std:memory"

export type Lookup = {
    previous: u8[],
    digests: u8[][]
}

export type Build = Lookup & {
    present: bool[],
    target: U8Buffer
}

export type Publish = {
    out: Writer,
    digests: u8[][],
    valid: bool[]
}
