import type { Input as Options, Prepared as Arguments } from "../arguments/model"

export type Lookup = {
    previous: u8[],
    digests: u8[][]
}

export type Build = Lookup & {
    present: bool[]
}

export type Checked = {
    pending: u32[],
    valid?: bool[]
}

export type Publish = {
    digests: u8[][],
    valid: bool[]
}

export type ScheduleInput = {
    state: Build,
    options: Options
}

export type Schedule = {
    pending: u32[],
    valid?: bool[],
    arguments: Arguments,
    invalidate: bool
}
