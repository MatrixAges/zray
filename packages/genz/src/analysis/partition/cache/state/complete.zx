export type Input = {
    pending: u32[],
    failures: string?[]
}

export type Output = {
    failed: bool,
    completed: u32[]
}

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        position: 0,
        failed: false,
        completed: empty
    }, {
        while: state => state.position < in.pending.length,
        next: state => {
            const position = state.position

            if (in.failures[position] == null) {
                state.completed = state.completed.push(in.pending[position])[0]
            } else {
                state.failed = true
            }

            state.position += 1
        },
        return: state => ({
            failed: state.failed,
            completed: state.completed
        })
    })
}
