import integers from "std:integer"
import memory from "std:memory"

import type { U8Buffer } from "std:memory"

export type Input = {
    pending: u32[],
    failures: string?[],
    target: U8Buffer
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        position: 0,
        failed: false
    }, {
        while: state => state.position < in.pending.length,
        next: state => {
            const position = state.position

            if (in.failures[position] == null) {
                const partition = integers.widen(in.pending[position])

                memory.writeU8(in.target, partition, 1)
            } else {
                state.failed = true
            }

            state.position += 1
        },
        return: state => state.failed
    })
}
