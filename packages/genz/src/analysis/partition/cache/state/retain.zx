import integers from "std:integer"

export type Input = {
    pending: u32[],
    length: u64
}

export type Output = bool[]

export default function (in: Input): Output {
    const empty: bool[] = []

    return loop({
        partition: 0,
        next: 0,
        valid: empty
    }, {
        while: state => state.partition < in.length,
        next: state => {
            const next = state.next
            const invalidate = next < in.pending.length &&
                integers.widen(in.pending[next]) == state.partition

            state.valid = state.valid.push(!invalidate)[0]

            if (invalidate) {
                state.next += 1
            }

            state.partition += 1
        },
        return: state => state.valid
    })
}
