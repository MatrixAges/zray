import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { U8Buffer } from "zig:compiler_memory"

export type Input = {
    pending: u32[],
    length: u64,
    target: U8Buffer
}

export type Output = void

export default function (in: Input): Output {
    const retained = loop({
        partition: 0,
        next: 0
    }, {
        while: state => state.partition < in.length,
        next: state => {
            const next = state.next
            const invalidate = next < in.pending.length &&
                integers.widen(in.pending[next]) == state.partition

            memory.writeU8(in.target, state.partition, invalidate ? 0 : 1)

            if (invalidate) {
                state.next += 1
            }

            state.partition += 1
        }
    })
}
