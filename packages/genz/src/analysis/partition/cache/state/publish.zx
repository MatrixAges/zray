import bytes from "std:bytes"

import type { Publish as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { digests, valid } = in

    const parts: u8[][] = []

    const collected = loop({
        index: 0,
        parts
    }, {
        while: state => state.index < valid.length,
        next: state => {
            const index = state.index

            if (valid[index]) {
                const line = bytes.join(bytes.fromText(""), [
                    bytes.fromText(templateFile("./entry.tpl")),
                    digests[index],
                    bytes.fromText("\n")
                ])

                state.parts = state.parts.push(line)[0]
            }

            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
