<Module>
    <Type from="model" as="State" />

    <Args in={State.Build} out={State.Checked} />

    <Call
        fn="lookup"
        in={{
            previous: $in.previous,
            digests: $in.digests
        }}
    />

    <Call
        fn="pending"
        in={{
            matched: $ctx.lookup,
            present: $in.present
        }}
    />

    <If on={$ctx.pending.length != 0}>
        <Call
            fn="retain"
            in={{
                pending: $ctx.pending,
                length: $in.present.length
            }}
        />

        <Return
            value={{
                pending: $ctx.pending,
                valid: $ctx.retain
            }}
        />
    </If>

    <Return
        value={{
            pending: $ctx.pending,
            valid: null
        }}
    />
</Module>
