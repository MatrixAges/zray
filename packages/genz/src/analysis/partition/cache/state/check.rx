<Module>
    <Type from="model" as="State" />

    <Args in={State.Build} out={u32[]} />

    <Call
        fn="lookup"
        in={{
            previous: $in.previous,
            digests: $in.digests
        }}
    />

    <Call
        fn="pending"
        in={{
            matched: $ctx.lookup,
            present: $in.present
        }}
    />

    <If on={$ctx.pending.length != 0}>
        <Call
            fn="retain"
            in={{
                pending: $ctx.pending,
                length: $in.present.length,
                target: $in.target
            }}
        />
    </If>

    <Return value={$ctx.pending} />
</Module>
