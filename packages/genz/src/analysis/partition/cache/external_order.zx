import bytes from "std:bytes"

import {
    sort_equal,
    sort_greater,
    sort_less
} from "../../uniqueness/replay/ordered/const"

export type File = {
    path: string,
    size?: u64
}

export type Input = File[]

export type Output = File[]

export default function (in: Input): Output {
    return in.sort(
        (left, right) => match {
            left.path == right.path => sort_equal,
            bytes.lessThan(
                bytes.fromText(left.path),
                bytes.fromText(right.path)
            ) =>
                sort_less,
            _ => sort_greater
        }
    )[0]
}
