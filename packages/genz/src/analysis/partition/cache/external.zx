import bytes from "std:bytes"

export type Input = {
    path: string,
    size?: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    const path = bytes.fromText(in.path)
    const size = in.size
    const encoded_size = size == null ? bytes.fromText("") : bytes.encodeU64Le(size)

    return bytes.join(bytes.fromText(""), [
        bytes.encodeU64Le(path.length),
        path,
        encoded_size
    ])
}
