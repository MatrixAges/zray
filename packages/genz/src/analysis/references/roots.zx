import memory from "memory"

import mark from "./mark"
import markIds from "./mark_ids"

import type { Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { needed, members, roots } = in

    memory.fillByteRange(needed, 0, in.functions.expressions.length, 0)

    return loop({
        row: 0,
        count: markIds({
            ids: members,
            needed
        })
    }, {
        while: state => state.row < roots.length,
        next: state => {
            state.count += mark({
                body: roots[state.row],
                needed
            })
            state.row += 1
        },
        return: state => state.count
    })
}
