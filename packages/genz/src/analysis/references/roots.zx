import mark from "./mark"
import markIds from "./mark_ids"

import type { Input, State as Output } from "./model"

export default function (in: Input): Output {
    const { members, roots } = in

    const empty: bool[] = []

    const initialized = loop(empty, {
        while: needed => needed.length < in.functions.expressions.length,
        next: needed => {
            needed = needed.push(false)[0]
        }
    })

    const initial = markIds({
        ids: members,
        needed: initialized,
        count: 0
    })

    return loop({
        row: 0,
        needed: initial.needed,
        count: initial.count
    }, {
        while: state => state.row < roots.length,
        next: state => {
            const next = mark({
                body: roots[state.row],
                needed: state.needed,
                count: state.count
            })

            state.needed = next.needed
            state.count = next.count
            state.row += 1
        },
        return: state => ({
            needed: state.needed,
            count: state.count
        })
    })
}
