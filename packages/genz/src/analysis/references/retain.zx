import memory from "memory"
import columns from "memory/columns"

import type { Destination } from "./model"

export type Input = {
    destination: Destination,
    names: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const result = columns.copyColumnTextViews(in.destination.owner, in.names)

    memory.resetArena(in.destination.scratch)

    return result
}
