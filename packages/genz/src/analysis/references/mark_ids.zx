import integers from "std:integer"

import type { State as Output } from "./model"

export type Input = Output & {
    ids: u32[]
}

export default function (in: Input): Output {
    const { ids } = in

    return loop({
        row: 0,
        needed: in.needed,
        count: in.count
    }, {
        while: state => state.row < ids.length,
        next: state => {
            const id = integers.widen(ids[state.row])

            if (!state.needed[id]) {
                state.needed[id] = true
                state.count += 1
            }

            state.row += 1
        },
        return: state => ({
            needed: state.needed,
            count: state.count
        })
    })
}
