<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Input} out={u64} />

    <Call fn="roots" in={$in} />

    <Call
        fn="closure"
        in={{
            functions: $in.functions,
            needed: $in.needed,
            count: $ctx.roots
        }}
    />

    <Return value={$ctx.closure} />
</Module>
