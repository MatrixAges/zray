import type { Contracts } from "core/contract_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Arena, U8Buffer } from "memory"
import type { ColumnAllocator } from "memory/columns"

export type Body = {
    expressions: Expressions,
    contracts: Contracts
}

export type Functions = {
    expressions: Expressions[],
    contracts: Contracts[]
}

export type Input = {
    functions: Functions,
    roots: Body[],
    needed: U8Buffer,
    members: u32[]
}

export type Destination = {
    owner: ColumnAllocator,
    scratch: Arena
}

export type Imports = Body & {
    names: string[],
    members: u32[],
    destination?: Destination,
    native?: string
}
