import integers from "std:integer"

import type { Imports as Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { body, members, names } = in

    const contracts = body.contracts.expressions
    const empty: string[] = []

    return loop({
        table: 0,
        values: empty
    }, {
        while: state => state.table <= contracts.length + 1,
        next: state => {
            const ids = match {
                state.table == 0 => body.expressions.call_functions,
                state.table <= contracts.length =>
                    contracts[state.table - 1].call_functions,
                _ => members
            }

            state.values = loop({
                row: 0,
                values: state.values
            }, {
                while: items => items.row < ids.length,
                next: items => {
                    const id = integers.widen(ids[items.row])

                    items.values = items.values.push(names[id])[0]
                    items.row += 1
                },
                return: items => items.values
            })
            state.table += 1
        },
        return: state => state.values
    })
}
