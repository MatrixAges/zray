import memory from "memory"

import mark from "./mark"

import type { Input as Graph } from "./model"

export type Input = Graph.Pick("functions", "needed") & {
    count: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { functions, needed } = in

    return loop({
        index: functions.expressions.length,
        count: in.count
    }, {
        while: state => state.index != 0,
        next: state => {
            state.index -= 1
            const index = state.index

            if (memory.readU8(needed, index) != 0) {
                state.count += mark({
                    body: {
                        expressions: functions.expressions[index],
                        contracts: functions.contracts[index]
                    },
                    needed
                })
            }
        },
        return: state => state.count
    })
}
