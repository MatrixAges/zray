import mark from "./mark"

import type { Input as Graph, State } from "./model"

export type Input = State & Graph.Pick("functions")

export type Output = State

export default function (in: Input): Output {
    const { functions } = in

    return loop({
        index: functions.expressions.length,
        needed: in.needed,
        count: in.count
    }, {
        while: state => state.index != 0,
        next: state => {
            state.index -= 1
            const index = state.index

            if (state.needed[index]) {
                const next = mark({
                    body: {
                        expressions: functions.expressions[index],
                        contracts: functions.contracts[index]
                    },
                    needed: state.needed,
                    count: state.count
                })

                state.needed = next.needed
                state.count = next.count
            }
        },
        return: state => ({
            needed: state.needed,
            count: state.count
        })
    })
}
