import markIds from "./mark_ids"

import type { Body, Input as Graph } from "./model"

export type Input = Graph.Pick("needed") & {
    body: Body
}

export type Output = u64

export default function (in: Input): Output {
    const { body, needed } = in

    return loop({
        row: 0,
        count: markIds({
            ids: body.expressions.call_functions,
            needed
        })
    }, {
        while: state => state.row < body.contracts.expressions.length,
        next: state => {
            const contract = body.contracts.expressions[state.row]

            state.count += markIds({
                ids: contract.call_functions,
                needed
            })
            state.row += 1
        },
        return: state => state.count
    })
}
