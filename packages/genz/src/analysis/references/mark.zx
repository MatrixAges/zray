import markIds from "./mark_ids"

import type { Body, State } from "./model"

export type Input = State & {
    body: Body
}

export type Output = State

export default function (in: Input): Output {
    const { body } = in

    const direct = markIds({
        ids: body.expressions.call_functions,
        needed: in.needed,
        count: in.count
    })

    return loop({
        row: 0,
        needed: direct.needed,
        count: direct.count
    }, {
        while: state => state.row < body.contracts.expressions.length,
        next: state => {
            const contract = body.contracts.expressions[state.row]

            const next = markIds({
                ids: contract.call_functions,
                needed: state.needed,
                count: state.count
            })

            state.needed = next.needed
            state.count = next.count
            state.row += 1
        },
        return: state => ({
            needed: state.needed,
            count: state.count
        })
    })
}
