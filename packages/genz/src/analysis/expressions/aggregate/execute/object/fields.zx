import integers from "std:integer"
import { convertStateValue, StateValueMode } from "ast_rows"
import host from "lowering_host"

import bindOperand from "../../../../aggregate/execute/bind_operand"
import borrowedField from "../../../../aggregate/execute/borrowed_field"
import { Route } from "../../../../aggregate/layout/fields"

import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    expression_types: u32[],
    fields: u32[],
    field_indices: u32[],
    field_names: string[],
    plain: Route,
    routes: Route[],
    projection_seed?: u32
}

export type Output = u32[]

export default function (in: Input): Output {
    const {
        frame,
        writer,
        sequence,
        expression_types,
        fields,
        field_indices,
        field_names,
        plain,
        routes,
        projection_seed
    } = in

    const initial: u32[] = []

    return loop({
        values: initial,
        index: 0
    }, {
        while: state => state.index < fields.length,
        next: state => {
            const item = fields[state.index]
            const value = host.lowerExpression(frame, item, false, null)

            const route = match routes.length {
                0 => plain,
                _ => routes[state.index]
            }

            if (route == Route.Direct) {
                state.values = state.values.push(value)[0]
            } else if (route == Route.Borrowed) {
                const name = field_names[integers.widen(field_indices[state.index])]
                const seed = projection_seed ?? host.invalidLowering()

                const borrowed = borrowedField({
                    frame,
                    writer,
                    seed,
                    name,
                    evaluated: value
                })

                state.values = state.values.push(borrowed)[0]
            } else {
                const bound = bindOperand({
                    frame,
                    writer,
                    sequence,
                    value
                })

                const pointer = convertStateValue(
                    writer,
                    sequence,
                    expression_types[integers.widen(item)],
                    bound,
                    StateValueMode.Pointer,
                    false
                )

                state.values = state.values.push(pointer)[0]
            }

            state.index += 1
        },
        return: state => state.values
    })
}
