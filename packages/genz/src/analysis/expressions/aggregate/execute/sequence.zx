import integers from "std:integer"
import { convertStateValue, StateValueMode, writeCollectionElement } from "ast_rows"
import {
    appendExpressionRows,
    AstPayloadOwnership,
    astExpressionCount,
    retainAstIds
} from "ast_rows"
import host from "lowering_host"

import operandsColumns from "../../../../ast/rows/operands_columns"
import { ExpressionsKind } from "../../../../printer/model/expressions"
import bindOperand from "../../../aggregate/execute/bind_operand"
import policy from "../../../aggregate/sequence"
import { Element, Result } from "../../../aggregate/sequence"

import type { AstSequence, AstWriter } from "ast_rows"
import type { ExpressionKind } from "core/expression_table/kinds"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    type_id: u32,
    expression_types: u32[],
    kind: ExpressionKind,
    layout: bool,
    state_active: bool,
    selected: bool,
    items: u32[]
}

export type Output = {
    result: Result,
    tuple?: u32,
    expressions: u32[]
}

export default function (in: Input): Output {
    const { frame, writer, sequence, items } = in

    const plan = policy({
        kind: in.kind,
        layout: in.layout,
        state_active: in.state_active,
        selected: in.selected
    })

    const empty: u32[] = []

    const expressions = loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < items.length,
        next: state => {
            const item = items[state.index]
            const value = host.lowerExpression(frame, item, false, null)

            const bound = bindOperand({
                frame,
                writer,
                sequence,
                value
            })

            const element = match plan.element {
                Element.Direct => bound,
                Element.List =>
                    writeCollectionElement(writer, sequence, in.type_id, bound),
                _ => convertStateValue(
                    writer,
                    sequence,
                    in.expression_types[integers.widen(item)],
                    bound,
                    StateValueMode.Pointer,
                    false
                )
            }

            state.values = state.values.push(element)[0]
            state.index += 1
        },
        return: state => state.values
    })

    if (plan.result == Result.Tuple || plan.result == Result.LayoutTuple) {
        const base = astExpressionCount(writer)
        const retained = retainAstIds(writer, expressions)

        const columns = operandsColumns({
            tags: [ExpressionsKind.Tuple],
            offsets: [0],
            tuple: [retained],
            builtin_name: [],
            builtin_arguments: [],
            identifier: [],
            address_of: [],
            object_type_expr: [],
            object_fields_start: [],
            object_fields_len: []
        })

        appendExpressionRows(
            writer,
            columns.rows,
            columns.forms,
            AstPayloadOwnership.Borrowed
        )

        return {
            result: plan.result,
            tuple: base,
            expressions
        }
    }

    return {
        result: plan.result,
        tuple: null,
        expressions
    }
}
