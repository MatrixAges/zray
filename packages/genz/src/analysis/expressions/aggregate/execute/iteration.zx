import { appendAstIdentifierRows, readAstOrigin } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import identifierRows from "../../../aggregate/binding/identifier_rows"
import reference from "../../../aggregate/binding/reference"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { IterationResourceFrame, Lowering } from "lowering_host"
import type { Bindings } from "../../../iteration/literals/model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    context: IterationResourceFrame,
    operands: u32[],
    fields?: u32[],
    observe: bool
}

export type Output = {
    bindings: Bindings,
    field_values: u32[],
    prior: u64[]
}

export default function (in: Input): Output {
    const { frame, writer, origin, context, operands, fields, observe } = in

    const empty_names: u8[][] = []
    const empty_u32: u32[] = []
    const empty_u64: u64[] = []

    const bound = loop({
        index: 0,
        names: empty_names,
        values: empty_u32,
        references: empty_u32,
        prior: empty_u64
    }, {
        while: state => state.index < operands.length,
        next: state => {
            const index = state.index
            const item = operands[index]
            const value = host.lowerExpression(frame, item, false, null)
            const current = readAstOrigin(writer, origin)

            const ref = reference({
                expression_base: current.expression_base,
                serial: current.serial
            })

            requireAllocation(ref.valid)

            const name = host.retainLoweringText(frame, ref.name)

            appendAstIdentifierRows(writer, identifierRows(name))
            host.finishGeneratedAst(frame, ref.serial, false)

            if (observe) {
                const count = host.observeIterationOperand(context, item, ref.root)

                state.prior = state.prior.push(count)[0]
            }

            state.names = state.names.push(name)[0]
            state.values = state.values.push(value)[0]
            state.references = state.references.push(ref.root)[0]
            state.index += 1
        },
        return: state => ({
            names: state.names,
            values: state.values,
            references: state.references,
            prior: state.prior
        })
    })

    const field_values = match {
        fields == null => empty_u32,
        _ => loop({
            index: 0,
            values: empty_u32
        }, {
            while: state => state.index < fields.length,
            next: state => {
                const value =
                    host.lowerExpression(frame, fields[state.index], false, null)

                state.values = state.values.push(value)[0]
                state.index += 1
            },
            return: state => state.values
        })
    }

    return {
        bindings: bound.omit(["prior"]),
        field_values,
        prior: bound.prior
    }
}
