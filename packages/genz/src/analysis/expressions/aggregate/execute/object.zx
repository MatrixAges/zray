import integers from "std:integer"
import { appendAstBindingRows } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import finishBlock from "../../../aggregate/execute/finish_block"
import objectLiteral from "../../../aggregate/execute/object_literal"
import retireOperands from "../../../aggregate/execute/retire_operands"
import layoutPlan from "../../../aggregate/layout/plan"
import lowerFields from "./object/fields"
import lowerOperands from "./object/operands"

import type { Input as ObjectInput } from "./object/model"

export type Input = ObjectInput

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, origin, sequence, batch } = in

    const observed = lowerOperands(
        in.pick([
            "frame",
            "writer",
            "origin",
            "sequence",
            "evaluation"
        ])
    )

    const updated = host.prepareObjectFields(batch)

    const layout = layoutPlan({
        expression: integers.widen(in.id),
        loop_states: in.loop_states,
        state_active: in.state_active,
        selected: in.selected,
        layout_only: in.layout_only,
        updated: updated != null,
        indices: in.field_indices,
        borrowed: in.borrowed
    })

    const field_values: u32[] = match {
        updated != null => [],
        _ => lowerFields({
            ...in.pick([
                "frame",
                "writer",
                "origin",
                "sequence",
                "batch",
                "fields",
                "field_indices",
                "field_names",
                "projection_seed"
            ]),
            plain: layout.plain,
            routes: layout.routes
        })
    }

    const retired = retireOperands({
        evaluation: in.evaluation,
        prior: observed.prior,
        references: observed.references,
        cache_reads: in.cache_reads
    })

    requireAllocation(retired.valid)

    if (retired.rows != null) {
        appendAstBindingRows(writer, sequence, retired.rows)
    }

    const result = updated ?? objectLiteral({
        writer,
        type_expr: match {
            layout.project => in.projection_layout ?? host.invalidLowering(),
            _ => host.lowerLayout(frame, in.type_id)
        },
        names: in.field_names,
        indices: in.field_indices,
        values: field_values
    })

    const constructed = match {
        layout.construct => host.finishObject(frame, in.type_id, result),
        _ => result
    }

    return finishBlock({
        frame,
        writer,
        origin,
        sequence,
        value: constructed
    })
}
