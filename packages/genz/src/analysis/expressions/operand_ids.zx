import { retainAstIds } from "ast_rows"

import type { AstWriter } from "ast_rows"

export type Pair = {
    first: u32,
    second: u32
}

export type Input = {
    writer: AstWriter,
    arguments?: Pair
}

export type Output = u32[][]

export default function (in: Input): Output {
    const { writer, arguments } = in

    if (arguments == null) {
        return []
    }

    return [retainAstIds(writer, [
        arguments.first,
        arguments.second
    ])]
}
