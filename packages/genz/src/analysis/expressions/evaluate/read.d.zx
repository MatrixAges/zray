export declare function readReference(
    frame: Lowering,
    symbol: u32,
    result_type: u32,
    iteration: bool
): u32 throws { OutOfMemory }

export declare function readTupleResult(
    frame: Lowering,
    operand: u32,
    index: u32
): u32? throws { OutOfMemory }

export declare function readRawMember(frame: Lowering, operand: u32): u32?
    throws { OutOfMemory }

export declare function readAnchor(frame: Lowering, operand: u32): u32
    throws { OutOfMemory }

export declare function readMember(
    frame: Lowering,
    row: u32,
    source: u32,
    raw: bool,
    iteration: bool
): u32 throws { OutOfMemory }

export declare function readRawList(frame: Lowering, operand: u32): u32?
    throws { OutOfMemory }

export declare function readList(frame: Lowering, operand: u32): u32 throws { OutOfMemory }

export declare function readListItems(frame: Lowering, origin: u32, value: u32): u32
    throws { OutOfMemory }

export declare function wrapLoweredList(frame: Lowering, subject: u32, items: u32): u32
    throws { OutOfMemory }

export declare function readElement(frame: Lowering, target_type: u32, value: u32): u32
    throws { OutOfMemory }

export declare function readBorrowedList(frame: Lowering, type_id: u32, value: u32): u32
    throws { OutOfMemory }

export declare function readRepresentedValue(frame: Lowering, type_id: u32, value: u32): u32
    throws { OutOfMemory }
