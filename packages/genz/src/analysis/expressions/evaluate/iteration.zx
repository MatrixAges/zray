import host from "lowering_host"
import { Representation } from "lowering_host"

import { Route } from "../../iteration/evaluation/model"
import read from "../read/evaluate"
import { ReadAction } from "../read/model"
import conditional from "./conditional"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Output as Plan } from "../../iteration/evaluation/model"
import type { IterationExpressions } from "./model"

export type Input = Plan & {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    expressions: IterationExpressions,
    id: u32,
    argument?: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, origin, expressions, id, probe } = in

    const read_expressions = expressions.omit([
        "conditional_conditions",
        "conditional_yes",
        "conditional_no"
    ])

    const conditional_expressions = expressions.pick([
        "payloads",
        "conditional_conditions",
        "conditional_yes",
        "conditional_no"
    ])

    switch (in.route) {
        case Route.Argument: return in.argument ?? host.invalidLowering()
        case Route.Cached:
            const value = in.value ?? host.invalidLowering()

            host.reuseIteration(frame, id)

            return value
        case Route.Fallback: return host.lowerRegular(
            frame,
            id,
            probe.checked,
            probe.value
        )
        case Route.Binary: return host.lowerRegular(
            frame,
            id,
            probe.checked,
            probe.value
        )
        case Route.Unpack:
            const value = host.lowerRegular(frame, id, probe.checked, probe.value)

            return host.lowerUnpack(frame, id, value)
        case Route.Reference: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Reference,
            iteration: true,
            result_type: null
        })
        case Route.Field: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Field,
            iteration: true,
            result_type: null
        })
        case Route.Unwrap: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Unwrap,
            iteration: true,
            result_type: null
        })
        case Route.TupleField: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.TupleField,
            iteration: true,
            result_type: null
        })
        case Route.Index: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Index,
            iteration: true,
            result_type: null
        })
        case Route.Length: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Length,
            iteration: true,
            result_type: null
        })
        case Route.Some: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Wrap,
            iteration: true,
            result_type: null
        })
        case Route.None: return read({
            frame,
            writer,
            origin,
            state: null,
            expressions: read_expressions,
            row: id,
            action: ReadAction.Empty,
            iteration: true,
            result_type: null
        })
        case Route.Update: return host.lowerMutation(frame, id)
        case Route.Mutation: return host.lowerMutation(frame, id)
        case Route.Aggregate: return host.lowerAggregate(
            frame,
            id,
            Representation.Iteration
        )
        case Route.List: return host.lowerAggregate(frame, id, Representation.Iteration)
        case Route.Collection: return host.lowerCollection(
            frame,
            id,
            Representation.Iteration
        )
        case Route.Scope: return host.lowerScope(frame, id, Representation.Iteration)
        case Route.Call: return host.lowerCall(
            frame,
            id,
            Representation.Iteration,
            in.value_call
        )
        case Route.Conditional: return conditional({
            frame,
            writer,
            expressions: conditional_expressions,
            id,
            value: false
        })
        case Route.Match: return host.lowerMatch(frame, id, false)
        case Route.Inspect: return host.invalidLowering()
    }
}
