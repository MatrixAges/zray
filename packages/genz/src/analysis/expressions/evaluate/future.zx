import integers from "std:integer"
import { readAstOrigin } from "ast_rows"
import host from "lowering_host"

import futureLabel from "../../tasks/future/label"
import { Kind as LabelKind } from "../../tasks/future/label"
import complete from "./future_complete"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { ExpressionKind } from "core/expression_table/kinds"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    kinds: ExpressionKind[],
    child: u32,
    cancel: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, origin, kinds, child, cancel: canceling } = in

    host.publishTaskEffects(frame, false, true, false)

    const inline_task = kinds[integers.widen(child)] == ExpressionKind.Task

    if (inline_task) {
        const current = readAstOrigin(writer, origin)

        const generated = futureLabel({
            kind: LabelKind.Future,
            serial: current.serial
        })

        const retained = host.retainLoweringText(frame, generated.name)

        host.setLoweringSerial(frame, generated.serial)

        const started = host.startInlineTask(frame, child, retained, false)

        return complete({
            frame,
            writer,
            origin,
            started,
            value: null,
            name: retained,
            cancel: canceling
        })
    }

    const operand = host.lowerExpression(frame, child, false, null)

    return complete({
        frame,
        writer,
        origin,
        started: 0,
        value: operand,
        name: null,
        cancel: canceling
    })
}
