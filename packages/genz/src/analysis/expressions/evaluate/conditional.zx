import integers from "std:integer"
import {
    appendExpressionRows,
    AstPayloadOwnership,
    astExpressionCount
} from "ast_rows"
import host from "lowering_host"

import emptyExpressions from "../../../ast/expressions/empty"
import emptyForms from "../../../ast/expressions/forms/empty"
import emitConditional from "../../selection/conditional"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { ConditionalExpressions } from "./model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    expressions: ConditionalExpressions,
    id: u32,
    value: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, expressions, id } = in

    const payload = integers.widen(expressions.payloads[integers.widen(id)])

    const test = expressions.conditional_conditions[payload]
    const yes = expressions.conditional_yes[payload]
    const no = expressions.conditional_no[payload]

    const condition = host.lowerExpression(frame, test, false, null)

    const accepted = match {
        in.value => host.lowerValueExpression(frame, yes),
        _ => host.lowerExpression(frame, yes, false, null)
    }

    const declined = match {
        in.value => host.lowerValueExpression(frame, no),
        _ => host.lowerExpression(frame, no, false, null)
    }

    const root = astExpressionCount(writer)

    const emitted = emitConditional({
        condition,
        yes: accepted,
        no: declined
    })

    appendExpressionRows(
        writer,
        {
            ...emptyExpressions({}),
            tags: emitted.tags,
            offsets: emitted.offsets
        },
        {
            ...emptyForms({}),
            ...emitted.omit([
                "tags",
                "offsets"
            ])
        },
        AstPayloadOwnership.Borrowed
    )

    return root
}
