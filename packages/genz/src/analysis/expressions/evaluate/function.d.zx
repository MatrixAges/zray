export declare function prepareFunctionBody(frame: Lowering): u8[][]?
    throws { OutOfMemory }

export declare function lowerFunctionStatements(frame: Lowering): u64
    throws { OutOfMemory }

export declare function lowerFunctionContracts(frame: Lowering): u64
    throws { OutOfMemory }

export declare function lowerFunctionPrelude(
    frame: Lowering,
    exported: bool,
    io: bool,
    process: bool
): u64 throws { OutOfMemory }

export declare function lowerFunctionPending(frame: Lowering): u64
    throws { OutOfMemory }

export declare function lowerFunctionReferences(frame: Lowering): u64
    throws { OutOfMemory }

export declare function openPreconditionScope(
    parent: Lowering,
    predicate: Lowering,
    index: u64
): void throws { OutOfMemory }

export declare function publishPreconditionScope(parent: Lowering, predicate: Lowering): void
