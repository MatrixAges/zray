export declare function openStatementScope(
    allocator,
    frame: Lowering,
    start: u32,
    count: u32
): StatementStack throws { OutOfMemory }

export declare function beginStatementStore(
    frame: Lowering,
    first: u64,
    count: u64,
    index: u64
): u64 throws { OutOfMemory }

export declare function emitParallelStatement(
    frame: Lowering,
    statement: u64
): u64 throws { OutOfMemory }

export declare function finishStatementScope(
    frame: Lowering,
    state_checkpoint: u64,
    stack_checkpoint: u64,
    spans: u64[]
): u64 throws { OutOfMemory }

export declare function finishStatementSelection(
    allocator,
    frame: Lowering,
    name: u8[],
    subject: u32,
    reference: u32,
    selected: bool,
    exhaustive: bool,
    total_count: u64,
    fallback: u64?,
    cases: StatementCases
): u64 throws { OutOfMemory }
