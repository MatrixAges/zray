export declare function guardLoopInitial(frame: LoopFrame, value: u32): void
    throws { OutOfMemory }

export declare function prepareLoopFields(frame: LoopFrame): bool throws { OutOfMemory }

export declare function emitLoopRenewals(
    frame: LoopFrame,
    first: u64,
    end: u64,
    skipped: u64[],
    filtered_inline: bool
): u64 throws { OutOfMemory }

export declare function maskLoopBorrowedFields(frame: LoopFrame): void throws { OutOfMemory }

export declare function declareProjectedLoopState(frame: LoopFrame): void throws { OutOfMemory }

export declare function projectLoopAssignment(frame: LoopFrame, value: u32): u32
    throws { OutOfMemory }

export declare function restoreLoopFields(frame: LoopFrame): u32 throws { OutOfMemory }

export declare function consumeDeepLoopResult(
    frame: Lowering,
    consumer: LoopConsumer,
    state: u32
): u32 throws { OutOfMemory }

export declare function consumeBufferedLoopResult(
    allocator,
    context: IterationResourceFrame,
    consumer: LoopConsumer,
    state: u32
): LoopConsumption throws { OutOfMemory }

export declare function consumeLoopProjection(
    allocator,
    frame: Lowering,
    consumer: LoopConsumer,
    state: u32,
    converted: bool
): LoopConsumption throws { OutOfMemory }

export declare function convertLoopResult(
    context: IterationResourceFrame,
    type_id: u32,
    state: u32,
    output: bool
): u32 throws { OutOfMemory }
