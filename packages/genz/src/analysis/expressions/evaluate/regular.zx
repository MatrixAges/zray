import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import host from "lowering_host"
import { Representation } from "lowering_host"

import read from "../read/evaluate"
import { ReadAction } from "../read/model"
import conditional from "./conditional"
import future from "./future"
import literal from "./literal"
import operator from "./operator"
import store from "./store"

import type { AstWriter } from "ast_rows"
import type { Table } from "core/type_table/model"
import type { Lowering } from "lowering_host"
import type { Expressions, StoreContext } from "./model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    store: StoreContext,
    expressions: Expressions,
    types: Table,
    id: u32,
    kind: ExpressionKind,
    type_id: u32
}

export type Output = {
    expression: u32,
    uses_context: bool
}

export default function (in: Input): Output {
    const { frame, writer, expressions, types, id, kind, type_id } = in

    const payload = integers.widen(expressions.payloads[integers.widen(id)])
    const result_type = host.lowerType(frame, type_id, false)

    if (kind == ExpressionKind.StoreGet) {
        return {
            expression: store({
                frame,
                writer,
                store: in.store,
                types,
                slot: expressions.stores[payload],
                type_id
            }),
            uses_context: true
        }
    }

    const state = {
        queries: in.store.queries,
        active: in.store.active
    }

    const read_expressions = expressions.pick([
        "types",
        "payloads",
        "some",
        "optional_values",
        "references",
        "projection_targets",
        "projection_indices",
        "index_targets",
        "index_values",
        "lengths"
    ])

    const conditional_expressions = expressions.pick([
        "payloads",
        "conditional_conditions",
        "conditional_yes",
        "conditional_no"
    ])

    const literal_expressions = expressions.pick([
        "kinds",
        "types",
        "payloads",
        "integers",
        "negative_integers",
        "floats",
        "strings",
        "booleans",
        "enumerations",
        "errors"
    ])

    const read_base = {
        frame,
        writer,
        state,
        expressions: read_expressions,
        row: id,
        iteration: false,
        result_type
    }

    const literal_input = {
        writer,
        expressions: literal_expressions,
        types,
        id,
        type_expr: result_type
    }

    const expression = match kind {
        ExpressionKind.Some => read({
            ...read_base,
            action: ReadAction.Wrap
        }),
        ExpressionKind.OptionalValue => read({
            ...read_base,
            action: ReadAction.Unwrap
        }),
        ExpressionKind.Reference => read({
            ...read_base,
            action: ReadAction.Reference
        }),
        ExpressionKind.Field => read({
            ...read_base,
            action: ReadAction.Field
        }),
        ExpressionKind.TupleField => read({
            ...read_base,
            action: ReadAction.TupleField
        }),
        ExpressionKind.Index => read({
            ...read_base,
            action: ReadAction.Index
        }),
        ExpressionKind.Length => read({
            ...read_base,
            action: ReadAction.Length
        }),
        ExpressionKind.Task => host.lowerTask(frame, id),
        ExpressionKind.AwaitTask => future({
            frame,
            writer,
            kinds: expressions.kinds,
            child: expressions.awaits[payload],
            cancel: false
        }),
        ExpressionKind.CancelTask => future({
            frame,
            writer,
            kinds: expressions.kinds,
            child: expressions.cancellations[payload],
            cancel: true
        }),
        ExpressionKind.Parallel => host.lowerParallel(frame, id),
        ExpressionKind.Capture => host.lowerCapture(frame, id, false),
        ExpressionKind.Unary => operator({
            frame,
            writer,
            expressions,
            types,
            id,
            binary: false
        }),
        ExpressionKind.Binary => operator({
            frame,
            writer,
            expressions,
            types,
            id,
            binary: true
        }),
        ExpressionKind.Conditional => conditional({
            frame,
            writer,
            expressions: conditional_expressions,
            id,
            value: false
        }),
        ExpressionKind.Match => host.lowerMatch(frame, id, false),
        ExpressionKind.Object => host.lowerAggregate(frame, id, Representation.Regular),
        ExpressionKind.List => host.lowerAggregate(frame, id, Representation.Regular),
        ExpressionKind.Tuple => host.lowerAggregate(frame, id, Representation.Regular),
        ExpressionKind.Template =>
            host.lowerAggregate(frame, id, Representation.Regular),
        ExpressionKind.ListOperation =>
            host.lowerCollection(frame, id, Representation.Regular),
        ExpressionKind.Transform => host.lowerTransform(frame, id),
        ExpressionKind.Scope => host.lowerScope(frame, id, Representation.Regular),
        ExpressionKind.Iteration => host.lowerIteration(frame, id, false),
        ExpressionKind.ListUpdate => host.lowerUpdate(frame, id),
        ExpressionKind.Call => host.lowerCall(frame, id, Representation.Regular, false),
        ExpressionKind.Integer => literal(literal_input),
        ExpressionKind.NegativeInteger => literal(literal_input),
        ExpressionKind.Float => literal(literal_input),
        ExpressionKind.String => literal(literal_input),
        ExpressionKind.Boolean => literal(literal_input),
        ExpressionKind.None => literal(literal_input),
        ExpressionKind.Unit => literal(literal_input),
        ExpressionKind.EnumValue => literal(literal_input),
        ExpressionKind.ErrorValue => literal(literal_input),
        _ => host.invalidLowering()
    }

    return {
        expression,
        uses_context: false
    }
}
