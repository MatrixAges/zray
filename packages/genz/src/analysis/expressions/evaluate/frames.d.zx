export type StatementCases = {
    body_start: u32[],
    body_count: u32[],
    conditions: u32[],
    literals: u32?[]
}

export type Lowering = mutable_opaque

export enum Representation {
    Regular,
    Value,
    Iteration
}

export enum CallArgument {
    Value,
    Tuple,
    Borrow,
    Stack
}

export type ModuleSuffix = {
    uses_parallel: bool,
    comparisons: u64
}

export enum ModuleFunctionForm {
    Native,
    Regular,
    RegularAndValue,
    Value
}

export enum ModuleRequestForm {
    Done,
    Native,
    FirstRegular,
    Regular,
    FirstValue,
    Value
}

export enum StoredType {
    None,
    AbiType,
    AbiLayout,
    StateType,
    StateLayout,
    ViewType,
    IterationType,
    IterationItem,
    Layout
}

export type LoopProjection = {
    borrowed: bool[],
    layout: u32
}

export type LoopConsumer = {
    symbol: u32,
    result: u32,
    result_type: u32,
    layout: bool
}

export type SortComparator = {
    declaration: u32,
    io: bool,
    process: bool
}

export type SortOperand = {
    value: u32,
    span: u64
}

export type WorkerState = {
    uses_allocator: bool,
    uses_io: bool,
    uses_process: bool,
    used: bool[],
    names: u8[][]
}

export type IterationTransferResult = {
    root: u32,
    cached: u32
}
