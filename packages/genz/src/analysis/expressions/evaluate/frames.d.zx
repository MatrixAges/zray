export type StatementTraversal = opaque

export type StatementStack = {
    stack_keys: u32[],
    stack_buckets: u32[]
}

export type StatementWrite = {
    row: u64,
    start: u32,
    count: u32,
    previous?: u64
}

export type Lowering = mutable_opaque

export enum Representation {
    Regular,
    Value,
    Iteration
}

export enum CallArgument {
    Value,
    Tuple,
    Borrow,
    Stack
}

export type ModuleSuffix = {
    uses_parallel: bool,
    comparisons: u64
}

export enum ModuleFunctionForm {
    Native,
    Regular,
    RegularAndValue,
    Value
}

export enum ModuleRequestForm {
    Done,
    Native,
    FirstRegular,
    Regular,
    FirstValue,
    Value
}

export enum StoredType {
    None,
    AbiType,
    AbiLayout,
    StateType,
    StateLayout,
    ViewType
}
