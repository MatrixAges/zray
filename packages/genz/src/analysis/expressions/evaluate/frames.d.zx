export type StatementStack = {
    state_checkpoint: u64,
    stack_checkpoint: u64,
    stack_keys: u32[],
    stack_buckets: u32[]
}

export type StatementCases = {
    body_start: u32[],
    body_count: u32[],
    conditions: u32[],
    literals: u32?[]
}

export type Lowering = mutable_opaque

export enum Representation {
    Regular,
    Value,
    Iteration
}

export enum CallArgument {
    Value,
    Tuple,
    Borrow,
    Stack
}

export type ModuleSuffix = {
    uses_parallel: bool,
    comparisons: u64
}

export enum ModuleFunctionForm {
    Native,
    Regular,
    RegularAndValue,
    Value
}

export enum ModuleRequestForm {
    Done,
    Native,
    FirstRegular,
    Regular,
    FirstValue,
    Value
}

export enum StoredType {
    None,
    AbiType,
    AbiLayout,
    StateType,
    StateLayout,
    ViewType
}
