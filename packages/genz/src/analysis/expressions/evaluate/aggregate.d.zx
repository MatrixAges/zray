export declare function publishSequenceElement(
    batch: SequenceFrame,
    item: u32,
    bound: u32,
    list: bool
): u32 throws { OutOfMemory }

export declare function publishObjectOperand(
    frame: Lowering,
    item: u32,
    reference: u32
): u64 throws { OutOfMemory }

export declare function prepareObjectFields(batch: ObjectFrame): u32?
    throws { OutOfMemory }

export declare function publishObjectField(
    batch: ObjectFrame,
    item: u32,
    bound: u32
): u32 throws { OutOfMemory }

export declare function finishObject(
    frame: Lowering,
    type_id: u32,
    value: u32
): u32 throws { OutOfMemory }

export declare function publishIterationOperand(
    batch: IterationOperands,
    index: u64,
    item: u32,
    reference: u32
): void throws { OutOfMemory }
