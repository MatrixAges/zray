export type LoopConsumer = opaque

export type LoopConsumerCache = {
    count: u64,
    metadata: u8[],
    keys: u32[],
    values: u32[]
}

export type LoopConsumerFacts = {
    cache: LoopConsumerCache,
    transaction: bool,
    capture: bool
}

export type LoopLayout = opaque

export type LoopFrame = opaque

