export type LoopConsumer = mutable_opaque

export type LoopConsumerCache = {
    count: u64,
    metadata: u8[],
    keys: u32[],
    values: u32[]
}

export type LoopConsumerFacts = {
    cache: LoopConsumerCache,
    transaction: bool,
    capture: bool
}

export type LoopLayout = opaque

export type LoopFrame = mutable_opaque

export type IterationScopeBindings = {
    symbols: u32?[],
    values: u32?[],
    types: u32?[],
    names: u8[][]
}

export enum LoopParameterLayout {
    Plain,
    Stack,
    State,
    Deep
}

export enum LoopUpdateScope {
    None,
    Projected,
    Ordinary
}

export enum PathConversion {
    Plain,
    BorrowList,
    Convert,
    ReadElement
}

export enum LoopAdmission {
    Proceed,
    Dereference,
    Reject
}

export enum LoopInitial {
    Reference,
    Value,
    Deep
}

export type IterationResourceFrame = mutable_opaque

export type IterationResourceStorage = mutable_opaque

export enum IterationResource {
    None,
    IterationType,
    IterationItem,
    NativeLayout,
    NativeType,
    StateLayout,
    Invalid
}

export type IterationPublication = mutable_opaque

export type LoopStatePublication = opaque

export type LoopFramePublication = opaque

export type LoopFieldPublication = mutable_opaque

export type LoopAssignmentPublication = opaque

export enum LoopNameStorage {
    Borrow,
    Own,
    Reuse
}

export enum LoopStorage {
    Keep,
    Dereference,
    Deep,
    State,
    StateValue,
    Clip
}

export type LoopFieldRebuild = mutable_opaque

export type LoopResultFrame = opaque

export enum LoopResultWrap {
    Block,
    Layout,
    Pointer
}

export type IterationMutationFrame = mutable_opaque

export type TransformFrame = mutable_opaque

export enum IterationMutationMode {
    Push,
    Pop,
    Update
}

export enum IterationOperandSlot {
    Target,
    Index,
    Value
}

export type IterationProjectionFrame = mutable_opaque

export type IterationResultApplication = mutable_opaque

export type IterationProjectionStamp = {
    serial: u64,
    history_count: u64
}

export type SortFrame = mutable_opaque

export type SortWorkerFrame = mutable_opaque

export type SortComparator = {
    declaration: u32,
    io: bool,
    process: bool
}

export type SortWorkerFacts = {
    raw: u32[],
    elements: u32[],
    used: bool[],
    uses_allocator: bool,
    uses_io: bool,
    uses_process: bool,
    uses_environment: bool,
    references_start: u32,
    references_count: u32,
    left_start: u32,
    left_count: u32,
    right_start: u32,
    right_count: u32
}

export type TaskWorker = mutable_opaque

export type TaskWorkerUsage = {
    uses_allocator: bool,
    uses_io: bool,
    uses_process: bool,
    used: bool[],
    names: u8[][]
}

export type TaskParallelNames = {
    futures: u8[][],
    results: u8[][],
    values: u8[][]
}

export type ParallelRecords = mutable_opaque

export type ParallelRecord = {
    argument: u32,
    worker_type: u32,
    type_name: u8[],
    input_name: u8[],
    worker_name: u8[],
    thread_name: u8[],
    symbol?: u32
}
