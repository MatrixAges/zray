export type LoopFrame = mutable_opaque

export type IterationResourceFrame = mutable_opaque

export enum IterationResource {
    None,
    IterationType,
    IterationItem,
    NativeLayout,
    NativeType,
    StateLayout,
    Invalid
}

export type LoopConsumer = {
    symbol: u32,
    result: u32,
    layout: bool
}

export type LoopConsumption = {
    value: u32,
    spans: u64[],
    tail: u64
}

export type SortComparator = {
    declaration: u32,
    io: bool,
    process: bool
}

export type SortOperand = {
    value: u32,
    span: u64
}

export type WorkerState = {
    uses_allocator: bool,
    uses_io: bool,
    uses_process: bool,
    used: bool[],
    names: u8[][]
}

export type IterationTransferResult = {
    root: u32,
    cached: u32
}
