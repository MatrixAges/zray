    CheckShallow,
    CheckProjection,
    CheckInitial,
    Dereference,
    Reject,
    Plain,
    Stack,
    State,
    Deep,
    Buffered
}

export enum LoopAdmission {
    Proceed,
    Dereference,
    Reject
}

export enum LoopInitial {
    Reference,
    Value,
    Deep
}

