export declare function materializeType(
    frame: Lowering,
    id: u32,
    representation: StoredType
): u32 throws { OutOfMemory }

export declare function lowerLayout(frame: Lowering, id: u32): u32
    throws { OutOfMemory }

export declare function retainLoweringText(frame: Lowering, text: u8[]): u8[]
    throws { OutOfMemory }

export declare function materializeIterationResource(
    frame: IterationResourceFrame,
    id: u32,
    resource: IterationResource
): u32 throws { OutOfMemory }

export declare function cacheIterationType(
    frame: IterationResourceFrame,
    id: u32,
    value: u32
): void throws { OutOfMemory }

export declare function reserveIterationProjection(
    frame: IterationResourceFrame,
    fresh: u64
): IterationProjectionStamp throws { OutOfMemory }

export declare function projectIterationResult(
    frame: Lowering,
    context: IterationResourceFrame?,
    consumer: LoopConsumer,
    state: u32,
    id: u32
): u32 throws { OutOfMemory }

export declare function transferIterationResult(
    allocator,
    context: IterationResourceFrame,
    id: u32,
    value: u32
): IterationTransferResult throws { OutOfMemory }

export declare function constructValue(
    frame: Lowering,
    type_id: u32,
    value: u32,
    layout: u32?
): u32 throws { OutOfMemory }
