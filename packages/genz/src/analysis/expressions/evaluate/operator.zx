import integers from "std:integer"
import {
    appendAstLiteralRows,
    astExpressionCount
} from "ast_rows"
import host from "lowering_host"

import emitUnary from "../../operators/unary"
import binary from "./binary"

import type { AstWriter } from "ast_rows"
import type { Table } from "core/type_table/model"
import type { Lowering } from "lowering_host"
import type { Expressions } from "./model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    expressions: Expressions,
    types: Table,
    id: u32,
    binary: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, expressions, types, id } = in

    const payload = integers.widen(expressions.payloads[integers.widen(id)])

    if (in.binary) {
        return binary({
            frame,
            writer,
            expressions: expressions.pick([
                "kinds",
                "types"
            ]),
            types,
            operator: expressions.binary_operators[payload],
            left_ir: expressions.binary_left[payload],
            right_ir: expressions.binary_right[payload]
        })
    }

    const value = host.lowerExpression(
        frame,
        expressions.unary_operands[payload],
        false,
        null
    )

    const root = astExpressionCount(writer)

    const emitted = emitUnary({
        operator: expressions.unary_operators[payload],
        operand: value
    })

    appendAstLiteralRows(
        writer,
        {
            ...emitted,
            integer: [],
            float: [],
            string: [],
            boolean: [],
            enum_literal: [],
            error_value: [],
            builtin_name: []
        },
        []
    )

    return root
}
