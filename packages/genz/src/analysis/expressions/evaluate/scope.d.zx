export declare function consumeScopeResult(
    scope: ScopeFrame,
    symbol: u32,
    value: u32,
    layout: bool
): u32? throws { OutOfMemory }

export declare function reuseScopeBinding(scope: ScopeFrame, position: u64): u64
    throws { OutOfMemory }

export declare function emitScopeTask(frame: Lowering, symbol: u32?, value: u32): u64
    throws { OutOfMemory }

export declare function prepareScopeBinding(
    scope: ScopeFrame,
    symbol: u32?,
    value: u32,
    type_id: u32
): u32? throws { OutOfMemory }

export declare function discardScopeOperand(frame: Lowering, operand: u32): u32
    throws { OutOfMemory }

export declare function publishScopeBinding(
    scope: ScopeFrame,
    position: u64,
    symbol: u32?,
    value: u32,
    layout: bool
): u64 throws { OutOfMemory }

export declare function completeScopeBlock(
    frame: Lowering,
    span: u64,
    result: u32
): u32 throws { OutOfMemory }

export declare function completeIterationScope(
    scope: ScopeFrame,
    bindings: IterationScopeBindings,
    result: u32
): u32 throws { OutOfMemory }
