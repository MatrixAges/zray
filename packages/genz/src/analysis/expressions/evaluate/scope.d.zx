export declare function consumeScopeResult(
    scope: ScopeFrame,
    symbol: u32,
    value: u32,
    layout: bool
): u32? throws { OutOfMemory }

export declare function beginScopeBindings(scope: ScopeFrame, count: u64): void
    throws { OutOfMemory }

export declare function reuseScopeBinding(scope: ScopeFrame, position: u64): void
    throws { OutOfMemory }

export declare function emitScopeTask(scope: ScopeFrame, symbol: u32?, value: u32): void
    throws { OutOfMemory }

export declare function prepareScopeBinding(
    scope: ScopeFrame,
    symbol: u32?,
    value: u32,
    type_id: u32
): u32? throws { OutOfMemory }

export declare function discardScopeOperand(frame: Lowering, operand: u32): u32
    throws { OutOfMemory }

export declare function publishScopeBinding(
    scope: ScopeFrame,
    position: u64,
    symbol: u32?,
    value: u32,
    layout: bool
): void throws { OutOfMemory }

export declare function finishScopeBindings(scope: ScopeFrame, result: u32): u32
    throws { OutOfMemory }
