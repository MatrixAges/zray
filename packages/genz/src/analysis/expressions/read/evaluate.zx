import integers from "std:integer"
import host from "lowering_host"

import emitOptional from "./emit_optional"
import list from "./list"
import member from "./member"
import { ReadAction } from "./model"

import type { Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, state, expressions, row, action, iteration } = in

    const index = integers.widen(row)

    const type_id = expressions.types[index]

    if (action == ReadAction.Empty) {
        const result_type = host.lowerType(frame, type_id, true)

        return emitOptional({
            writer,
            type_expr: result_type,
            value: null
        })
    }

    const payload = integers.widen(expressions.payloads[index])

    switch (action) {
        case ReadAction.Wrap:
            const result_type = match {
                iteration => host.lowerType(frame, type_id, true),
                _ => in.result_type ?? host.invalidLowering()
            }

            const operand = expressions.some[payload]

            const value = host.lowerExpression(frame, operand, false, null)

            return emitOptional({
                writer,
                type_expr: result_type,
                value
            })
        case ReadAction.Unwrap:
            const operand = expressions.optional_values[payload]

            const value = host.lowerExpression(frame, operand, false, null)

            return emitOptional({
                writer,
                type_expr: null,
                value
            })
        case ReadAction.Reference: return host.readReference(
            frame,
            expressions.references[payload],
            type_id,
            iteration
        )
        case ReadAction.Field:
            return member({
                frame,
                row,
                action,
                iteration,
                operand: expressions.projection_targets[payload],
                index: expressions.projection_indices[payload]
            })
        case ReadAction.TupleField:
            return member({
                frame,
                row,
                action,
                iteration,
                operand: expressions.projection_targets[payload],
                index: expressions.projection_indices[payload]
            })
        case ReadAction.Index:
            const target = expressions.index_targets[payload]

            return list({
                frame,
                writer,
                state,
                action,
                iteration,
                type_id,
                target_type: expressions.types[integers.widen(target)],
                result_type: in.result_type,
                operand: target,
                detail: expressions.index_values[payload]
            })
        case ReadAction.Length: return list({
            frame,
            writer,
            state,
            action,
            iteration,
            type_id,
            target_type: null,
            result_type: in.result_type,
            operand: expressions.lengths[payload],
            detail: null
        })
        case ReadAction.Empty: return host.invalidLowering()
    }
}
