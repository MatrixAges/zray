import {
    appendExpressionRows, AstPayloadOwnership,
    astExpressionCount
} from "ast_rows"

import accessColumns from "../../../ast/rows/access_columns"
import field from "../../access/field"

import type { AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    target: u32,
    name: u8[]
}

export type Output = u32

export default function (in: Input): Output {
    const root = astExpressionCount(in.writer)

    const rows = field({
        target: in.target,
        name: in.name
    })

    const columns = accessColumns({
        rows: {
            ...rows,
            dereference: [],
            optional_unwrap: [],
            builtin_name: []
        },
        arguments: []
    })

    appendExpressionRows(
        in.writer,
        columns.rows,
        columns.forms,
        AstPayloadOwnership.Borrowed
    )

    return root
}
