import { ReadAction } from "lowering_host"

import {
    index_key_column,
    index_target_column,
    length_column,
    member_index_column,
    member_target_column,
    optional_column,
    some_column,
    symbol_column
} from "./const"

import type { Columns as Output } from "./model"

export type Input = ReadAction

export default function (in: Input): Output {
    const operand: string? = match in {
        ReadAction.Wrap => some_column,
        ReadAction.Unwrap => optional_column,
        ReadAction.Reference => symbol_column,
        ReadAction.Field => member_target_column,
        ReadAction.TupleField => member_target_column,
        ReadAction.Index => index_target_column,
        ReadAction.Length => length_column,
        _ => null
    }

    const index: string? = match in {
        ReadAction.Field => member_index_column,
        ReadAction.TupleField => member_index_column,
        ReadAction.Index => index_key_column,
        _ => null
    }

    return {
        operand,
        index
    }
}
