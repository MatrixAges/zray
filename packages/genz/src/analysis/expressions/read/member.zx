import host from "lowering_host"

import { ReadAction } from "./model"

import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    row: u32,
    action: ReadAction,
    iteration: bool,
    operand: u32,
    index: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, operand, index, row, iteration } = in

    if (in.action == ReadAction.TupleField) {
        const previous = host.readTupleResult(frame, operand, index)

        if (previous != null) {
            return previous
        }
    }

    if (iteration) {
        const source = host.lowerExpression(frame, operand, false, null)

        return host.readMember(frame, row, source, false, true)
    }

    const raw = host.readRawMember(frame, operand)

    if (raw != null) {
        return host.readMember(frame, row, raw, true, false)
    }

    const source = host.readAnchor(frame, operand)

    return host.readMember(frame, row, source, false, false)
}
