import type { Lowering, ReadAction } from "lowering_host"

export type Input = {
    frame: Lowering,
    row: u32,
    action: ReadAction,
    iteration: bool,
    type_id: u32,
    result_type?: u32,
    operand?: u32,
    detail?: u32
}

export type Columns = {
    operand?: string,
    index?: string
}
