import bytes from "std:bytes"
import integers from "std:integer"
import host from "lowering_host"

import { items_field } from "../../iteration/types/const"
import { Property } from "../../state/queries/model"
import query from "../../state/queries/read"
import emitField from "./emit_field"
import emitIndex from "./emit_index"
import emitLength from "./emit_length"
import { ReadAction } from "./model"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { StateQueries } from "./model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    state?: StateQueries,
    action: ReadAction,
    iteration: bool,
    type_id: u32,
    target_type?: u32,
    result_type?: u32,
    operand: u32,
    detail?: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, operand, iteration } = in

    if (in.action == ReadAction.Length) {
        const result_type = match {
            iteration => host.lowerType(frame, in.type_id, false),
            _ => in.result_type ?? host.invalidLowering()
        }

        if (iteration) {
            const value = host.lowerExpression(frame, operand, false, null)

            return emitLength({
                writer,
                source: value,
                type_expr: result_type,
                buffered: true
            })
        }

        const raw = host.readRawList(frame, operand)

        const value = raw ?? host.readList(frame, operand)

        return emitLength({
            writer,
            source: value,
            type_expr: result_type,
            buffered: false
        })
    }

    const key = in.detail ?? host.invalidLowering()

    if (iteration) {
        const target = host.lowerExpression(frame, operand, false, null)

        const items = emitField({
            writer,
            target,
            name: bytes.fromText(items_field)
        })

        const position = host.lowerExpression(frame, key, false, null)

        return emitIndex({
            frame,
            writer,
            values: items,
            position
        })
    }

    const raw = host.readRawList(frame, operand)

    const target = raw ?? host.readList(frame, operand)

    const position = host.lowerExpression(frame, key, false, null)

    const value = emitIndex({
        frame,
        writer,
        values: target,
        position
    })

    const state = in.state

    if (state == null || !state.active) {
        return value
    }

    if (!query({
        value: state.queries[integers.widen(in.type_id)],
        property: Property.Represented
    })) {
        return value
    }

    if (raw != null) {
        return host.readRepresentedValue(frame, in.type_id, value)
    }

    return host.readElement(frame, in.target_type ?? host.invalidLowering(), value)
}
