import host from "lowering_host"

import emitFieldPath from "./emit_field_path"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    value: u32,
    fields: u8[][],
    start: u64,
    end: u64,
    key: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, value, fields, start, end, key } = in

    const target = emitFieldPath({
        writer,
        target: value,
        fields,
        start,
        end
    })

    const index = host.lowerExpression(frame, key, false, null)

    return host.readIndex(frame, target, index)
}
