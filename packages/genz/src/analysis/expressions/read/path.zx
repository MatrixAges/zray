import host from "lowering_host"

import emitFieldPath from "./emit_field_path"
import segment from "./segment"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as PlanInput, Path } from "../../access/projection/model"

export type ProjectionInput = PlanInput & {
    frame: Lowering,
    writer: AstWriter
}

export type Input = Path & {
    frame: Lowering,
    writer: AstWriter
}

export type Output = u32?

export default function (in: Input): Output {
    const { frame, writer, anchor, fields, keys, starts, ends } = in

    if (anchor == null) {
        return null
    }

    const base = match {
        in.managed => host.readList(frame, anchor),
        _ => host.readAnchor(frame, anchor)
    }

    const root = match {
        in.first_key == null => base,
        _ => segment({
            frame,
            writer,
            value: base,
            fields,
            start: in.first_start,
            end: in.first_end,
            key: in.first_key
        })
    }

    const value = loop({
        node: root,
        position: keys.length
    }, {
        while: state => state.position != 0,
        next: state => {
            const position = state.position - 1

            state.node = segment({
                frame,
                writer,
                value: state.node,
                fields,
                start: starts[position],
                end: ends[position],
                key: keys[position]
            })
            state.position = position
        },
        return: state => state.node
    })

    return emitFieldPath({
        writer,
        target: value,
        fields,
        start: 0,
        end: in.prefix
    })
}
