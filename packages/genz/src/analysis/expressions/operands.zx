export enum Form {
    Single,
    Binary,
    Conditional,
    ValueConditional
}

export enum Step {
    First,
    Second,
    Third,
    SecondValue,
    ThirdValue,
    FirstType
}

export type Input = Form

export type Output = Step[]

export default function (in: Input): Output {
    return match in {
        Form.Single => [Step.First],
        Form.Binary => [
            Step.First,
            Step.Second,
            Step.FirstType
        ],
        Form.Conditional => [
            Step.First,
            Step.Second,
            Step.Third
        ],
        _ => [
            Step.First,
            Step.SecondValue,
            Step.ThirdValue
        ]
    }
}
