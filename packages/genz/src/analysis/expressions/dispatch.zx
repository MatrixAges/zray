import { ExpressionKind } from "core/expression_table/kinds"

export enum Action {
    Literal,
    Wrap,
    Unwrap,
    Capture,
    Task,
    Wait,
    Cancel,
    Parallel,
    Reference,
    Store,
    Field,
    TupleField,
    Index,
    Length,
    Sequence,
    Collection,
    Transform,
    Scope,
    Iteration,
    Update,
    Call,
    Unary,
    Binary,
    Conditional,
    Match,
    Object,
    Empty,
    Invalid
}

export type Input = ExpressionKind

export type Output = Action

export default function (in: Input): Output {
    return match in {
        ExpressionKind.Integer => Action.Literal,
        ExpressionKind.NegativeInteger => Action.Literal,
        ExpressionKind.Float => Action.Literal,
        ExpressionKind.String => Action.Literal,
        ExpressionKind.Boolean => Action.Literal,
        ExpressionKind.None => Action.Literal,
        ExpressionKind.Unit => Action.Literal,
        ExpressionKind.EnumValue => Action.Literal,
        ExpressionKind.ErrorValue => Action.Literal,
        ExpressionKind.Some => Action.Wrap,
        ExpressionKind.OptionalValue => Action.Unwrap,
        ExpressionKind.Capture => Action.Capture,
        ExpressionKind.Task => Action.Task,
        ExpressionKind.AwaitTask => Action.Wait,
        ExpressionKind.CancelTask => Action.Cancel,
        ExpressionKind.Parallel => Action.Parallel,
        ExpressionKind.Reference => Action.Reference,
        ExpressionKind.StoreGet => Action.Store,
        ExpressionKind.Field => Action.Field,
        ExpressionKind.TupleField => Action.TupleField,
        ExpressionKind.Index => Action.Index,
        ExpressionKind.Length => Action.Length,
        ExpressionKind.List => Action.Sequence,
        ExpressionKind.Tuple => Action.Sequence,
        ExpressionKind.Template => Action.Sequence,
        ExpressionKind.ListOperation => Action.Collection,
        ExpressionKind.Transform => Action.Transform,
        ExpressionKind.Scope => Action.Scope,
        ExpressionKind.Iteration => Action.Iteration,
        ExpressionKind.ListUpdate => Action.Update,
        ExpressionKind.Call => Action.Call,
        ExpressionKind.Unary => Action.Unary,
        ExpressionKind.Binary => Action.Binary,
        ExpressionKind.Conditional => Action.Conditional,
        ExpressionKind.Match => Action.Match,
        ExpressionKind.Object => Action.Object,
        _ => Action.Invalid
    }
}
