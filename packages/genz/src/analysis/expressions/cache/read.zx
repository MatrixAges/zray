import read from "core/integer/map/read"

import count from "./count"

import type { Key } from "core/integer/map/model"
import type { Input as Count } from "./count"

export type Input = Key & Count

export type Output = {
    value?: u32,
    reads?: u64
}

export default function (in: Input): Output {
    const value = read(in.omit(["reads"]))

    if (value != null) {
        return {
            value,
            reads: count(in.omit(["state"]))
        }
    }

    return {
        value: null,
        reads: null
    }
}
