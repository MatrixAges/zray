import host from "lowering_host"

import type { Lowering, MatchFrame } from "lowering_host"

export type Input = {
    frame: Lowering,
    selection: MatchFrame,
    subject?: u32,
    discard: bool,
    fallback: u32,
    value: bool,
    has_arms: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, selection, subject } = in

    if (subject != null) {
        const value = host.lowerExpression(frame, subject, false, null)

        host.publishMatchSubject(selection, value, in.discard)
    }

    const fallback = match {
        in.value => host.lowerValueExpression(frame, in.fallback),
        _ => host.lowerExpression(frame, in.fallback, false, null)
    }

    const result = match {
        in.has_arms => host.lowerMatchArms(selection, fallback),
        _ => fallback
    }

    return match {
        subject != null => host.finishMatchResult(selection, result),
        _ => result
    }
}
