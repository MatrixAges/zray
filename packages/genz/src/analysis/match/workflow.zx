import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { ColumnLengths } from "memory"
import type { BinaryExpressions } from "../expressions/evaluate/model"
import type { Input as PlanInput } from "./model"

export type Input = PlanInput.Omit("result") & {
    frame: Lowering,
    writer: AstWriter,
    binary_expressions: BinaryExpressions,
    body: AstSequence,
    fallback: u32,
    layout: bool,
    positions: ColumnLengths
}

export type Fallback = Input.Pick("frame", "fallback", "layout")

export { appendAstBindingRows } from "ast_rows"
export { cacheLoweredOperand, lowerExpression } from "lowering_host"
export { requireAllocation } from "memory"
