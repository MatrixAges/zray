import { BinaryOperator } from "core/expression_table/kinds"
import host from "lowering_host"

import binary from "../expressions/evaluate/binary"
import { Operation } from "./model"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Table } from "core/type_table/model"
import type { Lowering } from "lowering_host"
import type { BinaryExpressions } from "../expressions/evaluate/model"
import type { Plan } from "./model"

export type Input = Plan.Pick("operations", "first", "second") & {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    binary_expressions: BinaryExpressions,
    types: Table
}

export type Output = u32[]

export default function (in: Input): Output {
    const {
        frame,
        writer,
        origin,
        binary_expressions,
        types,
        operations,
        first,
        second
    } = in

    const empty: u32[] = []

    return loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < operations.length,
        next: state => {
            const index = state.index
            const item = first[index]

            const value = match operations[index] {
                Operation.Expression => host.lowerExpression(frame, item, false, null),
                Operation.Value => host.lowerValueExpression(frame, item),
                Operation.Equality => binary({
                    frame,
                    writer,
                    origin,
                    expressions: binary_expressions,
                    types,
                    operator: BinaryOperator.Equal,
                    left_ir: item,
                    right_ir: second[index]
                }),
                _ => host.lowerRegular(frame, item, true, null)
            }

            state.values = state.values.push(value)[0]
            state.index = index + 1
        },
        return: state => state.values
    })
}
