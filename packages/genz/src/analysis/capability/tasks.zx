import memory from "memory"

import expressions from "../calls/expressions"
import flags from "../facts/flags"

import type { Allocator } from "memory"
import type { Functions } from "../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { functions, allocator } = in

    const required = flags({
        count: functions.output_types.length,
        allocator
    })

    const processed = loop({
        functions,
        index: 0
    }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const index = current.index

            const depends = !expressions({
                expressions: current.functions.expressions[index],
                allowed: required.values,
                expected: false,
                self_function: index,
                limit: index,
                tasks: true
            })

            memory.writeBool(required.buffer, index, depends)
            current.index += 1
        }
    })

    return required.values
}
