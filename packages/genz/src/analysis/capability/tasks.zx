import expressions from "../calls/expressions"

import type { Allocator } from "memory"
import type { Functions } from "../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const required: bool[] = []

    return loop({
        functions: in.functions,
        required,
        index: 0
    }, {
        while: current => current.index < current.functions.output_types.length,
        next: current => {
            const index = current.index

            const depends = !expressions({
                expressions: current.functions.expressions[index],
                allowed: current.required,
                expected: false,
                self_function: index,
                limit: index,
                tasks: true
            })

            current.required = current.required.push(depends)[0]
            current.index += 1
        },
        return: current => current.required
    })
}
