import memory from "memory"

import flags from "../../facts/flags"
import body from "./body"

import type { Allocator } from "memory"
import type { Functions } from "../../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { functions, allocator } = in

    const grows = flags({
        count: functions.output_types.length,
        allocator
    })

    const processed = loop({
        index: 0
    }, {
        while: state => state.index < functions.output_types.length,
        next: state => {
            const index = state.index
            const unknown = functions.native_modules[index] != null ||
                functions.roots[index] == null

            const may_grow = unknown || body({
                expressions: functions.expressions[index],
                grows: grows.values,
                limit: index
            })

            memory.writeBool(grows.buffer, index, may_grow)
            state.index += 1
        }
    })

    return grows.values
}
