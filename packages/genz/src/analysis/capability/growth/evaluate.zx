import body from "./body"

import type { Allocator } from "memory"
import type { Functions } from "../../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { functions } = in

    const grows: bool[] = []

    return loop({
        grows,
        index: 0
    }, {
        while: state => state.index < functions.output_types.length,
        next: state => {
            const index = state.index
            const unknown = functions.native_modules[index] != null ||
                functions.roots[index] == null

            const may_grow = unknown || body({
                expressions: functions.expressions[index],
                grows: state.grows,
                limit: index
            })

            state.grows = state.grows.push(may_grow)[0]
            state.index += 1
        },
        return: state => state.grows
    })
}
