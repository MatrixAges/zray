<Module>
    <Type from="model" as="Sort" />
    <Type from="../rows" as="AST" />

    <Args in={Sort.Execute} out={Sort.Result} />

    <Call fn="../rows.readAstOrigin" in={$in.writer} />
    <Call fn="../rows.astFieldCount" in={$in.writer} />

    <Call
        module="build"
        in={{
            ...$in.omit([
                "writer",
                "lower",
                "body"
            ]),
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="../rows.requireAllocation" in={$ctx.build.valid} />

    <Call
        fn="../rows.retainLoweringText"
        in={[
            $in.lower,
            $ctx.build.name
        ]}
    />

    <Call
        fn="../rows.astColumnCount"
        in={[
            $in.writer,
            AST.AstColumn.Identifiers
        ]}
    />

    <Call
        fn="../rows.appendExtendedExpressions"
        in={[
            $in.writer,
            $ctx.build.expressions,
            $ctx.build.forms,
            $ctx.build.extra
        ]}
    />

    <Call
        fn="../rows.replaceAstIdentifier"
        in={[
            $in.writer,
            $ctx.astColumnCount + $ctx.build.name_slot,
            $ctx.retainLoweringText
        ]}
    />

    <Call
        fn="../rows.appendAstFields"
        in={[
            $in.writer,
            $ctx.build.fields
        ]}
    />

    <Call
        fn="../rows.appendStatementSequence"
        in={[
            $in.writer,
            $in.body,
            $ctx.build.statements,
            {
                ...$ctx.build.variables,
                variable_name: [$ctx.retainLoweringText]
            },
            Sort.AstSequenceMode.BorrowingText
        ]}
    />

    <Call
        fn="../rows.finishGeneratedAst"
        in={[
            $in.lower,
            $ctx.build.serial,
            false
        ]}
    />

    <Return
        value={{
            root: $ctx.build.root,
            headered: $ctx.build.headered
        }}
    />
</Module>
