<Module>
    <Type from="model" as="Sorting" />

    <Args in={Sorting.Input} out={Sorting.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="errors" />
    <Call fn="failure" />
    <Call fn="values" />
    <Call fn="context" />
    <Call fn="invoke" />
    <Call fn="headered" />
    <Call fn="finish" />

    <Return value={$ctx.finish} />
</Module>
