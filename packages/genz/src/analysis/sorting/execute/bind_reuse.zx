import bindOperand from "../../aggregate/execute/bind_operand"
import emitFlag from "../../collections/workflow/emit_flag"
import { Operation } from "../../state/list/const"
import emitPermission from "../../state/list/emit_permission"

import type { Reuse as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { lower, writer, origin, body, target, selected, reusable } = in

    const reads_header = (
        - selected
        - and !reusable
    )

    const value = match {
        reads_header => emitPermission({
            writer,
            value: target,
            operation: Operation.Writable
        }),
        _ => emitFlag({
            writer,
            value: reusable
        })
    }

    return bindOperand({
        frame: lower,
        writer,
        origin,
        sequence: body,
        value
    })
}
