import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"
import emitFlag from "../../collections/workflow/emit_flag"

import type { Reuse as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, lower, writer, origin, body, target, selected, reusable } = in

    const reads_header = (
        - selected
        - and !reusable
    )

    const value = match {
        reads_header => host.sortWritable(frame, target),
        _ => emitFlag({
            writer,
            value: reusable
        })
    }

    return bindOperand({
        frame: lower,
        writer,
        origin,
        sequence: body,
        value
    })
}
