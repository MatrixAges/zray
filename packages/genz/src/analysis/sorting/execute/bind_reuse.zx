import host from "lowering_host"

import type { Target as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, target, selected } = in

    const reusable = host.sortInputReusable(frame)

    const reads_header = (
        - selected
        - and !reusable
    )

    if (reads_header) {
        const writable = host.sortWritable(frame, target)

        return host.bindSortValue(frame, writable)
    }

    const reuse = host.sortReuseFlag(frame, reusable)

    return host.bindSortValue(frame, reuse)
}
