import { Operation } from "../../state/list/const"
import emitPermission from "../../state/list/emit_permission"

import type { Header as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { writer, target, selected } = in

    if (!selected) {
        return 0
    }

    return emitPermission({
        writer,
        value: target,
        operation: Operation.Headered
    })
}
