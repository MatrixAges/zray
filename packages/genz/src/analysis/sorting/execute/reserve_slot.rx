<Module>
    <Type from="../rows" as="AST" />
    <Type from="model" as="Sort" />

    <Args in={Sort.Reservation} out={u8[]} />

    <Call fn="../rows.astExpressionCount" in={$in.writer} />

    <Call
        fn="../reserve"
        in={{
            index: $in.slot,
            expression_base: $ctx.astExpressionCount
        }}
    />

    <Call fn="../rows.requireAllocation" in={$ctx.reserve.valid} />

    <Call
        fn="../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.reserve.expressions,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../rows.appendAuxiliaryRow"
        in={[
            $in.writer,
            $ctx.reserve.declarations.omit(["tags"])
        ]}
    />

    <Return value={$ctx.appendAuxiliaryRow} />
</Module>
