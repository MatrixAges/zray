import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"

import type { Environment as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { lower, writer, origin, body, environment } = in

    const value = host.lowerExpression(lower, environment, false, null)

    return bindOperand({
        frame: lower,
        writer,
        origin,
        sequence: body,
        value
    })
}
