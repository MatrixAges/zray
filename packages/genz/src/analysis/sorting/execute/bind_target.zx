import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"

import type { Target as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, lower, writer, origin, body, target, selected } = in

    const raw = host.lowerExpression(lower, target, false, null)
    const qualified = selected ? host.clipSortTarget(frame, raw) : raw

    return bindOperand({
        frame: lower,
        writer,
        origin,
        sequence: body,
        value: qualified
    })
}
