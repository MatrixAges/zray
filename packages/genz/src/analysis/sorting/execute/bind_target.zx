import { clipCollectionTarget } from "ast_rows"
import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"

import type { Target as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { lower, writer, body, target, selected } = in

    const raw = host.lowerExpression(lower, target, false, null)
    const qualified = selected ? clipCollectionTarget(writer, body, target, raw) : raw

    return bindOperand({
        frame: lower,
        writer,
        sequence: body,
        value: qualified
    })
}
