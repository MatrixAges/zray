<Module>
    <Type from="model" as="Sort" />

    <Args in={Sort.Input} out={Sort.Output} />

    <Call fn="../rows.auxiliaryDeclarationCount" in={$in.writer} />

    <Call
        module="reserve_slot"
        in={{
            writer: $in.writer,
            slot: $ctx.auxiliaryDeclarationCount
        }}
    />

    <Call
        fn="index.materializeElementType"
        in={[
            $in.lower,
            $in.list_type
        ]}
    />

    <Call
        fn="index.buildSortComparator"
        in={[
            $in.lower,
            $in.id,
            $ctx.materializeElementType,
            $in.errors
        ]}
    />

    <Call
        module="../functions/publish"
        in={{
            writer: $in.writer,
            child: $ctx.materializeElementType,
            errors: $in.errors
        }}
    />

    <Call
        module="publish_slot"
        in={{
            writer: $in.writer,
            slot: $ctx.auxiliaryDeclarationCount,
            name: $ctx.reserve_slot,
            comparator: $ctx.buildSortComparator.declaration,
            ordering: $ctx.publish.ordering,
            sort: $ctx.publish.sort
        }}
    />

    <Call
        fn="index.publishTaskEffects"
        in={[
            $in.lower,
            true,
            $ctx.buildSortComparator.io,
            $ctx.buildSortComparator.process
        ]}
    />

    <Call
        fn="bind_target"
        in={$in.pick([
            "lower",
            "writer",
            "body",
            "target",
            "selected"
        ])}
    />

    <Call
        fn="index.readListItems"
        in={[
            $in.lower,
            $in.target,
            $ctx.bind_target
        ]}
    />

    <Call
        fn="bind_reuse"
        in={{
            ...$in.pick([
                "lower",
                "writer",
                "body",
                "selected",
                "reusable"
            ]),
            target: $ctx.bind_target
        }}
    />

    <Call
        fn="bind_environment"
        in={$in.pick([
            "lower",
            "writer",
            "body",
            "environment"
        ])}
    />

    <Call
        fn="read_header"
        in={{
            writer: $in.writer,
            target: $ctx.bind_target,
            selected: $in.selected
        }}
    />

    <Call
        module="../expression/execute"
        in={{
            writer: $in.writer,
            lower: $in.lower,
            body: $in.body,
            name: $ctx.reserve_slot,
            source: $ctx.readListItems,
            reuse: $ctx.bind_reuse,
            environment: $ctx.bind_environment,
            errors: $in.errors,
            io: $ctx.buildSortComparator.io,
            process: $ctx.buildSortComparator.process,
            selected: $in.selected,
            headered: $ctx.read_header
        }}
    />

    <Call
        fn="../../state/list/emit_owned"
        in={{
            lower: $in.lower,
            writer: $in.writer,
            type_id: $in.list_type,
            selected: $in.selected,
            value: $ctx.execute.root,
            header: $ctx.execute.headered,
            known_header: null
        }}
    />

    <Call
        fn="../../aggregate/execute/finish_block"
        in={{
            frame: $in.lower,
            writer: $in.writer,
            sequence: $in.body,
            value: $ctx.emit_owned
        }}
    />

    <Return value={$ctx.finish_block} />
</Module>
