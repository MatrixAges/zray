<Module>
    <Type from="model" as="Sort" />

    <Args in={Sort.Input} out={Sort.Output} />

    <Call fn="../rows.auxiliaryDeclarationCount" in={$in.writer} />

    <Call
        module="reserve_slot"
        in={{
            writer: $in.writer,
            slot: $ctx.auxiliaryDeclarationCount
        }}
    />

    <Call fn="../rows.releasePreparation" in={$in.scratch} />
    <Call fn="index.sortElementType" in={$in.frame} />

    <Call
        fn="index.buildSortComparator"
        in={[
            $in.frame,
            $ctx.sortElementType,
            $in.errors
        ]}
    />

    <Call
        module="../functions/publish"
        in={{
            writer: $in.writer,
            origin: $in.origin,
            child: $ctx.sortElementType,
            errors: $in.errors
        }}
    />

    <Call
        module="publish_slot"
        in={{
            writer: $in.writer,
            slot: $ctx.auxiliaryDeclarationCount,
            name: $ctx.reserve_slot,
            comparator: $ctx.buildSortComparator.declaration,
            ordering: $ctx.publish.ordering,
            sort: $ctx.publish.sort
        }}
    />

    <Call fn="../rows.releaseDeclarations" in={$in.scratch} />

    <Call
        fn="index.publishSortEffects"
        in={[
            $in.frame,
            $ctx.buildSortComparator
        ]}
    />

    <Call
        fn="bind_target"
        in={$in.pick([
            "frame",
            "lower",
            "writer",
            "origin",
            "body",
            "target",
            "selected"
        ])}
    />

    <Call
        fn="index.readSortItems"
        in={[
            $in.frame,
            $ctx.bind_target
        ]}
    />

    <Call
        fn="bind_reuse"
        in={{
            ...$in.pick([
                "frame",
                "lower",
                "writer",
                "origin",
                "body",
                "selected",
                "reusable"
            ]),
            target: $ctx.bind_target
        }}
    />

    <Call
        fn="bind_environment"
        in={$in.pick([
            "lower",
            "writer",
            "origin",
            "body",
            "environment"
        ])}
    />

    <Call
        fn="read_header"
        in={{
            frame: $in.frame,
            target: $ctx.bind_target,
            selected: $in.selected
        }}
    />

    <Call
        module="../expression/execute"
        in={{
            writer: $in.writer,
            lower: $in.lower,
            origin: $in.origin,
            body: $in.body,
            name: $ctx.reserve_slot,
            source: $ctx.readSortItems,
            reuse: $ctx.bind_reuse,
            environment: $ctx.bind_environment,
            errors: $in.errors,
            io: $ctx.buildSortComparator.io,
            process: $ctx.buildSortComparator.process,
            selected: $in.selected,
            headered: $ctx.read_header
        }}
    />

    <Call
        fn="index.finishSortResult"
        in={[
            $in.frame,
            $ctx.execute.root,
            $ctx.execute.headered
        ]}
    />

    <Return value={$ctx.finishSortResult} />
</Module>
