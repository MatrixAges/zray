import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Lowering, SortFrame } from "lowering_host"

export type Input = {
    frame: SortFrame,
    writer: AstWriter,
    lower: Lowering,
    body: AstSequence,
    origin: AstOriginBuffer,
    target: u32,
    environment: u32,
    list_type: u32,
    selected: bool,
    reusable: bool,
    errors?: u8[][]
}

export type Output = u32

export type Target = {
    frame: SortFrame,
    lower: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body: AstSequence,
    target: u32,
    selected: bool
}

export type Reuse = Input.Pick(
    "lower",
    "writer",
    "origin",
    "body",
    "target",
    "selected",
    "reusable"
)

export type Environment = Input.Pick("lower", "writer", "origin", "body", "environment")

export type Header = {
    writer: AstWriter,
    target: u32,
    selected: bool
}

export type Reservation = {
    writer: AstWriter,
    slot: u64
}

export type Declaration = Reservation & {
    name: u8[],
    comparator: u32,
    ordering: u32,
    sort: u32
}
