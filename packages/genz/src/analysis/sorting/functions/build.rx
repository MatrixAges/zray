<Module>
    <Type from="model" as="Sorting" />

    <Args in={Sorting.Input} out={Sorting.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="less/guard" />
    <Call fn="less/compare" />
    <Call fn="less/less" />
    <Call fn="less/ordering" />
    <Call fn="sort/storage" />
    <Call fn="sort/cleanup" />
    <Call fn="sort/execute" />
    <Call fn="sort/return_type" />
    <Call fn="sort/sort" />
    <Call fn="finish" />

    <Return value={$ctx.finish} />
</Module>
