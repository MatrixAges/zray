import type { AstOriginBuffer, AstWriter, ExpressionExtensions as Extra } from "ast_rows"
import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Functions } from "../../../ast/declarations/function"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { Columns as Statements } from "../../../ast/statements/model"

export type Input = {
    child: u32,
    errors?: u8[][],
    bases: Bases,
    declaration_base: u32
}

export type State = {
    source: Input,
    context: Context,
    extra: Extra,
    fields: Fields,
    declarations: Functions,
    context_id: u32,
    failure_id: u32,
    false_id: u32,
    guard_id: u32,
    guard_start: u32,
    comparison_id: u32,
    error_start: u32,
    body_start: u32,
    items_id: u32,
    reuse_id: u32,
    ordering: u32,
    sort: u32
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    extra: Extra,
    statements: Statements,
    fields: Fields,
    declarations: Functions,
    ordering: u32,
    sort: u32,
    valid: bool
}

export type ExecuteInput = Input.Pick("child", "errors") & {
    writer: AstWriter,
    origin: AstOriginBuffer
}

export type ExecuteOutput = Output.Pick("ordering", "sort")
