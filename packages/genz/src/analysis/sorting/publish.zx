import integers from "std:integer"

import constants from "../../ast/declarations/constants"
import empty from "../../ast/expressions/empty"
import extensions from "../../ast/expressions/empty_extensions"
import namespace from "../../ast/expressions/namespace"
import { word_radix } from "../node_headers/block/const"

import type { ExpressionExtensions, ExpressionRows } from "ast_rows"
import type { Columns as Declarations } from "../../ast/declarations/model"

export type Input = {
    name: u8[],
    expression_base: u32,
    declarations: u64
}

export type Output = {
    expressions: ExpressionRows,
    extensions: ExpressionExtensions,
    declarations: Declarations,
    valid: bool
}

export default function (in: Input): Output {
    const value = namespace({
        table: {
            tags: [],
            offsets: [],
            namespace_type_start: [],
            namespace_type_len: []
        },
        base: in.expression_base,
        start: integers.narrow(in.declarations / word_radix),
        count: integers.narrow(in.declarations % word_radix)
    })

    const declarations = constants({
        base: 0,
        values: [{
            name: in.name,
            type_expr: null,
            value: value.id,
            exported: false
        }]
    })

    return {
        expressions: {
            ...empty({}),
            tags: value.table.tags,
            offsets: value.table.offsets
        },
        extensions: {
            ...extensions({}),
            namespace_type_start: value.table.namespace_type_start,
            namespace_type_len: value.table.namespace_type_len
        },
        declarations: declarations.table,
        valid: value.valid && declarations.valid
    }
}
