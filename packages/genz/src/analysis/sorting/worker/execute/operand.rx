<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.OperandCursor} out={Flow.OperandCursor} />

    <If on={$in.operand_used[$in.row]}>
        <Call
            fn="index.readSortOperand"
            in={[
                $in.worker,
                $in.list_type,
                $in.raw[$in.row]
            ]}
        />

        <Call
            fn="advance_operand"
            in={{
                cursor: $in,
                operand: $ctx.readSortOperand
            }}
        />

        <Return value={$ctx.advance_operand} />
    </If>

    <Call
        fn="advance_operand"
        in={{
            cursor: $in,
            operand: null
        }}
    />

    <Return value={$ctx.advance_operand} />
</Module>
