<Module>
    <Type from="model" as="Worker" />
    <Type from="../../rows" as="AST" />

    <Args in={Worker.Input} out={Worker.Output} />

    <Call fn="../../rows.astExpressionCount" in={$in.writer} />

    <Call
        fn="../prepare"
        in={{
            base: $ctx.astExpressionCount
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.prepare.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.prepare.expressions,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="index.bindSortWorkerNames"
        in={[
            $in.frame,
            [
                $ctx.prepare.left_name,
                $ctx.prepare.right_name,
                $ctx.prepare.environment_name
            ]
        ]}
    />

    <Call fn="index.registerSortParameters" in={$in.frame} />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.worker,
            $in.body_expr,
            false,
            null
        ]}
    />

    <Call fn="prepare_operands" in={{}} />

    <Loop on={$in.running}>
        <Call
            module="operand"
            in={{
                frame: $in.frame,
                raw: [
                    $ctx.prepare.left,
                    $ctx.prepare.right
                ],
                count: $ctx.prepare_operands,
                row: 0,
                running: $ctx.prepare_operands != 0
            }}
        />
    </Loop>

    <Call
        fn="index.lowerType"
        in={[
            $in.lower,
            $in.output_type,
            false
        ]}
    />

    <Call fn="index.finishSortWorker" in={$in.frame} />

    <Call
        fn="../../rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call fn="../../rows.astFieldCount" in={$in.writer} />
    <Call fn="../../rows.astDeclarationCount" in={$in.writer} />

    <Call
        module="../build"
        in={{
            child: $in.child,
            errors: $in.errors,
            output_type: $ctx.lowerType,
            value: $ctx.lowerExpression,
            raw: $ctx.operand.raw,
            elements: $ctx.finishSortWorker.elements,
            used: $ctx.finishSortWorker.used,
            uses_allocator: $ctx.finishSortWorker.uses_allocator,
            uses_io: $ctx.finishSortWorker.uses_io,
            uses_process: $ctx.finishSortWorker.uses_process,
            uses_environment: $ctx.finishSortWorker.uses_environment,
            references: {
                start: $ctx.finishSortWorker.references_start,
                count: $ctx.finishSortWorker.references_count
            },
            left: {
                start: $ctx.finishSortWorker.left_start,
                count: $ctx.finishSortWorker.left_count
            },
            right: {
                start: $ctx.finishSortWorker.right_start,
                count: $ctx.finishSortWorker.right_count
            },
            bases: {
                ...$ctx.readAstOrigin,
                capture: null,
                field_base: $ctx.astFieldCount
            },
            declaration_base: $ctx.astDeclarationCount
        }}
    />

    <Call
        module="publish"
        in={{
            writer: $in.writer,
            fragment: $ctx.build
        }}
    />

    <Return value={$ctx.astDeclarationCount} />
</Module>
