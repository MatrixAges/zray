<Module>
    <Type from="model" as="Worker" />
    <Type from="../../rows" as="AST" />

    <Args in={Worker.Input} out={Worker.Output} />

    <Call fn="../../rows.astExpressionCount" in={$in.writer} />

    <Call
        fn="../prepare"
        in={{
            base: $ctx.astExpressionCount
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.prepare.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.prepare.expressions,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="index.bindSortWorkerNames"
        in={[
            $in.lower,
            $in.parameters,
            [
                $ctx.prepare.left_name,
                $ctx.prepare.right_name,
                $ctx.prepare.environment_name
            ]
        ]}
    />

    <Call
        fn="index.registerSortParameters"
        in={[
            $in.worker,
            $in.parameters
        ]}
    />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.worker,
            $in.body_expr,
            false,
            null
        ]}
    />

    <Call fn="index.readWorkerState" in={$in.worker} />

    <Call
        fn="prepare_operands"
        in={{
            worker: $in.worker,
            parameters: $in.parameters,
            list_type: $in.list_type,
            used_symbols: $ctx.readWorkerState.used,
            left: $ctx.prepare.left,
            right: $ctx.prepare.right
        }}
    />

    <Loop on={$in.running}>
        <Call module="operand" />
    </Loop>

    <Call
        fn="index.lowerType"
        in={[
            $in.lower,
            $in.output_type,
            false
        ]}
    />

    <Call fn="index.effects" in={$in.worker} />

    <Call
        fn="uses_environment"
        in={{
            parameters: $in.parameters,
            used: $ctx.effects.used
        }}
    />

    <Call fn="index.readWorkerReferenceBody" in={$in.worker} />

    <Call fn="index.reference" />

    <Call fn="index.leftOperandSpan" in={$ctx.operand.spans[0]} />
    <Call fn="index.rightOperandSpan" in={$ctx.operand.spans[1]} />
    <Call fn="../../rows.readAstOrigin" in={$in.writer} />
    <Call fn="../../rows.astFieldCount" in={$in.writer} />
    <Call fn="../../rows.astDeclarationCount" in={$in.writer} />

    <Call
        module="../build"
        in={{
            child: $in.child,
            errors: $in.errors,
            output_type: $ctx.lowerType,
            value: $ctx.lowerExpression,
            raw: $ctx.operand.raw,
            elements: $ctx.operand.elements,
            used: $ctx.operand.used,
            uses_allocator: $ctx.effects.uses_allocator,
            uses_io: $ctx.effects.uses_io,
            uses_process: $ctx.effects.uses_process,
            uses_environment: $ctx.uses_environment,
            references: $ctx.reference,
            left: $ctx.leftOperandSpan,
            right: $ctx.rightOperandSpan,
            bases: {
                ...$ctx.readAstOrigin,
                capture: null,
                field_base: $ctx.astFieldCount
            },
            declaration_base: $ctx.astDeclarationCount
        }}
    />

    <Call
        module="publish"
        in={{
            writer: $in.writer,
            fragment: $ctx.build
        }}
    />

    <Return value={$ctx.astDeclarationCount} />
</Module>
