import type { AstOriginBuffer, AstScratch, AstWriter } from "ast_rows"
import type { SortWorkerFrame } from "lowering_host"
import type { Input as WorkerInput, Output as WorkerOutput } from "../model"

export type Input = WorkerInput.Pick("child", "errors") & {
    frame: SortWorkerFrame,
    writer: AstWriter,
    scratch: AstScratch,
    origin: AstOriginBuffer
}

export type Output = u32

export type Publication = {
    writer: AstWriter,
    fragment: WorkerOutput
}
