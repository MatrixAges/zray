import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as WorkerInput, Output as WorkerOutput } from "../model"

export type Input = WorkerInput.Pick("child", "errors") & {
    writer: AstWriter,
    lower: Lowering,
    worker: Lowering,
    parameters: u32[],
    list_type: u32,
    body_expr: u32,
    output_type: u32
}

export type Output = u32

export type Publication = {
    writer: AstWriter,
    fragment: WorkerOutput
}

export type OperandCursor = {
    worker: Lowering,
    list_type: u32,
    operand_used: bool[],
    elements: u32[],
    used: bool[],
    spans: u64[],
    raw: u32[],
    count: u64,
    row: u64,
    running: bool
}
