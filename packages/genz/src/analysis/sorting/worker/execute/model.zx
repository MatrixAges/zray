import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering, SortWorkerFrame } from "lowering_host"
import type { Input as WorkerInput, Output as WorkerOutput } from "../model"

export type Input = WorkerInput.Pick("child", "errors") & {
    frame: SortWorkerFrame,
    writer: AstWriter,
    lower: Lowering,
    worker: Lowering,
    origin: AstOriginBuffer,
    body_expr: u32,
    output_type: u32
}

export type Output = u32

export type Publication = {
    writer: AstWriter,
    fragment: WorkerOutput
}

export type OperandCursor = Input.Pick("frame") & {
    raw: u32[],
    count: u64,
    row: u64,
    running: bool
}
