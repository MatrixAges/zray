import type { ExpressionExtensions as Extra } from "ast_rows"
import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Functions } from "../../../ast/declarations/function"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { Columns as Statements } from "../../../ast/statements/model"

export type Block = {
    start: u32,
    count: u32
}

export type Body = {
    starts: u32[],
    counts: u32[],
    count: u32
}

export type Input = {
    child: u32,
    output_type: u32,
    errors?: u8[][],
    value: u32,
    raw: u32[],
    elements: u32[],
    used: bool[],
    uses_allocator: bool,
    uses_io: bool,
    uses_process: bool,
    uses_environment: bool,
    references: Block,
    left: Block,
    right: Block,
    bases: Bases,
    declaration_base: u32
}

export type State = {
    source: Input,
    context: Context,
    discard: u32[],
    bindings: Statements,
    prefix: Statements,
    extra: Extra,
    fields: Fields
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    extra: Extra,
    prefix: Statements,
    bindings: Statements,
    ending: Statements,
    body: Body,
    fields: Fields,
    declarations: Functions,
    valid: bool
}
