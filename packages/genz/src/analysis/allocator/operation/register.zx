import bytes from "std:bytes"

import identifier from "../../../ast/context/identifier"
import spec from "./spec"

import type { State as Output } from "../model"
import type { Input } from "./model"

export default function (in: Input): Output {
    const state = in.state
    const name = bytes.fromText(spec(in.kind).name)

    const value = identifier({
        state: state.context,
        name
    })

    return {
        ...state,
        context: value.state,
        vtable_names: state.vtable_names.push(name)[0],
        vtable_values: state.vtable_values.push(value.id)[0]
    }
}
