import bytes from "std:bytes"
import integers from "std:integer"

import call from "../../../../ast/context/call"
import identifier from "../../../../ast/context/identifier"
import result from "../../../../ast/context/result"
import functionDeclaration from "../../../../ast/declarations/function"
import { execute_name } from "../const"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const callee = identifier({
        state: in.context,
        name: in.source.name
    })

    const value = call({
        state: callee.state,
        callee: callee.id,
        arguments: in.arguments,
        fallible: false
    })

    const context = result({
        state: value.state,
        value: value.id
    })

    const declaration = functionDeclaration({
        base: in.source.declaration_base,
        name: bytes.fromText(execute_name),
        parameters_start: in.source.bases.field_base,
        parameters_count: integers.narrow(in.parameters.name.length),
        return_type: in.source.return_type,
        body_start: in.source.bases.statement_base,
        body_count: integers.narrow(context.statements.tags.length),
        exported: true,
        abi_export: false,
        inlined: false,
        calling_convention: null
    })

    return {
        expressions: context.expressions,
        forms: context.forms,
        parameters: in.parameters,
        statements: context.statements,
        declarations: declaration.table,
        valid: context.valid && declaration.valid
    }
}
