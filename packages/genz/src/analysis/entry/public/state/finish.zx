import bytes from "std:bytes"
import integers from "std:integer"

import initialize from "../../../../ast/context/initialize"
import result from "../../../../ast/context/result"
import functionDeclaration from "../../../../ast/declarations/function"
import errorUnion from "../../../../ast/expressions/error_union"
import { value_entry_name } from "../const"

import type { Input as Bases } from "../../../../ast/context/model"
import type { Columns as Functions } from "../../../../ast/declarations/function"
import type { Columns as Expressions } from "../../../../ast/expressions/model"
import type { Columns as Statements } from "../../../../ast/statements/model"

export type Input = {
    value: u32,
    output_type: u32,
    errors?: u8[][],
    inferred: bool,
    inlined: bool,
    bases: Bases,
    parameters_start: u32,
    parameters_count: u32,
    body_start: u32,
    body_count: u32,
    declaration_base: u32
}

export type Extra = {
    error_union_payload: u32[],
    error_union_errors: u8[][]?[],
    error_union_inferred: bool[]
}

export type Output = {
    expressions: Expressions,
    extra: Extra,
    statements: Statements,
    declarations: Functions,
    valid: bool
}

export default function (in: Input): Output {
    const context = result({
        state: initialize(in.bases),
        value: in.value
    })

    const error_type = errorUnion({
        table: {
            ...context.expressions.pick([
                "tags",
                "offsets"
            ]),
            error_union_payload: [],
            error_union_errors: [],
            error_union_inferred: []
        },
        base: in.bases.expression_base,
        payload: in.output_type,
        errors: in.errors,
        inferred: in.inferred
    })

    const count = integers.widen(in.body_count) + context.statements.tags.length

    const declaration = functionDeclaration({
        base: in.declaration_base,
        name: bytes.fromText(value_entry_name),
        parameters_start: in.parameters_start,
        parameters_count: in.parameters_count,
        return_type: error_type.id,
        body_start: in.body_start,
        body_count: integers.narrow(count),
        exported: true,
        abi_export: false,
        inlined: in.inlined,
        calling_convention: null
    })

    return {
        expressions: {
            ...context.expressions,
            ...error_type.table.pick([
                "tags",
                "offsets"
            ])
        },
        extra: error_type.table.omit([
            "tags",
            "offsets"
        ]),
        statements: context.statements,
        declarations: declaration.table,
        valid: context.valid && error_type.valid && declaration.valid
    }
}
