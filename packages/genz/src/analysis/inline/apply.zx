import { type_id_void, type_id_bool } from "core/const"

import { inline_budget } from "../../const"
import scalar from "../types/scalar"
import bodyControl from "./body/control"
import bodyExpressions from "./body/expressions"
import bodyRoot from "./body/root"
import bodySymbols from "./body/symbols"
import rebuild from "./rebuild"
import selection from "./selection"

import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Program } from "../model"

export type Rebuilt = {
    unit: u64,
    symbols?: Symbols,
    expressions: Expressions,
    control: Control,
    root: u32
}

export type Input = {
    program: Program,
    plan: u64[]
}

export type Output = {
    functions: Rebuilt[],
    entry?: Rebuilt
}

export default function (in: Input): Output {
    const functions: Rebuilt[] = []
    const entry: Rebuilt? = null

    const void_type = scalar({
        kinds: in.program.types.kinds,
        first: in.program.types.first,
        scalar: type_id_void
    })

    const bool_type = scalar({
        kinds: in.program.types.kinds,
        first: in.program.types.first,
        scalar: type_id_bool
    })

    const { program } = in

    const count = program.functions.roots.length

    return loop({
        program,
        count,
        plan: in.plan,
        void_type,
        bool_type,
        functions,
        entry,
        index: 0
    }, {
        while: current => current.index <= current.count,
        next: current => {
            const index = current.index
            const entry = index == current.count
            const program = current.program
            const address = {
                program,
                index
            }
            const stores = entry ? program.stores : program.functions.stores[index]
            const expressions = bodyExpressions(address)
            const eligible = stores.paths.length == 0 &&
                expressions.call_functions.length != 0

            if (eligible) {
                const selected = selection({
                    types: program.types,
                    expressions,
                    control: bodyControl(address),
                    root: bodyRoot(address),
                    costs: current.plan,
                    limit: inline_budget
                })

                if (selected.selected) {
                    const rebuilt = rebuild({
                        types: program.types,
                        program,
                        plan: current.plan,
                        limit: inline_budget,
                        void_type: current.void_type,
                        bool_type: current.bool_type,
                        unit: index,
                        marked: selected.marked
                    })

                    if (!rebuilt.failed) {
                        const updated =
                            rebuilt.symbols.names.length !=
                            bodySymbols(address).names.length
                        const replacement: Rebuilt = {
                            unit: index,
                            symbols: updated ? rebuilt.symbols : null,
                            expressions: rebuilt.expressions,
                            control: rebuilt.control,
                            root: rebuilt.root
                        }

                        if (entry) {
                            current.entry = replacement
                        } else {
                            current.functions = current.functions.push(replacement)[0]
                        }
                    }
                }
            }

            current.index += 1
        },
        return: state => state.pick([
            "functions",
            "entry"
        ])
    })
}
