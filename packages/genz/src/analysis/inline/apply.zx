import { type_id_void, type_id_bool } from "core/const"

import { inline_budget } from "../../const"
import scalar from "../types/scalar"
import rebuild from "./rebuild"
import selection from "./selection"

import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Symbols } from "core/symbol_table/model"
import type { Table } from "core/type_table/model"
import type { Unit } from "../unit"

export type Rebuilt = {
    unit: u64,
    symbols?: Symbols,
    expressions: Expressions,
    control: Control,
    root: u32
}

export type Input = {
    types: Table,
    units: Unit[],
    plan: u64[]
}

export type Output = {
    functions: Rebuilt[],
    entry?: Rebuilt
}

export default function (in: Input): Output {
    const functions: Rebuilt[] = []
    const entry: Rebuilt? = null

    const void_type = scalar({
        kinds: in.types.kinds,
        first: in.types.first,
        scalar: type_id_void
    })

    const bool_type = scalar({
        kinds: in.types.kinds,
        first: in.types.first,
        scalar: type_id_bool
    })

    return loop({
        types: in.types,
        units: in.units,
        plan: in.plan,
        void_type,
        bool_type,
        functions,
        entry,
        index: 0
    }, {
        while: current => current.index < current.units.length,
        next: current => {
            const index = current.index
            const unit = current.units[index]
            const calls = unit.expressions.call_functions
            const eligible = unit.stores.paths.length == 0 && calls.length != 0

            if (eligible) {
                const selected = selection({
                    types: current.types,
                    unit,
                    costs: current.plan,
                    limit: inline_budget
                })

                if (selected.selected) {
                    const rebuilt = rebuild({
                        types: current.types,
                        units: current.units,
                        plan: current.plan,
                        limit: inline_budget,
                        void_type: current.void_type,
                        bool_type: current.bool_type,
                        unit: index,
                        marked: selected.marked
                    })

                    if (!rebuilt.failed) {
                        const updated =
                            rebuilt.symbols.names.length != unit.symbols.names.length
                        const replacement: Rebuilt = {
                            unit: index,
                            symbols: updated ? rebuilt.symbols : null,
                            expressions: rebuilt.expressions,
                            control: rebuilt.control,
                            root: rebuilt.root
                        }

                        if (index + 1 == current.units.length) {
                            current.entry = replacement
                        } else {
                            current.functions = current.functions.push(replacement)[0]
                        }
                    }
                }
            }

            current.index += 1
        },
        return: state => state.pick([
            "functions",
            "entry"
        ])
    })
}
