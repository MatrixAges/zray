import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import { inline_budget } from "../../const"
import simple from "../control/simple"
import primitive from "../types/primitive"

import type { Table } from "core/type_table/model"
import type { Functions } from "../model"

export type Input = {
    types: Table,
    functions: Functions,
    pure: bool[]
}

export type Output = {
    costs: u64[],
    available: bool
}

export default function (in: Input): Output {
    return loop({
        types: in.types,
        functions: in.functions,
        pure: in.pure,
        costs: in.pure.map(value => 0)[0],
        available: false,
        index: 0
    }, {
        while: current => current.index < current.pure.length,
        next: current => {
            const { functions, index } = current
            const input_type = functions.input_types[index]
            const input = integers.widen(input_type)
            const same_kinds = functions.contracts[index].kinds.length == 0
            const local = functions.native_modules[index] == null
            const no_stores = functions.stores[index].paths.length == 0

            const eligible =
                (
                    - current.pure[current.index]
                    - and local
                    - and no_stores
                    - and same_kinds
                )
            const primitives = primitive({
                types: current.types,
                id: input_type
            }) && primitive({
                types: current.types,
                id: functions.output_types[index]
            })
            const empty =
                current.types.kinds[input] == 0 && current.types.first[input] == 0

            const candidate = (
                - eligible
                - and !primitives
                - and !empty
            )

            if (candidate && simple({
                control: functions.control[index],
                root: functions.roots[index]
            })) {
                const table = functions.expressions[index]

                const counted = loop({
                    table,
                    costs: current.costs,
                    index: current.index,
                    cost:
                        table.kinds.length + functions.symbols[index].names.length + 1,
                    position: 0
                }, {
                    while: items =>
                        items.cost <= inline_budget &&
                        items.position < items.table.kinds.length,
                    next: items => {
                        if (
                            items.table.kinds[items.position] ==
                                ExpressionKind.Call
                        ) {
                            const child =
                                integers.widen(
                                    items.table
                                        .call_functions[integers.widen(
                                            items.table.payloads[items.position]
                                        )]
                                )

                            items.cost = match {
                                child >= items.index => inline_budget + 1,
                                _ => items.cost + items.costs[child]
                            }
                        }

                        items.position += 1
                    },
                    return: state => state.cost
                })

                if (counted <= inline_budget) {
                    current.costs[current.index] = counted
                    current.available = true
                }
            }

            current.index += 1
        },
        return: state => ({
            costs: state.costs,
            available: state.available
        })
    })
}
