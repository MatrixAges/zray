<Module>
    <Type from="../model" as="Model" />
    <Type from="../facts/allocators" as="Allocators" />
    <Type from="publication/model" as="Publication" />

    <Args
        in={{
            program: Model.Program,
            allocators: Allocators.Result
        }}
        out={Publication.Output}
    />

    <Call
        fn="../value/pure"
        in={{
            program: $in.program,
            allocator: $in.allocators.scratch
        }}
    />

    <Call
        fn="plan"
        in={{
            types: $in.program.types,
            functions: $in.program.functions,
            pure: $ctx.pure
        }}
    />

    <If on={!$ctx.plan.available}>
        <Return
            value={{
                functions: null,
                entry: null
            }}
        />
    </If>

    <Call
        fn="apply"
        in={{
            program: $in.program,
            plan: $ctx.plan.costs
        }}
    />

    <Call
        module="publication/run"
        in={{
            source: $in.program.functions.pick([
                "symbols",
                "expressions",
                "control",
                "roots"
            ]),
            changes: $ctx.apply.functions,
            entry: $ctx.apply.entry,
            allocators: $in.allocators
        }}
    />

    <Return value={$ctx.run} />
</Module>
