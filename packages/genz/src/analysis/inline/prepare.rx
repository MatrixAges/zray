<Module>
    <Type from="../model" as="Model" />
    <Type from="apply" as="Apply" />
    <Type from="../facts/allocators" as="Allocators" />

    <Args
        in={{
            program: Model.Program,
            allocator: Allocators.Resource
        }}
        out={Apply.Output}
    />

    <Call
        fn="../value/pure"
        in={{
            program: $in.program,
            allocator: $in.allocator
        }}
    />

    <Call
        fn="plan"
        in={{
            types: $in.program.types,
            functions: $in.program.functions,
            pure: $ctx.pure
        }}
    />

    <If on={!$ctx.plan.available}>
        <Return
            value={{
                functions: [],
                entry: null
            }}
        />
    </If>

    <Call
        fn="apply"
        in={{
            program: $in.program,
            plan: $ctx.plan.costs
        }}
    />

    <Return value={$ctx.apply} />
</Module>
