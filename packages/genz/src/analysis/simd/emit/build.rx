<Module>
    <Type from="model" as="Emit" />

    <Args in={Emit.Input} out={Emit.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="prepare/source" />
    <Call fn="prepare/allocation" />
    <Call fn="prepare/width" />
    <Call fn="prepare/chunks" />

    <Call module="vector" />
    <Call module="tail" />

    <Call fn="finish" />

    <Return value={$ctx.finish} />
</Module>
