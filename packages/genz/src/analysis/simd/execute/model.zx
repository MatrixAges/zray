import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as Analysis, Node } from "../model"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    analysis: Analysis
}

export type Output = u32?

export type Literals = Input.Pick("frame") & {
    nodes: Node[]
}
