import type { SimdFrame, SimdPublication } from "lowering_host"

export type Input = {
    frame: SimdFrame,
    count: u64,
    accepted: bool,
    wrap: bool
}

export type Output = u32?

export type Literals = Input.Pick(
    "frame",
    "count"
)

export type Publication = {
    frame: SimdPublication,
    count: u64
}
