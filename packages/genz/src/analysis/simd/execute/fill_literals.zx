import host from "lowering_host"
import memory from "memory"

import { Operation } from "../model"

import type { Literals } from "./model"

export type Input = Literals & {
    offset: u64
}

export type Output = void

export default function (in: Input): Output {
    const literals = loop(0, {
        while: index => index < in.nodes.length,
        next: index => {
            const node = in.nodes[index]

            if (node.operation == Operation.Literal) {
                const value = host.lowerExpression(in.frame, node.source, false, null)

                memory.writeU32(in.literals, in.offset + index, value)
            }

            index += 1
        }
    })
}
