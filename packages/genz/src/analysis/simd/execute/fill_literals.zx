import host from "lowering_host"

import { Operation } from "../model"

import type { Literals } from "./model"

export type Input = Literals

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < in.nodes.length,
        next: state => {
            const node = in.nodes[state.index]
            const value: u32 = match {
                node.operation == Operation.Literal =>
                    host.lowerExpression(in.frame, node.source, false, null),
                _ => 0
            }

            state.values = state.values.push(value)[0]
            state.index += 1
        },
        return: state => state.values
    })
}
