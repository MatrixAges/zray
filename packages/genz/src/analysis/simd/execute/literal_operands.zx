import collect from "./fill_literals"

import type { Input as Emission } from "../emit/model"
import type { Literals } from "./model"

export type Input = Literals

export type Output = Emission.Pick("vector_literals", "tail_literals")

export default function (in: Input): Output {
    const vector_literals = collect(in)
    const tail_literals = collect(in)

    return {
        vector_literals,
        tail_literals
    }
}
