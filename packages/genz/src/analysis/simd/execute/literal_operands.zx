import memory from "memory"

import collect from "./fill_literals"

import type { Input as Emission } from "../emit/model"
import type { Literals } from "./model"

export type Input = Literals

export type Output = Emission.Pick("vector_literals", "tail_literals")

export default function (in: Input): Output {
    collect({
        ...in,
        offset: 0
    })

    const count = in.nodes.length

    collect({
        ...in,
        offset: count
    })

    const values = memory.u32Views(in.literals)

    return {
        vector_literals: memory.borrowU32Range(values, 0, count),
        tail_literals: memory.borrowU32Range(values, count, count)
    }
}
