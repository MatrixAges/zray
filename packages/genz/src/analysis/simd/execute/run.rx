<Module>
    <Type from="model" as="SIMD" />

    <Args in={SIMD.Input} out={SIMD.Output} />

    <Call module="../analyze" in={$in.analysis} />

    <If on={!$ctx.analyze.accepted}>
        <Return value={null} />
    </If>

    <Call
        fn="index.readList"
        in={[
            $in.frame,
            $ctx.analyze.candidate.source
        ]}
    />

    <Call
        fn="index.lowerType"
        in={[
            $in.frame,
            $ctx.analyze.candidate.scalar,
            false
        ]}
    />

    <Call
        fn="literal_operands"
        in={{
            frame: $in.frame,
            nodes: $ctx.analyze.expression.nodes
        }}
    />

    <Call fn="index.readAstOrigin" in={$in.writer} />

    <Call
        module="../emit/build"
        in={{
            ...$ctx.readAstOrigin,
            ...$ctx.literal_operands,
            nodes: $ctx.analyze.expression.nodes,
            uses_element: $ctx.analyze.expression.uses_element,
            source: $ctx.readList,
            element_type: $ctx.lowerType
        }}
    />

    <Call
        module="../../node_headers/publication/dense"
        in={$ctx.build.omit(["root"])}
    />

    <If on={$in.analysis.consumer == null}>
        <Call
            fn="index.wrapLoweredList"
            in={[
                $in.frame,
                $in.analysis.subject,
                $ctx.build.root
            ]}
        />

        <Return value={$ctx.wrapLoweredList} />
    </If>

    <Return value={$ctx.build.root} />
</Module>
