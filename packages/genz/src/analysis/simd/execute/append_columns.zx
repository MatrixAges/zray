import host from "lowering_host"

import type { Publication } from "./model"

export type Input = Publication

export type Output = void

export default function (in: Input): Output {
    host.appendSimdExpressions(in.frame)

    const statements = loop(0, {
        while: index => index < in.count,
        next: index => {
            host.appendSimdStatement(in.frame, index)

            index += 1
        }
    })
}
