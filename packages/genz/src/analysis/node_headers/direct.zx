import bytes from "std:bytes"
import integers from "std:integer"
import { max_u64 } from "core/const"
import host from "lowering_host"

import { word_radix } from "./block/const"

import type { DirectAstRows } from "lowering_host"
import type { Published } from "./block/model"

export type Input = {
    rows: DirectAstRows,
    count: u64
}

export type Output = Published & {
    count: u64
}

export default function (in: Input): Output {
    const tags = bytes.repeat(in.count, 0)
    const offsets: u32[] = tags.map(tag => 0)[0]

    return loop({
        tags,
        offsets,
        count: 0,
        ready: true
    }, {
        while: state => state.count < in.count && state.ready,
        next: state => {
            const header = host.prepareDirectAstRow(in.rows, state.count)

            if (header == max_u64) {
                state.ready = false
            } else {
                state.tags[state.count] = integers.narrowByte(header / word_radix)
                state.offsets[state.count] = integers.narrow(header % word_radix)
                state.count += 1
            }
        },
        return: state => ({
            tags: state.tags,
            offsets: state.offsets,
            count: state.count
        })
    })
}
