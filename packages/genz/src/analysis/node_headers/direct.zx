import bytes from "std:bytes"
import integers from "std:integer"

import { word_radix } from "./block/const"

import type { Published } from "./block/model"

export type Input = {
    headers: u64[]
}

export type Output = Published

export default function (in: Input): Output {
    const tags = bytes.repeat(in.headers.length, 0)
    const offsets: u32[] = tags.map(tag => 0)[0]

    return loop({
        tags,
        offsets,
        row: 0
    }, {
        while: state => state.row < in.headers.length,
        next: state => {
            const header = in.headers[state.row]

            state.tags[state.row] = integers.narrowByte(header / word_radix)
            state.offsets[state.row] = integers.narrow(header % word_radix)
            state.row += 1
        },
        return: state => ({
            tags: state.tags,
            offsets: state.offsets
        })
    })
}
