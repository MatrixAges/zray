<Module>
    <Type from="model" as="Module" />
    <Type from="../model" as="Headers" />

    <Args in={Module.Input} out={Headers.Check} />

    <If on={$in.statements != null}>
        <Call module="../payload/validated" in={$in.statements} />

        <If on={$ctx.validated != Headers.Check.Valid}>
            <Return value={$ctx.validated} />
        </If>
    </If>

    <If on={$in.fields != null}>
        <Call module="../plain/append" in={$in.fields} />

        <If on={$ctx.append != Headers.Check.Valid}>
            <Return value={$ctx.append} />
        </If>
    </If>

    <Call module="declarations" in={$in} />

    <Return value={$ctx.declarations} />
</Module>
