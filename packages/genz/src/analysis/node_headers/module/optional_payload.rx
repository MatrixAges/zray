<Module>
    <Type from="../payload/model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Bound?} out={Payload.Published} />

    <If on={$in != null}>
        <Call module="../payload/validated" in={$in} />

        <Return value={$ctx.validated} />
    </If>

    <Return
        value={{
            check: Headers.Check.Valid,
            count: 0,
            offsets: []
        }}
    />
</Module>
