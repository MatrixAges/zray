import { copy, publish } from "core/column_transfer"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { allocator, groups, count } = in

    return loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            state.valid = copy({
                allocator,
                groups,
                index: 0,
                first: state.row,
                count: 1
            })

            if (state.valid) {
                state.row += publish({
                    groups,
                    index: 0,
                    count: 1
                })
            }
        },
        return: state => state.valid
    })
}
