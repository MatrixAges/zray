import { matches } from "core/column_transfer"

import fits from "../fits"
import { Check } from "../model"

import type { Input } from "./model"

export type Output = Check

export default function (in: Input): Output {
    const shape = matches({
        groups: in.groups,
        index: 0,
        count: in.count
    })

    if (!shape) {
        return Check.Invalid
    }

    const capacity = fits(in.pick([
        "existing",
        "count"
    ]))

    return capacity ? Check.Valid : Check.Exhausted
}
