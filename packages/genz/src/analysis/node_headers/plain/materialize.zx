import type { Columns } from "../../../ast/fields/model"

export type Field = {
    name: u8[],
    value: u32,
    default_value?: u32,
    comptime_parameter: bool
}

export type Input = Columns

export type Output = {
    valid: bool,
    fields: Field[]
}

export default function (in: Input): Output {
    const count = in.name.length
    const values_fit = in.value.length == count
    const defaults_fit = in.default_value.length == count
    const comptime_fits = in.comptime_parameter.length == count
    const empty: Field[] = []

    const valid = values_fit && defaults_fit && comptime_fits

    if (!valid) {
        return {
            valid: false,
            fields: empty
        }
    }

    const fields = loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < count,
        next: state => {
            const row = state.row

            state.items = state.items.push({
                name: in.name[row],
                value: in.value[row],
                default_value: in.default_value[row],
                comptime_parameter: in.comptime_parameter[row]
            })[0]
            state.row += 1
        },
        return: state => state.items
    })

    return {
        valid: true,
        fields
    }
}
