import { copy, publish, reserve } from "core/column_transfer"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { allocator, groups, count } = in

    const extent = {
        groups,
        index: 0,
        count
    }

    const base = reserve({
        ...extent,
        allocator
    })

    if (in.borrowed) {
        const copied = copy({
            ...extent,
            allocator,
            first: 0
        })

        if (copied) {
            publish(extent)
        }

        return copied
    }

    const completed = loop({
        row: 0,
        valid: true
    }, {
        while: state => state.valid && state.row < count,
        next: state => {
            state.valid = copy({
                allocator,
                groups,
                index: 0,
                first: state.row,
                count: 1
            })

            if (state.valid) {
                publish({
                    groups,
                    index: 0,
                    count: 1
                })
                state.row += 1
            }
        },
        return: state => state.valid
    })

    return completed
}
