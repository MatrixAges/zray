<Module>
    <Type from="model" as="Plain" />
    <Type from="../model" as="Headers" />

    <Args in={Plain.Input} out={Headers.Check} />

    <Call fn="check" in={$in} />

    <If on={$ctx.check != Headers.Check.Valid}>
        <Return value={$ctx.check} />
    </If>

    <Call fn="write" in={$in} />

    <If on={$ctx.write}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Return value={Headers.Check.Exhausted} />
</Module>
