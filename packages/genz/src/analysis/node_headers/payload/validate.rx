<Module>
    <Type from="model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Validation} out={Payload.ValidationResult} />

    <If on={$in.selected}>
        <Call
            fn="limits"
            in={$in.pick([
                "complete",
                "lengths"
            ])}
        />

        <Call
            module="../check"
            in={{
                ...$in.pick([
                    "existing",
                    "tags",
                    "offsets",
                    "mask"
                ]),
                limits: $ctx.limits,
                variants: $in.complete.length
            }}
        />

        <Return value={$ctx.check} />
    </If>

    <Call
        module="../check"
        in={{
            ...$in.pick([
                "existing",
                "tags",
                "offsets",
                "mask"
            ]),
            limits: null,
            variants: $in.complete.length
        }}
    />

    <If on={$ctx.check.check != Headers.Check.Valid}>
        <Return value={$ctx.check} />
    </If>

    <Call
        fn="shape"
        in={{
            ...$in.pick([
                "complete",
                "lengths"
            ]),
            counts: $ctx.check.counts
        }}
    />

    <If on={$ctx.shape}>
        <Return value={$ctx.check} />
    </If>

    <Return
        value={{
            check: Headers.Check.Invalid,
            counts: []
        }}
    />
</Module>
