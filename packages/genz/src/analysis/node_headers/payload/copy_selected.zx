import integers from "std:integer"
import { copy, publish } from "core/column_transfer"

import type { Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { tags, mask, offsets, groups, allocator } = in

    return loop({
        row: 0,
        ready: true
    }, {
        while: state => state.ready && state.row < tags.length,
        next: state => {
            const byte = integers.widenByte(tags[state.row])
            const group = integers.andBits(byte, mask)
            const index = integers.widen(offsets[state.row])

            state.ready = copy({
                allocator,
                groups,
                index: group,
                first: index,
                count: 1
            })

            if (state.ready) {
                publish({
                    groups,
                    index: group,
                    count: 1
                })
                state.row += 1
            }
        },
        return: state => state.row
    })
}
