<Module>
    <Type from="model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Bound} out={Headers.Check} />

    <Call
        module="validate"
        in={{
            ...$in.pick([
                "complete",
                "existing",
                "groups",
                "mask",
                "offsets",
                "tags"
            ]),
            selected: $in.layout == Payload.Layout.Selected
        }}
    />

    <If on={$ctx.validate.check != Headers.Check.Valid}>
        <Return value={$ctx.validate.check} />
    </If>

    <If on={$in.tags.length == 0}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Call
        module="append"
        in={{
            ...$in.omit([
                "complete",
                "existing"
            ]),
            counts: $ctx.validate.counts
        }}
    />

    <If on={$ctx.append}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Return value={Headers.Check.Exhausted} />
</Module>
