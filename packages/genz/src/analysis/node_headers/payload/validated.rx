<Module>
    <Type from="model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Bound} out={Payload.Published} />

    <Call
        module="validate"
        in={{
            ...$in.pick([
                "complete",
                "existing",
                "lengths",
                "mask",
                "offsets",
                "tags"
            ]),
            selected: $in.layout == Payload.Layout.Selected
        }}
    />

    <If on={$ctx.validate.check != Headers.Check.Valid || $in.tags.length == 0}>
        <Return
            value={{
                check: $ctx.validate.check,
                count: 0,
                offsets: []
            }}
        />
    </If>

    <If on={!$in.reserved}>
        <Return
            value={{
                check: Headers.Check.Exhausted,
                count: 0,
                offsets: []
            }}
        />
    </If>

    <Call
        module="append"
        in={{
            ...$in.omit([
                "complete",
                "existing",
                "lengths",
                "reserved"
            ]),
            counts: $ctx.validate.counts
        }}
    />

    <If on={$ctx.append.count == $in.tags.length}>
        <Return
            value={{
                ...$ctx.append,
                check: Headers.Check.Valid
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.append,
            check: Headers.Check.Exhausted
        }}
    />
</Module>
