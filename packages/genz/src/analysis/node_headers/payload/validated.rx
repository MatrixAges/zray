<Module>
    <Type from="model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Bound} out={Headers.Check} />

    <Call
        module="../check"
        in={{
            ...$in.pick([
                "existing",
                "tags",
                "offsets",
                "mask"
            ]),
            counts: $in.count_buffer,
            variants: $in.counts.length
        }}
    />

    <If on={$ctx.check != Headers.Check.Valid}>
        <Return value={$ctx.check} />
    </If>

    <Call
        fn="shape"
        in={$in.pick([
            "complete",
            "groups",
            "counts"
        ])}
    />

    <If on={!$ctx.shape}>
        <Return value={Headers.Check.Invalid} />
    </If>

    <If on={$in.tags.length == 0}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Call
        module="append"
        in={$in.omit([
            "count_buffer",
            "complete",
            "existing"
        ])}
    />

    <If on={$ctx.append}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Return value={Headers.Check.Exhausted} />
</Module>
