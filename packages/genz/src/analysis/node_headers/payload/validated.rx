<Module>
    <Type from="model" as="Payload" />
    <Type from="../model" as="Headers" />

    <Args in={Payload.Bound} out={Headers.Check} />

    <Call
        module="validate"
        in={$in.pick([
            "complete",
            "count_buffer",
            "counts",
            "existing",
            "groups",
            "limits",
            "mask",
            "offsets",
            "tags"
        ])}
    />

    <If on={$ctx.validate != Headers.Check.Valid}>
        <Return value={$ctx.validate} />
    </If>

    <If on={$in.tags.length == 0}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Call
        module="append"
        in={$in.omit([
            "count_buffer",
            "complete",
            "existing",
            "limits"
        ])}
    />

    <If on={$ctx.append}>
        <Return value={Headers.Check.Valid} />
    </If>

    <Return value={Headers.Check.Exhausted} />
</Module>
