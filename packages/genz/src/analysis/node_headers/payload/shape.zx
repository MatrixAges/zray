import integers from "std:integer"

import type { Shape as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { counts, complete, lengths } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < counts.length,
        next: state => {
            const index = state.index
            const count = integers.widen(counts[index])
            const supplied = count == 0 || complete[index]

            const group = lengths[index]

            state.valid =
                supplied && group.every(length => length == null || length == count)
            state.index += 1
        },
        return: state => state.valid
    })
}
