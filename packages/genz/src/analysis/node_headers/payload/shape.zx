import integers from "std:integer"
import memory from "memory"

import type { Validation as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { counts, complete, groups } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < counts.length,
        next: state => {
            const index = state.index
            const count = integers.widen(counts[index])
            const supplied = count == 0 || complete[index]

            state.valid =
                supplied && memory.columnGroupMatchesLength(groups, index, count)
            state.index += 1
        },
        return: state => state.valid
    })
}
