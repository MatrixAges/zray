import type { Allocator, ColumnTransfers, U32Buffer, U64Buffer } from "memory"
import type { Headers, Rebase, Tail } from "../model"

export enum Layout {
    Dense,
    Selected
}

export type Columns = {
    groups: ColumnTransfers,
    counts: u32[]
}

export type Preparation = Columns & {
    allocator: Allocator,
    bases: U32Buffer
}

export type Input = Rebase & Preparation & Tail & {
    layout: Layout
}

export type Shape = Columns & {
    complete: bool[]
}

export type Validation = Headers & Shape & {
    count_buffer: U32Buffer,
    existing: u64,
    limits?: U64Buffer
}

export type Bound = Input & Validation
