import type { Allocator, ColumnTransfers } from "memory"
import type { Check, CheckResult, Headers } from "../model"

export enum Layout {
    Dense,
    Selected
}

export type Columns = {
    groups: ColumnTransfers,
    counts: u32[]
}

export type Preparation = Columns & {
    allocator: Allocator
}

export type Input = Headers & Preparation & {
    layout: Layout
}

export type Shape = Columns & {
    complete: bool[]
}

export type Validation = Headers & {
    groups: ColumnTransfers,
    complete: bool[],
    existing: u64,
    selected: bool
}

export type ValidationResult = CheckResult

export type Bound = Headers & {
    allocator: Allocator,
    reserved: bool,
    groups: ColumnTransfers,
    complete: bool[],
    existing: u64,
    layout: Layout
}

export type Appended = {
    count: u64,
    offsets: u32[]
}

export type Published = Appended & {
    check: Check
}
