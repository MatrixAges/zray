import type { Allocator, ColumnTransfers } from "memory"
import type { Check, CheckResult, Headers } from "../model"

export enum Layout {
    Dense,
    Selected
}

export type Columns = {
    groups: ColumnTransfers,
    counts: u32[]
}

export type Preparation = Columns & {
    allocator: Allocator
}

export type Input = Headers & Preparation & {
    layout: Layout
}

export type SourceShape = {
    lengths: u64?[][],
    complete: bool[]
}

export type Shape = SourceShape & {
    counts: u32[]
}

export type Validation = Headers & SourceShape & {
    existing: u64,
    selected: bool
}

export type ValidationResult = CheckResult

export type Bound = Headers & SourceShape & {
    allocator: Allocator,
    reserved: bool,
    groups: ColumnTransfers,
    existing: u64,
    layout: Layout
}

export type Appended = {
    count: u64,
    offsets: u32[]
}

export type Published = Appended & {
    check: Check
}

export type PublishCursor = Columns & {
    index: u64,
    running: bool
}

export type PublishCount = PublishCursor.Pick("counts", "index")

export { publish as publishColumnGroup } from "core/column_transfer"
