import type { Allocator, ColumnTransfers } from "memory"
import type { CheckResult, Headers, Tail } from "../model"

export enum Layout {
    Dense,
    Selected
}

export type Columns = {
    groups: ColumnTransfers,
    counts: u32[]
}

export type Preparation = Columns & {
    allocator: Allocator
}

export type Input = Headers & Columns & Tail & {
    layout: Layout
}

export type Shape = Columns & {
    complete: bool[]
}

export type Validation = Headers & {
    groups: ColumnTransfers,
    complete: bool[],
    existing: u64,
    selected: bool
}

export type ValidationResult = CheckResult

export type Bound = Headers & Tail & {
    groups: ColumnTransfers,
    complete: bool[],
    existing: u64,
    layout: Layout
}
