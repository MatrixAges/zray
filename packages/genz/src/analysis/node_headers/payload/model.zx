import type { Allocator, ColumnTransfers, U32Buffer } from "memory"
import type { Rebase, Tail } from "../model"

export enum Layout {
    Dense,
    Selected
}

export type Columns = {
    groups: ColumnTransfers,
    counts: u32[]
}

export type Preparation = Columns & {
    allocator: Allocator,
    bases: U32Buffer
}

export type Input = Rebase & Preparation & Tail & {
    layout: Layout
}
