import integers from "std:integer"
import memory from "memory"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { counts, groups, allocator } = in

    const copied = loop({
        group: 0,
        ready: true
    }, {
        while: state => state.ready && state.group < counts.length,
        next: state => {
            const count = integers.widen(counts[state.group])

            if (count != 0) {
                state.ready =
                    memory.copyColumnGroup(allocator, groups, state.group, 0, count)
            }

            if (state.ready) {
                state.group += 1
            }
        },
        return: state => state.group
    })

    if (copied == counts.length) {
        return true
    }

    const released = loop(copied, {
        while: cursor => cursor != 0,
        next: cursor => {
            const group = cursor - 1
            const count = integers.widen(counts[group])

            memory.discardColumnGroup(allocator, groups, group, count)
            cursor = group
        }
    })

    return false
}
