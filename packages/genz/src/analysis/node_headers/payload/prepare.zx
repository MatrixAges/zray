import integers from "std:integer"
import { reserve } from "core/column_transfer"
import memory from "memory"

import type { Preparation as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { allocator, groups, counts, bases } = in

    const prepared = loop(0, {
        while: index => index < counts.length,
        next: index => {
            const count = integers.widen(counts[index])

            if (count != 0) {
                const base = reserve({
                    allocator,
                    groups,
                    index,
                    count
                })

                memory.writeU32(bases, index, integers.narrow(base))
            }

            index += 1
        }
    })
}
