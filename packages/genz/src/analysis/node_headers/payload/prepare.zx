import integers from "std:integer"
import { reserve } from "core/column_transfer"

import type { Preparation as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { allocator, groups, counts } = in

    const empty: u32[] = []
    const zero: u32 = 0

    return loop({
        index: 0,
        bases: empty
    }, {
        while: state => state.index < counts.length,
        next: state => {
            const count = integers.widen(counts[state.index])

            const base = match {
                count != 0 => integers.narrow(reserve({
                    allocator,
                    groups,
                    index: state.index,
                    count
                })),
                _ => zero
            }

            state.bases = state.bases.push(base)[0]
            state.index += 1
        },
        return: state => state.bases
    })
}
