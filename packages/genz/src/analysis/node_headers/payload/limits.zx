import { max_u64 } from "core/const"

import type { Validation } from "./model"

export type Input = Validation.Pick("lengths", "complete")

export type Output = u64[]

export default function (in: Input): Output {
    const zero: u64 = 0

    return in.lengths.map(
        (group, index) => match {
            in.complete[index] => group.reduce(
                (limit, length) => match {
                    length != null && length < limit => length,
                    _ => limit
                },
                max_u64
            )[1],
            _ => zero
        }
    )[0]
}
