import { minimum } from "core/column_transfer"

import type { Validation } from "./model"

export type Input = Validation.Pick("groups", "complete")

export type Output = u64[]

export default function (in: Input): Output {
    const { groups, complete } = in

    const empty: u64[] = []
    const zero: u64 = 0

    return loop({
        index: 0,
        limits: empty
    }, {
        while: state => state.index < complete.length,
        next: state => {
            const limit = match complete[state.index] {
                true => minimum({
                    groups,
                    index: state.index
                }),
                _ => zero
            }

            state.limits = state.limits.push(limit)[0]
            state.index += 1
        },
        return: state => state.limits
    })
}
