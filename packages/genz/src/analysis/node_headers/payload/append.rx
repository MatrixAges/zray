<Module>
    <Type from="model" as="Payload" />

    <Args in={Payload.Input} out={Payload.Appended} />

    <Call
        fn="prepare"
        in={$in.pick([
            "allocator",
            "groups",
            "counts"
        ])}
    />

    <If on={$in.layout == Payload.Layout.Selected}>
        <Call
            fn="../selected"
            in={{
                tags: $in.tags,
                mask: $in.mask,
                bases: $ctx.prepare
            }}
        />

        <Call fn="copy_selected" in={$in} />

        <Return
            value={{
                count: $ctx.copy_selected,
                offsets: $ctx.selected
            }}
        />
    </If>

    <Call
        fn="../rebase"
        in={{
            ...$in.pick([
                "tags",
                "offsets",
                "mask"
            ]),
            bases: $ctx.prepare
        }}
    />

    <Call fn="dense" in={$in} />

    <If on={!$ctx.dense}>
        <Return
            value={{
                count: 0,
                offsets: []
            }}
        />
    </If>

    <Loop on={$in.running}>
        <Call
            module="publish_group"
            in={{
                groups: $in.groups,
                counts: $in.counts,
                index: 0,
                running: $in.counts.length != 0
            }}
        />
    </Loop>

    <Return
        value={{
            count: $in.tags.length,
            offsets: $ctx.rebase
        }}
    />
</Module>
