<Module>
    <Type from="model" as="Headers" />

    <Args in={Headers.Layout} out={Headers.CheckResult} />

    <If on={$in.tags.length != $in.offsets.length}>
        <Return
            value={{
                check: Headers.Check.Invalid,
                counts: []
            }}
        />
    </If>

    <Call
        fn="fits"
        in={{
            existing: $in.existing,
            count: $in.tags.length
        }}
    />

    <If on={!$ctx.fits}>
        <Return
            value={{
                check: Headers.Check.Exhausted,
                counts: []
            }}
        />
    </If>

    <Call fn="count" in={$in} />

    <If on={!$ctx.count.valid}>
        <Return
            value={{
                check: Headers.Check.Invalid,
                counts: []
            }}
        />
    </If>

    <If on={$in.limits != null}>
        <Return
            value={{
                check: Headers.Check.Valid,
                counts: $ctx.count.counts
            }}
        />
    </If>

    <Call
        fn="dense"
        in={{
            ...$in.pick([
                "tags",
                "offsets",
                "mask"
            ]),
            counts: $ctx.count.counts
        }}
    />

    <If on={$ctx.dense}>
        <Return
            value={{
                check: Headers.Check.Valid,
                counts: $ctx.count.counts
            }}
        />
    </If>

    <Return
        value={{
            check: Headers.Check.Invalid,
            counts: []
        }}
    />
</Module>
