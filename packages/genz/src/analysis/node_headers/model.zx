export type Headers = {
    tags: u8[],
    offsets: u32[],
    mask: u64
}

export type Layout = Headers & {
    existing: u64,
    variants: u64,
    limits?: u64[]
}

export enum Check {
    Valid,
    Invalid,
    Exhausted
}

export type CheckResult = {
    check: Check,
    counts: u32[]
}

export type CountResult = {
    valid: bool,
    counts: u32[]
}

export type Dense = Headers & {
    counts: u32[]
}

export type Rebase = Headers & {
    bases: u32[]
}

export type Selected = Headers.Pick("tags", "mask") & {
    bases: u32[]
}
