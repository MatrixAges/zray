import type { ColumnLengths, U32Buffer, U8Buffer } from "memory"

export type Headers = {
    tags: u8[],
    offsets: u32[],
    mask: u64
}

export type Layout = Headers & {
    counts: U32Buffer,
    variants: u64,
    limits?: u64[]
}

export type Rebase = Headers & {
    bases: u32[],
    target: U32Buffer
}

export type Selected = Headers.Pick("tags", "mask") & {
    count: u64,
    bases: U32Buffer,
    target_tags: U8Buffer,
    target_offsets: U32Buffer,
    lengths: ColumnLengths
}

export type References = {
    tags: u8[],
    offsets: u32[],
    indices: u32[],
    target_tags: U8Buffer,
    target_offsets: U32Buffer
}
