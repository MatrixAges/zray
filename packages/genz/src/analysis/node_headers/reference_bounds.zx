import integers from "std:integer"

export type Input = {
    indices: u32[],
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.indices.length,
        next: state => {
            state.valid = integers.widen(in.indices[state.index]) < in.count
            state.index += 1
        },
        return: state => state.valid
    })
}
