import integers from "std:integer"
import memory from "memory"

import type { Rebase as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { bases, tags, offsets, mask } = in

    const written = loop(0, {
        while: index => index < tags.length,
        next: index => {
            const byte = integers.widenByte(tags[index])
            const tag = integers.andBits(byte, mask)
            const offset = bases[tag] + offsets[index]

            memory.writeU32(in.target, index, offset)
            index += 1
        }
    })
}
