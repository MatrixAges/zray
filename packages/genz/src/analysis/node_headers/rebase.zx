import integers from "std:integer"

import type { Rebase as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { bases, tags, offsets, mask } = in

    const rebased: u32[] = tags.map(tag => 0)[0]

    return loop({
        index: 0,
        offsets: rebased
    }, {
        while: state => state.index < tags.length,
        next: state => {
            const byte = integers.widenByte(tags[state.index])
            const tag = integers.andBits(byte, mask)

            state.offsets[state.index] = bases[tag] + offsets[state.index]
            state.index += 1
        },
        return: state => state.offsets
    })
}
