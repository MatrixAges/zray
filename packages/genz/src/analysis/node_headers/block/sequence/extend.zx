import append from "./append"

import type { Extend as Input, Extended as Output } from "./model"

export default function (in: Input): Output {
    const first = in.first

    const head = append({
        last: in.last,
        span: first ?? in.tail
    })

    if (first == null) {
        return {
            last: head.last,
            emit: head.emit
        }
    }

    return {
        last: in.tail,
        emit: head.emit,
        bridge: head.last
    }
}
