import { word_radix } from "../const"

import type { Append as Input, Appended as Output } from "./model"

export default function (in: Input): Output {
    const { span, last } = in

    const count = span % word_radix

    if (count == 0) {
        return {
            last,
            emit: null
        }
    }

    if (last == 0) {
        return {
            last: span,
            emit: null
        }
    }

    const end = last / word_radix + last % word_radix

    if (end == span / word_radix) {
        return {
            last: last + count,
            emit: null
        }
    }

    return {
        last: span,
        emit: last
    }
}
