import memory from "memory"

import { word_radix } from "../const"

import type { Append as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { span, last } = in

    const count = span % word_radix

    if (count == 0) {
        return last
    }

    if (last == 0) {
        return span
    }

    const end = last / word_radix + last % word_radix

    if (end == span / word_radix) {
        return last + count
    }

    memory.appendU64(in.allocator, in.parts, last)

    return span
}
