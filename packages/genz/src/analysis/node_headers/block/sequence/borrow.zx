import { word_radix } from "../const"

import type { LayoutRequest, Layout as Output } from "../model"

export type Input = LayoutRequest.Pick(
    "parts",
    "end",
    "at_tail"
)

export default function (in: Input): Output {
    const range = loop({
        start: 0,
        count: 0,
        contiguous: true,
        index: 0
    }, {
        while: state => state.index < in.parts.length,
        next: state => {
            const part = in.parts[state.index]
            const count = part % word_radix

            if (count != 0) {
                const start = part / word_radix

                if (state.count == 0) {
                    state.start = start
                } else if (start != state.start + state.count) {
                    state.contiguous = false
                }

                state.count += count
            }

            state.index += 1
        }
    })

    if (range.count == 0) {
        return {
            start: in.at_tail ? in.end : 0,
            count: 0,
            append: false
        }
    }

    const at_end = range.start + range.count == in.end
    const borrow = range.contiguous && (at_end || !in.at_tail)

    return {
        start: borrow ? range.start : in.end,
        count: range.count,
        append: !borrow
    }
}
