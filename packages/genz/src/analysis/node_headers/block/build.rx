<Module>
    <Type from="model" as="Block" />

    <Args in={Block.Input} out={Block.Output} />

    <Call
        fn="layout"
        in={$in.pick([
            "starts",
            "counts",
            "parts",
            "last",
            "end",
            "at_tail"
        ])}
    />

    <If on={$ctx.layout.append}>
        <Call
            fn="publish"
            in={$in.omit([
                "end",
                "at_tail"
            ])}
        />

        <Return
            value={{
                ...$ctx.layout,
                ...$ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.layout,
            tags: [],
            offsets: []
        }}
    />
</Module>
