export type Blocks = {
    starts: u32[],
    counts: u32[],
    parts: u64[],
    last: u64
}

export type LayoutRequest = Blocks & {
    end: u64,
    at_tail: bool
}

export type Layout = {
    start: u64,
    count: u64,
    append: bool
}

export type Sources = {
    source_tags: u8[],
    source_offsets: u32[]
}

export type Published = {
    tags: u8[],
    offsets: u32[]
}

export type Input = LayoutRequest & Sources

export type Output = Layout & Published

export type Destination = Blocks & Sources
