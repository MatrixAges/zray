import type { Destination as Headers } from "../model"

export type Blocks = {
    starts: u32[],
    counts: u32[]
}

export type LayoutRequest = Blocks & {
    end: u64,
    at_tail: bool
}

export type Layout = {
    start: u64,
    count: u64,
    append: bool
}

export type Destination = Blocks & Headers & {
    tags: u8[],
    offsets: u32[]
}
