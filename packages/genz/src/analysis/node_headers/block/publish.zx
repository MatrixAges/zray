import integers from "std:integer"

import { word_radix } from "./const"

import type { Destination as Input, Published as Output } from "./model"

export default function (in: Input): Output {
    const { starts, counts, parts, last, source_tags, source_offsets } = in

    const total = counts.length + parts.length
    const empty_tags: u8[] = []
    const empty_offsets: u32[] = []

    const written = loop({
        index: 0,
        tags: empty_tags,
        offsets: empty_offsets
    }, {
        while: state => state.index < total,
        next: state => {
            const word = match {
                state.index < counts.length => integers.widen(starts[state.index]) *
                    word_radix + integers.widen(counts[state.index]),
                _ => parts[state.index - counts.length]
            }
            const count = word % word_radix

            if (count != 0) {
                const start = word / word_radix
                const end = start + count

                const copied = loop({
                    pos: start,
                    tags: state.tags,
                    offsets: state.offsets
                }, {
                    while: inner => inner.pos < end,
                    next: inner => {
                        inner.tags = inner.tags.push(source_tags[inner.pos])[0]
                        inner.offsets =
                            inner.offsets.push(source_offsets[inner.pos])[0]
                        inner.pos += 1
                    },
                    return: inner => ({
                        tags: inner.tags,
                        offsets: inner.offsets
                    })
                })

                state.tags = copied.tags
                state.offsets = copied.offsets
            }

            state.index += 1
        },
        return: state => ({
            tags: state.tags,
            offsets: state.offsets
        })
    })

    const tail_count = last % word_radix

    if (tail_count == 0) {
        return written
    }

    const tail_start = last / word_radix
    const tail_end = tail_start + tail_count

    return loop({
        pos: tail_start,
        tags: written.tags,
        offsets: written.offsets
    }, {
        while: inner => inner.pos < tail_end,
        next: inner => {
            inner.tags = inner.tags.push(source_tags[inner.pos])[0]
            inner.offsets = inner.offsets.push(source_offsets[inner.pos])[0]
            inner.pos += 1
        },
        return: inner => ({
            tags: inner.tags,
            offsets: inner.offsets
        })
    })
}
