import integers from "std:integer"

import sequence from "./sequence/layout"

import type { LayoutRequest as Input, Layout as Output } from "./model"

export default function (in: Input): Output {
    if (in.last != 0) {
        return sequence(in.pick([
            "parts",
            "last",
            "end",
            "at_tail"
        ]))
    }

    const ranges = loop({
        start: 0,
        count: 0,
        contiguous: true,
        index: 0
    }, {
        while: state => state.index < in.counts.length,
        next: state => {
            const length = integers.widen(in.counts[state.index])

            if (length != 0) {
                const start = integers.widen(in.starts[state.index])

                if (state.count == 0) {
                    state.start = start
                } else if (start != state.start + state.count) {
                    state.contiguous = false
                }

                state.count += length
            }

            state.index += 1
        },
        return: state => state.pick([
            "start",
            "count",
            "contiguous"
        ])
    })

    if (ranges.count == 0) {
        return {
            start: in.at_tail ? in.end : 0,
            count: 0,
            append: false
        }
    }

    const at_end = ranges.start + ranges.count == in.end
    const borrow = ranges.contiguous && (at_end || !in.at_tail)

    return {
        start: borrow ? ranges.start : in.end,
        count: ranges.count,
        append: !borrow
    }
}
