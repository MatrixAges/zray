import integers from "std:integer"

import type { CountResult as Output, Layout as Input } from "./model"

export default function (in: Input): Output {
    const { tags, offsets, mask, limits } = in

    const empty: u32[] = []
    const zero: u32 = 0

    const initial = loop({
        index: 0,
        counts: empty
    }, {
        while: state => state.index < in.variants,
        next: state => {
            state.counts = state.counts.push(zero)[0]
            state.index += 1
        },
        return: state => state.counts
    })

    return loop({
        index: 0,
        valid: true,
        counts: initial
    }, {
        while: state => state.valid && state.index < tags.length,
        next: state => {
            const byte = integers.widenByte(tags[state.index])
            const tag = integers.andBits(byte, mask)

            if (tag >= in.variants) {
                state.valid = false
            } else if (
                limits != null &&
                    integers.widen(offsets[state.index]) >= limits[tag]
            ) {
                state.valid = false
            } else {
                const count = state.counts[tag]

                state.counts[tag] = count + 1
            }

            state.index += 1
        },
        return: state => ({
            valid: state.valid,
            counts: state.counts
        })
    })
}
