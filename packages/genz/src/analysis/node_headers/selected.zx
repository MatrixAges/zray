import integers from "std:integer"

import type { Selected as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { tags, mask } = in

    const rebased: u32[] = tags.map(tag => 0)[0]

    return loop({
        index: 0,
        bases: in.bases.map(base => base)[0],
        offsets: rebased
    }, {
        while: state => state.index < tags.length,
        next: state => {
            const byte = integers.widenByte(tags[state.index])
            const tag = integers.andBits(byte, mask)
            const offset = state.bases[tag]

            state.offsets[state.index] = offset
            state.bases[tag] = offset + 1
            state.index += 1
        },
        return: state => state.offsets
    })
}
