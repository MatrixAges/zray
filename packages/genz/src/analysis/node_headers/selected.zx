import integers from "std:integer"
import { publish as publishLengths } from "core/column_lengths"
import memory from "memory"

import type { Selected as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { target_tags, target_offsets, tags, mask, count, lengths } = in

    const written = loop({
        index: 0,
        bases: in.bases
    }, {
        while: state => state.index < count,
        next: state => {
            const byte = integers.widenByte(tags[state.index])
            const tag = integers.andBits(byte, mask)
            const offset = state.bases[tag]

            memory.writeU32(target_offsets, state.index, offset)
            state.bases[tag] = offset + 1
            state.index += 1
        }
    })

    const copied = memory.copyBytes(target_tags, 0, tags, 0, count)

    publishLengths({
        target: lengths,
        count
    })
}
