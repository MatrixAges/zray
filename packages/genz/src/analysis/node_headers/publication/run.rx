<Module>
    <Type from="model" as="Fragment" />

    <Args in={Fragment.Input} out={void} />

    <Call fn="host.requireAllocation" in={$in.valid} />

    <Call
        fn="host.appendFragmentExpressions"
        in={[
            $in.target,
            $in.kind == Fragment.FragmentKind.Guard ||
                $in.kind == Fragment.FragmentKind.List
        ]}
    />

    <If
        on={$in.kind != Fragment.FragmentKind.List &&
            $in.kind != Fragment.FragmentKind.Origin}
    >
        <Call
            fn="host.appendFragmentStatements"
            in={[
                $in.target,
                $in.kind
            ]}
        />

        <If on={$in.kind == Fragment.FragmentKind.Collection}>
            <Call
                fn="host.appendFragmentFields"
                in={[
                    $in.target,
                    true
                ]}
            />
        </If>

        <If
            on={$in.kind == Fragment.FragmentKind.Construction ||
                $in.kind == Fragment.FragmentKind.Conversion}
        >
            <Call
                module="storage"
                in={$in.pick([
                    "target",
                    "kind",
                    "sequence"
                ])}
            />

            <Else>
                <Call
                    fn="body_mode"
                    in={$in.pick([
                        "kind",
                        "sequence"
                    ])}
                />

                <Call
                    fn="host.appendFragmentBody"
                    in={[
                        $in.target,
                        $ctx.body_mode
                    ]}
                />
            </Else>
        </If>
    </If>

    <If on={$in.fields && $in.kind != Fragment.FragmentKind.Collection}>
        <Call
            fn="host.appendFragmentFields"
            in={[
                $in.target,
                false
            ]}
        />
    </If>

    <If
        on={$in.kind != Fragment.FragmentKind.Guard &&
            $in.kind != Fragment.FragmentKind.List &&
            $in.kind != Fragment.FragmentKind.Origin}
    >
        <Call
            fn="host.finishGeneratedAst"
            in={[
                $in.lower,
                $in.serial,
                $in.uses_allocator
            ]}
        />
    </If>
</Module>
