<Module>
    <Type from="dense_model" as="Flow" />

    <Args in={Flow.StatementCursor} out={Flow.StatementCursor} />

    <Store from="publication" as="publication" />

    <Call
        fn="append"
        in={{
            statements: $in.statements[$in.row],
            uses_allocator: false
        }}
        setter={[$store.publication.commit]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            running: $in.row + 1 < $in.statements.length
        }}
    />
</Module>
