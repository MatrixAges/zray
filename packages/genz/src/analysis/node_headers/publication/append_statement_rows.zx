import host from "ast_rows"

import type { Input } from "./dense_model"

export type Output = void

export default function (in: Input): Output {
    const statements = in.fragment.statements

    const written = loop(0, {
        while: row => row < statements.length,
        next: row => {
            host.appendStatementRows(in.writer, statements[row])

            row += 1
        }
    })
}
