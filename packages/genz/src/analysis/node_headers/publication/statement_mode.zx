import { FragmentKind, FragmentStatements } from "lowering_host"

export type Input = FragmentKind

export type Output = FragmentStatements

export default function (in: Input): Output {
    return match in {
        FragmentKind.Update => FragmentStatements.Sparse,
        FragmentKind.Collection => FragmentStatements.SparseWithVariables,
        FragmentKind.Conversion => FragmentStatements.SparseWithVariables,
        _ => FragmentStatements.Dense
    }
}
