<Module>
    <Type from="dense_model" as="Dense" />
    <Type from="host" as="Host" />

    <Args in={Dense.Input} out={void} />

    <Call fn="host.requireAllocation" in={$in.fragment.valid} />

    <Call
        fn="host.appendExpressionRows"
        in={[
            $in.writer,
            $in.fragment.expressions,
            null,
            Host.AstPayloadOwnership.Owned
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="statement_row"
            in={{
                writer: $in.writer,
                statements: $in.fragment.statements,
                row: 0,
                running: $in.fragment.statements.length != 0
            }}
        />
    </Loop>

    <Call
        fn="host.finishGeneratedAst"
        in={[
            $in.lower,
            $in.fragment.serial,
            $in.fragment.uses_allocator
        ]}
    />
</Module>
