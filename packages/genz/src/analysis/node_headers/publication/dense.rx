<Module>
    <Type from="dense_model" as="Dense" />

    <Args in={Dense.Fragment} out={void} />

    <Store from="publication" as="publication" />

    <Call
        fn="append"
        in={{
            expressions: $in.expressions,
            uses_allocator: false
        }}
        setter={[$store.publication.commit]}
    />

    <Loop on={$in.running}>
        <Call
            module="statement_row"
            in={{
                statements: $in.statements,
                row: 0,
                running: $in.statements.length != 0
            }}
        />
    </Loop>

    <Call
        fn="append"
        in={{
            serial: $in.serial,
            uses_allocator: $in.uses_allocator
        }}
        setter={[$store.publication.commit]}
    />
</Module>
