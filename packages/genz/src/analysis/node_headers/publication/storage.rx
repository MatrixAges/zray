<Module>
    <Type from="model" as="Fragment" />
    <Type from="host" as="Host" />

    <Args in={Fragment.Body} out={void} />

    <Call fn="host.appendFragmentStorage" in={$in.target} />

    <If on={$in.kind == Fragment.FragmentKind.Conversion && $in.sequence}>
        <Call
            fn="host.appendFragmentBody"
            in={[
                $in.target,
                Host.FragmentBody.ConvertedBinding
            ]}
        />

        <Call
            fn="host.appendFragmentBody"
            in={[
                $in.target,
                Host.FragmentBody.ConvertedBody
            ]}
        />
    </If>
</Module>
