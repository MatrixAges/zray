import integers from "std:integer"

import walk from "./closure/walk"

import type { Table } from "core/type_table/model"

export type Input = {
    types: Table,
    boxed: bool[],
    roots: u32[]
}

export type Output = bool[]

export default function (in: Input): Output {
    const queue: u32[] = []

    const seeded = loop({
        boxed: in.boxed,
        roots: in.roots,
        queue,
        index: 0
    }, {
        while: current => current.index < current.roots.length,
        next: current => {
            const id = current.roots[current.index]
            const index = integers.widen(id)

            if (!current.boxed[index]) {
                current.boxed[index] = true
                current.queue = current.queue.push(id)[0]
            }

            current.index += 1
        }
    })

    return walk({
        types: in.types,
        boxed: seeded.boxed,
        queue: seeded.queue
    })
}
