import bytes from "std:bytes"
import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import emptyFields from "../../../ast/fields/empty"
import { items_field, storage_field } from "./const"
import objectField from "./object_field"

import type { Field } from "../../../ast/fields/model"
import type { Plan, Types, Output } from "./model"

export type Input = {
    plan: Plan,
    types: Types
}

export default function (in: Input): Output {
    const result = loop({
        source: in.plan.source.types,
        origins: in.plan.origins,
        values: in.types.values,
        views: in.types.views,
        records: in.types.records,
        valid: in.types.valid,
        record: 0,
        member: 0,
        fields: emptyFields({})
    }, {
        while: current => current.valid && current.record < current.records.length,
        next: current => {
            const record = current.records[current.record]
            const owner = record.owner
            const list = kind(current.source.kinds[owner]) == Kind.List
            const count = list ? 2 : integers.widen(current.source.second[owner]) + 1

            if (current.member == count) {
                current.record += 1
                current.member = 0
            } else {
                const row: Field = match {
                    list => {
                        name: bytes.fromText(
                            current.member == 0 ? items_field : storage_field
                        ),
                        value: record.start + (current.member == 0 ? 0 : 1),
                        comptime_parameter: false
                    },
                    current.member + 1 == count => {
                        name: current.origins[owner],
                        value: record.start,
                        default_value: record.start + 1,
                        comptime_parameter: false
                    },
                    _ => objectField({
                        source: current.source,
                        record,
                        member: current.member,
                        values: current.values,
                        views: current.views
                    })
                }

                current.fields.name = current.fields.name.push(row.name)[0]
                current.fields.value = current.fields.value.push(row.value)[0]
                current.fields.default_value =
                    current.fields.default_value.push(row.default_value)[0]
                current.fields.comptime_parameter =
                    current.fields.comptime_parameter.push(row.comptime_parameter)[0]
                current.member += 1
            }
        }
    })

    return {
        types: in.types,
        fields: result.fields
    }
}
