import bytes from "std:bytes"
import integers from "std:integer"
import strings from "std:string"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import appendDeclaration from "../../../../ast/declarations/append_constant"
import { ExpressionsKind } from "../../../../printer/model/expressions"
import { view_prefix } from "../const"
import aggregate from "./aggregate"
import list from "./list"

import type { Selection, Build } from "../model"

export type Input = Selection

export type Output = Build

export default function (in: Input): Output {
    const state = in.state
    const index = state.index
    const source = state.source.source
    const target = kind(source.types.kinds[index])
    const name = state.source.names[index]
    const fresh = !state.state_claimed[in.slot]

    const claimed = {
        ...state,
        state_claimed: state.state_claimed.with(in.slot, true)
    }

    const constructed = match {
        target == Kind.List => list({
            ...in,
            state: claimed
        }),
        _ => aggregate({
            state: claimed,
            start: in.start,
            view: false
        })
    }

    const declaration = match {
        fresh => appendDeclaration({
            table: constructed.declarations,
            value: {
                name: bytes.fromText(name),
                type_expr: null,
                value: in.value - 1,
                exported: source.exported
            }
        }),
        _ => {
            table: constructed.declarations,
            valid: true
        }
    }

    const named = {
        ...constructed,
        declarations: declaration.table,
        valid: constructed.valid && declaration.valid,
        tags: constructed.tags.push(ExpressionsKind.Identifier)[0],
        offsets:
            constructed.offsets.push(integers.narrow(constructed.identifier.length))[0],
        identifier: constructed.identifier.push(bytes.fromText(name))[0]
    }

    if (target != Kind.Object && target != Kind.Tuple) {
        return named
    }

    const changed = state.source.changed[index]

    const view_name = strings.join("", [
        view_prefix,
        name
    ])

    const viewed = match {
        changed => aggregate({
            state: named,
            start: in.value + 1,
            view: true
        }),
        _ => named
    }

    const fresh_view = !viewed.view_claimed[in.slot]

    const view_declaration = match {
        fresh_view => appendDeclaration({
            table: viewed.declarations,
            value: {
                name: bytes.fromText(view_name),
                type_expr: null,
                value: changed ? in.view - 1 : in.value,
                exported: source.exported
            }
        }),
        _ => {
            table: viewed.declarations,
            valid: true
        }
    }

    const published = {
        ...viewed,
        declarations: view_declaration.table,
        valid: viewed.valid && view_declaration.valid,
        view_claimed: match {
            fresh_view => viewed.view_claimed.with(in.slot, true),
            _ => viewed.view_claimed
        }
    }

    if (!changed) {
        return published
    }

    return {
        ...published,
        tags: published.tags.push(ExpressionsKind.Identifier)[0],
        offsets:
            published.offsets.push(integers.narrow(published.identifier.length))[0],
        identifier: published.identifier.push(bytes.fromText(view_name))[0]
    }
}
