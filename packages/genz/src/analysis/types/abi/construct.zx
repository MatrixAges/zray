import integers from "std:integer"
import { max_u32 } from "core/const"
import { scalar_string } from "core/type_table/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { named_layout_offset } from "./const"
import emit from "./emit"
import empty from "./empty"
import isNamed from "./named"
import span from "./span"

import type { Plan, Output } from "./model"

export type Input = Plan

export default function (in: Input): Output {
    const ids: u32[] = []
    const values: u32[] = []
    const layouts: u32[] = []

    return loop({
        expressions: empty({}),
        ids,
        values,
        layouts,
        child: in.child,
        remaining: in.order.length,
        valid: true
    }, {
        while: current => current.valid && current.remaining != 0,
        next: current => {
            current.remaining -= 1
            const id = in.order[current.remaining]
            const index = integers.widen(id)
            const target = kind(in.source.types.kinds[index])
            const named = isNamed(target)
            const string =
                target == Kind.Scalar && in.source.types.first[index] == scalar_string
            const count = span({
                target,
                named,
                string
            })

            const base =
                integers.widen(in.source.base) + current.expressions.tags.length
            const end = base + count

            if (end > integers.widen(max_u32)) {
                current.valid = false
            } else {
                const start = integers.narrow(base)
                const value = integers.narrow(end - 1)
                const layout = named ? start + named_layout_offset : value

                current.expressions = emit({
                    table: current.expressions,
                    source: in.source,
                    index,
                    target,
                    child: current.child,
                    start
                })

                current.ids = current.ids.push(id)[0]
                current.values = current.values.push(value)[0]
                current.layouts = current.layouts.push(layout)[0]
                current.child = value
            }
        },
        return: current => current.pick([
            "expressions",
            "ids",
            "values",
            "layouts",
            "valid"
        ])
    })
}
