import type { Expressions } from "./model"

export type Input = {}

export type Output = Expressions

export default function (in: Input): Output {
    return {
        tags: [],
        offsets: [],
        identifier: [],
        primitive: [],
        field_target: [],
        field_name: [],
        pointer: [],
        const_pointer: [],
        optional_type: [],
        const_slice: [],
        error_set: [],
        error_union_payload: [],
        error_union_errors: [],
        error_union_inferred: [],
        call_callee: [],
        call_arguments: []
    }
}
