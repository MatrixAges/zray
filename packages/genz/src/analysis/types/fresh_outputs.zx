import integers from "std:integer"
import memory from "memory"

import flags from "../facts/flags"
import children from "./fresh_outputs/children"

import type { Allocator } from "memory"
import type { Program } from "../model"

export type Input = {
    program: Program,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { program, allocator } = in

    const seen: u32[] = program.types.kinds.map(kind => 0)[0]
    const pending: u32[] = []

    const fresh = flags({
        count: program.functions.input_types.length,
        allocator
    })

    const processed = loop({
        types: program.types,
        functions: program.functions,
        seen,
        pending,
        index: 0
    }, {
        while: current => current.index < current.functions.input_types.length,
        next: current => {
            const initial = children({
                types: current.types,
                id: current.functions.output_types[current.index],
                pending: current.pending,
                count: 0
            })

            const visited = loop({
                types: current.types,
                input: current.functions.input_types[current.index],
                round: integers.narrow(current.index + 1),
                seen: current.seen,
                pending: initial.pending,
                count: initial.count,
                fresh: true
            }, {
                while: walk => walk.fresh && walk.count != 0,
                next: walk => {
                    walk.count -= 1

                    const id = walk.pending[walk.count]
                    const index = integers.widen(id)

                    if (id == walk.input) {
                        walk.fresh = false
                    } else if (walk.seen[index] != walk.round) {
                        walk.seen[index] = walk.round

                        const nested = children({
                            types: walk.types,
                            id,
                            pending: walk.pending,
                            count: walk.count
                        })

                        walk.pending = nested.pending
                        walk.count = nested.count
                    }
                }
            })

            current.seen = visited.seen
            current.pending = visited.pending

            memory.writeBool(fresh.buffer, current.index, visited.fresh)
            current.index += 1
        }
    })

    return fresh.values
}
