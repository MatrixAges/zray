import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Columns } from "./model"

export type Input = {
    columns: Columns,
    row: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { columns, row } = in

    if (!columns.track_touched) {
        return false
    }

    const index = integers.widen(row)
    const no_abi = columns.abi_types[index] == max_u32
    const no_state = columns.state_types[index] == max_u32
    const no_view = columns.views[index] == max_u32

    return (
        - no_abi
        - and no_state
        - and no_view
    )
}
