import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { Columns } from "./model"

export type Input = {
    columns: Columns,
    row: u32
}

export type Output = void

export default function (in: Input): Output {
    const { columns, row } = in

    const touched = columns.touched

    if (touched == null) {
        return
    }

    const index = integers.widen(row)
    const has_abi = memory.readU32(columns.abi_types, index) != max_u32
    const has_state = memory.readU32(columns.state_types, index) != max_u32
    const has_view = memory.readU32(columns.views, index) != max_u32

    const registered = (
        - has_abi
        - or has_state
        - or has_view
    )

    if (registered) {
        return
    }

    const count = memory.readU32(touched.count, 0)

    memory.writeU32(touched.rows, integers.widen(count), row)
    memory.writeU32(touched.count, 0, count + 1)
}
