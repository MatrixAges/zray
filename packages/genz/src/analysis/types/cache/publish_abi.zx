import record from "./record"

import type { Output as Nodes } from "../abi/model"
import type { Columns } from "./model"

export type Input = {
    nodes: Nodes.Pick("ids"),
    columns: Columns
}

export type Output = u32[]

export default function (in: Input): Output {
    const { nodes, columns } = in

    const empty: u32[] = []

    return loop({
        index: 0,
        touched: empty
    }, {
        while: state => state.index < nodes.ids.length,
        next: state => {
            const row = nodes.ids[state.index]

            if (record({
                columns,
                row
            })) {
                const seen = loop({
                    position: 0,
                    found: false
                }, {
                    while: check => !check.found && check.position < state.touched.length,
                    next: check => {
                        check.found = state.touched[check.position] == row
                        check.position += 1
                    },
                    return: check => check.found
                })

                if (!seen) {
                    state.touched = state.touched.push(row)[0]
                }
            }

            state.index += 1
        },
        return: state => state.touched
    })
}
