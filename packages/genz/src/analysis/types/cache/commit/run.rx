<Module>
    <Type from="model" as="Commit" />
    <Type from="../../../node_headers/model" as="Headers" />

    <Args in={Commit.Input} out={Commit.Result} />

    <Call module="../../../node_headers/payload/validated" in={$in.ast} />

    <If on={$ctx.validated == Headers.Check.Valid}>
        <If on={$in.abi != null}>
            <Call
                fn="../publish_abi"
                in={{
                    nodes: $in.abi,
                    columns: $in.columns
                }}
            />

            <Return
                value={{
                    check: $ctx.validated,
                    touched: $ctx.publish_abi
                }}
            />
        </If>

        <If on={$in.state != null}>
            <Call
                fn="../publish_shared"
                in={{
                    entries: $in.state,
                    columns: $in.columns
                }}
            />

            <Return
                value={{
                    check: $ctx.validated,
                    touched: $ctx.publish_shared
                }}
            />
        </If>
    </If>

    <Return
        value={{
            check: $ctx.validated,
            touched: []
        }}
    />
</Module>
