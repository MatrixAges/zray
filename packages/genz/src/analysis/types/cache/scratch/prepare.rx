<Module>
    <Type from="model" as="Scratch" />

    <Args in={Scratch.Input} out={bool} />

    <Call
        fn="grow"
        in={$in.pick([
            "storage",
            "items",
            "count"
        ])}
    />

    <If on={$ctx.grow != null}>
        <Call
            fn="bind"
            in={{
                items: $in.items,
                tables: $in.tables,
                count: $in.count,
                stride: $ctx.grow
            }}
        />

        <Return value={true} />
    </If>

    <Return value={false} />
</Module>
