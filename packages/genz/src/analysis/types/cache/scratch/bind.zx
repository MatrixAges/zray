import {
    abi_types_column,
    abi_layouts_column,
    state_types_column,
    state_layouts_column,
    views_column,
    touched_column
} from "./const"

export type Input = u64

export type Output = {
    abi_types: u64,
    abi_layouts: u64,
    state_types: u64,
    state_layouts: u64,
    views: u64,
    touched: u64
}

export default function (in: Input): Output {
    return {
        abi_types: abi_types_column * in,
        abi_layouts: abi_layouts_column * in,
        state_types: state_types_column * in,
        state_layouts: state_layouts_column * in,
        views: views_column * in,
        touched: touched_column * in
    }
}
