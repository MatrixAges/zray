import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { Tables } from "./model"

export type Input = Tables

export type Output = void

export default function (in: Input): Output {
    const { count } = in.touched

    const length = integers.widen(memory.readU32(count, 0))

    if (length == 0) {
        return
    }

    const rows = memory.u32Views(in.touched.rows)
    const first: u64 = 0

    const reset = loop(first, {
        while: index => index < length,
        next: index => {
            const row = integers.widen(rows[index])
            memory.writeU32(in.abi_types, row, max_u32)
            memory.writeU32(in.abi_layouts, row, max_u32)
            memory.writeU32(in.state_types, row, max_u32)
            memory.writeU32(in.state_layouts, row, max_u32)
            memory.writeU32(in.views, row, max_u32)
            index += 1
        }
    })

    memory.writeU32(count, 0, 0)
}
