import integers from "std:integer"
import { max_u32 } from "core/const"

export type Input = {
    touched: u32[],
    dirty: u32
}

export type Output = {
    count: u64,
    sentinel: u32
}

export default function (in: Input): Output {
    const requested = integers.widen(in.dirty)

    return {
        count: match {
            requested <= in.touched.length => requested,
            _ => in.touched.length
        },
        sentinel: max_u32
    }
}
