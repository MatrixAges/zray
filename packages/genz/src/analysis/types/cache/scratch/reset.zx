import integers from "std:integer"
import { max_u32 } from "core/const"
import memory from "memory"

import type { U32Buffer } from "memory"
import type { Columns } from "../model"

export type Input = Columns.Omit("touched") & {
    rows: u32[],
    count: U32Buffer
}

export type Output = void

export default function (in: Input): Output {
    const first: u64 = 0

    const reset = loop(first, {
        while: index => index < in.rows.length,
        next: index => {
            const row = integers.widen(in.rows[index])
            memory.writeU32(in.abi_types, row, max_u32)
            memory.writeU32(in.abi_layouts, row, max_u32)
            memory.writeU32(in.state_types, row, max_u32)
            memory.writeU32(in.state_layouts, row, max_u32)
            memory.writeU32(in.views, row, max_u32)
            index += 1
        }
    })

    memory.writeU32(in.count, 0, 0)
}
