import bytes from "std:bytes"
import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import emptyFields from "../../../ast/fields/empty"

import type { Input as Source, Output, Types } from "./model"

export type Input = {
    source: Source,
    types: Types
}

export default function (in: Input): Output {
    const result = loop({
        source: in.source.types,
        values: in.types.values,
        valid: in.types.valid,
        type_index: 0,
        field_index: 0,
        field_end: 0,
        fields: emptyFields({})
    }, {
        while: current => current.valid &&
            (
                current.type_index < current.source.kinds.length ||
                    current.field_index < current.field_end
            ),
        next: current => {
            if (current.field_index < current.field_end) {
                const field = current.field_index

                const name = bytes.fromText(current.source.field_names[field])
                const field_type = integers.widen(current.source.field_types[field])

                current.fields.name = current.fields.name.push(name)[0]
                current.fields.value =
                    current.fields.value.push(current.values[field_type])[0]
                current.fields.default_value =
                    current.fields.default_value.push(null)[0]
                current.fields.comptime_parameter =
                    current.fields.comptime_parameter.push(false)[0]
                current.field_index += 1
            } else {
                const index = current.type_index

                if (kind(current.source.kinds[index]) == Kind.Object) {
                    current.field_index = integers.widen(current.source.first[index])
                    current.field_end = current.field_index +
                        integers.widen(current.source.second[index])
                }

                current.type_index += 1
            }
        }
    })

    return {
        types: in.types,
        fields: result.fields
    }
}
