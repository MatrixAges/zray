import { max_u32 } from "core/const"
import memory from "memory"

import type { Columns } from "../cache/model"

export type Input = Columns.Omit("touched") & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { count } = in

    memory.allocateU32Views(in.state_types, count)
    memory.allocateU32Views(in.state_layouts, count)
    memory.allocateU32Views(in.views, count)

    memory.fillU32Buffer(in.abi_types, count, max_u32)
    memory.fillU32Buffer(in.abi_layouts, count, max_u32)
    memory.fillU32Buffer(in.state_types, count, max_u32)
    memory.fillU32Buffer(in.state_layouts, count, max_u32)
    memory.fillU32Buffer(in.views, count, max_u32)
}
