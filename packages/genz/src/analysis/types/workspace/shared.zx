import { max_u32 } from "core/const"

export type Input = {
    count: u64
}

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < in.count,
        next: state => {
            state.items = state.items.push(max_u32)[0]
            state.index += 1
        },
        return: state => state.items
    })
}
