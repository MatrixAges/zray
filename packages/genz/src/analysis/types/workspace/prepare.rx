<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Input} out={Workspace.Output} />

    <If on={$in.reusable}>
        <If on={$in.body}>
            <Return
                value={[
                    Workspace.Step.Borrow,
                    Workspace.Step.Ast,
                    Workspace.Step.Bind,
                    Workspace.Step.Context
                ]}
            />
        </If>

        <Return
            value={[
                Workspace.Step.Borrow,
                Workspace.Step.Ast,
                Workspace.Step.Bind
            ]}
        />
    </If>

    <If on={$in.body}>
        <Return
            value={[
                Workspace.Step.Ast,
                Workspace.Step.Allocate,
                Workspace.Step.Bind,
                Workspace.Step.Context
            ]}
        />
    </If>

    <Return
        value={[
            Workspace.Step.Ast,
            Workspace.Step.Allocate,
            Workspace.Step.Bind
        ]}
    />
</Module>
