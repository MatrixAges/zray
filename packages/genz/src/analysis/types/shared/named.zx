import bytes from "std:bytes"
import integers from "std:integer"
import strings from "std:string"

import named from "../abi/emit/named"
import { view_prefix } from "../state/const"
import stateKey from "../state/key"
import stateName from "../state/name"
import { Mode } from "./model"

import type { Expressions } from "../abi/model"
import type { Input as Source, Step } from "./model"

export type Input = {
    table: Expressions,
    source: Source,
    step: Step
}

export type Output = Expressions

export default function (in: Input): Output {
    const index = integers.widen(in.step.request.id)

    const state = stateName({
        names: in.source.abi.names,
        key: stateKey({
            keys: in.source.keys,
            index
        }),
        index
    })

    const name = match {
        in.step.request.mode == Mode.View => strings.join("", [
            view_prefix,
            state
        ]),
        _ => state
    }

    return named({
        table: in.table,
        name: bytes.fromText(name),
        start: in.step.base,
        pointer: in.step.request.mode == Mode.State && in.source.borrowed[index],
        mutable: false
    })
}
