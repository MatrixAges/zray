import integers from "std:integer"
import kind from "core/type_table/kind"

import abi from "../abi/emit"
import wrapped from "../abi/emit/wrapped"
import empty from "../abi/empty"
import { Action } from "./model"
import named from "./named"

import type { Plan, Output } from "./model"

export type Input = Plan

export default function (in: Input): Output {
    return loop({
        expressions: empty({}),
        index: 0
    }, {
        while: current => in.valid && current.index < in.steps.length,
        next: current => {
            const step = in.steps[current.index]
            const table = current.expressions
            const index = integers.widen(step.request.id)

            current.expressions = match step.action {
                Action.Abi => abi({
                    table,
                    source: in.source.abi,
                    index,
                    target: kind(in.source.abi.types.kinds[index]),
                    child: step.child,
                    start: step.base
                }),
                Action.Optional => wrapped({
                    table,
                    child: step.child,
                    slice: false
                }),
                Action.Slice => wrapped({
                    table,
                    child: step.child,
                    slice: true
                }),
                _ => named({
                    table,
                    source: in.source,
                    step
                })
            }

            current.index += 1
        },
        return: current => {
            expressions: current.expressions,
            entries: in.entries,
            valid: in.valid
        }
    })
}
