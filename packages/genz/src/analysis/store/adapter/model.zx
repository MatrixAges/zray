import type { State as Context, Input as Bases } from "../../../ast/context/model"
import type { Variables } from "../../../ast/context/model"
import type { Columns as Functions } from "../../../ast/declarations/function"
import type { Columns as Forms } from "../../../ast/expressions/forms/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Statements } from "../../../ast/statements/model"

export type Input = {
    frame: Lowering,
    mapping: u32[],
    readable: bool[],
    store_count: u64,
    pending_name: u8[],
    bases: Bases,
    declaration_base: u32
}

export type Extra = ExpressionExtensions.Pick(
    "error_union_payload",
    "error_union_errors",
    "error_union_inferred",
    "container_type_fields_start",
    "container_type_fields_len",
    "container_type_declarations_start",
    "container_type_declarations_len"
)

export type State = {
    source: Input,
    context: Context,
    extra: Extra,
    fields: FieldRows,
    declarations: Functions
}

export type Readable = {
    state: State,
    names: u8[][],
    types: u32[],
    values: u32[]
}

export type Patched = {
    readable: Readable,
    patch: u32
}

export type Node = {
    state: State,
    id: u32
}

export type Output = {
    expressions: Expressions,
    forms: Forms,
    extra: Extra,
    statements: Statements,
    variables: Variables,
    fields: FieldRows,
    declarations: Functions,
    root: u32,
    serial: u64,
    valid: bool
}

import type { ExpressionExtensions, FieldRows } from "ast_rows"
import type { Lowering } from "lowering_host"
