<Module>
    <Type from="model" as="State" />

    <Args in={State.Fragment} out={u8[][]?} />

    <If on={!$in.snapshot.valid}>
        <Return value={null} />
    </If>

    <Call fn="snapshot" in={$in} />

    <Call
        module="../../../printer/render"
        in={{
            source: $ctx.snapshot
        }}
    />

    <Return value={$ctx.render} />
</Module>
