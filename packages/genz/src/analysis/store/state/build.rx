<Module>
    <Type from="model" as="State" />

    <Args in={State.Input} out={bool} />

    <Call fn="initialize" in={$in} />

    <Task name="storage" out={$ctx.render_part}>
        <Call module="../storage/build" in={$ctx.initialize} />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build,
                writer: $in.writer
            }}
        />
    </Task>

    <If on={!$ctx.task.storage}>
        <Return value={false} />
    </If>

    <Task name="lifecycle" out={$ctx.render_part}>
        <Call
            module="../lifecycle/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build,
                writer: $in.writer
            }}
        />
    </Task>

    <If on={!$ctx.task.lifecycle}>
        <Return value={false} />
    </If>

    <Task name="regions" out={$ctx.render_part}>
        <Call
            module="../regions/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases,
                declaration_base: 0
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build,
                writer: $in.writer
            }}
        />
    </Task>

    <If on={!$ctx.task.regions}>
        <Return value={false} />
    </If>

    <Task name="request" out={$ctx.render_part}>
        <Call
            module="../request/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases,
                declaration_base: 0,
                execute: $in.execute,
                io: $in.io,
                process: $in.process
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build,
                writer: $in.writer
            }}
        />
    </Task>

    <Return value={$ctx.task.request} />
</Module>
