<Module>
    <Type from="model" as="State" />

    <Args in={State.Input} out={u8[][][]?} />

    <Call fn="initialize" in={$in} />

    <Task name="storage" out={$ctx.render_part}>
        <Call module="../storage/build" in={$ctx.initialize} />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build
            }}
        />
    </Task>

    <If on={$ctx.task.storage == null}>
        <Return value={null} />
    </If>

    <Task name="lifecycle" out={$ctx.render_part}>
        <Call
            module="../lifecycle/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build
            }}
        />
    </Task>

    <If on={$ctx.task.lifecycle == null}>
        <Return value={null} />
    </If>

    <Task name="regions" out={$ctx.render_part}>
        <Call
            module="../regions/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases,
                declaration_base: 0
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build
            }}
        />
    </Task>

    <If on={$ctx.task.regions == null}>
        <Return value={null} />
    </If>

    <Task name="request" out={$ctx.render_part}>
        <Call
            module="../request/build"
            in={{
                objects: $in.objects,
                bases: $ctx.initialize.bases,
                declaration_base: 0,
                execute: $in.execute,
                io: $in.io,
                process: $in.process
            }}
        />

        <Call
            module="render_part"
            in={{
                snapshot: $ctx.build
            }}
        />
    </Task>

    <If on={$ctx.task.request == null}>
        <Return value={null} />
    </If>

    <Return
        value={[
            ($ctx.task.storage ?? []),
            ($ctx.task.lifecycle ?? []),
            ($ctx.task.regions ?? []),
            ($ctx.task.request ?? [])
        ]}
    />
</Module>
