<Module>
    <Type from="model" as="Storage" />

    <Args in={Storage.Input} out={Storage.Output} />

    <Call
        fn="../lifecycle/policy"
        in={{
            objects: $in.objects
        }}
    />

    <Call
        fn="prepare"
        in={{
            source: $in,
            policy: $ctx.policy
        }}
    />

    <Call fn="imports" />
    <Call fn="initials" />
    <Call fn="shared" />
    <Call fn="region" />
    <Call fn="retained" />
    <Call fn="slots" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
