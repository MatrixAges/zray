import { lowerType } from "lowering_host"

import type { Types as Input } from "./declare"

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < in.ids.length,
        next: state => {
            state.values = state.values.push(
                lowerType(
                    in.frame,
                    in.ids[state.index],
                    false
                )
            )[0]
            state.index += 1
        },
        return: state => state.values
    })
}
