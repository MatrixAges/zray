<Module>
    <Type from="initialize_input" as="Initial" />
    <Type from="../rows" as="AST" />

    <Args in={Initial.Input} out={u64} />

    <Call
        fn="policy"
        in={{
            mode: $in.mode,
            count: $in.store_count
        }}
    />

    <If on={!$ctx.policy}>
        <Return value={0} />
    </If>

    <Call
        fn="../rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call fn="../rows.astFieldCount" in={$in.writer} />

    <Call
        fn="null_fields"
        in={{
            ...$in.omit([
                "writer",
                "origin"
            ]),
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="pending_object" />

    <Call
        fn="../../control/writes"
        in={{
            control: $in.control,
            first: $in.first,
            count: $in.count
        }}
    />

    <Call
        fn="pending_binding"
        in={{
            object: $ctx.pending_object,
            mutable: $ctx.writes
        }}
    />

    <Call fn="../rows.requireAllocation" in={$ctx.pending_binding.valid} />

    <Call
        fn="../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.pending_binding.expressions,
            $ctx.pending_binding.forms,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../rows.appendOwnedAstFields"
        in={[
            $in.writer,
            $ctx.pending_binding.fields
        ]}
    />

    <Call
        fn="../rows.publishAstBindingRows"
        in={[
            $in.writer,
            $ctx.pending_binding.statements
        ]}
    />

    <Return value={$ctx.publishAstBindingRows} />
</Module>
