import expressionStatement from "../../../ast/context/expression_statement"
import initialize from "../../../ast/context/initialize"
import commit from "./commit_value"

import type { Input as Bases } from "../../../ast/context/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"
import type { Columns as Statements } from "../../../ast/statements/model"

export type Input = Bases

export type Output = {
    expressions: Expressions,
    statements: Statements,
    valid: bool
}

export default function (in: Input): Output {
    const result = commit(initialize(in))

    const state = expressionStatement({
        state: result.state,
        value: result.id
    })

    return {
        expressions: state.expressions,
        statements: state.statements,
        valid: state.valid
    }
}
