<Module>
    <Type from="model" as="Lifecycle" />

    <Args in={Lifecycle.Input} out={Lifecycle.Output} />

    <Call
        fn="policy"
        in={{
            objects: $in.objects
        }}
    />

    <Call
        fn="prepare"
        in={{
            source: $in,
            policy: $ctx.policy
        }}
    />

    <Call fn="initialize" />
    <Call fn="count" />
    <Call fn="multiple" />
    <Call fn="permissions" />
    <Call fn="validated" />
    <Call fn="apply" />

    <Call module="commit/build" />

    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
