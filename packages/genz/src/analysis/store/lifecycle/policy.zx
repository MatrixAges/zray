import memory from "memory"

import { Policy } from "./model"

import type { Objects } from "../objects/model"

export type Input = {
    objects: Objects
}

export type Output = Policy

export default function (in: Input): Output {
    const objects = in.objects
    const individual = objects.independent

    return loop({
        index: 0,
        policy: Policy.ReadOnly,
        complete: false
    }, {
        while: current => current.index < objects.count && !current.complete,
        next: current => {
            if (memory.readColumnBool(objects.writable, current.index)) {
                const independent = match {
                    individual == null => objects.uniform_independent,
                    _ => memory.readColumnBool(individual, current.index)
                }

                current.policy = independent ? Policy.Independent : Policy.Shared
                current.complete = individual == null || !independent
            }

            current.index += 1
        },
        return: current => current.policy
    })
}
