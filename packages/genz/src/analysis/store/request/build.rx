<Module>
    <Type from="model" as="Request" />

    <Args in={Request.Input} out={Request.Output} />

    <Call
        fn="../lifecycle/policy"
        in={{
            objects: $in.objects
        }}
    />

    <Call
        fn="prepare"
        in={{
            source: $in,
            policy: $ctx.policy
        }}
    />

    <Call fn="factory/shared" />
    <Call fn="factory/retained" />
    <Call fn="factory/slots" />
    <Call fn="factory/create" />

    <Call module="execute/execute" />
    <Call module="deinitialize/deinitialize" />
    <Call module="commit/commit" />

    <Call fn="container" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
