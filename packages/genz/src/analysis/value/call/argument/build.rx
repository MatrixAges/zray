<Module>
    <Type from="model" as="Borrow" />
    <Type from="rows" as="AST" />

    <Args in={Borrow.Publication} out={u32} />

    <Call
        fn="prepare"
        in={$in.omit([
            "writer",
            "frame",
            "sequence"
        ])}
    />

    <Call module="object" in={$in.pick(["object"])} />

    <Call fn="../../../aggregate/binding/reference" in={$ctx.prepare.binding} />
    <Call fn="rows.requireAllocation" in={$ctx.prepare.valid && $ctx.reference.valid} />

    <Call
        fn="rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.reference.name
        ]}
    />

    <Call
        fn="rows.retainAstIds"
        in={[
            $in.writer,
            $ctx.prepare.cast_arguments
        ]}
    />

    <Call
        fn="../../../aggregate/binding/operand_rows"
        in={{
            name: $ctx.retainLoweringText,
            value: $ctx.prepare.value
        }}
    />

    <Call
        fn="result"
        in={{
            bound: $ctx.reference,
            identifiers: $ctx.operand_rows.expressions.identifier,
            cast_arguments: $ctx.retainAstIds,
            values: $in.values,
            object: $ctx.object
        }}
    />

    <If on={$ctx.object != null}>
        <Call
            fn="rows.appendAstObjectFields"
            in={[
                $in.writer,
                $ctx.object.fields
            ]}
        />
    </If>

    <Call
        fn="rows.appendAstBindingRows"
        in={[
            $in.writer,
            $in.sequence,
            $ctx.operand_rows.statements
        ]}
    />

    <Call
        fn="rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.result.expressions.rows,
            $ctx.result.expressions.forms,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="rows.finishGeneratedAst"
        in={[
            $in.frame,
            $ctx.reference.serial,
            false
        ]}
    />

    <Return value={$ctx.result.root} />
</Module>
