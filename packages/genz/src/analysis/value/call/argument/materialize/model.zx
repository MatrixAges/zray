import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { U64Buffer } from "memory"
import type { Input as Routing } from "../route"

export type Input = {
    lowering: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    route: Routing,
    id: u32,
    type_id: u32,
    operand?: u32,
    items: u32[]
}

export type Call = Input.Pick("writer", "sequence", "id", "operand")

export type Output = u32

export type Object = {
    lowering: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    type_id: u32,
    evaluation: u32[],
    fields: u32[],
    field_indices: u32[],
    field_names: string[],
    convert: bool,
    cache_reads: U64Buffer
}

export type Observed = {
    evaluated: u32[],
    counts: u64[]
}

export type ObjectBorrow = {
    source: Object,
    values: u32[]
}

export type Tuple = {
    lowering: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    type_id: u32,
    items: u32[]
}
