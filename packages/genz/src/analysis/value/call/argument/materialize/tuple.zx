import host from "lowering_host"

import type { Tuple as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const published = loop(0, {
        while: index => index < in.items.length,
        next: index => {
            const value = host.lowerBorrowedOperand(in.frame, in.items[index])

            host.publishBorrowedTupleElement(in.tuple, index, value)

            index += 1
        }
    })

    return host.finishBorrowedTuple(in.tuple)
}
