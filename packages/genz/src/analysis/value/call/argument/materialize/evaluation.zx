import integers from "std:integer"
import { borrowedOperandCacheValue, lowerBorrowedOperand } from "ast_rows"
import host from "lowering_host"
import memory from "memory"

import bindOperand from "../../../../aggregate/execute/bind_operand"

import type { Object as Input, Observed as Output } from "./model"

export default function (in: Input): Output {
    const evaluated: u32[] = []
    const counts: u64[] = []

    return loop({
        evaluated,
        counts,
        index: 0
    }, {
        while: state => state.index < in.evaluation.length,
        next: state => {
            const id = in.evaluation[state.index]
            const value = lowerBorrowedOperand(in.writer, in.sequence, id)

            const bound = bindOperand({
                frame: in.lowering,
                writer: in.writer,
                sequence: in.sequence,
                value
            })

            const prior = memory.readU64(in.cache_reads, integers.widen(id))

            const cached = match {
                in.convert =>
                    borrowedOperandCacheValue(in.writer, in.sequence, id, bound),
                _ => bound
            }

            host.cacheLoweredOperand(in.lowering, id, cached)

            state.evaluated = state.evaluated.push(bound)[0]
            state.counts = state.counts.push(prior)[0]
            state.index += 1
        },
        return: state => state.omit(["index"])
    })
}
