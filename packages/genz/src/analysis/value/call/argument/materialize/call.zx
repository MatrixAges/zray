import { emitBorrowedCall, lowerBorrowedOperand } from "ast_rows"

import type { Call as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const operand = in.operand ?? 0
    const value = lowerBorrowedOperand(in.writer, in.sequence, operand)

    return emitBorrowedCall(in.writer, in.sequence, in.id, value)
}
