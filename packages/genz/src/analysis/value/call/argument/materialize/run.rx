<Module>
    <Type from="model" as="Argument" />
    <Type from="../route" as="Route" />

    <Args in={Argument.Input} out={Argument.Output} />

    <Call fn="../route" in={$in.route} />

    <Switch on={$ctx.route}>
        <Case value={Route.Output.Object}>
            <Call
                fn="index.materializeBorrowedObject"
                in={[
                    $in.writer,
                    $in.sequence,
                    $in.id
                ]}
            />

            <Return value={$ctx.materializeBorrowedObject} />
        </Case>

        <Case value={Route.Output.Tuple}>
            <Call
                fn="prepare_tuple"
                in={$in.pick([
                    "lowering",
                    "writer",
                    "sequence",
                    "type_id",
                    "items"
                ])}
            />

            <Call module="../build" />

            <Return value={$ctx.build} />
        </Case>

        <Case value={Route.Output.Call}>
            <Call
                fn="call"
                in={$in.pick([
                    "writer",
                    "sequence",
                    "id",
                    "operand"
                ])}
            />

            <Return value={$ctx.call} />
        </Case>

        <Case value={Route.Output.Existing}>
            <Call
                fn="existing"
                in={$in.pick([
                    "lowering",
                    "writer",
                    "sequence",
                    "id",
                    "type_id",
                    "state_active",
                    "queries"
                ])}
            />

            <Return value={$ctx.existing} />
        </Case>
    </Switch>
</Module>
