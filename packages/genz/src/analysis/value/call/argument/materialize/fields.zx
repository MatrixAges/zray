import { lowerExistingBorrowedOperand } from "ast_rows"

import type { Object as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const initial: u32[] = []

    return loop({
        values: initial,
        index: 0
    }, {
        while: state => state.index < in.fields.length,
        next: state => {
            const value = lowerExistingBorrowedOperand(
                in.writer,
                in.sequence,
                in.fields[state.index]
            )

            state.values = state.values.push(value)[0]
            state.index += 1
        },
        return: state => state.values
    })
}
