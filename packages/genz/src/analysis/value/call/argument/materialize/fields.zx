import host from "lowering_host"

import type { Object as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const published = loop(0, {
        while: index => index < in.fields.length,
        next: index => {
            const value =
                host.lowerExistingBorrowedOperand(in.frame, in.fields[index])

            host.publishBorrowedField(in.object, index, value)

            index += 1
        }
    })
}
