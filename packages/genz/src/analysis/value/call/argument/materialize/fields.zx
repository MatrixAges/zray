import integers from "std:integer"

import existing from "./existing"

import type { Object as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const initial: u32[] = []

    return loop({
        values: initial,
        index: 0
    }, {
        while: state => state.index < in.fields.length,
        next: state => {
            const id = in.fields[state.index]

            const value = existing({
                ...in.pick([
                    "lowering",
                    "writer",
                    "sequence",
                    "state_active",
                    "queries"
                ]),
                id,
                type_id: in.expression_types[integers.widen(id)]
            })

            state.values = state.values.push(value)[0]
            state.index += 1
        },
        return: state => state.values
    })
}
