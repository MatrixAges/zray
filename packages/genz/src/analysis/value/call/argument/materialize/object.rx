<Module>
    <Type from="model" as="Argument" />

    <Args in={Argument.Object} out={Argument.Output} />

    <Call fn="evaluation" in={$in} />
    <Call fn="fields" in={$in} />

    <Call
        fn="prepare_object"
        in={{
            source: $in,
            observed: $ctx.evaluation,
            values: $ctx.fields
        }}
    />

    <Call module="../build" />

    <Return value={$ctx.build} />
</Module>
