<Module>
    <Type from="model" as="Argument" />

    <Args in={Argument.Object} out={Argument.Output} />

    <Call fn="evaluation" in={$in} />
    <Call fn="fields" in={$in} />

    <Call
        fn="../../../../aggregate/execute/retire_operands"
        in={{
            evaluation: $in.evaluation,
            prior: $ctx.evaluation.counts,
            references: $ctx.evaluation.evaluated,
            cache_reads: $in.cache_reads
        }}
    />

    <Call
        fn="../../../../statements/rows.requireAllocation"
        in={$ctx.retire_operands.valid}
    />

    <If on={$ctx.retire_operands.rows != null}>
        <Call
            fn="../../../../statements/rows.appendAstBindingRows"
            in={[
                $in.writer,
                $in.sequence,
                $ctx.retire_operands.rows
            ]}
        />
    </If>

    <Call
        fn="prepare_object"
        in={{
            source: $in,
            values: $ctx.fields
        }}
    />

    <Call module="../build" />

    <Return value={$ctx.build} />
</Module>
