import integers from "std:integer"
import { max_u32 } from "core/const"

import type { Input, Prepared as Output } from "./model"

export default function (in: Input): Output {
    const base = integers.widen(in.expression_base)
    const layout = in.layout

    const start = match {
        layout != null => base + 2,
        in.object != null => base + 1,
        _ => base
    }

    const valid = start + 1 < integers.widen(max_u32)

    const binding_base = match valid {
        true => integers.narrow(start),
        _ => in.expression_base
    }

    const value = match {
        layout != null && valid => integers.narrow(base + 1),
        in.object != null => in.expression_base,
        _ => in.value
    }

    const cast_arguments = match {
        layout != null && valid => [
            layout,
            in.expression_base
        ],
        _ => []
    }

    return {
        binding: {
            expression_base: binding_base,
            serial: in.serial
        },
        value,
        cast_arguments,
        valid
    }
}
