import operandColumns from "../../../../ast/rows/operands_columns"
import {
    ExpressionsBuiltinName,
    ExpressionsKind
} from "../../../../printer/model/expressions"

import type { Reference as Input, Output } from "./model"

export default function (in: Input): Output {
    const { bound, identifiers, cast_arguments, object } = in

    const tuple = cast_arguments.length != 0

    const tags = match {
        tuple => [
            ExpressionsKind.Tuple,
            ExpressionsKind.Builtin,
            ExpressionsKind.Identifier,
            ExpressionsKind.AddressOf
        ],
        object != null => [
            ExpressionsKind.Object,
            ExpressionsKind.Identifier,
            ExpressionsKind.AddressOf
        ],
        _ => [
            ExpressionsKind.Identifier,
            ExpressionsKind.AddressOf
        ]
    }

    const offsets: u32[] = match {
        tuple => [
            0,
            0,
            0,
            0
        ],
        object != null => [
            0,
            0,
            0
        ],
        _ => [
            0,
            0
        ]
    }

    const operands = match tuple {
        true => {
            tuple: [in.values],
            builtin_name: [ExpressionsBuiltinName.As],
            builtin_arguments: [cast_arguments]
        },
        _ => {
            tuple: [],
            builtin_name: [],
            builtin_arguments: []
        }
    }

    const fields = match {
        object != null => object.expression.omit([
            "tags",
            "offsets"
        ]),
        _ => {
            object_type_expr: [],
            object_fields_start: [],
            object_fields_len: []
        }
    }

    return {
        expressions: operandColumns({
            tags,
            offsets,
            ...operands,
            identifier: identifiers,
            address_of: [bound.root],
            ...fields
        }),
        root: bound.root + 1
    }
}
