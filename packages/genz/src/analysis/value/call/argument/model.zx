import type { AstIdentifierRows, AstOperandRows, AstSequence } from "ast_rows"
import type { Target } from "../../../aggregate/binding/publication"
import type {
    Input as Binding,
    Output as Bound
} from "../../../aggregate/binding/reference"
import type {
    Input as Object,
    Output as ObjectRows
} from "../../../aggregate/object/model"

export type Input = {
    value: u32,
    layout?: u32,
    values: u32[],
    expression_base: u32,
    serial: u64,
    object?: Object
}

export type Publication = Input & Target & {
    sequence: AstSequence
}

export type ObjectInput = Input.Pick("object")

export type ObjectOutput = ObjectRows?

export type Prepared = {
    binding: Binding,
    value: u32,
    cast_arguments: u32[],
    valid: bool
}

export type Reference = {
    bound: Bound,
    identifiers: AstIdentifierRows,
    values: u32[],
    cast_arguments: u32[],
    object?: ObjectRows
}

export type Output = {
    expressions: AstOperandRows,
    root: u32
}
