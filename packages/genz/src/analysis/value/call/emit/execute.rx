<Module>
    <Type from="execute_model" as="Emission" />

    <Args in={Emission.Execute} out={u32} />

    <Call
        module="build"
        in={$in.pick([
            "context",
            "value",
            "target",
            "plan"
        ])}
    />

    <Call
        fn="publish_ast"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "body",
                "target"
            ]),
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish_ast} />
</Module>
