<Module>
    <Type from="model" as="Emission" />

    <Args in={Emission.Work} out={Emission.Work} />

    <If on={$in.source.target != null}>
        <Call
            module="../../../functions/requests/reference/build"
            in={{
                target: $in.source.target,
                base: $in.context.source.expression_base,
                identifiers: 0
            }}
        />

        <Call
            fn="link"
            in={{
                state: $in,
                reference: $ctx.build
            }}
        />

        <Call module="invocation" />

        <Return value={$ctx.invocation} />
    </If>

    <Call
        fn="unary"
        in={{
            state: $in,
            address: false
        }}
    />

    <Return value={$ctx.unary} />
</Module>
