import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input, Output } from "./model"

export { astFieldCount, readAstOrigin } from "ast_rows"

export type Execute = Input.Omit("context") & {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    body?: AstSequence
}

export type PublishAst = Execute.Pick("frame", "writer", "body", "target") & {
    output: Output
}
