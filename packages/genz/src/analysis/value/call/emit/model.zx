import type { Body } from "../../../../ast/body/model"
import type { Input as Context, State } from "../../../../ast/context/model"
import type { Columns } from "../../../../ast/statements/model"
import type {
    Output as Reference,
    Target
} from "../../../functions/requests/reference/model"
import type { Output as Policy, Result } from "../model"

export type Input = {
    context: Context,
    value: u32,
    target?: Target,
    plan?: Policy
}

export type Work = {
    source: Input,
    context: State,
    body: Body,
    root: u32,
    callee: u32,
    request: bool,
    name: u8[],
    name_index: u64,
    uses_allocator: bool,
    legacy: bool,
    legacy_deref: bool,
    result: Result
}

export type Unary = {
    state: Work,
    address: bool
}

export type Link = {
    state: Work,
    reference: Reference
}

export type Output = {
    context: State,
    body: Columns,
    root: u32,
    request: bool,
    name: u8[],
    name_index: u64,
    uses_allocator: bool
}
