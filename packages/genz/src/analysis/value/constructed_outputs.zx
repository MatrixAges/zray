import check from "./construction/check"

import type { Allocator } from "memory"
import type { Functions } from "../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { functions } = in

    const constructed: bool[] = []

    return loop({
        constructed,
        index: 0
    }, {
        while: state => state.index < functions.roots.length,
        next: state => {
            const index = state.index

            const is_constructed = check({
                control: functions.control[index],
                expressions: functions.expressions[index],
                root: functions.roots[index]
            })

            state.constructed = state.constructed.push(is_constructed)[0]
            state.index += 1
        },
        return: state => state.constructed
    })
}
