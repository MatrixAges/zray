import memory from "memory"

import flags from "../facts/flags"
import check from "./construction/check"

import type { Allocator } from "memory"
import type { Functions } from "../model"

export type Input = {
    functions: Functions,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { functions, allocator } = in

    const constructed = flags({
        count: functions.output_types.length,
        allocator
    })

    const processed = loop({
        index: 0
    }, {
        while: state => state.index < functions.roots.length,
        next: state => {
            const index = state.index

            const is_constructed = check({
                control: functions.control[index],
                expressions: functions.expressions[index],
                root: functions.roots[index]
            })

            memory.writeBool(constructed.buffer, index, is_constructed)
            state.index += 1
        }
    })

    return constructed.values
}
