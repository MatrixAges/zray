import body from "../calls/body"
import parallel from "../control/parallel"
import boundary from "./boundary"

import type { Allocator } from "memory"
import type { Program } from "../model"

export type Input = {
    program: Program,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { program } = in

    const pure: bool[] = []

    return loop({
        program,
        pure,
        index: 0
    }, {
        while: current =>
            current.index < current.program.functions.output_types.length,
        next: current => {
            const index = current.index
            const functions = current.program.functions

            const supported = match {
                functions.native_modules[index] != null => boundary({
                    program: current.program,
                    position: index,
                    borrowed: false
                }),
                _ => functions.stores[index].paths.length == 0 &&
                    !parallel({
                        control: functions.control[index],
                        root: functions.roots[index]
                    }) &&
                    body({
                        expressions: functions.expressions[index],
                        contracts: functions.contracts[index],
                        allowed: current.pure,
                        self_function: index,
                        limit: index
                    })
            }

            current.pure = current.pure.push(supported)[0]
            current.index += 1
        },
        return: current => current.pure
    })
}
