import memory from "memory"

import body from "../calls/body"
import parallel from "../control/parallel"
import flags from "../facts/flags"
import boundary from "./boundary"

import type { Allocator } from "memory"
import type { Program } from "../model"

export type Input = {
    program: Program,
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const { program, allocator } = in

    const pure = flags({
        count: program.functions.output_types.length,
        allocator
    })

    const processed = loop({
        program,
        index: 0
    }, {
        while: current =>
            current.index < current.program.functions.output_types.length,
        next: current => {
            const index = current.index
            const functions = current.program.functions

            if (functions.native_modules[index] != null) {
                const supported = boundary({
                    program: current.program,
                    position: index,
                    borrowed: false
                })

                memory.writeBool(pure.buffer, index, supported)
            } else {
                const plain =
                    functions.stores[index].paths.length == 0 && !parallel({
                        control: functions.control[index],
                        root: functions.roots[index]
                    })

                const supported = plain && body({
                    expressions: functions.expressions[index],
                    contracts: functions.contracts[index],
                    allowed: pure.values,
                    self_function: index,
                    limit: index
                })

                memory.writeBool(pure.buffer, index, supported)
            }

            current.index += 1
        }
    })

    return pure.values
}
