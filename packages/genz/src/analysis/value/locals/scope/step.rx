<Module>
    <Type from="model" as="Scope" />
    <Type from="../model" as="Locals" />

    <Args in={Scope.Step} out={Scope.Step} />

    <Call fn="scan" in={$in} />

    <If on={$ctx.scan.phase == Scope.Phase.Done}>
        <Return
            value={{
                ...$in,
                state: $ctx.scan
            }}
        />
    </If>

    <Call
        module="../resolve"
        in={{
            source: $in.source.source,
            cache: $ctx.scan.cache,
            symbol: $ctx.scan.symbol,
            value: $ctx.scan.value,
            phase: Locals.Resource.None
        }}
    />

    <Call
        fn="resolved"
        in={{
            state: $ctx.scan,
            resolution: $ctx.resolve
        }}
    />

    <Return
        value={{
            ...$in,
            state: $ctx.resolved
        }}
    />
</Module>
