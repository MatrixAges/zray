import add from "../../members/add"

import type { Register as Input, Walk as Output } from "./model"

export default function (in: Input): Output {
    const { state, decision } = in

    const next = {
        ...state,
        cache: decision.cache,
        pending: false,
        position: state.position + 1
    }

    if (decision.borrowed) {
        return next
    }

    return {
        ...next,
        index: add({
            index: state.index,
            key: state.symbol
        })
    }
}
