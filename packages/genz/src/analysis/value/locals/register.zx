import attach from "../../members/attach"

import type { Register as Input, Walk as Output } from "./model"

export default function (in: Input): Output {
    const { state, decision } = in

    const next = {
        ...state,
        cache: decision.cache,
        pending: false,
        position: state.position + 1
    }

    if (decision.borrowed) {
        return next
    }

    return {
        ...next,
        ...attach(state.pick([
            "index",
            "added",
            "symbol"
        ]))
    }
}
