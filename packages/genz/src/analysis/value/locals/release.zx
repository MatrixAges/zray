import remove from "../../members/remove_many"

import type { Input as Members } from "../../members/remove_many"

export type Input = {
    stack: Members,
    state: Members
}

export type Output = {
    stack: u64,
    state: u64
}

export default function (in: Input): Output {
    const stack = remove(in.stack)
    const state = remove(in.state)

    return {
        stack,
        state
    }
}
