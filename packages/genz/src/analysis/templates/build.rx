<Module>
    <Type from="model" as="Template" />

    <Args in={Template.Input} out={Template.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="literal" />

    <If on={$ctx.literal != null}>
        <Return value={$ctx.literal} />
    </If>

    <Call fn="format" in={$ctx.initialize} />

    <Call fn="concat" />

    <Return value={$ctx.concat} />
</Module>
