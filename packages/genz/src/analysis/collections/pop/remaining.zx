import slice from "../../../ast/context/slice"
import construct from "../../state/list/construct"
import proven from "../../state/list/proven"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const shortened = slice({
        state: in.state.context,
        target: in.source.items,
        start: null,
        end: in.last
    })

    if (!in.source.dynamic) {
        return {
            ...in,
            state: {
                ...in.state,
                context: shortened.state
            },
            remaining: shortened.id
        }
    }

    const storage = proven({
        state: shortened.state,
        ast: in.source.ast,
        header: in.source.header,
        unique: in.writable
    })

    const value = construct({
        context: storage.state,
        fields: in.state.fields,
        first: in.source.bases.field_base,
        layout: in.source.layout,
        value: shortened.id,
        storage: storage.id
    })

    return {
        ...in,
        state: {
            ...in.state,
            context: value.context,
            fields: value.fields
        },
        remaining: value.root
    }
}
