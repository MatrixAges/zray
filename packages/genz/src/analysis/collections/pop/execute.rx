<Module>
    <Type from="execute_model" as="Pop" />

    <Args in={Pop.Execute} out={u32} />

    <Call module="build" in={$in.pop} />

    <Call
        fn="../../state/conversion/emit/publish_ast"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            binding: $in.body,
            body: $in.body,
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish_ast} />
</Module>
