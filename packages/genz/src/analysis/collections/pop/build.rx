<Module>
    <Type from="model" as="Pop" />

    <Args in={Pop.Input} out={Pop.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="last" />
    <Call fn="permissions" />
    <Call fn="remaining" />
    <Call fn="read_slot" />

    <Call module="read" />

    <Call fn="nonempty" />

    <Call module="reclaim" />

    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
