<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.PrepareCursor} out={Flow.PrepareCursor} />

    <Call
        fn="prepare_members"
        in={{
            type_id: $in.types[$in.row],
            queries: $in.queries
        }}
    />

    <Call
        fn="model.prepareCollectionMember"
        in={[
            $in.frame,
            $in.row,
            $ctx.prepare_members
        ]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            running: $in.row + 1 < $in.types.length
        }}
    />
</Module>
