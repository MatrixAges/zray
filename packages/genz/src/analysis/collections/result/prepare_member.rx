<Module>
    <Type from="model" as="Flow" />
    <Type from="../../state/conversion/model" as="Conversion" />

    <Args in={Flow.PrepareCursor} out={Flow.PrepareCursor} />

    <Call fn="prepare_members" in={$in} />

    <If on={$ctx.prepare_members != null}>
        <Call
            module="../../state/conversion/plan/build"
            in={{
                ...$in.preparation.source,
                root: $ctx.prepare_members,
                mode: Conversion.Mode.Pointer
            }}
        />

        <Call
            fn="../../state/resources/resolve"
            in={{
                ...$in.preparation.resources,
                plan: $ctx.build
            }}
        />

        <Call
            fn="model.readAstOrigin"
            in={[
                $in.writer,
                $in.origin
            ]}
        />

        <Call fn="model.astFieldCount" in={$in.writer} />

        <Call
            fn="append_member"
            in={{
                state: $in,
                member: {
                    plan: $ctx.build,
                    ...$ctx.resolve,
                    referenced: $in.preparation.resources.referenced,
                    value: 0,
                    shared: $in.preparation.shared,
                    capture: $in.capture,
                    expression_base: $ctx.readAstOrigin.expression_base,
                    statement_base: $ctx.readAstOrigin.statement_base,
                    field_base: $ctx.astFieldCount,
                    serial: $ctx.readAstOrigin.serial
                }
            }}
        />

        <Return value={$ctx.append_member} />
    </If>

    <Call
        fn="append_member"
        in={{
            state: $in,
            member: null
        }}
    />

    <Return value={$ctx.append_member} />
</Module>
