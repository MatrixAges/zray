import integers from "std:integer"

import type { Table } from "core/type_table/model"
import type { Preparation } from "./model"

export type Input = {
    types: Table,
    id: u32
}

export type Output = Preparation.Pick("first", "count")

export default function (in: Input): Output {
    const index = integers.widen(in.id)

    return {
        first: integers.widen(in.types.first[index]),
        count: integers.widen(in.types.second[index])
    }
}
