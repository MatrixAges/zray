<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Execution} out={u32} />

    <Call fn="prepare_members" in={$in.preparation} />

    <Call
        fn="refresh_bases"
        in={$in.pick([
            "writer",
            "source"
        ])}
    />

    <Call module="build" />

    <Call
        fn="../../state/conversion/emit/publish_ast"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            binding: $in.body,
            body: $in.body,
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish_ast} />
</Module>
