<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Execution} out={u32} />

    <Loop on={$in.running}>
        <Call
            module="prepare_member"
            in={{
                writer: $in.writer,
                origin: $in.origin,
                capture: $in.source.bases.capture,
                preparation: $in.preparation,
                members: [],
                row: 0,
                running: $in.preparation.types.length != 0
            }}
        />
    </Loop>

    <Call
        fn="refresh_bases"
        in={{
            writer: $in.writer,
            source: {
                ...$in.source,
                members: $ctx.prepare_member.members
            }
        }}
    />

    <Call module="build" />

    <Call
        fn="../../state/conversion/emit/publish_ast"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            binding: $in.body,
            body: $in.body,
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish_ast} />
</Module>
