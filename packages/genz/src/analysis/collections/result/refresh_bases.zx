import { astExpressionCount, astFieldCount } from "ast_rows"

import type { AstWriter } from "ast_rows"
import type { Input as Source } from "./model"

export type Input = {
    writer: AstWriter,
    source: Source
}

export type Output = Source

export default function (in: Input): Output {
    const { writer, source } = in

    return {
        ...source,
        bases: {
            ...source.bases,
            expression_base: astExpressionCount(writer),
            field_base: astFieldCount(writer)
        }
    }
}