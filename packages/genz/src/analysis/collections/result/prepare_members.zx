import integers from "std:integer"

import { Property } from "../../state/queries/model"
import query from "../../state/queries/read"

import type { PrepareCursor } from "./model"

export type Input = PrepareCursor

export type Output = u32?

export default function (in: Input): Output {
    const { types, source } = in.preparation

    const type_id = types[in.row]

    const represented = query({
        value: source.queries[integers.widen(type_id)],
        property: Property.Represented
    })

    return represented ? type_id : null
}
