import integers from "std:integer"

import { Property } from "../../state/queries/model"
import query from "../../state/queries/read"

import type { Query } from "../../state/queries/model"

export type Input = {
    type_id: u32,
    queries: Query[]
}

export type Output = u32?

export default function (in: Input): Output {
    const represented = query({
        value: in.queries[integers.widen(in.type_id)],
        property: Property.Represented
    })

    return represented ? in.type_id : null
}
