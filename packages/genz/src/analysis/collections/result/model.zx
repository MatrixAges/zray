import type { Input as Bases } from "../../../ast/context/model"
import type {
    Input as Conversion,
    State as ConversionState,
    Output as Emission
} from "../../state/conversion/emit/model"

export type Input = {
    value: u32,
    members: Conversion?[],
    bases: Bases
}

export type State = {
    source: Input,
    state: ConversionState,
    root: u32,
    values: u32[],
    index: u64
}

export type Output = Emission

export type Members = State & {
    running: bool
}

export type Member = {
    state: ConversionState,
    value: u32,
    conversion?: Conversion
}

export type Publication = Member.Pick("state", "value") & {
    members: Members
}
