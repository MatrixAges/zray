import type { AstCapture, AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as Bases } from "../../../ast/context/model"
import type {
    Input as Conversion,
    State as ConversionState,
    Output as Emission
} from "../../state/conversion/emit/model"
import type { Input as ConversionSource } from "../../state/conversion/model"
import type { Resources } from "../../state/conversion/prepare/model"

export type Input = {
    value: u32,
    members: Conversion?[],
    bases: Bases
}

export type State = {
    source: Input,
    state: ConversionState,
    root: u32,
    values: u32[],
    index: u64
}

export type Output = Emission

export type Preparation = {
    first: u64,
    count: u64,
    source: ConversionSource.Omit("root", "mode"),
    resources: Resources,
    shared: bool
}

export type Execution = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    source: Input.Omit("members"),
    preparation: Preparation
}

export type Members = State & {
    running: bool
}

export type Member = {
    state: ConversionState,
    value: u32,
    conversion?: Conversion
}

export type Publication = Member.Pick("state", "value") & {
    members: Members
}

export type PrepareCursor = {
    writer: AstWriter,
    capture?: AstCapture,
    preparation: Preparation,
    members: Conversion?[],
    row: u64,
    running: bool
}

export { astFieldCount, readAstOrigin } from "ast_rows"
