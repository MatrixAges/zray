<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Rows} out={u32} />

    <If on={$in.kind == Flow.CollectionKind.Sort}>
        <Call
            fn="host.collectionCompare"
            in={[
                $in.ast.lower,
                $in.source_type
            ]}
        />

        <Call
            module="publish_rows"
            in={{
                ...$in,
                compare: $ctx.collectionCompare
            }}
        />

        <Return value={$ctx.publish_rows} />
    </If>

    <If
        on={$in.capacity != null && (
            $in.kind == Flow.CollectionKind.Push ||
                $in.kind == Flow.CollectionKind.Concat
        )}
    >
        <Call
            module="../../iteration/fields/projection/minimum"
            in={{
                ...$in.capacity,
                writer: $in.ast.writer,
                operation: $in.id
            }}
        />

        <Call
            module="publish_rows"
            in={{
                ...$in,
                minimum: $ctx.minimum,
                compare: []
            }}
        />

        <Return value={$ctx.publish_rows} />
    </If>

    <Call
        module="publish_rows"
        in={{
            ...$in,
            compare: []
        }}
    />

    <Return value={$ctx.publish_rows} />
</Module>
