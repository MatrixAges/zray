<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Rows} out={u32} />

    <Store from="comparisons" as="comparisons" />

    <If on={$in.kind == Flow.CollectionKind.Sort}>
        <Call
            fn="comparison"
            in={{
                types: $in.ast.elements.types,
                registered: $store.comparisons.registered.types,
                source_type: $in.source_type,
                named: $in.named
            }}
        />

        <If on={$ctx.comparison.next != null}>
            <Call
                fn="register_comparison"
                in={{
                    types: $store.comparisons.registered.types,
                    next: $ctx.comparison.next
                }}
                setter={[$store.comparisons.registered]}
            />
        </If>

        <Call
            fn="../../comparison/name"
            in={$ctx.comparison.pick([
                "type_id",
                "scalar",
                "named"
            ])}
        />

        <Call
            module="publish_rows"
            in={{
                ...$in,
                compare: $ctx.name
            }}
        />

        <Return value={$ctx.publish_rows} />
    </If>

    <If
        on={$in.capacity != null && (
            $in.kind == Flow.CollectionKind.Push ||
                $in.kind == Flow.CollectionKind.Concat
        )}
    >
        <Call
            module="../../iteration/fields/projection/minimum"
            in={{
                ...$in.capacity,
                writer: $in.ast.writer,
                operation: $in.id
            }}
        />

        <Call
            module="publish_rows"
            in={{
                ...$in,
                minimum: $ctx.minimum,
                compare: []
            }}
        />

        <Return value={$ctx.publish_rows} />
    </If>

    <Call
        module="publish_rows"
        in={{
            ...$in,
            compare: []
        }}
    />

    <Return value={$ctx.publish_rows} />
</Module>
