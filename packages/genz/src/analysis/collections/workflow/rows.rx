<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Rows} out={u32} />

    <If on={$in.kind == Flow.CollectionKind.Sort}>
        <Call
            fn="host.collectionCompare"
            in={[
                $in.ast.lower,
                $in.source_type
            ]}
        />

        <Call
            fn="host.emitCollectionRows"
            in={[
                $in.ast.writer,
                $in.ast.sequence,
                $in.id,
                $in.source_type,
                $in.removed_only,
                $in.rows,
                null,
                $ctx.collectionCompare
            ]}
        />

        <Return value={$ctx.emitCollectionRows} />
    </If>

    <If
        on={$in.kind == Flow.CollectionKind.Push ||
            $in.kind == Flow.CollectionKind.Concat}
    >
        <Call
            fn="host.collectionMinimum"
            in={[
                $in.ast.lower,
                $in.id
            ]}
        />

        <Call
            fn="host.emitCollectionRows"
            in={[
                $in.ast.writer,
                $in.ast.sequence,
                $in.id,
                $in.source_type,
                $in.removed_only,
                $in.rows,
                $ctx.collectionMinimum,
                null
            ]}
        />

        <Return value={$ctx.emitCollectionRows} />
    </If>

    <Call
        fn="host.emitCollectionRows"
        in={[
            $in.ast.writer,
            $in.ast.sequence,
            $in.id,
            $in.source_type,
            $in.removed_only,
            $in.rows,
            null,
            null
        ]}
    />

    <Return value={$ctx.emitCollectionRows} />
</Module>
