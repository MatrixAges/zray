<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.TargetRequest} out={Flow.BoundTarget} />

    <Call
        fn="host.lowerExpression"
        in={[
            $in.ast.lower,
            $in.target,
            false,
            null
        ]}
    />

    <Call
        module="bind_target"
        in={{
            ast: $in.ast,
            target: $in.target,
            evaluated: $ctx.lowerExpression,
            represented: $in.represented,
            clip: $in.represented && $in.kind != Flow.CollectionKind.Slice
        }}
    />

    <Return value={$ctx.bind_target} />
</Module>
