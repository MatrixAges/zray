<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.TargetRequest} out={Flow.BoundTarget} />

    <Call
        fn="host.evaluateCollectionValue"
        in={[
            $in.frame,
            $in.target
        ]}
    />

    <Call fn="host.collectionTargetRepresented" in={$in.frame} />

    <Call
        module="bind_target"
        in={{
            frame: $in.frame,
            target: $in.target,
            evaluated: $ctx.evaluateCollectionValue,
            represented: $ctx.collectionTargetRepresented,
            clip:
                $ctx.collectionTargetRepresented && $in.kind != Flow.CollectionKind.Slice
        }}
    />

    <Return value={$ctx.bind_target} />
</Module>
