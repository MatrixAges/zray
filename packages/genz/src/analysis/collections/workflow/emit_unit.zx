import { appendExpressionRows, AstPayloadOwnership, astExpressionCount } from "ast_rows"

import empty from "../../../ast/expressions/empty"
import { ExpressionsKind } from "../../../printer/model/expressions"

import type { AstWriter } from "ast_rows"

export type Input = AstWriter

export type Output = u32

export default function (in: Input): Output {
    const base = astExpressionCount(in)

    appendExpressionRows(in, {
        ...empty({}),
        tags: [ExpressionsKind.Unit],
        offsets: [0]
    }, null, AstPayloadOwnership.BorrowingText)

    return base
}
