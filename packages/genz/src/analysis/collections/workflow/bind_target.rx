<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.TargetBinding} out={Flow.BoundTarget} />

    <If on={$in.clip}>
        <Call
            fn="host.clipCollectionTarget"
            in={[
                $in.frame,
                $in.evaluated
            ]}
        />

        <Call
            fn="../../aggregate/execute/bind_operand"
            in={{
                frame: $in.ast.lower,
                writer: $in.ast.writer,
                sequence: $in.ast.sequence,
                value: $ctx.clipCollectionTarget
            }}
        />

        <Call
            fn="host.readListItems"
            in={[
                $in.ast.lower,
                $in.target,
                $ctx.bind_operand
            ]}
        />

        <Return
            value={{
                value: $ctx.bind_operand,
                items: $ctx.readListItems,
                represented: true
            }}
        />
    </If>

    <Call
        fn="../../aggregate/execute/bind_operand"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            sequence: $in.ast.sequence,
            value: $in.evaluated
        }}
    />

    <Call
        fn="host.readListItems"
        in={[
            $in.ast.lower,
            $in.target,
            $ctx.bind_operand
        ]}
    />

    <Return
        value={{
            value: $ctx.bind_operand,
            items: $ctx.readListItems,
            represented: $in.represented
        }}
    />
</Module>
