<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Outcome} out={u32} />

    <If on={$in.state_active && !$in.result_selected}>
        <Call
            fn="../result/tuple_range"
            in={{
                types: $in.conversion.source.types,
                id: $in.result_type
            }}
        />

        <Call fn="model.readAstOrigin" in={$in.ast.writer} />
        <Call fn="model.astFieldCount" in={$in.ast.writer} />

        <Call
            module="../result/execute"
            in={{
                frame: $in.ast.lower,
                writer: $in.ast.writer,
                body: $in.ast.sequence,
                source: {
                    value: $in.result,
                    bases: {
                        ...$ctx.readAstOrigin,
                        field_base: $ctx.astFieldCount
                    }
                },
                preparation: {
                    ...$in.conversion,
                    ...$ctx.tuple_range
                }
            }}
        />

        <Return value={$ctx.execute} />
    </If>

    <Return value={$in.result} />
</Module>
