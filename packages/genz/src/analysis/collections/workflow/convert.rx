<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Outcome} out={u32} />

    <If on={$in.state_active && !$in.result_selected}>
        <Call
            fn="host.convertCollectionResult"
            in={[
                $in.frame,
                $in.result
            ]}
        />

        <Return value={$ctx.convertCollectionResult} />
    </If>

    <Return value={$in.result} />
</Module>
