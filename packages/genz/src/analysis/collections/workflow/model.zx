import type { AstSequence, AstWriter } from "ast_rows"
import type { CollectionKind } from "core/expression_table/kinds"
import type { Lowering } from "lowering_host"
import type { Minimum } from "../../iteration/fields/projection/model"
import type { Source as ElementStorage } from "../../state/elements/storage"
import type { Preparation } from "../result/model"
import type { CollectionRows } from "./row_shape"

export { CollectionKind } from "core/expression_table/kinds"

export type Ast = {
    lower: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    elements: ElementStorage
}

export type Capacity = Minimum.Omit("writer", "operation")

export type Input = {
    id: u32,
    ast: Ast,
    represented: bool,
    kind: CollectionKind,
    target: u32,
    source_type: u32,
    expression_types: u32[],
    result_type: u32,
    conversion: Preparation.Omit("first", "count"),
    arguments: u32[],
    frontier: bool,
    in_place: bool,
    grow: bool,
    lazy: bool,
    retract: bool,
    shared: bool,
    removed_only: bool,
    capacity?: Capacity,
    state_active: bool,
    result_selected: bool,
    named: bool,
    layout?: u32
}

export type BoundTarget = {
    value: u32,
    items: u32,
    represented: bool
}

export type TargetRequest = {
    ast: Ast,
    represented: bool,
    kind: CollectionKind,
    target: u32
}

export type Arguments = {
    first: u32,
    second: u32,
    third: u32
}

export type ArgumentSource = Input.Pick(
    "ast",
    "kind",
    "arguments",
    "source_type",
    "expression_types"
)

export type Argument = {
    ast: Ast,
    origin: u32
}

export type Operation = Input & BoundTarget

export type Rows = Input.Pick(
    "id",
    "ast",
    "kind",
    "source_type",
    "named",
    "represented",
    "removed_only",
    "capacity",
    "frontier",
    "in_place",
    "grow",
    "lazy",
    "retract",
    "shared"
) & {
    rows: CollectionRows
}

export type RowEmission = Rows & {
    minimum?: u32,
    compare: u8[]
}

export type RowLayout = Rows.Pick("ast", "source_type", "represented")

export { astFieldCount, readAstOrigin } from "ast_rows"

export type Outcome =
    Input.Pick(
        "ast",
        "removed_only",
        "state_active",
        "result_selected",
        "result_type",
        "conversion",
        "layout"
    ) & {
        result: u32
    }

export type TargetBinding = TargetRequest.Pick("ast", "target") & {
    evaluated: u32,
    represented: bool,
    clip: bool
}
