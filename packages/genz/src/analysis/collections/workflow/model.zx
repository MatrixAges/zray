import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { CollectionKind } from "core/expression_table/kinds"
import type { CollectionFrame, CollectionRows, Lowering } from "lowering_host"

export { CollectionKind } from "core/expression_table/kinds"

export type Ast = {
    lower: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    sequence: AstSequence
}

export type Input = {
    frame: CollectionFrame,
    ast: Ast,
    represented: bool,
    kind: CollectionKind,
    target: u32,
    source_type: u32,
    result_type: u32,
    arguments: u32[],
    frontier: bool,
    removed_only: bool,
    state_active: bool,
    result_selected: bool,
    layout?: u32
}

export type BoundTarget = {
    value: u32,
    items: u32,
    represented: bool
}

export type TargetRequest = {
    frame: CollectionFrame,
    ast: Ast,
    represented: bool,
    kind: CollectionKind,
    target: u32
}

export type Arguments = {
    first: u32,
    second: u32,
    third: u32
}

export type Operation = Input & BoundTarget

export type Rows = {
    frame: CollectionFrame,
    kind: CollectionKind,
    rows: CollectionRows
}

export type Outcome =
    Input.Pick(
        "frame",
        "ast",
        "removed_only",
        "state_active",
        "result_selected",
        "result_type",
        "layout"
    ) & {
        result: u32
    }

export type TargetBinding = TargetRequest.Pick("frame", "ast", "target") & {
    evaluated: u32,
    represented: bool,
    clip: bool
}
