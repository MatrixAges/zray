<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Operation} out={u32} />

    <Call
        fn="host.materializeElementType"
        in={[
            $in.ast.lower,
            $in.source_type
        ]}
    />

    <Call
        fn="emit_length"
        in={{
            writer: $in.ast.writer,
            items: $in.items
        }}
    />

    <Call
        fn="emit_flag"
        in={{
            writer: $in.ast.writer,
            value: false
        }}
    />

    <Call fn="emit_unit" in={$in.ast.writer} />

    <Call
        fn="slice_rows"
        in={{
            items: $in.items,
            value: $in.value,
            header: $ctx.emit_flag,
            element: $ctx.materializeElementType,
            length: $ctx.emit_length,
            unit: $ctx.emit_unit
        }}
    />

    <Call
        fn="host.emitCollectionRows"
        in={[
            $in.frame,
            $ctx.slice_rows,
            null,
            null
        ]}
    />

    <If on={$in.layout != null}>
        <Call
            fn="emit_cast"
            in={{
                writer: $in.ast.writer,
                layout: $in.layout,
                value: $ctx.emitCollectionRows
            }}
        />

        <Call
            fn="../../aggregate/execute/finish_block"
            in={{
                frame: $in.ast.lower,
                writer: $in.ast.writer,
                origin: $in.ast.origin,
                sequence: $in.ast.sequence,
                value: $ctx.emit_cast
            }}
        />

        <Return value={$ctx.finish_block} />
    </If>

    <Call
        fn="../../aggregate/execute/finish_block"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            origin: $in.ast.origin,
            sequence: $in.ast.sequence,
            value: $ctx.emitCollectionRows
        }}
    />

    <Return value={$ctx.finish_block} />
</Module>
