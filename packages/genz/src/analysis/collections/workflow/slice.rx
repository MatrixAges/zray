<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Operation} out={u32} />

    <Call
        fn="../../state/elements/materialize_type"
        in={{
            frame: $in.ast.lower,
            source: $in.ast.elements,
            list: $in.source_type
        }}
    />

    <Call
        fn="emit_length"
        in={{
            writer: $in.ast.writer,
            items: $in.items
        }}
    />

    <Call
        fn="emit_flag"
        in={{
            writer: $in.ast.writer,
            value: false
        }}
    />

    <Call fn="emit_unit" in={$in.ast.writer} />

    <Call
        fn="slice_rows"
        in={{
            items: $in.items,
            value: $in.value,
            header: $ctx.emit_flag,
            element: $ctx.materialize_type,
            length: $ctx.emit_length,
            unit: $ctx.emit_unit
        }}
    />

    <Call
        module="publish_rows"
        in={{
            ...$in.pick([
                "id",
                "ast",
                "kind",
                "source_type",
                "named",
                "represented",
                "removed_only",
                "capacity",
                "frontier",
                "in_place",
                "grow",
                "lazy",
                "retract",
                "shared"
            ]),
            rows: $ctx.slice_rows,
            compare: []
        }}
    />

    <If on={$in.layout != null}>
        <Call
            fn="emit_cast"
            in={{
                writer: $in.ast.writer,
                layout: $in.layout,
                value: $ctx.publish_rows
            }}
        />

        <Call
            fn="../../aggregate/execute/finish_block"
            in={{
                frame: $in.ast.lower,
                writer: $in.ast.writer,
                sequence: $in.ast.sequence,
                value: $ctx.emit_cast
            }}
        />

        <Return value={$ctx.finish_block} />
    </If>

    <Call
        fn="../../aggregate/execute/finish_block"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            sequence: $in.ast.sequence,
            value: $ctx.publish_rows
        }}
    />

    <Return value={$ctx.finish_block} />
</Module>
