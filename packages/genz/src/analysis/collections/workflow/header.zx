import { Operation } from "../../state/list/const"
import emitPermission from "../../state/list/emit_permission"
import emitFlag from "./emit_flag"

import type { AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    value: u32,
    represented: bool,
    frontier: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { writer, value, represented, frontier } = in

    if (represented) {
        return emitPermission({
            writer,
            value,
            operation: Operation.Headered
        })
    }

    return emitFlag({
        writer,
        value: frontier
    })
}
