import host from "lowering_host"

import type { CollectionFrame } from "lowering_host"

export type Input = {
    frame: CollectionFrame,
    value: u32,
    represented: bool,
    frontier: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, value, represented, frontier } = in

    if (represented) {
        return host.collectionHeader(frame, value)
    }

    return host.collectionFlag(frame, frontier)
}
