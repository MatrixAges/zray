import host from "lowering_host"

import emitFlag from "./emit_flag"

import type { AstWriter } from "ast_rows"
import type { CollectionFrame } from "lowering_host"

export type Input = {
    frame: CollectionFrame,
    writer: AstWriter,
    value: u32,
    represented: bool,
    frontier: bool
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, value, represented, frontier } = in

    if (represented) {
        return host.collectionHeader(frame, value)
    }

    return emitFlag({
        writer,
        value: frontier
    })
}
