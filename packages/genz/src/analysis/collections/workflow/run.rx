<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={u32} />

    <Call
        module="target"
        in={$in.pick([
            "ast",
            "represented",
            "kind",
            "target"
        ])}
    />

    <If on={$in.kind == Flow.CollectionKind.Slice}>
        <Call
            module="slice"
            in={{
                ...$in,
                ...$ctx.target
            }}
        />

        <Return value={$ctx.slice} />
    </If>

    <Call
        module="operation"
        in={{
            ...$in,
            ...$ctx.target
        }}
    />

    <Call
        module="result"
        in={{
            ast: $in.ast,
            result: $ctx.operation,
            removed_only: $in.removed_only,
            state_active: $in.state_active,
            result_selected: $in.result_selected,
            result_type: $in.result_type,
            layout: $in.layout
        }}
    />

    <Return value={$ctx.result} />
</Module>
