<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Outcome} out={u32} />

    <If on={$in.removed_only}>
        <Call
            fn="../../aggregate/execute/finish_block"
            in={{
                frame: $in.ast.lower,
                writer: $in.ast.writer,
                origin: $in.ast.origin,
                sequence: $in.ast.sequence,
                value: $in.result
            }}
        />

        <Return value={$ctx.finish_block} />
    </If>

    <Call module="convert" in={$in} />

    <Call
        fn="host.constructCollectionResult"
        in={[
            $in.frame,
            $ctx.convert
        ]}
    />

    <Call
        fn="../../aggregate/execute/finish_block"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            origin: $in.ast.origin,
            sequence: $in.ast.sequence,
            value: $ctx.constructCollectionResult
        }}
    />

    <Return value={$ctx.finish_block} />
</Module>
