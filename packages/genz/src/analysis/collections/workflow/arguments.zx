import { writeCollectionElement } from "ast_rows"
import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"
import items from "./argument_items"
import { unused_expression } from "./const"
import { CollectionKind } from "./model"

import type { Arguments, Input as Request } from "./model"

export type Input =
    Request.Pick("ast", "kind", "arguments", "source_type", "expression_types")

export type Output = Arguments

export default function (in: Input): Output {
    const { ast, kind, arguments, source_type } = in

    if (kind == CollectionKind.Splice) {
        const start = host.lowerExpression(ast.lower, arguments[0], false, null)

        const first = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.sequence,
            value: start
        })

        const count = host.lowerExpression(ast.lower, arguments[1], false, null)

        const second = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.sequence,
            value: count
        })

        const replacement_id = arguments[2]
        const replacement = host.lowerExpression(ast.lower, replacement_id, false, null)

        const value = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.sequence,
            value: replacement
        })

        const third = items({
            ast,
            expression_types: in.expression_types,
            origin: replacement_id,
            value
        })

        return {
            first,
            second,
            third
        }
    }

    if (kind == CollectionKind.Push || kind == CollectionKind.Concat) {
        const id = arguments[0]
        const value = host.lowerExpression(ast.lower, id, false, null)

        const bound = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.sequence,
            value
        })

        const first = match kind {
            CollectionKind.Push =>
                writeCollectionElement(
                    ast.writer,
                    ast.sequence,
                    source_type,
                    bound
                ),
            _ => items({
                ast,
                expression_types: in.expression_types,
                origin: id,
                value: bound
            })
        }

        return {
            first,
            second: unused_expression,
            third: unused_expression
        }
    }

    return {
        first: unused_expression,
        second: unused_expression,
        third: unused_expression
    }
}
