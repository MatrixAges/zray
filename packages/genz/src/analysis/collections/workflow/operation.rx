<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Operation} out={u32} />

    <Call
        fn="header"
        in={{
            writer: $in.ast.writer,
            value: $in.value,
            represented: $in.represented,
            frontier: $in.frontier
        }}
    />

    <Call
        module="arguments"
        in={$in.pick([
            "source_type",
            "ast",
            "kind",
            "arguments",
            "expression_types"
        ])}
    />

    <Call
        fn="../../state/elements/materialize_type"
        in={{
            frame: $in.ast.lower,
            source: $in.ast.elements,
            list: $in.source_type
        }}
    />

    <Call
        fn="emit_length"
        in={{
            writer: $in.ast.writer,
            items: $in.items
        }}
    />

    <Call fn="emit_unit" in={$in.ast.writer} />

    <If on={$in.kind == Flow.CollectionKind.Pop}>
        <Call
            module="apply_work"
            in={{
                pop: {
                    retract: $in.retract,
                    source_type: $in.source_type,
                    result_type: $in.result_type,
                    items: $in.items,
                    value: $in.value,
                    header: $ctx.header,
                    element: $ctx.materialize_type,
                    length: $ctx.emit_length
                }
            }}
        />

        <Return value={$ctx.apply_work} />
    </If>

    <Call
        module="rows"
        in={{
            ...$in.pick([
                "id",
                "ast",
                "kind",
                "source_type",
                "named",
                "represented",
                "removed_only",
                "capacity",
                "frontier",
                "in_place",
                "grow",
                "lazy",
                "retract",
                "shared"
            ]),
            rows: {
                ...$ctx.arguments,
                items: $in.items,
                value: $in.value,
                header: $ctx.header,
                element: $ctx.materialize_type,
                length: $ctx.emit_length,
                unit: $ctx.emit_unit
            }
        }}
    />

    <Return value={$ctx.rows} />
</Module>
