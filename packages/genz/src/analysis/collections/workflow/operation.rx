<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Operation} out={u32} />

    <Call
        fn="header"
        in={{
            frame: $in.frame,
            writer: $in.ast.writer,
            value: $in.value,
            represented: $in.represented,
            frontier: $in.frontier
        }}
    />

    <Call
        fn="arguments"
        in={$in.pick([
            "frame",
            "ast",
            "kind",
            "arguments"
        ])}
    />

    <Call fn="host.collectionElementType" in={$in.frame} />

    <Call
        fn="emit_length"
        in={{
            writer: $in.ast.writer,
            items: $in.items
        }}
    />

    <Call fn="emit_unit" in={$in.ast.writer} />

    <If on={$in.kind == Flow.CollectionKind.Pop}>
        <Call
            fn="host.emitCollectionPop"
            in={[
                $in.frame,
                $in.items,
                $in.value,
                $ctx.header,
                $ctx.collectionElementType,
                $ctx.emit_length
            ]}
        />

        <Return value={$ctx.emitCollectionPop} />
    </If>

    <Call
        module="rows"
        in={{
            frame: $in.frame,
            kind: $in.kind,
            rows: {
                ...$ctx.arguments,
                items: $in.items,
                value: $in.value,
                header: $ctx.header,
                element: $ctx.collectionElementType,
                length: $ctx.emit_length,
                unit: $ctx.emit_unit
            }
        }}
    />

    <Return value={$ctx.rows} />
</Module>
