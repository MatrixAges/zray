<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.RowEmission} out={u32} />

    <Call
        fn="row_layout"
        in={$in.pick([
            "ast",
            "source_type",
            "represented"
        ])}
    />

    <Call fn="model.readAstOrigin" in={$in.ast.writer} />
    <Call fn="model.astFieldCount" in={$in.ast.writer} />

    <Call
        module="execute"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            body: $in.ast.sequence,
            rows: {
                ...$in.rows,
                ...$in.pick([
                    "kind",
                    "in_place",
                    "grow",
                    "frontier",
                    "lazy",
                    "retract",
                    "removed_only",
                    "shared",
                    "minimum",
                    "compare"
                ]),
                selected: $in.represented,
                layout: $ctx.row_layout,
                bases: {
                    ...$ctx.readAstOrigin,
                    field_base: $ctx.astFieldCount
                }
            }
        }}
    />

    <Return value={$ctx.execute} />
</Module>
