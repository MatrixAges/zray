import bytes from "std:bytes"
import { appendExpressionRows, AstPayloadOwnership, astExpressionCount } from "ast_rows"

import accessColumns from "../../../ast/rows/access_columns"
import { ExpressionsKind } from "../../../printer/model/expressions"
import { length_member } from "../../intrinsics/index/const"

import type { AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    items: u32
}

export type Output = u32

export default function (in: Input): Output {
    const base = astExpressionCount(in.writer)
    const empty: u32[][] = []

    const columns = accessColumns({
        rows: {
            tags: [ExpressionsKind.Field],
            offsets: [0],
            field_target: [in.items],
            field_name: [bytes.fromText(length_member)],
            dereference: [],
            optional_unwrap: [],
            builtin_name: []
        },
        arguments: empty
    })

    appendExpressionRows(
        in.writer,
        columns.rows,
        columns.forms,
        AstPayloadOwnership.Borrowed
    )

    return base
}
