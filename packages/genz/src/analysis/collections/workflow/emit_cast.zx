import {
    appendExpressionRows,
    AstPayloadOwnership,
    astExpressionCount,
    retainAstIds
} from "ast_rows"

import accessColumns from "../../../ast/rows/access_columns"
import {
    ExpressionsBuiltinName,
    ExpressionsKind
} from "../../../printer/model/expressions"

import type { AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    layout: u32,
    value: u32
}

export type Output = u32

export default function (in: Input): Output {
    const base = astExpressionCount(in.writer)

    const pair = retainAstIds(in.writer, [
        in.layout,
        in.value
    ])

    const columns = accessColumns({
        rows: {
            tags: [ExpressionsKind.Builtin],
            offsets: [0],
            field_target: [],
            field_name: [],
            dereference: [],
            optional_unwrap: [],
            builtin_name: [ExpressionsBuiltinName.As]
        },
        arguments: [pair]
    })

    appendExpressionRows(
        in.writer,
        columns.rows,
        columns.forms,
        AstPayloadOwnership.Borrowed
    )

    return base
}
