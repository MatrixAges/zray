import { unused_expression } from "./const"

import type { CollectionRows } from "./row_shape"

export type Input = CollectionRows.Omit("first", "second", "third")

export type Output = CollectionRows

export default function (in: Input): Output {
    return {
        ...in,
        first: unused_expression,
        second: unused_expression,
        third: unused_expression
    }
}
