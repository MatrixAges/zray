import { CollectionKind } from "core/expression_table/kinds"

export enum Argument {
    Direct,
    Element,
    Items,
    Splice
}

export type Input = {
    kind: CollectionKind,
    represented: bool
}

export type Output = {
    clip: bool,
    slice: bool,
    argument: Argument
}

export default function (in: Input): Output {
    const slice = in.kind == CollectionKind.Slice

    const argument = match in.kind {
        CollectionKind.Push => Argument.Element,
        CollectionKind.Concat => Argument.Items,
        CollectionKind.Splice => Argument.Splice,
        _ => Argument.Direct
    }

    return {
        clip: in.represented && !slice,
        slice,
        argument
    }
}
