<Module>
    <Type from="workflow" as="Update" />

    <Args in={Update.Input} out={u32} />

    <Call module="evaluate" in={$in} />

    <Call
        fn="prepare_input"
        in={{
            ...$in.pick([
                "ast",
                "represented",
                "source_type",
                "deferred",
                "in_place",
                "transfer",
                "grow",
                "exact",
                "shared"
            ]),
            evaluated: $ctx.evaluate
        }}
    />

    <Call
        module="execute"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            body: $in.ast.sequence,
            update: $ctx.prepare_input
        }}
    />

    <Call
        fn="../../aggregate/execute/finish_block"
        in={{
            frame: $in.ast.lower,
            writer: $in.ast.writer,
            sequence: $in.ast.sequence,
            value: $ctx.execute
        }}
    />

    <Return value={$ctx.finish_block} />
</Module>
