import host from "lowering_host"

import bindOperand from "../../aggregate/execute/bind_operand"

import type { Ast } from "../workflow/model"

export type Input = {
    ast: Ast,
    origin: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { ast, origin } = in

    const value = host.lowerExpression(ast.lower, origin, false, null)

    return bindOperand({
        frame: ast.lower,
        writer: ast.writer,
        origin: ast.origin,
        sequence: ast.sequence,
        value
    })
}
