import { writeCollectionElement } from "ast_rows"

import operand from "./operand"

import type { Ast } from "../workflow/model"

export type Input = {
    ast: Ast,
    origin: u32,
    source_type: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { ast, origin, source_type } = in

    const bound = operand({
        ast,
        origin
    })

    return writeCollectionElement(ast.writer, ast.sequence, source_type, bound)
}
