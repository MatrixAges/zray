import host from "lowering_host"

import operand from "./operand"

import type { CollectionFrame } from "lowering_host"
import type { Ast } from "../workflow/model"

export type Input = {
    frame: CollectionFrame,
    ast: Ast,
    origin: u32
}

export type Output = u32

export default function (in: Input): Output {
    const bound = operand({
        ast: in.ast,
        origin: in.origin
    })

    return host.writeCollectionElement(in.frame, bound)
}
