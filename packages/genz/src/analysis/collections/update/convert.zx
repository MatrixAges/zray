import { writeCollectionElement } from "ast_rows"

import type { Ast } from "../workflow/model"

export type Input = {
    ast: Ast,
    value: u32,
    source_type: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { ast, value, source_type } = in

    return writeCollectionElement(ast.writer, ast.sequence, source_type, value)
}
