<Module>
    <Type from="workflow" as="Update" />

    <Args in={Update.Input} out={Update.Evaluated} />

    <Call
        fn="../workflow/host.lowerExpression"
        in={[
            $in.ast.lower,
            $in.target,
            false,
            null
        ]}
    />

    <Call
        module="../workflow/bind_target"
        in={{
            frame: $in.frame,
            ast: $in.ast,
            target: $in.target,
            evaluated: $ctx.lowerExpression,
            represented: $in.represented,
            clip: $in.represented
        }}
    />

    <Call
        fn="operand"
        in={{
            ast: $in.ast,
            origin: $in.index
        }}
    />

    <Call
        fn="../../statements/rows.readAstOrigin"
        in={[
            $in.ast.writer,
            $in.ast.origin
        ]}
    />

    <Call fn="../../statements/rows.astFieldCount" in={$in.ast.writer} />

    <Call
        fn="check_bounds"
        in={{
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            },
            items: $ctx.bind_target.items,
            index: $ctx.operand
        }}
    />

    <Call
        module="../../intrinsics/guard/append"
        in={{
            writer: $in.ast.writer,
            fragment: $ctx.check_bounds
        }}
    />

    <Call
        fn="../../statements/rows.appendAstSequenceSpan"
        in={[
            $in.ast.sequence,
            $ctx.append
        ]}
    />

    <Call
        fn="convert"
        in={{
            frame: $in.frame,
            ast: $in.ast,
            origin: $in.value
        }}
    />

    <Call
        fn="../workflow/host.materializeElementType"
        in={[
            $in.ast.lower,
            $in.source_type
        ]}
    />

    <Return
        value={{
            items: $ctx.bind_target.items,
            target: $ctx.bind_target.value,
            index: $ctx.operand,
            value: $ctx.convert,
            element: $ctx.materializeElementType
        }}
    />
</Module>
