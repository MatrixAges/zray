<Module>
    <Type from="workflow" as="Update" />

    <Args in={Update.Input} out={Update.Write} />

    <Call
        fn="../workflow/host.lowerExpression"
        in={[
            $in.ast.lower,
            $in.target,
            false,
            null
        ]}
    />

    <Call
        module="../workflow/bind_target"
        in={{
            frame: $in.frame,
            ast: $in.ast,
            target: $in.target,
            evaluated: $ctx.lowerExpression,
            represented: $in.represented,
            clip: $in.represented
        }}
    />

    <Call
        fn="operand"
        in={{
            ast: $in.ast,
            origin: $in.index
        }}
    />

    <Call
        fn="check_bounds"
        in={{
            writer: $in.ast.writer,
            origin: $in.ast.origin,
            sequence: $in.ast.sequence,
            items: $ctx.bind_target.items,
            index: $ctx.operand
        }}
    />

    <Call
        fn="convert"
        in={{
            frame: $in.frame,
            ast: $in.ast,
            origin: $in.value
        }}
    />

    <Call fn="../workflow/host.collectionElementType" in={$in.frame} />

    <Return
        value={{
            items: $ctx.bind_target.items,
            target: $ctx.bind_target.value,
            index: $ctx.operand,
            value: $ctx.convert,
            element: $ctx.collectionElementType,
            selected: $in.represented
        }}
    />
</Module>
