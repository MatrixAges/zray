<Module>
    <Type from="workflow" as="Update" />

    <Args in={Update.Input} out={Update.Evaluated} />

    <Call
        module="../workflow/apply_work"
        in={{
            target: $in.target
        }}
    />

    <Call
        module="../workflow/bind_target"
        in={{
            ast: $in.ast,
            target: $in.target,
            evaluated: $ctx.apply_work,
            represented: $in.represented,
            clip: false
        }}
    />

    <Task name="index" out={$ctx.bind_argument}>
        <Call
            module="../workflow/bind_argument"
            in={{
                ast: $in.ast,
                origin: $in.index
            }}
        />
    </Task>

    <Call fn="../../statements/rows.readAstOrigin" in={$in.ast.writer} />
    <Call fn="../../statements/rows.astFieldCount" in={$in.ast.writer} />

    <Call
        fn="check_bounds"
        in={{
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            },
            items: $ctx.bind_target.items,
            index: $ctx.task.index
        }}
    />

    <Call
        module="../../intrinsics/guard/append"
        in={{
            writer: $in.ast.writer,
            fragment: $ctx.check_bounds
        }}
    />

    <Call
        fn="../../statements/rows.appendAstSequenceSpan"
        in={[
            $in.ast.sequence,
            $ctx.append
        ]}
    />

    <Call
        module="../workflow/bind_argument"
        in={{
            ast: $in.ast,
            origin: $in.value
        }}
    />

    <Call
        fn="convert"
        in={{
            ast: $in.ast,
            value: $ctx.bind_argument,
            source_type: $in.source_type
        }}
    />

    <Call
        fn="../../state/elements/materialize_type"
        in={{
            frame: $in.ast.lower,
            source: $in.ast.elements,
            list: $in.source_type
        }}
    />

    <Return
        value={{
            items: $ctx.bind_target.items,
            target: $ctx.bind_target.value,
            index: $ctx.task.index,
            value: $ctx.convert,
            element: $ctx.materialize_type
        }}
    />
</Module>
