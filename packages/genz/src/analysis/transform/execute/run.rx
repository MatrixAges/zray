<Module>
    <Type from="model" as="Transform" />

    <Args in={Transform.Input} out={Transform.Output} />

    <If on={$in.kind == Transform.TransformKind.Sort}>
        <Call fn="index.lowerTransformSort" in={$in.frame} />

        <Return value={$ctx.lowerTransformSort} />
    </If>

    <Call fn="index.enterTransformParameters" in={$in.frame} />

    <If
        on={$in.kind == Transform.TransformKind.Every ||
            $in.kind == Transform.TransformKind.Some}
    >
        <Call
            module="predicate"
            in={$in.pick([
                "frame",
                "ast",
                "kind",
                "target",
                "body_expr",
                "initial",
                "context_used",
                "context_name",
                "context_type"
            ])}
        />

        <Return value={$ctx.predicate} />
    </If>

    <Call fn="index.tryTransformSimd" in={$in.frame} />

    <If on={$ctx.tryTransformSimd != null}>
        <Return value={$ctx.tryTransformSimd} />
    </If>

    <Call
        fn="bind_source"
        in={{
            ast: $in.ast,
            target: $in.target
        }}
    />

    <Call
        fn="index.lowerType"
        in={[
            $in.ast.lower,
            $in.result_type,
            false
        ]}
    />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.ast.lower,
            $in.body_expr,
            false,
            null
        ]}
    />

    <If on={$in.kind == Transform.TransformKind.Reduce}>
        <Call
            module="reduce"
            in={{
                ...$in.pick([
                    "frame",
                    "ast",
                    "id",
                    "renewal_source",
                    "initial",
                    "state_active",
                    "inline_lists",
                    "accumulator"
                ]),
                source: $ctx.bind_source,
                callback: $ctx.lowerExpression,
                layout: $ctx.lowerType
            }}
        />

        <Return value={$ctx.reduce} />
    </If>

    <Call
        module="collect"
        in={{
            ...$in.pick([
                "frame",
                "ast",
                "kind",
                "result_type",
                "result_selected",
                "initial",
                "context_used",
                "context_name",
                "context_type",
                "element_symbol",
                "element_name"
            ]),
            source: $ctx.bind_source,
            callback: $ctx.lowerExpression
        }}
    />

    <Return value={$ctx.collect} />
</Module>
