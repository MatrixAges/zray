import { StatementsKind } from "../../../printer/model/statements"
import binding from "../../binding/emit"

import type { BindingRows } from "ast_rows"

export type Input = {
    value: u32,
    context_used: bool,
    context_name: u8[],
    type_expr?: u32
}

export type Output = BindingRows

export default function (in: Input): Output {
    return binding({
        kind: in.context_used ? StatementsKind.Constant : StatementsKind.Discard,
        name: in.context_name,
        type_expr: in.type_expr,
        value: in.value
    })
}
