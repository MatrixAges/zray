import { convertReduceValue } from "ast_rows"

import type { AstSequence, AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    sequence: AstSequence,
    result_type: u32,
    value: u32,
    active: bool
}

export type Output = u32

export default function (in: Input): Output {
    if (!in.active) {
        return in.value
    }

    return convertReduceValue(in.writer, in.sequence, in.result_type, in.value)
}
