import host from "lowering_host"

import type { Frame } from "./model"

export type Input = {
    frame: Frame,
    value: u32,
    initial: bool,
    active: bool
}

export type Output = u32

export default function (in: Input): Output {
    if (!in.active) {
        return in.value
    }

    return host.convertReduceValue(in.frame, in.value, in.initial)
}
