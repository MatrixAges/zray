<Module>
    <Type from="model" as="Transform" />

    <Args in={Transform.Frame} out={u32} />

    <Call fn="index.lowerReduceInitial" in={$in} />
    <Call fn="index.transformStateActive" in={$in} />

    <If on={$ctx.transformStateActive}>
        <Call fn="index.convertReduceInitial" in={$in} />
    </If>

    <Call fn="index.renewReduceStorage" in={$in} />

    <If on={$ctx.transformStateActive}>
        <Call fn="index.convertReduceCallback" in={$in} />
    </If>

    <Call fn="index.bindTransformElement" in={$in} />
    <Call fn="index.publishReduceTransform" in={$in} />

    <Return value={$ctx.publishReduceTransform} />
</Module>
