<Module>
    <Type from="model" as="Transform" />
    <Type from="../publication/model" as="Publication" />

    <Args in={Transform.Reduce} out={u32} />

    <Call
        fn="reduce_initial"
        in={{
            lower: $in.ast.lower,
            initial: $in.initial
        }}
    />

    <Call
        fn="index.convertInitial"
        in={{
            writer: $in.ast.writer,
            sequence: $in.ast.body,
            result_type: $in.result_type,
            value: $ctx.reduce_initial,
            active: $in.state_active
        }}
    />

    <Call
        module="renewal"
        in={{
            ...$in.pick([
                "id",
                "result_type",
                "accumulator",
                "inline_lists",
                "renewal_source"
            ]),
            frame: $in.ast.lower
        }}
    />

    <Call
        fn="index.convertCallback"
        in={{
            writer: $in.ast.writer,
            sequence: $in.ast.loop,
            result_type: $in.result_type,
            value: $in.callback,
            active: $in.state_active
        }}
    />

    <Call
        fn="index.bindTransformElement"
        in={[
            $in.ast.writer,
            $in.ast.binding,
            $in.source_type,
            $in.element_symbol
        ]}
    />

    <Call
        fn="block_name"
        in={{
            ast: $in.ast,
            predicate: false
        }}
    />

    <Call
        fn="index.outerBlock"
        in={[
            $in.ast.writer,
            $in.ast.body
        ]}
    />

    <Call
        fn="index.callbackBlock"
        in={[
            $in.ast.writer,
            $in.ast.loop
        ]}
    />

    <Call
        fn="index.elementBlock"
        in={[
            $in.ast.writer,
            $in.ast.binding
        ]}
    />

    <Call fn="index.reduceElementRange" />

    <Call fn="index.reduceCallbackRange" in={$ctx.callbackBlock} />

    <Call
        fn="index.joinAstStatementRows"
        in={[
            $in.ast.writer,
            [
                $ctx.reduceElementRange.start,
                $ctx.reduceCallbackRange.start
            ],
            [
                $ctx.reduceElementRange.count,
                $ctx.reduceCallbackRange.count
            ]
        ]}
    />

    <Call
        fn="split_reduce_spans"
        in={{
            start: $ctx.joinAstStatementRows,
            element: $ctx.reduceElementRange.count,
            callback: $ctx.reduceCallbackRange.count
        }}
    />

    <Call fn="index.outerRange" in={$ctx.outerBlock} />
    <Call fn="index.enteredRange" in={$ctx.renewal} />
    <Call fn="index.readAstOrigin" in={$in.ast.writer} />

    <Call
        module="../reduce/build"
        in={{
            ...$in.pick([
                "source",
                "layout",
                "accumulator"
            ]),
            ...$ctx.readAstOrigin.pick([
                "expression_base",
                "statement_base"
            ]),
            ...$ctx.split_reduce_spans.omit([
                "before",
                "after"
            ]),
            initial: $ctx.convertInitial,
            callback: $ctx.convertCallback,
            capture: $ctx.bindTransformElement,
            label: $ctx.block_name,
            entered_start: $ctx.enteredRange.start,
            entered_count: $ctx.enteredRange.count,
            outer_count: $ctx.outerRange.count
        }}
    />

    <Call
        module="../publication/append"
        in={{
            writer: $in.ast.writer,
            expressions: $ctx.build.expressions,
            forms: null,
            prelude: null,
            element: $ctx.split_reduce_spans.before,
            step: $ctx.build.update,
            remainder: $ctx.split_reduce_spans.after,
            outer: $ctx.outerBlock,
            result: $ctx.build.outer,
            variables: $ctx.build.variables,
            ownership: Publication.AstPayloadOwnership.Borrowed,
            valid: $ctx.build.valid
        }}
    />

    <Return value={$ctx.build.root} />
</Module>
