import bytes from "std:bytes"
import { TransformKind } from "core/expression_table/kinds"
import host from "lowering_host"

import { items } from "./const"

import type { Prepare } from "../collect/model"
import type { Collection } from "./model"

export type Input = Collection.Pick("frame", "kind")

export type Output = Prepare.Pick(
    "name",
    "element",
    "map"
)

export default function (in: Input): Output {
    const map = in.kind == TransformKind.Map
    const name = map ? bytes.fromText("") : host.transformFreshName(in.frame, items)
    const element = host.transformCollectionElement(in.frame)

    return {
        name,
        element,
        map
    }
}
