import bytes from "std:bytes"
import { TransformKind } from "core/expression_table/kinds"

import materializeType from "../../state/elements/materialize_type"
import { items } from "./const"
import freshName from "./fresh_name"

import type { Prepare } from "../collect/model"
import type { Collection } from "./model"

export type Input = Collection.Pick("ast", "kind", "result_type")

export type Output = Prepare.Pick("name", "element", "map")

export default function (in: Input): Output {
    const map = in.kind == TransformKind.Map

    const name = match map {
        true => bytes.fromText(""),
        _ => freshName({
            lower: in.ast.lower,
            writer: in.ast.writer,
            prefix: items
        })
    }

    const element = materializeType({
        frame: in.ast.lower,
        source: in.ast.elements,
        list: in.result_type
    })

    return {
        name,
        element,
        map
    }
}
