import { readAstOrigin } from "ast_rows"
import host from "lowering_host"

import fresh from "../../../ast/fresh"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    lower: Lowering,
    writer: AstWriter,
    prefix: string
}

export type Output = u8[]

export default function (in: Input): Output {
    const { lower, writer, prefix } = in

    const current = readAstOrigin(writer)

    const generated = fresh({
        serial: current.serial,
        prefix
    })

    const name = host.retainLoweringText(lower, generated.name)

    host.finishGeneratedAst(lower, generated.serial, false)

    return name
}
