import type { AstSequence, AstWriter } from "ast_rows"
import type { TransformKind } from "core/expression_table/kinds"
import type { Lowering, TransformFrame } from "lowering_host"
import type { Source as RenewalSource } from "../../iteration/deferred/model"

export { TransformKind } from "core/expression_table/kinds"

export type Frame = TransformFrame

export type Ast = {
    writer: AstWriter,
    lower: Lowering,
    body: AstSequence,
    loop: AstSequence,
    binding: AstSequence
}

export type Input = {
    frame: Frame,
    ast: Ast,
    kind: TransformKind,
    id: u32,
    target: u32,
    result_type: u32,
    result_selected: bool,
    body_expr: u32,
    initial?: u32,
    context_used: bool,
    context_name: u8[],
    context_type: u32,
    element_symbol: u32,
    element_name: u8[],
    state_active: bool,
    inline_lists: bool,
    accumulator: u8[],
    renewal_source?: RenewalSource
}

export type ContextBinding =
    Input.Pick("ast", "initial", "context_used", "context_name", "context_type")

export type Predicate = Input.Pick(
    "frame",
    "ast",
    "kind",
    "target",
    "body_expr",
    "initial",
    "context_used",
    "context_name",
    "context_type"
)

export type Collection =
    Input.Pick(
        "frame",
        "ast",
        "kind",
        "result_type",
        "result_selected",
        "initial",
        "context_used",
        "context_name",
        "context_type",
        "element_symbol",
        "element_name"
    ) & {
        source: u32,
        callback: u32
    }

export type Reduce = Input.Pick(
    "frame",
    "ast",
    "id",
    "renewal_source",
    "initial",
    "state_active",
    "inline_lists",
    "accumulator"
) & {
    source: u32,
    callback: u32,
    layout: u32
}

export type Renewal =
    Input.Pick("frame", "id", "accumulator", "inline_lists", "renewal_source")

export type Output = u32?
