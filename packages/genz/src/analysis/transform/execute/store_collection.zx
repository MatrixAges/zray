import { appendAstIdentifierRows, astExpressionCount } from "ast_rows"
import host from "lowering_host"

import { ExpressionsKind } from "../../../printer/model/expressions"
import bindOperand from "../../aggregate/execute/bind_operand"
import { index } from "./const"
import freshName from "./fresh_name"

import type { Publish } from "../collect/model"
import type { Collection } from "./model"

export type Input =
    Collection.Pick(
        "frame",
        "ast",
        "callback",
        "element_symbol",
        "element_name"
    ) & {
        result: u32,
        map: bool
    }

export type Output = Publish.Pick("result", "value", "index")

export default function (in: Input): Output {
    const { frame, ast, callback } = in

    if (in.map) {
        const result = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            origin: ast.origin,
            sequence: ast.body,
            value: in.result
        })

        const name = freshName({
            lower: ast.lower,
            writer: ast.writer,
            origin: ast.origin,
            prefix: index
        })

        const bound = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            origin: ast.origin,
            sequence: ast.loop,
            value: callback
        })

        const value = host.storeMapTransformValue(frame, bound)

        return {
            result,
            value,
            index: name
        }
    }

    const identifier = astExpressionCount(ast.writer)

    appendAstIdentifierRows(ast.writer, {
        tags: [ExpressionsKind.Identifier],
        offsets: [0],
        identifier: [in.element_name]
    })

    const value = host.storeMapTransformValue(frame, identifier)

    return {
        result: in.result,
        value,
        index: null
    }
}
