import {
    appendAstIdentifierRows,
    astExpressionCount,
    storeFilterTransformValue,
    writeCollectionElement
} from "ast_rows"

import { ExpressionsKind } from "../../../printer/model/expressions"
import bindOperand from "../../aggregate/execute/bind_operand"
import { index } from "./const"
import freshName from "./fresh_name"

import type { Publish } from "../collect/model"
import type { Collection } from "./model"

export type Input =
    Collection.Pick(
        "ast",
        "callback",
        "result_type",
        "element_symbol",
        "element_name"
    ) & {
        result: u32,
        map: bool
    }

export type Output = Publish.Pick("result", "value", "index")

export default function (in: Input): Output {
    const { ast, callback, result_type } = in

    if (in.map) {
        const result = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.body,
            value: in.result
        })

        const name = freshName({
            lower: ast.lower,
            writer: ast.writer,
            prefix: index
        })

        const bound = bindOperand({
            frame: ast.lower,
            writer: ast.writer,
            sequence: ast.loop,
            value: callback
        })

        const value = writeCollectionElement(ast.writer, ast.loop, result_type, bound)

        return {
            result,
            value,
            index: name
        }
    }

    const identifier = astExpressionCount(ast.writer)

    appendAstIdentifierRows(ast.writer, {
        tags: [ExpressionsKind.Identifier],
        offsets: [0],
        identifier: [in.element_name]
    })

    const value = storeFilterTransformValue(
        ast.writer,
        ast.loop,
        result_type,
        in.element_symbol,
        identifier
    )

    return {
        result: in.result,
        value,
        index: null
    }
}
