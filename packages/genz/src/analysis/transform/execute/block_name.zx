import { accumulator_block, predicate_block } from "./const"
import freshName from "./fresh_name"

import type { Ast } from "./model"

export type Input = {
    ast: Ast,
    predicate: bool
}

export type Output = u8[]

export default function (in: Input): Output {
    const prefix = in.predicate ? predicate_block : accumulator_block

    return freshName({
        lower: in.ast.lower,
        writer: in.ast.writer,
        prefix
    })
}
