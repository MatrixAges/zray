<Module>
    <Type from="model" as="Transform" />
    <Type from="../publication/model" as="Publication" />

    <Args in={Transform.Predicate} out={u32} />

    <Call fn="index.bindTransformSource" in={$in.frame} />

    <Call
        fn="block_name"
        in={{
            ast: $in.ast,
            predicate: true
        }}
    />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.ast.lower,
            $in.body_expr,
            false,
            null
        ]}
    />

    <Call
        fn="bind_context"
        in={$in.pick([
            "ast",
            "initial",
            "context_used",
            "context_name",
            "context_type"
        ])}
    />

    <Call fn="index.bindTransformElement" in={$in.frame} />

    <Call
        fn="index.outerBlock"
        in={[
            $in.ast.writer,
            $in.ast.body
        ]}
    />

    <Call
        fn="index.elementBlock"
        in={[
            $in.ast.writer,
            $in.ast.binding
        ]}
    />

    <Call fn="index.outerRange" in={$ctx.outerBlock} />
    <Call fn="index.elementRange" in={$ctx.elementBlock} />

    <Call
        fn="index.readAstOrigin"
        in={[
            $in.ast.writer,
            $in.ast.origin
        ]}
    />

    <Call
        module="../../predicates/build"
        in={{
            ...$ctx.readAstOrigin.pick([
                "expression_base",
                "statement_base"
            ]),
            kind: $in.kind,
            source: $ctx.bindTransformSource,
            callback: $ctx.lowerExpression,
            label: $ctx.block_name,
            capture: $ctx.bindTransformElement,
            outer_count: $ctx.outerRange.count,
            element_count: $ctx.elementRange.count
        }}
    />

    <Call
        module="../publication/append"
        in={{
            writer: $in.ast.writer,
            expressions: $ctx.build.expressions,
            forms: $ctx.build.forms,
            prelude: $ctx.build.stop,
            element: $ctx.elementBlock,
            step: $ctx.build.decision,
            remainder: null,
            outer: $ctx.outerBlock,
            result: $ctx.build.main,
            variables: null,
            ownership: Publication.AstPayloadOwnership.BorrowingText,
            valid: $ctx.build.valid
        }}
    />

    <Return value={$ctx.build.root} />
</Module>
