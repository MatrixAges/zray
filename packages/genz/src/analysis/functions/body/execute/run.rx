<Module>
    <Type from="model" as="Function" />

    <Args in={Function.Input} out={Function.Output} />

    <Call fn="index.prepareFunctionBody" in={$in.frame} />

    <Call module="sections" in={$in} />

    <Call
        fn="resolve_types"
        in={$in.pick([
            "frame",
            "input_id",
            "output_id",
            "value",
            "public_value"
        ])}
    />

    <Call fn="index.readAstOrigin" in={$in.writer} />
    <Call fn="index.astFieldCount" in={$in.writer} />

    <Call
        module="../../signature/build"
        in={{
            ...$in.pick([
                "name",
                "store_count",
                "io",
                "process",
                "exported",
                "inlined"
            ]),
            ...$ctx.resolve_types,
            errors: $ctx.prepareFunctionBody,
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount,
                capture: null
            }
        }}
    />

    <Call fn="index.requireAllocation" in={$ctx.build.valid} />
    <Call fn="index.emptyForms" in={{}} />
    <Call fn="../../../../ast/expressions/empty_extensions" in={{}} />

    <Call
        fn="index.appendExtendedExpressions"
        in={[
            $in.writer,
            $ctx.build.expressions,
            {
                ...$ctx.emptyForms,
                ...$ctx.build.forms
            },
            {
                ...$ctx.empty_extensions,
                ...$ctx.build.extra
            }
        ]}
    />

    <Return
        value={{
            ...$ctx.sections,
            ...$ctx.build.pick([
                "name",
                "parameters",
                "return_type",
                "exported",
                "inlined"
            ])
        }}
    />
</Module>
