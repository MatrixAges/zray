import host from "lowering_host"
import { BodySection } from "lowering_host"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { body, stores } = in

    if (stores) {
        host.lowerFunctionPending(body)
    }

    host.lowerFunctionReferences(body)

    if (stores) {
        host.lowerFunctionCommit(body)
    }

    host.publishFunctionBody(
        body,
        BodySection.Prelude,
        BodySection.Pending,
        BodySection.References,
        BodySection.Contracts,
        BodySection.Statements,
        BodySection.Commit
    )
}
