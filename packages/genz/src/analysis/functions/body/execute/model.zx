import type { AstWriter } from "ast_rows"
import type { FunctionBody } from "lowering_host"

export type Input = {
    body: FunctionBody,
    writer: AstWriter,
    stores: bool
}

export type Sections = {
    writer: AstWriter,
    spans: u64[]
}

export type Block = {
    start: u32,
    count: u32
}
