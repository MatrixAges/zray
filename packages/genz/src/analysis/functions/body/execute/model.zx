import type { AstWriter, FieldRows } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    name: u8[],
    input_id: u32,
    output_id: u32,
    store_count: u64,
    exported: bool,
    inlined: bool,
    io: bool,
    process: bool,
    value: bool,
    public_value: bool
}

export type Sections = {
    writer: AstWriter,
    spans: u64[]
}

export type Block = {
    start: u32,
    count: u32
}

export type Output = Block & {
    name: u8[],
    parameters: FieldRows,
    return_type: u32,
    exported: bool,
    inlined: bool
}
