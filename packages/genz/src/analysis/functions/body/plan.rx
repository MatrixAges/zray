<Module>
    <Type from="model" as="Body" />

    <Args in={Body.Form} out={Body.Step[]} />

    <Switch on={$in}>
        <Case value={Body.Form.Plain}>
            <Return
                value={[
                    Body.Step.Errors,
                    Body.Step.Workspace,
                    Body.Step.Statements,
                    Body.Step.Contracts,
                    Body.Step.Prelude,
                    Body.Step.References,
                    Body.Step.Signature
                ]}
            />
        </Case>

        <Case value={Body.Form.Store}>
            <Return
                value={[
                    Body.Step.Errors,
                    Body.Step.Workspace,
                    Body.Step.Statements,
                    Body.Step.Contracts,
                    Body.Step.Prelude,
                    Body.Step.Pending,
                    Body.Step.References,
                    Body.Step.Commit,
                    Body.Step.Signature
                ]}
            />
        </Case>

        <Case value={Body.Form.Layout}>
            <Return
                value={[
                    Body.Step.Prelude,
                    Body.Step.Pending,
                    Body.Step.References,
                    Body.Step.Contracts,
                    Body.Step.Statements,
                    Body.Step.Commit
                ]}
            />
        </Case>
    </Switch>
</Module>
