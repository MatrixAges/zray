<Module>
    <Type from="../allocation" as="Allocation" />
    <Type from="../symbol_names/publish" as="Names" />
    <Type from="initialize" as="Initialize" />

    <Args
        in={Allocation.Input & Names.Target & Initialize.Input}
        out={{
            allows_allocation: Allocation.Output,
            names: Names.Output,
            used_fill: bool,
            read_fill: u64
        }}
    />

    <Call
        fn="../allocation"
        in={{
            errors: $in.errors
        }}
    />

    <Call
        module="../symbol_names/build"
        in={$in.pick(["count"])}
    />

    <Call
        fn="initialize"
        in={$in.pick([
            "used_count",
            "read_count"
        ])}
    />

    <Return
        value={{
            allows_allocation: $ctx.allocation,
            names: $ctx.build,
            used_fill: $ctx.initialize.used_fill,
            read_fill: $ctx.initialize.read_fill
        }}
    />
</Module>
