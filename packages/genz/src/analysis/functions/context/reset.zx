export enum Form {
    Body,
    Adapter,
    StateView
}

export enum Field {
    References,
    ProjectedSymbols,
    InputAliases,
    UsesAllocator,
    UsesContext,
    UsesIo,
    UsesProcess,
    AllowsAllocation
}

export type Input = Form

export type Output = Field[]

export default function (in: Input): Output {
    return match in {
        Form.Body => [
            Field.References,
            Field.ProjectedSymbols,
            Field.InputAliases,
            Field.UsesAllocator,
            Field.UsesContext,
            Field.UsesIo,
            Field.UsesProcess
        ],
        Form.Adapter => [
            Field.References,
            Field.UsesAllocator,
            Field.UsesContext,
            Field.UsesIo,
            Field.UsesProcess,
            Field.AllowsAllocation
        ],
        _ => [Field.References]
    }
}
