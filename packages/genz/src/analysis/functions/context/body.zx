export enum Form {
    Function,
    Predicate,
    Native
}

export enum Field {
    Symbols,
    Expressions,
    Body,
    InputType,
    OutputType,
    Stores,
    StoreMode,
    Contracts
}

export type Input = Form

export type Output = Field[]

export default function (in: Input): Output {
    return match in {
        Form.Function => [
            Field.Symbols,
            Field.Expressions,
            Field.Body,
            Field.InputType,
            Field.OutputType,
            Field.Stores,
            Field.StoreMode,
            Field.Contracts
        ],
        Form.Predicate => [
            Field.Symbols,
            Field.Expressions
        ],
        _ => [
            Field.InputType,
            Field.OutputType,
            Field.Stores,
            Field.StoreMode
        ]
    }
}
