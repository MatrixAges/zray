import { input_name } from "../symbol_names/const"
import { Names } from "./scope"

export type Input = {
    symbols: u64,
    expressions: u64,
    name_source: Names
}

export type Output = {
    names_count: u64,
    initial_name?: string,
    used_count: u64,
    reads_count: u64
}

export default function (in: Input): Output {
    return {
        names_count: match in.name_source {
            Names.Own => in.symbols,
            Names.Input => 1,
            _ => 0
        },
        initial_name: match in.name_source {
            Names.Input => input_name,
            _ => null
        },
        used_count: in.symbols,
        reads_count: in.expressions
    }
}
