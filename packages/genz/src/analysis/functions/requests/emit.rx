<Module>
    <Type from="model" as="Requests" />

    <Args in={Requests.Form} out={Requests.EmitStep[]} />

    <Switch on={$in}>
        <Case value={Requests.Form.Native}>
            <Return value={[Requests.EmitStep.Native]} />
        </Case>

        <Case value={Requests.Form.FirstRegular}>
            <Return
                value={[
                    Requests.EmitStep.Enter,
                    Requests.EmitStep.Store,
                    Requests.EmitStep.Regular,
                    Requests.EmitStep.Parallel
                ]}
            />
        </Case>

        <Case value={Requests.Form.Regular}>
            <Return
                value={[
                    Requests.EmitStep.Enter,
                    Requests.EmitStep.Regular,
                    Requests.EmitStep.Parallel
                ]}
            />
        </Case>

        <Case value={Requests.Form.FirstValue}>
            <Return
                value={[
                    Requests.EmitStep.Enter,
                    Requests.EmitStep.Store,
                    Requests.EmitStep.Value,
                    Requests.EmitStep.Parallel
                ]}
            />
        </Case>

        <Case value={Requests.Form.Value}>
            <Return
                value={[
                    Requests.EmitStep.Enter,
                    Requests.EmitStep.Value,
                    Requests.EmitStep.Parallel
                ]}
            />
        </Case>

        <Case value={Requests.Form.Done}>
            <Return value={[]} />
        </Case>
    </Switch>
</Module>
