export enum Variant {
    Regular,
    Value
}

export type State = {
    ids: u32[],
    variants: Variant[],
    first: bool[],
    seen: u8[],
    next: u64
}

export type Request = {
    id: u32,
    variant: Variant
}

export type Push = {
    state: State,
    id: u32,
    variant: Variant
}

export enum Form {
    Done,
    Native,
    FirstRegular,
    Regular,
    FirstValue,
    Value
}

export type Take = State.Pick("ids", "variants", "first", "next") & {
    native_modules: u32?[]
}

export type Taken = {
    id: u32,
    next: u64,
    form: Form
}

export enum EmitStep {
    Native,
    Enter,
    Store,
    Regular,
    Value,
    Parallel
}
