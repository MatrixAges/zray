import type { U64Buffer } from "memory"

export enum Variant {
    Regular,
    Value
}

export type State = {
    ids: u32[],
    forms: Form[],
    seen: u8[],
    next: u64
}

export type Request = {
    id: u32,
    variant: Variant
}

export type Push = {
    state: State,
    id: u32,
    variant: Variant
}

export enum Form {
    Done,
    Native,
    FirstRegular,
    Regular,
    FirstValue,
    Value
}

export type Take = State.Pick("ids", "forms", "next") & {
    native_modules: u32?[],
    cursor: U64Buffer
}

export type Taken = {
    id: u32,
    form: Form
}
