import integers from "std:integer"

import { Form } from "./model"

import type { Take as Input, Taken as Output } from "./model"

export default function (in: Input): Output {
    const { next } = in

    if (next == in.ids.length) {
        return {
            id: 0,
            form: Form.Done,
            next
        }
    }

    const id = in.ids[next]
    const local = in.native_modules[integers.widen(id)] == null
    const form = local ? in.forms[next] : Form.Native

    return {
        id,
        form,
        next: next + 1
    }
}
