import integers from "std:integer"

import { Form, Variant } from "./model"

import type { Take as Input, Taken as Output } from "./model"

export default function (in: Input): Output {
    const { next } = in

    if (next == in.ids.length) {
        return {
            id: 0,
            next,
            form: Form.Done
        }
    }

    const id = in.ids[next]
    const first = in.first[next]
    const regular = in.variants[next] == Variant.Regular

    const form = match {
        in.native_modules[integers.widen(id)] != null => Form.Native,
        regular && first => Form.FirstRegular,
        regular => Form.Regular,
        first => Form.FirstValue,
        _ => Form.Value
    }

    return {
        id,
        next: next + 1,
        form
    }
}
