<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.ModuleRequestForm} out={Flow.Output} />

    <If on={$in == Flow.ModuleRequestForm.Done}>
        <Return
            value={{
                steps: [],
                comparisons: 0
            }}
        />
    </If>

    <Call fn="emit" in={$in} />

    <Return
        value={{
            steps: $ctx.emit,
            comparisons: 0
        }}
    />
</Module>
