import { ModuleRequestForm } from "lowering_host"

export type Input = ModuleRequestForm

export type Output = {
    native: bool,
    first: bool,
    value: bool
}

export default function (in: Input): Output {
    return {
        native: in == ModuleRequestForm.Native,
        first: in == ModuleRequestForm.FirstRegular || in == ModuleRequestForm.FirstValue,
        value: in == ModuleRequestForm.Value || in == ModuleRequestForm.FirstValue
    }
}
