import { ModuleRequestForm } from "lowering_host"

import { Step } from "./model"

import type { ModuleRequestForm as Input } from "lowering_host"

export type Output = Step[]

export default function (in: Input): Output {
    if (in == ModuleRequestForm.Native) {
        return [Step.RequestedNative]
    }

    const first =
        in == ModuleRequestForm.FirstRegular || in == ModuleRequestForm.FirstValue

    const value = in == ModuleRequestForm.Value || in == ModuleRequestForm.FirstValue
    const opened: Step[] = [Step.RequestedOpen]
    const prepared = first ? opened.push(Step.RequestedStore)[0] : opened
    const body = value ? Step.RequestedValue : Step.RequestedRegular

    return prepared.push(body)[0].push(Step.RequestedPublish)[0]
}
