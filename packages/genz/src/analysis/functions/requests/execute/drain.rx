<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Frame} out={void} />

    <Call fn="model.takeModuleFunction" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="request"
            in={{
                frame: $in,
                form: $ctx.takeModuleFunction,
                running: $ctx.takeModuleFunction != Flow.ModuleRequestForm.Done
            }}
        />
    </Loop>
</Module>
