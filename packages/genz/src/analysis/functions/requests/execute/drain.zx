import host from "lowering_host"
import { ModuleRequestForm } from "lowering_host"

import emit from "./emit"

import type { ModuleFrame as Input } from "lowering_host"

export type Output = void

export default function (in: Input): Output {
    const emitted = loop({
        form: host.takeModuleFunction(in)
    }, {
        while: state => state.form != ModuleRequestForm.Done,
        next: state => {
            emit({
                module_frame: in,
                form: state.form
            })

            state.form = host.takeModuleFunction(in)
        },
        return: state => state.form
    })
}
