import type {
    ExpressionsKind,
    ExpressionsBuiltinName
} from "../../../../printer/model/expressions"
import type { Request } from "../model"

export type Target = Request & {
    module?: string,
    recursive: bool,
    local_regular: bool
}

export type Name = {
    text: u8[],
    module?: string
}

export type Input = {
    target: Target,
    base: u32,
    identifiers: u64
}

export type Build = Input.Omit("target") & {
    name: Name
}

export type Nodes = {
    tags: ExpressionsKind[],
    offsets: u32[],
    identifier: u8[][],
    string: u8[][],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][],
    field_target: u32[],
    field_name: u8[][]
}

export type Output = {
    nodes: Nodes,
    root: u32
}
