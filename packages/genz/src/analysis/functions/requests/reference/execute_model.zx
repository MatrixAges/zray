import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Output, Target } from "./model"

export { astExpressionCount } from "ast_rows"

export type Execute = {
    frame: Lowering,
    writer: AstWriter,
    target: Target
}

export type Publish = Execute & {
    output: Output
}
