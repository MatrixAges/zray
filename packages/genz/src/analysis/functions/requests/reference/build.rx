<Module>
    <Type from="model" as="Reference" />

    <Args in={Reference.Input} out={Reference.Output} />

    <Call fn="resolve" in={$in.target} />

    <Call
        fn="nodes"
        in={{
            ...$in.pick([
                "base",
                "identifiers"
            ]),
            name: $ctx.resolve
        }}
    />

    <Return value={$ctx.nodes} />
</Module>
