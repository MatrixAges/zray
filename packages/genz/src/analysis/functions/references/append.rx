<Module>
    <Type from="model" as="References" />
    <Type from="../../node_headers/model" as="Headers" />

    <Args in={References.Input} out={References.Output} />

    <Call module="../../node_headers/payload/validated" in={$in.payload} />

    <If on={$ctx.validated == Headers.Check.Valid}>
        <Call fn="publish" in={$in} />

        <Return
            value={{
                check: $ctx.validated,
                span: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            check: $ctx.validated,
            span: 0
        }}
    />
</Module>
