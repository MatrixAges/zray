import encoding from "std:encoding"
import { decimal_radix } from "core/const"
import memory from "memory"

import { input_name, local_prefix } from "./const"

import type { StringBuffer } from "memory"

export type Target = {
    count: u64,
    target: StringBuffer
}

export type Input = Target & {
    bytes: u8[]
}

export type Output = void

export default function (in: Input): Output {
    if (in.count == 0) {
        return
    }

    const text = encoding.decodeUtf8(in.bytes)

    memory.writeString(in.target, 0, input_name)

    const written = loop({
        start: input_name.length,
        index: 1,
        width: local_prefix.length + 1,
        next_width: decimal_radix
    }, {
        while: state => state.index < in.count,
        next: state => {
            if (state.index == state.next_width) {
                state.width += 1
                state.next_width *= decimal_radix
            }

            const name = memory.borrowTextRange(text, state.start, state.width)

            memory.writeString(in.target, state.index, name)
            state.start += state.width
            state.index += 1
        }
    })
}
