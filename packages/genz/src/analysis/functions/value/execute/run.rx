<Module>
    <Type from="model" as="Value" />

    <Args in={Value.Input} out={Value.Step[]} />

    <Return
        value={[
            ($in.enter ? Value.Step.Enter : Value.Step.Reuse),
            ($in.bind_input ? Value.Step.Bind : Value.Step.Open),
            ($in.value_output ? Value.Step.Value : Value.Step.Abi),
            ($in.signature ? Value.Step.Prototype : Value.Step.Body)
        ]}
    />
</Module>
