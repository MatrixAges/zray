import { ModuleFunctionForm } from "lowering_host"

import { unnamed_parameter } from "../module/const"

export type Input = ModuleFunctionForm

export type Output = {
    native: bool,
    regular: bool,
    value: bool,
    parameter_name: string
}

export default function (in: Input): Output {
    return {
        native: in == ModuleFunctionForm.Native,
        regular: in != ModuleFunctionForm.Value,
        value: in != ModuleFunctionForm.Regular,
        parameter_name: unnamed_parameter
    }
}
