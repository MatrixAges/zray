import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { ContractKind } from "core/contract_table/model"
import type { Lowering } from "lowering_host"

export type Input = {
    parent: Lowering,
    predicate: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    kinds: ContractKind[],
    predicates: u32[]
}

export type Walk = {
    source: Input,
    index: u64,
    running: bool,
    spans: u64[]
}

export type Lower = Input.Pick(
    "parent",
    "predicate",
    "writer",
    "origin"
) & {
    expression: u32
}
