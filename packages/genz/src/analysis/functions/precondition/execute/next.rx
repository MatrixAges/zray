<Module>
    <Type from="model" as="Contract" />
    <Type from="core/contract_table/model" as="Table" />

    <Args in={Contract.Walk} out={Contract.Walk} />

    <If on={$in.source.kinds[$in.index] == Table.ContractKind.Requires}>
        <Call
            fn="index.openPreconditionScope"
            in={[
                $in.source.parent,
                $in.source.predicate,
                $in.index
            ]}
        />

        <Call
            module="lower"
            in={{
                ...$in.source.pick([
                    "parent",
                    "predicate",
                    "writer",
                    "origin"
                ]),
                expression: $in.source.predicates[$in.index]
            }}
        />

        <Call
            fn="advance"
            in={{
                cursor: $in,
                span: $ctx.lower
            }}
        />

        <Return value={$ctx.advance} />
    </If>

    <Call
        fn="advance"
        in={{
            cursor: $in,
            span: null
        }}
    />

    <Return value={$ctx.advance} />
</Module>
