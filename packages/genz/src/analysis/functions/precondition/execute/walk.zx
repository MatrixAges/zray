import { ContractKind } from "core/contract_table/model"
import host from "lowering_host"

import lower from "./lower.rx"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const contracts = loop(0, {
        while: index => index < in.kinds.length,
        next: index => {
            if (in.kinds[index] == ContractKind.Requires) {
                host.openPreconditionScope(in.frame, index)
                lower(in.frame)
            }

            index += 1
        }
    })
}
