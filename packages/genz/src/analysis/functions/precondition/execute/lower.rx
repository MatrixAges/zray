<Module>
    <Type from="model" as="Contract" />

    <Args in={Contract.Lower} out={u64} />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.predicate,
            $in.expression,
            false,
            null
        ]}
    />

    <Call fn="index.readAstOrigin" in={$in.writer} />

    <Call
        module="../build"
        in={{
            bases: {
                ...$ctx.readAstOrigin,
                field_base: 0
            },
            predicate: $ctx.lowerExpression
        }}
    />

    <Call
        module="../../../intrinsics/guard/append"
        in={{
            writer: $in.writer,
            fragment: $ctx.build
        }}
    />

    <Call
        fn="index.publishPreconditionScope"
        in={[
            $in.parent,
            $in.predicate
        ]}
    />

    <Return value={$ctx.append} />
</Module>
