import ast from "ast_rows"
import { AstPayloadOwnership } from "ast_rows"
import { requireAllocation } from "memory"

import type { AstSequence, AstWriter } from "ast_rows"
import type { Output as Fragment } from "../../../intrinsics/guard/model"

export type Input = {
    writer: AstWriter,
    body: AstSequence,
    fragment: Fragment
}

export type Output = void

export default function (in: Input): Output {
    const { writer, body, fragment } = in

    requireAllocation(fragment.valid)

    ast.appendExpressionRows(
        writer,
        fragment.expressions,
        fragment.forms,
        AstPayloadOwnership.BorrowingText
    )

    ast.appendStatementRows(
        writer,
        fragment.statements,
        null,
        AstPayloadOwnership.BorrowingText
    )

    ast.appendStatementSequence(writer, body, fragment.roots, {
        variable_name: [],
        variable_type_expr: [],
        variable_value: [],
        variable_exported: []
    })
}
