import integers from "std:integer"

import constants from "../../../ast/declarations/constants"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const first = integers.narrow(in.members.length)
    const contents = in.members.concat(in.roots)[0]

    const declarations = constants({
        values: contents,
        base: 0
    })

    return {
        expressions: in.expressions,
        declarations: declarations.table,
        first,
        valid: in.valid && declarations.valid
    }
}
