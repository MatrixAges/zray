<Module>
    <Type from="model" as="Guard" />
    <Type from="../../statements/rows" as="AST" />

    <Args in={Guard.Publication} out={u64} />

    <Call fn="../../statements/rows.requireAllocation" in={$in.fragment.valid} />

    <Call
        fn="../../statements/rows.appendExpressionRows"
        in={[
            $in.writer,
            $in.fragment.expressions,
            $in.fragment.forms,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../../statements/rows.appendStatementRows"
        in={[
            $in.writer,
            $in.fragment.statements,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../../statements/rows.publishAstBasicStatements"
        in={[
            $in.writer,
            $in.fragment.roots.pick([
                "tags",
                "offsets",
                "discard",
                "assignment_target",
                "assignment_value",
                "branch_condition",
                "branch_yes_start",
                "branch_yes_len",
                "branch_no_start",
                "branch_no_len",
                "branch_capture",
                "branch_capture_reference",
                "branch_error_capture"
            ])
        ]}
    />

    <Return value={$ctx.publishAstBasicStatements} />
</Module>
