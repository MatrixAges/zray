import bytes from "std:bytes"
import { max_u32 } from "core/const"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"
import { retainLoweringText } from "lowering_host"

import emptyExpressions from "../../ast/expressions/empty"
import {
    ExpressionsKind,
    ExpressionsBinaryOperator
} from "../../printer/model/expressions"
import { context_name } from "../comparison/const"
import { Property } from "../state/queries/model"
import query from "../state/queries/read"
import { pending_name } from "../store/const"
import slotName from "../store/slot_name"
import policy from "../store/transaction/policy"
import { Result } from "./model"

import type { ExpressionRows } from "ast_rows"
import type { StoreMode } from "core/function_table/complete"
import type { Lowering } from "lowering_host"
import type { Query } from "../state/queries/model"

export type Input = {
    frame: Lowering,
    slot: u64,
    type_kind: u8,
    query: Query,
    active: bool,
    store_count: u64,
    store_mode: StoreMode,
    expression_base: u32
}

export type Output = {
    nodes: ExpressionRows,
    root: u32,
    result: Result,
    valid: bool
}

export default function (in: Input): Output {
    const transaction = policy({
        mode: in.store_mode,
        count: in.store_count
    })

    const count: u32 = transaction ? 6 : 3
    const base = in.expression_base

    const represented = in.active && query({
        value: in.query,
        property: Property.Represented
    })

    const result = match {
        !represented => Result.Direct,
        kind(in.type_kind) == Kind.List => Result.BorrowedList,
        _ => Result.Value
    }

    if (base > max_u32 - count) {
        return {
            nodes: emptyExpressions({}),
            root: base,
            result,
            valid: false
        }
    }

    const name = retainLoweringText(in.frame, slotName(in.slot))

    const nodes: ExpressionRows = {
        ...emptyExpressions({}),
        tags: [
            ExpressionsKind.Identifier,
            ExpressionsKind.Field,
            ExpressionsKind.Dereference
        ],
        offsets: [
            0,
            0,
            0
        ],
        identifier: [bytes.fromText(context_name)],
        field_target: [base],
        field_name: [name],
        dereference: [base + 1]
    }

    if (!transaction) {
        return {
            nodes,
            root: base + 2,
            result,
            valid: true
        }
    }

    return {
        nodes: {
            ...nodes,
            tags: nodes.tags.concat([
                ExpressionsKind.Identifier,
                ExpressionsKind.Field,
                ExpressionsKind.Binary
            ])[0],
            offsets: nodes.offsets.concat([
                1,
                1,
                0
            ])[0],
            identifier: nodes.identifier.push(bytes.fromText(pending_name))[0],
            field_target: nodes.field_target.push(base + 3)[0],
            field_name: nodes.field_name.push(name)[0],
            binary_operator: [ExpressionsBinaryOperator.Coalesce],
            binary_left: [base + 4],
            binary_right: [base + 2]
        },
        root: base + 5,
        result,
        valid: true
    }
}
