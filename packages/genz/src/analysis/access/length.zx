import bytes from "std:bytes"
import { max_u32 } from "core/const"

import {
    ExpressionsKind,
    ExpressionsBuiltinName
} from "../../printer/model/expressions"
import { length_member } from "../intrinsics/index/const"
import { items_field } from "../iteration/types/const"

export type Input = {
    source: u32,
    type_expr: u32,
    base: u32,
    buffered: bool
}

export type Rows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    field_target: u32[],
    field_name: u8[][],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][]
}

export type Output = {
    rows: Rows,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    const count: u32 = in.buffered ? 3 : 2

    if (in.base > max_u32 - count) {
        return {
            rows: {
                tags: [],
                offsets: [],
                field_target: [],
                field_name: [],
                builtin_name: [],
                builtin_arguments: []
            },
            root: in.base,
            valid: false
        }
    }

    const length = in.base + count - 2

    const names = match {
        in.buffered => [
            bytes.fromText(items_field),
            bytes.fromText(length_member)
        ],
        _ => [bytes.fromText(length_member)]
    }

    const targets = match {
        in.buffered => [
            in.source,
            in.base
        ],
        _ => [in.source]
    }

    const tags = match {
        in.buffered => [
            ExpressionsKind.Field,
            ExpressionsKind.Field,
            ExpressionsKind.Builtin
        ],
        _ => [
            ExpressionsKind.Field,
            ExpressionsKind.Builtin
        ]
    }

    const offsets: u32[] = match {
        in.buffered => [
            0,
            1,
            0
        ],
        _ => [
            0,
            0
        ]
    }

    return {
        rows: {
            tags,
            offsets,
            field_target: targets,
            field_name: names,
            builtin_name: [ExpressionsBuiltinName.As],
            builtin_arguments: [[
                in.type_expr,
                length
            ]]
        },
        root: length + 1,
        valid: true
    }
}
