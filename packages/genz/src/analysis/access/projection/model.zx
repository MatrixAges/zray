import type { ExpressionKind } from "core/expression_table/kinds"
import type { State as Cache } from "core/integer/map/model"
import type { Query } from "../../state/queries/model"

export enum Route {
    None,
    Anchor,
    Field,
    Index
}

export enum Result {
    Direct,
    Borrowed,
    Value,
    Element
}

export type Input = {
    kinds: ExpressionKind[],
    types: u32[],
    payloads: u32[],
    projection_targets: u32[],
    projection_indices: u32[],
    index_targets: u32[],
    index_values: u32[],
    type_kinds: u8[],
    type_first: u32[],
    field_names: u8[][],
    queries: Query[],
    flags: u8[],
    cache: Cache,
    id: u32
}

export type Walk = {
    anchor?: u32,
    fallback?: u32,
    fallback_fields: u64,
    fallback_keys: u64,
    fields: u8[][],
    keys: u32[],
    boundaries: u64[]
}

export type Path = {
    anchor?: u32,
    fields: u8[][],
    keys: u32[],
    starts: u64[],
    ends: u64[],
    first_key?: u32,
    first_start: u64,
    first_end: u64,
    prefix: u64,
    managed: bool
}

export type Segments = {
    anchor?: u32,
    walk: Walk,
    field_count: u64,
    key_count: u64,
    managed: bool
}
