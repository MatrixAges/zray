import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import { Route } from "./model"
import route from "./route"

import type { Input, Walk as Output } from "./model"

export default function (in: Input): Output {
    const fields: u8[][] = []
    const keys: u32[] = []
    const boundaries: u64[] = []
    const anchor: u32? = null
    const fallback: u32? = null

    return loop({
        id: in.id,
        anchor,
        fallback,
        fallback_fields: 0,
        fallback_keys: 0,
        fields,
        keys,
        boundaries,
        walking: true
    }, {
        while: state => state.walking,
        next: state => {
            const { id } = state
            const selected = route({
                source: in,
                id
            })

            if (selected == Route.None || selected == Route.Anchor) {
                if (selected == Route.Anchor) {
                    state.anchor = id
                }

                state.walking = false
            } else {
                const row = integers.widen(id)
                const payload = integers.widen(in.payloads[row])

                if (selected == Route.Field) {
                    const target = in.projection_targets[payload]
                    const type_id = in.types[integers.widen(target)]
                    const first = in.type_first[integers.widen(type_id)]
                    const position = in.projection_indices[payload]
                    const name = in
                        .field_names[
                            integers.widen(first) + integers.widen(position)
                        ]

                    state.fields = state.fields.push(name)[0]
                    state.id = target
                } else {
                    state.boundaries = state.boundaries.push(state.fields.length)[0]
                    state.keys = state.keys.push(in.index_values[payload])[0]
                    state.id = in.index_targets[payload]

                    const type_id = integers.widen(in.types[row])

                    if (kind(in.type_kinds[type_id]) == Kind.Object) {
                        state.fallback = state.id
                        state.fallback_fields = state.fields.length
                        state.fallback_keys = state.keys.length
                    }
                }
            }
        },
        return: state => state.omit([
            "id",
            "walking"
        ])
    })
}
