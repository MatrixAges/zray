import type { Result } from "../model"
import type { Input as Value } from "../result"
import type { Output as Access } from "./field"

export type Borrow = {
    states: bool[],
    borrowed: bool[],
    target: u32,
    member: u32
}

export type Input = {
    value: Value,
    member: Member,
    source: u32,
    base: u32,
    projection?: Borrow
}

export type Output = Access & {
    result: Result
}

export type Member = {
    names: u8[][],
    first: u32,
    position: u32,
    tuple: bool
}
