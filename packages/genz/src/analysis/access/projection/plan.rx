<Module>
    <Type from="model" as="Projection" />

    <Args in={Projection.Input} out={Projection.Path} />

    <Call fn="walk" in={$in} />

    <If on={$ctx.walk.anchor != null}>
        <Call
            fn="segments"
            in={{
                anchor: $ctx.walk.anchor,
                walk: $ctx.walk,
                field_count: $ctx.walk.fields.length,
                key_count: $ctx.walk.keys.length,
                managed: false
            }}
        />

        <Return value={$ctx.segments} />
    </If>

    <Call
        fn="segments"
        in={{
            anchor: $ctx.walk.fallback,
            walk: $ctx.walk,
            field_count: $ctx.walk.fallback_fields,
            key_count: $ctx.walk.fallback_keys,
            managed: true
        }}
    />

    <Return value={$ctx.segments} />
</Module>
