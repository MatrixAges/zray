<Module>
    <Type from="model" as="Prelude" />

    <Args in={Prelude.Input} out={Prelude.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="imports" />
    <Call fn="configuration" />
    <Call fn="services" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
