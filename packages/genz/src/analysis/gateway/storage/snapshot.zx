import integers from "std:integer"

import emptyDeclarations from "../../../ast/snapshot/empty_declarations"
import emptyStatements from "../../../ast/snapshot/empty_statements"
import expressions from "../../../ast/snapshot/expressions"

import type { Source as Output } from "../../../printer/model"
import type { Output as Input } from "./model"

export default function (in: Input): Output {
    return {
        expressions: {
            ...expressions(in.context),
            ...in.extra
        },
        statements: emptyStatements({}),
        declarations: {
            ...emptyDeclarations({}),
            ...in.declarations
        },
        fields: in.fields,
        arms: {
            value: [],
            capture: [],
            result: []
        },
        first: 0,
        count: integers.narrow(in.declarations.tags.length)
    }
}
