<Module>
    <Type from="model" as="Storage" />

    <Args in={Storage.Render} out={u8[][]?} />

    <Call fn="../entry/bases" in={{}} />

    <Call
        fn="initialize"
        in={{
            bases: $ctx.bases,
            modules: $in.modules
        }}
    />

    <Call fn="items" />
    <Call fn="structure" />

    <If on={!$ctx.structure.valid}>
        <Return value={null} />
    </If>

    <Call fn="snapshot" in={$ctx.structure} />

    <Call
        module="../../../printer/render"
        in={{
            source: $ctx.snapshot
        }}
    />

    <Return value={$ctx.render} />
</Module>
