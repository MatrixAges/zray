import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type {
    Columns as Declarations,
    State as DeclarationBuilder
} from "../../../ast/declarations/builder/model"
import type { Columns as Fields } from "../../../ast/fields/model"

export type Render = {
    modules: string[]
}

export type Input = {
    bases: Bases,
    modules: string[]
}

export type State = {
    source: Input,
    context: Context,
    field_names: u8[][],
    field_values: u32[],
    field_defaults: u32?[],
    field_comptime: bool[],
    declarations: DeclarationBuilder,
    optional_type: u32[]
}

export type Item = {
    state: State,
    index: u64
}

export type Output = {
    context: Context,
    fields: Fields,
    declarations: Declarations,
    extra: {
        optional_type: u32[],
        struct_type_start: u32[],
        struct_type_len: u32[]
    },
    valid: bool
}
