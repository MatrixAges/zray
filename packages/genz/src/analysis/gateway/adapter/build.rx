<Module>
    <Type from="model" as="Adapter" />

    <Args in={Adapter.Input} out={Adapter.Output} />

    <If on={$in.slots.count == 0}>
        <Return value={null} />

        <Else>
            <Call fn="prepare" in={$in} />

            <Call fn="slots" />
            <Call fn="initialize" />
            <Call fn="commit" />
            <Call fn="container" />
            <Call fn="publish" />

            <Return value={$ctx.publish} />
        </Else>
    </If>
</Module>
