import type { Table } from "core/type_table/model"
import type { ByteWriter } from "memory"
import type { Input as Bases } from "../../../ast/context/model"
import type { Slot } from "../adapter/model"
import type { Input as DispatchInput, Route } from "../dispatch/model"
import type { Input as InvokeInput } from "../invoke/model"
import type { Input as PreludeInput } from "../prelude/model"

export type Service = {
    slots: Slot[],
    requires_io: bool,
    requires_process: bool,
    types: Table,
    output_type: u32
}

export type ServiceColumns = {
    slots: Slot[],
    ends: u64[],
    requires_io: bool[],
    requires_process: bool[],
    types: Table,
    output_types: u32[]
}

export type Input = {
    writer: ByteWriter,
    services: Service[],
    bound?: ServiceColumns,
    service_modules: string[],
    routes: Route[],
    listen: string,
    max_header_bytes: u32,
    max_body_bytes: u32
}

export type Output = {
    valid: bool,
    invalid_route: bool
}

export type Prelude = {
    writer: ByteWriter,
    config: PreludeInput
}

export type Dispatch = {
    writer: ByteWriter,
    config: DispatchInput
}

export type Services = Input.Pick("services", "bound", "writer") & {
    bases: Bases
}

export type Visit = Service & {
    writer: ByteWriter,
    bases: Bases,
    index: u64
}

export type Invoke = {
    writer: ByteWriter,
    config: InvokeInput
}

export type Http = {
    writer: ByteWriter,
    bases: Bases
}
