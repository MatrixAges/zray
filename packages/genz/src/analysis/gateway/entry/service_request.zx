import slots from "./service_slots"

import type { Traversal as Input, Visit as Output } from "./model"

export default function (in: Input): Output {
    const { bound, writer, bases, index } = in

    if (bound != null) {
        return {
            writer,
            bases,
            index,
            slots: slots({
                slots: bound.slots,
                ends: bound.ends,
                index
            }),
            requires_io: bound.requires_io[index],
            requires_process: bound.requires_process[index],
            types: bound.types,
            input_type: bound.input_types[index],
            output_type: bound.output_types[index]
        }
    }

    return {
        ...in.services[index],
        writer,
        bases,
        index
    }
}
