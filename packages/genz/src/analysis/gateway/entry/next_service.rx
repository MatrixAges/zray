<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Traversal} out={Entry.Traversal} />

    <Call fn="service_request" in={$in} />

    <Call module="service" />

    <Call
        fn="advance_service"
        in={{
            traversal: $in,
            service: $ctx.service
        }}
    />

    <Return value={$ctx.advance_service} />
</Module>
