<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Visit} out={Entry.Section} />

    <Call
        module="../adapter/build"
        in={{
            bases: $in.bases,
            declaration_base: 0,
            slots: $in.slots,
            service_index: $in.index
        }}
    />

    <If on={$ctx.build != null}>
        <If on={!$ctx.build.valid}>
            <Return
                value={{
                    valid: false,
                    invalid_route: false,
                    chunks: []
                }}
            />
        </If>

        <Call fn="snapshots/adapter" in={$ctx.build} />

        <Call
            module="../../../printer/render"
            in={{
                source: $ctx.adapter
            }}
        />

        <Return
            value={{
                valid: true,
                invalid_route: false,
                chunks: $ctx.render
            }}
        />

        <Else>
            <Return
                value={{
                    valid: true,
                    invalid_route: false,
                    chunks: []
                }}
            />
        </Else>
    </If>
</Module>
