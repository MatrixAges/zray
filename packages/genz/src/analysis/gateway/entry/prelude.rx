<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Prelude} out={Entry.Section} />

    <Call module="../prelude/build" in={$in.config} />

    <If on={!$ctx.build.valid}>
        <Return
            value={{
                valid: false,
                invalid_route: false,
                chunks: []
            }}
        />
    </If>

    <Call fn="snapshots/prelude" in={$ctx.build} />

    <Call
        module="../../../printer/render"
        in={{
            source: $ctx.prelude
        }}
    />

    <Return
        value={{
            valid: true,
            invalid_route: false,
            chunks: $ctx.render
        }}
    />
</Module>
