<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Prelude} out={Entry.Output} />

    <Call module="../prelude/build" in={$in.config} />

    <If on={!$ctx.build.valid}>
        <Return
            value={{
                valid: false,
                invalid_route: false
            }}
        />
    </If>

    <Call fn="snapshots/prelude" in={$ctx.build} />

    <Call
        module="../../../printer/render"
        in={{
            source: $ctx.prelude,
            output: $in.writer
        }}
    />

    <Return
        value={{
            valid: true,
            invalid_route: false
        }}
    />
</Module>
