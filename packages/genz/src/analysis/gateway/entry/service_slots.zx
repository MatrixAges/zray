import type { SlotRange } from "../adapter/model"
import type { ServiceColumns } from "./model"

export type Input = ServiceColumns.Pick("slots", "ends") & {
    index: u64
}

export type Output = SlotRange

export default function (in: Input): Output {
    const { slots, ends, index } = in

    const first = index == 0 ? 0 : ends[index - 1]
    const count = ends[index] - first

    return {
        ...slots,
        first,
        count
    }
}
