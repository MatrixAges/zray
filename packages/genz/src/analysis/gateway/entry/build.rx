<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Output} />

    <Call fn="bases" in={{}} />

    <Call
        module="prelude"
        in={{
            config: {
                bases: $ctx.bases,
                declaration_base: 0,
                service_modules: $in.service_modules,
                listen: $in.listen,
                max_header_bytes: $in.max_header_bytes,
                max_body_bytes: $in.max_body_bytes
            }
        }}
    />

    <If on={!$ctx.prelude.valid}>
        <Return
            value={{
                valid: $ctx.prelude.valid,
                invalid_route: $ctx.prelude.invalid_route,
                groups: []
            }}
        />
    </If>

    <Call
        module="dispatch"
        in={{
            config: {
                bases: $ctx.bases,
                declaration_base: 0,
                routes: $in.routes
            }
        }}
    />

    <If on={!$ctx.dispatch.valid || $ctx.dispatch.invalid_route}>
        <Return
            value={{
                valid: $ctx.dispatch.valid,
                invalid_route: $ctx.dispatch.invalid_route,
                groups: []
            }}
        />
    </If>

    <Call
        module="services"
        in={{
            bases: $ctx.bases,
            services: $in.services,
            bound: $in.bound
        }}
    />

    <If on={!$ctx.services.valid}>
        <Return value={$ctx.services} />
    </If>

    <Call
        module="http"
        in={{
            bases: $ctx.bases
        }}
    />

    <Call
        fn="sections"
        in={{
            prelude: $ctx.prelude.chunks,
            dispatch: $ctx.dispatch.chunks,
            services: $ctx.services.groups,
            http: $ctx.http.chunks
        }}
    />

    <Return
        value={{
            valid: $ctx.http.valid,
            invalid_route: $ctx.http.invalid_route,
            groups: $ctx.sections
        }}
    />
</Module>
