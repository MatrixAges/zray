<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Services} out={Entry.Output} />

    <Call fn="service_count" in={$in} />

    <Call
        module="next_service"
        while="running"
        in={{
            ...$in,
            state: {
                valid: true,
                invalid_route: false
            },
            index: 0,
            count: $ctx.service_count,
            running: $ctx.service_count != 0
        }}
    />

    <Return value={$ctx.next_service.state} />
</Module>
