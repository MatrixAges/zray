<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Services} out={Entry.Output} />

    <Call fn="service_count" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="next_service"
            in={{
                ...$in,
                groups: [],
                valid: true,
                index: 0,
                count: $ctx.service_count,
                running: $ctx.service_count != 0
            }}
        />
    </Loop>

    <Return
        value={{
            valid: $ctx.next_service.valid,
            invalid_route: false,
            groups: $ctx.next_service.groups
        }}
    />
</Module>
