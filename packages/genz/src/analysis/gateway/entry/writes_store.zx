import columns from "memory"

import type { SlotRange as Input } from "../adapter/model"

export type Output = bool

export default function (in: Input): Output {
    const end = in.first + in.count

    return loop({
        row: in.first,
        writable: false
    }, {
        while: state => state.row < end && !state.writable,
        next: state => {
            state.writable = columns.readColumnBool(in.writable, state.row)
            state.row += 1
        },
        return: state => state.writable
    })
}
