<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Http} out={Entry.Section} />

    <Call module="../http/build" in={$in.bases} />

    <If on={!$ctx.build.valid}>
        <Return
            value={{
                valid: false,
                invalid_route: false,
                chunks: []
            }}
        />
    </If>

    <Call fn="snapshots/http" in={$ctx.build} />

    <Call
        module="../../../printer/render"
        in={{
            source: $ctx.http
        }}
    />

    <Return
        value={{
            valid: true,
            invalid_route: false,
            chunks: $ctx.render
        }}
    />
</Module>
