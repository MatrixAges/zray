import service from "./service.rx"
import slots from "./service_slots"

import type { Output, Services as Input } from "./model"

export default function (in: Input): Output {
    const bound = in.bound
    const count = bound == null ? in.services.length : bound.ends.length

    return loop({
        state: {
            valid: true,
            invalid_route: false
        },
        index: 0
    }, {
        while: current => current.state.valid && current.index < count,
        next: current => {
            const index = current.index

            if (bound != null) {
                current.state = service({
                    writer: in.writer,
                    bases: in.bases,
                    index,
                    slots: slots({
                        slots: bound.slots,
                        ends: bound.ends,
                        index
                    }),
                    requires_io: bound.requires_io[index],
                    requires_process: bound.requires_process[index],
                    types: bound.types,
                    input_type: bound.input_types[index],
                    output_type: bound.output_types[index]
                })
            } else {
                current.state = service({
                    ...in.services[index],
                    writer: in.writer,
                    bases: in.bases,
                    index
                })
            }

            current.index += 1
        },
        return: current => current.state
    })
}
