<Module>
    <Type from="model" as="Dispatch" />

    <Args in={Dispatch.Input} out={Dispatch.Output} />

    <Call fn="prepare" in={$in} />

    <Call fn="symbols" />
    <Call fn="types" />
    <Call fn="guard" />

    <Call module="paths" />

    <Call fn="routes" />
    <Call fn="missing" />
    <Call fn="finish" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
