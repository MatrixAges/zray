<Module>
    <Type from="model" as="Host" />

    <Args in={Host.Render} out={bool} />

    <Call fn="../entry/bases" in={{}} />

    <Call fn="prepare" />
    <Call fn="symbols" />
    <Call fn="types" />
    <Call fn="result_types" />
    <Call fn="imports" />
    <Call fn="listen" />
    <Call fn="arena" />
    <Call fn="state" />
    <Call fn="buffer" />
    <Call fn="accept" />
    <Call fn="connection_io" />
    <Call fn="receive" />
    <Call fn="request_scope" />
    <Call fn="dispatch" />
    <Call fn="handle" />
    <Call fn="check_canceled" />
    <Call fn="publish" />

    <Call
        module="../../../printer/render_checked"
        in={{
            module: $ctx.publish,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
