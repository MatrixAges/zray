import binary from "../../../ast/context/binary"
import path from "../../../ast/context/member_path"
import { ExpressionsBinaryOperator as B } from "../../../printer/model/expressions"
import {
    head_name,
    expect_member,
    transfer_encoding_name,
    content_length_name,
    server_name,
    reader_name
} from "./const"

import type { State as Input, Read as Output } from "./model"

export default function (in: Input): Output {
    const head = path({
        state: in.context,
        target: in.symbols.request,
        path: [head_name]
    })

    const expect = path({
        state: head.state,
        target: head.id,
        path: [expect_member]
    })

    const encoding = path({
        state: expect.state,
        target: head.id,
        path: [transfer_encoding_name]
    })

    const content_length = path({
        state: encoding.state,
        target: head.id,
        path: [content_length_name]
    })

    const length = binary({
        state: content_length.state,
        operator: B.Coalesce,
        left: content_length.id,
        right: in.values.zero
    })

    const reader = path({
        state: length.state,
        target: in.symbols.request,
        path: [
            server_name,
            reader_name
        ]
    })

    return {
        state: {
            ...in,
            context: reader.state
        },
        head: head.id,
        expect: expect.id,
        encoding: encoding.id,
        length: length.id,
        raw_reader: reader.id,
        read: 0,
        caught: 0
    }
}
