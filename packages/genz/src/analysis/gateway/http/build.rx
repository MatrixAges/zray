<Module>
    <Type from="model" as="Http" />

    <Args in={Http.Input} out={Http.Output} />

    <Call fn="prepare" in={$in} />

    <Call fn="types" />
    <Call fn="read_layout" />
    <Call fn="read_content" />
    <Call fn="read_catch" />
    <Call fn="read_expect" />
    <Call fn="read_limits" />
    <Call fn="read_continue" />
    <Call fn="read_stream" />
    <Call fn="read_finish" />
    <Call fn="respond" />
    <Call fn="head_classify" />
    <Call fn="head_request" />
    <Call fn="head_layout" />
    <Call fn="head_headers" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
