import bytes from "std:bytes"
import integers from "std:integer"
import { kind_scalar, scalar_void } from "core/type_table/const"

import address from "../../../../ast/context/address"
import identifier from "../../../../ast/context/identifier"
import member from "../../../../ast/context/member_path"
import method from "../../../../ast/context/method"
import standard from "../../../../ast/context/standard"
import text from "../../../../ast/context/text"
import binding from "../../../../ast/statements/builder/binding"
import close from "../../../../ast/statements/builder/close"
import evaluate from "../../../../ast/statements/builder/evaluate"
import header from "../../../../ast/statements/builder/header"
import open from "../../../../ast/statements/builder/open"
import result from "../../../../ast/statements/builder/result"
import { ExpressionsKind as K } from "../../../../printer/model/expressions"
import { StatementsKind as S } from "../../../../printer/model/statements"
import caught from "../catch"
import {
    allocating_name,
    child_allocator_name,
    deinit_name,
    init_name,
    io_type_name,
    json_name,
    null_json,
    out_of_memory_name,
    response_writer_name,
    stringify_name,
    stringify_value_name,
    writer_name,
    writer_type_name,
    written_name
} from "../const"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const types = in.source.types
    const index = integers.widen(in.source.output_type)

    if (types.kinds[index] == kind_scalar && types.first[index] == scalar_void) {
        const empty = text({
            state: in.context,
            kind: K.String,
            value: bytes.fromText(null_json)
        })

        return {
            ...in,
            context: empty.state,
            statements: evaluate({
                state: in.statements,
                value: in.symbols.output,
                discard: true
            }),
            encoded: empty.id
        }
    }

    const allocator = member({
        state: in.context,
        target: in.symbols.arena,
        path: [child_allocator_name]
    })

    const created = standard({
        state: allocator.state,
        path: [
            io_type_name,
            writer_type_name,
            allocating_name,
            init_name
        ],
        arguments: [allocator.id],
        fallible: false
    })

    const writer = identifier({
        state: created.state,
        name: bytes.fromText(response_writer_name)
    })

    const declared = binding({
        state: in.statements,
        name: bytes.fromText(response_writer_name),
        value: created.id,
        mutable: true
    })

    const cleanup = method({
        state: writer.state,
        target: writer.id,
        path: [deinit_name],
        arguments: []
    })

    const deferred = header({
        state: declared,
        kind: S.DeferExpression,
        offset: in.deferred.length
    })

    const interface = member({
        state: cleanup.state,
        target: writer.id,
        path: [writer_name]
    })

    const destination = address({
        state: interface.state,
        value: interface.id
    })

    const encoded = standard({
        state: destination.state,
        path: [
            json_name,
            stringify_name,
            stringify_value_name
        ],
        arguments: [
            in.symbols.output,
            in.symbols.empty,
            destination.id
        ],
        fallible: false
    })

    const oom = text({
        state: encoded.state,
        kind: K.ErrorValue,
        value: bytes.fromText(out_of_memory_name)
    })

    const scope = open(deferred)

    const failure = close(result({
        state: scope.state,
        value: oom.id
    }))

    const serialized = caught({
        state: {
            ...in,
            context: oom.state,
            statements: {
                ...failure.state,
                root_tags: scope.parent_tags,
                root_offsets: scope.parent_offsets
            }
        },
        value: encoded.id,
        first: failure.first,
        count: failure.count
    })

    const written = method({
        state: serialized.state.context,
        target: writer.id,
        path: [written_name],
        arguments: []
    })

    return {
        ...serialized.state,
        context: written.state,
        statements: evaluate({
            state: serialized.state.statements,
            value: serialized.id,
            discard: false
        }),
        deferred: in.deferred.push(cleanup.id)[0],
        encoded: written.id
    }
}
