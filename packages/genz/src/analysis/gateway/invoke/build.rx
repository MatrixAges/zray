<Module>
    <Type from="model" as="Invoke" />

    <Args in={Invoke.Input} out={Invoke.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="symbols" />
    <Call fn="types" />
    <Call fn="input/arena" />
    <Call fn="input/read_body" />
    <Call fn="input/empty_input" />
    <Call fn="input/parse_input" />
    <Call fn="input/select_input" />
    <Call fn="execution/arguments" />

    <Call module="execution/context_choice" />

    <Call fn="execution/runtime_arguments" />
    <Call fn="execution/execute" />
    <Call fn="response/failure" />
    <Call fn="response/validation" />

    <Call
        fn="../../host/json_output/check"
        in={{
            state: {
                source: {
                    bases: $in.bases,
                    types: $in.types,
                    type_id: $in.output_type,
                    failure_first: $ctx.validation.state.failure_first,
                    failure_count: $ctx.validation.state.failure_count
                },
                context: $ctx.validation.state.context,
                statements: $ctx.validation.state.statements,
                loops: $ctx.validation.state.fors,
                sequence: 0
            },
            type_id: $in.output_type,
            value: $ctx.validation.state.symbols.output
        }}
    />

    <Call
        fn="response/validated"
        in={{
            prepared: $ctx.validation,
            checked: $ctx.check
        }}
    />

    <Call fn="response/encoded" />
    <Call fn="response/respond" />
    <Call fn="finish" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
