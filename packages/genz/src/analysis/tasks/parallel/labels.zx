import host from "lowering_host"

import label from "../future/label"
import { Kind } from "../future/label"

import type { Lowering } from "lowering_host"

export type Input = {
    serial: u64,
    frame: Lowering,
    fields: u32?[]
}

export type Output = {
    serial: u64,
    results: u8[][],
    values: u8[][]
}

export default function (in: Input): Output {
    const empty_results: u8[][] = []
    const empty_values: u8[][] = []
    const empty_name: u8[] = []

    const first = loop({
        serial: in.serial,
        items: empty_results,
        index: 0
    }, {
        while: current => current.index < in.fields.length,
        next: current => {
            const generated = label({
                serial: current.serial,
                kind: Kind.Result
            })

            const retained = host.retainLoweringText(in.frame, generated.name)

            current.items = current.items.push(retained)[0]
            current.serial = generated.serial
            current.index += 1
        },
        return: current => current
    })

    const second = loop({
        serial: first.serial,
        items: empty_values,
        index: 0
    }, {
        while: current => current.index < in.fields.length,
        next: current => {
            if (in.fields[current.index] != null) {
                const generated = label({
                    serial: current.serial,
                    kind: Kind.Value
                })

                const retained = host.retainLoweringText(in.frame, generated.name)

                current.items = current.items.push(retained)[0]
                current.serial = generated.serial
            } else {
                current.items = current.items.push(empty_name)[0]
            }

            current.index += 1
        },
        return: current => current
    })

    return {
        serial: second.serial,
        results: first.items,
        values: second.items
    }
}
