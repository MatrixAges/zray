import type { AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    body: AstSequence,
    type_id: u32,
    tasks: u32[],
    fields: u32?[],
    object_names?: u8[][]
}

export type Branches = Input.Pick("frame", "writer", "body", "tasks")

export type Output = u32
