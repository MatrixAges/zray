<Module>
    <Type from="model" as="Parallel" />
    <Type from="../../future/label" as="Label" />

    <Args in={Parallel.Branch} out={Parallel.Branch} />

    <Call
        fn="../../rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call
        fn="../../future/label"
        in={{
            kind: Label.Kind.Future,
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Call
        fn="../../rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.label.name
        ]}
    />

    <Call
        fn="../../rows.setLoweringSerial"
        in={[
            $in.frame,
            $ctx.label.serial
        ]}
    />

    <Call
        fn="index.startParallelBranch"
        in={[
            $in.group,
            $in.index,
            $in.tasks[$in.index],
            $ctx.retainLoweringText
        ]}
    />

    <Call
        fn="../../rows.appendAstSequenceSpan"
        in={[
            $in.body,
            $ctx.startParallelBranch
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
