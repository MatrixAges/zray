<Module>
    <Type from="model" as="Parallel" />
    <Type from="../../rows" as="AST" />

    <Args in={Parallel.Input} out={Parallel.Output} />

    <Call
        fn="branches"
        in={$in.pick([
            "frame",
            "writer",
            "body",
            "tasks"
        ])}
    />

    <Call fn="../../rows.readAstOrigin" in={$in.writer} />

    <Call
        fn="../labels"
        in={{
            ...$in.pick([
                "frame",
                "fields"
            ]),
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Call
        fn="../../rows.setLoweringSerial"
        in={[
            $in.frame,
            $ctx.labels.serial
        ]}
    />

    <Call fn="../../rows.astFieldCount" in={$in.writer} />

    <Call
        module="../build"
        in={{
            futures: $ctx.branches,
            results: $ctx.labels.results,
            values: $ctx.labels.values,
            fields: $in.fields,
            object_names: $in.object_names,
            bases: {
                ...$ctx.readAstOrigin,
                serial: $ctx.labels.serial,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.build.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.build.expressions,
            $ctx.build.forms,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../../rows.appendAstFields"
        in={[
            $in.writer,
            $ctx.build.fields
        ]}
    />

    <Call
        fn="../../rows.appendStatementRows"
        in={[
            $in.writer,
            $ctx.build.statements,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="result"
        in={{
            frame: $in.frame,
            type_id: $in.type_id,
            value: $ctx.build.root,
            construct: $ctx.build.construct
        }}
    />

    <Call
        fn="body"
        in={{
            start: $ctx.readAstOrigin.statement_base,
            count: $ctx.build.statements.tags.length
        }}
    />

    <Call
        fn="../../rows.appendAstSequenceSpan"
        in={[
            $in.body,
            $ctx.body
        ]}
    />

    <Call
        fn="../../rows.finishAstSequence"
        in={[
            $in.writer,
            $in.body
        ]}
    />

    <Call
        fn="../../../aggregate/execute/finish_stored"
        in={{
            frame: $in.frame,
            writer: $in.writer,
            span: $ctx.finishAstSequence,
            value: $ctx.result,
            guard: null
        }}
    />

    <Return value={$ctx.finish_stored} />
</Module>
