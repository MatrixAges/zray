import { convertStateValue, StateValueMode } from "ast_rows"

import type { AstSequence, AstWriter } from "ast_rows"

export type Input = {
    writer: AstWriter,
    body: AstSequence,
    type_id: u32,
    value: u32,
    construct: bool
}

export type Output = u32

export default function (in: Input): Output {
    if (in.construct) {
        return convertStateValue(
            in.writer,
            in.body,
            in.type_id,
            in.value,
            StateValueMode.Construct,
            false
        )
    }

    return in.value
}
