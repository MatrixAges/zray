import host from "lowering_host"

import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    type_id: u32,
    value: u32,
    construct: bool
}

export type Output = u32

export default function (in: Input): Output {
    return in.construct ? host.finishObject(in.frame, in.type_id, in.value) : in.value
}
