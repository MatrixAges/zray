import initialize from "../../../ast/context/initialize"
import invoke from "./invoke"
import { Method } from "./invoke"
import target from "./target"

import type { Called as Output, Input } from "./model"

export default function (in: Input): Output {
    const future = target({
        state: initialize(in.bases),
        value: in.value,
        name: in.name
    })

    const result = invoke({
        state: future.state,
        future: future.id,
        method: in.cancel ? Method.Cancel : Method.Await,
        fallible: !in.cancel
    })

    return {
        result,
        needs_block: in.name != null
    }
}
