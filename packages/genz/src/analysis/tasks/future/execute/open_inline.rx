<Module>
    <Type from="model" as="Future" />
    <Type from="../label" as="Label" />

    <Args in={Future.Open} out={u8[]} />

    <Call
        fn="../../rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call
        fn="../label"
        in={{
            kind: Label.Kind.Future,
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Call
        fn="../../rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.label.name
        ]}
    />

    <Call
        fn="../../rows.setLoweringSerial"
        in={[
            $in.frame,
            $ctx.label.serial
        ]}
    />

    <Return value={$ctx.retainLoweringText} />
</Module>
