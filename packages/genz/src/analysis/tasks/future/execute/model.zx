import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Open = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer
}

export type Input = Open & {
    child: u32,
    cancel: bool,
    inline_task: bool
}

export type Output = u32

export type Completion = Open & {
    started: u64,
    value?: u32,
    name?: u8[],
    cancel: bool
}
