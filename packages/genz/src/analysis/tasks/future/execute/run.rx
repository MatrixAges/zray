<Module>
    <Type from="model" as="Future" />

    <Args in={Future.Input} out={Future.Output} />

    <Call
        fn="index.publishTaskEffects"
        in={[
            $in.frame,
            false,
            true,
            false
        ]}
    />

    <If on={$in.inline_task}>
        <Call
            module="open_inline"
            in={$in.pick([
                "frame",
                "writer",
                "origin"
            ])}
        />

        <Call
            fn="index.startInlineTask"
            in={[
                $in.frame,
                $in.child,
                $ctx.open_inline
            ]}
        />

        <Call
            module="complete"
            in={{
                ...$in.pick([
                    "frame",
                    "writer",
                    "origin",
                    "cancel"
                ]),
                started: $ctx.startInlineTask,
                value: null,
                name: $ctx.open_inline
            }}
        />

        <Return value={$ctx.complete} />
    </If>

    <Call
        fn="index.lowerTaskOperand"
        in={[
            $in.frame,
            $in.child
        ]}
    />

    <Call
        module="complete"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "origin",
                "cancel"
            ]),
            started: 0,
            value: $ctx.lowerTaskOperand,
            name: null
        }}
    />

    <Return value={$ctx.complete} />
</Module>
