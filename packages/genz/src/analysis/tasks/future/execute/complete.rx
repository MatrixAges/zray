<Module>
    <Type from="model" as="Future" />
    <Type from="../../rows" as="AST" />

    <Args in={Future.Completion} out={Future.Output} />

    <Call fn="../../rows.astFieldCount" in={$in.writer} />

    <Call
        fn="../../rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call
        module="../build"
        in={{
            ...$in.pick([
                "value",
                "name",
                "cancel"
            ]),
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.build.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.build.expressions,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <If on={$ctx.build.wrap}>
        <Call
            fn="../../rows.appendAstCleanupRows"
            in={[
                $in.writer,
                $ctx.build.statements.tags,
                $ctx.build.statements.offsets,
                null,
                $ctx.build.statements.discard_error,
                [],
                []
            ]}
        />

        <Call
            module="wrap"
            in={{
                frame: $in.frame,
                writer: $in.writer,
                started: $in.started,
                completed: $ctx.appendAstCleanupRows,
                value: $ctx.build.root
            }}
        />

        <Return value={$ctx.wrap} />
    </If>

    <Return value={$ctx.build.root} />
</Module>
