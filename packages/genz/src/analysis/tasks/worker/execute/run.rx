<Module>
    <Type from="model" as="Worker" />
    <Type from="../../rows" as="AST" />

    <Args in={Worker.Input} out={Worker.Output} />

    <Call fn="../../rows.auxiliaryDeclarationCount" in={$in.writer} />

    <Call
        module="reserve_slot"
        in={{
            writer: $in.writer,
            slot: $ctx.auxiliaryDeclarationCount
        }}
    />

    <Call
        fn="types"
        in={$in.pick([
            "lower",
            "captures",
            "symbol_types"
        ])}
    />

    <Call fn="../../rows.astFieldCount" in={$in.writer} />
    <Call fn="../../rows.readAstOrigin" in={$in.writer} />

    <Call
        fn="../prepare"
        in={{
            process: $in.process,
            symbols: $in.captures,
            types: $ctx.types,
            bases: {
                ...$ctx.readAstOrigin,
                capture: null,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.prepare.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.prepare.expressions,
            null,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../../rows.appendOwnedAstFields"
        in={[
            $in.writer,
            $ctx.prepare.fields
        ]}
    />

    <Call
        fn="index.bindTaskCaptureNames"
        in={[
            $in.lower,
            $in.captures,
            $ctx.prepare.capture_first
        ]}
    />

    <Call
        fn="index.lowerExpression"
        in={[
            $in.worker,
            $in.body_expr,
            false,
            null
        ]}
    />

    <Call fn="index.readWorkerState" in={$in.worker} />

    <Call
        fn="index.lowerType"
        in={[
            $in.lower,
            $in.result_type,
            false
        ]}
    />

    <Call fn="../../rows.astStatementCount" in={$in.writer} />

    <Call
        module="discard"
        in={{
            writer: $in.writer,
            captures: $in.captures,
            process: $in.process,
            body: $ctx.readWorkerState
        }}
    />

    <Call fn="index.readWorkerReferenceBody" in={$in.worker} />

    <Call fn="reference" />

    <Call
        fn="../../rows.tailAstStatementRows"
        in={[
            $in.writer,
            [
                $ctx.astStatementCount,
                $ctx.reference.start
            ],
            [
                $ctx.discard - $ctx.astStatementCount,
                $ctx.reference.count
            ]
        ]}
    />

    <Call
        module="finish"
        in={{
            writer: $in.writer,
            name: $ctx.reserve_slot,
            slot: $ctx.auxiliaryDeclarationCount,
            value: $ctx.lowerExpression,
            output_type: $ctx.lowerType,
            errors: $in.errors,
            parameters_first: $ctx.prepare.first,
            parameters_count: $ctx.prepare.count,
            body_first: $ctx.tailAstStatementRows
        }}
    />

    <Return value={$ctx.finish} />
</Module>
