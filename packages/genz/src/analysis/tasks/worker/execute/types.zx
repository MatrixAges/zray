import integers from "std:integer"
import host from "lowering_host"

import type { Input as Worker } from "./model"

export type Input = Worker.Pick("lower", "captures", "symbol_types")

export type Output = u32[]

export default function (in: Input): Output {
    const types: u32[] = []

    const { lower, captures, symbol_types } = in

    return loop({
        types,
        index: 0
    }, {
        while: state => state.index < captures.length,
        next: state => {
            const type_id = host.lowerType(
                lower,
                symbol_types[integers.widen(captures[state.index])],
                false
            )

            state.types = state.types.push(type_id)[0]
            state.index += 1
        },
        return: state => state.types
    })
}
