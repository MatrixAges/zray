import type { AstWriter } from "ast_rows"
import type { Lowering, TaskWorker, TaskWorkerBody } from "lowering_host"
import type { Input as WorkerFinish, Output as Final } from "../finish_model"

export type Input = {
    worker: TaskWorker,
    lower: Lowering,
    writer: AstWriter,
    captures: u32[],
    symbol_types: u32[],
    body_expr: u32,
    result_type: u32,
    errors?: u8[][],
    process: bool
}

export type Output = u32

export type Reservation = {
    writer: AstWriter,
    slot: u64
}

export type Publication = Reservation & {
    fragment: Final
}

export type Discard = Input.Pick("writer", "process", "captures") & {
    body: TaskWorkerBody.Omit("value")
}

export type Finish = WorkerFinish.Omit("declaration_base", "bases") & Reservation & {
}
