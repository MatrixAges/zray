import integers from "std:integer"
import { publishAstBasicStatements } from "ast_rows"
import host from "lowering_host"

import discard from "../basic/discard"
import {
    destructure_operation,
    evaluate_operation,
    operation_mask,
    return_operation,
    write_operation
} from "../block/const"
import destructure from "./destructure"
import result from "./result"
import storeWrite from "./store_write"

import type { Body, Input } from "./model"

export type Output = Body?

export default function (in: Input): Output {
    const { context, statement, route } = in

    const operation = integers.andBits(integers.widenByte(route), operation_mask)
    const control = context.control

    if (operation == integers.widenByte(evaluate_operation)) {
        const value = control
            .evaluations[integers.widen(
                control.statement_payloads[statement]
            )]

        const lowered = host.lowerDiscardedExpression(context.frame, value)

        return {
            span: publishAstBasicStatements(
                context.writer,
                discard({
                    value: lowered
                })
            ),
            consumed_previous: false
        }
    }

    if (operation == integers.widenByte(destructure_operation)) {
        return {
            span: destructure({
                context,
                statement
            }),
            consumed_previous: false
        }
    }

    if (operation == integers.widenByte(write_operation)) {
        const payload = integers.widen(control.statement_payloads[statement])

        return {
            span: storeWrite({
                frame: context.frame,
                writer: context.writer,
                slot: control.setter_slots[payload],
                value: control.setter_values[payload]
            }),
            consumed_previous: false
        }
    }

    if (operation == integers.widenByte(return_operation)) {
        return result(in)
    }

    return null
}
