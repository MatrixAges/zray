import type { StatementTraversal } from "lowering_host"
import type { Output as Committed } from "../traversal/commit"
import type { Context } from "../traversal/execute/model"

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    scope: u64,
    index: u64,
    statement: u64,
    route: u8
}

export type Output = Committed?

export type Body = {
    span: u64,
    consumed_previous: bool
}

export type Publication = Input.Pick("context", "index") & {
    prefix: u64,
    span: u64,
    consumed_previous: bool
}
