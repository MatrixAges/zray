import host from "lowering_host"

import type { Publication as Input, Output } from "./model"

export default function (in: Input): Output {
    const { traversal, scope, index } = in

    if (in.prefix == true && !host.joinStatementSpans(traversal)) {
        return null
    }

    return host.commitStatementSpan(traversal, scope, index + 1)
}
