import { tailAstPackedStatements } from "ast_rows"

import unpackSpan from "../../tasks/worker/execute/reference"
import commit from "../traversal/commit"

import type { Output } from "../traversal/commit"
import type { Publication as Input } from "./model"

export default function (in: Input): Output {
    const prefix = unpackSpan(in.prefix)

    const combined = match {
        prefix.count != 0 => tailAstPackedStatements(in.context.writer, [
            in.prefix,
            in.span
        ]),
        _ => in.span
    }

    const span = unpackSpan(combined)

    return commit({
        row: in.index,
        start: span.start,
        count: span.count,
        consumed_previous: in.consumed_previous
    })
}
