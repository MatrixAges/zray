import integers from "std:integer"
import host from "lowering_host"

import { fuse_route } from "../block/const"
import resultPublish from "./result_publish"

import type { Body, Input } from "./model"

export type Output = Body?

export default function (in: Input): Output {
    const { traversal, context, statement, route } = in
    const { control } = context

    const payload = integers.widen(control.statement_payloads[statement])

    const source = control.results[payload]

    if (source == null) {
        return {
            span: resultPublish({
                frame: context.frame,
                writer: context.writer,
                sequence: context.sequence,
                transaction: context.transaction,
                value: null
            }),
            consumed_previous: false
        }
    }

    const bits = integers.widenByte(route)
    const fuse = integers.andBits(bits, integers.widenByte(fuse_route)) != 0
    const by_value = context.value_output

    const previous: u64? = match {
        fuse => integers.widen(control.statement_payloads[statement - 1]),
        _ => null
    }

    const fused: u32? = match {
        previous != null =>
            host.fuseStatementResult(
                context.frame,
                control.constant_symbols[previous],
                control.constant_values[previous],
                source,
                by_value
            ),
        _ => null
    }

    const lowered: u32 = fused ?? match {
        by_value => host.lowerValueExpression(context.frame, source),
        _ => host.lowerExpression(context.frame, source, false, null)
    }

    const owned: u32? = match {
        !context.state_active => lowered,
        _ => host.clipStatementResult(traversal, source, lowered)
    }

    if (owned == null) {
        return null
    }

    const output: u32? = match {
        context.state_active && context.public_value_output =>
            host.viewStatementResult(traversal, owned),
        _ => owned
    }

    if (output == null) {
        return null
    }

    return {
        span: resultPublish({
            frame: context.frame,
            writer: context.writer,
            sequence: context.sequence,
            transaction: context.transaction,
            value: output
        }),
        consumed_previous: fused != null
    }
}
