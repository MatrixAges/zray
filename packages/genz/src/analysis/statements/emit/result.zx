import integers from "std:integer"
import host from "lowering_host"
import { StatementResultMode } from "lowering_host"

import { fuse_route } from "../block/const"
import resultPublish from "./result_publish"

import type { Body, Input } from "./model"

export type Output = Body?

export default function (in: Input): Output {
    const { traversal, context, scope, index, route } = in

    const source = host.statementResult(traversal, scope, index)

    if (source == null) {
        return {
            span: resultPublish({
                frame: context.frame,
                writer: context.writer,
                origin: context.origin,
                sequence: context.sequence,
                transaction: context.transaction,
                value: null
            }),
            consumed_previous: false
        }
    }

    const bits = integers.widenByte(route)
    const fuse = integers.andBits(bits, integers.widenByte(fuse_route)) != 0
    const by_value = host.statementResultUsesValue(traversal)

    if (
        fuse && !host.fuseStatementResult(traversal, scope, index, source, by_value)
    ) {
        return null
    }

    const fused: u32? = fuse ? host.borrowedStatementValue(traversal) : null

    const lowered: u32? = match {
        fused != null => fused,
        _ => host.lowerStatementExpression(traversal, source, by_value)
    }

    if (lowered == null) {
        return null
    }

    const mode = host.statementResultMode(traversal)

    const owned: u32? = match mode {
        StatementResultMode.Plain => lowered,
        _ => host.clipStatementResult(traversal, source, lowered)
    }

    if (owned == null) {
        return null
    }

    const output: u32? = match mode {
        StatementResultMode.View => host.viewStatementResult(traversal, owned),
        _ => owned
    }

    if (output == null) {
        return null
    }

    return {
        span: resultPublish({
            frame: context.frame,
            writer: context.writer,
            origin: context.origin,
            sequence: context.sequence,
            transaction: context.transaction,
            value: output
        }),
        consumed_previous: fused != null
    }
}
