import {
    AstPayloadOwnership,
    appendExpressionRows,
    appendStatementSequence,
    astFieldCount,
    finishAstSequence,
    readAstOrigin
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import emptyVariables from "../../../ast/statements/empty_variables"
import commit from "../result/commit"
import finish from "../result/finish"
import initialize from "../result/initialize"
import ordinary from "../result/ordinary"
import save from "../result/save"

import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    sequence: AstSequence,
    transaction: bool,
    value?: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { frame, writer, origin, sequence, transaction, value } = in

    const current = readAstOrigin(writer, origin)
    const field_base = astFieldCount(writer)

    const bases = {
        ...current,
        field_base
    }

    const built = match {
        !transaction => ordinary({
            frame,
            value,
            transaction,
            bases
        }),
        _ => finish(commit(save(initialize({
            frame,
            value,
            transaction,
            bases
        }))))
    }

    requireAllocation(built.valid)

    const expressions = built.expressions

    if (expressions != null) {
        appendExpressionRows(
            writer,
            expressions,
            null,
            AstPayloadOwnership.BorrowingText
        )
    }

    appendStatementSequence(writer, sequence, built.statements, emptyVariables({}))
    host.setLoweringSerial(frame, built.serial)

    return finishAstSequence(writer, sequence)
}
