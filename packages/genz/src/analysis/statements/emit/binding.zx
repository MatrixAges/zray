import integers from "std:integer"
import { prepareScopeBinding } from "ast_rows"
import host from "lowering_host"

import { task_route, value_route } from "../block/const"

import type { Input as Binding } from "../../binding/execute/model"
import type { Input } from "./model"

export type Output = {
    task_span?: u64,
    publication?: Binding
}

export default function (in: Input): Output {
    const { context, statement, route } = in

    const bits = integers.widenByte(route)
    const task = integers.andBits(bits, integers.widenByte(task_route)) != 0
    const payload = integers.widen(context.control.statement_payloads[statement])
    const symbol = context.control.constant_symbols[payload]
    const value = context.control.constant_values[payload]

    if (task) {
        return {
            task_span: host.startInlineTask(
                context.frame,
                value,
                context.names[integers.widen(symbol)],
                false
            )
        }
    }

    const borrowed = prepareScopeBinding(
        context.writer,
        context.sequence,
        symbol,
        value,
        context.output_type
    )

    const by_value = integers.andBits(bits, integers.widenByte(value_route)) != 0

    const lowered: u32 = borrowed ?? match {
        by_value => host.lowerValueExpression(context.frame, value),
        _ => host.lowerExpression(context.frame, value, false, null)
    }

    const row = integers.widen(symbol)
    const used = context.used[row]

    return {
        publication: {
            frame: context.frame,
            writer: context.writer,
            sequence: context.sequence,
            policy: {
                has_symbol: true,
                used,
                by_value,
                loop_field: false,
                mutable: false
            },
            name: match {
                used => context.names[row],
                _ => []
            },
            type_id: used ? context.symbol_types[row] : 0,
            value: lowered
        }
    }
}
