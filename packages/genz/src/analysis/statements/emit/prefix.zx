import integers from "std:integer"
import host from "lowering_host"

import { store_route } from "../block/const"

import type { Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const bits = integers.widenByte(in.route)
    const begin = integers.andBits(bits, integers.widenByte(store_route)) != 0

    if (!begin) {
        return 0
    }

    return host.beginStatementStore(in.traversal, in.scope, in.index)
}
