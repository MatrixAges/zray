import {
    appendAstProjectionRows,
    astExpressionCount,
    publishAstBasicStatements
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import assignment from "../basic/assignment"
import storeTarget from "../basic/store_target"

import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    slot: u32,
    value: u32
}

export type Output = u64

export default function (in: Input): Output {
    const target = storeTarget({
        frame: in.frame,
        slot: in.slot,
        base: astExpressionCount(in.writer)
    })

    requireAllocation(target.valid)
    appendAstProjectionRows(in.writer, target.nodes)

    const value = host.lowerExpression(in.frame, in.value, false, null)

    const statement = assignment({
        target: target.root,
        value
    })

    return publishAstBasicStatements(in.writer, statement)
}
