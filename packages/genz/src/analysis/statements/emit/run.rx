<Module>
    <Type from="model" as="Emit" />

    <Args in={Emit.Input} out={Emit.Output} />

    <Store from="../traversal/execute/selection" as="traversal" />

    <Call module="prefix" in={$in} />

    <Call fn="is_parallel" in={$in.route} />

    <If on={$ctx.is_parallel}>
        <Call
            fn="parallel_calls"
            in={$in.pick([
                "context",
                "statement"
            ])}
        />

        <Call
            fn="set_effects"
            in={{
                uses_context: false,
                uses_parallel: true
            }}
            setter={[$store.traversal.effects]}
        />

        <Call
            module="../../parallel/emit/execute/run"
            in={{
                ...$ctx.parallel_calls,
                ...$in.context.pick([
                    "frame",
                    "writer",
                    "used",
                    "names"
                ])
            }}
        />

        <Call
            fn="publish"
            in={{
                context: $in.context,
                index: $in.index,
                prefix: $ctx.prefix,
                span: $ctx.run,
                consumed_previous: false
            }}
        />

        <Return value={$ctx.publish} />
    </If>

    <Call fn="is_binding" in={$in.route} />

    <If on={$ctx.is_binding}>
        <Call fn="binding" in={$in} />

        <If on={$ctx.binding.publication != null}>
            <Call module="publish_binding" in={$ctx.binding.publication} />

            <Call
                fn="publish"
                in={{
                    context: $in.context,
                    index: $in.index,
                    prefix: $ctx.prefix,
                    span: $ctx.publish_binding,
                    consumed_previous: false
                }}
            />

            <Return value={$ctx.publish} />
        </If>

        <If on={$ctx.binding.task_span != null}>
            <Call
                fn="publish"
                in={{
                    context: $in.context,
                    index: $in.index,
                    prefix: $ctx.prefix,
                    span: $ctx.binding.task_span,
                    consumed_previous: false
                }}
            />

            <Return value={$ctx.publish} />
        </If>

        <Return value={null} />
    </If>

    <Call fn="body" in={$in} />

    <If on={$ctx.body != null}>
        <Call
            fn="publish"
            in={{
                ...$in.pick([
                    "context",
                    "index"
                ]),
                prefix: $ctx.prefix,
                span: $ctx.body.span,
                consumed_previous: $ctx.body.consumed_previous
            }}
        />

        <Return value={$ctx.publish} />
    </If>

    <Return value={null} />
</Module>
