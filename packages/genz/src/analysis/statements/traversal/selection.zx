import integers from "std:integer"

import { Action, Phase } from "./model"

import type { Position as Input, Step as Output } from "./model"

export default function (in: Input): Output {
    const { rows } = in

    const frame = in.omit(["rows"])

    if (frame.phase == Phase.SaveDefault) {
        return {
            ...frame,
            phase: Phase.Defaults,
            action: Action.Fallback,
            offset: 0,
            length: 0,
            child: null
        }
    }

    if (frame.phase == Phase.SaveNamed) {
        const label = rows.case_values[frame.case_cursor]

        return {
            ...frame,
            phase: Phase.Named,
            action: Action.SaveCase,
            offset: label ?? 0,
            length: integers.narrow(frame.named),
            child: null
        }
    }

    if (frame.phase == Phase.Defaults) {
        const cursor = loop(frame.case_cursor, {
            while: cursor =>
                cursor < frame.case_end && rows.case_values[cursor] != null,
            next: cursor => {
                cursor += 1
            },
            return: cursor => cursor
        })

        const named = frame.named + cursor - frame.case_cursor

        if (cursor == frame.case_end) {
            return {
                ...frame,
                phase: Phase.Named,
                case_cursor: cursor,
                named,
                action: Action.Resolve,
                offset: 0,
                length: integers.narrow(named),
                child: null
            }
        }

        return {
            ...frame,
            phase: Phase.SaveDefault,
            case_cursor: cursor + 1,
            named,
            action: Action.Descend,
            offset: 0,
            length: 0,
            child: rows.case_bodies[cursor]
        }
    }

    if (frame.named == 0) {
        return {
            ...frame,
            phase: Phase.Statements,
            action: Action.EndSelection,
            offset: integers.narrow(frame.cursor - frame.first),
            length: 0,
            child: null
        }
    }

    const end = loop(frame.case_cursor, {
        while: cursor => rows.case_values[cursor - 1] == null,
        next: cursor => {
            cursor -= 1
        },
        return: cursor => cursor
    })

    const cursor = end - 1
    const named = frame.named - 1
    const label = rows.case_values[cursor]

    return {
        ...frame,
        phase: Phase.SaveNamed,
        case_cursor: cursor,
        named,
        action: Action.Case,
        offset: label ?? 0,
        length: integers.narrow(named),
        child: rows.case_bodies[cursor]
    }
}
