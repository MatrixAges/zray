import integers from "std:integer"
import { StatementKind } from "core/control_table/model"

import { Action, Phase } from "./model"
import runStart from "./run_start"
import selection from "./selection"

import type { Position as Input, Step as Output } from "./model"

export default function (in: Input): Output {
    const { rows } = in

    const frame = in.omit(["rows"])

    if (frame.phase == Phase.Open) {
        return {
            ...frame,
            phase: Phase.Statements,
            action: Action.Open,
            offset: integers.narrow(frame.first),
            length: integers.narrow(frame.count),
            child: null
        }
    }

    const position = frame.cursor - frame.first

    if (frame.phase == Phase.No) {
        return {
            ...frame,
            phase: Phase.Join,
            action: Action.SaveYes,
            offset: 0,
            length: 0,
            child: frame.no
        }
    }

    if (frame.phase == Phase.Join) {
        return {
            ...frame,
            phase: Phase.Statements,
            action: Action.Join,
            offset: integers.narrow(position),
            length: 0,
            child: null
        }
    }

    if (frame.phase != Phase.Statements) {
        return selection(in)
    }

    if (position == 0) {
        return {
            ...frame,
            action: Action.Close,
            offset: 0,
            length: 0,
            child: null
        }
    }

    const start = runStart({
        kinds: rows.statement_kinds,
        first: frame.first,
        cursor: frame.cursor
    })

    if (start < frame.cursor) {
        return {
            ...frame,
            cursor: start,
            action: Action.Execute,
            offset: integers.narrow(start - frame.first),
            length: integers.narrow(frame.cursor - start),
            child: null
        }
    }

    const cursor = frame.cursor - 1
    const payload = integers.widen(rows.statement_payloads[cursor])

    if (rows.statement_kinds[cursor] == StatementKind.Switch) {
        const first = integers.widen(rows.selection_first[payload])
        const count = integers.widen(rows.selection_count[payload])

        return {
            ...frame,
            cursor,
            phase: Phase.Defaults,
            case_end: first + count,
            case_cursor: first,
            named: 0,
            action: Action.Selection,
            offset: integers.narrow(position - 1),
            length: 0,
            child: null
        }
    }

    return {
        ...frame,
        cursor,
        phase: Phase.No,
        no: rows.branch_no[payload],
        action: Action.Condition,
        offset: integers.narrow(position - 1),
        length: 0,
        child: rows.branch_yes[payload]
    }
}
