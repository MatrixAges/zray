import integers from "std:integer"

import type { Scope as Input, ScopeWalk as Output } from "./model"

export default function (in: Input): Output {
    const first = integers.widen(in.first)

    return {
        traversal: in.traversal,
        context: in.context,
        scope: in.scope,
        routes: in.routes,
        writes: in.writes,
        first,
        cursor: first + integers.widen(in.count),
        scope_first: integers.widen(in.scope_first),
        valid: true,
        running: in.count != 0
    }
}
