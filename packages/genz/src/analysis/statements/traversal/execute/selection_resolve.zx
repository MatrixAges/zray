import integers from "std:integer"
import host from "lowering_host"
import memory from "memory"

import eligible from "../../../selection/labels/eligible"
import initialize from "../../../selection/labels/initialize"
import scan from "../../../selection/labels/scan"

import type { StatementTraversal } from "lowering_host"
import type { Input as SelectionInput } from "../../../selection/labels/model"
import type { Buffers, Context } from "./model"

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    buffers: Buffers,
    placement: u64,
    count: u32
}

export type Output = bool

export default function (in: Input): Output {
    const { traversal, context, buffers, placement, count } = in
    const { control } = context

    const payload =
        integers.widen(memory.readU32(buffers.selection_payloads, placement))

    const subject_ir = memory.readU32(buffers.selection_subjects, placement)
    const first_case = integers.widen(control.selection_first[payload])
    const total_cases = integers.widen(control.selection_count[payload])
    const empty: u32[] = []

    const conditions = loop({
        index: 0,
        values: empty
    }, {
        while: state => state.index < total_cases,
        next: state => {
            const value = control.case_values[first_case + state.index]

            if (value != null) {
                state.values = state.values.push(value)[0]
            }

            state.index += 1
        },
        return: state => state.values
    })

    const source: SelectionInput = {
        expressions: context.expressions,
        types: context.types,
        subject: subject_ir,
        conditions
    }

    const selected = match {
        eligible(source) => scan({
            source,
            state: initialize({})
        }),
        _ => false
    }

    const selected_byte: u8 = match {
        selected => 1,
        _ => 0
    }

    memory.writeU32(buffers.selection_counts, placement, count)
    memory.writeU8(buffers.selection_selected, placement, selected_byte)

    return host.resolveStatementSelection(traversal, placement, count, selected)
}
