<Module>
    <Type from="model" as="Execution" />
    <Type from="../model" as="Schedule" />

    <Args in={Execution.ScheduleWalk} out={Execution.ScheduleWalk} />

    <Store from="selection" as="selection" />

    <If on={$in.plan.actions[$in.index] == Schedule.Action.Execute}>
        <Call
            module="scope"
            in={{
                ...$in.pick([
                    "context"
                ]),
                writes: $in.state.scope_writes[$in.plan.scopes[$in.index]],
                first: $in.plan.offsets[$in.index],
                count: $in.plan.counts[$in.index],
                routes: $in.state.scope_routes[$in.plan.scopes[$in.index]],
                scope_first: $in.state.scope_firsts[$in.plan.scopes[$in.index]],
                scope_count: $in.state.scope_counts[$in.plan.scopes[$in.index]]
            }}
        />

        <Call
            fn="save_scope_writes"
            in={{
                state: $in.state,
                scope: $in.plan.scopes[$in.index],
                writes: $ctx.scope.writes
            }}
        />

        <Return
            value={{
                ...$in,
                state: $ctx.save_scope_writes,
                index: $in.index + ($ctx.scope.valid ? 1 : 0),
                running: $ctx.scope.valid && $in.index + 1 < $in.plan.actions.length
            }}
        />
    </If>

    <Call
        fn="step"
        in={{
            ...$in.pick([
                "context",
                "state",
                "child"
            ]),
            action: $in.plan.actions[$in.index],
            first: $in.plan.offsets[$in.index],
            count: $in.plan.counts[$in.index],
            scope: $in.plan.scopes[$in.index],
            placement: $in.plan.placements[$in.index]
        }}
    />

    <If on={$ctx.step.binding != null}>
        <Call
            fn="set_selection"
            in={$ctx.step.binding}
            setter={[$store.selection.binding]}
        />
    </If>

    <Return
        value={{
            ...$in,
            state: $ctx.step.state,
            child: $ctx.step.child,
            index: $in.index + ($ctx.step.ok ? 1 : 0),
            running: $ctx.step.ok && $in.index + 1 < $in.plan.actions.length
        }}
    />
</Module>
