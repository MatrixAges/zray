<Module>
    <Type from="model" as="Execution" />
    <Type from="../model" as="Schedule" />

    <Args in={Execution.ScheduleWalk} out={Execution.ScheduleWalk} />

    <If on={$in.plan.actions[$in.index] == Schedule.Action.Execute}>
        <Call
            module="scope"
            in={{
                ...$in.pick([
                    "traversal",
                    "context",
                    "buffers"
                ]),
                scope: $in.plan.scopes[$in.index],
                first: $in.plan.offsets[$in.index],
                count: $in.plan.counts[$in.index]
            }}
        />

        <Return
            value={{
                ...$in,
                index: $in.index + ($ctx.scope ? 1 : 0),
                running: $ctx.scope && $in.index + 1 < $in.plan.actions.length
            }}
        />
    </If>

    <Call
        fn="step"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "buffers",
                "child"
            ]),
            action: $in.plan.actions[$in.index],
            first: $in.plan.offsets[$in.index],
            count: $in.plan.counts[$in.index],
            scope: $in.plan.scopes[$in.index],
            placement: $in.plan.placements[$in.index]
        }}
    />

    <Return
        value={{
            ...$in,
            child: $ctx.step.child,
            index: $in.index + ($ctx.step.ok ? 1 : 0),
            running: $ctx.step.ok && $in.index + 1 < $in.plan.actions.length
        }}
    />
</Module>
