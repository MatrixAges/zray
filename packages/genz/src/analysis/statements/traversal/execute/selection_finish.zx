import integers from "std:integer"

import unpackSpan from "../../../tasks/worker/execute/reference"

import type { Input as Selection } from "../../switch/model"
import type { Step } from "./model"

export type Input = {
    step: Step,
    arm_base: u64
}

export type Output = Selection.Omit("bases")

export default function (in: Input): Output {
    const { context, state, placement } = in.step

    const payload = integers.widen(state.selection_payloads[placement])
    const cases = state.selection_cases[placement]
    const fallback = state.selection_fallbacks[placement]
    const block = unpackSpan(fallback ?? 0)

    return {
        name: state.selection_names[placement],
        subject: state.selection_values[placement],
        reference: state.selection_references[placement],
        selected: state.selection_selected[placement],
        exhaustive: context.control.selection_exhaustive[payload],
        total_count: integers.widen(context.control.selection_count[payload]),
        fallback_start: fallback != null ? block.start : null,
        fallback_count: block.count,
        arm_base: integers.narrow(in.arm_base),
        cases: {
            body_start: cases.body_start.reverse()[0],
            body_count: cases.body_count.reverse()[0],
            conditions: cases.conditions.reverse()[0],
            literals: cases.literals.reverse()[0]
        }
    }
}
