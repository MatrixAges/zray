import integers from "std:integer"
import { publishAstBasicStatements } from "ast_rows"
import host from "lowering_host"
import memory from "memory"

import unpackSpan from "../../../tasks/worker/execute/reference"
import branch from "../../basic/branch"
import { Action } from "../model"
import selectionCase from "./case"
import openScope from "./open_scope"
import selectionOpen from "./selection_open"
import selectionResolve from "./selection_resolve"

import type { Step as Input, StepResult as Output } from "./model"

export default function (in: Input): Output {
    const {
        action,
        traversal,
        context,
        buffers,
        state,
        scope,
        first,
        count,
        placement,
        child
    } =
        in

    if (action == Action.Open) {
        const opened = openScope({
            traversal,
            context,
            scope,
            first,
            count,
            placement
        })

        if (!opened.ok) {
            return {
                ok: false,
                child,
                state
            }
        }

        return {
            ok: true,
            child,
            state: {
                ...state,
                scope_firsts: state.scope_firsts.splice(scope, 1, [first])[0],
                scope_placements:
                    state.scope_placements.splice(scope, 1, [placement])[0],
                scope_routes:
                    state.scope_routes.splice(scope, 1, [opened.routes])[0]
            }
        }
    }

    if (action == Action.Condition) {
        const scope_first = state.scope_firsts[scope]
        const row = integers.widen(scope_first) + integers.widen(first)
        const payload = integers.widen(context.control.statement_payloads[row])

        const cond = host.lowerExpression(
            context.frame,
            context.control.branch_conditions[payload],
            false,
            null
        )

        return {
            ok: true,
            child,
            state: {
                ...state,
                scope_conditions: state.scope_conditions.splice(scope, 1, [cond])[0]
            }
        }
    }

    if (action == Action.SaveYes) {
        const yes = unpackSpan(child)

        return {
            ok: true,
            child,
            state: {
                ...state,
                scope_yes_starts:
                    state.scope_yes_starts.splice(scope, 1, [yes.start])[0],
                scope_yes_counts:
                    state.scope_yes_counts.splice(scope, 1, [yes.count])[0]
            }
        }
    }

    if (action == Action.Join) {
        const condition = state.scope_conditions[scope]
        const yes_start = state.scope_yes_starts[scope]
        const yes_count = state.scope_yes_counts[scope]
        const scope_placement = state.scope_placements[scope]
        const no = unpackSpan(child)

        const span = publishAstBasicStatements(
            context.writer,
            branch({
                condition,
                yes_start,
                yes_count,
                no_start: no.start,
                no_count: no.count
            })
        )

        const joined = unpackSpan(span)
        const offset = scope_placement + integers.widen(first)

        memory.writeU32(buffers.starts, offset, joined.start)
        memory.writeU32(buffers.counts, offset, joined.count)

        return {
            ok: true,
            child,
            state
        }
    }

    if (action == Action.Close) {
        const finished = host.finishStatementScope(traversal, scope)

        return {
            ok: finished != null,
            child: finished ?? child,
            state
        }
    }

    if (action == Action.Fallback) {
        const fallback: u64? = child

        return {
            ok: true,
            child,
            state: {
                ...state,
                selection_fallbacks:
                    state.selection_fallbacks.splice(placement, 1, [fallback])[0]
            }
        }
    }

    if (action == Action.EndSelection) {
        return {
            ok: host.finishStatementSelection(
                traversal,
                scope,
                first,
                placement,
                state.selection_fallbacks[placement]
            ),
            child,
            state
        }
    }

    const result = match action {
        Action.Selection => selectionOpen({
            traversal,
            context,
            state,
            scope,
            first,
            placement
        }),
        Action.Resolve => selectionResolve({
            traversal,
            context,
            state,
            placement,
            count
        }),
        Action.Case => selectionCase({
            traversal,
            context,
            state,
            placement,
            count,
            first,
            after: false
        }),
        Action.SaveCase => selectionCase({
            traversal,
            context,
            state,
            placement,
            count,
            first,
            after: true
        }),
        _ => ({
            ok: false,
            state
        })
    }

    return {
        ok: result.ok,
        child,
        state: result.state
    }
}
