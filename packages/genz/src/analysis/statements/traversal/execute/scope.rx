<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Scope} out={Execution.ScopeResult} />

    <Call fn="range" in={$in} />

    <Loop on={$in.running}>
        <Call module="next_statement" />
    </Loop>

    <Return
        value={$ctx.next_statement.pick([
            "valid",
            "writes"
        ])}
    />
</Module>
