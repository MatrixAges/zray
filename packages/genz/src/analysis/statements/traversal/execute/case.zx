import integers from "std:integer"
import host from "lowering_host"

import type { Case as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { traversal, placement, count, first } = in

    const direct = host.statementSelectionUsesSwitch(traversal, placement)

    if (!in.after) {
        host.resetStatementCase(traversal, placement, count)

        return direct ||
            host.lowerStatementComparison(traversal, placement, count, first)
    }

    host.saveStatementCase(traversal, placement, count)

    if (!direct) {
        return true
    }

    const last = integers.widen(count) + 1 ==
        host.statementSelectionCaseCount(traversal, placement)

    if (last) {
        return host.lowerStatementComparison(traversal, placement, count, first)
    }

    return host.lowerStatementCaseLiteral(traversal, placement, count, first)
}
