import integers from "std:integer"
import { BinaryOperator } from "core/expression_table/kinds"
import host from "lowering_host"

import binary from "../../../expressions/evaluate/binary"

import type { Case as Input, StateResult as Output } from "./model"

export default function (in: Input): Output {
    const { traversal, context, state, placement, count, first } = in

    const direct = state.selection_selected[placement]
    const subject_ir = state.selection_subjects[placement]

    const binary_expressions = context.expressions.pick([
        "kinds",
        "types"
    ])

    if (!in.after) {
        if (direct) {
            return {
                ok: true,
                state
            }
        }

        const comparison = binary({
            frame: context.frame,
            writer: context.writer,
            origin: context.origin,
            expressions: binary_expressions,
            types: context.types,
            operator: BinaryOperator.Equal,
            left_ir: subject_ir,
            right_ir: first
        })

        return {
            ok: true,
            state: {
                ...state,
                selection_comparisons:
                    state.selection_comparisons.splice(placement, 1, [comparison])[0]
            }
        }
    }

    if (!direct) {
        const comparison = state.selection_comparisons[placement]

        host.saveStatementCase(traversal, placement, count, comparison, null)

        return {
            ok: true,
            state
        }
    }

    const case_count = state.selection_counts[placement]

    if (integers.widen(count) + 1 == integers.widen(case_count)) {
        const comparison = binary({
            frame: context.frame,
            writer: context.writer,
            origin: context.origin,
            expressions: binary_expressions,
            types: context.types,
            operator: BinaryOperator.Equal,
            left_ir: subject_ir,
            right_ir: first
        })

        host.saveStatementCase(traversal, placement, count, comparison, null)

        return {
            ok: true,
            state
        }
    }

    const literal = host.lowerRegular(context.frame, first, true, null)

    host.saveStatementCase(traversal, placement, count, 0, literal)

    return {
        ok: true,
        state
    }
}
