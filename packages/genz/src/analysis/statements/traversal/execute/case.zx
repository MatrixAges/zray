import integers from "std:integer"
import { BinaryOperator } from "core/expression_table/kinds"
import host from "lowering_host"

import binary from "../../../expressions/evaluate/binary"
import unpackSpan from "../../../tasks/worker/execute/reference"

import type { StatementCases } from "lowering_host"
import type { Case as Input, StateResult as Output } from "./model"

export default function (in: Input): Output {
    const { context, state, placement, count, first } = in

    const direct = state.selection_selected[placement]
    const subject_ir = state.selection_subjects[placement]

    const binary_expressions = context.expressions.pick([
        "kinds",
        "types"
    ])

    if (!in.after) {
        if (direct) {
            return {
                ok: true,
                state
            }
        }

        const comparison = binary({
            frame: context.frame,
            writer: context.writer,
            expressions: binary_expressions,
            types: context.types,
            operator: BinaryOperator.Equal,
            left_ir: subject_ir,
            right_ir: first
        })

        return {
            ok: true,
            state: {
                ...state,
                selection_comparisons:
                    state.selection_comparisons.splice(placement, 1, [comparison])[0]
            }
        }
    }

    const last = integers.widen(count) + 1 == integers.widen(
        state.selection_counts[placement]
    )

    const comparison = match {
        !direct => state.selection_comparisons[placement],
        last => binary({
            frame: context.frame,
            writer: context.writer,
            expressions: binary_expressions,
            types: context.types,
            operator: BinaryOperator.Equal,
            left_ir: subject_ir,
            right_ir: first
        }),
        _ => 0
    }

    const literal: u32? = match {
        direct && !last => host.lowerRegular(context.frame, first, true, null),
        _ => null
    }

    const block = unpackSpan(in.child)
    const cases = state.selection_cases[placement]

    const updated: StatementCases = {
        body_start: cases.body_start.push(block.start)[0],
        body_count: cases.body_count.push(block.count)[0],
        conditions: cases.conditions.push(comparison)[0],
        literals: cases.literals.push(literal)[0]
    }

    return {
        ok: true,
        state: {
            ...state,
            selection_cases: state.selection_cases.with(placement, updated)
        }
    }
}
