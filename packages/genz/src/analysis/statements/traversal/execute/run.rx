<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Input} out={u64?} />

    <If on={$in.plan.flat}>
        <Call module="flat" in={$in} />

        <Return value={$ctx.flat} />
    </If>

    <Call
        module="walk"
        in={$in.pick([
            "context",
            "plan"
        ])}
    />

    <Return value={$ctx.walk} />
</Module>
