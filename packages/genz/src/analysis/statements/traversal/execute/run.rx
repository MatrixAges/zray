<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Input} out={bool} />

    <If on={$in.plan.flat}>
        <Call module="flat" in={$in} />

        <Return value={$ctx.flat} />
    </If>

    <Call
        module="walk"
        in={$in.pick([
            "traversal",
            "context",
            "plan"
        ])}
    />

    <Return value={$ctx.walk == $in.plan.actions.length} />
</Module>
