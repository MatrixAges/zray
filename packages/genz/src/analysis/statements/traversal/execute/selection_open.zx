import integers from "std:integer"
import {
    AstPayloadOwnership,
    appendExpressionRows,
    astFieldCount,
    readAstOrigin
} from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import switchName from "../../switch/name"
import switchReference from "../../switch/reference"

import type { Context, State, StateResult as Output } from "./model"

export type Input = {
    context: Context,
    state: State,
    scope: u64,
    first: u32,
    placement: u64
}

export default function (in: Input): Output {
    const { context, state, scope, first, placement } = in
    const { frame, writer, control } = context

    const scope_first = state.scope_firsts[scope]
    const row = integers.widen(scope_first) + integers.widen(first)
    const payload = control.statement_payloads[row]
    const subject_ir = control.selection_subjects[integers.widen(payload)]
    const current = readAstOrigin(writer)

    const generated = switchName({
        serial: current.serial
    })

    const name = host.retainLoweringText(frame, generated.name)

    host.finishGeneratedAst(frame, generated.serial, false)

    const subject = host.lowerExpression(frame, subject_ir, false, null)
    const ref_origin = readAstOrigin(writer)
    const field_base = astFieldCount(writer)

    const ref = switchReference({
        name,
        bases: {
            ...ref_origin,
            field_base
        }
    })

    requireAllocation(ref.valid)

    appendExpressionRows(
        writer,
        ref.expressions,
        null,
        AstPayloadOwnership.BorrowingText
    )

    const no_fallback: u64? = null

    return {
        ok: true,
        binding: {
            subject: subject_ir,
            reference: ref.root
        },
        state: {
            ...state,
            selection_payloads: state.selection_payloads.with(placement, payload),
            selection_subjects: state.selection_subjects.with(placement, subject_ir),
            selection_names: state.selection_names.with(placement, name),
            selection_values: state.selection_values.with(placement, subject),
            selection_references: state.selection_references.with(placement, ref.root),
            selection_fallbacks: state.selection_fallbacks.with(
                placement,
                no_fallback
            )
        }
    }
}
