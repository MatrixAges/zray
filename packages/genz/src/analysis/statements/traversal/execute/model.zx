import type { AstSequence, AstWriter } from "ast_rows"
import type { Control as ControlTable } from "core/control_table/model"
import type { StoreMode } from "core/function_table/complete"
import type { Table as TypeTable } from "core/type_table/model"
import type { Lowering, StatementCases } from "lowering_host"
import type {
    Expressions as SelectionExpressions
} from "../../../selection/labels/model"
import type { Values as StoreValues } from "../../../store/begin/model"
import type { Write } from "../commit"
import type { Action, Schedule } from "../model"

export type Control = ControlTable.Pick(
    "statement_kinds",
    "statement_payloads",
    "evaluations",
    "constant_symbols",
    "constant_values",
    "results",
    "branch_conditions",
    "setter_slots",
    "setter_values",
    "destructure_values",
    "destructure_first",
    "destructure_count",
    "destructure_symbols",
    "selection_subjects",
    "selection_first",
    "selection_count",
    "selection_exhaustive",
    "case_values",
    "parallel_first",
    "parallel_count",
    "parallel_values",
    "parallel_symbols"
)

export type ScopeRange = {
    first: u32,
    count: u32
}

export type StackView = {
    keys: u32[],
    buckets: u32[]
}

export type State = {
    scope_writes: Write[][],
    scope_firsts: u32[],
    scope_counts: u32[],
    scope_conditions: u32[],
    scope_yes_starts: u32[],
    scope_yes_counts: u32[],
    scope_routes: u8[][],
    selection_payloads: u32[],
    selection_subjects: u32[],
    selection_counts: u32[],
    selection_comparisons: u32[],
    selection_selected: bool[],
    selection_fallbacks: u64?[],
    selection_names: u8[][],
    selection_values: u32[],
    selection_references: u32[],
    selection_cases: StatementCases[]
}

export type Context = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    control: Control,
    expressions: SelectionExpressions,
    types: TypeTable,
    store_values: StoreValues,
    function_modes: StoreMode[],
    call_arguments: u32[],
    output_type: u32,
    store_mode: StoreMode,
    store_count: u64,
    names: u8[][],
    symbol_types: u32[],
    used: bool[],
    transaction: bool,
    value_output: bool,
    state_active: bool,
    public_value_output: bool
}

export type Input = {
    context: Context,
    plan: Schedule,
    first: u32,
    count: u32
}

export type Run = Input.Pick("context", "plan")

export type Step = Input.Pick("context") & {
    state: State,
    action: Action,
    first: u32,
    count: u32,
    scope: u64,
    placement: u64,
    child: u64
}

export type SelectionBinding = {
    subject: u32,
    reference?: u32
}

export type StepResult = {
    binding?: SelectionBinding,
    ok: bool,
    child: u64,
    state: State
}

export type StateResult = {
    binding?: SelectionBinding,
    ok: bool,
    state: State
}

export type Scope = Step.Pick(
    "context",
    "first",
    "count"
) & {
    routes: u8[],
    writes: Write[],
    scope_first: u32,
    scope_count: u32
}

export type Case = Step.Pick(
    "context",
    "state",
    "placement",
    "count",
    "first",
    "child"
) & {
    after: bool
}

export type ScopeWalk =
    Scope.Pick("context", "routes", "writes") & {
        first: u64,
        cursor: u64,
        scope_first: u64,
        scope_count: u64,
        valid: bool,
        running: bool
    }

export type ScheduleWalk = Run & {
    state: State,
    index: u64,
    child: u64,
    running: bool
}

export type ScopeResult = {
    valid: bool,
    writes: Write[]
}

export type Statement = {
    current: ScopeWalk,
    write: Write,
    cursor: u64
}
