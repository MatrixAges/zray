import type { AstOriginBuffer, AstSequence, AstWriter } from "ast_rows"
import type { Control as ControlTable } from "core/control_table/model"
import type { StoreMode } from "core/function_table/complete"
import type { Table as TypeTable } from "core/type_table/model"
import type { Lowering, StatementTraversal } from "lowering_host"
import type { U8Buffer, U32Buffer, U64Buffer } from "memory"
import type {
    Expressions as SelectionExpressions
} from "../../../selection/labels/model"
import type { Action, Schedule } from "../model"

export type Control = ControlTable.Pick(
    "statement_kinds",
    "statement_payloads",
    "evaluations",
    "constant_symbols",
    "constant_values",
    "results",
    "branch_conditions",
    "setter_slots",
    "setter_values",
    "destructure_values",
    "destructure_first",
    "destructure_count",
    "destructure_symbols",
    "selection_subjects",
    "selection_first",
    "selection_count",
    "case_values"
)

export type Buffers = {
    starts: U32Buffer,
    counts: U32Buffer,
    routes: U8Buffer,
    scope_firsts: U32Buffer,
    scope_placements: U64Buffer,
    scope_conditions: U32Buffer,
    scope_yes_starts: U32Buffer,
    scope_yes_counts: U32Buffer,
    selection_payloads: U32Buffer,
    selection_subjects: U32Buffer,
    selection_counts: U32Buffer,
    selection_comparisons: U32Buffer,
    selection_selected: U8Buffer,
    selection_has_fallback: U8Buffer,
    selection_fallbacks: U64Buffer
}

export type Context = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    sequence: AstSequence,
    control: Control,
    expressions: SelectionExpressions,
    types: TypeTable,
    store_mode: StoreMode,
    store_count: u64,
    names: u8[][],
    used: bool[],
    transaction: bool,
    value_output: bool,
    state_active: bool,
    public_value_output: bool
}

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    buffers: Buffers,
    plan: Schedule,
    first: u32,
    count: u32
}

export type Run = Input.Pick("traversal", "context", "buffers", "plan")

export type Step = Input.Pick("traversal", "context", "buffers") & {
    action: Action,
    first: u32,
    count: u32,
    scope: u64,
    placement: u64,
    child: u64
}

export type StepResult = {
    ok: bool,
    child: u64
}

export type Scope = Step.Pick(
    "traversal",
    "context",
    "buffers",
    "first",
    "count",
    "scope"
)

export type Case = Step.Pick(
    "traversal",
    "context",
    "buffers",
    "placement",
    "count",
    "first"
) & {
    after: bool
}

export type ScopeWalk = Scope.Pick("traversal", "context", "buffers", "scope") & {
    first: u64,
    cursor: u64,
    scope_first: u64,
    scope_placement: u64,
    valid: bool,
    running: bool
}

export type ScheduleWalk = Run & {
    index: u64,
    child: u64,
    running: bool
}
