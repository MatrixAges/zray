import type { AstSequence, AstWriter } from "ast_rows"
import type { Control as ControlTable } from "core/control_table/model"
import type { StoreMode } from "core/function_table/complete"
import type { Table as TypeTable } from "core/type_table/model"
import type { Lowering, StatementTraversal } from "lowering_host"
import type { U32Buffer } from "memory"
import type {
    Expressions as SelectionExpressions
} from "../../../selection/labels/model"
import type { Write } from "../commit"
import type { Action, Schedule } from "../model"

export type Control = ControlTable.Pick(
    "statement_kinds",
    "statement_payloads",
    "evaluations",
    "constant_symbols",
    "constant_values",
    "results",
    "branch_conditions",
    "setter_slots",
    "setter_values",
    "destructure_values",
    "destructure_first",
    "destructure_count",
    "destructure_symbols",
    "selection_subjects",
    "selection_first",
    "selection_count",
    "case_values"
)

export type State = {
    scope_writes: Write[][],
    scope_firsts: u32[],
    scope_conditions: u32[],
    scope_yes_starts: u32[],
    scope_yes_counts: u32[],
    scope_routes: u8[][],
    selection_payloads: u32[],
    selection_subjects: u32[],
    selection_counts: u32[],
    selection_comparisons: u32[],
    selection_selected: bool[],
    selection_fallbacks: u64?[]
}

export type Context = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    control: Control,
    expressions: SelectionExpressions,
    types: TypeTable,
    output_type: u32,
    store_mode: StoreMode,
    store_count: u64,
    names: u8[][],
    used: bool[],
    stack_keys: U32Buffer,
    stack_buckets: U32Buffer,
    transaction: bool,
    value_output: bool,
    state_active: bool,
    public_value_output: bool
}

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    plan: Schedule,
    first: u32,
    count: u32
}

export type Run = Input.Pick("traversal", "context", "plan")

export type Step = Input.Pick("traversal", "context") & {
    state: State,
    action: Action,
    first: u32,
    count: u32,
    scope: u64,
    placement: u64,
    child: u64
}

export type StepResult = {
    ok: bool,
    child: u64,
    state: State
}

export type StateResult = {
    ok: bool,
    state: State
}

export type Scope = Step.Pick(
    "traversal",
    "context",
    "first",
    "count",
    "scope"
) & {
    routes: u8[],
    writes: Write[],
    scope_first: u32
}

export type Case = Step.Pick(
    "traversal",
    "context",
    "state",
    "placement",
    "count",
    "first"
) & {
    after: bool
}

export type ScopeWalk =
    Scope.Pick("traversal", "context", "scope", "routes", "writes") & {
        first: u64,
        cursor: u64,
        scope_first: u64,
        valid: bool,
        running: bool
    }

export type ScheduleWalk = Run & {
    state: State,
    index: u64,
    child: u64,
    running: bool
}

export type ScopeResult = {
    valid: bool,
    writes: Write[]
}

export type Statement = {
    current: ScopeWalk,
    write: Write,
    cursor: u64
}
