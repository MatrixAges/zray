<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Input} out={bool} />

    <Call
        fn="open_scope"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "first",
                "count"
            ]),
            scope: 0,
            placement: 0
        }}
    />

    <If on={!$ctx.open_scope.ok}>
        <Return value={false} />
    </If>

    <Call
        module="scope"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "buffers",
                "first",
                "count"
            ]),
            scope: 0,
            routes: $ctx.open_scope.routes,
            scope_first: $in.first,
            scope_placement: 0
        }}
    />

    <If on={!$ctx.scope}>
        <Return value={false} />
    </If>

    <Call
        fn="host.finishStatementScope"
        in={[
            $in.traversal,
            0
        ]}
    />

    <Return value={$ctx.finishStatementScope != null} />
</Module>
