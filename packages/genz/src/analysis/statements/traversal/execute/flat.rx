<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Input} out={u64?} />

    <Store from="selection" as="traversal" />

    <Call
        module="open_scope"
        in={$in.pick([
            "context",
            "first",
            "count"
        ])}
    />

    <Call
        module="scope"
        in={{
            ...$in.pick([
                "context",
                "first",
                "count"
            ]),
            writes: [],
            routes: $ctx.open_scope,
            scope_first: $in.first,
            scope_count: $in.count
        }}
    />

    <If on={!$ctx.scope.valid}>
        <Return value={null} />
    </If>

    <Call
        fn="close_scope"
        in={{
            writer: $in.context.writer,
            count: $in.count,
            writes: $ctx.scope.writes
        }}
    />

    <Call fn="set_scope" in={null} setter={[$store.traversal.locals]} />

    <Return value={$ctx.close_scope} />
</Module>
