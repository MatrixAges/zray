<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.Input} out={bool} />

    <Call
        fn="open_scope"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "first",
                "count"
            ]),
            scope: 0,
            placement: 0
        }}
    />

    <If on={!$ctx.open_scope.ok}>
        <Return value={false} />
    </If>

    <Call
        module="scope"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "first",
                "count"
            ]),
            scope: 0,
            writes: [],
            routes: $ctx.open_scope.routes,
            scope_first: $in.first
        }}
    />

    <If on={!$ctx.scope.valid}>
        <Return value={false} />
    </If>

    <Call
        fn="host"
        in={{
            traversal: $in.traversal,
            scope: 0,
            writes: $ctx.scope.writes
        }}
    />

    <Return value={$ctx.host != null} />
</Module>
