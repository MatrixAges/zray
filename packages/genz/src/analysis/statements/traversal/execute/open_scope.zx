import integers from "std:integer"
import host from "lowering_host"

import plan from "../../block/plan"

import type { Context, ScopeCheckpoint } from "./model"

export type Input = {
    context: Context,
    first: u32,
    count: u32
}

export type Output = {
    checkpoint: ScopeCheckpoint,
    routes: u8[]
}

export default function (in: Input): Output {
    const { context, first, count } = in

    const stack = host.openStatementScope(context.frame, first, count)

    const routes = plan({
        control: context.control.pick([
            "statement_kinds",
            "statement_payloads",
            "evaluations",
            "constant_values",
            "constant_symbols",
            "results"
        ]),
        values: {
            kinds: context.expressions.kinds,
            types: context.expressions.types,
            type_kinds: context.types.kinds
        },
        first: integers.widen(first),
        count: integers.widen(count),
        mode: context.store_mode,
        store_count: context.store_count,
        stack_keys: stack.stack_keys,
        stack_buckets: stack.stack_buckets
    })

    return {
        checkpoint: stack.pick([
            "state_checkpoint",
            "stack_checkpoint"
        ]),
        routes
    }
}
