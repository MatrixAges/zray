import integers from "std:integer"
import host from "lowering_host"
import memory from "memory"

import plan from "../../block/plan"

import type { StatementTraversal } from "lowering_host"
import type { Buffers, Context } from "./model"

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    buffers: Buffers,
    scope: u64,
    first: u32,
    count: u32,
    placement: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { traversal, context, buffers, scope, first, count, placement } = in

    if (!host.openStatementScope(traversal, scope, first, count, placement)) {
        return false
    }

    memory.writeU32(buffers.scope_firsts, scope, first)
    memory.writeU64(buffers.scope_placements, scope, placement)

    plan({
        control: context.control.pick([
            "statement_kinds",
            "statement_payloads",
            "evaluations",
            "constant_values",
            "results"
        ]),
        values: {
            kinds: context.expression_kinds,
            types: context.expression_types,
            type_kinds: context.type_kinds
        },
        first: integers.widen(first),
        count: integers.widen(count),
        offset: placement,
        mode: context.store_mode,
        store_count: context.store_count,
        target: buffers.routes
    })

    return true
}
