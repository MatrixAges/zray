import integers from "std:integer"
import host from "lowering_host"

import plan from "../../block/plan"

import type { StatementTraversal } from "lowering_host"
import type { Context } from "./model"

export type Input = {
    traversal: StatementTraversal,
    context: Context,
    scope: u64,
    first: u32,
    count: u32,
    placement: u64
}

export type Output = {
    ok: bool,
    routes: u8[]
}

export default function (in: Input): Output {
    const { traversal, context, scope, first, count, placement } = in

    if (!host.openStatementScope(traversal, scope, first, count, placement)) {
        return {
            ok: false,
            routes: []
        }
    }

    const routes = plan({
        control: context.control.pick([
            "statement_kinds",
            "statement_payloads",
            "evaluations",
            "constant_values",
            "results"
        ]),
        values: {
            kinds: context.expressions.kinds,
            types: context.expressions.types,
            type_kinds: context.types.kinds
        },
        first: integers.widen(first),
        count: integers.widen(count),
        mode: context.store_mode,
        store_count: context.store_count
    })

    return {
        ok: true,
        routes
    }
}
