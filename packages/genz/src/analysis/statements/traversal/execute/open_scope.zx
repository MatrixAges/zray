import integers from "std:integer"

import plan from "../../block/plan"

import type { Context, StackView } from "./model"

export type Input = {
    context: Context,
    first: u32,
    count: u32,
    stack: StackView
}

export type Output = u8[]

export default function (in: Input): Output {
    const { context, first, count, stack } = in

    return plan({
        control: context.control.pick([
            "statement_kinds",
            "statement_payloads",
            "evaluations",
            "constant_values",
            "constant_symbols",
            "results"
        ]),
        values: {
            kinds: context.expressions.kinds,
            types: context.expressions.types,
            type_kinds: context.types.kinds
        },
        first: integers.widen(first),
        count: integers.widen(count),
        mode: context.store_mode,
        store_count: context.store_count,
        stack_keys: stack.keys,
        stack_buckets: stack.buckets
    })
}
