<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.ScopeWalk} out={Execution.ScopeWalk} />

    <Call
        module="../../emit/run"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "scope"
            ]),
            index: $in.cursor - 1,
            statement: $in.scope_first + $in.cursor - 1,
            route: $in.routes[$in.cursor - 1]
        }}
    />

    <If on={$ctx.run != null}>
        <Call
            fn="save_statement"
            in={{
                current: $in,
                write: $ctx.run.omit(["cursor"]),
                cursor: $ctx.run.cursor
            }}
        />

        <Return value={$ctx.save_statement} />
    </If>

    <Return
        value={{
            ...$in,
            valid: false,
            running: false
        }}
    />
</Module>
