<Module>
    <Type from="model" as="Execution" />

    <Args in={Execution.ScopeWalk} out={Execution.ScopeWalk} />

    <Call
        fn="host.readU8"
        in={[
            $in.buffers.routes,
            $in.scope_placement + $in.cursor - 1
        ]}
    />

    <Call
        module="../../emit/run"
        in={{
            ...$in.pick([
                "traversal",
                "context",
                "buffers",
                "scope"
            ]),
            index: $in.cursor - 1,
            statement: $in.scope_first + $in.cursor - 1,
            placement: $in.scope_placement,
            route: $ctx.readU8
        }}
    />

    <If on={$ctx.run != null}>
        <Return
            value={{
                ...$in,
                cursor: $ctx.run,
                running: $ctx.run > $in.first
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            valid: false,
            running: false
        }}
    />
</Module>
