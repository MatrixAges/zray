import integers from "std:integer"
import { joinAstStatementRows } from "ast_rows"

import packSpan from "../../../node_headers/block/span"

import type { AstWriter } from "ast_rows"
import type { Write } from "../commit"

export type Input = {
    writer: AstWriter,
    writes: Write[],
    count: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { writer, writes } = in

    const count = integers.widen(in.count)
    const empty: u32[] = []
    const zero: u32 = 0
    const total: u64 = 0

    if (count == 0) {
        return 0
    }

    const blank = loop({
        row: 0,
        values: empty
    }, {
        while: state => state.row < count,
        next: state => {
            state.values = state.values.push(zero)[0]
            state.row += 1
        },
        return: state => state.values
    })

    const rows = loop({
        index: 0,
        starts: blank,
        counts: blank,
        total
    }, {
        while: state => state.index < writes.length,
        next: state => {
            const write = writes[state.index]
            const previous = write.previous

            state.total -= integers.widen(state.counts[write.row])
            state.total += integers.widen(write.count)
            state.starts = state.starts.with(write.row, write.start)
            state.counts = state.counts.with(write.row, write.count)

            if (previous != null) {
                state.total -= integers.widen(state.counts[previous])
                state.starts = state.starts.with(previous, zero)
                state.counts = state.counts.with(previous, zero)
            }

            state.index += 1
        },
        return: state => state
    })

    return packSpan({
        start: joinAstStatementRows(writer, rows.starts, rows.counts),
        count: rows.total
    })
}
