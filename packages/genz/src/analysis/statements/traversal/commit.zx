export type Input = {
    row: u64,
    start: u32,
    count: u32,
    consumed_previous: bool
}

export type Write = {
    row: u64,
    start: u32,
    count: u32,
    previous?: u64
}

export type Output = Write & {
    cursor: u64
}

export default function (in: Input): Output {
    const cursor = in.consumed_previous ? in.row - 1 : in.row
    const previous: u64? = in.consumed_previous ? cursor : null

    return {
        ...in.omit(["consumed_previous"]),
        previous,
        cursor
    }
}
