<Module>
    <Type from="model" as="Destructure" />
    <Type from="../../rows" as="AST" />

    <Args in={Destructure.Input} out={u64} />

    <Call fn="../name" in={$in.pick(["serial"])} />

    <Call
        fn="../../rows.retainLoweringText"
        in={[
            $in.frame,
            $ctx.name.name
        ]}
    />

    <Call
        fn="../../rows.setLoweringSerial"
        in={[
            $in.frame,
            $ctx.name.serial
        ]}
    />

    <Call
        fn="operand"
        in={$in.pick([
            "frame",
            "value",
            "capture"
        ])}
    />

    <Call fn="../../rows.astExpressionCount" in={$in.writer} />

    <Call
        module="../build"
        in={{
            ...$in.pick([
                "frame",
                "symbols",
                "names",
                "used"
            ]),
            name: $ctx.retainLoweringText,
            value: $ctx.operand,
            expression_base: $ctx.astExpressionCount
        }}
    />

    <Call fn="../../rows.requireAllocation" in={$ctx.build.valid} />

    <Call
        fn="../../rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.build.expressions,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call fn="../../rows.astStatementCount" in={$in.writer} />

    <Call
        fn="../../rows.appendStatementRows"
        in={[
            $in.writer,
            $ctx.build.statements,
            null,
            AST.AstPayloadOwnership.Borrowed
        ]}
    />

    <Call
        fn="../../../node_headers/block/span"
        in={{
            start: $ctx.astStatementCount,
            count: $ctx.build.statements.tags.length
        }}
    />

    <Return value={$ctx.span} />
</Module>
