import bytes from "std:bytes"
import integers from "std:integer"
import { max_u32 } from "core/const"

import emptyExpressions from "../../../ast/expressions/empty"
import { ExpressionsKind } from "../../../printer/model/expressions"
import { pending_name } from "../../store/const"
import retainSlotName from "../../store/retain_slot_name"

import type { ExpressionRows } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    slot: u32,
    base: u32
}

export type Output = {
    nodes: ExpressionRows,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    if (in.base > max_u32 - 2) {
        return {
            nodes: emptyExpressions({}),
            root: 0,
            valid: false
        }
    }

    const name = retainSlotName([
        in.frame,
        integers.widen(in.slot)
    ])

    return {
        nodes: {
            ...emptyExpressions({}),
            tags: [
                ExpressionsKind.Identifier,
                ExpressionsKind.Field
            ],
            offsets: [
                0,
                0
            ],
            identifier: [bytes.fromText(pending_name)],
            field_target: [in.base],
            field_name: [name]
        },
        root: in.base + 1,
        valid: true
    }
}
