import bytes from "std:bytes"
import integers from "std:integer"
import { max_u32 } from "core/const"

import { ExpressionsKind } from "../../../printer/model/expressions"
import { pending_name } from "../../store/const"
import retainSlotName from "../../store/retain_slot_name"

import type { ProjectionRows } from "ast_rows"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    slot: u32,
    base: u32
}

export type Output = {
    nodes: ProjectionRows,
    root: u32,
    valid: bool
}

export default function (in: Input): Output {
    if (in.base > max_u32 - 2) {
        return {
            nodes: {
                tags: [],
                offsets: [],
                identifier: [],
                field_target: [],
                field_name: [],
                dereference: [],
                binary_operator: [],
                binary_left: [],
                binary_right: []
            },
            root: 0,
            valid: false
        }
    }

    const name = retainSlotName([
        in.frame,
        integers.widen(in.slot)
    ])

    return {
        nodes: {
            tags: [
                ExpressionsKind.Identifier,
                ExpressionsKind.Field
            ],
            offsets: [
                0,
                0
            ],
            identifier: [bytes.fromText(pending_name)],
            field_target: [in.base],
            field_name: [name],
            dereference: [],
            binary_operator: [],
            binary_left: [],
            binary_right: []
        },
        root: in.base + 1,
        valid: true
    }
}
