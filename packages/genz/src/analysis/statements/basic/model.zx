import type { AstWriter } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as BranchFields } from "./branch"
import type { Input as DiscardValue } from "./discard"

export type Writer = {
    writer: AstWriter
}

export type Evaluation = Writer & DiscardValue & {
    frame: Lowering
}

export type Branch = Writer & BranchFields

export type StoreWrite = Evaluation & {
    slot: u32
}
