import empty from "../../../ast/statements/empty"
import { StatementsKind } from "../../../printer/model/statements"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    return {
        expressions: null,
        statements: {
            ...empty({}),
            tags: [StatementsKind.Result],
            offsets: [0],
            result: [in.value]
        },
        serial: in.bases.serial,
        valid: true
    }
}
