import { retainLoweringText } from "lowering_host"

import identifier from "../../../ast/context/identifier"
import fresh from "../../../ast/fresh"
import binding from "../../../ast/statements/binding"
import { output_prefix } from "./const"

import type { State as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const value = in.value

    if (value == null) {
        return in
    }

    const fresh_name = fresh({
        serial: in.context.serial,
        prefix: output_prefix
    })

    const name = retainLoweringText(in.frame, fresh_name.name)

    const reference = identifier({
        state: {
            ...in.context,
            serial: fresh_name.serial
        },
        name
    })

    const saved = binding({
        table: reference.state.statements,
        base: 0,
        name,
        value
    })

    return {
        frame: in.frame,
        context: {
            ...reference.state,
            statements: saved.table,
            valid: reference.state.valid && saved.valid
        },
        value: reference.id
    }
}
