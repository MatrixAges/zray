import type { StatementRows } from "ast_rows"
import type { Lowering } from "lowering_host"
import type { Input as Bases, State as Context } from "../../../ast/context/model"
import type { Columns as Expressions } from "../../../ast/expressions/model"

export type Input = {
    frame: Lowering,
    value?: u32,
    transaction: bool,
    bases: Bases
}

export type State = {
    frame: Lowering,
    context: Context,
    value?: u32
}

export type Output = {
    expressions?: Expressions,
    statements: StatementRows,
    serial: u64,
    valid: bool
}
