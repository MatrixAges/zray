<Module>
    <Type from="../input" as="Host" />

    <Args in={Host.Render} out={bool} />

    <Call fn="initialize" in={$in.omit(["writer"])} />

    <Call module="storage" />
    <Call module="allocation" />

    <Call fn="json_execute" />
    <Call fn="result_ptr" />
    <Call fn="result_len" />
    <Call fn="reset" />
    <Call fn="deinit" />

    <Call module="prepare" />
    <Call module="json" />
    <Call module="scalar" />

    <Call fn="publish" />

    <Call
        module="../../../printer/render_checked"
        in={{
            module: $ctx.publish,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
