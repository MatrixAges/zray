<Module>
    <Type from="model" as="Wasm" />

    <Args in={Wasm.Input} out={Wasm.Output} />

    <Call fn="initialize" in={$in} />

    <Call module="storage" />
    <Call module="allocation" />

    <Call fn="json_execute" />
    <Call fn="result_ptr" />
    <Call fn="result_len" />
    <Call fn="reset" />
    <Call fn="deinit" />

    <Call module="prepare" />
    <Call module="json" />
    <Call module="scalar" />

    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
