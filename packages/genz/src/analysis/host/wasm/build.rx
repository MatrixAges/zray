<Module>
    <Type from="../input" as="Host" />

    <Args in={Host.Input} out={u8[][]?} />

    <Call fn="initialize" in={$in} />

    <Call module="storage" />
    <Call module="allocation" />

    <Call fn="json_execute" />
    <Call fn="result_ptr" />
    <Call fn="result_len" />
    <Call fn="reset" />
    <Call fn="deinit" />

    <Call module="prepare" />
    <Call module="json" />
    <Call module="scalar" />

    <Call fn="publish" />

    <Call
        module="../../../printer/render_checked"
    />

    <Return value={$ctx.render_checked} />
</Module>
