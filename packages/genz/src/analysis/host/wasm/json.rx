<Module>
    <Type from="model" as="Wasm" />

    <Args in={Wasm.State} out={Wasm.State} />

    <Call fn="run_begin" in={$in} />

    <Call fn="input_empty" />
    <Call fn="input_parse" />
    <Call fn="input_select" />
    <Call fn="run_execute" />

    <Call module="validation" />

    <Call fn="run_finish" />

    <Return value={$ctx.run_finish} />
</Module>
