<Module>
    <Type from="model" as="Wasm" />

    <Args in={Wasm.State} out={Wasm.State} />

    <Call fn="scalar_storage" in={$in} />

    <Call fn="scalar_exports" />
    <Call fn="is_scalar" />
    <Call fn="scalar_type" />
    <Call fn="scalar_call" />
    <Call fn="scalar_call_void" />
    <Call fn="scalar_result" />
    <Call fn="scalar_invalid" />

    <Call module="scalar_execution" />

    <Return value={$ctx.scalar_execution} />
</Module>
