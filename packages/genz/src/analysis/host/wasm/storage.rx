<Module>
    <Type from="model" as="Wasm" />

    <Args in={Wasm.State} out={Wasm.State} />

    <Call module="request" in={$in} />

    <Call fn="prelude" />
    <Call fn="storage_state" />
    <Call fn="storage_buffers" />
    <Call fn="storage_flags" />
    <Call fn="capabilities" />

    <Return value={$ctx.capabilities} />
</Module>
