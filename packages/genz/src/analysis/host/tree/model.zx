import type { StatementsKind } from "../../../printer/model/statements"
import type { Input as AstInput, State as Ast, Published } from "./ast"

export type Input = AstInput

export type Extra = {
    error_union_payload: u32[],
    error_union_errors: u8[][]?[],
    error_union_inferred: bool[],
    catch_scope_value: u32[],
    catch_scope_capture: u8[]?[],
    catch_scope_body_start: u32[],
    catch_scope_body_len: u32[],
    defer_expression: u32[],
    defer_scope_start: u32[],
    defer_scope_len: u32[]
}

export type State = {
    ast: Ast,
    extra: Extra
}

export type Node = {
    state: State,
    id: u32
}

export type Parameter = {
    name: string,
    value: u32,
    comptime_parameter?: bool
}

export type Method = {
    state: State,
    name: string,
    parameters: Parameter[],
    return_type: u32,
    exported: bool,
    convention?: u32,
    abi_export?: bool
}

export type Saved = {
    state: State,
    parent_tags: StatementsKind[],
    parent_offsets: u32[]
}

export type Output = Published
