import type { State as Context } from "../../../ast/context/model"
import type { Table as Declarations } from "../../../ast/declarations/table/model"
import type { Columns as Fields } from "../../../ast/fields/model"
import type { State as Statements } from "../../../ast/statements/builder/model"
import type { Columns as Loops } from "../../../ast/statements/builder/while_loop"
import type { Destination, Published as Module } from "../../../printer/model"

export type Input = {
    stateful: bool
}

export type State = {
    stateful: bool,
    context: Context,
    declarations: Declarations,
    fields: Fields,
    members: Fields,
    statements: Statements,
    loops: Loops,
    optional_type: u32[],
    valid: bool
}

export type Render = Input & Destination

export type Published = Module
