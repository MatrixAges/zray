<Module>
    <Type from="../input" as="Host" />

    <Args in={Host.Render} out={bool} />

    <Call fn="initialize" in={$in.omit(["writer"])} />

    <Call fn="prelude" />

    <Call module="lifecycle" />

    <Call fn="input/empty" />
    <Call fn="input/json" />
    <Call fn="input/select" />
    <Call fn="execution/execute" />

    <Call
        module="output/build"
        in={{
            state: $ctx.execute,
            types: $in.types,
            output_type: $in.output_type
        }}
    />

    <Call fn="finish" />
    <Call fn="publish" />

    <Call
        module="../../../printer/render_checked"
        in={{
            module: $ctx.publish,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
