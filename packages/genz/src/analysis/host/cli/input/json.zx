import binary from "../../../../ast/context/binary"
import emptyObject from "../../../../ast/context/empty_object"
import integer from "../../../../ast/context/integer"
import invoke from "../../../../ast/context/invoke"
import path from "../../../../ast/context/path"
import index from "../../../../ast/context/subscript"
import { ExpressionsBinaryOperator as B } from "../../../../printer/model/expressions"
import {
    standard_name,
    json_name,
    parse_name,
    application_name,
    input_type,
    allocator_name,
    args_name,
    input_argument,
    length_name,
    json_input_argc,
    json_input_error
} from "../const"
import block from "./block"

import type { State as Input, State as Output } from "../model"

export default function (in: Input): Output {
    const options = emptyObject(in.context)

    const target = path({
        state: options.state,
        path: [
            application_name,
            input_type
        ]
    })

    const allocator = path({
        state: target.state,
        path: [allocator_name]
    })

    const args = path({
        state: allocator.state,
        path: [args_name]
    })

    const position = integer({
        state: args.state,
        value: input_argument
    })

    const source = index({
        state: position.state,
        target: args.id,
        index: position.id
    })

    const parsed = invoke({
        state: source.state,
        path: [
            standard_name,
            json_name,
            parse_name
        ],
        arguments: [
            target.id,
            allocator.id,
            source.id,
            options.id
        ],
        fallible: true
    })

    const length = path({
        state: parsed.state,
        path: [
            args_name,
            length_name
        ]
    })

    const expected = integer({
        state: length.state,
        value: json_input_argc
    })

    const condition = binary({
        state: expected.state,
        operator: B.NotEqual,
        left: length.id,
        right: expected.id
    })

    const body = block({
        state: {
            ...in,
            context: condition.state
        },
        condition: condition.id,
        value: parsed.id,
        error: json_input_error
    })

    return {
        ...body.state,
        parsed_input: body.id
    }
}
