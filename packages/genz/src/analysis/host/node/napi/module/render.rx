<Module>
    <Type from="model" as="Binding" />

    <Args in={Binding.Input} out={Binding.Rendered} />

    <Call module="build" in={$in} />

    <If on={!$ctx.build.supported}>
        <Return
            value={{
                status: Binding.Status.Unsupported,
                chunks: []
            }}
        />
    </If>

    <If on={!$ctx.build.valid}>
        <Return
            value={{
                status: Binding.Status.Invalid,
                chunks: []
            }}
        />
    </If>

    <Call
        module="../../../../../printer/render"
        in={{
            source: $ctx.build.module
        }}
    />

    <Return
        value={{
            status: Binding.Status.Ready,
            chunks: $ctx.render
        }}
    />
</Module>
