<Module>
    <Type from="model" as="Root" />

    <Args in={Root.Types} out={Root.Types} />

    <Call fn="type_member" in={$in} />

    <If on={$ctx.type_member != null}>
        <Call module="member" in={$ctx.type_member} />

        <Return
            value={{
                state: $ctx.member,
                index: $in.index + 1,
                running:
                    $in.index + 1 < $in.state.aliases.length &&
                    $ctx.member.codec.supported
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.state.aliases.length
        }}
    />
</Module>
