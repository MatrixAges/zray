<Module>
    <Type from="model" as="Value" />

    <Args in={Value.Input} out={Value.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="check" />
    <Call fn="fail" />
    <Call fn="kind" />
    <Call fn="length" />
    <Call fn="size" />
    <Call fn="allocate" />
    <Call fn="string" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
