<Module>
    <Type from="model" as="Value" />

    <Args in={Value.State} out={Value.State} />

    <Call fn="check" in={$in} />

    <Call fn="fail" />
    <Call fn="kind" />
    <Call fn="length" />
    <Call fn="size" />
    <Call fn="allocate" />
    <Call fn="string" />

    <Return value={$ctx.string} />
</Module>
