import integers from "std:integer"

import emptyDeclarations from "../../../../../ast/snapshot/empty_declarations"
import emptyStatements from "../../../../../ast/snapshot/empty_statements"
import expressions from "../../../../../ast/snapshot/expressions"
import statements from "../../../../../ast/statements/builder/publish"

import type { State as Input, Output } from "./model"

export default function (in: Input): Output {
    const body = statements(in.tree.ast.statements)

    const valid = (
        - in.tree.ast.valid
        - and in.tree.ast.context.valid
        - and body.valid
    )

    return {
        module: {
            expressions: {
                ...expressions(in.tree.ast.context),
                ...in.tree.extra.omit([
                    "defer_expression",
                    "defer_scope_start",
                    "defer_scope_len"
                ]),
                optional_type: in.tree.ast.optional_type,
                many_pointer: in.many_pointer
            },
            statements: {
                ...emptyStatements({}),
                ...body.statements,
                ...body.variables,
                ...in.loops,
                ...in.scopes,
                ...in.tree.extra.pick([
                    "defer_expression",
                    "defer_scope_start",
                    "defer_scope_len"
                ])
            },
            fields: in.tree.ast.fields,
            declarations: {
                ...emptyDeclarations({}),
                ...in.tree.ast.declarations
            },
            arms: {
                value: [],
                capture: [],
                result: []
            },
            first: 0,
            count: integers.narrow(in.tree.ast.declarations.tags.length)
        },
        supported: in.supported,
        valid
    }
}
