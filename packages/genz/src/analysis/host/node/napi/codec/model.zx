import type { Kind as TypeKind, Table } from "core/type_table/model"
import type { Input as Bases } from "../../../../../ast/context/model"
import type { Columns as Loops } from "../../../../../ast/statements/builder/for_loop"
import type { Columns as Scopes } from "../../../../../ast/statements/builder/scope"
import type { Source } from "../../../../../printer/model"
import type { State as Tree } from "../../../tree/model"

export type Kind = TypeKind

export enum ScalarRoute {
    Void,
    Boolean,
    String,
    BigInteger,
    Float,
    Integer
}

export type Input = {
    types: Table,
    id: u32,
    reading: bool,
    bases: Bases
}

export type State = {
    source: Input,
    tree: Tree,
    loops: Loops,
    scopes: Scopes,
    many_pointer: u32[],
    kind: TypeKind,
    scalar: u32,
    scalar_route: ScalarRoute,
    byte_child: bool,
    child: u32,
    supported: bool
}

export type Output = {
    module: Source,
    supported: bool,
    valid: bool
}

export type Member = {
    state: State,
    position: u64
}

export type Classification =
    State.Pick("kind", "scalar", "scalar_route", "byte_child", "child")

export type Selection = {
    state: State,
    id: u32,
    reading: bool
}
