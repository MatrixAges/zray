<Module>
    <Call fn="cleanup" in={$in} />

    <Call fn="bindings" />
    <Call fn="registered" />
    <Call fn="finalize" />
    <Call fn="callback" />
    <Call fn="arguments" />
    <Call fn="arity" />
    <Call fn="context" />
    <Call fn="guard_context" />

    <If on={$in.tree.ast.stateful}>
        <Call fn="pending" in={$ctx.guard_context} />

        <Call module="execution" />

        <Return value={$ctx.execution} />

        <Else>
            <Call module="execution" in={$ctx.guard_context} />

            <Return value={$ctx.execution} />
        </Else>
    </If>
</Module>
