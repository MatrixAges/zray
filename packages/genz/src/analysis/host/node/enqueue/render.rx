<Module>
    <Type from="../../tree/ast" as="Tree" />

    <Args in={Tree.Render} out={bool} />

    <Call module="build" in={$in.omit(["writer"])} />

    <Call
        module="../../../../printer/render_checked"
        in={{
            module: $ctx.build,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
