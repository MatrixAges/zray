<Module>
    <Type from="model" as="Enqueue" />

    <Args in={Enqueue.Args} out={Enqueue.Output} />

    <Call fn="initialize" in={$in} />

    <Call fn="prelude" />
    <Call fn="callback" />
    <Call fn="arguments" />
    <Call fn="count" />
    <Call fn="context" />
    <Call fn="guard_context" />
    <Call fn="busy" />
    <Call fn="callbacks" />
    <Call fn="result_value" />
    <Call fn="allocate" />
    <Call fn="retain" />
    <Call fn="input" />
    <Call fn="references" />
    <Call fn="work" />

    <If on={$in.stateful}>
        <Call fn="dispatch" in={$ctx.work} />

        <Call fn="finish" />
        <Call fn="publish" />

        <Return value={$ctx.publish} />

        <Else>
            <Call fn="start" in={$ctx.work} />

            <Call fn="finish" />
            <Call fn="publish" />

            <Return value={$ctx.publish} />
        </Else>
    </If>
</Module>
