<Module>
    <Type from="../../tree/ast" as="Context" />

    <Args in={Context.Input} out={u8[][]?} />

    <Call fn="../../tree/initialize_ast" in={$in} />

    <Call fn="prelude" />
    <Call fn="fields" />
    <Call fn="retain" />
    <Call fn="release" />
    <Call fn="close" />
    <Call fn="cleanup" />
    <Call fn="publish" />

    <Call
        module="../../../../printer/render_checked"
    />

    <Return value={$ctx.render_checked} />
</Module>
