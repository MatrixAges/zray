<Module>
    <Type from="../../tree/ast" as="Context" />

    <Args in={Context.Render} out={bool} />

    <Call fn="../../tree/initialize_ast" in={$in.omit(["writer"])} />

    <Call fn="prelude" />
    <Call fn="fields" />
    <Call fn="retain" />
    <Call fn="release" />
    <Call fn="close" />
    <Call fn="cleanup" />
    <Call fn="publish" />

    <Call
        module="../../../../printer/render_checked"
        in={{
            module: $ctx.publish,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
