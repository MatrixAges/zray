<Module>
    <Type from="../../tree/ast" as="Context" />

    <Args in={Context.Input} out={Context.Published} />

    <Call fn="../../tree/initialize_ast" in={$in} />

    <Call fn="prelude" />
    <Call fn="fields" />
    <Call fn="retain" />
    <Call fn="release" />
    <Call fn="close" />
    <Call fn="cleanup" />
    <Call fn="publish" />

    <Return value={$ctx.publish} />
</Module>
