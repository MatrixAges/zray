import invoke from "../../../../ast/context/invoke"
import evaluate from "../../../../ast/statements/builder/evaluate"

import type { State } from "../../tree/ast"

export type Input = {
    state: State,
    path: string[],
    arguments: u32[],
    discard: bool
}

export type Output = State

export default function (in: Input): Output {
    const result = invoke({
        state: in.state.context,
        path: in.path,
        arguments: in.arguments,
        fallible: false
    })

    return {
        ...in.state,
        context: result.state,
        statements: evaluate({
            state: in.state.statements,
            value: result.id,
            discard: in.discard
        })
    }
}
