<Module>
    <Type from="../../tree/ast" as="Task" />

    <Args in={Task.Render} out={bool} />

    <Call fn="../../tree/initialize" in={$in.omit(["writer"])} />

    <Call fn="prelude" />
    <Call fn="fields" />
    <Call fn="destroy" />
    <Call fn="start" />
    <Call fn="execute" />

    <Task name="completion" out={$ctx.build}>
        <Call module="complete/build" in={$ctx.execute} />
    </Task>

    <Call module="settle/build" />

    <Call fn="publish" />

    <Call
        module="../../../../printer/render_checked"
        in={{
            module: $ctx.publish,
            writer: $in.writer
        }}
    />

    <Return value={$ctx.render_checked} />
</Module>
