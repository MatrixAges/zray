<Module>
    <Type from="../../tree/ast" as="Task" />

    <Args in={Task.Input} out={u8[][]?} />

    <Call fn="../../tree/initialize" in={$in} />

    <Call fn="prelude" />
    <Call fn="fields" />
    <Call fn="destroy" />
    <Call fn="start" />
    <Call fn="execute" />

    <Task name="completion" out={$ctx.build}>
        <Call module="complete/build" in={$ctx.execute} />
    </Task>

    <Call module="settle/build" />

    <Call fn="publish" />

    <Call
        module="../../../../printer/render_checked"
    />

    <Return value={$ctx.render_checked} />
</Module>
