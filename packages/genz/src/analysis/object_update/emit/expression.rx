<Module>
    <Type from="model" as="Update" />

    <Args in={Update.Expression} out={Update.Output} />

    <Call fn="initialize" in={$in.source} />

    <If on={$in.boxed != null}>
        <Call
            fn="overlay"
            in={{
                state: $ctx.initialize,
                layout: $in.layout,
                initial: $in.initial,
                boxed: $in.boxed
            }}
        />

        <Return value={$ctx.overlay} />
    </If>

    <Call
        fn="variable"
        in={{
            state: $ctx.initialize,
            layout: $in.layout,
            initial: $in.initial
        }}
    />

    <Call module="updates" />

    <Call
        fn="finish"
        in={{
            state: $ctx.updates,
            label: $in.label
        }}
    />

    <Return value={$ctx.finish} />
</Module>
