import integers from "std:integer"

export type Update = {
    symbol: u32,
    name: string
}

export type Input = {
    symbols: u32[],
    sources: u32[],
    replacements: string[],
    names: string[],
    saved: string[],
    restore: bool
}

export type Output = {
    saved: string[],
    updates: Update[]
}

export default function (in: Input): Output {
    const empty_saved: string[] = []
    const empty_updates: Update[] = []

    return loop({
        index: 0,
        names: in.names,
        saved: empty_saved,
        updates: empty_updates
    }, {
        while: state => state.index < in.symbols.length,
        next: state => {
            const index = match in.restore {
                true => in.symbols.length - state.index - 1,
                _ => state.index
            }

            const symbol = integers.widen(in.symbols[index])

            if (in.restore) {
                state.updates = state.updates.push({
                    symbol: in.symbols[index],
                    name: in.saved[index]
                })[0]
            } else {
                const name = match {
                    in.replacements.length != 0 => in.replacements[index],
                    _ => state.names[integers.widen(in.sources[index])]
                }

                state.saved = state.saved.push(state.names[symbol])[0]
                state.names[symbol] = name
                state.updates = state.updates.push({
                    symbol: in.symbols[index],
                    name
                })[0]
            }

            state.index += 1
        },
        return: state => ({
            saved: state.saved,
            updates: state.updates
        })
    })
}
