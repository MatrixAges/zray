import execute from "./execute"
import { Action } from "./model"
import next from "./next"

import type { Input as Scope, Prepared } from "./model"

export type Input = Prepared.Pick("count", "type_id") & {
    source: Scope
}

export type Output = u64[]

export default function (in: Input): Output {
    const { source, count, type_id } = in
    const { frame, scope, selection, names } = source

    const empty: u64[] = []

    const initial_spans = loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < count,
        next: state => {
            state.items = state.items.push(0)[0]
            state.index += 1
        },
        return: state => state.items
    })

    return loop({
        remaining: count,
        spans: initial_spans
    }, {
        while: state => state.remaining != 0,
        next: state => {
            const binding = next({
                selection,
                remaining: state.remaining
            })

            const span = match binding.action {
                Action.Skip => 0,
                _ => execute({
                    frame,
                    scope,
                    binding,
                    type_id,
                    names
                })
            }

            state.spans[binding.position] = span
            state.remaining = binding.position
        },
        return: state => state.spans
    })
}
