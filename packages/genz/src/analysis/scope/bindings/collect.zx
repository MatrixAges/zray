import memory from "memory"

import execute from "./execute"
import iteration from "./iteration"
import { Action } from "./model"
import next from "./next"

import type { Input as Scope, Prepared } from "./model"

export type Input = Prepared.Pick("count", "type_id") & {
    source: Scope
}

export type Output = void

export default function (in: Input): Output {
    const { source, count, type_id } = in
    const { frame, scope, selection, spans, values, names } = source

    const remaining = loop(count, {
        while: remaining => remaining != 0,
        next: remaining => {
            const binding = next({
                selection,
                remaining
            })

            if (selection.iteration) {
                iteration({
                    scope: source,
                    binding,
                    output: values
                })
            } else {
                const span = match binding.action {
                    Action.Skip => 0,
                    _ => execute({
                        frame,
                        scope,
                        binding,
                        type_id,
                        names
                    })
                }

                memory.writeU64(spans, binding.position, span)
            }

            remaining = binding.position
        }
    })
}
