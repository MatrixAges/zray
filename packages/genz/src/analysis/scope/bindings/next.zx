import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"

import before from "../../binding/before"
import { Route } from "../../binding/model"
import { Action } from "./model"

import type { Binding as Output, Selected } from "./model"

export type Input = {
    selection: Selected,
    remaining: u64
}

export default function (in: Input): Output {
    const data = in.selection
    const position = in.remaining - 1
    const symbol = data.symbols[position]
    const value = data.values[position]
    const row = integers.widen(value)
    const kind = data.kinds[row]

    const used = match {
        symbol != null => data.used[integers.widen(symbol)],
        _ => false
    }

    const binding = {
        position,
        symbol,
        value
    }

    if (data.iteration) {
        const reference = kind == ExpressionKind.Reference

        const skip = (
            - symbol != null
            - and !used
            - and reference
        )

        return {
            ...binding,
            action: skip ? Action.Skip : Action.Iteration
        }
    }

    if (position < data.changes.length && data.changes[position] != null) {
        return {
            ...binding,
            action: Action.Reuse
        }
    }

    const type_id = integers.widen(data.types[row])

    const route = before({
        kind,
        type_kind: data.type_kinds[type_id],
        scope: true,
        has_symbol: symbol != null,
        used
    })

    if (route == Route.Skip || route == Route.Task) {
        return {
            ...binding,
            action: route == Route.Skip ? Action.Skip : Action.Task
        }
    }

    if (symbol == null) {
        return {
            ...binding,
            action: Action.Discard
        }
    }

    return {
        ...binding,
        action: data.stacked[position] ? Action.Value : Action.Ordinary
    }
}
