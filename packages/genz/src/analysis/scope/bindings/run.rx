<Module>
    <Type from="model" as="Scope" />

    <Args in={Scope.Input} out={u32} />

    <Call fn="prepare" in={$in} />

    <Call
        fn="reserve"
        in={{
            ...$in.pick([
                "spans",
                "values"
            ]),
            iteration: $in.selection.iteration,
            count: $ctx.prepare.count
        }}
    />

    <Call
        fn="collect"
        in={{
            source: $in,
            ...$ctx.prepare.pick([
                "count",
                "type_id"
            ])
        }}
    />

    <If on={!$in.selection.iteration}>
        <Call fn="workflow.u64Views" in={$in.spans} />

        <Call
            fn="workflow.tailAstPackedStatements"
            in={[
                $in.writer,
                $ctx.u64Views
            ]}
        />

        <Call
            fn="../../aggregate/execute/finish_stored"
            in={{
                frame: $in.frame,
                writer: $in.writer,
                origin: $in.origin,
                span: $ctx.tailAstPackedStatements,
                value: $ctx.prepare.value,
                guard: null
            }}
        />

        <Return value={$ctx.finish_stored} />
    </If>

    <Call
        fn="iteration_result"
        in={{
            symbols: $in.selection.symbols,
            buffers: $in.values
        }}
    />

    <Call
        fn="workflow.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call
        module="../../iteration/scope/build"
        in={{
            writer: $in.writer,
            frame: $in.frame,
            bindings: $ctx.iteration_result,
            result: $ctx.prepare.value,
            expression_base: $ctx.readAstOrigin.expression_base,
            statement_base: $ctx.readAstOrigin.statement_base,
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Return value={$ctx.build} />
</Module>
