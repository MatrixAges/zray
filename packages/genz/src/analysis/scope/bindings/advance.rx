<Module>
    <Type from="model" as="Binding" />

    <Args in={Binding.Advance} out={Binding.Request} />

    <Call fn="complete" in={$in} />

    <If on={$ctx.complete.action == Binding.Action.Type}>
        <Return value={$ctx.complete} />
    </If>

    <Call fn="request" in={$in} />

    <Return value={$ctx.request} />
</Module>
