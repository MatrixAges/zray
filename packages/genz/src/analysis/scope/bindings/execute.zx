import host from "lowering_host"

import { Action } from "./model"

import type { Lowering, ScopeFrame } from "lowering_host"
import type { Binding } from "./model"

export type Input = {
    frame: Lowering,
    scope: ScopeFrame,
    binding: Binding,
    type_id: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { frame, scope, binding, type_id } = in
    const { action, position, symbol, value } = binding

    if (action == Action.Reuse) {
        return host.reuseScopeBinding(scope, position)
    }

    if (action == Action.Task) {
        return host.emitScopeTask(frame, symbol, value)
    }

    const borrowed = host.prepareScopeBinding(scope, symbol, value, type_id)

    const lowered: u32 = borrowed ?? match action {
        Action.Discard => host.lowerDiscardedExpression(frame, value),
        Action.Value => host.lowerValueExpression(frame, value),
        _ => host.lowerExpression(frame, value, false, null)
    }

    return host.publishScopeBinding(
        scope,
        position,
        symbol,
        lowered,
        action == Action.Value
    )
}
