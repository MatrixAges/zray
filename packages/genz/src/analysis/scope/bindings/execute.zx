import integers from "std:integer"
import { prepareScopeBinding, publishScopeBinding } from "ast_rows"
import host from "lowering_host"

import { Action } from "./model"

import type { Binding, Input as Scope } from "./model"

export type Input = {
    source: Scope,
    binding: Binding,
    type_id: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { source, binding, type_id } = in
    const { frame, writer, sequence, candidates, selection, variables, names } = source
    const { action, position, symbol, value } = binding

    const change: u32? = match {
        action == Action.Reuse => selection.changes[position],
        _ => null
    }

    if (change != null && candidates != null) {
        const candidate = integers.widen(change)

        return host.reuseScopeBinding(
            frame,
            candidates.previous[candidate],
            candidates.references[candidate],
            candidates.types[candidate],
            candidates.field_indices[candidate],
            candidates.field_values[candidate]
        )
    }

    if (action == Action.Task) {
        return host.startInlineTask(
            frame,
            value,
            names[integers.widen(symbol ?? 0)],
            false
        )
    }

    const borrowed = prepareScopeBinding(writer, sequence, symbol, value, type_id)

    const lowered: u32 = borrowed ?? match action {
        Action.Discard => host.lowerDiscardedExpression(frame, value),
        Action.Value => host.lowerValueExpression(frame, value),
        _ => host.lowerExpression(frame, value, false, null)
    }

    return publishScopeBinding(
        writer,
        sequence,
        symbol,
        lowered,
        action == Action.Value,
        position < variables.length && variables[position]
    )
}
