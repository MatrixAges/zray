import integers from "std:integer"
import memory from "memory"

import { Action } from "./model"

import type { Advance as Input, Request } from "./model"

export type Output = Request

export default function (in: Input): Output {
    const { previous, spans, values } = in
    const { position, symbol } = previous

    const complete = {
        ...previous,
        action: Action.Done
    }

    if (previous.action == Action.Begin) {
        return complete
    }

    if (spans != null) {
        memory.writeU32(spans.starts, position, in.value)
        memory.writeU32(spans.counts, position, in.count)

        return complete
    }

    if (values == null) {
        return complete
    }

    if (previous.action == Action.Type) {
        memory.writeOptionalU32(values.values, position, previous.value)
        memory.writeOptionalU32(values.types, position, in.value)
        memory.writeU8List(values.names, position, previous.name)

        return complete
    }

    if (symbol != null && in.selection.used[integers.widen(symbol)]) {
        const index = integers.widen(symbol)

        return {
            ...previous,
            action: Action.Type,
            value: in.value,
            name: in.names[index],
            type_id: in.symbol_types[index]
        }
    }

    memory.writeOptionalU32(values.values, position, in.value)
    memory.writeOptionalU32(values.types, position, null)
    memory.writeU8List(values.names, position, [])

    return complete
}
