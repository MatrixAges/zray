import type { ExpressionKind } from "core/expression_table/kinds"
import type { Lowering, ScopeFrame } from "lowering_host"
import type { OptionalU32Buffer, U32Buffer, U8ListBuffer } from "memory"

export enum Action {
    Reuse,
    Skip,
    Task,
    Discard,
    Value,
    Ordinary,
    Iteration
}

export type Selection = {
    symbols: u32?[],
    values: u32[],
    kinds: ExpressionKind[],
    types: u32[],
    type_kinds: u8[],
    used: bool[],
    stack_keys: U32Buffer,
    stack_buckets: U32Buffer,
    changes: u32?[],
    iteration: bool
}

export type Binding = {
    position: u64,
    symbol?: u32,
    value: u32,
    action: Action
}

export type Spans = {
    starts: U32Buffer,
    counts: U32Buffer,
    current: U32Buffer
}

export type Values = {
    values: OptionalU32Buffer,
    types: OptionalU32Buffer,
    names: U8ListBuffer
}

export type Input = {
    frame: Lowering,
    scope: ScopeFrame,
    result: u32,
    layout: bool,
    selection: Selection,
    spans?: Spans,
    values?: Values,
    names: u8[][],
    symbol_types: u32[]
}

export type Prepared = {
    value: u32,
    type_id: u32,
    count: u64
}

export type Output = Prepared.Pick("value")
