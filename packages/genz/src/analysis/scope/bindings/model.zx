import type { AstSequence, AstWriter } from "ast_rows"
import type { ExpressionKind } from "core/expression_table/kinds"
import type { Lowering } from "lowering_host"
import type { Candidates } from "../reuse/model"

export enum Action {
    Reuse,
    Skip,
    Task,
    Discard,
    Value,
    Ordinary,
    Iteration
}

export type Selection = {
    symbols: u32?[],
    values: u32[],
    kinds: ExpressionKind[],
    types: u32[],
    type_kinds: u8[],
    used: bool[],
    stack_keys: u32[],
    stack_buckets: u32[],
    changes: u32?[],
    iteration: bool
}

export type Selected = Selection.Omit("stack_keys", "stack_buckets") & {
    stacked: bool[]
}

export type Binding = {
    position: u64,
    symbol?: u32,
    value: u32,
    action: Action
}

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    sequence: AstSequence,
    result: u32,
    layout: bool,
    selection: Selection,
    candidates?: Candidates,
    variables: bool[],
    names: u8[][],
    symbol_types: u32[]
}

export type Prepared = {
    value: u32,
    type_id: u32,
    count: u64
}
