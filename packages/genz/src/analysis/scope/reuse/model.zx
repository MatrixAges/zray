import type { Expressions } from "core/expression_table/model"
import type { Change, Environment } from "../../object_update/match/model"
import type { Update as NameUpdate } from "../names"
import type { Last } from "../reads/model"

export type Candidates = {
    bindings: u32[],
    previous: u32[],
    types: u32[],
    references: u32[],
    field_indices: u32[],
    field_values: u32[]
}

export type Bindings = {
    bindings: u32[],
    symbols: u32?[],
    result: u32
}

export type Source = Bindings & {
    matching: Environment
}

export type Job = Source & {
    names: string[]
}

export type Input = Bindings & {
    expressions: Expressions,
    symbol_types: u32[],
    candidates: Candidates
}

export type Plan = {
    changes: u32?[],
    variables: bool[],
    alias_symbols: u32[],
    alias_sources: u32[]
}

export type Active = Plan & {
    candidates: Candidates,
    saved: string[],
    updates: NameUpdate[]
}

export type Output = Active?

export type Preparation = {
    source: Input,
    last: Last
}

export type Work = Plan & {
    source: Input,
    last: Last,
    bound: Last,
    binding: u64,
    candidate: u64
}

export type Scan = {
    source: Source,
    found: Candidates,
    row: u64,
    running: bool
}

export type Add = Scan.Pick("found", "row") & {
    change: Change
}
