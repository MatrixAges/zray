<Module>
    <Type from="model" as="Reuse" />

    <Args in={Reuse.Source} out={Reuse.Input} />

    <Loop on={$in.running}>
        <Call
            module="scan_next"
            in={{
                source: $in,
                found: {
                    bindings: [],
                    previous: [],
                    types: [],
                    references: [],
                    field_indices: [],
                    field_values: []
                },
                row: 0,
                running: $in.symbols.length != 0
            }}
        />
    </Loop>

    <Return
        value={{
            expressions: $in.matching.expressions,
            symbol_types: $in.matching.symbol_types,
            ...$in.omit(["matching"]),
            candidates: $ctx.scan_next.found
        }}
    />
</Module>
