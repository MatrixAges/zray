<Module>
    <Type from="model" as="Reuse" />

    <Args in={Reuse.Job} out={Reuse.Output} />

    <Call
        module="scan"
        in={$in.omit([
            "names",
            "saved"
        ])}
    />

    <Call fn="has" />

    <If on={$ctx.has}>
        <Call
            module="../reads/collect"
            in={{
                expressions: $ctx.scan.expressions,
                bindings: $in.bindings,
                result: $in.result
            }}
        />

        <Call
            fn="initialize"
            in={{
                source: $ctx.scan,
                last: $ctx.collect
            }}
        />

        <Call fn="plan" />

        <If on={$ctx.plan.alias_symbols.length == 0}>
            <Return value={null} />
        </If>

        <Call
            fn="install"
            in={{
                ...$in.pick([
                    "names",
                    "saved"
                ]),
                ...$ctx.plan.pick([
                    "alias_symbols",
                    "alias_sources"
                ])
            }}
        />

        <Return
            value={{
                ...$ctx.plan,
                candidates: $ctx.scan.candidates
            }}
        />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
