<Module>
    <Type from="model" as="Reuse" />
    <Type from="../names" as="Names" />

    <Args in={Reuse.Job} out={Reuse.Output} />

    <Call module="scan" in={$in.omit(["names"])} />

    <Call fn="has" />

    <If on={$ctx.has}>
        <Call
            module="../reads/collect"
            in={{
                expressions: $ctx.scan.expressions,
                bindings: $in.bindings,
                result: $in.result
            }}
        />

        <Call
            fn="initialize"
            in={{
                source: $ctx.scan,
                last: $ctx.collect
            }}
        />

        <Call fn="plan" />

        <If on={$ctx.plan.alias_symbols.length == 0}>
            <Return value={null} />
        </If>

        <Call
            fn="../names"
            in={{
                names: $in.names,
                saved: [],
                symbols: $ctx.plan.alias_symbols,
                sources: $ctx.plan.alias_sources,
                replacements: [],
                action: Names.Action.Bind
            }}
        />

        <Return
            value={{
                ...$ctx.plan,
                candidates: $ctx.scan.candidates,
                saved: $ctx.names.saved,
                updates: $ctx.names.updates
            }}
        />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
