<Module>
    <Type from="model" as="Reuse" />

    <Args in={Reuse.Source} out={Reuse.Output} />

    <Call module="scan" in={$in} />

    <Call fn="has" />

    <If on={$ctx.has}>
        <Call
            module="../reads/collect"
            in={{
                expressions: $ctx.scan.expressions,
                bindings: $in.bindings,
                result: $in.result
            }}
        />

        <Call
            fn="initialize"
            in={{
                source: $ctx.scan,
                last: $ctx.collect
            }}
        />

        <Call fn="plan" />

        <Return
            value={{
                ...$ctx.plan,
                candidates: $ctx.scan.candidates
            }}
        />

        <Else>
            <Return value={null} />
        </Else>
    </If>
</Module>
