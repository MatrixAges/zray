import memory from "memory"

import applyNames from "../names"

import type { Aliases as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    memory.allocateStringViews(in.saved, in.alias_symbols.length)

    applyNames({
        ...in.pick([
            "names",
            "saved"
        ]),
        symbols: in.alias_symbols,
        sources: in.alias_sources,
        replacements: [],
        restore: false
    })
}
