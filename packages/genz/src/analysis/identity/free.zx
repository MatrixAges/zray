import memory from "memory"

import flags from "../facts/flags"
import body from "./body"

import type { Table } from "core/type_table/model"
import type { Allocator } from "memory"
import type { Functions } from "../model"

export type Input = {
    types: Table,
    functions: Functions,
    pure: bool[],
    allocator: Allocator
}

export type Output = bool[]

export default function (in: Input): Output {
    const safe = flags({
        count: in.functions.output_types.length,
        allocator: in.allocator
    })

    const processed = loop({
        types: in.types,
        expressions: in.functions.expressions,
        contracts: in.functions.contracts,
        pure: in.pure,
        index: 0
    }, {
        while: current => current.index < current.expressions.length,
        next: current => {
            const index = current.index

            const independent = current.pure[index] && body({
                types: current.types,
                expressions: current.expressions[index],
                contracts: current.contracts[index],
                allowed: safe.values,
                limit: index
            })

            memory.writeBool(safe.buffer, index, independent)
            current.index += 1
        }
    })

    return safe.values
}
