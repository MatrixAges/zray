import ast from "ast_rows"
import { AstPayloadOwnership } from "ast_rows"
import host from "lowering_host"
import { requireAllocation } from "memory"

import type { PublishAst as Input } from "./execute_model"

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, output } = in

    requireAllocation(output.valid)

    ast.appendExpressionRows(
        writer,
        output.expressions,
        output.forms,
        AstPayloadOwnership.Owned
    )

    ast.appendStatementRows(
        writer,
        output.statements,
        null,
        AstPayloadOwnership.Owned
    )

    ast.hoistStatementRows(writer, output.storage, output.variables)
    host.finishGeneratedAst(frame, output.serial, output.uses_allocator)

    return output.root
}
