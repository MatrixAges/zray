<Module>
    <Type from="execute_model" as="Construction" />

    <Args in={Construction.Execute} out={u32} />

    <Call module="build" in={$in.request} />

    <Call
        fn="publish_ast"
        in={{
            ...$in.pick([
                "frame",
                "writer"
            ]),
            output: $ctx.build
        }}
    />

    <Return value={$ctx.publish_ast} />
</Module>
