<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Entry} out={Workflow.EntryStep[]} />

    <If on={$in.type_only}>
        <If on={$in.local}>
            <Return
                value={[
                    Workflow.EntryStep.Standard,
                    Workflow.EntryStep.NativeImports,
                    Workflow.EntryStep.Types,
                    Workflow.EntryStep.Exports,
                    Workflow.EntryStep.Constants
                ]}
            />
        </If>

        <Return
            value={[
                Workflow.EntryStep.Standard,
                Workflow.EntryStep.Types,
                Workflow.EntryStep.Exports,
                Workflow.EntryStep.Constants
            ]}
        />
    </If>

    <If on={$in.local}>
        <Return
            value={[
                Workflow.EntryStep.Standard,
                Workflow.EntryStep.NativeImports,
                Workflow.EntryStep.Types,
                Workflow.EntryStep.Exports,
                Workflow.EntryStep.Constants,
                Workflow.EntryStep.Shape,
                Workflow.EntryStep.Contracts,
                Workflow.EntryStep.Store,
                Workflow.EntryStep.Entry,
                Workflow.EntryStep.ValueEntry,
                Workflow.EntryStep.RequestedFunctions,
                Workflow.EntryStep.ParallelAllocator,
                Workflow.EntryStep.Comparisons
            ]}
        />
    </If>

    <Return
        value={[
            Workflow.EntryStep.Standard,
            Workflow.EntryStep.Types,
            Workflow.EntryStep.Exports,
            Workflow.EntryStep.Constants,
            Workflow.EntryStep.Shape,
            Workflow.EntryStep.Contracts,
            Workflow.EntryStep.Store,
            Workflow.EntryStep.Entry,
            Workflow.EntryStep.ValueEntry,
            Workflow.EntryStep.ParallelAllocator,
            Workflow.EntryStep.Comparisons
        ]}
    />
</Module>
