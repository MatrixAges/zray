import host from "lowering_host"

import type { Entry as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { module_frame, local } = in

    host.emitModuleStandard(module_frame)

    if (local) {
        host.emitModuleImports(module_frame)
    }

    host.emitModuleTypes(module_frame)
    host.emitModuleExports(module_frame)
    host.emitModuleConstants(module_frame)
}
