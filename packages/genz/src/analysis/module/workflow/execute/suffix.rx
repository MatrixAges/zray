<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Suffix} out={Workflow.Output} />

    <If on={$in.uses_parallel}>
        <Return
            value={{
                steps: [
                    Workflow.Step.ParallelAllocator,
                    Workflow.Step.Comparisons
                ],
                comparisons: $in.comparisons
            }}
        />
    </If>

    <Return
        value={{
            steps: [Workflow.Step.Comparisons],
            comparisons: $in.comparisons
        }}
    />
</Module>
