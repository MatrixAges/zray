<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.ComparisonCursor} out={Flow.ComparisonCursor} />

    <Call
        fn="index.emitModuleComparison"
        in={[
            $in.frame,
            $in.row
        ]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1,
            running: $in.row + 1 < $in.count
        }}
    />
</Module>
