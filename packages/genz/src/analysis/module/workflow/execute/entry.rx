<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Entry} out={Workflow.Output} />

    <If on={$in.request != null}>
        <Call
            module="../../../functions/requests/execute/request"
            in={$in.request}
        />

        <Return value={$ctx.request} />
    </If>

    <If on={$in.suffix != null}>
        <Call module="suffix" in={$in.suffix} />

        <Return value={$ctx.suffix} />
    </If>

    <Call
        fn="entry_steps"
        in={$in.pick([
            "type_only",
            "local"
        ])}
    />

    <Return
        value={{
            steps: $ctx.entry_steps,
            comparisons: 0
        }}
    />
</Module>
