<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Function} out={Workflow.Output} />

    <If on={$in.suffix != null}>
        <Call module="suffix" in={$in.suffix} />

        <Return value={$ctx.suffix} />
    </If>

    <Call fn="function_steps" in={$in.form} />

    <Return
        value={{
            steps: $ctx.function_steps,
            comparisons: 0
        }}
    />
</Module>
