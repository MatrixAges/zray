import host from "lowering_host"

import type { ModuleFrame as Input } from "lowering_host"

export type Output = void

export default function (in: Input): Output {
    host.emitModuleShape(in)
    host.emitModuleAliases(in)
    host.emitModuleStore(in)
    host.emitModuleEntry(in)
    host.emitModuleValueEntry(in)
}
