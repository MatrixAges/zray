import type { ModuleFunctionForm, ModuleRequestForm, ModuleSuffix } from "lowering_host"

export enum Step {
    Standard,
    Imports,
    Types,
    Exports,
    Constants,
    Shape,
    Aliases,
    Store,
    Entry,
    ValueEntry,
    Requests,
    Suffix,
    Auxiliary,
    AppendSuffix,
    Finish,
    OpenFunction,
    OpenNative,
    NativeBody,
    RegularBody,
    ValueBody,
    ParallelAllocator,
    Comparisons,
    RequestedNative,
    RequestedOpen,
    RequestedStore,
    RequestedRegular,
    RequestedValue,
    RequestedPublish
}

export type Suffix = ModuleSuffix

export type Entry = {
    type_only: bool,
    local: bool,
    suffix?: Suffix,
    request?: ModuleRequestForm
}

export type Function = {
    form: ModuleFunctionForm,
    suffix?: Suffix
}

export type Output = {
    steps: Step[],
    comparisons: u64
}
