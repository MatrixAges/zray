import type { ModuleFrame, ModuleFunctionForm } from "lowering_host"

export { ModuleFunctionForm } from "lowering_host"

export type Entry = {
    module_frame: ModuleFrame,
    type_only: bool,
    local: bool
}

export type Function = {
    module_frame: ModuleFrame,
    form: ModuleFunctionForm
}

export type Module = ModuleFrame

export type ComparisonCursor = {
    frame: ModuleFrame,
    count: u64,
    row: u64,
    running: bool
}
