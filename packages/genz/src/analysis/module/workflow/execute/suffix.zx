import host from "lowering_host"

import type { ModuleFrame as Input } from "lowering_host"

export type Output = void

export default function (in: Input): Output {
    if (host.moduleUsesParallel(in)) {
        host.emitModuleParallelAllocator(in)
    }

    const count = host.moduleComparisonCount(in)

    const emitted = loop({
        index: 0
    }, {
        while: state => state.index < count,
        next: state => {
            host.emitModuleComparison(in, state.index)
            state.index = state.index + 1
        },
        return: state => state.index
    })
}
