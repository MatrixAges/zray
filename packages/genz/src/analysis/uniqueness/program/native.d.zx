export type Context = opaque

export type PlanTarget = opaque

export declare function replay(context: Context, target: PlanTarget): bool throws {
    OutOfMemory
}

export declare function open(context: Context): void throws { OutOfMemory }

export declare function prepare(
    context: Context,
    reset: bool,
    clear: bool
): u64 throws { OutOfMemory }

export declare function settle(context: Context, budget: u64): bool throws { OutOfMemory }

export declare function demand(context: Context): bool throws { OutOfMemory }

export declare function plans(context: Context, target: PlanTarget): void throws {
    OutOfMemory
}

export declare function commit(context: Context): void throws { OutOfMemory }
