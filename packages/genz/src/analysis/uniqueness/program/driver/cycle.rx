<Module>
    <Type from="model" as="Driver" />
    <Type from="effect" as="Effect" />

    <Args in={Driver.Convergence} out={Driver.Convergence} />

    <Task name="settle" out={$ctx.round}>
        <Call
            module="round"
            in={{
                kind: Effect.Kind.Settle,
                exhausted: false
            }}
        />
    </Task>

    <Call
        module="round"
        in={{
            kind: Effect.Kind.Demand,
            exhausted: $ctx.task.settle == Driver.Outcome.Exhausted
        }}
    />

    <Return
        value={{
            running: $ctx.round == Driver.Outcome.Grew
        }}
    />
</Module>
