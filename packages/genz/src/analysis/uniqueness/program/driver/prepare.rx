<Module>
    <Type from="model" as="Driver" />
    <Type from="effect" as="Effect" />

    <Args in={Driver.Input} out={bool} />

    <Store from="execution" as="driver" />

    <Call
        fn="submit"
        in={{
            step: Effect.Step.PrepareStorage
        }}
        setter={[$store.driver.exchange]}
    />

    <If on={$in.persistent}>
        <Call
            fn="submit"
            in={{
                step: Effect.Step.PrepareIdentities
            }}
            setter={[$store.driver.exchange]}
        />

        <If on={$in.recording}>
            <Call
                fn="submit"
                in={{
                    step: Effect.Step.PrepareReplay
                }}
                setter={[$store.driver.exchange]}
            />

            <Call fn="read" in={$store.driver.exchange} />

            <Return value={$ctx.read.available} />
        </If>
    </If>

    <Return value={false} />
</Module>
