<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Input} out={bool} />

    <Call fn="index.prepareOwnershipStorage" in={$in.frame} />

    <If on={$in.persistent}>
        <Call fn="index.prepareOwnershipIdentities" in={$in.frame} />

        <If on={$in.recording}>
            <Call fn="index.prepareOwnershipReplay" in={$in.frame} />

            <Return value={$ctx.prepareOwnershipReplay} />
        </If>
    </If>

    <Return value={false} />
</Module>
