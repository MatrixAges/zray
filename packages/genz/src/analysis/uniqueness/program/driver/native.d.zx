export type Execution = mutable_opaque

export type FlowExecution = mutable_opaque

export type FlowQueue = {
    first: u64[],
    items: u32[],
    indices: u32[],
    queued: u8[],
    count: u64
}

export type FlowLayers = {
    order: u32[],
    ends: u64[]
}

export enum RoundKind {
    Settle,
    Demand,
    Plan
}

export enum RoundOutcome {
    Stable,
    Grew,
    Exhausted
}

export type RoundClaim = {
    body?: u64,
    grew: bool,
    exhausted: bool
}

export enum ReplayPhase {
    Start,
    Settled,
    Demanded,
    Planned,
    Done,
    Reject
}

export declare function prepareOwnershipStorage(in: Execution): void
    throws { OutOfMemory }

export declare function prepareOwnershipIdentities(in: Execution): void
    throws { OutOfMemory }

export declare function prepareOwnershipReplay(in: Execution): bool
    throws { OutOfMemory }

export declare function prepareOwnershipBodies(in: Execution): void
    throws { OutOfMemory }

export declare function prepareOwnershipWorkers(in: Execution): void
    throws { OutOfMemory }

export declare function prepareOwnershipQueue(in: Execution): void
    throws { OutOfMemory }

export declare function bindOwnershipMemoRows(in: Execution): void

export declare function beginOwnershipRound(
    in: Execution,
    kind: RoundKind,
    exhausted: bool
): void throws { OutOfMemory }

export declare function claimOwnershipBody(
    in: Execution,
    kind: RoundKind
): RoundClaim throws { OutOfMemory }

export declare function visitOwnershipBody(
    in: Execution,
    kind: RoundKind,
    body: u64
): void throws { OutOfMemory }

export declare function finishOwnershipRound(in: Execution, publish: bool): void

export declare function scanOwnershipReplay(
    in: Execution,
    phase: ReplayPhase,
    recovered: u32?
): ReplayPhase throws { OutOfMemory }

export declare function recoverOwnershipVisit(
    in: Execution,
    phase: ReplayPhase
): u32 throws { OutOfMemory }

export declare function publishOwnershipReplay(in: Execution): void throws { OutOfMemory }

export declare function finishOwnershipReplay(in: Execution): void

export declare function initializeFlow(flow: FlowExecution): void throws { OutOfMemory }

export declare function planFlow(flow: FlowExecution): FlowLayers? throws { OutOfMemory }

export declare function reserveFlowMemo(flow: FlowExecution): void throws { OutOfMemory }

export declare function openFlowWorkers(flow: FlowExecution): bool[] throws { OutOfMemory }

export declare function solveFlowLayer(
    flow: FlowExecution,
    first: u64,
    end: u64
): void throws { OutOfMemory }

export declare function keepFlowMemo(flow: FlowExecution, row: u64): void

export declare function publishFlowMemo(flow: FlowExecution, row: u64): void
    throws { OutOfMemory }

export declare function openRecursiveFlow(flow: FlowExecution): FlowQueue
    throws { OutOfMemory }

export declare function retainFlowFacts(flow: FlowExecution, index: u32): void
    throws { OutOfMemory }

export declare function visitRecursiveFlow(
    flow: FlowExecution,
    index: u32,
    retained: bool
): bool throws { OutOfMemory }
