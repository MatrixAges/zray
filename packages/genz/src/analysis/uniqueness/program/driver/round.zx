import host from "ownership_host"
import { RoundKind, RoundOutcome } from "ownership_host"

import type { Round as Input } from "./model"

export type Output = RoundOutcome

export default function (in: Input): Output {
    const { frame, kind, exhausted } = in

    host.beginOwnershipRound(frame, kind, exhausted)

    const stopped = loop({
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const body = host.claimOwnershipBody(frame, kind)

            if (body != null) {
                host.visitOwnershipBody(frame, kind, body)
            }

            state.done = body == null
        },
        return: state => state.done
    })

    const outcome = host.ownershipRoundOutcome(frame)

    host.finishOwnershipRound(
        frame,
        kind == RoundKind.Plan && outcome != RoundOutcome.Exhausted
    )

    return outcome
}
