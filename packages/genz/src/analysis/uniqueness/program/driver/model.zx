import type { Execution, RoundKind, RoundOutcome } from "ownership_host"

export type Kind = RoundKind

export type Input = {
    frame: Execution,
    persistent: bool,
    recording: bool
}

export type Round = {
    frame: Execution,
    kind: Kind,
    exhausted: bool
}

export type Outcome = RoundOutcome

export type Convergence = {
    frame: Execution,
    running: bool
}
