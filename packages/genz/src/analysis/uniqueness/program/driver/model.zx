import type { Kind } from "./effect"

export enum Outcome {
    Stable,
    Grew,
    Exhausted
}

export type Input = {
    persistent: bool,
    recording: bool
}

export type Round = {
    kind: Kind,
    exhausted: bool
}

export type Cursor = {
    kind: Kind,
    outcome: Outcome,
    running: bool
}

export type Convergence = {
    running: bool
}
