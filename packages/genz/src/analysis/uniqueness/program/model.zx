import type { Allocator, ArenaScope } from "memory"
import type { Create, Layout } from "../summaries/model"
import type { Bodies, Calls, Input as Graph } from "../topology/model"
import type { Buffers } from "../work/allocate"

export type Arenas = {
    scope: ArenaScope,
    temporary: Allocator,
    summaries: Allocator
}

export type Prepare = Create.Omit("allocator") & {
    bodies: Bodies,
    arenas: Arenas
}

export type Prepared = {
    topology: Calls,
    layout: Layout
}

export type Open = Graph & {
    queue: Buffers
}

export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}
