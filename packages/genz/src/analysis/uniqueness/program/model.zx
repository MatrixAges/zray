import type { Cells, Create } from "../summaries/model"
import type { Bodies, Calls, Input as Graph } from "../topology/model"
import type { Buffers } from "../work/allocate"

export type Prepare = Create & {
    bodies: Bodies
}

export type Prepared = {
    topology: Calls,
    cells: Cells
}

export type Open = Graph & {
    queue: Buffers
}

export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}
