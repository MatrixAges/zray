import type { Cells, Create } from "../summaries/model"
import type { Bodies, Calls, Plan } from "../topology/model"

export type Prepare = Create & {
    bodies: Bodies
}

export type Prepared = {
    topology: Calls,
    cells: Cells
}

export type Open = Plan & {
    queue_count: u64
}

export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}
