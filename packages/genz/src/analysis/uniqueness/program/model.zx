import type { Allocator, ArenaScope } from "memory"
import type { Cells, Create } from "../summaries/model"
import type { Bodies, Calls } from "../topology/model"

export type Arenas = {
    scope: ArenaScope,
    temporary: Allocator,
    summaries: Allocator
}

export type Prepare = Create & {
    bodies: Bodies,
    arenas: Arenas
}

export type Prepared = {
    topology: Calls,
    storage: Cells
}

export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}

export enum Step {
    Start,
    Replay,
    Open,
    Settle,
    Demand,
    ConservativeDemand,
    Plan,
    Release,
    Commit,
    Done
}

export type Input = {
    step: Step,
    following: bool,
    reused: bool,
    grew: bool,
    exhausted: bool,
    recording: bool
}
