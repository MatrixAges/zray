export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}

export enum Step {
    Start,
    Replay,
    Open,
    Settle,
    Demand,
    ConservativeDemand,
    Plan,
    Release,
    Commit,
    Done
}

export type Input = {
    step: Step,
    following: bool,
    reused: bool,
    grew: bool,
    exhausted: bool,
    recording: bool
}
