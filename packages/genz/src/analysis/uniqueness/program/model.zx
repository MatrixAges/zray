import type { Allocator, ArenaScope } from "memory"
import type { Cells, Create } from "../summaries/model"
import type { Bodies, Calls, Input as Graph } from "../topology/model"
import type { Buffers } from "../work/allocate"

export type Arenas = {
    scope: ArenaScope,
    temporary: Allocator,
    summaries: Allocator
}

export type Prepare = Create & {
    bodies: Bodies,
    arenas: Arenas
}

export type Prepared = {
    topology: Calls,
    storage: Cells
}

export type Open = Graph & {
    queue: Buffers
}

export enum Phase {
    Start,
    Replay,
    Settle,
    Demand,
    Plan,
    Commit,
    Done
}

export enum Step {
    Start,
    Replay,
    Open,
    Settle,
    Demand,
    ConservativeDemand,
    Plan,
    Release,
    ReleaseReused,
    Commit,
    Done
}

export type Input = {
    step: Step,
    condition: bool
}
