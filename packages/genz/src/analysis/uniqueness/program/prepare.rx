<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Prepare} out={Program.Prepared} />

    <Call module="../topology/collect" in={$in.bodies} />

    <Call
        fn="allocators.selectAllocator"
        in={[
            $in.arenas.scope,
            $in.arenas.summaries
        ]}
    />

    <Call
        module="../summaries/create"
        in={$in.omit([
            "bodies",
            "arenas"
        ])}
    />

    <Call
        fn="allocators.selectAllocator"
        in={[
            $in.arenas.scope,
            $in.arenas.temporary
        ]}
    />

    <Return
        value={{
            topology: $ctx.collect,
            storage: $ctx.create
        }}
    />
</Module>
