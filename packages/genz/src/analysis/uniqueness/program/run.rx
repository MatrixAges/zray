<Module>
    <Type from="driver/model" as="Driver" />
    <Type from="driver/effect" as="Effect" />

    <Args in={Driver.Input} out={bool} />

    <Store from="driver/execution" as="driver" />

    <Call module="driver/prepare" in={$in} />

    <Call
        fn="driver/submit"
        in={{
            step: Effect.Step.PrepareBodies
        }}
        setter={[$store.driver.exchange]}
    />

    <Call module="../replay/shortcut/attempt" in={$ctx.prepare} />

    <If on={!$ctx.attempt}>
        <Call
            fn="driver/submit"
            in={{
                step: Effect.Step.PrepareWorkers
            }}
            setter={[$store.driver.exchange]}
        />

        <Call
            fn="driver/submit"
            in={{
                step: Effect.Step.PrepareQueue
            }}
            setter={[$store.driver.exchange]}
        />

        <Call
            fn="driver/submit"
            in={{
                step: Effect.Step.BindMemoRows
            }}
            setter={[$store.driver.exchange]}
        />

        <Call
            module="driver/convergence"
            in={{
                running: true
            }}
        />

        <Call
            module="driver/round"
            in={{
                kind: Effect.Kind.Plan,
                exhausted: false
            }}
        />
    </If>

    <Call
        fn="driver/finish"
        in={{
            recording: $in.persistent && $in.recording,
            reused: $ctx.attempt
        }}
    />

    <Return value={$ctx.finish} />
</Module>
