<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Input} out={Program.Step} />

    <If
        on={$in.step == Program.Step.Demand ||
            $in.step == Program.Step.ConservativeDemand}
    >
        <If on={$in.condition}>
            <Return value={Program.Step.Settle} />
        </If>

        <Return value={Program.Step.Plan} />
    </If>

    <Switch on={$in.step}>
        <Case value={Program.Step.Start}>
            <If on={$in.condition}>
                <Return value={Program.Step.Replay} />
            </If>

            <Return value={Program.Step.Open} />
        </Case>

        <Case value={Program.Step.Replay}>
            <If on={$in.condition}>
                <Return value={Program.Step.ReleaseReused} />
            </If>

            <Return value={Program.Step.Open} />
        </Case>

        <Case value={Program.Step.Open}>
            <Return value={Program.Step.Settle} />
        </Case>

        <Case value={Program.Step.Settle}>
            <If on={$in.condition}>
                <Return value={Program.Step.ConservativeDemand} />
            </If>

            <Return value={Program.Step.Demand} />
        </Case>

        <Case value={Program.Step.Plan}>
            <Return value={Program.Step.Release} />
        </Case>

        <Case value={Program.Step.Release}>
            <If on={$in.condition}>
                <Return value={Program.Step.Commit} />
            </If>
        </Case>
    </Switch>

    <Return value={Program.Step.Done} />
</Module>
