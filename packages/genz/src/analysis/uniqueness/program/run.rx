<Module>
    <Type from="driver/model" as="Driver" />

    <Args in={Driver.Input} out={void} />

    <Call fn="../replay/shortcut/attempt" in={$in.frame} />

    <If on={!$ctx.attempt}>
        <Call fn="driver/converge" in={$in.frame} />

        <Call
            fn="driver/round"
            in={{
                frame: $in.frame,
                kind: Driver.Kind.Plan,
                exhausted: false
            }}
        />
    </If>

    <Call
        fn="driver/finish"
        in={{
            ...$in,
            reused: $ctx.attempt
        }}
    />
</Module>
