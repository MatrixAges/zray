<Module>
    <Type from="model" as="Program" />

    <Args in={Program.Input} out={Program.Phase} />

    <Switch on={$in.phase}>
        <Case value={Program.Phase.Start}>
            <If on={$in.following}>
                <Return value={Program.Phase.Replay} />
            </If>

            <Return value={Program.Phase.Settle} />
        </Case>

        <Case value={Program.Phase.Replay}>
            <If on={$in.reused}>
                <Return value={Program.Phase.Done} />
            </If>

            <Return value={Program.Phase.Settle} />
        </Case>

        <Case value={Program.Phase.Settle}>
            <Return value={Program.Phase.Demand} />
        </Case>

        <Case value={Program.Phase.Demand}>
            <If on={$in.grew}>
                <Return value={Program.Phase.Settle} />
            </If>

            <Return value={Program.Phase.Plan} />
        </Case>

        <Case value={Program.Phase.Plan}>
            <If on={$in.recording}>
                <Return value={Program.Phase.Commit} />
            </If>
        </Case>
    </Switch>

    <Return value={Program.Phase.Done} />
</Module>
