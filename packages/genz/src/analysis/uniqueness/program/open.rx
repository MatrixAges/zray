<Module>
    <Type from="model" as="Program" />
    <Type from="../topology/model" as="Graph" />

    <Args in={Graph.Input} out={Program.Open} />

    <Call module="../topology/build" in={$in} />

    <Return
        value={{
            ...$ctx.build,
            queue_count: $in.callees.length
        }}
    />
</Module>
