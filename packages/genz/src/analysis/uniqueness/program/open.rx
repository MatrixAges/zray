<Module>
    <Type from="model" as="Program" />
    <Type from="../topology/model" as="Graph" />

    <Args in={Program.Open} out={Graph.Plan} />

    <Call module="../topology/build" in={$in.omit(["queue"])} />

    <Call
        fn="../work/allocate"
        in={{
            ...$in.queue,
            count: $in.callees.length
        }}
    />

    <Return value={$ctx.build} />
</Module>
