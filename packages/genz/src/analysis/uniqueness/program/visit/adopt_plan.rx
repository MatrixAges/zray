<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.PlanAdoption} out={Visit.PlanAdopted} />

    <Call module="../../retain/plan" in={$in.source} />

    <If on={$in.memo != null}>
        <Call
            module="../../memo/record/write"
            in={{
                target: $in.memo,
                result: {
                    levels: [],
                    changed: [],
                    grew: false,
                    plan: $ctx.plan
                }
            }}
        />

        <Return
            value={{
                plan: $ctx.plan,
                row: $ctx.write
            }}
        />
    </If>

    <Return
        value={{
            plan: $ctx.plan,
            row: null
        }}
    />
</Module>
