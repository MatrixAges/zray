<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.PlanAdoption} out={Visit.PlanAdopted} />

    <Call module="../../retain/plan" in={$in.source} />

    <If on={$in.memo != null}>
        <Call module="../../memo/table/store" in={$in.memo} />

        <Return
            value={{
                plan: $ctx.plan,
                row: $ctx.store
            }}
        />
    </If>

    <Return
        value={{
            plan: $ctx.plan,
            row: null
        }}
    />
</Module>
