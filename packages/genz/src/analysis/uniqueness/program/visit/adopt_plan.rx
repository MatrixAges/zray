<Module>
    <Type from="model" as="Visit" />
    <Type from="../../replay/ordered/model" as="Record" />

    <Args in={Visit.PlanAdoption} out={Record.Planned} />

    <Call module="../../retain/plan" in={$in.source} />

    <If on={$in.memo != null}>
        <Call
            module="../../memo/record/write"
            in={{
                target: $in.memo,
                result: {
                    levels: [],
                    changed: [],
                    grew: false,
                    plan: $ctx.plan
                }
            }}
        />
    </If>

    <Return value={$ctx.plan} />
</Module>
