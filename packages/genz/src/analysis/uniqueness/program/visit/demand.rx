<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.Demand} out={u64[]} />

    <If on={$in.origin == Visit.Origin.Ahead}>
        <Call fn="growth" in={$in.growth} />
    </If>

    <Call
        fn="../../function/updates/marks"
        in={$in.pick([
            "inputs",
            "outputs",
            "marks"
        ])}
    />

    <If on={$in.origin == Visit.Origin.Cached}>
        <Call fn="growth" in={$in.growth} />
    </If>

    <If on={$in.save != null}>
        <Call fn="../../retain/rows" in={$in.save.marks} />

        <Call
            module="../../memo/record/write"
            in={{
                target: $in.save.memo,
                result: {
                    levels: [],
                    changed: $ctx.marks,
                    grew: $in.save.grew,
                    plan: null
                }
            }}
        />
    </If>

    <Return value={$ctx.marks} />
</Module>
