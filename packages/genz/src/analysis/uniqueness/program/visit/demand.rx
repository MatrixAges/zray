<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.Demand} out={Visit.AdoptedDemand} />

    <Call
        fn="../../function/updates/marks"
        in={$in.pick([
            "inputs",
            "outputs",
            "marks"
        ])}
    />

    <If on={$in.save != null}>
        <Call fn="../../retain/rows" in={$in.save.marks} />

        <Call module="../../memo/table/store" in={$in.save.memo} />

        <Return
            value={{
                ...$ctx.marks,
                marks: $ctx.rows,
                retain_growth: $in.origin == Visit.Origin.Ahead && $in.grew,
                install_growth: $in.origin != Visit.Origin.Analyze
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.marks,
            marks: null,
            retain_growth: $in.origin == Visit.Origin.Ahead && $in.grew,
            install_growth: $in.origin != Visit.Origin.Analyze
        }}
    />
</Module>
