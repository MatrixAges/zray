import memory from "memory"

import retain from "../../function/result/retain"

import type { SettlementRetention as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    memory.selectAllocator(in.scope, in.owner)

    const levels = retain(in.omit([
        "scope",
        "owner",
        "scratch"
    ]))

    memory.selectAllocator(in.scope, in.scratch)

    return levels
}
