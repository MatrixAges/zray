<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.Settlement} out={Visit.AdoptedSettlement} />

    <If on={$in.save != null}>
        <Call fn="../../function/result/retain" in={$in.save.retain} />

        <Call module="../../memo/table/store" in={$in.save.memo} />

        <Call
            fn="../../function/updates/contributions"
            in={$in.omit(["save"])}
        />

        <Return
            value={{
                ...$ctx.contributions,
                retained: $ctx.retain
            }}
        />
    </If>

    <Call
        fn="../../function/updates/contributions"
        in={$in.omit(["save"])}
    />

    <Return
        value={{
            ...$ctx.contributions,
            retained: null
        }}
    />
</Module>
