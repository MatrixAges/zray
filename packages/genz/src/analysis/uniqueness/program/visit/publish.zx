import memory from "memory"

import type { Plan as Input } from "../../work/round/model"

export type Output = void

export default function (in: Input): Output {
    if (in.body == in.count) {
        memory.copyColumnValue(in.entry, 0, in.fields)
    } else {
        memory.copyColumnValue(in.plans, in.body, in.fields)
    }
}
