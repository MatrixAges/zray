import memory from "memory"
import columns from "memory/columns"

import retain from "../../retain/rows"

import type { Growth as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { snapshot } = in

    if (snapshot == null || !snapshot.grew) {
        memory.copyColumnValue(in.target, 0, in.rows)

        return
    }

    retain(snapshot.rows.normalized)
    retain(snapshot.rows.renewed)

    columns.writeRowList(snapshot.normalized, 0, snapshot.rows.normalized.target)
    columns.writeRowList(snapshot.renewed, 0, snapshot.rows.renewed.target)
}
