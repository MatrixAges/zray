import memory from "memory"

import probe from "../../../memo/encoding/body/probe.rx"

import type { Cache, Found as Output } from "./model"

export type Input = Cache.Omit("history") & {
    following: bool
}

export default function (in: Input): Output {
    const { memo, scope, owner, temporary, following } = in

    if (memo == null) {
        return {
            trace_row: null,
            memo_row: null,
            following,
            state_end: in.state_end
        }
    }

    memory.selectAllocator(scope, owner)

    const found = probe(memo)

    memory.selectAllocator(scope, temporary)

    return {
        trace_row: null,
        memo_row: found.row,
        following,
        state_end: found.state.state_end
    }
}
