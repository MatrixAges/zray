import type { AtomicRows, ListColumn } from "memory"
import type { Probe } from "../../../memo/encoding/body/model"
import type { Step } from "../../../replay/model"
import type { Origin } from "../model"

export type Reads = {
    tables: AtomicRows[],
    kinds: ListColumn,
    functions: ListColumn,
    slots: ListColumn,
    values: ListColumn
}

export type Cache = {
    memo?: Probe,
    history?: Step,
    state_end: u64
}

export type ProbeInput = Cache.Omit("history") & {
    following: bool
}

export type Found = {
    trace_row?: u64,
    memo_row?: u32,
    following: bool,
    state_end: u64
}

export type Input = Cache & {
    ahead_ready: bool,
    ahead_reads?: Reads
}

export type Output = Found & {
    origin: Origin
}
