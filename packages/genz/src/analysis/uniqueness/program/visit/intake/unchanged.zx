import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import decode from "../../../function/levels/decode"

import type { Reads as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const count = memory.listLength(in.kinds, 0)

    return loop({
        index: 0,
        same: true
    }, {
        while: state => state.same && state.index < count,
        next: state => {
            const { index } = state
            const kind = integers.widenByte(memory.readListU8(in.kinds, 0, index))
            const body = integers.widen(memory.readListU32(in.functions, 0, index))
            const slot = integers.widen(memory.readListU32(in.slots, 0, index))
            const current = bytes.loadAtomicCell(in.tables[kind], body, slot)

            state.same =
                decode(current) == decode(memory.readListU8(in.values, 0, index))
            state.index += 1
        },
        return: state => state.same
    })
}
