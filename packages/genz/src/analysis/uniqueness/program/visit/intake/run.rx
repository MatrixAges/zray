<Module>
    <Type from="model" as="Intake" />

    <Args in={Intake.Input} out={Intake.Output} />

    <Call
        fn="clear"
        in={$in.pick([
            "scratch",
            "reset"
        ])}
    />

    <Call
        module="cache"
        in={$in.omit([
            "ahead_ready",
            "ahead_reads",
            "scratch",
            "reset"
        ])}
    />

    <If on={$in.ahead_ready && $in.ahead_reads != null}>
        <Call fn="unchanged" in={$in.ahead_reads} />

        <Call
            fn="complete"
            in={{
                ...$ctx.cache,
                ahead: $ctx.unchanged,
                scratch: $in.scratch,
                reset: $in.reset
            }}
        />

        <Return value={$ctx.complete} />
    </If>

    <Call
        fn="complete"
        in={{
            ...$ctx.cache,
            ahead: $in.ahead_ready,
            scratch: $in.scratch,
            reset: $in.reset
        }}
    />

    <Return value={$ctx.complete} />
</Module>
