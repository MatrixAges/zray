<Module>
    <Type from="model" as="Intake" />

    <Args in={Intake.ProbeInput} out={Intake.Found} />

    <If on={$in.memo != null}>
        <Call module="../../../memo/encoding/body/probe" in={$in.memo} />

        <Return
            value={{
                trace_row: null,
                next: null,
                memo_row: $ctx.probe.row,
                following: $in.following,
                encoded: $ctx.probe.state,
                digest: $ctx.probe.digest
            }}
        />
    </If>

    <Return
        value={{
            trace_row: null,
            next: null,
            memo_row: null,
            following: $in.following,
            encoded: null,
            digest: null
        }}
    />
</Module>
