<Module>
    <Type from="model" as="Intake" />

    <Args in={Intake.ProbeInput} out={Intake.Found} />

    <If on={$in.memo != null}>
        <Call module="../../../memo/encoding/body/probe" in={$in.memo} />

        <Return
            value={{
                trace_row: null,
                memo_row: $ctx.probe.row,
                following: $in.following,
                state_end: $ctx.probe.state.state_end
            }}
        />
    </If>

    <Return
        value={{
            trace_row: null,
            memo_row: null,
            following: $in.following,
            state_end: $in.state_end
        }}
    />
</Module>
