import choose from "../select"

import type { Found, Output } from "./model"

export type Input = Found & {
    ahead: bool
}

export default function (in: Input): Output {
    return {
        ...in.omit(["ahead"]),
        origin: choose({
            cached: in.trace_row != null || in.memo_row != null,
            ahead: in.ahead
        })
    }
}
