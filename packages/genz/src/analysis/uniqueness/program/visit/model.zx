import type { WriteColumn } from "memory"
import type { Input as Marks } from "../../function/updates/marks"

export enum Origin {
    Cached,
    Ahead,
    Analyze
}

export type Available = {
    cached: bool,
    ahead: bool
}

export type Growth = {
    target: WriteColumn,
    rows: u8[]
}

export type Demand = Marks & {
    origin: Origin,
    growth: Growth
}

export type Plan = {
    plans: WriteColumn,
    entry: WriteColumn,
    count: u64,
    body: u64,
    fields: u8[]
}
