import type { SettlementRecord } from "../../function/result/model"
import type { Input as RetainSettlement } from "../../function/result/retain"
import type { Input as Contributions } from "../../function/updates/contributions"
import type { Input as Marks } from "../../function/updates/marks"
import type { Store as MemoTarget } from "../../memo/table/model"
import type { Planned } from "../../replay/ordered/model"
import type { Input as RetainRows } from "../../retain/rows"

export enum Origin {
    Cached,
    Ahead,
    Analyze
}

export type Available = {
    cached: bool,
    ahead: bool
}

export type Demand = Marks & {
    origin: Origin,
    grew: bool,
    save?: DemandSave
}

export type DemandSave = {
    memo: MemoTarget,
    marks: RetainRows
}

export type AdoptedDemand = {
    changed: u64[],
    marks?: u8[],
    retain_growth: bool,
    install_growth: bool
}

export type Settlement = Contributions & {
    save?: SettlementSave
}

export type AdoptedSettlement = {
    changed: u64[],
    retained?: SettlementRecord
}

export type SettlementSave = {
    memo: MemoTarget,
    retain: RetainSettlement
}

export type PlanAdoption = {
    source: Planned,
    memo?: MemoTarget
}

export type PlanAdopted = {
    plan: Planned,
    row?: u64
}
