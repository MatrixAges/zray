import type { WriteColumn } from "memory"
import type { WriteColumn as Column } from "memory/columns"
import type { Input as Marks } from "../../function/updates/marks"
import type { Growth as GrowthRetention } from "../../retain/model"
import type { Phase } from "../model"

export enum Origin {
    Cached,
    Ahead,
    Analyze
}

export type Available = {
    cached: bool,
    ahead: bool
}

export enum Step {
    Recall,
    ReadMemoOnMiss,
    TakeAhead,
    UseCached,
    AdoptAhead,
    ResetScratch,
    Analyze,
    Apply,
    SaveBorrowed,
    SaveOwned,
    RecordTrace,
    RetainOutput
}

export type Request = {
    phase: Phase,
    origin?: Origin,
    persistent: bool
}

export type PlanRequest = Request.Omit("phase")

export type Growth = {
    target: WriteColumn,
    rows: u8[],
    snapshot?: GrowthSnapshot
}

export type GrowthSnapshot = {
    grew: bool,
    rows: GrowthRetention,
    normalized: Column,
    renewed: Column
}

export type Demand = Marks & {
    origin: Origin,
    growth: Growth
}
