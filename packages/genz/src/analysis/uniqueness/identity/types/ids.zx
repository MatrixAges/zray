import bytes from "std:bytes"
import integers from "std:integer"

import type { Ids as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { words } = loop(
        {
            index: start_index,
            words: [
                in.count
            ]
        },
        {
            while: state => state.index < in.count,
            next: state => {
                state.words = state.words.push(
                    integers.widen(
                        in.values[in.first + state.index]
                    )
                )[0]
                state.index += 1
            }
        }
    )

    return bytes.encodeU64sLe(words)
}
