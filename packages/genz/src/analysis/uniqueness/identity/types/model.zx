import type { Table } from "core/type_table/model"

export type Input = {
    types: Table
}

export type Row = {
    types: Table,
    index: u64
}

export type Ids = {
    values: u32[],
    first: u64,
    count: u64
}

export type Names = {
    values: string[],
    first: u64,
    count: u64
}

export type Parts = {
    seed: u8[],
    walk: u8[]
}
