import bytes from "std:bytes"
import integers from "std:integer"

import ids from "./ids"
import names from "./names"

import type { Row as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const first = integers.widen(in.types.first[in.index])
    const count = integers.widen(in.types.second[in.index])

    return bytes.join(
        bytes.fromText(""),
        [
            names({
                values: in.types.field_names,
                first,
                count
            }),
            ids({
                values: in.types.field_types,
                first,
                count
            }),
            bytes.encodeU64Le(count)
        ]
    )
}
