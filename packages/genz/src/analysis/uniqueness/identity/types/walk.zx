import bytes from "std:bytes"

import row from "./row"

import type { Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0
    const empty: u8[][] = []

    const { parts } = loop(
        {
            index: start_index,
            parts: empty
        },
        {
            while: state => state.index < in.types.kinds.length,
            next: state => {
                state.parts = state.parts.push(
                    row({
                        ...in,
                        index: state.index
                    })
                )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
