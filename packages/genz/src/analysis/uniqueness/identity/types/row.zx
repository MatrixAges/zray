import bytes from "std:bytes"
import integers from "std:integer"
import kind from "core/type_table/kind"
import { Kind } from "core/type_table/model"

import frame from "../bytes"
import fields from "./fields"
import ids from "./ids"
import names from "./names"
import tag from "./tag"

import type { Row as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const target = kind(in.types.kinds[in.index])
    const first = integers.widen(in.types.first[in.index])
    const second = integers.widen(in.types.second[in.index])
    const header = frame(bytes.fromText(tag(target)))

    if (target == Kind.Object) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                fields(in)
            ]
        )
    }

    if (target == Kind.Tuple) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                ids({
                    values: in.types.children,
                    first,
                    count: second
                }),
                bytes.encodeU64Le(second)
            ]
        )
    }

    if (target == Kind.Task) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                bytes.encodeU64sLe([
                    first,
                    second
                ])
            ]
        )
    }

    if (target == Kind.NativeReference) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                frame(bytes.fromText(in.types.labels[in.index])),
                bytes.encodeU64Le(first)
            ]
        )
    }

    if (target == Kind.Enumeration) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                frame(bytes.fromText(in.types.labels[in.index])),
                names({
                    values: in.types.names,
                    first,
                    count: second
                })
            ]
        )
    }

    if (target == Kind.ErrorSet) {
        return bytes.join(
            bytes.fromText(""),
            [
                header,
                names({
                    values: in.types.names,
                    first,
                    count: second
                })
            ]
        )
    }

    return bytes.join(
        bytes.fromText(""),
        [
            header,
            bytes.encodeU64Le(first)
        ]
    )
}
