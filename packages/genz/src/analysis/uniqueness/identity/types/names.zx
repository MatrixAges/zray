import bytes from "std:bytes"

import frame from "../bytes"

import type { Names as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(in.count)
            ]
        },
        {
            while: state => state.index < in.count,
            next: state => {
                state.parts = state.parts.push(
                    frame(
                        bytes.fromText(
                            in.values[in.first + state.index]
                        )
                    )
                )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
