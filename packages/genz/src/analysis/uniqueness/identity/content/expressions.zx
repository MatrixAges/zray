import bytes from "std:bytes"

import expression from "./expression"

import type { Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(in.expressions.kinds.length)
            ]
        },
        {
            while: state => state.index < in.expressions.kinds.length,
            next: state => {
                state.parts = state.parts.push(
                    expression({
                        content: in,
                        index: state.index
                    })
                )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
