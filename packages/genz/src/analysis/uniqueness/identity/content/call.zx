import bytes from "std:bytes"
import integers from "std:integer"
import words from "core/ir/fingerprint/words"
import memory from "memory"

import type { Call as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { expressions, payload } = in

    return bytes.join(
        bytes.fromText(""),
        [
            bytes.encodeU64sLe([
                integers.widen(
                    expressions.call_functions[payload]
                ),
                integers.widen(expressions.call_arguments[payload])
            ]),
            words(
                memory.borrowU32Range(
                    expressions.call_stores,
                    integers.widen(expressions.call_store_first[payload]),
                    integers.widen(expressions.call_store_count[payload])
                )
            )
        ]
    )
}
