import bytes from "std:bytes"
import integers from "std:integer"
import words from "core/ir/fingerprint/words"
import memory from "memory"

import type { Call as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { out, expressions, payload } = in

    bytes.writeU64Le(out, integers.widen(expressions.call_functions[payload]))
    bytes.writeU64Le(out, integers.widen(expressions.call_arguments[payload]))

    words({
        out,
        values: memory.borrowU32Range(
            expressions.call_stores,
            integers.widen(expressions.call_store_first[payload]),
            integers.widen(expressions.call_store_count[payload])
        )
    })
}
