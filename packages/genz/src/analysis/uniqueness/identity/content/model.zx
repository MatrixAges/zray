import type { Control } from "core/control_table/model"
import type { Expressions } from "core/expression_table/model"
import type { Symbols } from "core/symbol_table/model"

export type Input = {
    symbols: Symbols,
    expressions: Expressions,
    control: Control,
    first: u64,
    count: u64,
    input_type: u32,
    output_type: u32
}

export type Call = {
    expressions: Expressions,
    payload: u64
}

export type Parts = {
    symbols: u8[],
    expressions: u8[],
    block: u8[],
    signature: u8[]
}
