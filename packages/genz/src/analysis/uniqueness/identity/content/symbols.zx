import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"
import { Ownership } from "core/symbol_table/model"

import { copy_ownership, borrowed_ownership, owned_ownership } from "./const"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    bytes.writeU64Le(in.out, in.symbols.names.length)

    const result = loop({
        index: 0
    }, {
        while: state => state.index < in.symbols.names.length,
        next: state => {
            text({
                out: in.out,
                text: in.symbols.names[state.index]
            })

            bytes.writeU64Le(
                in.out,
                integers.widen(in.symbols.types[state.index])
            )

            const ownership = match in.symbols.ownership[state.index] {
                Ownership.Copy => copy_ownership,
                Ownership.Borrowed => borrowed_ownership,
                _ => owned_ownership
            }

            bytes.writeU64Le(in.out, ownership)

            state.index += 1
        }
    })
}
