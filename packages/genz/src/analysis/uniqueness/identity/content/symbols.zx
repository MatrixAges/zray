import bytes from "std:bytes"
import integers from "std:integer"
import text from "core/ir/fingerprint/text"
import { Ownership } from "core/symbol_table/model"

import { copy_ownership, borrowed_ownership, owned_ownership } from "./const"

import type { Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(in.symbols.names.length)
            ]
        },
        {
            while: state => state.index < in.symbols.names.length,
            next: state => {
                const ownership = match in.symbols.ownership[state.index] {
                    Ownership.Copy => copy_ownership,
                    Ownership.Borrowed => borrowed_ownership,
                    _ => owned_ownership
                }

                state.parts =
                    state.parts.push(text(in.symbols.names[state.index]))[0]
                state.parts = state.parts.push(
                    bytes.encodeU64sLe([
                        integers.widen(
                            in.symbols.types[state.index]
                        ),
                        ownership
                    ])
                )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
