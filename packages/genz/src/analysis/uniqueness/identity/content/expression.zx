import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import payloadBytes from "core/ir/fingerprint/payload"
import text from "core/ir/fingerprint/text"

import call from "./call"
import tag from "./tag"

import type { Input as Content } from "./model"

export type Input = {
    content: Content,
    index: u64
}

export type Output = void

export default function (in: Input): Output {
    const { out, expressions } = in.content

    const kind = expressions.kinds[in.index]
    const payload = integers.widen(expressions.payloads[in.index])

    bytes.writeU64Le(out, integers.widen(expressions.types[in.index]))

    text({
        out,
        text: tag(kind)
    })

    if (kind == ExpressionKind.Call) {
        call({
            out,
            expressions,
            payload
        })
    } else {
        payloadBytes({
            out,
            expressions,
            kind,
            payload
        })
    }
}
