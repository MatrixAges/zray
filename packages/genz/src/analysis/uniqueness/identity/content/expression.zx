import bytes from "std:bytes"
import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import payloadBytes from "core/ir/fingerprint/payload"
import text from "core/ir/fingerprint/text"

import call from "./call"
import tag from "./tag"

import type { Input as Content } from "./model"

export type Input = {
    content: Content,
    index: u64
}

export type Output = u8[]

export default function (in: Input): Output {
    const { expressions } = in.content

    const kind = expressions.kinds[in.index]
    const payload = integers.widen(expressions.payloads[in.index])

    const tail = match kind == ExpressionKind.Call {
        true => call({
            expressions,
            payload
        }),
        _ => payloadBytes({
            expressions,
            kind,
            payload
        })
    }

    return bytes.join(
        bytes.fromText(""),
        [
            bytes.encodeU64Le(integers.widen(expressions.types[in.index])),
            text(tag(kind)),
            tail
        ]
    )
}
