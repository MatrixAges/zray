<Module>
    <Type from="model" as="Identity" />

    <Args in={Identity.Input} out={u8[]} />

    <Call fn="symbols" in={$in} />
    <Call fn="expressions" in={$in} />

    <Call
        fn="block"
        in={{
            control: $in.control,
            first: $in.first,
            count: $in.count
        }}
    />

    <Call fn="signature" in={$in} />

    <Call
        fn="assemble"
        in={{
            symbols: $ctx.symbols,
            expressions: $ctx.expressions,
            block: $ctx.block,
            signature: $ctx.signature
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
