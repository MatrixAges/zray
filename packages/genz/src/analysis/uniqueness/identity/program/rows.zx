import bytes from "std:bytes"

import frame from "../bytes"

export type Input = u8[][]

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.encodeU64Le(in.length)
            ]
        },
        {
            while: state => state.index < in.length,
            next: state => {
                state.parts = state.parts.push(frame(in[state.index]))[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
