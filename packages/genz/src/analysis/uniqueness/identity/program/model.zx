export type Input = {
    types: u8[],
    input_types: u32[],
    output_types: u32[],
    native_modules: u32?[],
    held: u8[][],
    written: u8[][],
    return_only: u8[],
    return_allocations: u8[]
}

export type Assemble = {
    seed: u8[],
    signatures: u8[],
    held: u8[][],
    written: u8[][],
    return_only: u8[],
    return_allocations: u8[]
}
