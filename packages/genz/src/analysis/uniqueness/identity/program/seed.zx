import bytes from "std:bytes"

import frame from "../bytes"
import { identity_domain } from "./const"

import type { Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(
        bytes.fromText(""),
        [
            frame(bytes.fromText(identity_domain)),
            frame(in.types)
        ]
    )
}
