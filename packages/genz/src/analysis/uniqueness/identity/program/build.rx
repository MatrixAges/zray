<Module>
    <Type from="model" as="Identity" />

    <Args in={Identity.Input} out={u8[]} />

    <Call fn="seed" in={$in} />
    <Call fn="signatures" in={$in} />

    <Call
        fn="assemble"
        in={{
            seed: $ctx.seed,
            signatures: $ctx.signatures,
            held: $in.held,
            written: $in.written,
            return_only: $in.return_only,
            return_allocations: $in.return_allocations
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
