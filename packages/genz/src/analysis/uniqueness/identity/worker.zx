export enum IdentityRow {
    Zero,
    Content,
    Known,
    Body
}

export type Input = {
    contents: bool,
    native: bool,
    active: bool,
    known: bool
}

export type Output = IdentityRow

export default function (in: Input): Output {
    return match {
        in.contents && in.native => IdentityRow.Zero,
        in.contents => IdentityRow.Content,
        !in.active => IdentityRow.Zero,
        in.known => IdentityRow.Known,
        _ => IdentityRow.Body
    }
}
