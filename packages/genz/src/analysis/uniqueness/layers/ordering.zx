import integers from "std:integer"
import memory from "memory"

import includes from "./includes"

import type { Plan, Selection } from "./model"

export type Input = {
    depths: u32[],
    starts: u64[],
    selection: Selection
}

export type Output = Plan

export default function (in: Input): Output {
    const order: u32[] = in.depths.map(depth => 0)[0]
    const selection = in.selection

    const result = loop({
        depths: in.depths,
        ends: in.starts,
        order,
        index: 0
    }, {
        while: current => current.index < current.depths.length,
        next: current => {
            if (includes({
                ...selection,
                index: current.index
            })) {
                const depth = integers.widen(current.depths[current.index])
                const position = current.ends[depth]

                current.order[position] = integers.narrow(current.index)
                current.ends[depth] += 1
            }

            current.index += 1
        }
    })

    return {
        order:
            memory.borrowU32Range(
                result.order,
                0,
                result.ends[result.ends.length - 1]
            ),
        ends: result.ends
    }
}
