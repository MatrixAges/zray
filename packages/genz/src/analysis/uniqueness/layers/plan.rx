<Module>
    <Type from="model" as="Layers" />

    <Args in={Layers.Planning} out={Layers.Plan?} />

    <Call
        fn="depths"
        in={$in.pick([
            "expressions",
            "native_modules"
        ])}
    />

    <If on={!$ctx.depths.ordered}>
        <Return value={null} />
    </If>

    <Call
        fn="counts"
        in={{
            ...$ctx.depths.omit(["ordered"]),
            selection: $in.omit(["expressions"])
        }}
    />

    <Call fn="offsets" />

    <Call
        fn="ordering"
        in={{
            depths: $ctx.depths.values,
            starts: $ctx.offsets,
            selection: $in.omit(["expressions"])
        }}
    />

    <Call fn="nonempty" in={$ctx.ordering.ends} />

    <Return
        value={{
            order: $ctx.ordering.order,
            ends: $ctx.nonempty
        }}
    />
</Module>
