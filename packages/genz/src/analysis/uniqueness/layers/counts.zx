import integers from "std:integer"

import includes from "./includes"

import type { Depths, Selection } from "./model"

export type Input = Depths.Pick("values", "maximum") & {
    selection: Selection
}

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const initial = loop({
        values: empty,
        index: 0,
        maximum: integers.widen(in.maximum)
    }, {
        while: current => current.index <= current.maximum,
        next: current => {
            current.values = current.values.push(0)[0]
            current.index += 1
        }
    })

    const selection = in.selection

    return loop({
        depths: in.values,
        counts: initial.values,
        index: 0
    }, {
        while: current => current.index < current.depths.length,
        next: current => {
            if (includes({
                ...selection,
                index: current.index
            })) {
                const depth = integers.widen(current.depths[current.index])

                current.counts[depth] += 1
            }

            current.index += 1
        },
        return: state => state.counts
    })
}
