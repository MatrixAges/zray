import integers from "std:integer"

import type { Depths, Functions } from "./model"

export type Input =
    Depths.Pick("values", "maximum") & Functions.Pick("native_modules")

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const initial = loop({
        values: empty,
        index: 0,
        maximum: integers.widen(in.maximum)
    }, {
        while: current => current.index <= current.maximum,
        next: current => {
            current.values = current.values.push(0)[0]
            current.index += 1
        }
    })

    const native_modules = in.native_modules

    return loop({
        depths: in.values,
        counts: initial.values,
        index: 0
    }, {
        while: current => current.index < current.depths.length,
        next: current => {
            if (native_modules[current.index] == null) {
                const depth = integers.widen(current.depths[current.index])

                current.counts[depth] += 1
            }

            current.index += 1
        },
        return: state => state.counts
    })
}
