import memory from "memory"

import { Phase } from "../../program/model"
import { clear_flag } from "../const"

import type { Take as Input, Visit as Output } from "./model"

export default function (in: Input): Output {
    const { state } = in

    const cursor = state.cursor
    const head = cursor.head
    const count = cursor.count

    if (count == 0) {
        return {
            body: null,
            exhausted: false,
            first: [],
            second: [],
            grew: cursor.grew,
            prefetch: false,
            cursor
        }
    }

    const available = state.capacity - head
    const prefix = count < available ? count : available
    const index = in.slots[head]
    const next = head + 1
    const first = next == state.capacity ? 0 : next

    memory.writeU8(state.queued, index, clear_flag)

    const limited = in.phase == Phase.Settle
    const budget = cursor.budget
    const exhausted = limited && budget == 0
    const next_budget = limited && !exhausted ? budget - 1 : budget

    return {
        body: exhausted ? null : index,
        exhausted,
        first: memory.borrowU64Range(in.slots, head, prefix),
        second: memory.borrowU64Range(in.slots, 0, count - prefix),
        grew: false,
        prefetch: !exhausted && !in.following,
        cursor: {
            ...cursor,
            head: first,
            count: count - 1,
            budget: next_budget
        }
    }
}
