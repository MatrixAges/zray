import { Phase } from "../../program/model"

import type { Take as Input, Visit as Output } from "./model"

export default function (in: Input): Output {
    const { state, additions } = in
    const { cursor, capacity } = state

    const head = cursor.head
    const count = cursor.count + additions.length

    if (count == 0) {
        return {
            body: null,
            dequeued: null,
            exhausted: false,
            pending_start: head,
            pending_first: 0,
            pending_second: 0,
            grew: cursor.grew,
            prefetch: false,
            cursor
        }
    }

    const available = capacity - head
    const prefix = count < available ? count : available
    const index = cursor.count == 0 ? additions[0].body : in.slots[head]
    const next = head + 1
    const first = next == capacity ? 0 : next

    const limited = in.phase == Phase.Settle
    const budget = cursor.budget
    const exhausted = limited && budget == 0
    const next_budget = limited && !exhausted ? budget - 1 : budget

    return {
        body: exhausted ? null : index,
        dequeued: index,
        exhausted,
        pending_start: head,
        pending_first: prefix,
        pending_second: count - prefix,
        grew: false,
        prefetch: !exhausted && !in.following,
        cursor: {
            ...cursor,
            head: first,
            count: count - 1,
            budget: next_budget
        }
    }
}
