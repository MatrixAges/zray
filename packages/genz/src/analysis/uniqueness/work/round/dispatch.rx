<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Dispatch} out={Round.Dispatched} />

    <If on={$in.round != null}>
        <Call module="advance" in={$in.round} />

        <If
            on={$ctx.advance.prefetch &&
                $in.prefetch.window.workers != 0 &&
                $ctx.advance.first.length != 0}
        >
            <Call
                module="../ahead/request/offer"
                in={{
                    ...$in.prefetch,
                    window: {
                        ...$in.prefetch.window,
                        indices: $ctx.advance.first,
                        wrapped: $ctx.advance.second
                    }
                }}
            />

            <Return
                value={{
                    claim: $ctx.advance,
                    offered: $ctx.offer
                }}
            />
        </If>

        <Return
            value={{
                claim: $ctx.advance,
                offered: null
            }}
        />
    </If>

    <Call module="../ahead/request/offer" in={$in.prefetch} />

    <Return
        value={{
            claim: null,
            offered: $ctx.offer
        }}
    />
</Module>
