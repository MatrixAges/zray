<Module>
    <Type from="model" as="Round" />
    <Type from="../../program/model" as="Program" />

    <Args in={Round.PhaseFeedback} out={Round.Actions} />

    <If on={$in.phase == Program.Phase.Settle}>
        <Call
            module="publish"
            in={{
                ...$in.pick([
                    "active",
                    "outputs",
                    "callers"
                ]),
                ...$in.previous.pick([
                    "body",
                    "levels",
                    "changed"
                ])
            }}
        />

        <Return
            value={{
                dirty: $ctx.publish.changed,
                updates: $ctx.publish.updates,
                plan: null
            }}
        />
    </If>

    <If on={$in.phase == Program.Phase.Demand && $in.previous.changed.length != 0}>
        <Call
            fn="../notify"
            in={{
                active: $in.active,
                changed: $in.previous.changed,
                callers: $in.callers,
                demand_body: $in.previous.body
            }}
        />

        <Return
            value={{
                dirty: $ctx.notify,
                updates: [],
                plan: null
            }}
        />
    </If>

    <If on={$in.phase == Program.Phase.Plan && $in.previous.plan != null}>
        <Call fn="../../program/visit/publish" in={$in.previous.plan} />

        <Return
            value={{
                dirty: [],
                updates: [],
                plan: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            dirty: [],
            updates: [],
            plan: null
        }}
    />
</Module>
