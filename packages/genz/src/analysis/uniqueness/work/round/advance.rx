<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Advance} out={Round.Visit} />

    <Call module="feedback" in={$in} />

    <Call
        fn="take"
        in={{
            state: {
                ...$in.state,
                cursor: $ctx.feedback
            },
            slots: $in.slots,
            phase: $in.phase,
            following: $in.following
        }}
    />

    <Return value={$ctx.take} />
</Module>
