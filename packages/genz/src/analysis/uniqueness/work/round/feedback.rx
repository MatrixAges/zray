<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Advance} out={Round.PreparedFeedback} />

    <If on={$in.previous != null}>
        <Call
            module="phase_feedback"
            in={{
                ...$in,
                previous: $in.previous
            }}
        />

        <If on={$in.previous.grew}>
            <Call fn="record_growth" in={$in.state.cursor} />

            <Return
                value={{
                    ...$ctx.phase_feedback,
                    cursor: $ctx.record_growth
                }}
            />
        </If>

        <Return
            value={{
                ...$ctx.phase_feedback,
                cursor: $in.state.cursor
            }}
        />
    </If>

    <Return
        value={{
            cursor: $in.state.cursor,
            dirty: [],
            plan: null
        }}
    />
</Module>
