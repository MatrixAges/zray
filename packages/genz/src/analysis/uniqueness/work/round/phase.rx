<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Transition} out={Round.Phase} />

    <Switch on={$in.event}>
        <Case value={Round.Event.Start}>
            <If on={$in.following}>
                <Return value={Round.Phase.Replay} />
            </If>

            <Return value={Round.Phase.Settled} />
        </Case>

        <Case value={Round.Event.ReplayAccepted}>
            <Return value={Round.Phase.Finished} />
        </Case>

        <Case value={Round.Event.ReplayRejected}>
            <Return value={Round.Phase.Settled} />
        </Case>

        <Case value={Round.Event.Settled}>
            <Return value={Round.Phase.Demanded} />
        </Case>

        <Case value={Round.Event.Exhausted}>
            <Return value={Round.Phase.Demanded} />
        </Case>

        <Case value={Round.Event.DemandGrew}>
            <Return value={Round.Phase.Settled} />
        </Case>

        <Case value={Round.Event.DemandStable}>
            <Return value={Round.Phase.Planned} />
        </Case>

        <Case value={Round.Event.PlansPublished}>
            <If on={$in.persistent}>
                <Return value={Round.Phase.CommitTrace} />
            </If>

            <Return value={Round.Phase.Finished} />
        </Case>
    </Switch>
</Module>
