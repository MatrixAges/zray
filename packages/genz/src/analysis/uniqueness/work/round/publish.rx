<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Settlement} out={u64[]} />

    <Call
        fn="../notify"
        in={{
            ...$in.pick([
                "changed",
                "active",
                "callers"
            ]),
            demand_body: null
        }}
    />

    <If on={$in.body + 1 < $in.active.length}>
        <Call
            fn="publish_output"
            in={$in.omit([
                "changed",
                "active"
            ])}
        />

        <Call
            fn="join_indices"
            in={{
                first: $ctx.notify,
                second: $ctx.publish_output
            }}
        />

        <Return value={$ctx.join_indices} />
    </If>

    <Return value={$ctx.notify} />
</Module>
