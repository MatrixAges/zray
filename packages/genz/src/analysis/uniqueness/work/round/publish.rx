<Module>
    <Type from="model" as="Round" />
    <Type from="../../function/updates/model" as="Updates" />

    <Args in={Round.Settlement} out={Updates.Batch} />

    <Call
        fn="../notify"
        in={{
            ...$in.pick([
                "changed",
                "active",
                "callers"
            ]),
            demand_body: null
        }}
    />

    <If on={$in.body + 1 < $in.active.length}>
        <Call
            fn="publish_output"
            in={$in.omit([
                "changed",
                "active"
            ])}
        />

        <Call
            fn="join_indices"
            in={{
                first: $ctx.notify,
                second: $ctx.publish_output.changed
            }}
        />

        <Return
            value={{
                changed: $ctx.join_indices,
                updates: $ctx.publish_output.updates
            }}
        />
    </If>

    <Return
        value={{
            changed: $ctx.notify,
            updates: []
        }}
    />
</Module>
