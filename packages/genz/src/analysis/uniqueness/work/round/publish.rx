<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Settlement} out={void} />

    <Call
        fn="../notify"
        in={{
            ...$in.omit([
                "body",
                "levels",
                "outputs"
            ]),
            demand_body: null
        }}
    />

    <If on={$in.body < $in.native_modules.length}>
        <Call
            fn="publish_output"
            in={$in.omit([
                "changed",
                "type_only",
                "native_modules"
            ])}
        />
    </If>
</Module>
