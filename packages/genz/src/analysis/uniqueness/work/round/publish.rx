<Module>
    <Type from="model" as="Round" />
    <Type from="../model" as="Work" />

    <Args in={Round.Settlement} out={Work.Cursor} />

    <Call
        fn="../notify"
        in={{
            ...$in.omit([
                "body",
                "levels",
                "outputs"
            ]),
            demand_body: null
        }}
    />

    <If on={$in.body + 1 < $in.active.length}>
        <Call
            fn="publish_output"
            in={{
                ...$in.omit([
                    "changed",
                    "active"
                ]),
                state: {
                    ...$in.state,
                    cursor: $ctx.notify
                }
            }}
        />

        <Return value={$ctx.publish_output} />
    </If>

    <Return value={$ctx.notify} />
</Module>
