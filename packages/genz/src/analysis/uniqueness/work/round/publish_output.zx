import integers from "std:integer"

import merge from "../../function/updates/merge"
import enqueue from "../enqueue"

import type { Settlement } from "./model"

export type Input = Settlement.Omit("changed", "type_only", "native_modules")

export type Output = void

export default function (in: Input): Output {
    const { state, body, levels, outputs, dirty, callers } = in

    const weakened = merge({
        rows: outputs,
        row: integers.narrow(body),
        first: 0,
        levels,
        joining: false
    })

    if (weakened != 0) {
        enqueue({
            state,
            dirty,
            indices: callers
        })
    }
}
