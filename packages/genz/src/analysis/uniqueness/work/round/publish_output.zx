import integers from "std:integer"

import merge from "../../function/updates/merge"

import type { Batch as Output } from "../../function/updates/model"
import type { Settlement } from "./model"

export type Input = Settlement.Omit("changed", "active")

export default function (in: Input): Output {
    const { body, levels, outputs, callers } = in

    const updates = merge({
        rows: outputs,
        updates: [],
        row: integers.narrow(body),
        levels,
        output: true
    })

    return {
        changed: match {
            updates.length == 0 => [],
            _ => callers
        },
        updates
    }
}
