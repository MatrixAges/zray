import integers from "std:integer"

import merge from "../../function/updates/merge"
import enqueue from "../enqueue"

import type { Cursor as Output } from "../model"
import type { Settlement } from "./model"

export type Input = Settlement.Omit("changed", "active")

export default function (in: Input): Output {
    const { state, body, levels, outputs, dirty, callers } = in

    const weakened = merge({
        rows: outputs,
        row: integers.narrow(body),
        first: 0,
        levels,
        joining: false
    })

    if (weakened != 0) {
        return enqueue({
            state,
            dirty,
            indices: callers
        })
    }

    return state.cursor
}
