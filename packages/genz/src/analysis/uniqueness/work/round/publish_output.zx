import integers from "std:integer"

import merge from "../../function/updates/merge"

import type { Settlement } from "./model"

export type Input = Settlement.Omit("changed", "active")

export type Output = u64[]

export default function (in: Input): Output {
    const { body, levels, outputs, callers } = in

    const weakened = merge({
        rows: outputs,
        row: integers.narrow(body),
        first: 0,
        levels,
        joining: false
    })

    if (weakened == 0) {
        return []
    }

    return callers
}
