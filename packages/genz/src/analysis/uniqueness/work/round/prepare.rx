<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Input} out={Round.Output} />

    <Call
        module="phase"
        in={{
            event: $in.event,
            following: false,
            persistent: false
        }}
    />

    <If on={$ctx.phase == Round.Phase.Settled}>
        <Call fn="../../summaries/reset" in={$in.facts} />
    </If>

    <If on={$in.event == Round.Event.Exhausted}>
        <Call
            fn="../../summaries/clear"
            in={{
                cells: $in.facts.guarantees,
                count: $in.facts.layout.input_count + $in.facts.layout.output_count
            }}
        />
    </If>

    <Call module="../fill" in={$in.queue} />

    <Call fn="budget" in={$ctx.fill.queued.length} />

    <Return
        value={{
            state: $ctx.fill,
            phase: $ctx.phase,
            budget: $ctx.budget
        }}
    />
</Module>
