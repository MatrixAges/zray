<Module>
    <Type from="model" as="Round" />
    <Type from="../../program/model" as="Program" />

    <Args in={Round.Input} out={u64} />

    <If on={$in.phase == Program.Phase.Settle}>
        <Call fn="../../summaries/reset" in={$in.facts} />
    </If>

    <If on={$in.phase == Program.Phase.Demand && $in.exhausted}>
        <Call
            fn="../../summaries/clear"
            in={{
                cells: $in.facts.guarantees,
                count: $in.facts.layout.input_count + $in.facts.layout.output_count
            }}
        />
    </If>

    <Call fn="../fill" in={$in.queue} />
    <Call fn="budget" in={$in.queue.state.capacity} />

    <Return value={$ctx.budget} />
</Module>
