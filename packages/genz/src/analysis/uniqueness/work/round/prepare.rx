<Module>
    <Type from="model" as="Round" />

    <Args in={Round.Input} out={Round.Prepared} />

    <Call module="prepare_summaries" in={$in.omit(["queue"])} />

    <Call fn="../fill" in={$in.queue} />

    <Call
        fn="budget"
        in={{
            cursor: $ctx.fill,
            capacity: $in.queue.state.capacity
        }}
    />

    <Return
        value={{
            cursor: $ctx.budget,
            guarantees: $ctx.prepare_summaries
        }}
    />
</Module>
