import type { AtomicRows } from "std:bytes"
import type { Lifecycle } from "../../summaries/model"
import type { Fill, Notify, State } from "../model"

export type Input = {
    queue: Fill,
    facts: Lifecycle,
    reset: bool,
    clear: bool
}

export type Output = {
    state: State,
    budget: u64
}

export type Take = {
    state: State,
    budget: u64
}

export type Visit = Take & {
    body?: u64,
    exhausted: bool
}

export type Settlement = Notify.Omit("demand_body") & {
    body: u64,
    levels: u8[],
    outputs: AtomicRows
}
