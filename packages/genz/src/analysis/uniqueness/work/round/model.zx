import type { AtomicRows } from "memory"
import type { Cell } from "../../function/updates/model"
import type { Phase } from "../../program/model"
import type { Facts } from "../../summaries/model"
import type { Cursor, Fill, Filled, Notify, Slot, State } from "../model"

export type Input = {
    queue: Fill,
    facts: Facts,
    phase: Phase,
    exhausted: bool
}

export type PrepareSummaries = Input.Omit("queue")

export type Prepared = Filled & {
    guarantees?: u8[]
}

export type Request = {
    state: State,
    slots: u64[],
    phase: Phase,
    following: bool
}

export type Take = Request & {
    additions: Slot[]
}

export type Visit = {
    body?: u64,
    dequeued?: u64,
    exhausted: bool,
    pending_start: u64,
    pending_first: u64,
    pending_second: u64,
    grew: bool,
    prefetch: bool,
    cursor: Cursor
}

export type Settlement = Notify.Omit("demand_body") & {
    body: u64,
    levels: u8[],
    outputs: AtomicRows
}

export type Feedback = {
    body: u64,
    changed: u64[],
    levels: u8[],
    grew: bool,
    plan?: Plan
}

export type Plan = {
    count: u64,
    body: u64,
    fields: u8[]
}

export type Advance = Request & Notify.Pick("active") & {
    outputs: AtomicRows,
    callers: u64[][],
    previous?: Feedback
}

export type PhaseFeedback = Advance.Omit("previous") & {
    previous: Feedback
}

export type PlanWrite = {
    entry: bool,
    index: u64,
    fields: u8[]
}

export type Actions = {
    dirty: u64[],
    updates: Cell[],
    plan?: PlanWrite
}

export type PreparedFeedback = Actions & {
    cursor: Cursor
}

export type Dispatch = Visit & Actions & {
    additions: Slot[]
}
