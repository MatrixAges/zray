import type { AtomicRows } from "std:bytes"
import type { Phase } from "../../program/model"
import type { Lifecycle } from "../../summaries/model"
import type { Fill, Notify, State } from "../model"

export type Input = {
    queue: Fill,
    facts: Lifecycle,
    phase: Phase,
    exhausted: bool
}

export type Take = {
    state: State,
    phase: Phase,
    following: bool
}

export type Visit = {
    body?: u64,
    exhausted: bool,
    first: u64,
    prefix: u64,
    suffix: u64,
    grew: bool,
    prefetch: bool
}

export type Settlement = Notify.Omit("demand_body") & {
    body: u64,
    levels: u8[],
    outputs: AtomicRows
}

export type Feedback = {
    body: u64,
    changed: u64[],
    levels: u8[],
    grew: bool
}

export type Advance = Take & Notify.Pick("dirty", "active") & {
    outputs: AtomicRows,
    callers: u64[][],
    previous?: Feedback
}
