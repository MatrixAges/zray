import type { AtomicRows, WriteColumn } from "memory"
import type { Phase } from "../../program/model"
import type { Lifecycle } from "../../summaries/model"
import type { Input as Prefetch, Output as Offered } from "../ahead/request/model"
import type { Fill, Notify, State } from "../model"

export type Input = {
    queue: Fill,
    facts: Lifecycle,
    phase: Phase,
    exhausted: bool
}

export type Take = {
    state: State,
    slots: u64[],
    phase: Phase,
    following: bool
}

export type Visit = {
    body?: u64,
    exhausted: bool,
    first: u64[],
    second: u64[],
    grew: bool,
    prefetch: bool
}

export type Settlement = Notify.Omit("demand_body") & {
    body: u64,
    levels: u8[],
    outputs: AtomicRows
}

export type Feedback = {
    body: u64,
    changed: u64[],
    levels: u8[],
    grew: bool,
    plan?: Plan
}

export type Plan = {
    plans: WriteColumn,
    entry: WriteColumn,
    count: u64,
    body: u64,
    fields: u8[]
}

export type Advance = Take & Notify.Pick("dirty", "active") & {
    outputs: AtomicRows,
    callers: u64[][],
    previous?: Feedback
}

export type Dispatch = {
    round?: Advance,
    prefetch: Prefetch
}

export type Dispatched = {
    claim?: Visit,
    offered?: Offered
}
