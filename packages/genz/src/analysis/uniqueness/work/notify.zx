import type { Notify as Input } from "./model"

export type Output = u64[]

export default function (in: Input): Output {
    const { changed, active, demand_body, callers } = in

    const indices: u64[] = []

    return loop({
        index: 0,
        indices
    }, {
        while: state => state.index < changed.length,
        next: state => {
            const body = changed[state.index]

            if (demand_body != null && body == demand_body) {
                state.indices = state.indices.concat(callers)[0]
            } else if (active[body]) {
                state.indices = state.indices.push(body)[0]
            }

            state.index += 1
        },
        return: state => state.indices
    })
}
