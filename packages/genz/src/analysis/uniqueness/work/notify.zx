import enqueue from "./enqueue"
import invalidate from "./invalidate"

import type { Notify } from "./model"

export type Input = Notify

export type Output = void

export default function (in: Input): Output {
    const { changed, active, demand_body, callers, dirty } = in

    const start: u64 = 0

    const notified = loop(start, {
        while: index => index < changed.length,
        next: index => {
            const body = changed[index]

            if (demand_body != null && body == demand_body) {
                enqueue({
                    state: in.state,
                    dirty,
                    indices: callers
                })
            } else if (active[body]) {
                invalidate({
                    state: in.state,
                    dirty,
                    index: body
                })
            }

            index += 1
        }
    })
}
