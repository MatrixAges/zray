import enqueue from "./enqueue"
import invalidate from "./invalidate"

import type { Notify } from "./model"

export type Input = Notify

export type Output = void

export default function (in: Input): Output {
    const { changed, native_modules, type_only, demand_body, callers, dirty } = in

    const start: u64 = 0

    const notified = loop(start, {
        while: index => index < changed.length,
        next: index => {
            const body = changed[index]

            if (demand_body != null && body == demand_body) {
                enqueue({
                    state: in.state,
                    dirty,
                    indices: callers
                })
            } else {
                const active = match {
                    body < native_modules.length => native_modules[body] == null,
                    _ => !type_only
                }

                if (active) {
                    invalidate({
                        state: in.state,
                        dirty,
                        index: body
                    })
                }
            }

            index += 1
        }
    })
}
