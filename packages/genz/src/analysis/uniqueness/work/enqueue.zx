import insert from "../function/demand/seen/insert"
import { clear_flag } from "./const"
import push from "./push"

import type { Seen } from "../function/demand/seen/model"
import type { Enqueue as Input, Slot } from "./model"

export type Output = Slot[]

export default function (in: Input): Output {
    const { indices, state } = in
    const { cursor, capacity, queued } = state

    const planned: Slot[] = []

    const seen: Seen = {
        keys: [],
        count: 0
    }

    return loop({
        index: 0,
        planned,
        seen
    }, {
        while: current => current.index < indices.length,
        next: current => {
            const body = indices[current.index]

            if (queued[body] == clear_flag) {
                const checked = insert({
                    seen: current.seen,
                    key: body + 1
                })

                if (!checked.found) {
                    current.planned = current.planned.push(push({
                        head: cursor.head,
                        count: cursor.count + current.planned.length,
                        capacity,
                        body
                    }))[0]
                }

                current.seen = checked.seen
            }

            current.index += 1
        },
        return: current => current.planned
    })
}
