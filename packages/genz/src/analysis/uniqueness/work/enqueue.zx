import invalidate from "./invalidate"

import type { Cursor as Output, Enqueue as Input } from "./model"

export type { Enqueue as Input, Cursor as Output } from "./model"

export default function (in: Input): Output {
    const { dirty, indices } = in

    const start: u64 = 0

    return loop({
        index: start,
        cursor: in.state.cursor
    }, {
        while: current => current.index < indices.length,
        next: current => {
            current.cursor = invalidate({
                state: {
                    ...in.state,
                    cursor: current.cursor
                },
                dirty,
                index: indices[current.index]
            })
            current.index += 1
        },
        return: current => current.cursor
    })
}
