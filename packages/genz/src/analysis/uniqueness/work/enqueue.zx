import invalidate from "./invalidate"

import type { Enqueue } from "./model"

export type Input = Enqueue

export type Output = void

export default function (in: Input): Output {
    const { dirty, indices } = in

    const start: u64 = 0

    const filled = loop(start, {
        while: index => index < indices.length,
        next: index => {
            invalidate({
                state: in.state,
                dirty,
                index: indices[index]
            })
            index += 1
        }
    })
}
