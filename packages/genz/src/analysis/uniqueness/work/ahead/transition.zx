import memory from "memory"

import { failed, held, idle, queued, ready, running, waiting } from "./const"
import { Event } from "./model"

import type { Slot } from "./model"

export type Input = Slot & {
    event: Event
}

export type Output = bool

export default function (in: Input): Output {
    const { words, index, event } = in

    if (event == Event.Claim) {
        return memory.compareExchangeU32Acquire(words, index, queued, running)
    }

    if (event == Event.Withdraw) {
        return memory.compareExchangeU32Acquire(words, index, queued, idle)
    }

    if (event == Event.Queue || event == Event.Hold) {
        const next = event == Event.Queue ? queued : held

        memory.storeU32Release(words, index, next)
    } else {
        const next = event == Event.Complete ? ready : failed
        const previous = memory.exchangeU32Release(words, index, next)

        if (previous == waiting) {
            memory.wakeOneU32(words, index)
        }
    }

    return true
}
