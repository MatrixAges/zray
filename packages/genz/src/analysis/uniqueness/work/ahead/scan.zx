import memory from "memory"

import { clean, held, idle, queued, ready, requests_per_worker } from "./const"

import type { Buffers } from "./model"

export type Input = Buffers & {
    recursive: bool[],
    indices: u64[],
    wrapped: u64[],
    first: u64,
    workers: u64
}

export type Candidate = {
    position: u64,
    index: u64
}

export type Output = Candidate?

export default function (in: Input): Output {
    const width = in.workers * requests_per_worker
    const length = in.indices.length + in.wrapped.length
    const end = width < length ? width : length

    const candidate: Output = null

    return loop({
        pos: in.first,
        candidate
    }, {
        while: state => state.candidate == null && state.pos < end,
        next: state => {
            const index = match {
                state.pos < in.indices.length => in.indices[state.pos],
                _ => in.wrapped[state.pos - in.indices.length]
            }
            const status = memory.loadU32Acquire(in.words, index)
            const eligible = match status {
                idle => true,
                ready => memory.readU8(in.dirty, index) != clean,
                held => memory.readU8(in.dirty, index) != clean,
                _ => false
            }

            const found = eligible && !in.recursive[index]

            if (found || status == queued) {
                memory.writeU8(in.dirty, index, clean)
            }

            if (found) {
                state.candidate = {
                    position: state.pos,
                    index
                }
            } else {
                state.pos += 1
            }
        },
        return: state => state.candidate
    })
}
