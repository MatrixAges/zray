<Module>
    <Type from="model" as="Ahead" />

    <Args in={Ahead.Input} out={Ahead.Output} />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                ...$in,
                first: $in.window.first,
                pending: null,
                running: true
            }}
        />
    </Loop>

    <Return
        value={{
            encoding: $ctx.advance.encoding,
            next: $ctx.advance.first,
            pending: $ctx.advance.pending
        }}
    />
</Module>
