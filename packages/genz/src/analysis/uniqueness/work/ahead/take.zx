import memory from "memory"

import { clean, failed, idle, queued, ready, running, waiting } from "./const"
import { Result } from "./model"

import type { Buffers, Slot } from "./model"

export type Input = Buffers & Slot.Pick("index")

export type Output = Result

export default function (in: Input): Output {
    const { words, dirty, index } = in

    memory.writeU8(dirty, index, clean)

    const result = loop({
        result: Result.Pending
    }, {
        while: state => state.result == Result.Pending,
        next: state => {
            const status = memory.loadU32Acquire(words, index)

            if (status == queued) {
                if (
                    memory.compareExchangeU32Acquire(
                        words,
                        index,
                        queued,
                        idle
                    )
                ) {
                    state.result = Result.Missing
                }
            } else if (status == running) {
                const marked =
                    memory.compareExchangeU32Acquire(words, index, running, waiting)

                if (marked) {
                    memory.waitU32(words, index, waiting)
                }
            } else if (status == waiting) {
                memory.waitU32(words, index, waiting)
            } else {
                state.result = match status {
                    ready => Result.Ready,
                    failed => Result.Failed,
                    _ => Result.Missing
                }
            }
        },
        return: state => state.result
    })

    memory.storeU32Release(words, index, idle)

    return result
}
