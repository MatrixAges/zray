import memory from "memory"

import { clean } from "./const"

import type { Buffers } from "./model"

export type Input = Buffers & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    memory.clearU32Buffer(in.words, in.count)
    memory.fillByteRange(in.dirty, 0, in.count, clean)
}
