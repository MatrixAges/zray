<Module>
    <Type from="model" as="Ahead" />
    <Type from="../../../program/model" as="Program" />

    <Args in={Ahead.Request} out={Ahead.Step[]} />

    <Switch on={$in.activity}>
        <Case value={Ahead.Activity.Request}>
            <If on={$in.phase == Program.Phase.Plan && !$in.persistent}>
                <Return
                    value={[
                        Ahead.Step.Reserve,
                        Ahead.Step.Submit,
                        Ahead.Step.WithdrawOnFull
                    ]}
                />
            </If>

            <Return
                value={[
                    Ahead.Step.CheckMemo,
                    Ahead.Step.Reserve,
                    Ahead.Step.Submit,
                    Ahead.Step.WithdrawOnFull
                ]}
            />
        </Case>

        <Case value={Ahead.Activity.Analyze}>
            <Switch on={$in.phase}>
                <Case value={Program.Phase.Demand}>
                    <Return
                        value={[
                            Ahead.Step.Claim,
                            Ahead.Step.ReadGrowth,
                            Ahead.Step.AnalyzeDeferred,
                            Ahead.Step.Publish,
                            Ahead.Step.Complete
                        ]}
                    />
                </Case>

                <Case value={Program.Phase.Plan}>
                    <Return
                        value={[
                            Ahead.Step.Claim,
                            Ahead.Step.AnalyzePlan,
                            Ahead.Step.Publish,
                            Ahead.Step.Complete
                        ]}
                    />
                </Case>

                <Default>
                    <Return
                        value={[
                            Ahead.Step.Claim,
                            Ahead.Step.AnalyzeDeferred,
                            Ahead.Step.Publish,
                            Ahead.Step.Complete
                        ]}
                    />
                </Default>
            </Switch>
        </Case>

        <Default>
            <If on={$in.phase == Program.Phase.Plan}>
                <Return value={[Ahead.Step.Wait]} />
            </If>

            <Return
                value={[
                    Ahead.Step.Wait,
                    Ahead.Step.CheckReads
                ]}
            />
        </Default>
    </Switch>
</Module>
