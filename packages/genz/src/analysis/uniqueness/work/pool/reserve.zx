import integers from "std:integer"
import memory from "memory"

import { capacity, head, tail, word_mask, word_span } from "./const"

import type { U32Buffer as Input } from "memory"

export type Output = u32?

export default function (in: Input): Output {
    const end = memory.loadU32Relaxed(in, tail)
    const first = memory.loadU32Sequential(in, head)
    const delta = integers.widen(end) + word_span - integers.widen(first)

    return integers.andBits(delta, word_mask) < capacity ? end : null
}
