import integers from "std:integer"
import memory from "memory"

import { capacity, tail, word_mask } from "./const"

import type { Publication as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const position = integers.widen(in.position)
    const next = integers.andBits(position + 1, word_mask)

    memory.storeU32Relaxed(in.ring, position % capacity, in.index)
    memory.storeU32Sequential(in.counters, tail, integers.narrow(next))
}
