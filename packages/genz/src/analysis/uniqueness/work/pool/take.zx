import memory from "memory"

import claim from "./claim"
import { spins, stopping } from "./const"
import park from "./park"
import pending from "./pending"

import type { State as Input } from "./model"

export type Output = u32?

export default function (in: Input): Output {
    const job: u32? = null

    return loop({
        job,
        idle: 0,
        stopped: false
    }, {
        while: state => state.job == null && !state.stopped,
        next: state => {
            if (pending(in.counters)) {
                state.job = claim(in)
                state.idle = 0
            } else if (memory.loadU32Sequential(in.counters, stopping) != 0) {
                state.stopped = true
            } else if (state.idle < spins) {
                memory.spinHint()
                state.idle += 1
            } else {
                park(in.counters)
                state.idle = 0
            }
        },
        return: state => state.job
    })
}
