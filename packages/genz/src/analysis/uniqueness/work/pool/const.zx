import { max_u32 } from "core/const"

export const head: u64 = 0

export const tail: u64 = 1

export const busy: u64 = 2

export const sleepers: u64 = 3

export const signal: u64 = 4

export const stopping: u64 = 5

export const counter_count: u64 = stopping + 1

export const capacity: u64 = 256

export const max_threads: u64 = 8

export const spins: u64 = 2000

export const word_span: u64 = 4294967296

export const word_mask: u64 = word_span - 1

export const decrement: u32 = max_u32

export const stopped: u32 = 1
