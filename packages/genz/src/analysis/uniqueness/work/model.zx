export type Cursor = {
    head: u64,
    count: u64,
    budget: u64,
    grew: bool
}

export type State = {
    queued: u8[],
    cursor: Cursor,
    capacity: u64
}

export type Fill = {
    capacity: u64,
    active: bool[]
}

export type Filled = {
    queued: u8[],
    slots: u64[],
    cursor: Cursor
}

export type Slot = {
    slot: u64,
    body: u64
}

export type Enqueue = {
    state: State,
    indices: u64[]
}

export type Notify = {
    changed: u64[],
    active: bool[],
    callers: u64[],
    demand_body?: u64
}
