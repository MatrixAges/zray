import type { U8Buffer } from "memory"

export type State = {
    buffer: u64[],
    queued: bool[],
    head: u64,
    tail: u64
}

export type Fill = {
    state: State,
    native_modules: u32?[],
    type_only: bool
}

export type Push = {
    state: State,
    index: u64
}

export type Popped = {
    state: State,
    index?: u64
}

export type Enqueue = {
    state: State,
    dirty: U8Buffer,
    indices: u64[]
}

export type Notify = Enqueue.Omit("indices") & {
    changed: u64[],
    native_modules: u32?[],
    type_only: bool,
    callers: u64[],
    demand_body?: u64
}
