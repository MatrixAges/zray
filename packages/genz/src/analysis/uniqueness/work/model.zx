import type { U8Buffer, U64Buffer } from "memory"

export type State = {
    slots: U64Buffer,
    queued: U8Buffer,
    positions: U64Buffer,
    capacity: u64
}

export type Fill = {
    state: State,
    active: bool[]
}

export type Push = {
    state: State,
    index: u64
}

export type Enqueue = {
    state: State,
    dirty: U8Buffer,
    indices: u64[]
}

export type Notify = Enqueue.Omit("indices") & {
    changed: u64[],
    active: bool[],
    callers: u64[],
    demand_body?: u64
}
