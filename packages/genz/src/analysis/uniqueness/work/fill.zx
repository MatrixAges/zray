import memory from "memory"

import { clear_flag, queued_flag } from "./const"

import type { Cursor as Output, Fill as Input } from "./model"

export default function (in: Input): Output {
    const queue = in.state

    const count = loop({
        body: 0,
        tail: 0
    }, {
        while: row => row.body < queue.capacity,
        next: row => {
            const body = row.body
            const active = in.active[body]

            memory.writeU8(queue.queued, body, active ? queued_flag : clear_flag)

            if (active) {
                memory.writeU64(queue.slots, row.tail, body)
                row.tail += 1
            }

            row.body += 1
        },
        return: row => row.tail
    })

    return {
        head: 0,
        count,
        budget: 0,
        grew: false
    }
}
