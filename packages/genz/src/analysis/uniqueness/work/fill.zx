import bytes from "std:bytes"

import { clear_flag, queued_flag } from "./const"

import type { Fill as Input, Filled as Output } from "./model"

export default function (in: Input): Output {
    const { capacity, active } = in

    const queued = bytes.repeat(capacity, clear_flag)
    const slots: u64[] = queued.map(flag => 0)[0]

    return loop({
        body: 0,
        count: 0,
        queued,
        slots
    }, {
        while: row => row.body < capacity,
        next: row => {
            if (active[row.body]) {
                row.queued[row.body] = queued_flag
                row.slots[row.count] = row.body
                row.count += 1
            }

            row.body += 1
        },
        return: row => ({
            queued: row.queued,
            slots: row.slots,
            cursor: {
                head: 0,
                count: row.count,
                budget: 0,
                grew: false
            }
        })
    })
}
