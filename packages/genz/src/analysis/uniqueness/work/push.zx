import memory from "memory"

import { clear_flag, queued_flag } from "./const"

import type { Cursor as Output, Push as Input } from "./model"

export default function (in: Input): Output {
    const { state, index } = in

    if (memory.readU8(state.queued, index) == clear_flag) {
        const count = state.cursor.count
        const tail = state.cursor.head + count
        const slot = tail < state.capacity ? tail : tail - state.capacity

        memory.writeU64(state.slots, slot, index)
        memory.writeU8(state.queued, index, queued_flag)

        return {
            ...state.cursor,
            count: count + 1
        }
    }

    return state.cursor
}
