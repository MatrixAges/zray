import type { Slot } from "./model"

export type Input = {
    head: u64,
    count: u64,
    capacity: u64,
    body: u64
}

export type Output = Slot

export default function (in: Input): Output {
    const tail = in.head + in.count

    return {
        body: in.body,
        slot: tail < in.capacity ? tail : tail - in.capacity
    }
}
