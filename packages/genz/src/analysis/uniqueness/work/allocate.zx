import { allocateRows } from "core/row_buffer"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Buffers = {
    owner: ColumnAllocator,
    slots: RowBuffer,
    queued: RowBuffer
}

export type Input = Buffers & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    allocateRows({
        target: in.slots,
        count: in.count,
        owner: in.owner
    })

    allocateRows({
        target: in.queued,
        count: in.count,
        owner: in.owner
    })
}
