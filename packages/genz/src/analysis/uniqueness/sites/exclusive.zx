import integers from "std:integer"

import apart from "../order/apart"

import type { Query } from "./model"

export type Input = {
    query: Query,
    left: u64,
    right: u64
}

export type Output = bool

export default function (in: Input): Output {
    const sites = in.query.plan.sites

    const { left, right } = in

    const marked = integers.widen(sites.edge[left]) >= in.query.plan.edge_count ||
        integers.widen(sites.edge[right]) >= in.query.plan.edge_count

    if (marked) {
        return false
    }

    const left_region = sites.region[left]
    const right_region = sites.region[right]
    const left_count = sites.arms[left]
    const right_count = sites.arms[right]
    const missing_arms = left_count == 0 || right_count == 0

    if (left_region == right_region && missing_arms) {
        return false
    }

    const regions = in.query.regions
    const times = in.query.nodes.time
    const left_time = times[integers.widen(sites.top[left])]
    const right_time = times[integers.widen(sites.top[right])]

    if (apart({
        regions,
        left: left_region,
        left_time,
        right: right_region,
        right_time
    })) {
        return true
    }

    return loop({
        index: integers.narrow(0),
        found: false
    }, {
        while: current => !current.found && current.index < left_count,
        next: current => {
            const left_arm = match current.index {
                0 => sites.a[left],
                1 => sites.b[left],
                2 => sites.c[left],
                _ => sites.d[left]
            }

            current.found = loop({
                index: integers.narrow(0),
                found: false
            }, {
                while: other => !other.found && other.index < right_count,
                next: other => {
                    const right_arm = match other.index {
                        0 => sites.a[right],
                        1 => sites.b[right],
                        2 => sites.c[right],
                        _ => sites.d[right]
                    }

                    other.found = apart({
                        regions,
                        left: left_arm,
                        left_time,
                        right: right_arm,
                        right_time
                    })
                    other.index += 1
                },
                return: state => state.found
            })
            current.index += 1
        },
        return: state => state.found
    })
}
