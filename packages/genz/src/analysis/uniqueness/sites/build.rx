<Module>
    <Type from="model" as="Sites" />

    <Args in={Sites.Input} out={Sites.Facts} />

    <Task
        name="plan"
        out={$ctx.publish}
    >
        <Call fn="consumers" in={$in} />
        <Call fn="references" in={$in} />
        <Call fn="slots" in={$in} />

        <Call
            fn="walk"
            in={{
                source: $in,
                consumers: $ctx.consumers,
                references: $ctx.references
            }}
        />

        <Call
            fn="resolve_roles"
            in={{
                source: $in,
                trace: $ctx.walk
            }}
        />

        <Call
            module="borrow_uses/build"
            in={{
                source: $in,
                trace: $ctx.walk,
                roles: $ctx.resolve_roles
            }}
        />

        <Call
            fn="publish"
            in={{
                ...$ctx.build,
                edge_count: $in.edges.parent.length,
                slot_first: $ctx.slots
            }}
        />
    </Task>

    <Call
        fn="classify"
        in={{
            source: $in,
            plan: $ctx.task.plan
        }}
    />

    <Return
        value={{
            plan: $ctx.task.plan,
            states: $ctx.classify
        }}
    />
</Module>
