import integers from "std:integer"

import { Role } from "../order/model"

import type { Mark } from "./borrow_uses/model"
import type { Plan as Output, Trace } from "./model"

export type Input = Output.Pick("edge_count", "slot_first") & {
    trace: Trace,
    roles: Role[],
    marks: Mark[]
}

export default function (in: Input): Output {
    const { sites } = in.trace

    const roles: Role[] = in.roles

    const columns = loop({
        parent: sites.map(site => site.parent)[0],
        edge: sites.map(site => site.edge)[0],
        role: roles,
        index: 0
    }, {
        while: state => state.index < in.marks.length,
        next: state => {
            const mark = in.marks[state.index]
            const index = integers.widen(mark.site)

            state.parent[index] = mark.boundary
            state.edge[index] = integers.narrow(in.edge_count + state.index)
            state.role[index] = Role.observe
            state.index += 1
        }
    })

    return {
        edge_count: in.edge_count,
        first: in.trace.first,
        slot_first: in.slot_first,
        sites: {
            lo: sites.map(site => site.lo)[0],
            hi: sites.map(site => site.hi)[0],
            delta: sites.map(site => site.delta)[0],
            top: sites.map(site => site.top)[0],
            region: sites.map(site => site.region)[0],
            a: sites.map(site => site.a)[0],
            b: sites.map(site => site.b)[0],
            c: sites.map(site => site.c)[0],
            d: sites.map(site => site.d)[0],
            arms: sites.map(site => site.arms)[0],
            edge: columns.edge,
            parent: columns.parent,
            role: columns.role
        }
    }
}
