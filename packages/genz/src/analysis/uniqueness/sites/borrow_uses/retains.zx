import integers from "std:integer"

export type Input = {
    held: bool[],
    first: u32,
    end: u32
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        slot: integers.widen(in.first),
        found: false
    }, {
        while: state => !state.found && state.slot < integers.widen(in.end),
        next: state => {
            state.found = in.held[state.slot]
            state.slot += 1
        },
        return: state => state.found
    })
}
