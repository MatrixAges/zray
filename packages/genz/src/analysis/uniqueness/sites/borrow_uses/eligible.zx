import integers from "std:integer"
import { max_u32 } from "core/const"
import { ExpressionKind } from "core/expression_table/kinds"

import { Role } from "../../order/model"
import hasEffect from "./has_effect"
import observes from "./observes"

import type { Selected as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const input = in.source
    const site = input.trace.sites[in.site]

    if (site.role != Role.argument || site.parent == max_u32) {
        return false
    }

    const parent = integers.widen(site.parent)
    const expressions = input.source.expressions

    if (expressions.kinds[parent] != ExpressionKind.Call) {
        return false
    }

    const payload = integers.widen(expressions.payloads[parent])
    const callee = integers.widen(expressions.call_functions[payload])
    const effects = input.source.effects

    if (!effects.return_only[callee]) {
        return false
    }

    const first = integers.widenSigned(site.lo) + site.delta
    const end = integers.widenSigned(site.hi) + site.delta
    const limit = integers.widenSigned(effects.limit[callee])

    if (first < 0 || end > limit) {
        return false
    }

    const range = {
        first: integers.narrowSigned(first),
        end: integers.narrowSigned(end)
    }

    const held = hasEffect({
        ...range,
        slots: input.source.held[callee]
    })

    if (!held) {
        return false
    }

    if (!effects.borrow_only[callee] && hasEffect({
        ...range,
        slots: input.source.written[callee]
    })) {
        return false
    }

    const root = input.source.symbols.length + parent

    return loop({
        index: integers.widen(input.trace.first[root]),
        valid: true
    }, {
        while: state => state.valid &&
            state.index < integers.widen(input.trace.first[root + 1]),
        next: state => {
            state.valid = observes({
                source: input,
                site: state.index
            })
            state.index += 1
        },
        return: state => state.valid
    })
}
