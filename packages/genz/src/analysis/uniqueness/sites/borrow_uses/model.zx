import type { Role } from "../../order/model"
import type { Input as Source, Trace } from "../model"

export type Input = {
    source: Source,
    trace: Trace,
    roles: Role[]
}

export type Selected = {
    source: Input,
    site: u64
}

export type Candidate = {
    site: u32,
    node: u32,
    start: u32,
    finish: u32
}

export type Mark = {
    site: u32,
    boundary: u32
}

export type Candidates = {
    source: Input,
    candidates: Candidate[]
}

export type Completion = {
    source: Input,
    ends: u32[],
    node: u32
}
