<Module>
    <Type from="model" as="Borrow" />

    <Args in={Borrow.Input} out={Borrow.Mark[]} />

    <Call fn="candidates" in={$in} />

    <If on={$ctx.candidates.length == 0}>
        <Return value={[]} />
    </If>

    <Call
        fn="solve"
        in={{
            source: $in,
            candidates: $ctx.candidates
        }}
    />

    <Return value={$ctx.solve} />
</Module>
