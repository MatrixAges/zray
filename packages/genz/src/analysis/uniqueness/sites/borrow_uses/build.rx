<Module>
    <Type from="model" as="Borrow" />
    <Type from="../model" as="Sites" />

    <Args in={Borrow.Input} out={Sites.Resolved} />

    <Call fn="candidates" in={$in} />

    <If on={$ctx.candidates.length == 0}>
        <Return
            value={{
                trace: $in.trace,
                roles: $in.roles
            }}
        />
    </If>

    <Call
        fn="expand"
        in={{
            source: $in,
            candidates: $ctx.candidates
        }}
    />

    <Return
        value={{
            trace: $ctx.expand,
            roles: null
        }}
    />
</Module>
