import integers from "std:integer"

import eligible from "./eligible"

import type { Candidate, Input } from "./model"

export type Output = Candidate[]

export default function (in: Input): Output {
    const candidates: Candidate[] = []

    return loop({
        candidates,
        index: 0
    }, {
        while: state => state.index < in.trace.sites.length,
        next: state => {
            if (eligible({
                source: in,
                site: state.index
            })) {
                const node = in.trace.sites[state.index].parent
                const index = integers.widen(node)

                state.candidates = state.candidates.push({
                    site: integers.narrow(state.index),
                    node,
                    start: in.source.nodes.time[index],
                    finish: in.source.nodes.finish[index]
                })[0]
            }

            state.index += 1
        },
        return: state => state.candidates
    })
}
