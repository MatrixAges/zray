import integers from "std:integer"

import { Role } from "../order/model"

import type { Input as Source, Trace } from "./model"

export type Input = {
    source: Source,
    trace: Trace
}

export type Output = Role[]

export default function (in: Input): Output {
    const roles: Role[] = []

    return loop({
        roles,
        role: Role.argument,
        index: 0
    }, {
        while: current => current.index < in.trace.sites.length,
        next: current => {
            const site = in.trace.sites[current.index]
            const source = in.source

            current.role = site.role

            if (current.role == Role.argument) {
                const parent = integers.widen(site.parent)

                const payload = integers.widen(source.expressions.payloads[parent])

                const callee =
                    integers.widen(source.expressions.call_functions[payload])

                const kind = source.effects.kind[callee]
                const first = integers.widenSigned(site.lo) + site.delta
                const end = integers.widenSigned(site.hi) + site.delta
                const limit = integers.widenSigned(source.effects.limit[callee])
                const known = first >= 0 && end <= limit
                const root = source.symbols.length + parent
                const observes = kind == Role.observe ||
                    (
                        source.effects.borrow_only[callee] &&
                            in.trace.first[root] == in.trace.first[root + 1]
                    )

                if (known && observes) {
                    current.role = Role.observe
                } else if (kind == Role.use) {
                    current.role = Role.use
                }
            }

            current.roles = current.roles.push(current.role)[0]
            current.index += 1
        },
        return: state => state.roles
    })
}
