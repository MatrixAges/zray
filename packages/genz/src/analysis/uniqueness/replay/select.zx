import integers from "std:integer"

import type { Step as Input, Selection as Output } from "./model"

export default function (in: Input): Output {
    if (in.changed != in.verify) {
        return {
            following: true,
            cursor: null,
            next: null
        }
    }

    const position = match {
        in.positions.length == 0 => in.starts[in.index],
        _ => in.positions[in.index]
    }

    if (position == in.starts[in.index + 1]) {
        return {
            following: false,
            cursor: null,
            next: null
        }
    }

    return {
        following: true,
        cursor: integers.widen(position),
        next: position + 1
    }
}
