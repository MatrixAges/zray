<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Capture} out={void} />

    <Call fn="offsets" in={$in.omit(["edges"])} />

    <Call
        fn="edges"
        in={{
            callees: $in.callees,
            edges: $in.edges,
            count: $ctx.offsets
        }}
    />
</Module>
