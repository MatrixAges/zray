import type { Capture } from "./model"

export type Input = Capture

export type Output = u32[]

export default function (in: Input): Output {
    const empty: u32[] = []

    return loop({
        row: 0,
        edges: empty
    }, {
        while: state => state.row < in.callees.length,
        next: state => {
            state.edges = state.edges.concat(in.callees[state.row])[0]
            state.row += 1
        },
        return: state => state.edges
    })
}
