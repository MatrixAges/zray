import memory from "memory"

import type { Capture } from "./model"

export type Input = Capture.Omit("starts") & {
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    memory.allocateU32Views(in.edges, in.count)

    const written = loop({
        row: 0,
        offset: 0
    }, {
        while: state => state.row < in.callees.length,
        next: state => {
            const children = in.callees[state.row]

            memory.copyU32sAt(in.edges, state.offset, children)
            state.offset += children.length
            state.row += 1
        }
    })
}
