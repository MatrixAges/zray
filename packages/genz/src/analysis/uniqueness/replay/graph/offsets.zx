import type { Capture } from "./model"

export type Input = Capture

export type Output = u64[]

export default function (in: Input): Output {
    const initial: u64[] = [0]

    return loop({
        row: 0,
        end: 0,
        starts: initial
    }, {
        while: state => state.row < in.callees.length,
        next: state => {
            state.end += in.callees[state.row].length
            state.starts = state.starts.push(state.end)[0]
            state.row += 1
        },
        return: state => state.starts
    })
}
