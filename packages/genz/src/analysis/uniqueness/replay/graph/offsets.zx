import memory from "memory"

import type { Capture } from "./model"

export type Input = Capture.Omit("edges")

export type Output = u64

export default function (in: Input): Output {
    memory.allocateU64Views(in.starts, in.callees.length + 1)
    memory.writeU64(in.starts, 0, 0)

    return loop({
        row: 0,
        end: 0
    }, {
        while: state => state.row < in.callees.length,
        next: state => {
            state.end += in.callees[state.row].length
            state.row += 1
            memory.writeU64(in.starts, state.row, state.end)
        },
        return: state => state.end
    })
}
