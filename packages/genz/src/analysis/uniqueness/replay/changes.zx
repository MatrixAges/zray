import equal from "./digest"

import type { Input } from "./model"

export type Output = bool[]

export default function (in: Input): Output {
    const { previous, identities } = in

    if (previous == null) {
        return []
    }

    const width = in.key.length
    const changed: bool[] = []

    return loop({
        changed,
        index: 0
    }, {
        while: state => state.index < in.callees.length,
        next: state => {
            const unchanged = equal({
                previous: previous.identities,
                current: identities,
                start: state.index * width,
                width
            })

            state.changed = state.changed.push(!unchanged)[0]
            state.index += 1
        },
        return: state => state.changed
    })
}
