import bytes from "std:bytes"
import memory from "memory"

import type { Input } from "./model"

export type Output = bool[]

export default function (in: Input): Output {
    const { previous, identities } = in

    if (previous == null) {
        return []
    }

    const width = in.key.length
    const changed: bool[] = []

    return loop({
        changed,
        index: 0
    }, {
        while: state => state.index < in.callees.length,
        next: state => {
            const start = state.index * width
            const old = memory.borrowU8Range(previous.identities, start, width)
            const current = memory.borrowU8Range(identities, start, width)
            const unchanged = bytes.equals(old, current)

            state.changed = state.changed.push(!unchanged)[0]
            state.index += 1
        },
        return: state => state.changed
    })
}
