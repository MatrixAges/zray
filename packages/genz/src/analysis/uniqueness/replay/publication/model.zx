import type {
    Input as Group,
    Output as GroupOutput
} from "../../group/borrowed/model"
import type { Capture, Graph } from "../graph/model"

export type Identities = {
    source: u8[],
    count: u64,
    width: u64
}

export type Input = {
    identities: Identities,
    graph: Capture,
    settled: Group,
    demanded: Group,
    planned: Group
}

export type Output = {
    identities: u8[],
    graph: Graph,
    settled: GroupOutput,
    demanded: GroupOutput,
    planned: GroupOutput
}
