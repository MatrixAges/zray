import { allocateRows } from "core/row_buffer"
import columns from "memory/columns"

import type { Identities as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    allocateRows({
        target: in.target,
        count: in.count
    })

    columns.copyRowPrefix(in.target, in.source, in.count)
}
