export enum Phase {
    Start,
    Settled,
    Demanded,
    Planned,
    Done,
    Reject
}

export type Cursor = {
    body: u64,
    phase: Phase,
    visit: u64
}

export type Visits = {
    settled: u32[],
    demanded: u32[],
    planned: u32[]
}

export type Scan = {
    active: bool[],
    planned: u32[],
    changed: bool[],
    cursor: Cursor
}

export type Input = Scan & Visits

export enum PlanSource {
    Empty,
    Recorded,
    Replacement
}

export type Range = {
    end: u64,
    source: PlanSource,
    plan_first: u64,
    next_replacement: u64
}
