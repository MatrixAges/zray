import type { ReadColumn, ListColumn, WriteColumn } from "memory"
import type { Planned } from "../ordered/model"

export enum Phase {
    Start,
    Settled,
    Demanded,
    Planned,
    Done,
    Reject
}

export type Cursor = {
    body: u64,
    phase: Phase,
    visit: u64
}

export type Visits = {
    settled: u32[],
    demanded: u32[],
    planned: u32[]
}

export type Scan = {
    active: bool[],
    planned: u32[],
    changed: bool[],
    cursor: Cursor
}

export type Input = Scan & Visits & {
    agreed: bool
}

export type Advance = Input & {
    demand_count: u64
}

export type Advanced = {
    cursor: Cursor,
    cleared?: u8[]
}

export type PlanReads = {
    flags: ListColumn,
    keys: ReadColumn,
    paths: ReadColumn,
    transfers: ReadColumn,
    slot_first: ReadColumn
}

export type PlanWrites = {
    flags: WriteColumn,
    keys: WriteColumn,
    paths: WriteColumn,
    transfers: WriteColumn,
    slot_first: WriteColumn
}

export type Plans = Scan.Pick("planned", "changed") & {
    recorded: PlanReads,
    replacements: PlanReads
}

export type PlanUpdate = {
    body: u64,
    value: Planned
}

export type PlanUpdates = {
    functions: PlanUpdate[],
    entry?: Planned
}
