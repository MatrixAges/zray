import type { ReadColumn, ListColumn, WriteColumn, U8Buffer } from "memory"

export enum Phase {
    Start,
    Settled,
    Demanded,
    Planned,
    Done,
    Reject
}

export type Cursor = {
    body: u64,
    phase: Phase,
    visit: u64
}

export type Visits = {
    settled: u32[],
    demanded: u32[],
    planned: u32[]
}

export type Scan = {
    active: bool[],
    planned: u32[],
    changed: bool[],
    cursor: Cursor
}

export type Input = Scan & Visits & {
    agreed: bool
}

export type PlanReads = {
    flags: ListColumn,
    keys: ReadColumn,
    paths: ReadColumn,
    transfers: ReadColumn,
    slot_first: ReadColumn
}

export type PlanWrites = {
    flags: WriteColumn,
    keys: WriteColumn,
    paths: WriteColumn,
    transfers: WriteColumn,
    slot_first: WriteColumn
}

export type Plans = Scan.Pick("planned", "changed") & {
    recorded: PlanReads,
    replacements: PlanReads,
    functions: PlanWrites,
    entry: PlanWrites
}

export type Commit = {
    count: u64,
    width: u64,
    positions: ReadColumn,
    values: ReadColumn,
    records: WriteColumn,
    old_identities: U8Buffer,
    identities: u8[]
}

export type Publication = {
    plans: Plans,
    commit: Commit
}
