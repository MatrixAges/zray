<Module>
    <Type from="model" as="Visit" />
    <Type from="../model" as="Shortcut" />

    <Args in={Visit.Input} out={Visit.Step[]} />

    <If on={$in.recompute}>
        <If on={$in.phase == Shortcut.Phase.Demanded}>
            <Return
                value={[
                    Visit.Step.RestoreState,
                    Visit.Step.Analyze,
                    Visit.Step.RetainRestoredGrowth,
                    Visit.Step.SaveRecord
                ]}
            />
        </If>

        <Return
            value={[
                Visit.Step.RestoreState,
                Visit.Step.Analyze,
                Visit.Step.SaveRecord
            ]}
        />
    </If>

    <If on={$in.phase == Shortcut.Phase.Planned}>
        <Return
            value={[
                Visit.Step.ResetScratch,
                Visit.Step.FindRecord,
                Visit.Step.RecoverOnMiss,
                Visit.Step.StagePlan
            ]}
        />
    </If>

    <Return
        value={[
            Visit.Step.ResetScratch,
            Visit.Step.FindRecord,
            Visit.Step.RecoverOnMiss,
            Visit.Step.CompareResult
        ]}
    />
</Module>
