<Module>
    <Type from="model" as="Trace" />

    <Args in={Trace.Advance} out={Trace.Advanced} />

    <Call module="choose" in={$in.omit(["demand_count"])} />

    <If on={$ctx.choose.phase == Trace.Phase.Reject}>
        <Call
            fn="../../summaries/clear"
            in={{
                count: $in.demand_count
            }}
        />

        <Return
            value={{
                cursor: $ctx.choose,
                cleared: $ctx.clear
            }}
        />
    </If>

    <Return
        value={{
            cursor: $ctx.choose,
            cleared: null
        }}
    />
</Module>
