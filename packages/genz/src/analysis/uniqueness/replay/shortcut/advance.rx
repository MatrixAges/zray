<Module>
    <Type from="model" as="Trace" />

    <Args in={Trace.Input} out={Trace.Cursor} />

    <If on={!$in.agreed}>
        <Return
            value={{
                ...$in.cursor,
                phase: Trace.Phase.Reject
            }}
        />
    </If>

    <If
        on={$in.cursor.phase == Trace.Phase.Settled ||
            $in.cursor.phase == Trace.Phase.Demanded}
    >
        <Call
            fn="remaining"
            in={$in.omit([
                "active",
                "changed",
                "agreed"
            ])}
        />

        <Return value={$ctx.remaining} />
    </If>

    <Call
        fn="next"
        in={$in.omit([
            "settled",
            "demanded",
            "agreed"
        ])}
    />

    <If on={$ctx.next.phase != Trace.Phase.Start}>
        <Return value={$ctx.next} />
    </If>

    <Call
        fn="remaining"
        in={{
            ...$in.pick([
                "settled",
                "demanded",
                "planned"
            ]),
            cursor: $ctx.next
        }}
    />

    <Return value={$ctx.remaining} />
</Module>
