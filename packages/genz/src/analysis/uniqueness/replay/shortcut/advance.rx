<Module>
    <Type from="model" as="Trace" />

    <Args in={Trace.Advance} out={Trace.Cursor} />

    <Call module="choose" in={$in.omit(["demands"])} />

    <If on={$ctx.choose.phase == Trace.Phase.Reject}>
        <Call fn="../../summaries/clear" in={$in.demands} />
    </If>

    <Return value={$ctx.choose} />
</Module>
