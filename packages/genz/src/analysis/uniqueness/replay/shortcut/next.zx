import integers from "std:integer"

import { Phase } from "./model"

import type { Scan as Input, Cursor as Output } from "./model"

export default function (in: Input): Output {
    const { active, planned, changed, cursor } = in

    const first = cursor.phase == Phase.Planned ? cursor.body + 1 : cursor.body

    return loop({
        body: first,
        phase: Phase.Done,
        visit: 0
    }, {
        while: state => state.phase == Phase.Done && state.body < active.length,
        next: state => {
            const body = state.body
            if (active[body]) {
                const start = integers.widen(planned[body])
                const end = integers.widen(planned[body + 1])

                if (end != start + 1) {
                    state.phase = Phase.Reject
                } else if (changed[body]) {
                    state.phase = Phase.Start
                }
            }

            if (state.phase == Phase.Done) {
                state.body += 1
            }
        }
    })
}
