import integers from "std:integer"

import readPlan from "../record/read_plan"

import type { Planned } from "../ordered/model"
import type { PlanUpdate, PlanUpdates as Output, Plans as Input } from "./model"

export default function (in: Input): Output {
    const last = in.changed.length - 1
    const functions: PlanUpdate[] = []
    const entry: Planned? = null

    return loop({
        body: 0,
        replacement: 0,
        functions,
        entry
    }, {
        while: state => state.body < in.changed.length,
        next: state => {
            const body = state.body
            const start = in.planned[body]

            if (start != in.planned[body + 1]) {
                const replaced = in.changed[body]
                const value = readPlan({
                    source: replaced ? in.replacements : in.recorded,
                    row: replaced ? state.replacement : integers.widen(start)
                })

                if (body == last) {
                    state.entry = value
                } else {
                    state.functions = state.functions.push({
                        body,
                        value
                    })[0]
                }

                if (replaced) {
                    state.replacement += 1
                }
            }

            state.body += 1
        },
        return: state => ({
            functions: state.functions,
            entry: state.entry
        })
    })
}
