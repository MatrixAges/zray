import host from "ownership_host"
import { ReplayPhase } from "ownership_host"

import type { Execution } from "ownership_host"

export type Input = {
    frame: Execution,
    available: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { frame, available } = in

    if (!available) {
        return false
    }

    const recovered: u32? = null

    const accepted = loop({
        phase: ReplayPhase.Start,
        recovered
    }, {
        while: state =>
            state.phase != ReplayPhase.Done && state.phase != ReplayPhase.Reject,
        next: state => {
            const phase = host.scanOwnershipReplay(frame, state.phase, state.recovered)

            state.phase = phase

            if (phase != ReplayPhase.Done && phase != ReplayPhase.Reject) {
                state.recovered = host.recoverOwnershipVisit(frame, phase)
            }
        },
        return: state => state.phase == ReplayPhase.Done
    })

    if (accepted) {
        host.publishOwnershipReplay(frame)
    }

    host.finishOwnershipReplay(frame)

    return accepted
}
