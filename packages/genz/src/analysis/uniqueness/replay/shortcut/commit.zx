import integers from "std:integer"
import memory from "memory"

import type { Commit as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const first: u64 = 0

    const replaced = loop(first, {
        while: row => row < in.count,
        next: row => {
            const position = integers.widen(memory.readColumnU32(in.positions, row))
            const value = memory.readFixedBytes(in.values, row, in.width)

            memory.copyColumnValue(in.records, position, value)

            row += 1
        }
    })

    memory.copyU8s(in.old_identities, in.identities)
}
