import memory from "memory"
import columns from "memory/columns"

import reserve from "../../record/reserve"

import type { Append as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { target, used } = in

    reserve({
        rows: target.rows,
        available: columns.rowBufferBytes(target.rows).length / target.width,
        granule: target.granule,
        used,
        owner: target.owner
    })

    memory.writeColumnU32(target.positions, used, in.visit)
    memory.copyColumnValue(target.values, used, in.value)

    return used + 1
}
