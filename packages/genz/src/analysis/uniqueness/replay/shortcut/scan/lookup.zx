import memory from "memory"

import { Kind } from "../../../memo/encoding/model"
import probe from "../../../memo/encoding/replay_key"
import { Phase } from "../model"

import type { Found as Output, Lookup as Input } from "./model"

export default function (in: Input): Output {
    const { tables, cursor } = in

    const index = match cursor.phase {
        Phase.Settled => tables.settled.index,
        Phase.Demanded => tables.demanded.index,
        _ => tables.planned
    }

    const kind = match cursor.phase {
        Phase.Settled => Kind.Settled,
        Phase.Demanded => Kind.Demanded,
        _ => Kind.Planned
    }

    const state = memory.borrowListBytes(index.states, cursor.visit)

    const row = probe({
        kind,
        identity:
            memory.readFixedBytes(tables.identities, cursor.body, tables.digest_width),
        state,
        digest: tables.digest,
        table: index.table
    })

    return {
        row,
        state
    }
}
