<Module>
    <Type from="model" as="Scan" />
    <Type from="../model" as="Trace" />

    <Args in={Scan.Input} out={Scan.Output} />

    <Call module="initialize" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="next"
            in={{
                ...$in.omit(["recovered"]),
                ...$ctx.initialize,
                running:
                    $ctx.initialize.cursor.phase != Trace.Phase.Done &&
                    $ctx.initialize.cursor.phase != Trace.Phase.Reject
            }}
        />
    </Loop>

    <Return
        value={$ctx.next.pick([
            "cursor",
            "count"
        ])}
    />
</Module>
