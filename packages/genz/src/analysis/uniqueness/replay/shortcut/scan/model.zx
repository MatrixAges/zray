import type { ListColumn, ReadColumn } from "memory"
import type {
    Input as RecordedState,
    Restored
} from "../../../memo/restore/model"
import type { Probe } from "../../../memo/table/model"
import type { Demand, Settlement } from "../../ordered/columns"
import type { Advance, Cursor, Phase } from "../model"

export type Index = {
    table: Probe,
    states: ListColumn
}

export type Settlements = {
    index: Index,
    trace: Settlement,
    memo: Settlement
}

export type Demands = {
    index: Index,
    trace: Demand,
    memo: Demand
}

export type Tables = {
    settled: Settlements,
    demanded: Demands,
    planned: Index,
    identities: ReadColumn,
    digest_width: u64
}

export type Replacement = {
    visit: u32,
    row: u32
}

export type Hit = {
    phase: Phase,
    row: u32
}

export type Input = {
    replay: Advance,
    tables: Tables,
    recovery: Recovery,
    recovered?: u32
}

export type Output = {
    cursor: Cursor,
    replacements: Replacement[],
    cleared?: u8[],
    restored?: Restored,
    digest?: u8[],
    hits: Hit[]
}

export type Resume =
    Input.Omit("recovered", "recovery") & Output.Pick("replacements") & {
        row: u64
    }

export type Recovery = {
    summaries: RecordedState.Pick("input", "output", "inputs", "outputs"),
    callees: u32[][]
}

export type Restore = Recovery & {
    cursor: Cursor,
    source: u8[]
}

export type Lookup = {
    tables: Tables,
    cursor: Cursor
}

export type Found = {
    row?: u32,
    digest: u8[],
    state: u8[]
}

export type Compare = Lookup & {
    row: u64
}

export type Consume = Compare & Output.Pick("replacements")

export type Consumed = Output.Pick("replacements") & {
    agreed: bool
}

export type Traversal = Input.Omit("recovered") & Output & {
    running: bool
}

export type Miss = {
    scan: Traversal,
    digest: u8[],
    source: u8[]
}
