import integers from "std:integer"

import advance from "../advance.rx"
import { Phase } from "../model"
import consume from "./consume"
import lookup from "./lookup"
import resume from "./resume.rx"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    const { replay, tables, replacements, arenas } = in
    const { recovered, count } = in

    const start = match {
        recovered == null => {
            cursor: advance(replay),
            count
        },
        _ => resume({
            replay,
            tables,
            replacements,
            arenas,
            count,
            row: integers.widen(recovered)
        })
    }

    return loop({
        ...start,
        missed: false
    }, {
        while: state => !state.missed && state.cursor.phase != Phase.Done &&
            state.cursor.phase != Phase.Reject,
        next: state => {
            const { cursor } = state

            const hit = lookup({
                tables,
                cursor
            })

            if (hit == null) {
                state.missed = true
            } else {
                const result = consume({
                    tables,
                    cursor,
                    row: integers.widen(hit),
                    replacements,
                    arenas,
                    count: state.count
                })

                state.count = result.count
                state.cursor = advance({
                    ...replay.omit([
                        "cursor",
                        "agreed"
                    ]),
                    cursor,
                    agreed: result.agreed
                })
            }
        },
        return: state => state.pick([
            "cursor",
            "count"
        ])
    })
}
