<Module>
    <Type from="model" as="Scan" />
    <Type from="../model" as="Trace" />

    <Args in={Scan.Restore} out={bool} />

    <Call
        module="../../../memo/restore/run"
        in={{
            normalized: $in.normalized,
            renewed: $in.renewed,
            state: {
                ...$in.summaries,
                source: $in.source,
                body: $in.cursor.body,
                callees: $in.callees[$in.cursor.body],
                demanded: $in.cursor.phase == Trace.Phase.Demanded
            }
        }}
    />

    <Return value={$ctx.run} />
</Module>
