import integers from "std:integer"

import type { Consumed as Output, Consume as Input } from "./model"

export default function (in: Input): Output {
    const replacement = {
        visit: integers.narrow(in.cursor.visit),
        row: integers.narrow(in.row)
    }

    return {
        agreed: true,
        replacements: in.replacements.push(replacement)[0]
    }
}
