<Module>
    <Type from="model" as="Scan" />

    <Args in={Scan.Resume} out={Scan.Output} />

    <Call
        module="consume"
        in={{
            ...$in.omit(["replay"]),
            cursor: $in.replay.cursor
        }}
    />

    <Call
        module="../advance"
        in={{
            ...$in.replay,
            agreed: $ctx.consume.agreed
        }}
    />

    <Return
        value={{
            cursor: $ctx.advance.cursor,
            count: $ctx.consume.count,
            cleared: $ctx.advance.cleared
        }}
    />
</Module>
