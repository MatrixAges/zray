<Module>
    <Type from="model" as="Scan" />
    <Type from="../model" as="Trace" />

    <Args in={Scan.Miss} out={Scan.Traversal} />

    <Call
        module="restore"
        in={{
            ...$in.scan.recovery,
            cursor: $in.scan.cursor,
            source: $in.source
        }}
    />

    <If on={$ctx.restore}>
        <Return
            value={{
                ...$in.scan,
                running: false
            }}
        />
    </If>

    <Call
        module="../advance"
        in={{
            ...$in.scan.replay,
            cursor: $in.scan.cursor,
            agreed: false
        }}
    />

    <Return
        value={{
            ...$in.scan,
            cursor: $ctx.advance,
            running:
                $ctx.advance.phase != Trace.Phase.Done &&
                $ctx.advance.phase != Trace.Phase.Reject
        }}
    />
</Module>
