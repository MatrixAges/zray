import memory from "memory"

import equal from "./ordered/integers"

import type { Build as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const previous = in.source.previous

    if (previous == null) {
        return false
    }

    const calls = previous.callees

    return loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.changed.length,
        next: state => {
            const index = state.index

            if (in.changed[index]) {
                const first = calls.starts[index]
                const count = calls.starts[index + 1] - first

                state.valid = equal({
                    left: memory.borrowU32Range(calls.edges, first, count),
                    right: in.source.callees[index]
                })
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
