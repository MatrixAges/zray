<Module>
    <Type from="model" as="Replay" />

    <Args in={Replay.Input} out={Replay.State} />

    <Call fn="matched" in={$in} />

    <If on={$ctx.matched}>
        <Call fn="changes" in={$in} />

        <Call
            fn="compatible"
            in={{
                source: $in,
                changed: $ctx.changes
            }}
        />

        <If on={$ctx.compatible}>
            <Call
                fn="initial"
                in={{
                    source: $in,
                    changed: $ctx.changes
                }}
            />

            <Return value={$ctx.initial} />
        </If>
    </If>

    <Return
        value={{
            following: false,
            changed: [],
            settled: [],
            demanded: [],
            planned: []
        }}
    />
</Module>
