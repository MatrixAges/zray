<Module>
    <Type from="model" as="Replay" />

    <Args in={Replay.Input} out={Replay.State} />

    <Call fn="matched" in={$in} />

    <If on={$ctx.matched}>
        <Call fn="changes" in={$in} />

        <Call
            fn="compatible"
            in={{
                source: $in,
                changed: $ctx.changes
            }}
        />

        <If on={$ctx.compatible}>
            <Return
                value={{
                    following: true,
                    changed: $ctx.changes
                }}
            />
        </If>
    </If>

    <Return
        value={{
            following: false,
            changed: []
        }}
    />
</Module>
