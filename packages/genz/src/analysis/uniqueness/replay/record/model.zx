import type { Step } from "../model"
import type { DemandPair, SettlementPair } from "../ordered/columns"
import type { PlanReads } from "../shortcut/model"

export type Plans = {
    left: PlanReads,
    right: PlanReads
}

export type Comparison = {
    cursor: u64,
    settled?: SettlementPair.Omit("previous", "current"),
    demanded?: DemandPair.Omit("previous", "current"),
    planned?: Plans
}

export type Input = {
    selection?: Step,
    comparison: Comparison.Omit("cursor"),
}

export type Output = {
    following: bool,
    next?: u32
}
