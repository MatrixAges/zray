<Module>
    <Type from="model" as="Record" />

    <Args in={Record.Input} out={Record.Output} />

    <If on={$in.selection != null}>
        <Call fn="../select" in={$in.selection} />

        <If on={$ctx.select.cursor != null}>
            <Call
                module="compare"
                in={{
                    ...$in.comparison,
                    cursor: $ctx.select.cursor
                }}
            />

            <Return
                value={{
                    following: $ctx.compare,
                    next: $ctx.select.next
                }}
            />
        </If>

        <Return
            value={{
                following: $ctx.select.following,
                next: $ctx.select.next
            }}
        />
    </If>

    <Return
        value={{
            following: false,
            next: null
        }}
    />
</Module>
