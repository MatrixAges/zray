import type { U32Buffer } from "memory"
import type { Graph } from "./graph/model"

export type Previous = {
    key: u8[],
    identities: u8[],
    callees: Graph
}

export type Input = {
    previous?: Previous,
    key: u8[],
    identities: u8[],
    callees: u32[][]
}

export type State = {
    following: bool,
    changed: bool[]
}

export type Build = {
    source: Input,
    changed: bool[]
}

export type Step = {
    positions: U32Buffer,
    changed: bool,
    verify: bool,
    index: u64,
    starts: u32[]
}

export type Selection = {
    following: bool,
    cursor?: u64
}
