import type { Build as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const { source, changed } = in

    const previous = source.previous
    const settled: u32[] = []
    const demanded: u32[] = []
    const planned: u32[] = []

    if (previous == null) {
        return {
            following: false,
            changed: [],
            settled,
            demanded,
            planned
        }
    }

    return loop({
        settled,
        demanded,
        planned,
        index: 0
    }, {
        while: state => state.index < changed.length,
        next: state => {
            state.settled = state.settled.push(previous.settled[state.index])[0]
            state.demanded = state.demanded.push(previous.demanded[state.index])[0]
            state.planned = state.planned.push(previous.planned[state.index])[0]
            state.index += 1
        },
        return: state => ({
            following: true,
            changed,
            ...state.pick([
                "settled",
                "demanded",
                "planned"
            ])
        })
    })
}
