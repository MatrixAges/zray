import { sort_less, sort_equal, sort_greater } from "./const"

import type { Normalized } from "./model"

export type Input = Normalized[]

export type Output = Input

export default function (in: Input): Output {
    if (in.length < 2) {
        return in
    }

    return in.sort(
        (left, right) => match {
            left.id < right.id => sort_less,
            left.id == right.id => sort_equal,
            _ => sort_greater
        }
    )[0]
}
