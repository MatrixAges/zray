import equal from "./normalized_equal"
import ordered from "./order_normalized"

import type { Input, Output } from "./normalized_equal"

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    if (equal(in)) {
        return true
    }

    return equal({
        left: ordered(in.left),
        right: ordered(in.right)
    })
}
