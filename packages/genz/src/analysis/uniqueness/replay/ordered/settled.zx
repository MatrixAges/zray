import bytes from "std:bytes"
import memory from "memory"

import levels from "./levels"

import type { SettlementPair as Input } from "./columns"

export type Output = bool

export default function (in: Input): Output {
    const { previous, current, left, right } = in

    const count = memory.listLength(left.callees, previous)

    if (count != memory.listLength(right.callees, current)) {
        return false
    }

    const agreed = loop({
        index: 0,
        equal: true
    }, {
        while: state => state.equal && state.index < count,
        next: state => {
            const { index } = state
            const before = memory.readListU32(left.callees, previous, index)
            const after = memory.readListU32(right.callees, current, index)

            state.equal = before == after && levels({
                left:
                    bytes.fromText(
                        memory.readListText(
                            left.levels,
                            previous,
                            index
                        )
                    ),
                right:
                    bytes.fromText(
                        memory.readListText(
                            right.levels,
                            current,
                            index
                        )
                    )
            })
            state.index += 1
        },
        return: state => state.equal
    })

    return agreed && levels({
        left: memory.borrowListBytes(left.output, previous),
        right: memory.borrowListBytes(right.output, current)
    })
}
