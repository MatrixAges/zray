import { sort_less, sort_equal, sort_greater } from "./const"

import type { Renewed } from "./model"

export type Input = Renewed[]

export type Output = Input

export default function (in: Input): Output {
    if (in.length < 2) {
        return in
    }

    return in.sort(
        (left, right) => match {
            left.key < right.key => sort_less,
            left.key == right.key => sort_equal,
            _ => sort_greater
        }
    )[0]
}
