import ordered from "./order_renewed"
import equal from "./renewed_equal"

import type { Input, Output } from "./renewed_equal"

export default function (in: Input): Output {
    if (in.left.length != in.right.length) {
        return false
    }

    if (equal(in)) {
        return true
    }

    return equal({
        left: ordered(in.left),
        right: ordered(in.right)
    })
}
