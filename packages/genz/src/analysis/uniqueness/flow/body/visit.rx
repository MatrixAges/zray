<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Visit} out={bool} />

    <Call
        module="select"
        in={{
            source: $in.source,
            counts: $in.environment.counts,
            facts: $in.facts
        }}
    />

    <Call
        module="analyze"
        in={{
            ...$in.omit([
                "environment",
                "source",
                "target",
                "facts"
            ]),
            body: {
                ...$ctx.select,
                ...$in.environment,
                expressions: $in.source.expressions
            }
        }}
    />

    <Call
        fn="publish"
        in={{
            target: $in.target,
            summary: $ctx.analyze.omit(["changed"])
        }}
    />

    <Return value={$ctx.analyze.changed} />
</Module>
