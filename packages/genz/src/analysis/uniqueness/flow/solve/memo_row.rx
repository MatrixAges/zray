<Module>
    <Type from="model" as="Flow" />
    <Type from="effect" as="Effect" />

    <Args in={Flow.MemoCursor} out={Flow.MemoCursor} />

    <Store from="execution" as="flow" />

    <Call
        fn="layers"
        in={$in.pick([
            "order",
            "hits",
            "position"
        ])}
    />

    <If on={$ctx.layers.keep}>
        <Call
            fn="submit"
            in={{
                step: Effect.Step.KeepMemo,
                row: $ctx.layers.body
            }}
            setter={[$store.flow.exchange]}
        />

        <Else>
            <Call
                fn="submit"
                in={{
                    step: Effect.Step.PublishMemo,
                    row: $ctx.layers.body
                }}
                setter={[$store.flow.exchange]}
            />
        </Else>
    </If>

    <Return
        value={{
            ...$in,
            position: $in.position + 1,
            running: $in.position + 1 < $in.end
        }}
    />
</Module>
