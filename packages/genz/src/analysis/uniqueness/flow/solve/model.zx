import type { FlowExecution, FlowPlan } from "ownership_host"
import type { Advance } from "../fixpoint/model"

export type Plan = FlowPlan

export type Input = {
    flow: FlowExecution,
    remembered: bool
}

export type Layers = Input & {
    order: u32[],
    ends: u64[],
    hits: bool[]
}

export type LayerCursor = Layers & {
    layer: u64,
    first: u64,
    running: bool
}

export type MemoCursor = Layers.Pick("flow", "order", "hits") & {
    position: u64,
    end: u64,
    running: bool
}

export type RecursiveCursor = {
    flow: FlowExecution,
    queue: Advance,
    running: bool
}
