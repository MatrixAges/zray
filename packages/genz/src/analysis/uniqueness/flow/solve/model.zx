import type { Functions } from "../../layers/model"
import type { Advance } from "../fixpoint/model"

export type Input = {
    functions: Functions,
    remembered: bool
}

export type Layers = Input.Pick("remembered") & {
    order: u32[],
    ends: u64[],
    hits: bool[]
}

export type LayerCursor = Layers & {
    layer: u64,
    first: u64,
    running: bool
}

export type MemoCursor = Layers.Pick("order", "hits") & {
    position: u64,
    end: u64,
    running: bool
}

export type RecursiveCursor = {
    queue: Advance,
    started: bool,
    running: bool
}
