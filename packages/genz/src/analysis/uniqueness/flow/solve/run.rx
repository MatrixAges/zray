<Module>
    <Type from="model" as="Flow" />
    <Type from="effect" as="Effect" />

    <Args in={Flow.Input} out={void} />

    <Store from="execution" as="flow" />

    <Call
        fn="submit"
        in={{
            step: Effect.Step.Initialize
        }}
        setter={[$store.flow.exchange]}
    />

    <Task name="initial" out={$ctx.read}>
        <Call fn="read" in={$store.flow.exchange} />
    </Task>

    <Call
        module="../../layers/plan"
        in={{
            ...$in.functions,
            held: $ctx.task.initial.held,
            remembered: $in.remembered
        }}
    />

    <If on={$ctx.plan == null}>
        <Call
            module="../fixpoint/create"
            in={{
                ...$in.functions,
                held: $ctx.task.initial.held
            }}
        />

        <Loop on={$in.running}>
            <Call
                module="recursive"
                in={{
                    queue: {
                        ...$ctx.create,
                        changed: null
                    },
                    started: false,
                    running: true
                }}
            />
        </Loop>

        <Else>
            <If on={$in.remembered}>
                <Call
                    fn="submit"
                    in={{
                        step: Effect.Step.ReserveMemo
                    }}
                    setter={[$store.flow.exchange]}
                />
            </If>

            <If on={$ctx.plan.order.length != 0}>
                <Call
                    fn="submit"
                    in={{
                        step: Effect.Step.OpenWorkers
                    }}
                    setter={[$store.flow.exchange]}
                />

                <Call fn="read" in={$store.flow.exchange} />

                <Loop on={$in.running}>
                    <Call
                        module="layer"
                        in={{
                            remembered: $in.remembered,
                            order: $ctx.plan.order,
                            ends: $ctx.plan.ends,
                            hits: $ctx.read.hits,
                            layer: 0,
                            first: 0,
                            running: $ctx.plan.ends.length != 0
                        }}
                    />
                </Loop>
            </If>
        </Else>
    </If>
</Module>
