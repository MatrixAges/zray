<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={void} />

    <Call fn="index.initializeFlow" in={$in.flow} />
    <Call fn="index.planFlow" in={$in.flow} />

    <If on={$ctx.planFlow == null}>
        <Call fn="index.openRecursiveFlow" in={$in.flow} />

        <Loop on={$in.running}>
            <Call
                module="recursive"
                in={{
                    flow: $in.flow,
                    queue: {
                        ...$ctx.openRecursiveFlow,
                        changed: null
                    },
                    running: true
                }}
            />
        </Loop>

        <Else>
            <If on={$in.remembered}>
                <Call fn="index.reserveFlowMemo" in={$in.flow} />
            </If>

            <If on={$ctx.planFlow.order.length != 0}>
                <Call fn="index.openFlowWorkers" in={$in.flow} />

                <Loop on={$in.running}>
                    <Call
                        module="layer"
                        in={{
                            ...$in,
                            order: $ctx.planFlow.order,
                            ends: $ctx.planFlow.ends,
                            hits: $ctx.openFlowWorkers,
                            layer: 0,
                            first: 0,
                            running: $ctx.planFlow.ends.length != 0
                        }}
                    />
                </Loop>
            </If>
        </Else>
    </If>
</Module>
