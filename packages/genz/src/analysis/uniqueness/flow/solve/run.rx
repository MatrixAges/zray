<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={void} />

    <Call fn="index.initializeFlow" in={$in.flow} />

    <Call
        module="../../layers/plan"
        in={{
            ...$in.functions,
            held: $ctx.initializeFlow,
            remembered: $in.remembered
        }}
    />

    <If on={$ctx.plan == null}>
        <Call fn="index.openRecursiveFlow" in={$in.flow} />

        <Loop on={$in.running}>
            <Call
                module="recursive"
                in={{
                    flow: $in.flow,
                    queue: {
                        ...$ctx.openRecursiveFlow,
                        changed: null
                    },
                    running: true
                }}
            />
        </Loop>

        <Else>
            <If on={$in.remembered}>
                <Call fn="index.reserveFlowMemo" in={$in.flow} />
            </If>

            <If on={$ctx.plan.order.length != 0}>
                <Call fn="index.openFlowWorkers" in={$in.flow} />

                <Loop on={$in.running}>
                    <Call
                        module="layer"
                        in={{
                            flow: $in.flow,
                            remembered: $in.remembered,
                            order: $ctx.plan.order,
                            ends: $ctx.plan.ends,
                            hits: $ctx.openFlowWorkers,
                            layer: 0,
                            first: 0,
                            running: $ctx.plan.ends.length != 0
                        }}
                    />
                </Loop>
            </If>
        </Else>
    </If>
</Module>
