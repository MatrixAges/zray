import integers from "std:integer"

import type { MemoCursor } from "./model"

export type Input = MemoCursor.Pick("order", "hits", "position")

export type Output = {
    body: u64,
    keep: bool
}

export default function (in: Input): Output {
    const body = integers.widen(in.order[in.position])

    return {
        body,
        keep: in.hits[body]
    }
}
