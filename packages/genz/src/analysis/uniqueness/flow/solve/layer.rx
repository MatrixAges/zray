<Module>
    <Type from="model" as="Flow" />
    <Type from="effect" as="Effect" />

    <Args in={Flow.LayerCursor} out={Flow.LayerCursor} />

    <Store from="execution" as="flow" />

    <Call
        fn="submit"
        in={{
            step: Effect.Step.SolveLayer,
            order: $in.order,
            first: $in.first,
            end: $in.ends[$in.layer]
        }}
        setter={[$store.flow.exchange]}
    />

    <If on={$in.remembered && $in.first < $in.ends[$in.layer]}>
        <Loop on={$in.running}>
            <Call
                module="memo_row"
                in={{
                    order: $in.order,
                    hits: $in.hits,
                    position: $in.first,
                    end: $in.ends[$in.layer],
                    running: true
                }}
            />
        </Loop>
    </If>

    <Return
        value={{
            ...$in,
            layer: $in.layer + 1,
            first: $in.ends[$in.layer],
            running: $in.layer + 1 < $in.ends.length
        }}
    />
</Module>
