import bytes from "std:bytes"
import integers from "std:integer"

import word from "./word"

import type { Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const start_index: u64 = 0
    const empty: u8[][] = []

    const { parts } = loop(
        {
            index: start_index,
            parts: empty
        },
        {
            while: state => state.index < in.call_functions.length,
            next: state => {
                const callee = integers.widen(in.call_functions[state.index])
                const held = in.held[callee]
                const text = in.text_held[callee]

                state.parts = state.parts
                    .push(
                        word({
                            value: integers.narrow(held.length),
                            little_endian: in.little_endian
                        })
                    )[0]
                    .push(held)[0]
                    .push(
                        word({
                            value: integers.narrow(text.length),
                            little_endian: in.little_endian
                        })
                    )[0]
                    .push(text)[0]
                    .push(
                        in.written[callee]
                    )[0]
                state.index += 1
            }
        }
    )

    return bytes.join(bytes.fromText(""), parts)
}
