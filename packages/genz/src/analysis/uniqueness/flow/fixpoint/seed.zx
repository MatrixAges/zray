import integers from "std:integer"

import { queued, unlisted } from "./const"

import type { Input as Program, Seed as Output } from "./model"

export type Input = Program.Pick("native_modules", "held")

export default function (in: Input): Output {
    const zero: u32 = 0
    const initial_indices: u32[] = in.native_modules.map(item => zero)[0]
    const initial_queued: u8[] = in.native_modules.map(item => unlisted)[0]

    return loop({
        remaining: in.native_modules.length,
        count: 0,
        indices: initial_indices,
        queued: initial_queued
    }, {
        while: state => state.remaining != 0,
        next: state => {
            state.remaining -= 1

            const body = state.remaining
            const active =
                in.native_modules[body] == null && in.held[body].length != 0

            state.queued[body] = active ? queued : unlisted

            if (active) {
                state.indices[state.count] = integers.narrow(body)
                state.count += 1
            }
        },
        return: state => ({
            indices: state.indices,
            queued: state.queued,
            count: state.count
        })
    })
}
