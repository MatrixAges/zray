import host from "ownership_host"

import advance from "./advance"

import type { FlowFixpoint } from "ownership_host"
import type { Advance } from "./model"

export type Input = {
    flow: FlowFixpoint,
    queue: Advance
}

export type Output = void

export default function (in: Input): Output {
    const { flow, queue } = in

    const changed: u32? = null

    const settled = loop({
        count: queue.count,
        changed,
        active: true
    }, {
        while: state => state.active,
        next: state => {
            const visit = advance({
                ...queue,
                count: state.count,
                changed: state.changed
            })
            const index = visit.index

            if (index == null) {
                state.active = false
            } else {
                if (visit.retain) {
                    host.retainFlowFacts(flow, index)
                }

                const grew = host.visitRecursiveFlow(flow, index, visit.retain)

                state.count = visit.count
                state.changed = grew ? index : null
            }
        }
    })
}
