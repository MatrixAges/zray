import integers from "std:integer"
import memory from "memory"

import type { Edges } from "./model"

export type Input = Edges.Pick("first", "items", "fill") & {
    calls: u32[],
    caller: u32
}

export type Output = void

export default function (in: Input): Output {
    const result = loop({
        index: in.calls.length
    }, {
        while: row => row.index != 0,
        next: row => {
            row.index -= 1

            const { calls, first, items, fill, caller } = in
            const target = integers.widen(calls[row.index])
            const end = memory.readU64(first, target)

            if (fill) {
                memory.writeU64(first, target, end - 1)
                memory.writeU32(items, end - 1, caller)
            } else {
                memory.writeU64(first, target, end + 1)
            }
        }
    })
}
