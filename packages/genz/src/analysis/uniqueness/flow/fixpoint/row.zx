import integers from "std:integer"

import type { Graph } from "./model"

export type Input = Graph & {
    calls: u32[],
    caller: u32,
    fill: bool
}

export type Output = Graph

export default function (in: Input): Output {
    return loop({
        index: in.calls.length,
        first: in.first,
        items: in.items
    }, {
        while: row => row.index != 0,
        next: row => {
            row.index -= 1

            const target = integers.widen(in.calls[row.index])
            const end = row.first[target]

            if (in.fill) {
                row.first[target] = end - 1
                row.items[end - 1] = in.caller
            } else {
                row.first[target] = end + 1
            }
        },
        return: row => ({
            first: row.first,
            items: row.items
        })
    })
}
