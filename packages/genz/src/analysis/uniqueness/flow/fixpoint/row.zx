import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import memory from "memory"

import type { Expressions } from "core/expression_table/model"
import type { Edges } from "./model"

export type Input = Edges.Pick("first", "items", "fill") & {
    table: Expressions,
    caller: u32
}

export type Output = void

export default function (in: Input): Output {
    loop({
        source: in,
        index: in.table.kinds.length
    }, {
        while: row => row.index != 0,
        next: row => {
            row.index -= 1

            const { table, first, items, fill, caller } = row.source

            if (table.kinds[row.index] == ExpressionKind.Call) {
                const payload = integers.widen(table.payloads[row.index])
                const target =
                    integers.widen(table.call_functions[payload])
                const end = memory.readU64(first, target)

                if (!fill) {
                    memory.writeU64(first, target, end + 1)
                } else {
                    memory.writeU64(first, target, end - 1)
                    memory.writeU32(
                        items,
                        end - 1,
                        caller
                    )
                }
            }
        }
    })
}
