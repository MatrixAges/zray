import integers from "std:integer"

import { queued, retained_queued, retained_unlisted, unlisted } from "./const"

import type { Advance as Input, Stack } from "./model"

export type Output = Stack & {
    count: u64
}

export default function (in: Input): Output {
    const changed = in.changed

    if (changed == null) {
        return {
            indices: in.indices,
            queued: in.queued,
            count: in.count
        }
    }

    const body = integers.widen(changed)
    const end = in.first[body + 1]

    return loop({
        count: in.count,
        position: in.first[body],
        indices: in.indices,
        queued: in.queued
    }, {
        while: state => state.position < end,
        next: state => {
            const caller = in.items[state.position]
            const index = integers.widen(caller)

            const status = state.queued[index]
            const next = match status {
                unlisted => queued,
                retained_unlisted => retained_queued,
                _ => status
            }

            if (next != status) {
                state.queued[index] = next
                state.indices[state.count] = caller
                state.count += 1
            }

            state.position += 1
        },
        return: state => ({
            indices: state.indices,
            queued: state.queued,
            count: state.count
        })
    })
}
