import integers from "std:integer"

import { unlisted } from "./const"
import row from "./row"

import type { Expressions } from "core/expression_table/model"
import type { Graph } from "./model"

export type Input = Graph & {
    expressions: Expressions[],
    queued: u8[],
    fill: bool
}

export type Output = Graph

export default function (in: Input): Output {
    const zero: u64 = 0

    const initial_first: u64[] = match {
        in.fill => in.first,
        _ => in.expressions.map(item => zero)[0].push(zero)[0]
    }

    return loop({
        body: in.expressions.length,
        first: initial_first,
        items: in.items
    }, {
        while: state => state.body != 0,
        next: state => {
            state.body -= 1

            if (in.queued[state.body] != unlisted) {
                const updated = row({
                    calls: in.expressions[state.body].call_functions,
                    caller: integers.narrow(state.body),
                    first: state.first,
                    items: state.items,
                    fill: in.fill
                })

                state.first = updated.first
                state.items = updated.items
            }
        },
        return: state => ({
            first: state.first,
            items: state.items
        })
    })
}
