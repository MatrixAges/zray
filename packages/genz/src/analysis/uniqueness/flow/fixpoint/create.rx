<Module>
    <Type from="model" as="Flow" />

    <Args in={Flow.Input} out={Flow.Queue} />

    <Call
        fn="seed"
        in={$in.pick([
            "native_modules",
            "held"
        ])}
    />

    <Task name="counts" out={$ctx.edges}>
        <Call
            fn="edges"
            in={{
                expressions: $in.expressions,
                queued: $ctx.seed.queued,
                first: [],
                items: [],
                fill: false
            }}
        />
    </Task>

    <Call
        fn="allocate"
        in={{
            first: $ctx.task.counts.first,
            count: $in.expressions.length
        }}
    />

    <Call
        fn="edges"
        in={{
            expressions: $in.expressions,
            queued: $ctx.seed.queued,
            first: $ctx.allocate.first,
            items: $ctx.allocate.items,
            fill: true
        }}
    />

    <Call
        fn="retention"
        in={{
            expressions: $in.expressions,
            queued: $ctx.seed.queued
        }}
    />

    <Return
        value={{
            indices: $ctx.seed.indices,
            queued: $ctx.retention,
            first: $ctx.edges.first,
            items: $ctx.edges.items,
            count: $ctx.seed.count
        }}
    />
</Module>
