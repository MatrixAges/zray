import integers from "std:integer"

import { queued, retained_queued, unlisted } from "./const"

import type { Expressions } from "core/expression_table/model"

export type Input = {
    expressions: Expressions[],
    queued: u8[]
}

export type Output = u8[]

export default function (in: Input): Output {
    return loop({
        index: 0,
        queued: in.queued
    }, {
        while: state => state.index < in.expressions.length,
        next: state => {
            const index = state.index

            if (state.queued[index] == queued) {
                const calls = in.expressions[index].call_functions
                const revisit = calls.some(
                    callee => {
                        const target = integers.widen(callee)
                        const status = state.queued[target]

                        return match status {
                            unlisted => false,
                            retained_queued => true,
                            _ => target >= index
                        }
                    }
                )

                if (revisit) {
                    state.queued[index] = retained_queued
                }
            }

            state.index += 1
        },
        return: state => state.queued
    })
}
