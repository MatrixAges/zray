import type { Graph as Output } from "./model"

export type Input = {
    first: u64[],
    count: u64
}

export default function (in: Input): Output {
    const prefix = loop({
        row: 0,
        total: 0,
        first: in.first
    }, {
        while: state => state.row <= in.count,
        next: state => {
            if (state.row < in.count) {
                state.total += state.first[state.row]
                state.first[state.row] = state.total
            } else {
                state.first[in.count] = state.total
            }
            state.row += 1
        },
        return: state => ({
            total: state.total,
            first: state.first
        })
    })

    const empty: u32[] = []
    const zero: u32 = 0

    const items = loop({
        row: 0,
        values: empty
    }, {
        while: state => state.row < prefix.total,
        next: state => {
            state.values = state.values.push(zero)[0]
            state.row += 1
        },
        return: state => state.values
    })

    return {
        first: prefix.first,
        items
    }
}
