import type { Functions } from "../../layers/model"

export type Stack = {
    indices: u32[],
    queued: u8[]
}

export type Input = Functions & {
    held: bool[][]
}

export type Queue = Stack & {
    first: u64[],
    items: u32[],
    count: u64
}

export type Advance = Queue & {
    changed?: u32
}

export type Visit = Stack & {
    count: u64,
    index?: u32,
    retain: bool
}

export type Graph = {
    first: u64[],
    items: u32[]
}

export type Seed = Stack & {
    count: u64
}
