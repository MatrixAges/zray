import integers from "std:integer"

import { retained_queued, retained_unlisted, unlisted } from "./const"

import type { Advance, Visit as Output } from "./model"

export type Input = Advance.Pick("indices", "queued", "count")

export default function (in: Input): Output {
    if (in.count == 0) {
        return {
            count: 0,
            index: null,
            retain: false,
            indices: in.indices,
            queued: in.queued
        }
    }

    const count = in.count - 1
    const index = in.indices[count]
    const body = integers.widen(index)
    const retain = in.queued[body] == retained_queued

    const next_queued = loop({
        done: false,
        queued: in.queued
    }, {
        while: state => !state.done,
        next: state => {
            state.queued[body] = retain ? retained_unlisted : unlisted
            state.done = true
        },
        return: state => state.queued
    })

    return {
        count,
        index,
        retain,
        indices: in.indices,
        queued: next_queued
    }
}
