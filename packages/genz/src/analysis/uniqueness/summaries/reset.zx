import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"
import { Mode } from "./model"

import type { Lifecycle as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { layout } = in

    const count = layout.input_first.length
    const all = encode(Knowledge.All)
    const none = encode(Knowledge.None)
    const empty: u8[] = []

    const input_cells = loop({
        row: 0,
        cells: empty
    }, {
        while: state => state.row < count,
        next: state => {
            const internal = in.active[state.row]
            const reached = in.mode == Mode.Initialize || in.known[state.row]
            const next = state.row + 1
            const start = layout.input_first[state.row]
            const end = match {
                next == count => layout.input_count,
                _ => layout.input_first[next]
            }
            const value = internal && reached ? all : none

            state.cells = loop({
                pos: start,
                cells: state.cells
            }, {
                while: inner => inner.pos < end,
                next: inner => {
                    inner.cells = inner.cells.push(value)[0]
                    inner.pos += 1
                },
                return: inner => inner.cells
            })

            state.row = next
        },
        return: state => state.cells
    })

    return loop({
        row: 0,
        cells: input_cells
    }, {
        while: state => state.row < count,
        next: state => {
            const internal = in.active[state.row]
            const next = state.row + 1
            const start = layout.output_first[state.row]
            const end = match {
                next == count => layout.output_count,
                _ => layout.output_first[next]
            }
            const value = internal ? all : none

            state.cells = loop({
                pos: start,
                cells: state.cells
            }, {
                while: inner => inner.pos < end,
                next: inner => {
                    inner.cells = inner.cells.push(value)[0]
                    inner.pos += 1
                },
                return: inner => inner.cells
            })

            state.row = next
        },
        return: state => state.cells
    })
}
