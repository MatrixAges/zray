import memory from "memory"

import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"
import { Mode } from "./model"

import type { Lifecycle as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { layout, guarantees } = in

    const count = layout.input_first.length
    const all = encode(Knowledge.All)
    const none = encode(Knowledge.None)
    const initial: u64 = 0

    const filled = loop(initial, {
        while: row => row < count,
        next: row => {
            const internal = in.active[row]
            const reached = in.mode == Mode.Initialize || in.known[row]
            const next = row + 1
            const input = layout.input_first[row]
            const output = layout.output_first[row]

            const input_end = match {
                next == count => layout.input_count,
                _ => layout.input_first[next]
            }
            const output_end = match {
                next == count => layout.output_count,
                _ => layout.output_first[next]
            }

            if (input != input_end) {
                memory.fillByteRange(
                    guarantees,
                    input,
                    input_end - input,
                    internal && reached ? all : none
                )
            }

            if (output != output_end) {
                memory.fillByteRange(
                    guarantees,
                    layout.input_count + output,
                    output_end - output,
                    internal ? all : none
                )
            }

            row = next
        }
    })
}
