<Module>
    <Type from="model" as="State" />

    <Args in={State.Create} out={State.Layout} />

    <Call fn="layout" in={$in.shape} />

    <Call
        fn="allocate"
        in={{
            layout: $ctx.layout,
            buffers: $in.buffers,
            allocator: $in.allocator
        }}
    />

    <Call
        fn="views"
        in={{
            cells: $ctx.allocate,
            views: $in.views
        }}
    />

    <Return value={$ctx.layout} />
</Module>
