import type { U8Buffer } from "memory"

export type Shape = {
    counts: u32[],
    input_types: u32[],
    output_types: u32[]
}

export type Layout = {
    input_first: u64[],
    output_first: u64[],
    input_count: u64,
    output_count: u64
}

export type Storage = {
    layout: Layout,
    guarantees: u8[],
    demands: u8[]
}

export enum Mode {
    Initialize,
    Reset,
    Clear,
    ClearWants
}

export type Lifecycle = {
    mode: Mode,
    layout: Layout,
    guarantees: U8Buffer,
    demands: U8Buffer,
    active: bool[],
    known: bool[]
}

export type Clear = {
    cells: U8Buffer,
    count: u64
}
