export type Shape = {
    counts: u32[],
    input_types: u32[],
    output_types: u32[]
}

export type Layout = {
    input_first: u64[],
    output_first: u64[],
    input_count: u64,
    output_count: u64
}

export type Cells = {
    layout: Layout,
    guarantees: u8[],
    demands: u8[]
}

export type Create = {
    shape: Shape
}

export enum Mode {
    Initialize,
    Reset,
    Clear,
    ClearWants
}

export type Facts = {
    layout: Layout,
    active: bool[],
    known: bool[]
}

export type Lifecycle = Facts & {
    mode: Mode
}

export type Clear = {
    count: u64
}
