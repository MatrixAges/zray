import type { Allocator, U8Buffer } from "memory"
import type { RowBuffer } from "memory/columns"

export type Shape = {
    counts: u32[],
    input_types: u32[],
    output_types: u32[]
}

export type Layout = {
    input_first: u64[],
    output_first: u64[],
    input_count: u64,
    output_count: u64
}

export type Buffers = {
    guarantees: U8Buffer,
    demands: U8Buffer
}

export type Cells = {
    layout: Layout,
    guarantees: u8[],
    demands: u8[]
}

export type Views = {
    input: RowBuffer,
    output: RowBuffer,
    inputs: RowBuffer,
    outputs: RowBuffer
}

export type Create = {
    shape: Shape,
    views: Views,
    buffers: Buffers,
    allocator: Allocator
}

export enum Mode {
    Initialize,
    Reset,
    Clear,
    ClearWants
}

export type Lifecycle = {
    mode: Mode,
    layout: Layout,
    guarantees: U8Buffer,
    demands: U8Buffer,
    active: bool[],
    known: bool[]
}

export type Clear = {
    cells: U8Buffer,
    count: u64
}
