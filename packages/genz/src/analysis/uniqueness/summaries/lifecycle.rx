<Module>
    <Type from="model" as="State" />

    <Args in={State.Lifecycle} out={void} />

    <Switch on={$in.mode}>
        <Case value={State.Mode.Initialize}>
            <Call fn="reset" in={$in} />
        </Case>

        <Case value={State.Mode.Reset}>
            <Call fn="reset" in={$in} />
        </Case>

        <Case value={State.Mode.Clear}>
            <Call
                fn="clear"
                in={{
                    cells: $in.guarantees,
                    count: $in.layout.input_count + $in.layout.output_count
                }}
            />
        </Case>

        <Case value={State.Mode.ClearWants}>
            <Call
                fn="clear"
                in={{
                    cells: $in.demands,
                    count: $in.layout.input_count + $in.layout.output_count
                }}
            />
        </Case>
    </Switch>
</Module>
