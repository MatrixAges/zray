import memory from "memory"

import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"

import type { Allocator } from "memory"
import type { Buffers, Cells as Output, Layout } from "./model"

export type Input = {
    layout: Layout,
    buffers: Buffers,
    allocator: Allocator
}

export default function (in: Input): Output {
    const empty = encode(Knowledge.None)
    const count = in.layout.input_count + in.layout.output_count

    const guarantees = memory.allocateU8Buffer(
        in.allocator,
        in.buffers.guarantees,
        count
    )

    const demands = memory.allocateU8Buffer(in.allocator, in.buffers.demands, count)

    if (count != 0) {
        memory.fillByteRange(in.buffers.guarantees, 0, count, empty)
        memory.fillByteRange(in.buffers.demands, 0, count, empty)
    }

    return {
        layout: in.layout,
        guarantees,
        demands
    }
}
