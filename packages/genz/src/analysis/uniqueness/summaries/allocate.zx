import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"

import type { Cells as Output, Layout as Input } from "./model"

export default function (in: Input): Output {
    const empty = encode(Knowledge.None)
    const count = in.input_count + in.output_count
    const empty_guarantees: u8[] = []
    const empty_demands: u8[] = []

    const buffers = loop({
        index: 0,
        guarantees: empty_guarantees,
        demands: empty_demands
    }, {
        while: state => state.index < count,
        next: state => {
            state.guarantees = state.guarantees.push(empty)[0]
            state.demands = state.demands.push(empty)[0]
            state.index += 1
        },
        return: state => state
    })

    return {
        layout: in,
        guarantees: buffers.guarantees,
        demands: buffers.demands
    }
}
