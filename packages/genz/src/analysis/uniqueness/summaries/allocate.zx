import bytes from "std:bytes"

import encode from "../function/levels/encode"
import { Knowledge } from "../function/levels/model"

import type { Layout as Input, Cells as Output } from "./model"

export default function (in: Input): Output {
    const empty = encode(Knowledge.None)
    const count = in.input_count + in.output_count

    return {
        layout: in,
        guarantees: bytes.repeat(count, empty),
        demands: bytes.repeat(count, empty)
    }
}
