import integers from "std:integer"

import type { Regions } from "./plan"

export type Input = {
    regions: Regions,
    left: u32,
    left_time: u32,
    right: u32,
    right_time: u32
}

export type Output = bool

export default function (in: Input): Output {
    const regions = in.regions
    const depth = regions.depth
    const parent = regions.parent

    const result = loop({
        left: in.left,
        right: in.right,
        left_returns: false,
        right_returns: false
    }, {
        while: current => depth[integers.widen(current.left)] !=
            depth[integers.widen(current.right)] ||
            (
                current.left != current.right &&
                    parent[integers.widen(current.left)] !=
                    parent[integers.widen(current.right)]
            ),
        next: current => {
            const left = integers.widen(current.left)
            const right = integers.widen(current.right)
            const left_depth = depth[left]
            const right_depth = depth[right]

            if (left_depth >= right_depth) {
                current.left_returns = current.left_returns || regions.returns[left]
                current.left = parent[left]
            }

            if (right_depth >= left_depth) {
                current.right_returns = current.right_returns || regions.returns[right]
                current.right = parent[right]
            }
        }
    })

    const left = integers.widen(result.left)
    const right = integers.widen(result.right)
    const different = left != right

    const fork = regions.fork
    const arm = regions.arm

    const exclusive = (
        - different
        - and fork[left] == fork[right]
        - and arm[left] != arm[right]
    )

    if (exclusive) {
        return true
    }

    return match {
        in.left_time < in.right_time =>
            result.left_returns || (different && regions.returns[left]),
        _ => result.right_returns || (different && regions.returns[right])
    }
}
