import integers from "std:integer"
import { max_u32 } from "core/const"

import alternatives from "./alternatives"
import expression from "./expression"
import { Action, Definition } from "./model"
import push from "./push"
import statement from "./statement"
import blockArm from "./walk/block_arm"
import nodes from "./walk/nodes"
import parts from "./walk/parts"
import repetition from "./walk/repetition"
import scope from "./walk/scope"

import type { Walk as Input, Trace as Output } from "./model"

export default function (in: Input): Output {
    const { source, returns, detailed } = in

    const seen = source.expressions.kinds.map(kind => false)[0]

    const initial_nodes = nodes({
        seen,
        detailed
    })

    const result = loop({
        regions: in.state.graph.regions,
        edges: in.state.graph.edges,
        definitions: in.state.graph.definitions,
        results: in.state.graph.results,
        repetitions: in.state.graph.repeated,
        seen,
        time: initial_nodes.time,
        finish: initial_nodes.finish,
        region: initial_nodes.region,
        repeated: initial_nodes.repeated,
        stack: in.state.stack,
        clock: in.state.clock,
        forks: in.state.forks,
        active_region: in.state.region,
        active_loop: in.state.repeated
    }, {
        while: current => current.stack.top != max_u32,
        next: current => {
            const last = integers.widen(current.stack.top)

            const event = current.stack.nodes[last]
            const action = event.action
            const first = event.first
            const second = event.second
            const third = event.third
            const fourth = event.fourth
            const role = event.role
            const table = source.expressions
            const control = source.control
            const index = integers.widen(first)

            current.stack.top = event.parent

            const dispatch = match action {
                Action.ValueArm => Action.BlockArm,
                Action.Switch => Action.Branch,
                Action.Conditional => Action.Branch,
                Action.Match => Action.Branch,
                Action.Transform => Action.Repeat,
                Action.Iteration => Action.Repeat,
                _ => action
            }

            switch (dispatch) {
                case Action.Block:
                    if (second != 0) {
                        const pending = push({
                            stack: current.stack,
                            event: {
                                action: Action.Block,
                                first: first + 1,
                                second: second - 1
                            }
                        })

                        current.stack = statement({
                            table: control,
                            stack: pending,
                            index: first
                        })
                    }

                case Action.Operand:
                    const child = integers.widen(second)

                    if (detailed) {
                        current.edges = current.edges.push({
                            parent: first,
                            child: second,
                            role,
                            index: third,
                            region: current.active_region
                        })[0]
                    }

                    if (!current.seen[child]) {
                        const time_stamp = current.clock

                        current.seen[child] = true
                        current.clock += 1

                        const pending = match {
                            detailed => push({
                                stack: current.stack,
                                event: {
                                    action: Action.Finish,
                                    first: second,
                                    second: time_stamp,
                                    third: current.active_region,
                                    fourth: current.active_loop
                                }
                            }),
                            _ => current.stack
                        }

                        current.stack = expression({
                            table,
                            stack: pending,
                            id: second
                        })
                    }

                case Action.Finish:
                    if (detailed) {
                        current.time[index] = second
                        current.finish[index] = current.clock
                        current.region[index] = third
                        current.repeated[index] = fourth
                    }

                case Action.RestoreRegion:
                    current.active_region = first

                case Action.RestoreLoop:
                    current.active_loop = first

                case Action.Define:
                    current.definitions[index] = {
                        ...current.definitions[index],
                        kind: Definition.Value,
                        value: second,
                        repeated: current.active_loop
                    }

                case Action.Parts:
                    current.definitions = parts({
                        control,
                        definitions: current.definitions,
                        statement: index,
                        repeated: current.active_loop
                    })

                case Action.Result:
                    current.results = current.results.push(first)[0]

                case Action.Scope:
                    current.stack = scope({
                        table,
                        stack: current.stack,
                        event
                    })

                case Action.BlockArm:
                    const arm_next = blockArm({
                        control,
                        returns,
                        regions: current.regions,
                        stack: current.stack,
                        active_region: current.active_region,
                        detailed,
                        event
                    })

                    current.regions = arm_next.regions
                    current.stack = arm_next.stack
                    current.active_region = arm_next.active_region

                case Action.Branch:
                    current.forks += 1
                    current.stack = alternatives({
                        source,
                        stack: current.stack,
                        action,
                        index: first,
                        fork: current.forks
                    })

                case Action.Repeat:
                    const repeated_next = repetition({
                        table,
                        stack: current.stack,
                        definitions: current.definitions,
                        repetitions: current.repetitions,
                        parent: current.active_loop,
                        event
                    })

                    current.repetitions = repeated_next.repetitions
                    current.active_loop = repeated_next.active
                    current.definitions = repeated_next.definitions
                    current.stack = repeated_next.stack

                default:
            }
        }
    })

    return {
        seen: result.seen,
        nodes: {
            time: result.time,
            finish: result.finish,
            region: result.region,
            repeated: result.repeated
        },
        graph: {
            regions: result.regions,
            edges: result.edges,
            definitions: result.definitions,
            results: result.results,
            repeated: result.repetitions
        }
    }
}
