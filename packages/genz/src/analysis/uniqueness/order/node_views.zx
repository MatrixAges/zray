import memory from "memory"

import type { NodeBuffers as Input, Nodes as Output } from "./model"

export default function (in: Input): Output {
    return {
        time: memory.u32Views(in.time),
        finish: memory.u32Views(in.finish),
        region: memory.u32Views(in.region),
        repeated: memory.u32Views(in.repeated)
    }
}
