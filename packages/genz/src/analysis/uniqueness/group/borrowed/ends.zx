import integers from "std:integer"

import type { Count as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { owners, count } = in

    const length = count + 1
    const zero: u32 = 0
    const empty: u32[] = []

    const blank = loop({
        index: 0,
        first: empty
    }, {
        while: state => state.index < length,
        next: state => {
            state.first = state.first.push(zero)[0]
            state.index += 1
        },
        return: state => state.first
    })

    const counted = loop({
        index: 0,
        first: blank
    }, {
        while: state => state.index <= owners.length,
        next: state => {
            if (state.index < owners.length) {
                const owner = integers.widen(owners[state.index])

                state.first[owner] += 1
            } else {
                state.first[count] = integers.narrow(owners.length)
            }
            state.index += 1
        },
        return: state => state.first
    })

    return loop({
        index: 1,
        first: counted
    }, {
        while: state => state.index < count,
        next: state => {
            const total = state.first[state.index - 1] + state.first[state.index]

            state.first[state.index] = total
            state.index += 1
        },
        return: state => state.first
    })
}
