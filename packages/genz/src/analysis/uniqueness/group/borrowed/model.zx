import type { U32Buffer } from "memory"
import type { RowBuffer } from "memory/columns"

export type Count = {
    count: u64,
    owners: u32[],
    first: U32Buffer
}

export type Input = Count & {
    source: u8[],
    target: RowBuffer,
    width: u64
}

export type Arrange = Input.Omit("count")
