<Module>
    <Type from="model" as="Group" />

    <Args in={Group.Input} out={void} />

    <Call
        fn="ends"
        in={$in.pick([
            "count",
            "owners",
            "first"
        ])}
    />

    <Call
        fn="arrange"
        in={$in.omit(["count"])}
    />
</Module>
