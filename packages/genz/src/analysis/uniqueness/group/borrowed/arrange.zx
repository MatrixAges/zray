import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import type { Arrange as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { owners, first, width, source, target } = in

    columns.allocateRows(target, owners.length)

    const grouped = loop(owners.length, {
        while: index => index != 0,
        next: index => {
            index -= 1

            const owner = integers.widen(owners[index])
            const position = memory.readU32(first, owner) - 1
            const offset = index * width
            const row = memory.borrowU8Range(source, offset, width)

            memory.writeU32(first, owner, position)

            columns.writeRow(target, integers.widen(position), row)
        }
    })
}
