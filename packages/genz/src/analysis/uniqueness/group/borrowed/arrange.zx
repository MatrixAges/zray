import integers from "std:integer"
import memory from "std:memory"

import type { Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { owners, first } = in

    const items: u32[] = owners.map(owner => 0)[0]

    return loop({
        items,
        index: owners.length
    }, {
        while: state => state.index != 0,
        next: state => {
            state.index -= 1

            const owner = integers.widen(owners[state.index])
            const position = memory.readU32(first, owner) - 1

            memory.writeU32(first, owner, position)
            state.items[integers.widen(position)] = integers.narrow(state.index)
        },
        return: state => state.items
    })
}
