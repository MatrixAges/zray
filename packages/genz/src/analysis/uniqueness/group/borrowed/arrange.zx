import integers from "std:integer"
import memory from "zig:compiler_memory"

import type { Arrange as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { owners, first, width, source, target } = in

    const grouped = loop(owners.length, {
        while: index => index != 0,
        next: index => {
            index -= 1

            const owner = integers.widen(owners[index])
            const position = memory.readU32(first, owner) - 1
            const offset = index * width
            const destination = integers.widen(position) * width

            memory.writeU32(first, owner, position)

            const copied = memory.copyBytes(
                target,
                destination,
                source,
                offset,
                offset + width
            )
        }
    })
}
