import integers from "std:integer"

import type { Arrange as Input, Output } from "./model"

export default function (in: Input): Output {
    const { owners } = in

    const zero: u32 = 0
    const initial_order: u32[] = owners.map(item => zero)[0]

    return loop({
        index: owners.length,
        first: in.first,
        order: initial_order
    }, {
        while: state => state.index != 0,
        next: state => {
            state.index -= 1

            const owner = integers.widen(owners[state.index])
            const position = state.first[owner] - 1

            state.first[owner] = position
            state.order[integers.widen(position)] = integers.narrow(state.index)
        },
        return: state => ({
            starts: state.first,
            order: state.order
        })
    })
}
