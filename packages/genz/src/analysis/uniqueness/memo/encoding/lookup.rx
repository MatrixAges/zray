<Module>
    <Type from="model" as="Encoding" />

    <Args in={Encoding.Lookup} out={Encoding.Found} />

    <Call module="key" in={$in.omit(["table"])} />

    <Call
        fn="find"
        in={{
            table: $in.table,
            chunks: $ctx.key.chunks
        }}
    />

    <Return
        value={{
            ...$ctx.find,
            state: $ctx.key
        }}
    />
</Module>
