import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import storedKey from "../../../function/levels/growth/stored_key"
import { renewal_key_width, word_width } from "../const"
import record from "../record"
import word from "../word"

import type { Emit as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { columns, count, order, wide } = in
    const { keys, wants } = columns

    const width = wide ? renewal_key_width : word_width
    const header = word(count)

    const rows = loop({
        parts: bytes.repeat(count + 1, 0).map(byte => header)[0],
        index: 0
    }, {
        while: state => state.index < count,
        next: state => {
            const offset = match {
                order == null => state.index,
                _ => integers.widen(order[state.index])
            }

            state.parts[state.index + 1] = record({
                value: storedKey({
                    keys,
                    wide,
                    index: offset
                }),
                width,
                want: memory.readColumnU8(wants, offset)
            })

            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join([], rows)
}
