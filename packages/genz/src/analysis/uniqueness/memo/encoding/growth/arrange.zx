import bytes from "std:bytes"
import integers from "std:integer"

import sift from "./sift"

import type { Sort as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { columns, count, wide } = in

    const initial: u32[] = bytes.repeat(count, 0).map(byte => 0)[0]

    const seeded = loop({
        index: 0,
        indices: initial
    }, {
        while: s => s.index < count,
        next: s => {
            s.indices[s.index] = integers.narrow(s.index)
            s.index += 1
        },
        return: s => s.indices
    })

    const prepared = loop({
        position: count / 2,
        indices: seeded
    }, {
        while: s => s.position != 0,
        next: s => {
            s.position -= 1

            s.indices = sift({
                columns,
                wide,
                indices: s.indices,
                limit: count,
                root: s.position
            })
        },
        return: s => s.indices
    })

    return loop({
        limit: count,
        indices: prepared
    }, {
        while: s => s.limit > 1,
        next: s => {
            s.limit -= 1

            const first: u64 = 0
            const last = s.indices[s.limit]
            const largest = s.indices[first]

            const swapped = s.indices.with(first, last).with(s.limit, largest)

            s.indices = sift({
                columns,
                wide,
                indices: swapped,
                limit: s.limit,
                root: first
            })
        },
        return: s => s.indices
    })
}
