<Module>
    <Type from="model" as="Growth" />

    <Args in={Growth.Group} out={u8[]} />

    <Call
        fn="ordered"
        in={{
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide
        }}
    />

    <If on={$ctx.ordered}>
        <Call
            fn="write"
            in={{
                columns: $in.rows,
                count: $in.count,
                wide: $in.wide
            }}
        />

        <Return value={$ctx.write} />
    </If>

    <Call
        fn="arrange"
        in={{
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide
        }}
    />

    <Call
        fn="write"
        in={{
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide,
            order: $ctx.arrange
        }}
    />

    <Return value={$ctx.write} />
</Module>
