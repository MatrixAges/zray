<Module>
    <Type from="../model" as="Encoding" />
    <Type from="model" as="Growth" />

    <Args in={Growth.Group} out={Encoding.State} />

    <Call
        fn="../word"
        in={{
            state: $in.state,
            value: $in.count
        }}
    />

    <If on={$in.count == 0}>
        <Return value={$ctx.word} />
    </If>

    <Call
        fn="ordered"
        in={{
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide
        }}
    />

    <If on={$ctx.ordered}>
        <Call
            fn="write"
            in={{
                state: $ctx.word,
                columns: $in.rows,
                count: $in.count,
                wide: $in.wide
            }}
        />

        <Return value={$ctx.write} />
    </If>

    <Call
        fn="arrange"
        in={{
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide
        }}
    />

    <Call
        fn="write"
        in={{
            state: $ctx.word,
            columns: $in.rows,
            count: $in.count,
            wide: $in.wide,
            order: $ctx.arrange
        }}
    />

    <Return value={$ctx.write} />
</Module>
