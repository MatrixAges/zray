import type { RecordColumns, State } from "../model"

export type Group = {
    state: State,
    rows: RecordColumns,
    count: u64,
    wide: bool
}

export type Rows = {
    columns: RecordColumns,
    count: u64,
    wide: bool
}

export type Sort = Rows

export type Heap = {
    columns: RecordColumns,
    wide: bool,
    indices: u32[],
    limit: u64,
    root: u64
}

export type Emit = Rows & {
    state: State,
    order?: u32[]
}
