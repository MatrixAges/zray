import type { U32Buffer } from "memory"
import type { Order, RecordColumns, State } from "../model"

export type Group = {
    state: State,
    rows: RecordColumns,
    count: u64,
    wide: bool,
    order: Order
}

export type Rows = {
    columns: RecordColumns,
    count: u64,
    wide: bool
}

export type Sort = Rows & {
    order: Order
}

export type Heap = {
    columns: RecordColumns,
    wide: bool,
    indices: U32Buffer,
    limit: u64,
    root: u64
}

export type Emit = Rows & {
    state: State,
    order?: U32Buffer
}
