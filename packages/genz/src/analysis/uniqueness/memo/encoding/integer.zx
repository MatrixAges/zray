import integers from "std:integer"
import memory from "memory"

import { byte_radix } from "./const"

import type { Integer as Input, State as Output } from "./model"

export default function (in: Input): Output {
    const loop_initial = {
        value: in.value,
        index: 0
    }

    const { state, width } = in

    return loop(loop_initial, {
        while: current => current.index < width,
        next: current => {
            const byte = integers.narrowByte(current.value % byte_radix)

            memory.appendByte(state.buffer, byte)

            current.value /= byte_radix
            current.index += 1
        },
        return: current => state
    })
}
