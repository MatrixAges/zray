import crypto from "std:crypto"

import touch from "../table/touch"

import type { Match as Output, Target } from "./model"

export type Input = Target & {
    chunks: u8[][]
}

export default function (in: Input): Output {
    const digest = crypto.sha256Parts(in.chunks)

    const row = touch({
        ...in.table,
        key: digest
    })

    return {
        row,
        digest
    }
}
