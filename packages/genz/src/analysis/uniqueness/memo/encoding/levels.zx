import bytes from "std:bytes"
import integers from "std:integer"

import { level_modulus } from "../../replay/ordered/const"
import { byte_radix, level_pair_radix, word_width } from "./const"

export type Input = u8[]

export type Output = u8[]

export default function (in: Input): Output {
    const count = integers.widen(integers.narrow(in.length))
    const size = word_width + (count + 1) / 2

    return loop({
        output: bytes.repeat(size, 0),
        length: count,
        index: 0
    }, {
        while: state => state.index < size,
        next: state => {
            if (state.index < word_width) {
                state.output[state.index] =
                    integers.narrowByte(state.length % byte_radix)
                state.length /= byte_radix
            } else {
                const index = (state.index - word_width) * 2
                const lower = integers.widenByte(in[index] % level_modulus)
                const upper = match {
                    index + 1 < count =>
                        integers.widenByte(in[index + 1] % level_modulus),
                    _ => 0
                }

                state.output[state.index] =
                    integers.narrowByte(lower + upper * level_pair_radix)
            }

            state.index += 1
        },
        return: state => state.output
    })
}
