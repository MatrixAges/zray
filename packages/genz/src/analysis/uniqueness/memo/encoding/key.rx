<Module>
    <Type from="model" as="Encoding" />

    <Args in={Encoding.Key} out={Encoding.State} />

    <Call
        module="begin"
        in={$in.pick([
            "state",
            "identity",
            "index"
        ])}
    />

    <Task name="summary" out={$ctx.facts}>
        <Call
            fn="facts"
            in={{
                state: $ctx.begin,
                callees: $in.callees,
                rows: $in.called_outputs,
                own: $in.own_input,
                trailing: false
            }}
        />
    </Task>

    <Task name="normalized" out={$ctx.encode}>
        <Call
            module="growth/encode"
            in={{
                state: $ctx.task.summary,
                rows: $in.normalized,
                order: $in.order
            }}
        />
    </Task>

    <Task name="renewed" out={$ctx.encode}>
        <Call
            module="growth/encode"
            in={{
                state: $ctx.task.normalized,
                rows: $in.renewed,
                order: $in.order
            }}
        />
    </Task>

    <If on={$in.kind == Encoding.Kind.Demanded}>
        <Call
            fn="output_wants"
            in={{
                index: $in.index,
                rows: $in.output_wants
            }}
        />

        <Call
            fn="facts"
            in={{
                state: $ctx.task.renewed,
                callees: $in.callees,
                rows: $in.called_input_wants,
                own: $ctx.output_wants,
                trailing: true
            }}
        />

        <Call
            module="finish"
            in={{
                state: $ctx.facts,
                kind: $in.kind
            }}
        />

        <Return value={$ctx.finish} />
    </If>

    <Call
        module="finish"
        in={{
            state: $ctx.task.renewed,
            kind: $in.kind
        }}
    />

    <Return value={$ctx.finish} />
</Module>
