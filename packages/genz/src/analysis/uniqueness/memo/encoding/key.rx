<Module>
    <Type from="model" as="Encoding" />

    <Args in={Encoding.Key} out={Encoding.State} />

    <Call
        module="begin"
        in={$in.pick([
            "state",
            "identity",
            "index"
        ])}
    />

    <Task name="summary" out={$ctx.facts}>
        <Call
            fn="facts"
            in={{
                state: $ctx.begin,
                callees: $in.callees,
                rows: $in.called_outputs,
                own: $in.own_input,
                trailing: false
            }}
        />
    </Task>

    <Call
        fn="normalized"
        in={{
            state: $ctx.task.summary,
            records: $in.normalized
        }}
    />

    <Call
        fn="renewed"
        in={{
            state: $ctx.normalized,
            records: $in.renewed
        }}
    />

    <If on={$in.kind == Encoding.Kind.Demanded}>
        <Call
            fn="facts"
            in={{
                state: $ctx.renewed,
                callees: $in.callees,
                rows: $in.called_input_wants,
                own: $in.own_output_wants,
                trailing: true
            }}
        />

        <Call
            module="finish"
            in={{
                state: $ctx.facts,
                kind: $in.kind
            }}
        />

        <Return value={$ctx.finish} />
    </If>

    <Call
        module="finish"
        in={{
            state: $ctx.renewed,
            kind: $in.kind
        }}
    />

    <Return value={$ctx.finish} />
</Module>
