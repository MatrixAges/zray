<Module>
    <Type from="model" as="Encoding" />

    <Args in={Encoding.Key} out={Encoding.State} />

    <Task name="summary" out={$ctx.facts}>
        <Call
            fn="facts"
            in={{
                callees: $in.callees,
                rows: $in.called_outputs,
                own: $in.own_input,
                trailing: false
            }}
        />
    </Task>

    <Task name="normalized" out={$ctx.encode}>
        <Call
            module="growth/encode"
            in={{
                rows: $in.normalized,
                count: $in.normalized_count,
                wide: false
            }}
        />
    </Task>

    <Task name="renewed" out={$ctx.encode}>
        <Call
            module="growth/encode"
            in={{
                rows: $in.renewed,
                count: $in.renewed_count,
                wide: true
            }}
        />
    </Task>

    <If on={$in.kind == Encoding.Kind.Demanded}>
        <Call
            fn="output_wants"
            in={{
                index: $in.index,
                rows: $in.output_wants
            }}
        />

        <Call
            fn="facts"
            in={{
                callees: $in.callees,
                rows: $in.called_input_wants,
                own: $ctx.output_wants,
                trailing: true
            }}
        />

        <Call
            fn="assemble"
            in={{
                identity: $in.identity,
                index: $in.index,
                summary: $ctx.task.summary,
                normalized: $ctx.task.normalized,
                renewed: $ctx.task.renewed,
                demand: $ctx.facts,
                kind: $in.kind
            }}
        />

        <Return value={$ctx.assemble} />
    </If>

    <Call
        fn="assemble"
        in={{
            identity: $in.identity,
            index: $in.index,
            summary: $ctx.task.summary,
            normalized: $ctx.task.normalized,
            renewed: $ctx.task.renewed,
            demand: [],
            kind: $in.kind
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
