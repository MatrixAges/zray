import memory from "memory"

import type { Body as Input, Fields as Output } from "./model"

export default function (in: Input): Output {
    const { rows, summaries, index } = in
    const { growth, identities, empty_identity } = rows
    const { projection } = growth

    const normalized = {
        keys: memory.selectProjectedList(projection, 0, index),
        wants: memory.selectProjectedList(projection, 1, index)
    }

    const renewed = {
        keys: memory.selectProjectedList(projection, 2, index),
        wants: memory.selectProjectedList(projection, 3, index)
    }

    const identity = match {
        index < memory.columnLength(identities) =>
            memory.readFixedBytes(identities, index, empty_identity.length),
        _ => empty_identity
    }

    const own_input = match {
        index < summaries.inputs.length => summaries.inputs[index],
        _ => []
    }

    return {
        identity,
        callees: rows.callees[index],
        own_input,
        normalized,
        normalized_count: memory.columnLength(normalized.keys),
        renewed,
        renewed_count: memory.columnLength(renewed.keys)
    }
}
