import bytes from "std:bytes"
import integers from "std:integer"

import levels from "./levels"

import type { Facts as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { own, trailing, callees, rows } = in

    const own_levels: u8[][] = [levels(own)]

    const called =
        callees.map(callee => levels(rows[integers.widen(callee)]))[0]

    const chunks = match {
        trailing => called.concat(own_levels)[0],
        _ => own_levels.concat(called)[0]
    }

    return bytes.join([], chunks)
}
