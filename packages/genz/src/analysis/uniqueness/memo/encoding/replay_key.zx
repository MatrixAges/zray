import memory from "memory"

import touch from "../table/touch"
import tag from "./tag"

import type { Kind, Target } from "./model"

export type Input = Target & {
    identity: u8[],
    state: u8[],
    kind: Kind
}

export type Output = u32?

export default function (in: Input): Output {
    const { identity, state, kind } = in

    const key = memory.sha256FramedInto(in.digest, identity, state, tag(kind))

    return touch({
        ...in.table,
        key
    })
}
