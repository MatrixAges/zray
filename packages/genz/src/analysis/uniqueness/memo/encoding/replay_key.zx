import crypto from "std:crypto"

import touch from "../table/touch"
import tag from "./tag"

import type { Kind, Match as Output, Target } from "./model"

export type Input = Target & {
    identity: u8[],
    state: u8[],
    kind: Kind
}

export default function (in: Input): Output {
    const digest = crypto.sha256Parts([
        in.identity,
        in.state,
        tag(in.kind)
    ])

    const row = touch({
        ...in.table,
        key: digest
    })

    return {
        row,
        digest
    }
}
