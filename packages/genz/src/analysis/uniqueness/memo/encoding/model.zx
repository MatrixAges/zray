import type { GrowthColumns } from "../../function/levels/model"
import type { Probe } from "../table/model"

export type State = {
    chunks: u8[][],
    state_end: u64,
    size: u64
}

export enum Kind {
    Settled,
    Demanded,
    Planned
}

export type GrowthLevel = {
    value: u64,
    width: u64,
    want: u8
}

export type RecordColumns = GrowthColumns.Omit("bytes", "wide")

export type Key = {
    identity: u8[],
    index: u64,
    kind: Kind,
    callees: u32[],
    own_input: u8[],
    called_outputs: u8[][],
    output_wants: u8[][],
    called_input_wants: u8[][],
    normalized: RecordColumns,
    normalized_count: u64,
    renewed: RecordColumns,
    renewed_count: u64
}

export type Target = {
    table: Probe
}

export type Lookup = Key & Target

export type Match = {
    row?: u32,
    digest: u8[]
}

export type Found = Match & {
    state: State
}

export type Facts = {
    callees: u32[],
    rows: u8[][],
    own: u8[],
    trailing: bool
}
