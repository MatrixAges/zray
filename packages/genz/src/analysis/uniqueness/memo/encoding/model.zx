import type { Normalized, Renewed } from "../../replay/ordered/model"

export type State = {
    buffer: u8[],
    end: u64,
    state_end: u64
}

export type Append = {
    state: State,
    bytes: u8[]
}

export type Integer = {
    state: State,
    value: u64,
    width: u64
}

export type Levels = {
    state: State,
    values: u8[]
}

export enum Kind {
    Settled,
    Demanded,
    Planned
}

export type Header = {
    state: State,
    identity: u8[]
}

export type Begin = {
    state: State,
    identity: u8[],
    index: u64
}

export type Finish = {
    state: State,
    kind: Kind
}

export type Word = {
    state: State,
    value: u64
}

export type GrowthLevel = Integer & {
    want: u8
}

export type Key = {
    state: State,
    identity: u8[],
    index: u64,
    kind: Kind,
    callees: u32[],
    own_input: u8[],
    called_outputs: u8[][],
    own_output_wants: u8[],
    called_input_wants: u8[][],
    normalized: Normalized[],
    renewed: Renewed[]
}

export type Facts = {
    state: State,
    callees: u32[],
    rows: u8[][],
    own: u8[],
    trailing: bool
}
