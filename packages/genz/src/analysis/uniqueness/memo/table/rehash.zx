import integers from "std:integer"
import { sha256_digest_width } from "core/const"
import memory from "memory"

import position from "./position"

import type { Rehash as Input } from "./model"

export type Output = u32[]

export default function (in: Input): Output {
    const { current, buckets, keys } = in

    return loop({
        row: 0,
        buckets
    }, {
        while: state => state.row < current,
        next: state => {
            const key = memory.borrowU8Range(
                keys,
                state.row * sha256_digest_width,
                sha256_digest_width
            )
            const located = position({
                keys,
                buckets: state.buckets,
                key
            })

            state.buckets[located.slot] = integers.narrow(state.row + 1)
            state.row += 1
        },
        return: state => state.buckets
    })
}
