import integers from "std:integer"
import slot from "core/bytes/index/digest/slot"
import memory from "memory"

import type { Hit as Input } from "./model"

export type Output = u32?

export default function (in: Input): Output {
    const row = slot(in.omit(["used"])).found

    if (row != null && in.used != null) {
        memory.writeColumnBool(in.used, integers.widen(row), true)
    }

    return row
}
