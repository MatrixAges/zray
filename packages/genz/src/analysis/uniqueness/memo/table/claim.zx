import integers from "std:integer"

import position from "./position"

import type { Probe } from "./model"

export type Input = Probe & {
    key: u8[],
    used: u32
}

export type Output = {
    row: u64,
    bucket?: u64,
    used: u32
}

export default function (in: Input): Output {
    const located = position(in.omit(["used"]))

    if (located.found != null) {
        return {
            row: integers.widen(located.found),
            used: in.used
        }
    }

    return {
        row: integers.widen(in.used),
        bucket: located.slot,
        used: in.used + 1
    }
}
