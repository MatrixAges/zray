import integers from "std:integer"
import exchange from "core/bytes/index/digest/exchange"
import columns from "memory/columns"

import type { Index } from "./model"

export type Input = Index.Omit("used") & {
    digest: u8[],
    used: u32
}

export type Output = u64

export default function (in: Input): Output {
    const { keys, buckets, capacity, rows, digest, used } = in

    const previous = exchange({
        keys,
        buckets,
        capacity,
        key: digest,
        insert: used
    })

    if (previous != null) {
        return integers.widen(previous)
    }

    const row = integers.widen(used)

    columns.writeRow(rows, row, digest)

    return row
}
