import type { ReadColumn } from "memory"

export type Publication = {
    keys: u8[],
    buckets: u32[],
    digest: u8[],
    current: u64
}

export type Published = {
    row: u64,
    bucket?: u64,
    used: u32
}

export type Store = Publication & {
    limit: u64
}

export type Probe = {
    keys: u8[],
    buckets: u32[]
}

export type Hit = Probe & {
    key: u8[]
}

export type Usage = {
    count: u64,
    used: ReadColumn
}

export type Resize = {
    current: u64,
    additional: u32
}

export type Reserve = Resize & {
    keys: u8[]
}

export type Reserved = {
    limit: u64,
    buckets: u32[]
}

export type Rehash = Reserve.Pick("keys", "current") & {
    buckets: u32[]
}
