import type { ReadTable, Table } from "core/bytes/index/digest/model"
import type { Allocator, ReadColumn, U32Buffer, WriteColumn } from "memory"
import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Index = Table & {
    rows: RowBuffer,
    used: U32Buffer
}

export type Publication = Storage.Pick("keys", "values", "buckets") & {
    digest: u8[],
    value: u8[],
    current: u64
}

export type Published = {
    row: u64,
    used: u32
}

export type Store = Publication & {
    owner: Allocator,
    owner_rows: ColumnAllocator,
    next_buckets: U32Buffer,
    limit: u64
}

export type Probe = ReadTable & {
    used?: WriteColumn
}

export type Hit = Probe & {
    key: u8[]
}

export type Usage = {
    count: u64,
    used: ReadColumn
}

export type Resize = {
    current: u64,
    additional: u32
}

export type Storage = {
    keys: RowBuffer,
    values: RowBuffer,
    buckets: U32Buffer,
    owner: Allocator,
    owner_rows: ColumnAllocator
}

export type Reserve = Storage & Resize

export type Rehash = Storage.Pick("keys", "buckets") & Resize.Pick("current")
