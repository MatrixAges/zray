import bytes from "std:bytes"
import integers from "std:integer"
import { sha256_digest_width } from "core/const"
import memory from "memory"

import type { Hit as Input } from "./model"

export type Output = {
    slot: u64,
    found?: u32
}

export default function (in: Input): Output {
    const { keys, key, buckets } = in

    if (buckets.length == 0) {
        return {
            slot: 0
        }
    }

    const mask = buckets.length - 1
    const hash = memory.readU64Bytes(key, 0, true)
    const missing: u32? = null

    return loop({
        slot: integers.andBits(hash, mask),
        found: missing,
        done: false
    }, {
        while: state => !state.done,
        next: state => {
            const entry = buckets[state.slot]

            if (entry == 0) {
                state.done = true
            } else {
                const row = entry - 1
                const offset = integers.widen(row) * sha256_digest_width
                const candidate =
                    memory.borrowU8Range(keys, offset, sha256_digest_width)

                if (bytes.equals(candidate, key)) {
                    state.found = row
                    state.done = true
                } else {
                    state.slot = integers.andBits(state.slot + 1, mask)
                }
            }
        },
        return: state => ({
            slot: state.slot,
            found: state.found
        })
    })
}
