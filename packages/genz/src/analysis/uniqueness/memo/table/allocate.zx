import integers from "std:integer"
import capacity from "core/bytes/map/capacity"
import { reserveRows } from "core/row_buffer"
import memory from "memory"

import type { Reserve as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { keys, values, buckets, owner, current, additional } = in

    const size = capacity(integers.narrow(current + integers.widen(additional)))

    reserveRows([
        keys,
        current,
        size.limit
    ])

    reserveRows([
        values,
        current,
        size.limit
    ])

    memory.allocateU32Buffer(owner, buckets, size.capacity)

    return size.limit
}
