import bytes from "std:bytes"
import integers from "std:integer"
import capacity from "core/bytes/map/capacity"

import type { Resize as Input, Reserved as Output } from "./model"

export default function (in: Input): Output {
    const { current, additional } = in

    const size = capacity(integers.narrow(current + integers.widen(additional)))
    const buckets: u32[] = bytes.repeat(size.capacity, 0).map(byte => 0)[0]

    return {
        limit: size.limit,
        buckets
    }
}
