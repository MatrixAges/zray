<Module>
    <Type from="model" as="Table" />

    <Args in={Table.Store} out={u64} />

    <Store from="state" as="memo" />

    <If on={$in.current == $in.limit}>
        <Call
            module="reserve"
            in={{
                ...$in.pick([
                    "keys",
                    "current"
                ]),
                additional: 1
            }}
        />

        <Call
            fn="publish"
            in={{
                ...$in.pick([
                    "keys",
                    "digest",
                    "current"
                ]),
                buckets: $ctx.reserve.buckets
            }}
        />

        <Call
            fn="set_state"
            in={{
                ...$ctx.publish,
                ...$ctx.reserve,
                changed: true
            }}
            setter={[$store.memo.state]}
        />

        <Return value={$ctx.publish.row} />
    </If>

    <Call
        fn="publish"
        in={$in.pick([
            "keys",
            "digest",
            "current",
            "buckets"
        ])}
    />

    <Call
        fn="set_state"
        in={{
            ...$ctx.publish,
            buckets: [],
            limit: $in.limit,
            changed: true
        }}
        setter={[$store.memo.state]}
    />

    <Return value={$ctx.publish.row} />
</Module>
