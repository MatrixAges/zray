<Module>
    <Type from="model" as="Table" />

    <Args in={Table.Store} out={u64} />

    <Store from="state" as="memo" />

    <If on={$in.current == $in.limit}>
        <Call
            module="reserve"
            in={{
                ...$in.pick([
                    "keys",
                    "values",
                    "owner",
                    "owner_rows",
                    "current"
                ]),
                buckets: $in.next_buckets,
                additional: 1
            }}
        />

        <Call
            fn="publish"
            in={{
                ...$in.omit([
                    "owner",
                    "owner_rows",
                    "next_buckets",
                    "limit"
                ]),
                buckets: $in.next_buckets
            }}
        />

        <Call
            fn="set_state"
            in={{
                used: $ctx.publish.used,
                limit: $ctx.reserve,
                changed: true
            }}
            setter={[$store.memo.state]}
        />

        <Return value={$ctx.publish.row} />
    </If>

    <Call
        fn="publish"
        in={$in.omit([
            "owner",
            "owner_rows",
            "next_buckets",
            "limit"
        ])}
    />

    <Call
        fn="set_state"
        in={{
            used: $ctx.publish.used,
            limit: $in.limit,
            changed: true
        }}
        setter={[$store.memo.state]}
    />

    <Return value={$ctx.publish.row} />
</Module>
