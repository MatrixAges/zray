import bytes from "std:bytes"
import integers from "std:integer"

import { level_modulus } from "../../replay/ordered/const"
import { level_pair_radix, word_width } from "../encoding/const"

import type { Cell } from "../../function/updates/model"

export type Input = {
    source: u8[],
    offset: u64,
    updates: Cell[],
    output: bool,
    row: u64,
    length: u64,
    collect: bool
}

export type Decoded = {
    end: u64,
    updates: Cell[]
}

export type Output = Decoded?

export default function (in: Input): Output {
    if (in.offset > in.source.length || in.source.length - in.offset < word_width) {
        return null
    }

    const length = integers.widen(bytes.readU32(in.source, in.offset, true))
    const first = in.offset + word_width
    const end = first + (length + 1) / 2

    if (length != in.length || end > in.source.length) {
        return null
    }

    if (!in.collect) {
        return {
            end,
            updates: in.updates
        }
    }

    const modulus = integers.widenByte(level_modulus)

    const { source, row, output } = in

    const updates = loop({
        updates: in.updates,
        column: 0,
        offset: first
    }, {
        while: state => state.column < length,
        next: state => {
            const encoded = integers.widenByte(source[state.offset])

            state.updates = state.updates.push({
                row,
                slot: state.column,
                output,
                value: integers.narrowByte(encoded % modulus)
            })[0]

            if (state.column + 1 < length) {
                state.updates = state.updates.push({
                    row,
                    slot: state.column + 1,
                    output,
                    value: integers.narrowByte(
                        encoded / level_pair_radix % modulus
                    )
                })[0]
            }

            state.column += 2
            state.offset += 1
        },
        return: state => state.updates
    })

    return {
        end,
        updates
    }
}
