import integers from "std:integer"
import memory from "memory"

import row from "./row"

import type { AtomicRows } from "memory"
import type { Cell } from "../../function/updates/model"
import type { LevelScan as Output } from "./model"

export type Input = {
    source: u8[],
    first: u64,
    own: AtomicRows,
    called: AtomicRows,
    body: u64,
    callees: u32[],
    trailing: bool,
    collect: bool
}

export default function (in: Input): Output {
    const own_index = in.trailing ? in.callees.length : 0
    const end = in.callees.length + 1
    const updates: Cell[] = []

    return loop({
        index: 0,
        offset: in.first,
        valid: true,
        updates
    }, {
        while: state => state.index < end && state.valid,
        next: state => {
            const own = state.index == own_index
            const target = own ? in.own : in.called
            const selected = match {
                own => in.body,
                in.trailing => integers.widen(in.callees[state.index]),
                _ => integers.widen(in.callees[state.index - 1])
            }
            const length = match {
                own && selected == memory.atomicRowsCount(target) => 0,
                _ => memory.atomicRowLength(target, selected)
            }

            const decoded = row({
                source: in.source,
                offset: state.offset,
                updates: state.updates,
                output: own == in.trailing,
                row: selected,
                length,
                collect: in.collect
            })

            if (decoded == null) {
                state.valid = false
            } else {
                state.offset = decoded.end
                state.updates = decoded.updates
            }

            state.index += 1
        },
        return: state => ({
            end: state.offset,
            valid: state.valid,
            updates: state.updates
        })
    })
}
