<Module>
    <Type from="model" as="Restore" />

    <Args in={Restore.Publication} out={Restore.Updates} />

    <Task name="facts" out={$ctx.levels}>
        <Call
            fn="levels"
            in={{
                ...$in.input.pick([
                    "source",
                    "body",
                    "callees"
                ]),
                first: $in.facts_start,
                own: $in.input.input,
                called: $in.input.output,
                trailing: false,
                collect: true
            }}
        />
    </Task>

    <If on={$in.input.demanded}>
        <Call
            fn="levels"
            in={{
                ...$in.input.pick([
                    "source",
                    "body",
                    "callees"
                ]),
                first: $in.wants_start,
                own: $in.input.outputs,
                called: $in.input.inputs,
                trailing: true,
                collect: true
            }}
        />

        <Return
            value={{
                facts: $ctx.task.facts.updates,
                wants: $ctx.levels.updates
            }}
        />
    </If>

    <Return
        value={{
            facts: $ctx.task.facts.updates,
            wants: []
        }}
    />
</Module>
