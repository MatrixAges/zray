<Module>
    <Type from="model" as="Restore" />

    <Args in={Restore.Input} out={Restore.Restored?} />

    <Call module="inspect" in={$in} />

    <If on={$ctx.inspect != null}>
        <Call
            fn="../disk/load/normalized_rows"
            in={{
                source: $in.source,
                start: $ctx.inspect.normalized_start,
                count: $ctx.inspect.normalized_count
            }}
        />

        <Call
            fn="../disk/load/renewed_rows"
            in={{
                source: $in.source,
                start: $ctx.inspect.renewed_start,
                count: $ctx.inspect.renewed_count
            }}
        />

        <Call
            module="publish"
            in={{
                input: $in,
                facts_start: $ctx.inspect.facts_start,
                wants_start: $ctx.inspect.wants_start
            }}
        />

        <Return
            value={{
                ...$ctx.publish,
                normalized: $ctx.normalized_rows,
                renewed: $ctx.renewed_rows
            }}
        />
    </If>

    <Return value={null} />
</Module>
