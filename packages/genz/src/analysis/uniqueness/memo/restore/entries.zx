import { level_modulus } from "../../replay/ordered/const"
import { normalized_width, renewed_width } from "../disk/const"
import checked from "../disk/fields/checked"

import type { Span as Output } from "../disk/model"
import type { Input as Cursor } from "../disk/rows/model"

export type Input = Cursor & {
    wide: bool
}

export default function (in: Input): Output {
    const { source, start, wide } = in

    return checked({
        source,
        start,
        stride: wide ? renewed_width : normalized_width,
        limit: level_modulus,
        mark: false,
        trusted: false
    })
}
