import type { AtomicRows } from "memory"
import type { Cell } from "../../function/updates/model"
import type { NormalizedRow, RenewedRow } from "../disk/load/model"
import type { GrowthLayout } from "../disk/model"

export type Input = {
    source: u8[],
    body: u64,
    callees: u32[],
    demanded: bool,
    input: AtomicRows,
    output: AtomicRows,
    inputs: AtomicRows,
    outputs: AtomicRows
}

export type Cursor = {
    end: u64,
    valid: bool
}

export type LevelScan = Cursor & {
    updates: Cell[]
}

export type Decoded = GrowthLayout & {
    facts_start: u64,
    wants_start: u64
}

export type Output = Decoded?

export type Publication = {
    input: Input,
    facts_start: u64,
    wants_start: u64
}

export type Updates = {
    facts: Cell[],
    wants: Cell[]
}

export type Restored = Updates & {
    normalized: NormalizedRow[],
    renewed: RenewedRow[]
}
