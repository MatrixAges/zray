<Module>
    <Type from="model" as="Record" />

    <Args in={Record.Writer} out={u64} />

    <Call
        module="../table/store"
        in={{
            ...$in.table,
            value: $in.value
        }}
    />

    <Call
        fn="limit.writeU64"
        in={[
            $in.limit,
            0,
            $ctx.store.limit
        ]}
    />

    <Return value={$ctx.store.row} />
</Module>
