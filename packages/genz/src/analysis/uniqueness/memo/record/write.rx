<Module>
    <Type from="write_input" as="Record" />

    <Args in={Record.Input} out={u64} />

    <If on={$in.target.settlement != null}>
        <Call
            fn="write_settlement"
            in={{
                target: $in.target.settlement,
                levels: $in.result.levels
            }}
        />

        <Else>
            <If on={$in.target.demand != null}>
                <Call
                    fn="write_demand"
                    in={{
                        target: $in.target.demand,
                        grew: $in.result.grew
                    }}
                />

                <Else>
                    <If on={$in.target.plan != null && $in.result.plan != null}>
                        <Call
                            fn="plan"
                            in={{
                                source: $in.result.plan,
                                target: $in.target.plan
                            }}
                        />
                    </If>
                </Else>
            </If>
        </Else>
    </If>

    <Call module="commit" in={$in.target.writer} />

    <Return value={$ctx.commit} />
</Module>
