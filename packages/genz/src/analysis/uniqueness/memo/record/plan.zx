import memory from "memory"

import type { Plan as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { source, target } = in

    memory.writeColumnBytes(target.flags, 0, source.flags)
    memory.writeColumnU64List(target.keys, 0, source.renewals.keys)
    memory.writeColumnU32Lists(target.paths, 0, source.renewals.paths)
    memory.writeColumnU64List(target.transfers, 0, source.transfers)
    memory.writeColumnU32List(target.slot_first, 0, source.slot_first)
}
