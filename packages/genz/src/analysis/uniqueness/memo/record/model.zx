import type { WriteColumn } from "memory"
import type { RowBuffer, WriteColumn as RowColumn } from "memory/columns"
import type { Planned } from "../../replay/ordered/model"
import type { PlanWrites } from "../../replay/shortcut/model"
import type { Store } from "../table/model"

export type Writer = {
    table: Store.Omit("value"),
    value: u8[]
}

export type Settlement = {
    contributions: RowBuffer,
    passed: RowColumn,
    levels: WriteColumn
}

export type Demand = {
    marks: RowBuffer,
    mark_column: RowColumn,
    normalized: WriteColumn,
    renewed: WriteColumn,
    source_normalized: u8[],
    source_renewed: u8[],
    grew: WriteColumn
}

export type Target = {
    writer: Writer,
    settlement?: Settlement,
    demand?: Demand,
    plan?: PlanWrites
}

export type Plan = {
    source: Planned,
    target: PlanWrites
}
