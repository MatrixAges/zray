import memory from "memory"

import store from "../table/store.rx"

import type { Writer as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    memory.selectAllocator(in.scope, in.table.owner)

    const stored = store({
        ...in.table,
        value: in.value
    })

    memory.writeU64(in.limit, 0, stored.limit)
    memory.selectAllocator(in.scope, in.scratch)

    return stored.row
}
