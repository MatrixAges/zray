import memory from "memory"
import columns from "memory/columns"

import decode from "../demand.rx"
import claim from "./claim"
import complete from "./complete"

import type { DemandedSection as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { index, source, start, count, marks, normalized, renewed, target } = in

    return loop({
        offset: start,
        remaining: count,
        used: memory.readU32(index.used, 0)
    }, {
        while: state => state.remaining != 0 && state.offset != 0,
        next: state => {
            const record = decode({
                source,
                start: state.offset,
                marks,
                normalized,
                renewed
            })

            if (record == null) {
                state.offset = 0
            } else {
                const row = claim({
                    index,
                    digest: record.digest,
                    used: state.used
                })

                columns.moveRowList(target.marks, row, marks.storage)
                columns.moveRowList(target.normalized, row, normalized.storage)
                columns.moveRowList(target.renewed, row, renewed.storage)
                memory.writeColumnBool(target.grew, row, record.grew)
                memory.writeColumnBool(target.used, row, false)

                state.used = complete({
                    target: index.used,
                    used: state.used,
                    row
                })
                state.offset = record.end
                state.remaining -= 1
            }
        },
        return: state => state.remaining == 0
    })
}
