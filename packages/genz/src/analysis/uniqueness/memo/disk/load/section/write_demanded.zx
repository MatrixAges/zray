import integers from "std:integer"
import { moveRowList } from "core/row_buffer"
import memory from "memory"

import claim from "../../../table/claim"

import type { DemandedWrite as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { section, used, record } = in
    const { index, target, marks, normalized, renewed } = section

    const row = claim({
        ...index,
        digest: record.digest,
        used
    })

    moveRowList([
        target.marks,
        row,
        marks.storage
    ])

    moveRowList([
        target.normalized,
        row,
        normalized.storage
    ])

    moveRowList([
        target.renewed,
        row,
        renewed.storage
    ])

    memory.writeColumnBool(target.grew, row, record.grew)
    memory.writeColumnBool(target.used, row, false)

    return row == integers.widen(used) ? used + 1 : used
}
