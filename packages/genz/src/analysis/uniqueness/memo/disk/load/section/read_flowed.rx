<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.FlowedTraversal} out={Cache.FlowedTraversal} />

    <Call
        module="../flow"
        in={{
            source: $in.section.source,
            start: $in.offset
        }}
    />

    <If on={$ctx.flow != null}>
        <Call
            fn="append_flowed"
            in={{
                records: $in.records,
                record: $ctx.flow
            }}
        />

        <Return
            value={{
                ...$in,
                offset: $ctx.flow.end,
                remaining: $in.remaining - 1,
                records: $ctx.append_flowed,
                running: $in.remaining != 1 && $ctx.flow.end != 0
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            offset: 0,
            running: false
        }}
    />
</Module>
