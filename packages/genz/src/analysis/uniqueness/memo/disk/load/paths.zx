import bytes from "std:bytes"
import integers from "std:integer"
import memory from "zig:compiler_memory"

import { word_width } from "../../encoding/const"
import vector from "../fields/vector"

import type { Rows as Input } from "./model"

export type Output = u32[][]

export default function (in: Input): Output {
    const { source, start } = in

    const rows = memory.borrowU8Range(source, start, integers.widen(in.count))
    const empty: u32[] = []
    const paths = rows.map(row => empty)[0]

    return loop({
        paths,
        offset: start,
        index: 0
    }, {
        while: state => state.index < state.paths.length,
        next: state => {
            const path = vector({
                source,
                start: state.offset,
                width: word_width
            })

            state.paths[state.index] = bytes.readU32sLe(source, path.start, path.end)
            state.offset = path.end
            state.index += 1
        },
        return: state => state.paths
    })
}
