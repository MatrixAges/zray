<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Input} out={Load.SettlementResult?} />

    <Call
        fn="split"
        in={$in.pick([
            "source",
            "start"
        ])}
    />

    <Call
        fn="../settled"
        in={{
            source: $in.source,
            start: $ctx.split.start,
            trusted: true
        }}
    />

    <If on={$ctx.settled != null}>
        <Call
            fn="contributions"
            in={{
                source: $in.source,
                start: $ctx.settled.passed_start,
                count: $ctx.settled.passed_count
            }}
        />

        <Call
            fn="payload"
            in={{
                source: $in.source,
                start: $ctx.settled.output_start,
                end: $ctx.settled.output_end
            }}
        />

        <Return
            value={{
                digest: $ctx.split.digest,
                end: $ctx.settled.end,
                passed: $ctx.contributions,
                output: $ctx.payload
            }}
        />
    </If>

    <Return value={null} />
</Module>
