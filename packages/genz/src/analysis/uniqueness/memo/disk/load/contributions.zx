import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"
import columns from "memory/columns"

import contribution from "../rows/contribution"

import type { Contributions as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { source, start, target } = in
    const { callees, levels } = target.columns

    const count = integers.widen(in.count)

    columns.allocateRows(target.storage, count)

    const written = loop({
        offset: start,
        index: 0
    }, {
        while: state => state.index < count,
        next: state => {
            const row = contribution({
                source,
                start: state.offset
            })
            const values = bytes.readU8s(source, row.start, row.end)

            memory.writeColumnU32(callees, state.index, row.callee)
            memory.writeColumnBytes(levels, state.index, values)
            state.offset = row.end
            state.index += 1
        }
    })
}
