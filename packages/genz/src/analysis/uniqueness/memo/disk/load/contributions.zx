import bytes from "std:bytes"
import integers from "std:integer"

import contribution from "../rows/contribution"

import type { ContributionRow, Rows as Input } from "./model"

export type Output = ContributionRow[]

export default function (in: Input): Output {
    const { source, start } = in

    const count = integers.widen(in.count)
    const empty: ContributionRow[] = []

    return loop({
        offset: start,
        index: 0,
        items: empty
    }, {
        while: state => state.index < count,
        next: state => {
            const row = contribution({
                source,
                start: state.offset
            })
            const levels = bytes.readU8s(source, row.start, row.end)

            state.items = state.items.push({
                callee: row.callee,
                levels
            })[0]
            state.offset = row.end
            state.index += 1
        },
        return: state => state.items
    })
}
