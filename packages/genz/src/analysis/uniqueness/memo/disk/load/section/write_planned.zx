import integers from "std:integer"
import memory from "memory"

import claim from "../../../table/claim"

import type { PlannedWrite as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { section, used, record } = in
    const { index, target } = section

    const row = claim({
        ...index,
        digest: record.digest,
        used
    })

    memory.writeColumnBytes(target.flags, row, record.flags)
    memory.writeColumnU64List(target.keys, row, record.renewals.keys)

    memory.writeColumnU32Lists(
        target.paths,
        row,
        record.renewals.paths
    )

    memory.writeColumnU64List(target.transfers, row, record.transfers)

    memory.writeColumnU32List(
        target.slot_first,
        row,
        record.slot_first
    )

    memory.writeColumnBool(target.used, row, false)

    return row == integers.widen(used) ? used + 1 : used
}
