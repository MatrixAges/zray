import { sha256_digest_width } from "core/const"
import memory from "memory"

import type { Input } from "./model"

export type Output = {
    digest: u8[],
    start: u64
}

export default function (in: Input): Output {
    return {
        digest: memory.borrowU8Range(in.source, in.start, sha256_digest_width),
        start: in.start + sha256_digest_width
    }
}
