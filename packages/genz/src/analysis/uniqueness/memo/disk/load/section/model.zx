import type { Input, Span } from "../../model"
import type { DemandResult, Flow, Plan, SettlementResult } from "../model"

export type Section = Input & Span.Pick("start", "count")

export type SettledOutcome = {
    valid: bool,
    records: SettlementResult[]
}

export type DemandedOutcome = {
    valid: bool,
    records: DemandResult[]
}

export type PlannedOutcome = {
    valid: bool,
    records: Plan[]
}

export type FlowedOutcome = {
    valid: bool,
    records: Flow[]
}

export type Position = {
    offset: u64,
    remaining: u32,
    running: bool
}

export type SettledTraversal = Position & {
    section: Section,
    records: SettlementResult[]
}

export type SettledAppend = {
    records: SettlementResult[],
    record: SettlementResult
}

export type DemandedTraversal = Position & {
    section: Section,
    records: DemandResult[]
}

export type DemandedAppend = {
    records: DemandResult[],
    record: DemandResult
}

export type PlannedTraversal = Position & {
    section: Section,
    records: Plan[]
}

export type PlannedAppend = {
    records: Plan[],
    record: Plan
}

export type FlowedTraversal = Position & {
    section: Section,
    records: Flow[]
}

export type FlowedAppend = {
    records: Flow[],
    record: Flow
}
