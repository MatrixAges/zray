import integers from "std:integer"

import { mark_width } from "../const"
import mark from "../rows/mark"

import type { MarkRow, Rows as Input } from "./model"

export type Output = MarkRow[]

export default function (in: Input): Output {
    const { source, start } = in

    const count = integers.widen(in.count)
    const empty: MarkRow[] = []

    return loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < count,
        next: state => {
            const row = mark({
                source,
                start: start + state.index * mark_width
            })

            state.items = state.items.push({
                output: row.output,
                function: row.function,
                slot: row.slot,
                want: row.want
            })[0]
            state.index += 1
        },
        return: state => state.items
    })
}
