<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Input} out={Load.Flow?} />

    <Call fn="split" in={$in} />

    <Call
        fn="../flowed"
        in={{
            source: $in.source,
            start: $ctx.split.start,
            trusted: true
        }}
    />

    <If on={$ctx.flowed != null}>
        <Call
            fn="flow_vectors"
            in={{
                source: $in.source,
                shape: $ctx.flowed
            }}
        />

        <Return
            value={{
                ...$ctx.flow_vectors,
                digest: $ctx.split.digest
            }}
        />
    </If>

    <Return value={null} />
</Module>
