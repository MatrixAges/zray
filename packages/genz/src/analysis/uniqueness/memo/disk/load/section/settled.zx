import memory from "memory"
import columns from "memory/columns"

import claim from "../../../table/claim"
import complete from "../../../table/complete"
import decode from "../settlement.rx"

import type { SettledSection as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { index, source, start, count, passed, target } = in

    return loop({
        offset: start,
        remaining: count,
        used: memory.readU32(index.used, 0)
    }, {
        while: state => state.remaining != 0 && state.offset != 0,
        next: state => {
            const record = decode({
                source,
                start: state.offset,
                passed
            })

            if (record == null) {
                state.offset = 0
            } else {
                const row = claim({
                    index,
                    digest: record.digest,
                    used: state.used
                })

                columns.moveRowList(target.passed, row, passed.storage)
                memory.writeColumnBytes(target.output, row, record.output)
                memory.writeColumnBool(target.used, row, false)

                state.used = complete({
                    target: index.used,
                    used: state.used,
                    row
                })
                state.offset = record.end
                state.remaining -= 1
            }
        },
        return: state => state.remaining == 0
    })
}
