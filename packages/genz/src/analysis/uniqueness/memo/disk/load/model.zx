import type { Target as GrowthTarget } from "../../../growth/output"
import type { Planned } from "../../../replay/ordered/model"
import type { Input as Cursor } from "../rows/model"

export type Input = Cursor

export type Rows = Input & {
    count: u32
}

export type Growth = Rows & {
    target: GrowthTarget
}

export type ContributionRow = {
    callee: u32,
    levels: u8[]
}

export type MarkRow = {
    output: bool,
    function: u32,
    slot: u32,
    want: u8
}

export type NormalizedRow = {
    id: u32,
    want: u8
}

export type RenewedRow = {
    key: u64,
    want: u8
}

export type Record = {
    digest: u8[],
    end: u64
}

export type SettlementResult = Record & {
    passed: ContributionRow[],
    output: u8[]
}

export type DemandResult = Record & {
    marks: MarkRow[],
    normalized: NormalizedRow[],
    renewed: RenewedRow[],
    grew: bool
}

export type Plan = Planned & Record

export type FlowFields = {
    end: u64,
    held: u8[],
    text_held: u8[],
    written: u8[]
}

export type Flow = FlowFields & Record
