import type { ContributionTarget, MarkTarget } from "../../../function/result/columns"
import type {
    Target as GrowthTarget,
    Targets as GrowthTargets
} from "../../../growth/output"
import type { Planned } from "../../../replay/ordered/model"
import type { Input as Cursor } from "../rows/model"

export type Input = Cursor

export type Rows = Input & {
    count: u32
}

export type Contributions = Rows & {
    target: ContributionTarget
}

export type Marks = Rows & {
    target: MarkTarget
}

export type Growth = Rows & {
    target: GrowthTarget
}

export type Settlement = Input & {
    passed: ContributionTarget
}

export type Demand = Input & GrowthTargets & {
    marks: MarkTarget
}

export type Record = {
    digest: u8[],
    end: u64
}

export type SettlementResult = Record & {
    output: u8[]
}

export type DemandResult = Record & {
    grew: bool
}

export type Plan = Planned & Record

export type FlowFields = {
    end: u64,
    held: u8[],
    text_held: u8[],
    written: u8[]
}

export type Flow = FlowFields & Record
