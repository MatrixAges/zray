import type { WriteColumn } from "memory"
import type {
    Storage,
    Target as GrowthTarget,
    Targets as GrowthTargets
} from "../../../growth/output"
import type { Planned } from "../../../replay/ordered/model"
import type { Input as Cursor } from "../rows/model"

export type Input = Cursor

export type Rows = Input & {
    count: u32
}

export type ContributionColumns = {
    callees: WriteColumn,
    levels: WriteColumn
}

export type MarkColumns = {
    output: WriteColumn,
    functions: WriteColumn,
    slots: WriteColumn,
    wants: WriteColumn
}

export type ContributionTarget = Storage & {
    columns: ContributionColumns
}

export type MarkTarget = Storage & {
    columns: MarkColumns
}

export type Contributions = Rows & {
    target: ContributionTarget
}

export type Marks = Rows & {
    target: MarkTarget
}

export type Growth = Rows & {
    target: GrowthTarget
}

export type Settlement = Input & {
    passed: ContributionTarget
}

export type Demand = Input & GrowthTargets & {
    marks: MarkTarget
}

export type SettlementResult = {
    end: u64,
    output: u8[]
}

export type DemandResult = {
    end: u64,
    grew: bool
}

export type Plan = Planned & {
    end: u64
}

export type Flow = {
    end: u64,
    held: u8[],
    text_held: u8[],
    written: u8[]
}
