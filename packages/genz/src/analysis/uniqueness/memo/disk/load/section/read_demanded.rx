<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.DemandedTraversal} out={Cache.DemandedTraversal} />

    <Call
        module="../demand"
        in={{
            source: $in.section.source,
            start: $in.offset
        }}
    />

    <If on={$ctx.demand != null}>
        <Call
            fn="append_demanded"
            in={{
                records: $in.records,
                record: $ctx.demand
            }}
        />

        <Return
            value={{
                ...$in,
                offset: $ctx.demand.end,
                remaining: $in.remaining - 1,
                records: $ctx.append_demanded,
                running: $in.remaining != 1 && $ctx.demand.end != 0
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            offset: 0,
            running: false
        }}
    />
</Module>
