<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.FlowedSection} out={bool} />

    <Call
        fn="buffers.readU32"
        in={[
            $in.index.used,
            0
        ]}
    />

    <Call
        module="read_flowed"
        while="running"
        in={{
            section: $in,
            offset: $in.start,
            remaining: $in.count,
            used: $ctx.readU32,
            running: $in.count != 0 && $in.start != 0
        }}
    />

    <Return value={$ctx.read_flowed.remaining == 0} />
</Module>
