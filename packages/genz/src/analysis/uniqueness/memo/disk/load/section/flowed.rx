<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Section} out={Cache.FlowedOutcome} />

    <Loop on={$in.running}>
        <Call
            module="read_flowed"
            in={{
                section: $in,
                offset: $in.start,
                remaining: $in.count,
                records: [],
                running: $in.count != 0 && $in.start != 0
            }}
        />
    </Loop>

    <Return
        value={{
            valid: $ctx.read_flowed.remaining == 0,
            records: $ctx.read_flowed.records
        }}
    />
</Module>
