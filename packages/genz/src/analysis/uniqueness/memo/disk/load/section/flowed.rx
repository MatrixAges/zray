<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.FlowedSection} out={Cache.Outcome} />

    <Loop on={$in.running}>
        <Call
            module="read_flowed"
            in={{
                section: $in,
                offset: $in.start,
                remaining: $in.count,
                used: $in.used,
                running: $in.count != 0 && $in.start != 0
            }}
        />
    </Loop>

    <Return
        value={{
            valid: $ctx.read_flowed.remaining == 0,
            used: $ctx.read_flowed.used
        }}
    />
</Module>
