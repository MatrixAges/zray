<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Demand} out={Load.DemandResult?} />

    <Call
        fn="../demanded"
        in={{
            source: $in.source,
            start: $in.start,
            trusted: true
        }}
    />

    <If on={$ctx.demanded != null}>
        <Call
            fn="marks"
            in={{
                source: $in.source,
                start: $ctx.demanded.marks_start,
                count: $ctx.demanded.marks_count,
                target: $in.marks
            }}
        />

        <Call
            fn="normalized"
            in={{
                source: $in.source,
                start: $ctx.demanded.normalized_start,
                count: $ctx.demanded.normalized_count,
                target: $in.normalized
            }}
        />

        <Call
            fn="renewed"
            in={{
                source: $in.source,
                start: $ctx.demanded.renewed_start,
                count: $ctx.demanded.renewed_count,
                target: $in.renewed
            }}
        />

        <Return
            value={{
                end: $ctx.demanded.end,
                grew: $ctx.demanded.grew
            }}
        />
    </If>

    <Return value={null} />
</Module>
