<Module>
    <Type from="model" as="Load" />

    <Args in={Load.Input} out={Load.DemandResult?} />

    <Call
        fn="split"
        in={$in.pick([
            "source",
            "start"
        ])}
    />

    <Call
        fn="../demanded"
        in={{
            source: $in.source,
            start: $ctx.split.start,
            trusted: true
        }}
    />

    <If on={$ctx.demanded != null}>
        <Call
            fn="marks"
            in={{
                source: $in.source,
                start: $ctx.demanded.marks_start,
                count: $ctx.demanded.marks_count
            }}
        />

        <Call
            fn="normalized_rows"
            in={{
                source: $in.source,
                start: $ctx.demanded.normalized_start,
                count: $ctx.demanded.normalized_count
            }}
        />

        <Call
            fn="renewed_rows"
            in={{
                source: $in.source,
                start: $ctx.demanded.renewed_start,
                count: $ctx.demanded.renewed_count
            }}
        />

        <Return
            value={{
                digest: $ctx.split.digest,
                end: $ctx.demanded.end,
                marks: $ctx.marks,
                normalized: $ctx.normalized_rows,
                renewed: $ctx.renewed_rows,
                grew: $ctx.demanded.grew
            }}
        />
    </If>

    <Return value={null} />
</Module>
