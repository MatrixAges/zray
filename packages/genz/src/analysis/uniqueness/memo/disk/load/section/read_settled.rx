<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.SettledTraversal} out={Cache.SettledTraversal} />

    <Call
        module="../settlement"
        in={{
            source: $in.section.source,
            start: $in.offset
        }}
    />

    <If on={$ctx.settlement != null}>
        <Call
            fn="append_settled"
            in={{
                records: $in.records,
                record: $ctx.settlement
            }}
        />

        <Return
            value={{
                ...$in,
                offset: $ctx.settlement.end,
                remaining: $in.remaining - 1,
                records: $ctx.append_settled,
                running: $in.remaining != 1 && $ctx.settlement.end != 0
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            offset: 0,
            running: false
        }}
    />
</Module>
