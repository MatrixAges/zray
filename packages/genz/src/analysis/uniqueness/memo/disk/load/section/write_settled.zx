import memory from "memory"
import columns from "memory/columns"

import claim from "../../../table/claim"
import complete from "../../../table/complete"

import type { SettledWrite as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { section, used, record } = in
    const { index, target, passed } = section

    const row = claim({
        ...index.omit(["used"]),
        digest: record.digest,
        used
    })

    columns.moveRowList(target.passed, row, passed.storage)
    memory.writeColumnBytes(target.output, row, record.output)
    memory.writeColumnBool(target.used, row, false)

    return complete({
        target: index.used,
        used,
        row
    })
}
