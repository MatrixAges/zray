import integers from "std:integer"

import { normalized_width } from "../const"
import entry from "../rows/normalized"

import type { NormalizedRow, Rows as Input } from "./model"

export type Output = NormalizedRow[]

export default function (in: Input): Output {
    const { source, start } = in

    const count = integers.widen(in.count)
    const empty: NormalizedRow[] = []

    return loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < count,
        next: state => {
            const row = entry({
                source,
                start: start + state.index * normalized_width
            })

            state.items = state.items.push({
                id: row.id,
                want: row.want
            })[0]
            state.index += 1
        },
        return: state => state.items
    })
}
