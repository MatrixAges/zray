<Module>
    <Type from="model" as="Wire" />

    <Args in={Wire.Tables} out={u8[]} />

    <Call fn="settlements" in={$in.settled} />
    <Call fn="demands" in={$in.demanded} />
    <Call fn="plans" in={$in.planned} />
    <Call fn="flows" in={$in.flowed} />

    <Call
        fn="assemble"
        in={{
            settled: $ctx.settlements,
            demanded: $ctx.demands,
            planned: $ctx.plans,
            flowed: $ctx.flows
        }}
    />

    <Return value={$ctx.assemble} />
</Module>
