import { sha256_digest_width } from "core/const"
import memory from "memory"

import type { Rows as Input } from "./model"

export type Output = u32

export default function (in: Input): Output {
    const { keys, used } = in

    const zero: u32 = 0

    return loop({
        index: 0,
        count: zero
    }, {
        while: state => state.index < keys.length / sha256_digest_width,
        next: state => {
            if (memory.readColumnBool(used, state.index)) {
                state.count += 1
            }

            state.index += 1
        },
        return: state => state.count
    })
}
