import type { ListColumn, ReadColumn } from "memory"

export type Rows = {
    used: ReadColumn,
    keys: u8[]
}

export type Tables = {
    settled: Settlements,
    demanded: Demands,
    planned: Plans,
    flowed: Flows
}

export type Sections = {
    settled: u8[],
    demanded: u8[],
    planned: u8[],
    flowed: u8[]
}

export type Selection = {
    rows: Rows,
    first: u64
}

export type Settlements = {
    rows: Rows,
    callees: ListColumn,
    levels: ListColumn,
    output: ListColumn
}

export type Demands = {
    rows: Rows,
    marks_output: ListColumn,
    marks_function: ListColumn,
    marks_slot: ListColumn,
    marks_want: ListColumn,
    normalized_id: ListColumn,
    normalized_want: ListColumn,
    renewed_key: ListColumn,
    renewed_want: ListColumn,
    grew: ReadColumn
}

export type Plans = {
    rows: Rows,
    flags: ListColumn,
    keys: ReadColumn,
    paths: ReadColumn,
    transfers: ReadColumn,
    slot_first: ReadColumn
}

export type Flows = {
    rows: Rows,
    held: ListColumn,
    text_held: ListColumn,
    written: ListColumn
}

export type Record = {
    digest: u8[],
    index: u64
}

export type Settled = Record & {
    table: Settlements
}

export type Demanded = Record & {
    table: Demands
}

export type Planned = Record & {
    table: Plans
}

export type Flowed = Record & {
    table: Flows
}
