import type { Writer } from "std:bytes"
import type { ListColumn, ReadColumn } from "memory"

export type Slots = {
    metadata: u8[],
    occupied: u8,
    used: ReadColumn,
    keys: u8[]
}

export type Tables = {
    writer: Writer,
    settled: Settlements,
    demanded: Demands,
    planned: Plans,
    flowed: Flows
}

export type Selection = {
    slots: Slots,
    first: u64
}

export type Settlements = {
    slots: Slots,
    callees: ListColumn,
    levels: ListColumn,
    output: ListColumn
}

export type Demands = {
    slots: Slots,
    marks_output: ListColumn,
    marks_function: ListColumn,
    marks_slot: ListColumn,
    marks_want: ListColumn,
    normalized_id: ListColumn,
    normalized_want: ListColumn,
    renewed_key: ListColumn,
    renewed_want: ListColumn,
    grew: ReadColumn
}

export type Plans = {
    slots: Slots,
    flags: ListColumn,
    keys: ReadColumn,
    paths: ReadColumn,
    transfers: ReadColumn,
    slot_first: ReadColumn
}

export type Flows = {
    slots: Slots,
    held: ListColumn,
    text_held: ListColumn,
    written: ListColumn
}

export type Count = {
    writer: Writer,
    count: u32
}

export type Record = {
    writer: Writer,
    digest: u8[],
    index: u64
}

export type Settled = Record & {
    table: Settlements
}

export type Demanded = Record & {
    table: Demands
}

export type Planned = Record & {
    table: Plans
}

export type Flowed = Record & {
    table: Flows
}
