import memory from "memory"

import type { Selection as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { metadata, occupied, used } = in.slots

    return loop({
        index: in.first,
        found: false
    }, {
        while: state => !state.found && state.index < metadata.length,
        next: state => {
            if (metadata[state.index] >= occupied) {
                state.found = memory.readColumnBool(used, state.index)
            }

            state.index += 1
        },
        return: state => state.found ? state.index - 1 : state.index
    })
}
