import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { level_modulus } from "../../../replay/ordered/const"
import { true_byte } from "../const"

import type { Settled as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { writer, table, index } = in
    const { callees, levels } = table

    const mask = level_modulus - true_byte
    const count = memory.listLength(callees, index)

    bytes.write(writer, in.digest)
    bytes.writeU32Le(writer, integers.narrow(count))

    const first: u64 = 0

    const passed_written = loop(first, {
        while: member => member < count,
        next: member => {
            const callee = memory.readListU32(callees, index, member)
            const payload = bytes.fromText(memory.readListText(levels, index, member))

            bytes.writeU32Le(writer, callee)
            bytes.writeU32Le(writer, integers.narrow(payload.length))
            bytes.writeMasked(writer, payload, mask)

            member += 1
        }
    })

    const output = memory.borrowListBytes(table.output, index)

    bytes.writeU32Le(writer, integers.narrow(output.length))
    bytes.writeMasked(writer, output, mask)
    bytes.writeByte(writer, true_byte)
}
