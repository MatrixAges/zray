import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { level_modulus } from "../../../replay/ordered/const"
import { true_byte } from "../const"

import type { Settled as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { table, index } = in
    const { callees, levels } = table

    const mask = level_modulus - true_byte
    const count = memory.listLength(callees, index)

    const initial: u8[][] = [
        in.digest,
        bytes.encodeU32Le(integers.narrow(count))
    ]

    const collected = loop({
        member: 0,
        parts: initial
    }, {
        while: state => state.member < count,
        next: state => {
            const callee = memory.readListU32(callees, index, state.member)
            const payload =
                bytes.fromText(memory.readListText(levels, index, state.member))

            const entry = bytes.join(bytes.fromText(""), [
                bytes.encodeU32Le(callee),
                bytes.encodeU32Le(integers.narrow(payload.length)),
                bytes.mask(payload, mask)
            ])

            state.parts = state.parts.push(entry)[0]
            state.member += 1
        },
        return: state => state.parts
    })

    const output = memory.borrowListBytes(table.output, index)

    return bytes.join(bytes.fromText(""), [
        bytes.join(bytes.fromText(""), collected),
        bytes.encodeU32Le(integers.narrow(output.length)),
        bytes.mask(output, mask),
        bytes.repeat(1, true_byte)
    ])
}
