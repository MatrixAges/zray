import { sha256_digest_width } from "core/const"
import memory from "memory"

import count from "./count"
import write from "./demanded"
import population from "./population"
import selected from "./selected"

import type { Writer } from "std:bytes"
import type { Demands as Table } from "./model"

export type Input = {
    writer: Writer,
    table: Table
}

export type Output = void

export default function (in: Input): Output {
    const { writer, table } = in
    const { rows } = table

    count({
        writer,
        count: population(rows)
    })

    const first = selected({
        rows,
        first: 0
    })

    const last: u64 = rows.keys.length / sha256_digest_width

    const written = loop(first, {
        while: index => index < last,
        next: index => {
            const digest = memory.borrowU8Range(
                rows.keys,
                index * sha256_digest_width,
                sha256_digest_width
            )

            write({
                writer,
                digest,
                index,
                table
            })

            index = selected({
                rows,
                first: index + 1
            })
        }
    })
}
