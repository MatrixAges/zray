import bytes from "std:bytes"
import { sha256_digest_width } from "core/const"
import memory from "memory"

import write from "./demanded"
import population from "./population"
import selected from "./selected"

import type { Demands as Table } from "./model"

export type Input = Table

export type Output = u8[]

export default function (in: Input): Output {
    const { rows } = in

    const first = selected({
        rows,
        first: 0
    })

    const last: u64 = rows.keys.length / sha256_digest_width

    const initial: u8[][] = [bytes.encodeU32Le(population(rows))]

    const collected = loop({
        index: first,
        parts: initial
    }, {
        while: state => state.index < last,
        next: state => {
            const digest = memory.borrowU8Range(
                rows.keys,
                state.index * sha256_digest_width,
                sha256_digest_width
            )

            const entry = write({
                digest,
                index: state.index,
                table: in
            })

            state.parts = state.parts.push(entry)[0]
            state.index = selected({
                rows,
                first: state.index + 1
            })
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), collected)
}
