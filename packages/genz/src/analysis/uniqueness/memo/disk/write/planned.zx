import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { true_byte } from "../const"

import type { Planned as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { table, index } = in

    const flags = memory.borrowListBytes(table.flags, index)
    const keys = memory.readColumnU64List(table.keys, index)
    const paths = memory.readColumnU32Lists(table.paths, index)
    const transfers = memory.readColumnU64List(table.transfers, index)
    const slot_first = memory.readColumnU32List(table.slot_first, index)

    const initial: u8[][] = [
        in.digest,
        bytes.encodeU32Le(integers.narrow(flags.length)),
        flags,
        bytes.encodeU32Le(integers.narrow(keys.length)),
        bytes.encodeU64sLe(keys),
        bytes.encodeU32Le(integers.narrow(paths.length))
    ]

    const collected = loop({
        index: 0,
        parts: initial
    }, {
        while: state => state.index < paths.length,
        next: state => {
            const path = paths[state.index]

            const entry = bytes.join(bytes.fromText(""), [
                bytes.encodeU32Le(integers.narrow(path.length)),
                bytes.encodeU32sLe(path)
            ])

            state.parts = state.parts.push(entry)[0]
            state.index += 1
        },
        return: state => state.parts
    })

    return bytes.join(bytes.fromText(""), [
        bytes.join(bytes.fromText(""), collected),
        bytes.encodeU32Le(integers.narrow(transfers.length)),
        bytes.encodeU64sLe(transfers),
        bytes.encodeU32Le(integers.narrow(slot_first.length)),
        bytes.encodeU32sLe(slot_first),
        bytes.repeat(1, true_byte)
    ])
}
