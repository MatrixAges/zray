import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { level_modulus } from "../../../replay/ordered/const"
import { false_byte, true_byte } from "../const"

import type { Demanded as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { writer, table, index } = in

    const mark_count = memory.listLength(table.marks_function, index)
    const normalized_count = memory.listLength(table.normalized_id, index)
    const renewed_count = memory.listLength(table.renewed_key, index)

    const first: u64 = 0

    bytes.write(writer, in.digest)
    bytes.writeU32Le(writer, integers.narrow(mark_count))

    const marks_written = loop(first, {
        while: member => member < mark_count,
        next: member => {
            const output = memory.readListBool(table.marks_output, index, member)
            const callee = memory.readListU32(table.marks_function, index, member)
            const slot = memory.readListU32(table.marks_slot, index, member)
            const want = memory.readListU8(table.marks_want, index, member)

            bytes.writeByte(writer, output ? true_byte : false_byte)
            bytes.writeU32Le(writer, callee)
            bytes.writeU32Le(writer, slot)
            bytes.writeByte(writer, want % level_modulus)

            member += 1
        }
    })

    bytes.writeU32Le(writer, integers.narrow(normalized_count))

    const normalized_written = loop(first, {
        while: member => member < normalized_count,
        next: member => {
            const id = memory.readListU32(table.normalized_id, index, member)
            const want = memory.readListU8(table.normalized_want, index, member)

            bytes.writeU32Le(writer, id)
            bytes.writeByte(writer, want % level_modulus)

            member += 1
        }
    })

    bytes.writeU32Le(writer, integers.narrow(renewed_count))

    const renewed_written = loop(first, {
        while: member => member < renewed_count,
        next: member => {
            const key = memory.readListU64(table.renewed_key, index, member)
            const want = memory.readListU8(table.renewed_want, index, member)

            bytes.writeU64Le(writer, key)
            bytes.writeByte(writer, want % level_modulus)

            member += 1
        }
    })

    const grew = memory.readColumnBool(table.grew, index)

    bytes.writeByte(writer, grew ? true_byte : false_byte)
    bytes.writeByte(writer, true_byte)
}
