import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { level_modulus } from "../../../replay/ordered/const"
import { false_byte, true_byte } from "../const"

import type { Demanded as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { table, index } = in

    const mark_count = memory.listLength(table.marks_function, index)
    const normalized_count = memory.listLength(table.normalized_id, index)
    const renewed_count = memory.listLength(table.renewed_key, index)

    const initial: u8[][] = [
        in.digest,
        bytes.encodeU32Le(integers.narrow(mark_count))
    ]

    const with_marks = loop({
        member: 0,
        parts: initial
    }, {
        while: state => state.member < mark_count,
        next: state => {
            const output = memory.readListBool(table.marks_output, index, state.member)
            const callee = memory.readListU32(table.marks_function, index, state.member)
            const slot = memory.readListU32(table.marks_slot, index, state.member)
            const want = memory.readListU8(table.marks_want, index, state.member)

            const entry = bytes.join(bytes.fromText(""), [
                bytes.repeat(1, output ? true_byte : false_byte),
                bytes.encodeU32Le(callee),
                bytes.encodeU32Le(slot),
                bytes.repeat(1, want % level_modulus)
            ])

            state.parts = state.parts.push(entry)[0]
            state.member += 1
        },
        return: state => state.parts
    })

    const with_normalized = loop({
        member: 0,
        parts:
            with_marks.push(bytes.encodeU32Le(
                integers.narrow(
                    normalized_count
                )
            ))[0]
    }, {
        while: state => state.member < normalized_count,
        next: state => {
            const id = memory.readListU32(table.normalized_id, index, state.member)
            const want = memory.readListU8(table.normalized_want, index, state.member)

            const entry = bytes.join(bytes.fromText(""), [
                bytes.encodeU32Le(id),
                bytes.repeat(1, want % level_modulus)
            ])

            state.parts = state.parts.push(entry)[0]
            state.member += 1
        },
        return: state => state.parts
    })

    const with_renewed = loop({
        member: 0,
        parts:
            with_normalized.push(
                bytes.encodeU32Le(
                    integers.narrow(
                        renewed_count
                    )
                )
            )[0]
    }, {
        while: state => state.member < renewed_count,
        next: state => {
            const key = memory.readListU64(table.renewed_key, index, state.member)
            const want = memory.readListU8(table.renewed_want, index, state.member)

            const entry = bytes.join(bytes.fromText(""), [
                bytes.encodeU64Le(key),
                bytes.repeat(1, want % level_modulus)
            ])

            state.parts = state.parts.push(entry)[0]
            state.member += 1
        },
        return: state => state.parts
    })

    const grew = memory.readColumnBool(table.grew, index)

    return bytes.join(bytes.fromText(""), [
        bytes.join(bytes.fromText(""), with_renewed),
        bytes.repeat(1, grew ? true_byte : false_byte),
        bytes.repeat(1, true_byte)
    ])
}
