import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { true_byte } from "../const"

import type { Flowed as Input } from "./model"

export type Output = u8[]

export default function (in: Input): Output {
    const { table, index } = in

    const held = memory.borrowListBytes(table.held, index)
    const text_held = memory.borrowListBytes(table.text_held, index)
    const written = memory.borrowListBytes(table.written, index)

    return bytes.join(bytes.fromText(""), [
        in.digest,
        bytes.encodeU32Le(integers.narrow(held.length)),
        bytes.mask(held, true_byte),
        bytes.encodeU32Le(integers.narrow(text_held.length)),
        bytes.mask(text_held, true_byte),
        bytes.encodeU32Le(integers.narrow(written.length)),
        bytes.mask(written, true_byte),
        bytes.repeat(1, true_byte)
    ])
}
