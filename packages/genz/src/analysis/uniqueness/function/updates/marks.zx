import integers from "std:integer"
import memory from "memory"

import cell from "./cell"

import type { AtomicRows } from "std:bytes"
import type { ReadColumn } from "memory"

export type Marks = {
    output: ReadColumn,
    functions: ReadColumn,
    slots: ReadColumn,
    wants: ReadColumn,
    count: u64
}

export type Input = {
    inputs: AtomicRows,
    outputs: AtomicRows,
    marks: Marks
}

export type Output = u64[]

export default function (in: Input): Output {
    const { inputs, outputs, marks } = in

    const changed: u64[] = []

    return loop({
        changed,
        index: 0
    }, {
        while: state => state.index < marks.count,
        next: state => {
            const index = state.index
            const output = memory.readColumnBool(marks.output, index)
            const rows = output ? outputs : inputs
            const row = integers.widen(memory.readColumnU32(marks.functions, index))
            const updated = cell({
                rows,
                row,
                slot: integers.widen(memory.readColumnU32(marks.slots, index)),
                level: memory.readColumnU8(marks.wants, index),
                joining: true
            })

            if (updated) {
                state.changed = state.changed.push(row)[0]
            }

            state.index += 1
        },
        return: state => state.changed
    })
}
