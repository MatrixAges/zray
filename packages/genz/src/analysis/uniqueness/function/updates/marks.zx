import integers from "std:integer"
import memory from "memory"

import cell from "./cell"
import load from "./pending/load"

import type { AtomicRows, ReadColumn } from "memory"
import type { Batch as Output, Cell } from "./model"

export type Marks = {
    output: ReadColumn,
    functions: ReadColumn,
    slots: ReadColumn,
    wants: ReadColumn,
    count: u64
}

export type Input = {
    inputs: AtomicRows,
    outputs: AtomicRows,
    marks: Marks
}

export default function (in: Input): Output {
    const { inputs, outputs, marks } = in

    const changed: u64[] = []
    const updates: Cell[] = []

    return loop({
        changed,
        updates,
        index: 0
    }, {
        while: state => state.index < marks.count,
        next: state => {
            const index = state.index
            const output = memory.readColumnBool(marks.output, index)
            const rows = output ? outputs : inputs
            const row = integers.widen(memory.readColumnU32(marks.functions, index))
            const slot = integers.widen(memory.readColumnU32(marks.slots, index))

            const before = match {
                state.updates.length == 0 => memory.loadAtomicCell(rows, row, slot),
                _ => load({
                    updates: state.updates,
                    rows,
                    row,
                    slot,
                    output
                })
            }

            const updated = cell({
                before,
                level: memory.readColumnU8(marks.wants, index),
                joining: true
            })

            if (updated != null) {
                state.updates = state.updates.push({
                    row,
                    slot,
                    output,
                    value: updated
                })[0]
                state.changed = state.changed.push(row)[0]
            }

            state.index += 1
        },
        return: state => ({
            changed: state.changed,
            updates: state.updates
        })
    })
}
