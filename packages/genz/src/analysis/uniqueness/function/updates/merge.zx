import integers from "std:integer"

import cell from "./cell"

import type { AtomicRows } from "std:bytes"

export type Input = {
    rows: AtomicRows,
    row: u32,
    first: u32,
    levels: u8[],
    joining: bool
}

export type Output = u64

export default function (in: Input): Output {
    const row = integers.widen(in.row)
    const first = integers.widen(in.first)

    const { rows, levels, joining } = in

    return loop({
        index: 0,
        changed: 0
    }, {
        while: state => state.index < levels.length,
        next: state => {
            const changed = cell({
                rows,
                row,
                slot: first + state.index,
                level: levels[state.index],
                joining
            })

            if (changed) {
                state.changed += 1
            }

            state.index += 1
        },
        return: state => state.changed
    })
}
