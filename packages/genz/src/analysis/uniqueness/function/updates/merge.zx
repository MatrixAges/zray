import integers from "std:integer"
import memory from "memory"

import cell from "./cell"
import load from "./pending/load"

import type { AtomicRows } from "memory"
import type { Cell } from "./model"

export type Input = {
    rows: AtomicRows,
    updates: Cell[],
    row: u32,
    levels: u8[],
    output: bool
}

export type Output = Cell[]

export default function (in: Input): Output {
    const row = integers.widen(in.row)

    const { rows, levels, output, updates } = in

    return loop({
        index: 0,
        updates
    }, {
        while: state => state.index < levels.length,
        next: state => {
            const slot = state.index
            const before = match {
                updates.length == 0 => memory.loadAtomicCell(rows, row, slot),
                _ => load({
                    updates,
                    rows,
                    row,
                    slot,
                    output
                })
            }

            const next = cell({
                before,
                level: levels[state.index],
                joining: false
            })

            if (next != null) {
                state.updates = state.updates.push({
                    row,
                    slot,
                    output,
                    value: next
                })[0]
            }

            state.index += 1
        },
        return: state => state.updates
    })
}
