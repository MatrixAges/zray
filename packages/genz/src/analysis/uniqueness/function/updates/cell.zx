import join from "../../level/join"
import decode from "../levels/decode"
import encode from "../levels/encode"
import knowledge from "../levels/knowledge"
import meet from "../levels/meet"
import value from "../levels/value"

export type Input = {
    before: u8,
    level: u8,
    joining: bool
}

export type Output = u8?

export default function (in: Input): Output {
    const before = decode(in.before)
    const incoming = decode(in.level)

    const next = match {
        in.joining => knowledge(join({
            left: value(before),
            right: value(incoming)
        })),
        _ => meet({
            left: before,
            right: incoming
        })
    }

    return next == before ? null : encode(next)
}
