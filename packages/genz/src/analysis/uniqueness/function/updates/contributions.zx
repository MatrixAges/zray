import integers from "std:integer"
import memory from "memory"

import merge from "./merge"

import type { AtomicRows } from "memory"
import type { ContributionRows } from "../result/columns"
import type { Batch as Output, Cell } from "./model"

export type Input = {
    inputs: AtomicRows,
    contributions: ContributionRows
}

export default function (in: Input): Output {
    const { inputs, contributions } = in

    const changed: u64[] = []
    const updates: Cell[] = []

    return loop({
        changed,
        updates,
        index: 0
    }, {
        while: state => state.index < contributions.count,
        next: state => {
            const callee = memory.readColumnU32(contributions.callees, state.index)
            const levels = memory.borrowListBytes(contributions.levels, state.index)
            const previous_count = state.updates.length

            state.updates = merge({
                rows: inputs,
                updates: state.updates,
                row: callee,
                levels,
                output: false
            })

            if (state.updates.length != previous_count) {
                state.changed = state.changed.push(integers.widen(callee))[0]
            }

            state.index += 1
        },
        return: state => ({
            changed: state.changed,
            updates: state.updates
        })
    })
}
