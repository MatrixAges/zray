import integers from "std:integer"
import memory from "memory"

import decode from "../levels/decode"
import encode from "../levels/encode"
import meet from "../levels/meet"

import type { AtomicRows } from "memory"
import type { Knowledge } from "../levels/model"

export type Input = {
    inputs: AtomicRows,
    callee: u32,
    slot: u64,
    value: Knowledge,
    changed: u64[]
}

export type Output = u64[]

export default function (in: Input): Output {
    const row = integers.widen(in.callee)
    const previous = decode(memory.loadAtomicCell(in.inputs, row, in.slot))

    const next = meet({
        left: previous,
        right: in.value
    })

    if (next == previous) {
        return in.changed
    }

    memory.storeAtomicCell(in.inputs, row, in.slot, encode(next))

    return in.changed.push(row)[0]
}
