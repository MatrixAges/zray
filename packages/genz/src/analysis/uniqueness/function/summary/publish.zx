import integers from "std:integer"
import memory from "memory"

import encode from "../levels/encode"
import cell from "../updates/cell"
import load from "../updates/pending/load"

import type { AtomicRows } from "memory"
import type { Knowledge } from "../levels/model"
import type { Cell } from "../updates/model"

export type Input = {
    inputs: AtomicRows,
    callee: u32,
    slot: u64,
    value: Knowledge,
    updates: Cell[]
}

export type Output = Cell[]

export default function (in: Input): Output {
    const { callee, slot, updates } = in

    const row = integers.widen(callee)
    const rows = in.inputs

    const before = match {
        updates.length == 0 => memory.loadAtomicCell(rows, row, slot),
        _ => load({
            updates,
            rows,
            row,
            slot,
            output: false
        })
    }

    const next = cell({
        before,
        level: encode(in.value),
        joining: false
    })

    if (next == null) {
        return updates
    }

    return updates.push({
        row,
        slot,
        output: false,
        value: next
    })[0]
}
