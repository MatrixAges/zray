import type { AtomicRows } from "memory"
import type { Context, Knowledge, Read } from "../levels/model"
import type { Batch } from "../updates/model"

export type Working = {
    known: Knowledge[],
    reads: Read[]
}

export type ReturnSource = {
    context: Context,
    carried: Knowledge[][],
    results: u32[],
    count: u64
}

export type ReturnStage = {
    source: ReturnSource,
    working: Working
}

export type Returned = {
    known: Knowledge[],
    reads: Read[],
    levels: Knowledge[]
}

export type ArgumentSource = {
    context: Context,
    carried: Knowledge[][],
    operations: u32[],
    inputs: AtomicRows,
    deferred: bool
}

export type ArgumentStage = {
    source: ArgumentSource,
    working: Working
}

export type Contribution = {
    callee: u32,
    guarantees: u8[]
}

export type Contributed = Batch & {
    known: Knowledge[],
    reads: Read[],
    passed: Contribution[]
}

export type Settlement = {
    context: Context,
    repeated: u32[],
    operations: u32[],
    inputs: AtomicRows,
    deferred: bool,
    results: u32[],
    count: u64
}

export type Settled = Batch & {
    reads: Read[],
    passed: Contribution[],
    levels: Knowledge[]
}
