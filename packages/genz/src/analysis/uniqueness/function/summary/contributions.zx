import integers from "std:integer"
import memory from "memory"

import encode from "../levels/encode"
import query from "../levels/query"
import publish from "./publish"

import type { Cell } from "../updates/model"
import type {
    ArgumentStage as Input,
    Contributed as Output,
    Contribution
} from "./model"

export default function (in: Input): Output {
    const passed: Contribution[] = []
    const updates: Cell[] = []

    const loop_initial = {
        known: in.working.known,
        reads: in.working.reads,
        index: 0,
        passed,
        updates
    }

    const readonly_source = in.source

    return loop(loop_initial, {
        while: state => state.index < readonly_source.operations.length,
        next: state => {
            const expressions = readonly_source.context.metadata.expressions

            const node = integers.widen(readonly_source.operations[state.index])

            const payload = integers.widen(expressions.payloads[node])
            const callee = expressions.call_functions[payload]
            const count =
                memory.atomicRowLength(
                    readonly_source.inputs,
                    integers.widen(callee)
                )
            const levels: u8[] = []

            const row_initial = {
                known: state.known,
                reads: state.reads,
                updates: state.updates,
                levels,
                slot: 0
            }

            const row_scope = {
                source: readonly_source,
                callee,
                count,
                argument: expressions.call_arguments[payload]
            }

            const row = loop(row_initial, {
                while: current => current.slot < row_scope.count,
                next: current => {
                    const context = row_scope.source.context

                    // Recursive calls can change the input guarantee read later in this visit.
                    const view = match {
                        current.updates.length == 0 => context,
                        _ => {
                            ...context,
                            pending_input: current.updates
                        }
                    }

                    const result = query({
                        context: view,
                        state: {
                            known: current.known,
                            carried: row_scope.source.carried,
                            reads: current.reads
                        },
                        request: {
                            node: row_scope.argument,
                            slot: integers.narrow(current.slot),
                            raw: false
                        }
                    })

                    current.known = result.known
                    current.reads = result.reads
                    current.levels = current.levels.push(encode(result.value))[0]

                    if (!row_scope.source.deferred) {
                        current.updates = publish({
                            inputs: row_scope.source.inputs,
                            callee: row_scope.callee,
                            slot: current.slot,
                            value: result.value,
                            updates: current.updates
                        })
                    }

                    current.slot += 1
                }
            })

            state.known = row.known
            state.reads = row.reads
            state.updates = row.updates
            state.passed = state.passed.push({
                callee,
                guarantees: row.levels
            })[0]

            state.index += 1
        },
        return: state => ({
            ...state.pick([
                "known",
                "reads",
                "passed"
            ]),
            changed: state.updates.map(update => update.row)[0],
            updates: state.updates
        })
    })
}
