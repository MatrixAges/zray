import integers from "std:integer"
import memory from "memory"

import decode from "../levels/decode"

import type { AtomicRows } from "memory"
import type { Knowledge, Table } from "../levels/model"
import type { Working } from "./model"

export type Input = {
    rows: AtomicRows,
    working: Working,
    table: Table,
    function_index: u32,
    slot: u32
}

export type Output = {
    working: Working,
    value: Knowledge
}

export default function (in: Input): Output {
    const working = in.working

    const value = decode(
        memory.loadAtomicCell(
            in.rows,
            integers.widen(in.function_index),
            integers.widen(in.slot)
        )
    )

    return {
        working: {
            ...working,
            reads: match {
                working.context.metadata.record => working.reads.push({
                    table: in.table,
                    function_index: in.function_index,
                    slot: in.slot,
                    value
                })[0],
                _ => working.reads
            }
        },
        value
    }
}
