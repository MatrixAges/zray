import integers from "std:integer"
import memory from "memory"

import decode from "../levels/decode"
import { Table } from "../levels/model"
import load from "../updates/pending/load"

import type { AtomicRows } from "memory"
import type { Knowledge } from "../levels/model"
import type { Working } from "./model"

export type Input = {
    rows: AtomicRows,
    working: Working,
    table: Table,
    function_index: u32,
    slot: u32
}

export type Output = {
    working: Working,
    value: Knowledge
}

export default function (in: Input): Output {
    const { working, rows } = in

    const row = integers.widen(in.function_index)
    const slot = integers.widen(in.slot)
    const updates = working.updates

    const stored = match {
        updates.length == 0 => memory.loadAtomicCell(rows, row, slot),
        _ => load({
            updates,
            rows,
            row,
            slot,
            output: in.table == Table.Outputs
        })
    }

    const value = decode(stored)

    return {
        working: {
            ...working,
            reads: match {
                working.context.metadata.record => working.reads.push({
                    table: in.table,
                    function_index: in.function_index,
                    slot: in.slot,
                    value
                })[0],
                _ => working.reads
            }
        },
        value
    }
}
