import integers from "std:integer"
import { allocateRows } from "core/row_buffer"
import memory from "memory"
import columns from "memory/columns"

import encode from "../../levels/encode"

import type { Write as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { rows, target, wide } = in

    const { keys, wants } = target.columns

    allocateRows({
        target: target.storage,
        count: rows.count
    })

    if (rows.stored != null) {
        columns.copyRowPrefix(target.storage, rows.stored.bytes, rows.count)

        return
    }

    const first: u64 = 0

    const written = loop(first, {
        while: index => index < rows.count,
        next: index => {
            const row = rows.items[index]

            if (wide) {
                memory.writeColumnU64(keys, index, row.key)
            } else {
                memory.writeColumnU32(
                    keys,
                    index,
                    integers.narrow(row.key)
                )
            }

            memory.writeColumnU8(wants, index, encode(row.value))
            index += 1
        }
    })
}
