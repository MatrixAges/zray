import integers from "std:integer"

import encode from "../../levels/encode"

import type { Batch as Output, Write as Input } from "./model"

export default function (in: Input): Output {
    const { rows, wide } = in

    if (rows.stored != null) {
        return {
            stored: rows.stored.bytes,
            items: []
        }
    }

    return {
        items: rows.items.map(row => {
            const key = match {
                wide => row.key,
                _ => integers.widen(integers.narrow(row.key))
            }

            return {
                key,
                want: encode(row.value)
            }
        })[0]
    }
}
