import type { WriteColumn } from "zig:compiler_memory"
import type { Growth } from "../../levels/model"

export type Columns = {
    keys: WriteColumn,
    wants: WriteColumn
}

export type Input = {
    normalized: Growth[],
    renewed: Growth[],
    normalized_target: Columns,
    renewed_target: Columns
}

export type Write = {
    rows: Growth[],
    target: Columns,
    wide: bool
}
