import type { GrowthRows } from "../../levels/model"

export type Input = {
    normalized: GrowthRows,
    renewed: GrowthRows
}

export type Write = {
    rows: GrowthRows,
    wide: bool
}

export type Row = {
    key: u64,
    want: u8
}

export type Batch = {
    stored?: u8[],
    items: Row[]
}

export type Snapshot = {
    normalized: Batch,
    renewed: Batch
}
