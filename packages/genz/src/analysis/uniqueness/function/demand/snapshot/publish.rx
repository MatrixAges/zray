<Module>
    <Type from="model" as="Growth" />

    <Args in={Growth.Input} out={Growth.Snapshot} />

    <Task name="normalized" out={$ctx.write}>
        <Call
            fn="write"
            in={{
                rows: $in.normalized,
                wide: false
            }}
        />
    </Task>

    <Call
        fn="write"
        in={{
            rows: $in.renewed,
            wide: true
        }}
    />

    <Return
        value={{
            normalized: $ctx.task.normalized,
            renewed: $ctx.write
        }}
    />
</Module>
