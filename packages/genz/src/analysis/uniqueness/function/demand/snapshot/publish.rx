<Module>
    <Type from="model" as="Growth" />

    <Args in={Growth.Input} out={void} />

    <Call
        fn="write"
        in={{
            rows: $in.normalized,
            target: $in.targets.normalized,
            wide: false,
            owner: $in.owner
        }}
    />

    <Call
        fn="write"
        in={{
            rows: $in.renewed,
            target: $in.targets.renewed,
            wide: true,
            owner: $in.owner
        }}
    />
</Module>
