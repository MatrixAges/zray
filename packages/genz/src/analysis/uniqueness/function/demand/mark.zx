import integers from "std:integer"
import memory from "memory"

import encode from "../levels/encode"
import cell from "../updates/cell"
import load from "../updates/pending/load"

import type { Exchange, Mark, Working } from "./model"

export type Input = {
    exchange: Exchange,
    working: Working,
    mark: Mark
}

export type Output = Working

export default function (in: Input): Output {
    const working = {
        ...in.working,
        marks: in.working.marks.push(in.mark)[0]
    }

    if (in.exchange.deferred) {
        return working
    }

    const { output } = in.mark

    const rows = output ? in.exchange.outputs : in.exchange.inputs
    const row = integers.widen(in.mark.function_index)
    const slot = integers.widen(in.mark.slot)
    const updates = working.updates

    const before = match {
        updates.length == 0 => memory.loadAtomicCell(rows, row, slot),
        _ => load({
            updates,
            rows,
            row,
            slot,
            output
        })
    }

    const next = cell({
        before,
        level: encode(in.mark.want),
        joining: true
    })

    if (next == null) {
        return working
    }

    return {
        ...working,
        changed: working.changed.push(row)[0],
        updates: updates.push({
            row,
            slot,
            output,
            value: next
        })[0]
    }
}
