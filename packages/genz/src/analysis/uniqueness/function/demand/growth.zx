import join from "../../level/join"
import find from "../levels/growth/find"
import materialize from "../levels/growth/materialize"
import knowledge from "../levels/knowledge"
import value from "../levels/value"

import type { GrowthRows, Knowledge } from "../levels/model"

export type Input = {
    entries: GrowthRows,
    key: u64,
    want: Knowledge
}

export type Output = {
    entries: GrowthRows,
    grew: bool
}

export default function (in: Input): Output {
    const found = find({
        rows: in.entries,
        key: in.key
    })

    const next = match {
        found.value == null => in.want,
        _ => knowledge(join({
            left: value(found.value),
            right: value(in.want)
        }))
    }

    if (found.value != null && next == found.value) {
        return {
            entries: in.entries,
            grew: false
        }
    }

    const items = materialize(in.entries)

    const entry = {
        key: in.key,
        value: next
    }

    const updated = match {
        found.value == null => items.push(entry)[0],
        _ => items.with(found.index, entry)
    }

    return {
        entries: {
            count: updated.length,
            stored: null,
            items: updated
        },
        grew: true
    }
}
