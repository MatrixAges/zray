import type { AtomicRows } from "std:bytes"
import type { Context, Knowledge, Read } from "../levels/model"
import type { Seen } from "./seen/model"

export type Mark = {
    output: bool,
    function_index: u32,
    slot: u32,
    want: Knowledge
}

export type Exchange = {
    return_allocations: bool[],
    inputs: AtomicRows,
    outputs: AtomicRows,
    deferred: bool
}

export type Source = {
    kinds: u8[],
    carried: Knowledge[][],
    exchange?: Exchange,
    function_index?: u32,
    operations: u32[],
    results: u32[]
}

export type Working = {
    context: Context,
    known: Knowledge[],
    reads: Read[],
    seen: Seen,
    marks: Mark[],
    changed: u64[],
    grew: bool
}

export type Input = {
    context: Context,
    known: Knowledge[],
    source: Source
}

export type Stage = {
    source: Source,
    working: Working
}

export type Request = {
    node: u32,
    slot: u32,
    outer?: u32,
    repeated: bool,
    wanted: Knowledge
}

export type Trace = {
    source: Source,
    working: Working,
    request: Request
}

export type Output = Working.Omit("seen")

export type Continuation = {
    working: Working,
    request?: Request
}

export type Visit = {
    context: Context,
    repeated: u32[],
    source: Source.Omit("carried")
}

export type Demanded = Context.Pick("normalized", "renewed") &
    Output.Pick("marks", "changed", "grew") & {
        before: Read[],
        after: Read[]
    }
