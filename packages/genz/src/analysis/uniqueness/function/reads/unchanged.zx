import bytes from "std:bytes"
import integers from "std:integer"

import decode from "../levels/decode"

import type { AtomicRows } from "std:bytes"

export type Record = {
    table: u8,
    function: u32,
    slot: u32,
    value: u8
}

export type Input = {
    reads: Record[],
    tables: AtomicRows[]
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        same: true
    }, {
        while: state => state.same && state.index < in.reads.length,
        next: state => {
            const read = in.reads[state.index]
            const current = bytes.loadAtomicCell(
                in.tables[integers.widenByte(
                    read.table
                )],
                integers.widen(read.function),
                integers.widen(read.slot)
            )

            state.same = decode(current) == decode(read.value)
            state.index += 1
        },
        return: state => state.same
    })
}
