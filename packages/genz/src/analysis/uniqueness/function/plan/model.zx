import type { Table } from "core/type_table/model"
import type { Planned } from "../../replay/ordered/model"
import type { Context, Knowledge, Metadata, Read } from "../levels/model"

export type Snapshot = {
    known: Knowledge[],
    carried: Knowledge[][]
}

export type Input = {
    context: Context,
    state: Snapshot,
    types: Table,
    time: u32[],
    operations: u32[],
    repeated: u32[]
    results: u32[]
}

export type Working = Output.Omit("needed", "keys", "writable")

export type Stage = {
    source: Input,
    working: Working
}

export type Selected = {
    working: Working,
    keys: u64[],
    writable: u64[]
}

export type Output = {
    known: Knowledge[],
    reads: Read[],
    flags: u64[],
    keys: u64[],
    writable: u64[],
    needed: bool[]
}

export type Finish = {
    metadata: Metadata,
    type_kinds: u8[],
    flags: u64[],
    keys: u64[],
    writable: u64[],
    needed: bool[]
}

export type Published = Planned

export type Visit = Input.Omit("state")

export type Decisions = Output.Pick("flags", "keys", "writable", "needed")
