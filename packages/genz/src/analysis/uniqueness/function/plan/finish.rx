<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Finish} out={Plan.Published} />

    <Call
        fn="renewal_paths"
        in={$in.pick([
            "metadata",
            "type_kinds",
            "keys",
            "writable"
        ])}
    />

    <Call
        fn="../transfer/build"
        in={$in.pick([
            "metadata",
            "needed"
        ])}
    />

    <Call fn="pack_flags" in={$in.flags} />

    <Call
        fn="publish_slots"
        in={{
            slot_first: $in.metadata.usage.plan.slot_first,
            symbols: $in.metadata.usage.symbols
        }}
    />

    <Return
        value={{
            flags: $ctx.pack_flags,
            renewals: $ctx.renewal_paths,
            transfers: $ctx.build,
            slot_first: $ctx.publish_slots
        }}
    />
</Module>
