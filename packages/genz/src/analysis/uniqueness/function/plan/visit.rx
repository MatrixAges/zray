<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Generation} out={Plan.Published} />

    <Call
        module="../levels/close"
        in={$in.pick([
            "context",
            "repeated"
        ])}
    />

    <Call
        module="plan"
        in={{
            ...$in.omit(["arenas"]),
            state: $ctx.close.pick([
                "known",
                "carried"
            ])
        }}
    />

    <Call
        fn="publish"
        in={{
            ...$ctx.plan.pick([
                "flags",
                "keys",
                "writable",
                "needed"
            ]),
            metadata: $in.context.metadata,
            type_kinds: $in.types.kinds,
            arenas: $in.arenas
        }}
    />

    <Return value={$ctx.publish} />
</Module>
