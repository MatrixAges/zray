<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Generation} out={Plan.Published} />

    <Call
        module="state"
        in={$in.omit(["time"])}
    />

    <Call
        module="plan"
        in={{
            ...$in.pick([
                "types",
                "time",
                "operations",
                "repeated",
                "results"
            ]),
            ...$ctx.state
        }}
    />

    <Call
        module="finish"
        in={{
            ...$ctx.plan.pick([
                "flags",
                "keys",
                "writable",
                "needed"
            ]),
            metadata: $in.context.metadata,
            type_kinds: $in.types.kinds
        }}
    />

    <Return value={$ctx.finish} />
</Module>
