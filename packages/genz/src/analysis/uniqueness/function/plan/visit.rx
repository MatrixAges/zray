<Module>
    <Type from="model" as="Plan" />

    <Args in={Plan.Generation} out={Plan.Published} />

    <Call
        module="state"
        in={$in.omit([
            "arenas",
            "time"
        ])}
    />

    <Call
        module="plan"
        in={{
            ...$in.pick([
                "types",
                "time",
                "operations",
                "repeated",
                "results"
            ]),
            ...$ctx.state
        }}
    />

    <Call
        module="publish"
        in={{
            ...$ctx.plan.pick([
                "flags",
                "keys",
                "writable",
                "needed"
            ]),
            metadata: $in.context.metadata,
            type_kinds: $in.types.kinds,
            arenas: $in.arenas
        }}
    />

    <Return value={$ctx.publish} />
</Module>
