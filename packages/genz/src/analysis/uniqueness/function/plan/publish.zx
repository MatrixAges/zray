import memory from "memory"

import finish from "./finish.rx"

import type { Publication as Input, Published as Output } from "./model"

export default function (in: Input): Output {
    const { scope, scratch, owner } = in.arenas

    memory.selectAllocator(scope, owner)

    const published = finish(in.omit(["arenas"]))

    memory.selectAllocator(scope, scratch)

    return published
}
