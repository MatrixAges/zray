import integers from "std:integer"

import { slot_stride, sort_owner_stride } from "../../renewals/const"
import path from "../../slots/path"

import type { Finish } from "./model"

export type Input = Finish.Pick("metadata", "type_kinds", "keys")

export type Output = u32[][]

export default function (in: Input): Output {
    const paths: Output = []

    return loop({
        index: 0,
        paths
    }, {
        while: state => state.index < in.keys.length,
        next: state => {
            const key = in.keys[state.index]
            const owner = key / sort_owner_stride
            const metadata = in.metadata

            state.paths = state.paths.push(path({
                layout: metadata.layout,
                kinds: in.type_kinds,
                type_id: metadata.expressions.types[owner],
                slot: integers.narrow(key % slot_stride)
            }))[0]
            state.index += 1
        },
        return: state => state.paths
    })
}
