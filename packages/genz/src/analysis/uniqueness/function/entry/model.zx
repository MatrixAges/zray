import type { Source } from "../demand/model"
import type { Context } from "../levels/model"
import type { Generation, Published, Snapshot } from "../plan/model"

export type Input = Generation

export type Solve = {
    context: Context,
    repeated: u32[],
    source: Source.Pick("kinds", "operations", "results")
}

export type Solved = {
    context: Context,
    state: Snapshot
}

export type Output = Published
