import type { Source } from "../demand/model"
import type { Context, State } from "../levels/model"
import type { Snapshot } from "../plan/model"

export type Solve = {
    context: Context,
    repeated: u32[],
    source: Source.Pick("kinds", "operations", "results")
}

export type Solved = {
    context: Context,
    state: Snapshot
}

export type Convergence = Solve & {
    closure: State,
    running: bool
}
