import type { AtomicRows } from "std:bytes"
import type { EntryReset } from "../../summaries/model"
import type { Source } from "../demand/model"
import type { Context } from "../levels/model"
import type { Input as Plan, Output as Facts, Snapshot } from "../plan/model"

export type Input = Plan.Omit("state") & {
    inputs: AtomicRows,
    outputs: AtomicRows,
    native_modules: u32?[],
    clear_demands: EntryReset
}

export type Demand =
    Source.Omit("carried", "function_index", "deferred", "record_marks")

export type Solve = {
    context: Context,
    repeated: u32[],
    source: Demand
}

export type Solved = {
    context: Context,
    state: Snapshot
}

export type Output = Facts.Pick("flags", "keys", "writable", "needed")
