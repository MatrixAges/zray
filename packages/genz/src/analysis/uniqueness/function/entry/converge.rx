<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Solve} out={Entry.Solved} />

    <Call
        module="../levels/close"
        in={$in.pick([
            "context",
            "repeated"
        ])}
    />

    <Loop on={$in.running}>
        <Call
            module="advance"
            in={{
                ...$in,
                closure: $ctx.close,
                running: true
            }}
        />
    </Loop>

    <Return
        value={{
            context: $ctx.advance.context,
            state: $ctx.advance.closure.pick([
                "known",
                "carried"
            ])
        }}
    />
</Module>
