<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Output} />

    <Call
        fn="converge"
        in={{
            context: $in.context,
            repeated: $in.repeated,
            source: {
                kinds: $in.types.kinds,
                operations: $in.operations,
                results: $in.results
            }
        }}
    />

    <Call
        module="../plan/plan"
        in={{
            ...$in.pick([
                "types",
                "time",
                "operations",
                "repeated",
                "results"
            ]),
            ...$ctx.converge
        }}
    />

    <Return
        value={$ctx.plan.pick([
            "flags",
            "keys",
            "writable",
            "needed"
        ])}
    />
</Module>
