<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={Entry.Output} />

    <Call
        fn="converge"
        in={{
            context: $in.context,
            repeated: $in.repeated,
            source: {
                kinds: $in.types.kinds,
                operations: $in.operations,
                results: $in.results
            }
        }}
    />

    <Call
        module="../plan/plan"
        in={{
            ...$in.pick([
                "types",
                "time",
                "operations",
                "repeated",
                "results"
            ]),
            ...$ctx.converge
        }}
    />

    <Call
        fn="../plan/publish"
        in={{
            ...$ctx.plan.pick([
                "flags",
                "keys",
                "writable",
                "needed"
            ]),
            metadata: $in.context.metadata,
            type_kinds: $in.types.kinds,
            arenas: $in.arenas
        }}
    />

    <Return value={$ctx.publish} />
</Module>
