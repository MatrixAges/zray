import initialize from "../demand/initialize"
import operations from "../demand/operations"
import close from "../levels/close.rx"

import type { Source } from "../demand/model"
import type { Solve as Input, Solved as Output } from "./model"

export default function (in: Input): Output {
    const { context, repeated } = in

    const closure = close({
        context,
        repeated
    })

    return loop({
        context,
        closure,
        grew: true
    }, {
        while: current => current.grew,
        next: current => {
            const source: Source = {
                ...in.source,
                carried: current.closure.carried,
                function_index: null,
                deferred: false,
                record_marks: false,
                return_allocations: []
            }

            const working = initialize({
                context: current.context,
                known: current.closure.known,
                source
            })

            const result = operations({
                source,
                working
            })

            current.grew = result.grew

            if (current.grew) {
                current.context = result.context
                current.closure = close({
                    context: current.context,
                    repeated
                })
            }
        },
        return: current => ({
            context: current.context,
            state: current.closure.pick([
                "known",
                "carried"
            ])
        })
    })
}
