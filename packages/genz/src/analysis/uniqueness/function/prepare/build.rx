<Module>
    <Type from="model" as="Function" />

    <Args in={Function.Input} out={Function.Output} />

    <Call
        fn="allocate_nodes"
        in={{
            ...$in.pick([
                "nodes",
                "owner"
            ]),
            count: $in.source.expressions.kinds.length
        }}
    />

    <Task name="order" out={$ctx.build}>
        <Call
            module="../../order/build"
            in={$in.pick([
                "source",
                "nodes"
            ])}
        />
    </Task>

    <Call
        module="../../sites/build"
        in={{
            ...$in.pick([
                "symbols",
                "counts",
                "layout",
                "held",
                "written",
                "effects"
            ]),
            expressions: $in.source.expressions,
            nodes: $ctx.task.order.nodes,
            regions: $ctx.task.order.graph.regions,
            edges: $ctx.task.order.graph.edges,
            def_loop: $ctx.task.order.graph.definitions.repeated
        }}
    />

    <Call
        fn="operations"
        in={{
            expressions: $in.source.expressions,
            time: $ctx.task.order.nodes.time
        }}
    />

    <Return
        value={{
            ...$ctx.task.order.graph.omit(["edges"]),
            nodes: $ctx.task.order.nodes,
            usage: $ctx.build,
            operations: $ctx.operations
        }}
    />
</Module>
