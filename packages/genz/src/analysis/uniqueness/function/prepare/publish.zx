import type { Definition, Role } from "../../order/model"
import type { Usage } from "../../sites/model"
import type { Output as Facts } from "./model"

export type Input = Facts

export type Output = Facts

export default function (in: Input): Output {
    const { regions, definitions, repeated, nodes, usage } = in
    const { plan } = usage
    const { sites } = plan

    const words: u32[] = []
    const flags: bool[] = []
    const kinds: Definition[] = []
    const deltas: i64[] = []
    const roles: Role[] = []
    const states: Usage[] = []

    return {
        regions: {
            parent: words.concat(regions.parent)[0],
            fork: words.concat(regions.fork)[0],
            arm: words.concat(regions.arm)[0],
            depth: words.concat(regions.depth)[0],
            returns: flags.concat(regions.returns)[0]
        },
        definitions: {
            kind: kinds.concat(definitions.kind)[0],
            value: words.concat(definitions.value)[0],
            index: words.concat(definitions.index)[0],
            repeated: words.concat(definitions.repeated)[0]
        },
        results: words.concat(in.results)[0],
        repeated: {
            owner: words.concat(repeated.owner)[0],
            parent: words.concat(repeated.parent)[0],
            concurrent: flags.concat(repeated.concurrent)[0]
        },
        nodes: {
            time: words.concat(nodes.time)[0],
            finish: words.concat(nodes.finish)[0],
            region: words.concat(nodes.region)[0],
            repeated: words.concat(nodes.repeated)[0]
        },
        usage: {
            plan: {
                edge_count: plan.edge_count,
                first: words.concat(plan.first)[0],
                slot_first: words.concat(plan.slot_first)[0],
                sites: {
                    lo: words.concat(sites.lo)[0],
                    hi: words.concat(sites.hi)[0],
                    delta: deltas.concat(sites.delta)[0],
                    top: words.concat(sites.top)[0],
                    region: words.concat(sites.region)[0],
                    a: words.concat(sites.a)[0],
                    b: words.concat(sites.b)[0],
                    c: words.concat(sites.c)[0],
                    d: words.concat(sites.d)[0],
                    arms: words.concat(sites.arms)[0],
                    edge: words.concat(sites.edge)[0],
                    parent: words.concat(sites.parent)[0],
                    role: roles.concat(sites.role)[0]
                }
            },
            states: states.concat(usage.states)[0]
        },
        operations: words.concat(in.operations)[0]
    }
}
