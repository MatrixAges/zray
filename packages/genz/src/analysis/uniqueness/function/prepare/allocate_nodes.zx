import { max_u32 } from "core/const"
import memory from "memory"

import type { Allocator } from "memory"
import type { NodeBuffers } from "../../order/model"

export type Input = {
    nodes: NodeBuffers,
    owner: Allocator,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { nodes, owner, count } = in

    memory.allocateFilledU32Buffer(owner, nodes.time, count, max_u32)
    memory.allocateFilledU32Buffer(owner, nodes.finish, count, max_u32)
    memory.allocateU32Buffer(owner, nodes.region, count)
    memory.allocateFilledU32Buffer(owner, nodes.repeated, count, max_u32)
}
