<Module>
    <Type from="model" as="Result" />

    <Args in={Result.SettleVisit} out={Result.PublishedSettlement} />

    <Call module="../summary/settle" in={$in.analysis} />

    <Call
        module="publish_settlement"
        in={{
            ...$in.omit(["analysis"]),
            result: $ctx.settle
        }}
    />

    <Return value={$ctx.publish_settlement} />
</Module>
