<Module>
    <Type from="model" as="Result" />

    <Args in={Result.PublishSettlement} out={Result.PublishedSettlement} />

    <Call
        module="settlement"
        in={{
            ...$in.result.pick([
                "passed",
                "levels",
                "reads"
            ]),
            ...$in.targets,
            owner: $in.owner
        }}
    />

    <Return
        value={{
            levels: $ctx.settlement,
            changed: $in.result.changed
        }}
    />
</Module>
