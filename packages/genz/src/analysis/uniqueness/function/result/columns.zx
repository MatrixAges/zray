import type { ListColumn, ReadColumn } from "memory"

export type ContributionRows = {
    callees: ReadColumn,
    levels: ListColumn,
    count: u64
}

export type EncodedMark = {
    output: bool,
    function_index: u32,
    slot: u32,
    want: u8
}

export type EncodedRead = {
    table: u8,
    function_index: u32,
    slot: u32,
    value: u8
}
