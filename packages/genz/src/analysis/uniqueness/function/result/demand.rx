<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Demand} out={void} />

    <Call
        fn="marks"
        in={{
            marks: $in.marks,
            target: $in.mark_target,
            owner: $in.owner
        }}
    />

    <If on={$in.read_target != null}>
        <Call
            fn="reads"
            in={{
                before: $in.before,
                after: $in.after,
                target: $in.read_target,
                owner: $in.owner
            }}
        />
    </If>

    <If on={$in.growth != null}>
        <Call
            module="../demand/snapshot/publish"
            in={{
                normalized: $in.normalized,
                renewed: $in.renewed,
                targets: $in.growth,
                owner: $in.owner
            }}
        />
    </If>
</Module>
