<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Demand} out={Result.DemandResult} />

    <Call fn="marks" in={$in.marks} />

    <Call
        fn="reads"
        in={{
            before: $in.before,
            after: $in.after,
            enabled: $in.deferred
        }}
    />

    <If on={$in.save_growth}>
        <Call
            module="../demand/snapshot/publish"
            in={$in.pick([
                "normalized",
                "renewed"
            ])}
        />

        <Return
            value={{
                marks: $ctx.marks,
                reads: $ctx.reads,
                growth: $ctx.publish
            }}
        />
    </If>

    <Return
        value={{
            marks: $ctx.marks,
            reads: $ctx.reads,
            growth: null
        }}
    />
</Module>
