import memory from "memory"
import columns from "memory/columns"

import publish from "./demand.rx"

import type { PublishedDemand as Output, PublishDemand as Input } from "./model"

export default function (in: Input): Output {
    const { scope, scratch, owner } = in.arenas
    const { result, targets } = in

    const retained_growth = result.grew || in.restored_growth

    memory.selectAllocator(scope, owner)

    publish({
        ...result.omit([
            "grew",
            "changed"
        ]),
        ...targets.omit([
            "growth",
            "install"
        ]),
        growth: retained_growth ? targets.growth : null
    })

    if (retained_growth) {
        columns.writeRowList(
            targets.install.normalized,
            0,
            targets.growth.normalized.storage
        )

        columns.writeRowList(
            targets.install.renewed,
            0,
            targets.growth.renewed.storage
        )
    }

    memory.selectAllocator(scope, scratch)

    return {
        grew: result.grew,
        changed: result.changed
    }
}
