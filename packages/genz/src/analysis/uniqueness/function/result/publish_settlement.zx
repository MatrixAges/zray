import memory from "memory"

import publish from "./settlement.rx"

import type { PublishedSettlement as Output, PublishSettlement as Input } from "./model"

export default function (in: Input): Output {
    const { scope, scratch, owner } = in.arenas
    const { result, targets } = in

    memory.selectAllocator(scope, owner)

    const levels = publish({
        ...result.pick([
            "passed",
            "levels",
            "reads"
        ]),
        ...targets
    })

    memory.selectAllocator(scope, scratch)

    return {
        levels,
        changed: result.changed
    }
}
