import columns from "memory/columns"

import encode from "../levels/encode"

import type { ColumnAllocator } from "memory/columns"
import type { Knowledge } from "../levels/model"

export type Input = {
    levels: Knowledge[],
    owner?: ColumnAllocator
}

export type Output = u8[]

export default function (in: Input): Output {
    const encoded = in.levels.map(value => encode(value))[0]

    return match {
        in.owner != null => columns.copyColumnBytes(in.owner, encoded),
        _ => encoded
    }
}
