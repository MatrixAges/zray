import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import type { ColumnAllocator } from "memory/columns"
import type { ContributionColumns } from "./columns"

export type Input = {
    target: ContributionColumns,
    index: u64,
    callee: u32,
    levels: u8[],
    owner?: ColumnAllocator
}

export type Output = void

export default function (in: Input): Output {
    const { target, index, callee, levels } = in

    const owned = match {
        in.owner != null => columns.copyColumnBytes(in.owner, levels),
        _ => bytes.readU8s(levels, 0, levels.length)
    }

    memory.writeColumnU32(target.callees, index, callee)
    memory.writeColumnBytes(target.levels, index, owned)
}
