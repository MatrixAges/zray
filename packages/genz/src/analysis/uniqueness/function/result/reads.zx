import encode from "../levels/encode"
import { Table } from "../levels/model"
import {
    input_guarantee_table,
    output_guarantee_table,
    input_demand_table,
    output_demand_table
} from "./const"

import type { EncodedRead } from "./columns"
import type { Reads as Input } from "./model"

export type Output = EncodedRead[]

export default function (in: Input): Output {
    if (!in.enabled) {
        return []
    }

    const rows = in.before.concat(in.after)[0]

    return rows.map(row => {
        const table = match row.table {
            Table.Input => input_guarantee_table,
            Table.Output => output_guarantee_table,
            Table.Inputs => input_demand_table,
            _ => output_demand_table
        }

        return {
            table,
            function_index: row.function_index,
            slot: row.slot,
            value: encode(row.value)
        }
    })[0]
}
