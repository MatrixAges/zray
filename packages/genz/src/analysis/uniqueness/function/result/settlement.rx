<Module>
    <Type from="model" as="Result" />

    <Args in={Result.PublishSettlement} out={Result.SettlementResult} />

    <Call fn="levels" in={$in.result.levels} />

    <If on={$in.deferred}>
        <Call
            fn="reads"
            in={{
                enabled: true,
                before: [],
                after: $in.result.reads
            }}
        />

        <Return
            value={{
                passed: $in.result.passed,
                levels: $ctx.levels,
                reads: $ctx.reads
            }}
        />
    </If>

    <Return
        value={{
            passed: $in.result.passed,
            levels: $ctx.levels,
            reads: []
        }}
    />
</Module>
