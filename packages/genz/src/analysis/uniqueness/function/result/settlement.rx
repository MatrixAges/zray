<Module>
    <Type from="model" as="Result" />

    <Args in={Result.Settlement} out={u8[]} />

    <Call
        fn="contributions"
        in={{
            passed: $in.passed,
            target: $in.contributions,
            owner: $in.owner
        }}
    />

    <If on={$in.read_target != null}>
        <Call
            fn="reads"
            in={{
                before: [],
                after: $in.reads,
                target: $in.read_target,
                owner: $in.owner
            }}
        />
    </If>

    <Call
        fn="levels"
        in={{
            levels: $in.levels,
            owner: $in.owner
        }}
    />

    <Return value={$ctx.levels} />
</Module>
