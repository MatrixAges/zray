import memory from "memory"
import columns from "memory/columns"

import { false_byte, true_byte } from "../../memo/disk/const"
import encode from "../levels/encode"

import type { Marks as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { marks, target } = in
    const { output, functions, slots, wants } = target.columns

    columns.allocateRows(target.storage, marks.length)

    const first: u64 = 0

    const written = loop(first, {
        while: index => index < marks.length,
        next: index => {
            const mark = marks[index]

            memory.writeColumnU8(
                output,
                index,
                mark.output ? true_byte : false_byte
            )
            memory.writeColumnU32(functions, index, mark.function_index)
            memory.writeColumnU32(slots, index, mark.slot)
            memory.writeColumnU8(wants, index, encode(mark.want))
            index += 1
        }
    })
}
