import encode from "../levels/encode"

import type { Mark } from "../demand/model"
import type { EncodedMark } from "./columns"

export type Input = Mark[]

export type Output = EncodedMark[]

export default function (in: Input): Output {
    return in.map(mark => ({
        ...mark.omit(["want"]),
        want: encode(mark.want)
    }))[0]
}
