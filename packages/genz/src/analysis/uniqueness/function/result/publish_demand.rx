<Module>
    <Type from="model" as="Result" />

    <Args in={Result.PublishDemand} out={Result.PublishedDemand} />

    <Call
        module="demand"
        in={{
            ...$in.result.omit([
                "grew",
                "changed",
                "updates"
            ]),
            deferred: $in.deferred,
            save_growth: $in.result.grew || $in.restored_growth
        }}
    />

    <Return
        value={{
            ...$ctx.demand,
            ...$in.result.pick([
                "grew",
                "changed",
                "updates"
            ])
        }}
    />
</Module>
