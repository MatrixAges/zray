import bytes from "std:bytes"
import memory from "memory"

import type { Contribution } from "../summary/model"
import type { ContributionRows } from "./columns"
import type { SettlementRecord as Output } from "./model"

export type Input = {
    source: ContributionRows,
    output: u8[]
}

export default function (in: Input): Output {
    const { source } = in

    const blank: Contribution = {
        callee: 0,
        guarantees: []
    }

    const rows = bytes.repeat(source.count, 0).map(byte => blank)[0]

    const passed = loop({
        index: 0,
        rows
    }, {
        while: state => state.index < source.count,
        next: state => {
            state.rows[state.index] = {
                callee: memory.readColumnU32(source.callees, state.index),
                guarantees: memory.borrowListBytes(source.levels, state.index)
            }

            state.index += 1
        },
        return: state => state.rows
    })

    return {
        passed,
        levels: in.output
    }
}
