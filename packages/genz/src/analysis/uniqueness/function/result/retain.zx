import memory from "memory"
import columns from "memory/columns"

import record from "./contribution"

import type { ContributionRows, ContributionTarget } from "./columns"

export type Input = {
    source: ContributionRows,
    target: ContributionTarget,
    output: u8[]
}

export type Output = u8[]

export default function (in: Input): Output {
    const { source, target } = in

    columns.allocateRows(target.storage, source.count)

    const first: u64 = 0

    const retained = loop(first, {
        while: index => index < source.count,
        next: index => {
            record({
                target: target.columns,
                index,
                callee: memory.readColumnU32(source.callees, index),
                levels: memory.borrowListBytes(source.levels, index)
            })
            index += 1
        }
    })

    const output: u8[] = []

    return output.concat(in.output)[0]
}
