import { allocateRows } from "core/row_buffer"

import record from "./contribution"

import type { Contributions as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { passed, target } = in

    allocateRows({
        target: target.storage,
        count: passed.length,
        owner: in.owner
    })

    const first: u64 = 0

    const written = loop(first, {
        while: index => index < passed.length,
        next: index => {
            const row = passed[index]

            record({
                target: target.columns,
                index,
                callee: row.callee,
                levels: row.guarantees,
                owner: in.owner
            })
            index += 1
        }
    })
}
