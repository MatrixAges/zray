import type { Demanded, Visit as DemandInput } from "../demand/model"
import type { Snapshot } from "../demand/snapshot/model"
import type { Read } from "../levels/model"
import type {
    Contribution,
    Settled,
    Settlement as SettlementInput
} from "../summary/model"
import type { Batch } from "../updates/model"
import type { EncodedMark, EncodedRead } from "./columns"

export type Reads = {
    enabled: bool,
    before: Read[],
    after: Read[]
}

export type Demand = Demanded.Omit("grew", "changed", "updates") & {
    deferred: bool,
    save_growth: bool
}

export type SettleVisit = {
    analysis: SettlementInput
}

export type DemandVisit = {
    analysis: DemandInput,
    restored_growth: bool
}

export type PublishSettlement = {
    result: Settled,
    deferred: bool
}

export type PublishDemand = DemandVisit.Omit("analysis") & {
    result: Demanded,
    deferred: bool
}

export type SettlementRecord = {
    passed: Contribution[],
    levels: u8[]
}

export type SettlementResult = SettlementRecord & {
    reads: EncodedRead[]
}

export type DemandResult = {
    marks: EncodedMark[],
    reads: EncodedRead[],
    growth?: Snapshot
}

export type PublishedSettlement = SettlementResult & Batch

export type PublishedDemand = DemandResult & Demanded.Pick("grew", "changed", "updates")
