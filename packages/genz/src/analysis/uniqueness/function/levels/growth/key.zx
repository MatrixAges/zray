import storedKey from "./stored_key"

import type { GrowthRows } from "../model"

export type Input = {
    rows: GrowthRows,
    index: u64
}

export type Output = u64

export default function (in: Input): Output {
    const { rows, index } = in

    if (rows.stored == null) {
        return rows.items[index].key
    }

    return storedKey({
        keys: rows.stored.keys,
        wide: rows.stored.wide,
        index
    })
}
