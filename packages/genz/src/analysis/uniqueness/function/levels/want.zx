import integers from "std:integer"

import { slot_stride } from "../../renewals/const"
import { value_renewal } from "./const"
import find from "./growth/find"
import { GrowthKind } from "./model"

import type { GrowthRows, Knowledge } from "./model"

export type Input = {
    values: GrowthRows,
    kind: GrowthKind,
    owner: u32,
    slot: u32
}

export type Output = Knowledge?

export default function (in: Input): Output {
    if (in.values.count == 0) {
        return null
    }

    const packed =
        integers.widen(in.owner) * slot_stride + integers.widen(in.slot)

    const key = match in.kind {
        GrowthKind.Normalized => integers.widen(in.owner),
        GrowthKind.Value => integers.orBits(packed, value_renewal),
        _ => packed
    }

    return find({
        rows: in.values,
        key
    }).value
}
