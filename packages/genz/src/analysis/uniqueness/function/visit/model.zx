import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { AtomicRows } from "memory"
import type { Store as MemoTarget } from "../../memo/table/model"
import type { Layout } from "../../slots/model"
import type { Exchange } from "../demand/model"
import type { Snapshot } from "../demand/snapshot/model"
import type { Context as FactsContext } from "../levels/model"
import type { Published } from "../plan/model"
import type { Output as Facts } from "../prepare/model"
import type { EncodedMark, EncodedRead } from "../result/columns"
import type { Contribution } from "../summary/model"
import type { Batch } from "../updates/model"

export type Body = FactsContext.Pick("normalized", "renewed") & {
    facts: Facts,
    expressions: Expressions,
    layout: Layout,
    counts: u32[],
    symbols: u64,
    index?: u32,
    input: AtomicRows,
    output: AtomicRows,
    held: bool[][],
    written: bool[][],
    record: bool
}

export type Settlement = {
    input: AtomicRows
}

export type Demand = {
    exchange: Exchange,
    restored_growth: bool
}

export type View = {
    context: FactsContext,
    count: u64
}

export type Input = {
    view: View,
    facts: Facts,
    index?: u32,
    types: Table,
    deferred: bool,
    settlement?: Settlement,
    demand?: Demand,
    independent: bool
}

export type Output = Batch & {
    levels: u8[],
    passed: Contribution[],
    marks: EncodedMark[],
    reads: EncodedRead[],
    growth?: Snapshot,
    grew: bool,
    plan?: Published
}

export type Execution = Input & {
    memo?: MemoTarget
}

export type Executed = Output & {
    row?: u64
}
