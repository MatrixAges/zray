<Module>
    <Type from="model" as="Visit" />

    <Args in={Visit.Execution} out={Visit.Executed} />

    <Call module="run" in={$in.omit(["memo"])} />

    <If on={$in.memo != null}>
        <Call module="../../memo/table/store" in={$in.memo} />

        <Return
            value={{
                ...$ctx.run,
                row: $ctx.store
            }}
        />
    </If>

    <Return
        value={{
            ...$ctx.run,
            row: null
        }}
    />
</Module>
