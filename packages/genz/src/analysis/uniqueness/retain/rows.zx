import columns from "memory/columns"

import type { RowBuffer } from "memory/columns"

export type Input = {
    source: u8[],
    target: RowBuffer,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    columns.allocateRows(in.target, in.count)
    columns.copyRowPrefix(in.target, in.source, in.count)
}
