import { allocateRows } from "core/row_buffer"
import columns from "memory/columns"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Input = {
    source: u8[],
    target: RowBuffer,
    count: u64,
    owner: ColumnAllocator
}

export type Output = void

export default function (in: Input): Output {
    allocateRows({
        target: in.target,
        count: in.count,
        owner: in.owner
    })

    columns.copyRowPrefix(in.target, in.source, in.count)
}
