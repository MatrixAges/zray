import columns from "memory/columns"

import type { ColumnAllocator, RowBuffer } from "memory/columns"

export type Input = {
    source: u8[],
    target: RowBuffer,
    count: u64,
    owner: ColumnAllocator
}

export type Output = void

export default function (in: Input): Output {
    columns.allocateRowsWithAllocator(in.owner, in.target, in.count)
    columns.copyRowPrefix(in.target, in.source, in.count)
}
