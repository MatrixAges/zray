import callees from "./callees"

import type { Bodies } from "./model"

export type Input = Bodies.Pick("expressions", "entry") & {
    active: bool[]
}

export type Output = u32[][]

export default function (in: Input): Output {
    const empty: u32[] = []
    const rows: u32[][] = []

    const functions_initial = {
        rows,
        index: 0
    }

    const functions_scope = {
        input: in,
        empty
    }

    const functions = loop(functions_initial, {
        while: state => state.index < functions_scope.input.expressions.length,
        next: state => {
            const row = match {
                functions_scope.input.active[state.index] =>
                    callees(functions_scope.input.expressions[state.index]),
                _ => functions_scope.empty
            }

            state.rows = state.rows.push(row)[0]
            state.index += 1
        },
        return: state => state.rows
    })

    const entry = match {
        in.active[in.expressions.length] => callees(in.entry),
        _ => empty
    }

    return functions.push(entry)[0]
}
