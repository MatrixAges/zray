<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Bodies} out={Graph.Calls} />

    <Call
        fn="active"
        in={$in.pick([
            "native_modules",
            "type_only"
        ])}
    />

    <Call
        fn="collect"
        in={{
            ...$in.pick([
                "expressions",
                "entry"
            ]),
            active: $ctx.active
        }}
    />

    <Call fn="recursive" />

    <Return
        value={{
            active: $ctx.active,
            callees: $ctx.collect,
            recursive: $ctx.recursive
        }}
    />
</Module>
