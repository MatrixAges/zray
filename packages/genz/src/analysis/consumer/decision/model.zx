import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { LoopConsumerFacts } from "lowering_host"

export enum Gate {
    None,
    Simd,
    Policy
}

export enum Branch {
    None,
    Scalar,
    Eligible
}

export type Source = {
    types: Table,
    table: Expressions,
    symbol: u64,
    value: u32,
    result: u64
}

export type Input = Source & LoopConsumerFacts
