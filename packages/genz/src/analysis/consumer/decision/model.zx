import type { Expressions } from "core/expression_table/model"
import type { State as Cache } from "core/integer/map/model"
import type { Table } from "core/type_table/model"

export enum Gate {
    None,
    Simd,
    Policy
}

export enum Branch {
    None,
    Scalar,
    Eligible
}

export type Source = {
    types: Table,
    table: Expressions,
    symbol: u64,
    value: u32,
    result: u64
}

export type LoopConsumerFacts = {
    cache: Cache,
    transaction: bool,
    capture: bool
}

export type Input = Source & LoopConsumerFacts
