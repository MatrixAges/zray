import integers from "std:integer"
import lookup from "core/integer/map/lookup"

import scalar from "../scalar"
import { Branch } from "./model"

import type { Input, Branch as Output } from "./model"

export default function (in: Input): Output {
    if (in.transaction) {
        return Branch.None
    }

    const direct = scalar({
        types: in.types,
        id: in.table.types[in.result]
    })

    if (direct) {
        return Branch.Scalar
    }

    if (in.capture) {
        return Branch.None
    }

    if (lookup({
        ...in.cache.omit(["values"]),
        key: integers.narrow(in.result)
    }) != null) {
        return Branch.None
    }

    return Branch.Eligible
}
