<Module>
    <Type from="model" as="Consumer" />

    <Args in={Consumer.Input} out={Consumer.Output} />

    <Call fn="gate" in={$in} />

    <Switch on={$ctx.gate}>
        <Case value={Consumer.Gate.None}>
            <Return
                value={{
                    action: Consumer.Action.None,
                    next: null
                }}
            />
        </Case>

        <Case value={Consumer.Gate.Simd}>
            <Return
                value={{
                    action: Consumer.Action.Simd,
                    next: Consumer.Phase.AfterSimd
                }}
            />
        </Case>

        <Case value={Consumer.Gate.Policy}>
            <Call module="policy" in={$in} />

            <If on={$ctx.policy == Consumer.Action.Eligible}>
                <Return
                    value={{
                        action: $ctx.policy,
                        next: Consumer.Phase.Fallback
                    }}
                />
            </If>

            <Return
                value={{
                    action: $ctx.policy,
                    next: null
                }}
            />
        </Case>

        <Case value={Consumer.Gate.Fallback}>
            <Call module="fallback" in={$in} />

            <Return
                value={{
                    action: $ctx.fallback,
                    next: null
                }}
            />
        </Case>
    </Switch>
</Module>
