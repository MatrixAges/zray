import host from "lowering_host"
import { ConsumerAction, ConsumerPhase } from "lowering_host"

import type { LoopConsumer } from "lowering_host"

export type Input = LoopConsumer

export type Output = u32?

export default function (in: Input): Output {
    const unset: u32? = null
    const first: ConsumerPhase? = ConsumerPhase.Initial

    return loop({
        result: unset,
        phase: first
    }, {
        while: state => state.phase != null,
        next: state => {
            const phase = state.phase ?? ConsumerPhase.Initial
            const action = host.decideLoopConsumer(in, phase)
            const result: u32? = match action {
                ConsumerAction.None => null,
                ConsumerAction.Simd => host.consumeVectorLoop(in),
                ConsumerAction.Scalar => host.consumeLoop(in, true),
                _ => host.consumeLoop(in, false)
            }

            state.result = result
            state.phase = match {
                action == ConsumerAction.None => null,
                result != null => null,
                _ => host.nextLoopConsumer(in)
            }
        },
        return: state => state.result
    })
}
