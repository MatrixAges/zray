<Module>
    <Type from="model" as="Execution" />
    <Type from="../decision/model" as="Consumer" />

    <Args in={Execution.Input} out={Execution.Output} />

    <If on={$in.phase == Execution.Phase.Initial}>
        <Call
            fn="../decision/gate"
            in={{
                ...$in.source,
                ...$in.facts
            }}
        />

        <If on={$ctx.gate == Consumer.Gate.None}>
            <Return
                value={{
                    decision: Execution.Decision.None,
                    retry: false
                }}
            />
        </If>

        <If on={$ctx.gate == Consumer.Gate.Simd}>
            <Return
                value={{
                    decision: Execution.Decision.Simd,
                    retry: false
                }}
            />
        </If>
    </If>

    <Call
        module="apply"
        in={{
            ...$in.source,
            ...$in.facts,
            fallback_only: $in.phase == Execution.Phase.AfterLayout
        }}
    />

    <Return value={$ctx.apply} />
</Module>
