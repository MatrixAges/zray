import type { Input as Facts, LoopConsumerFacts, Source } from "../decision/model"

export enum Phase {
    Initial,
    AfterSimd,
    AfterLayout
}

export enum Decision {
    None,
    Simd,
    Scalar,
    Layout
}

export type Input = {
    source: Source,
    facts: LoopConsumerFacts,
    phase: Phase
}

export type Apply = Facts & {
    fallback_only: bool
}

export type Output = {
    decision: Decision,
    retry: bool
}
