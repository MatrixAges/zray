<Module>
    <Type from="model" as="Execution" />
    <Type from="../decision/model" as="Consumer" />
    <Type from="../../iteration/result/model" as="Result" />

    <Args in={Execution.Apply} out={Execution.Output} />

    <If on={!$in.fallback_only}>
        <Call fn="../decision/branch" in={$in.omit(["fallback_only"])} />

        <If on={$ctx.branch == Consumer.Branch.None}>
            <Return
                value={{
                    decision: Execution.Decision.None,
                    retry: false
                }}
            />
        </If>

        <If on={$ctx.branch == Consumer.Branch.Scalar}>
            <Call
                fn="../projection"
                in={$in.pick([
                    "table",
                    "symbol",
                    "result"
                ])}
            />

            <If on={$ctx.projection}>
                <Return
                    value={{
                        decision: Execution.Decision.Scalar,
                        retry: false
                    }}
                />
            </If>

            <Return
                value={{
                    decision: Execution.Decision.None,
                    retry: false
                }}
            />
        </If>

        <Call
            module="../../iteration/result/analyze"
            in={{
                ...$in.pick([
                    "types",
                    "table",
                    "symbol",
                    "result",
                    "capture"
                ]),
                cached: $in.cache,
                mode: Result.Mode.Eligible
            }}
        />

        <If on={$ctx.analyze.valid}>
            <Return
                value={{
                    decision: Execution.Decision.Layout,
                    retry: true
                }}
            />
        </If>
    </If>

    <Call
        fn="../decision/fallback"
        in={$in.pick([
            "types",
            "table",
            "result"
        ])}
    />

    <If on={$ctx.fallback}>
        <Call
            fn="../projection"
            in={$in.pick([
                "table",
                "symbol",
                "result"
            ])}
        />

        <If on={$ctx.projection}>
            <Return
                value={{
                    decision: Execution.Decision.Layout,
                    retry: false
                }}
            />
        </If>
    </If>

    <Return
        value={{
            decision: Execution.Decision.None,
            retry: false
        }}
    />
</Module>
