import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { Query } from "../../state/queries/model"

export enum Representation {
    Plain,
    BorrowList,
    Convert,
    ReadElement
}

export type Input = {
    table: Expressions,
    types: Table,
    selected: bool[],
    queries: Query[],
    element_storage: bool[],
    active: bool,
    root: u32,
    symbol: u32
}

export type Output = {
    rows: u32[],
    representations: Representation[],
    length_type?: u32,
    valid: bool
}
