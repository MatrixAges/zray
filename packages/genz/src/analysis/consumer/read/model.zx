import type { Expressions } from "core/expression_table/model"
import type { Table } from "core/type_table/model"
import type { Lowering, PathConversion as Representation } from "lowering_host"
import type { Query } from "../../state/queries/model"

export { PathConversion as Representation, requireLoopPath } from "lowering_host"

export type Input = {
    table: Expressions,
    types: Table,
    selected: bool[],
    queries: Query[],
    element_storage: bool[],
    active: bool,
    root: u32,
    symbol: u32
}

export type Output = {
    rows: u32[],
    representations: Representation[],
    length_type?: u32,
    valid: bool
}

export type Request = {
    frame: Lowering,
    source: Input,
    state: u32
}

export type Prepare = Request.Pick("frame", "state") & {
    plan: Output
}
