<Module>
    <Type from="model" as="Read" />

    <Args in={Read.Request} out={u32} />

    <Call fn="walk" in={$in.source} />

    <Call
        fn="prepare"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "origin",
                "state"
            ]),
            table: $in.source.table,
            plan: $ctx.walk
        }}
    />

    <Call fn="execute" />

    <Return value={$ctx.execute} />
</Module>
