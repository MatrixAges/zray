import { lowerType } from "lowering_host"

import type { Input as Output } from "./execute"
import type { Prepare as Input } from "./model"

export default function (in: Input): Output {
    const { frame, plan, state } = in

    const type_id = plan.length_type

    const length_type: u32? = match {
        type_id == null => null,
        _ => lowerType(frame, type_id, false)
    }

    return {
        frame,
        state,
        rows: plan.rows,
        representations: plan.representations,
        length_type
    }
}
