import integers from "std:integer"
import { ExpressionKind } from "core/expression_table/kinds"
import host from "lowering_host"

import emitIndex from "../../expressions/read/emit_index"
import { Representation } from "./model"

import type { AstOriginBuffer, AstWriter } from "ast_rows"
import type { Expressions } from "core/expression_table/model"
import type { Lowering } from "lowering_host"

export type Input = {
    frame: Lowering,
    writer: AstWriter,
    origin: AstOriginBuffer,
    table: Expressions,
    rows: u32[],
    representations: Representation[],
    length_type?: u32,
    state: u32
}

export type Output = u32

export default function (in: Input): Output {
    const { frame, writer, origin, table, rows, representations, length_type } = in

    return loop({
        index: rows.length,
        value: in.state
    }, {
        while: state => state.index != 0,
        next: state => {
            const index = state.index - 1
            const row = rows[index]
            const row_index = integers.widen(row)
            const payload = integers.widen(table.payloads[row_index])
            const projected = host.projectLoopPath(frame, row, state.value, length_type)

            const value = match {
                table.kinds[row_index] == ExpressionKind.Index => emitIndex({
                    frame,
                    writer,
                    origin,
                    values: projected,
                    position: host.lowerExpression(
                        frame,
                        table.index_values[payload],
                        false,
                        null
                    )
                }),
                _ => projected
            }

            const conversion = representations[index]

            state.value = match conversion {
                Representation.Plain => value,
                Representation.BorrowList =>
                    host.readBorrowedList(frame, table.types[row_index], value),
                Representation.ReadElement =>
                    host.readElement(
                        frame,
                        table.types[integers.widen(
                            table.index_targets[payload]
                        )],
                        value
                    ),
                _ =>
                    host.readRepresentedValue(frame, table.types[row_index], value),
            }
            state.index = index
        },
        return: state => state.value
    })
}
