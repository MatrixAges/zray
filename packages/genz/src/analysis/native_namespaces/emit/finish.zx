import bytes from "std:bytes"
import integers from "std:integer"

import constant from "../../../ast/declarations/builder/constant"
import publish from "../../../ast/declarations/builder/publish"

import type { State, Output } from "./model"

export type Input = {
    state: State,
    native_value: u32,
    layouts_value: u32
}

export default function (in: Input): Output {
    const start = in.state.declarations.tags.length

    const natives = constant({
        state: in.state.declarations,
        name: bytes.fromText(in.state.source.plan.native_name),
        type_expr: null,
        value: in.native_value,
        exported: true
    })

    const layouts = constant({
        state: natives,
        name: bytes.fromText(in.state.source.plan.layouts_name),
        type_expr: null,
        value: in.layouts_value,
        exported: true
    })

    return {
        expressions: in.state.expressions,
        declarations: publish(layouts),
        root_start: layouts.base + integers.narrow(start),
        root_count: integers.narrow(layouts.tags.length - start),
        valid: in.state.valid && layouts.valid
    }
}
