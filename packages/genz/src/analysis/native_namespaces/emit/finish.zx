import bytes from "std:bytes"
import integers from "std:integer"

import constants from "../../../ast/declarations/constants"

import type { Constant } from "../../../ast/declarations/model"
import type { State, Output } from "./model"

export type Input = {
    state: State,
    native_value: u32,
    layouts_value: u32
}

export default function (in: Input): Output {
    const declarations = constants({
        values: in.state.declarations,
        base: in.state.source.declaration_base
    })

    const base = integers.widen(in.state.source.declaration_base) +
        in.state.declarations.length

    const values: Constant[] = [
        {
            name: bytes.fromText(in.state.source.plan.native_name),
            type_expr: null,
            value: in.native_value,
            exported: true
        },
        {
            name: bytes.fromText(in.state.source.plan.layouts_name),
            type_expr: null,
            value: in.layouts_value,
            exported: true
        }
    ]

    const roots = constants({
        values,
        base: integers.narrow(base)
    })

    const prefix = integers.widen(in.state.source.prefix_count)
    const first = integers.widen(in.state.source.declaration_base) - prefix
    const count = prefix + roots.table.tags.length
    const indices: u32[] = []

    const selected = loop({
        indices,
        index: 0
    }, {
        while: state => state.index < count,
        next: state => {
            const row = match {
                state.index < prefix => first + state.index,
                _ => base + state.index - prefix
            }

            state.indices = state.indices.push(integers.narrow(row))[0]
            state.index += 1
        },
        return: state => state.indices
    })

    return {
        expressions: in.state.expressions,
        declarations: declarations.table,
        roots: roots.table,
        selected,
        valid: in.state.valid && declarations.valid && roots.valid
    }
}
