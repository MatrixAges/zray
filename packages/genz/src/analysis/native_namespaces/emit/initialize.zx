import declarations from "../../../ast/declarations/builder/initialize"

import type { Planned as Input, State } from "./model"

export type Output = State

export default function (in: Input): Output {
    return {
        source: in,
        expressions: {
            tags: [],
            offsets: [],
            namespace_type_start: [],
            namespace_type_len: []
        },
        declarations: declarations(in.declaration_base),
        signatures: [],
        members: [],
        layouts: [],
        valid: true
    }
}
