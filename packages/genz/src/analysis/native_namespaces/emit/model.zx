import type {
    Columns as Declarations,
    State as DeclarationBuilder
} from "../../../ast/declarations/builder/model"
import type { Columns as Expressions } from "../../../ast/expressions/namespace"
import type { Input as Namespace, Output as Plan } from "../model"

export type Input = Namespace & {
    types: u32[],
    layouts: u32[],
    expression_base: u32,
    declaration_base: u32
}

export type Planned = Input & {
    plan: Plan
}

export type State = {
    source: Planned,
    expressions: Expressions,
    declarations: DeclarationBuilder,
    signatures: u32[][],
    members: u32[],
    layouts: u32[],
    valid: bool
}

export type Output = {
    expressions: Expressions,
    declarations: Declarations,
    root_start: u32,
    root_count: u32,
    valid: bool
}
