<Module>
    <Type from="model" as="Parallel" />
    <Type from="../label" as="Label" />
    <Type from="../../../tasks/rows" as="AST" />

    <Args in={Parallel.Input} out={Parallel.Output} />

    <Call
        module="name"
        in={{
            ...$in.pick([
                "frame",
                "writer",
            ]),
            kind: Label.Kind.Allocator
        }}
    />

    <Call
        fn="branches"
        in={$in.omit([
            "used",
            "names"
        ])}
    />

    <Call fn="../../../tasks/rows.astFieldCount" in={$in.writer} />
    <Call fn="../../../tasks/rows.readAstOrigin" in={$in.writer} />

    <Call
        module="../build"
        in={{
            ...$in.pick([
                "used",
                "names"
            ]),
            shared: $ctx.name,
            records: $ctx.branches,
            bases: {
                ...$ctx.readAstOrigin,
                field_base: $ctx.astFieldCount
            }
        }}
    />

    <Call fn="../../../tasks/rows.requireAllocation" in={$ctx.build.valid} />

    <Call
        fn="../../../tasks/rows.appendExpressionRows"
        in={[
            $in.writer,
            $ctx.build.expressions,
            $ctx.build.forms,
            AST.AstPayloadOwnership.BorrowingText
        ]}
    />

    <Call
        fn="../../../tasks/rows.appendAstFields"
        in={[
            $in.writer,
            $ctx.build.fields
        ]}
    />

    <Call
        fn="index.publishAstStatementBatch"
        in={[
            $in.writer,
            $ctx.build.statements,
            {
                variables: $ctx.build.variables,
                starts: $ctx.build.extra.scope_start,
                counts: $ctx.build.extra.scope_len
            },
            null
        ]}
    />

    <Call
        fn="outer_span"
        in={{
            span: $ctx.publishAstStatementBatch,
            inner: $ctx.build.inner_count
        }}
    />

    <Return value={$ctx.outer_span} />
</Module>
