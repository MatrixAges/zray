<Module>
    <Type from="model" as="Parallel" />
    <Type from="../label" as="Label" />

    <Args in={Parallel.Branch} out={Parallel.Branch} />

    <Call
        fn="../../../tasks/rows.readAstOrigin"
        in={[
            $in.writer,
            $in.origin
        ]}
    />

    <Call
        fn="lead_names"
        in={{
            frame: $in.frame,
            serial: $ctx.readAstOrigin.serial
        }}
    />

    <Call
        fn="index.lowerParallelArgument"
        in={[
            $in.frame,
            $in.expressions[$in.index]
        ]}
    />

    <Call
        fn="index.buildParallelWorker"
        in={[
            $in.frame,
            $in.expressions[$in.index]
        ]}
    />

    <Call
        module="name"
        in={{
            ...$in.pick([
                "frame",
                "writer",
                "origin"
            ]),
            kind: Label.Kind.Thread
        }}
    />

    <Call
        fn="index.storeParallelRecord"
        in={[
            $in.records,
            $in.index,
            $ctx.lowerParallelArgument,
            $ctx.buildParallelWorker,
            $ctx.lead_names.type_name,
            $ctx.lead_names.input_name,
            $ctx.lead_names.worker_name,
            $ctx.name,
            $in.symbols[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
