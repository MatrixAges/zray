import memory from "memory"

import queries from "../state/queries/build"
import layouts from "../types/layout"

import type { Table } from "core/type_table/model"
import type { Output as Queries } from "../state/queries/build"
import type { Output as Layouts } from "../types/layout"
import type { Buffers } from "./allocators"

export type Input = {
    allocators: Buffers,
    types: Table,
    selected: bool[]
}

export type Output = {
    state_queries: Queries,
    layout_types: Layouts
}

export default function (in: Input): Output {
    const { scope, owned, scratch } = in.allocators

    memory.selectAllocator(scope, owned)

    const state_queries = queries({
        types: in.types,
        selected: in.selected
    })

    const layout_types = layouts(in.types)

    memory.selectAllocator(scope, scratch)

    return {
        state_queries,
        layout_types
    }
}
