<Module>
    <Type from="../model" as="Model" />
    <Type from="../types/layout" as="Layout" />
    <Type from="../state/queries/build" as="StateQueries" />
    <Type from="allocators" as="Allocators" />
    <Type from="core/error_effects/functions/model" as="Effects" />

    <Args
        in={{
            allocators: Allocators.Buffers,
            boundaries: Model.Boundaries,
            errors: Effects.Sources,
            program: Model.Program
        }}
        out={{
            errors: string[]?[],
            return_allocations: bool[],
            fresh_outputs: bool[],
            constructed_outputs: bool[],
            grows: bool[],
            identity_free: bool[],
            io: bool[],
            keys: u8[],
            local: bool[],
            layout_types: Layout.Output,
            process: bool[],
            pure: bool[],
            selected: bool[],
            element_storage: bool[],
            borrowed: bool[],
            state_queries: StateQueries.Output,
            tasks: bool[],
            values: bool[]
        }}
    />

    <Call fn="../value/local" in={$in.program} />

    <Call
        module="../state/select"
        in={{
            program: $in.program,
            boundaries: $in.boundaries,
            local: $ctx.local
        }}
    />

    <Call
        fn="owned_types"
        in={{
            allocators: $in.allocators,
            types: $in.program.types,
            selected: $ctx.select.selected
        }}
    />

    <Call
        fn="../value/summary"
        in={{
            program: $in.program,
            queries: $ctx.owned_types.state_queries,
            local: $ctx.local
        }}
    />

    <Call fn="../capability/io" in={$in.program.functions} />
    <Call fn="../capability/process" in={$in.program.functions} />
    <Call fn="../capability/tasks" in={$in.program} />
    <Call fn="../capability/growth/evaluate" in={$in.program.functions} />
    <Call fn="../types/fresh_outputs" in={$in.program} />
    <Call fn="../value/constructed_outputs" in={$in.program.functions} />

    <Call
        fn="../identity/free"
        in={{
            types: $in.program.types,
            functions: $in.program.functions,
            pure: $ctx.summary.pure
        }}
    />

    <Call module="core/error_effects/functions" in={$in.errors} />

    <Call
        fn="function_errors"
        in={{
            source: $ctx.functions,
            allocators: $in.allocators,
            native_modules: $in.program.functions.native_modules
        }}
    />

    <Return
        value={{
            ...$ctx.summary,
            ...$ctx.select,
            ...$ctx.owned_types,
            io: $ctx.io,
            process: $ctx.process,
            tasks: $ctx.tasks,
            grows: $ctx.evaluate,
            fresh_outputs: $ctx.fresh_outputs,
            constructed_outputs: $ctx.constructed_outputs,
            identity_free: $ctx.free,
            ...$ctx.function_errors
        }}
    />
</Module>
