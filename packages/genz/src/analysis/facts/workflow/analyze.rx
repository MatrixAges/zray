<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Analysis} out={Workflow.Step[]} />

    <Call fn="schedule" in={$in} />

    <If on={$ctx.schedule.basis != null}>
        <Return
            value={[
                $ctx.schedule.basis,
                Workflow.Step.CollectFacts,
                Workflow.Step.JoinBasis,
                $ctx.schedule.ownership,
                Workflow.Step.AnalyzeFlags
            ]}
        />
    </If>

    <Return
        value={[
            Workflow.Step.CollectFacts,
            Workflow.Step.JoinBasis,
            $ctx.schedule.ownership,
            Workflow.Step.AnalyzeFlags
        ]}
    />
</Module>
