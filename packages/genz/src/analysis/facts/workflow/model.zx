import type { Table as Functions } from "core/function_table/model"
import type { Effects } from "../../uniqueness/sites/model"
import type { Plan, Types } from "../../uniqueness/slots/model"

export enum Step {
    StartBasis,
    BuildBasis,
    CollectFacts,
    JoinBasis,
    PlanSerial,
    PlanConcurrent,
    AnalyzeFlags,
    PlanEntry
}

export type Analysis = {
    build: bool,
    concurrent: bool
}

export type Basis = {
    persistent: bool,
    types: Types,
    functions: Functions,
    flow?: Flow
}

export type Flow = {
    held: bool[][],
    written: bool[][]
}

export type BasisPlan = {
    slots: Plan,
    hash: bool
}

export type BasisOutput = {
    plan?: BasisPlan,
    effects?: Effects
}
