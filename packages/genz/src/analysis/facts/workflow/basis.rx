<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Basis} out={Workflow.BasisEffects} />

    <Call fn="index.buildBasisSlots" in={$in.work} />

    <If on={$in.persistent}>
        <Call fn="index.hashBasis" in={$in.work} />
    </If>

    <Call fn="index.buildBasisFlow" in={$in.work} />
    <Call fn="../../uniqueness/return_only" in={$in.functions} />

    <Call
        fn="../../uniqueness/sites/effects"
        in={{
            ...$ctx.buildBasisFlow,
            return_only: $ctx.return_only
        }}
    />

    <Return value={$ctx.effects} />
</Module>
