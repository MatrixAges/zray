<Module>
    <Type from="model" as="Workflow" />

    <Args in={Workflow.Basis} out={Workflow.BasisOutput} />

    <If on={$in.flow != null}>
        <Call fn="../../uniqueness/return_only" in={$in.functions} />

        <Call
            fn="../../uniqueness/sites/effects"
            in={{
                ...$in.flow,
                return_only: $ctx.return_only
            }}
        />

        <Return
            value={{
                effects: $ctx.effects
            }}
        />
    </If>

    <Call module="../../uniqueness/slots/build" in={$in.types} />

    <Return
        value={{
            plan: {
                slots: $ctx.build,
                hash: $in.persistent
            }
        }}
    />
</Module>
