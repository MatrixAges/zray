import memory from "memory"

import type { Allocator, BoolBuffer } from "memory"

export type Input = {
    count: u64,
    allocator: Allocator
}

export type Output = {
    buffer: BoolBuffer,
    values: bool[]
}

export default function (in: Input): Output {
    const buffer = memory.createBoolBuffer(in.allocator, in.count, null)

    return {
        buffer,
        values: memory.boolViews(buffer)
    }
}
