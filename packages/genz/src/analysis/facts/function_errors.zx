import integers from "std:integer"

import returnAllocations from "./return_allocations"

import type { Result } from "core/error_effects/functions/model"

export type Input = {
    source: Result,
    native_modules: u32?[]
}

export type Output = {
    groups: string[][],
    error_groups: u32?[],
    return_allocations: bool[]
}

export default function (in: Input): Output {
    const { names: groups, components, unknown } = in.source

    const error_groups = components.map(
        component => {
            const known: u32? = component

            return unknown[integers.widen(component)] ? null : known
        }
    )[0]

    const errors = error_groups.map(
        group => {
            const missing: string[]? = null

            return group == null ? missing : groups[integers.widen(group)]
        }
    )[0]

    const return_allocations = returnAllocations({
        errors,
        native_modules: in.native_modules
    })

    return {
        groups,
        error_groups,
        return_allocations
    }
}
