import integers from "std:integer"

import type { Result as Input } from "core/error_effects/functions/model"

export type Output = string[]?[]

export default function (in: Input): Output {
    const unknown: string[]? = null

    return in.components.map(
        component => {
            const group = integers.widen(component)

            return in.unknown[group] ? unknown : in.names[group]
        }
    )[0]
}
