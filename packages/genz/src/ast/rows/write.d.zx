export type AstWriter = mutable_opaque

export type AstOriginBuffer = mutable_opaque

export type AstSequence = mutable_opaque

export type AstScratch = opaque

export type AstBlockRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    block_label: u8[][],
    block_statements_start: u32[],
    block_statements_len: u32[]
}

export type AstConditionalRows = {
    conditional_condition: u32[],
    conditional_yes: u32[],
    conditional_no: u32[],
    conditional_capture: u8[]?[],
    conditional_error_capture: u8[]?[]
}

export type AstIdentifierRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    identifier: u8[][]
}

export type AstObjectFields = {
    name: string[],
    value: u32[]
}

export type AstFieldAddressRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    field_target: u32[],
    field_name: u8[][],
    address_of: u32[]
}

export type AstLeafStatements = {
    tags: StatementsKind[],
    offsets: u32[],
    expression: u32[],
    discard: u32[],
    constant_name: u8[][],
    constant_type_expr: u32?[],
    constant_value: u32[],
    constant_exported: bool[],
    break_value_label: u8[][],
    break_value_value: u32[]
}

export enum AstPayloadOwnership {
    Owned,
    BorrowingText,
    Borrowed,
    Selected
}

export enum AstSequenceMode {
    Owned,
    BorrowingText,
    SelectedOwned,
    SelectedBorrowingText
}

export type AstCapture = {
    name: u8[],
    label: u8[],
    failure: u32
}

export type AstOrigin = {
    expression_base: u32,
    statement_base: u32,
    serial: u64,
    capture?: AstCapture
}

export declare function readAstOrigin(writer: AstWriter, buffer: AstOriginBuffer): AstOrigin

export declare function appendExpressionRows(
    writer: AstWriter,
    rows: ExpressionRows,
    forms: ExpressionForms?,
    ownership: AstPayloadOwnership
): void throws { OutOfMemory }

export declare function appendStatementRows(
    writer: AstWriter,
    rows: StatementRows,
    variables: StatementVariables?,
    ownership: AstPayloadOwnership
): void throws { OutOfMemory }

export declare function appendAstBlockRows(
    writer: AstWriter,
    rows: AstBlockRows,
    conditionals: AstConditionalRows?
): void throws { OutOfMemory }

export declare function appendAstIdentifierRows(writer: AstWriter, rows: AstIdentifierRows): void
    throws { OutOfMemory }

export declare function appendAstObjectFields(writer: AstWriter, rows: AstObjectFields): void
    throws { OutOfMemory }

export declare function retainAstIds(writer: AstWriter, ids: u32[]): u32[]
    throws { OutOfMemory }

export declare function appendAstOperandRows(writer: AstWriter, rows: AstOperandRows): void
    throws { OutOfMemory }

export declare function appendAstObjectRows(writer: AstWriter, rows: AstObjectRows): void
    throws { OutOfMemory }

export declare function appendAstFieldAddresses(writer: AstWriter, rows: AstFieldAddressRows): void
    throws { OutOfMemory }

export declare function appendAstLeafStatements(writer: AstWriter, rows: AstLeafStatements): void
    throws { OutOfMemory }

export declare function appendStatementSequence(
    writer: AstWriter,
    target: AstSequence,
    rows: StatementRows,
    variables: StatementVariables,
    mode: AstSequenceMode
): void throws { OutOfMemory }

export declare function hoistStatementRows(
    writer: AstWriter,
    rows: StatementRows,
    variables: StatementVariables
): void throws { OutOfMemory }

export declare function appendAuxiliaryFunction(
    writer: AstWriter,
    columns: FunctionRows,
    parameters: FieldRows
): void throws { OutOfMemory }

export declare function appendAstBindingRows(
    writer: AstWriter,
    target: AstSequence,
    rows: BindingRows
): void throws { OutOfMemory }

export declare function publishAstBindingRows(writer: AstWriter, rows: BindingRows): u64
    throws { OutOfMemory }

export declare function publishAstBasicStatements(
    writer: AstWriter,
    rows: BasicStatementRows
): u64 throws { OutOfMemory }

export declare function extendStatementSequence(target: AstSequence, suffix: AstSequence): void
    throws { OutOfMemory }

export declare function statementSequenceBlock(writer: AstWriter, target: AstSequence): u64
    throws { OutOfMemory }

export declare function joinAstSpans(writer: AstWriter, first: u64, second: u64): u64
    throws { OutOfMemory }

export declare function appendAstSpan(writer: AstWriter, span: u64): void
    throws { OutOfMemory }

export declare function astFieldCount(writer: AstWriter): u32

export declare function astDeclarationCount(writer: AstWriter): u32

export declare function appendExtendedExpressions(
    writer: AstWriter,
    rows: ExpressionRows,
    forms: ExpressionForms?,
    extensions: ExpressionExtensions
): void throws { OutOfMemory }

export declare function appendAstFields(writer: AstWriter, rows: FieldRows): void
    throws { OutOfMemory }

export declare function appendAstFunctions(writer: AstWriter, rows: FunctionRows): void
    throws { OutOfMemory }

export declare function joinAstStatementRows(
    writer: AstWriter,
    starts: u32[],
    counts: u32[]
): u32 throws { OutOfMemory }

export declare function astIdentifierCount(writer: AstWriter): u64

export declare function replaceAstIdentifier(writer: AstWriter, index: u64, name: u8[]): void

export declare function astExpressionCount(writer: AstWriter): u32

export declare function auxiliaryDeclarationCount(writer: AstWriter): u64

export declare function appendAstExpressionHeaders(
    writer: AstWriter,
    tags: ExpressionsKind[],
    offsets: u32[]
): void throws { OutOfMemory }

export declare function appendAstNamespaceRows(writer: AstWriter, rows: NamespaceRows): void
    throws { OutOfMemory }

export declare function appendAstProjectionRows(writer: AstWriter, rows: ProjectionRows): void
    throws { OutOfMemory }

export declare function appendAuxiliaryRow(writer: AstWriter, rows: ConstantRows): u8[]
    throws { OutOfMemory }

export declare function replaceAuxiliaryRow(writer: AstWriter, slot: u64, rows: ConstantRows): void
    throws { OutOfMemory }

export declare function joinAstDeclarationRows(
    writer: AstWriter,
    starts: u32[],
    counts: u32[]
): u64 throws { OutOfMemory }

export declare function releaseAstScratch(scratch: AstScratch): void

export declare function appendOwnedAstFields(writer: AstWriter, rows: FieldRows): void
    throws { OutOfMemory }
