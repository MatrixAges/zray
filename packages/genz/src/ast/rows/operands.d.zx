export type AstOperandRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    tuple: u32[][],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][],
    identifier: u8[][],
    address_of: u32[],
    object_type_expr: u32?[],
    object_fields_start: u32[],
    object_fields_len: u32[]
}

export type AstLiteralRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    integer: u64[],
    float: u64[],
    string: u8[][],
    boolean: bool[],
    enum_literal: u8[][],
    error_value: u8[][],
    unary_operator: ExpressionsUnaryOperator[],
    unary_operand: u32[],
    builtin_name: ExpressionsBuiltinName[]
}

export type AstAccessRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    field_target: u32[],
    field_name: u8[][],
    dereference: u32[],
    optional_unwrap: u32[],
    builtin_name: ExpressionsBuiltinName[]
}

export enum StateValueMode {
    Borrow,
    Value,
    ValueLayout,
    Layout,
    Pointer,
    Construct,
    ViewLayout,
    IterationInput,
    IterationOutput
}

export type StatementScopes = {
    variables: StatementVariables,
    starts: u32[],
    counts: u32[]
}

export type StatementSelectionArms = {
    value: u32?[],
    capture: u8[]?[],
    result: u32[]
}

export type StatementSelectionHeaders = {
    tags: StatementsKind[],
    offsets: u32[]
}

export enum AstColumn {
    Identifiers,
    SelectionArms
}

export type SelectionColumns = {
    selection_subject: u32[],
    selection_arms_start: u32[],
    selection_arms_len: u32[]
}

export type StatementSelection = {
    expressions: ExpressionRows,
    extra: SelectionColumns,
    arms: StatementSelectionArms,
    children: StatementSelectionHeaders
}

export type ValueCallEmission = {
    regular: bool,
    result: u8,
    legacy: bool,
    legacy_deref: bool
}

export type CallTarget = {
    function_id: u32,
    io: bool,
    process: bool,
    value?: ValueCallEmission
}
