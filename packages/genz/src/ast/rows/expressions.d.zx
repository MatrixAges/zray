}

export enum StatementsKind {
    Scope,
    DeferExpression,
    ErrdeferExpression,
    DeferScope,
    DiscardError,
    Constant,
    Variable,
    Assignment,
    ForLoop,
    WhileLoop,
    BreakLoop,
    ContinueLoop,
    BreakValue,
    UnreachableStmt,
    Result,
    Branch,
    Discard,
    Expression
}

