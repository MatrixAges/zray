}

export enum StateValueMode {
    Borrow,
    Value,
    ValueLayout,
    Layout,
    Pointer,
    Construct,
    ViewLayout
}

export type ValueCallEmission = {
    regular: bool,
    result: u8,
    legacy: bool,
    legacy_deref: bool
}

export type CallTarget = {
    function_id: u32,
    io: bool,
    process: bool,
    value?: ValueCallEmission
}
