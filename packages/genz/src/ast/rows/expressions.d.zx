export enum AstPayloadOwnership {
    Owned,
    BorrowingText,
    Borrowed,
    Selected
}

export enum AstSequenceMode {
    Owned,
    BorrowingText,
    SelectedOwned,
    SelectedBorrowingText
}

export type AstCapture = {
    name: u8[],
    label: u8[],
    failure: u32
}

export type AstOrigin = {
    expression_base: u32,
    statement_base: u32,
    serial: u64,
    capture?: AstCapture
}

export type CollectionRows = {
    first: u32,
    second: u32,
    third: u32,
    items: u32,
    value: u32,
    header: u32,
    element: u32,
    length: u32,
