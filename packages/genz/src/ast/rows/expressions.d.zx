export enum ExpressionsKind {
    Identifier,
    NullValue,
    Unit,
    ReturnValue,
    CatchScope,
    FixedArrayType,
    UndefinedValue,
    UnreachableValue,
    OptionalType,
    TupleType,
    EnumType,
    EnumLiteral,
    Array,
    Tuple,
    Index,
    Slice,
    Range,
    AddressOf,
    ErrorValue,
    Block,
    TryValue,
    CatchValue,
    ComptimeValue,
    ErrorSet,
    ErrorUnion,
    Integer,
    Float,
    String,
    Boolean,
    Primitive,
    Dereference,
    OptionalUnwrap,
    Selection,
    Pointer,
    ConstPointer,
    ConstSlice,
    MutableSlice,
    ManyPointer,
    OpaqueType,
    StructType,
    NamespaceType,
    ContainerType,
    Field,
    Unary,
    Binary,
    Builtin,
    Call,
    Conditional,
    Object
}

export enum ExpressionsUnaryOperator {
    Negate,
    Not
}

export enum ExpressionsBinaryOperator {
    Add,
    SaturatingAdd,
    ShiftLeft,
    Subtract,
    Multiply,
    Divide,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    LogicalAnd,
    LogicalOr,
    Coalesce
}

export enum ExpressionsBuiltinName {
    DivTrunc,
    Rem,
    As,
    SetRuntimeSafety,
    Import,
    EmbedFile,
    IntCast,
    FloatCast,
    FloatFromInt,
    IntFromFloat,
    Trunc,
    TagName,
    EnumFromInt,
    IntFromEnum,
    TypeOf,
    FieldType,
    TypeInfo,
    SizeOf,
    Max,
    IntFromPtr,
    Int,
    Export,
    CompileError,
    IntFromBool,
    ErrorName,
    This,
    ConstCast,
    PtrCast,
    AlignCast,
    Memcpy,
    Vector,
    Splat,
    Field,
    HasField,
    HasDecl
}

export type ExpressionRows = {
    tags: ExpressionsKind[],
    offsets: u32[],
    unary_operator: ExpressionsUnaryOperator[],
    unary_operand: u32[],
    binary_operator: ExpressionsBinaryOperator[],
    binary_left: u32[],
    binary_right: u32[],
    builtin_name: ExpressionsBuiltinName[],
    builtin_arguments: u32[][],
    identifier: u8[][],
    integer: u64[],
    field_target: u32[],
    field_name: u8[][],
    call_callee: u32[],
    call_arguments: u32[][],
    try_value: u32[],
    comptime_value: u32[],
    dereference: u32[],
    catch_value_value: u32[],
    catch_value_capture: u8[][],
    catch_value_label: u8[][],
    catch_value_result: u32[],
    slice_target: u32[],
    slice_start: u32?[],
    slice_end: u32?[],
    range_start: u32[],
    range_end: u32[],
    index_target: u32[],
    index_index: u32[],
    block_label: u8[][],
    block_statements_start: u32[],
    block_statements_len: u32[]
}
