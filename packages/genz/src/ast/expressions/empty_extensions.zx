import type { ExpressionExtensions as Output } from "ast_rows"

export type Input = {}

export default function (in: Input): Output {
    return {
        catch_scope_value: [],
        catch_scope_capture: [],
        catch_scope_body_start: [],
        catch_scope_body_len: [],
        mutable_slice: [],
        error_union_payload: [],
        error_union_errors: [],
        error_union_inferred: [],
        namespace_type_start: [],
        namespace_type_len: [],
        error_set: [],
        optional_type: [],
        struct_type_start: [],
        struct_type_len: []
    }
}
