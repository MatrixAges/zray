import type { AstOrigin, StatementVariables as Variables } from "ast_rows"
import type { Columns as Forms } from "../expressions/forms/model"
import type { Columns as Expressions } from "../expressions/model"
import type { Columns as Statements } from "../statements/model"

export type { StatementVariables as Variables } from "ast_rows"

export type Input = AstOrigin & {
    field_base: u32
}

export type State = {
    source: Input,
    expressions: Expressions,
    forms: Forms,
    statements: Statements,
    variables: Variables,
    undefined_count: u64,
    null_count: u64,
    serial: u64,
    valid: bool
}

export type Node = {
    state: State,
    id: u32
}
