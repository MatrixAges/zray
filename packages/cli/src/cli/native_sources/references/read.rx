<Module>
    <Type from="model" as="References" />

    <Args in={References.Source} out={References.Result} />

    <Call
        fn="../index.scanBuiltins"
        in={[
            $in.collection,
            $in.content
        ]}
    />

    <Call fn="read" />

    <If on={$ctx.read.issue != null}>
        <Return value={$ctx.read} />
    </If>

    <If on={$ctx.read.paths.length != 0}>
        <Loop on={$in.running}>
            <Call
                module="decode_step"
                in={{
                    collection: $in.collection,
                    raw_paths: $ctx.read.paths,
                    raw_sources: $ctx.read.sources,
                    index: 0,
                    paths: [],
                    sources: [],
                    running: true
                }}
            />
        </Loop>

        <Return
            value={{
                ...$ctx.read.pick([
                    "dynamic_resources",
                    "c_imports"
                ]),
                paths: $ctx.decode_step.paths,
                sources: $ctx.decode_step.sources
            }}
        />
    </If>

    <Return value={$ctx.read} />
</Module>
