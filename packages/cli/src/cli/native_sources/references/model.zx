import type { Flags } from "../collect/model"

export type Input = {
    name: string,
    arguments: u64,
    literal: bool
}

export enum Action {
    Ignore,
    CImport,
    InvalidSource,
    InvalidImport,
    DynamicAsset,
    Zig,
    Asset
}

export type Result = Flags & {
    paths: string[],
    sources: bool[]
}
