import host from "native_resource_host"

import classify from "./classify"
import local from "./local"
import { Action } from "./model"

import type { Context } from "native_resource_host"
import type { Result } from "./model"

export type Input = Context

export type Output = Result

export default function (in: Input): Output {
    const empty_paths: string[] = []
    const empty_sources: bool[] = []

    return loop({
        dynamic_resources: false,
        c_imports: false,
        paths: empty_paths,
        sources: empty_sources
    }, {
        while: state => host.nextBuiltin(in),
        next: state => {
            const action = classify({
                name: host.builtinName(in),
                arguments: host.builtinArguments(in),
                literal: host.builtinHasLiteral(in)
            })

            switch (action) {
                case Action.CImport:
                    state.c_imports = true
                case Action.InvalidSource:
                    host.invalidBuiltin(in, false)
                case Action.InvalidImport:
                    host.invalidBuiltin(in, true)
                case Action.DynamicAsset:
                    state.dynamic_resources = true
                case Action.Zig:
                    const path = host.decodeLiteral(in)

                    if (local(path)) {
                        state.paths = state.paths.push(path)[0]
                        state.sources = state.sources.push(true)[0]
                    } else {
                        host.discardLiteral(in, path)
                    }
                case Action.Asset:
                    state.paths = state.paths.push(host.decodeLiteral(in))[0]
                    state.sources = state.sources.push(false)[0]
                default:
            }
        }
    })
}
