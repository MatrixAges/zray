<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Discovery} out={Collection.Decision} />

    <Store from="state" as="collection" />

    <Call
        fn="../index.openCollection"
        in={[
            $in.collection,
            $in.root,
            $in.entry_path
        ]}
    />

    <If on={$in.entry_path != null}>
        <Call
            fn="enqueue_one"
            in={{
                queue: $store.collection.queue,
                path: $in.entry_path,
                source: true,
                from_present: false,
                from_path: ""
            }}
            setter={[$store.collection.queue]}
        />
    </If>

    <If on={$in.bundle_files.length != 0}>
        <Loop on={$in.running}>
            <Call
                module="seed_bundle"
                in={{
                    collection: $in.collection,
                    root: $in.root,
                    separator: $in.separator,
                    canonical_root: $ctx.openCollection,
                    bundle_files: $in.bundle_files,
                    index: 0,
                    running: true
                }}
            />
        </Loop>

        <If on={$ctx.seed_bundle.issue != null}>
            <Return
                value={{
                    valid: false,
                    issue: $ctx.seed_bundle.issue,
                    dynamic_resources: false,
                    c_imports: $in.header
                }}
            />
        </If>
    </If>

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                collection: $in.collection,
                root: $in.root,
                separator: $in.separator,
                canonical_root: $ctx.openCollection,
                has_bundle: $in.bundle_files.length != 0,
                index: 0,
                running: true,
                flags: {
                    valid: true,
                    dynamic_resources: false,
                    c_imports: $in.header
                }
            }}
        />
    </Loop>

    <Return value={$ctx.walk.flags} />
</Module>
