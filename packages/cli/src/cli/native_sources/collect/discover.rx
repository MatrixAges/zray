<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Discovery} out={Collection.Decision} />

    <Call fn="../index.openCollection" in={$in.collection} />

    <Call
        fn="seed"
        in={$in.pick([
            "collection",
            "bundle_files"
        ])}
    />

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                collection: $in.collection,
                has_bundle: $in.bundle_files.length != 0,
                index: 0,
                running: true,
                flags: {
                    valid: true,
                    dynamic_resources: false,
                    c_imports: $in.header
                }
            }}
        />
    </Loop>

    <Return value={$ctx.walk.flags} />
</Module>
