import host from "native_resource_host"

import type { Discovery } from "./model"

export type Input = Discovery.Pick("collection", "bundle_files")

export type Output = void

export default function (in: Input): Output {
    const { collection, bundle_files } = in

    const entry = host.entryPath(collection)

    if (entry != null) {
        host.enqueue(collection, entry, true)
    }

    const seeded = loop({
        index: 0
    }, {
        while: bundle => bundle.index < bundle_files.length,
        next: bundle => {
            const paths = host.readBundle(collection, bundle_files[bundle.index])

            const queued = loop({
                index: 0
            }, {
                while: file => file.index < paths.length,
                next: file => {
                    host.enqueue(collection, paths[file.index], false)
                    file.index += 1
                }
            })

            bundle.index += 1
        }
    })
}
