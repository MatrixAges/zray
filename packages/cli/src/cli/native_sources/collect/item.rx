<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Pending} out={Collection.Decision} />

    <Store from="state" as="collection" />

    <Call
        fn="../index.relativePath"
        in={[
            $in.collection,
            $in.path
        ]}
    />

    <Call
        fn="lookup_seen"
        in={{
            seen: $store.collection.seen,
            relative: $ctx.relativePath
        }}
    />

    <Call
        module="visit"
        in={{
            found: $ctx.lookup_seen.found,
            previous_parsed: $ctx.lookup_seen.parsed,
            source: $in.source
        }}
    />

    <If on={$ctx.visit == Collection.Action.Skip}>
        <Return value={$in.flags} />
    </If>

    <Call
        fn="../index.checkPending"
        in={[
            $in.collection,
            $in.path
        ]}
    />

    <Call
        module="load_pending"
        in={{
            ...$in.pick([
                "collection",
                "path"
            ]),
            cached: $store.collection.seen.contents,
            reuse: $ctx.visit == Collection.Action.Promote,
            index: $ctx.lookup_seen.index
        }}
    />

    <Call
        fn="../index.observePending"
        in={[
            $in.collection,
            $in.path,
            $ctx.load_pending
        ]}
    />

    <If on={$ctx.visit == Collection.Action.Promote}>
        <Call
            fn="promote_seen"
            in={{
                seen: $store.collection.seen,
                index: $ctx.lookup_seen.index
            }}
            setter={[$store.collection.seen]}
        />

        <Else>
            <Call
                fn="add_seen"
                in={{
                    ...$in.pick([
                        "source",
                        "from_present",
                        "from_path"
                    ]),
                    seen: $store.collection.seen,
                    relative: $ctx.relativePath,
                    content: $ctx.load_pending
                }}
                setter={[$store.collection.seen]}
            />
        </Else>
    </If>

    <If on={$ctx.visit == Collection.Action.ReadAsset}>
        <Return value={$in.flags} />
    </If>

    <Call
        module="../references/read"
        in={{
            collection: $in.collection,
            content: $ctx.load_pending
        }}
    />

    <Call
        module="scan"
        in={{
            found: $ctx.read.pick([
                "dynamic_resources",
                "c_imports"
            ]),
            accumulated: $in.flags.pick([
                "dynamic_resources",
                "c_imports"
            ]),
            has_bundle: $in.has_bundle
        }}
    />

    <If on={$ctx.scan.valid && $ctx.read.paths.length != 0}>
        <Loop on={$in.running}>
            <Call
                module="enqueue_refs"
                in={{
                    collection: $in.collection,
                    current_path: $in.path,
                    relative: $ctx.relativePath,
                    ref_paths: $ctx.read.paths,
                    ref_sources: $ctx.read.sources,
                    index: 0,
                    running: true
                }}
            />
        </Loop>
    </If>

    <Return value={$ctx.scan} />
</Module>
