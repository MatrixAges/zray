import type { Context } from "native_resource_host"

export type Item = {
    previous_parsed?: bool,
    source: bool
}

export enum Action {
    Skip,
    ReadAsset,
    ReadSource,
    Promote
}

export type Flags = {
    dynamic_resources: bool,
    c_imports: bool
}

export type Scan = {
    found: Flags,
    accumulated: Flags,
    has_bundle: bool
}

export type Decision = Flags & {
    valid: bool
}

export type Discovery = {
    collection: Context,
    bundle_files: string[],
    header: bool
}

export type Walk = Discovery.Pick("collection", "header") & {
    has_bundle: bool
}

export type Pending = Walk.Pick("collection", "has_bundle") & {
    index: u64,
    flags: Decision
}
