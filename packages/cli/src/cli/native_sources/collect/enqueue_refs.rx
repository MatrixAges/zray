<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.EnqueueRefsStep} out={Collection.EnqueueRefsStep} />

    <Store from="state" as="collection" />

    <Call
        fn="../path/resolve"
        in={{
            root: $in.root,
            current_path: $in.current_path,
            path: $in.ref_paths[$in.index],
            separator: $in.separator
        }}
    />

    <If on={$ctx.resolve.issue != null}>
        <Return
            value={{
                ...$in,
                issue: $ctx.resolve.issue,
                running: false
            }}
        />
    </If>

    <Call
        fn="enqueue_one"
        in={{
            queue: $store.collection.queue,
            path: $ctx.resolve.path,
            source: $in.ref_sources[$in.index],
            from_present: true,
            from_path: $in.relative
        }}
        setter={[$store.collection.queue]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.ref_paths.length
        }}
    />
</Module>
