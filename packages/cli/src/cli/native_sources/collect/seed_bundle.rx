<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.SeedBundleStep} out={Collection.SeedBundleStep} />

    <Store from="state" as="collection" />

    <Call
        fn="../path/resolve"
        in={{
            root: $in.root,
            path: $in.bundle_files[$in.index],
            separator: $in.separator
        }}
    />

    <If on={$ctx.resolve.issue != null}>
        <Return
            value={{
                ...$in,
                issue: $ctx.resolve.issue,
                running: false
            }}
        />
    </If>

    <Call
        fn="../index.readBundle"
        in={[
            $in.collection,
            $in.canonical_root,
            $ctx.resolve.path
        ]}
    />

    <If on={$ctx.readBundle.length != 0}>
        <Call
            fn="enqueue_batch"
            in={{
                queue: $store.collection.queue,
                paths: $ctx.readBundle,
                source: false
            }}
            setter={[$store.collection.queue]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.bundle_files.length
        }}
    />
</Module>
