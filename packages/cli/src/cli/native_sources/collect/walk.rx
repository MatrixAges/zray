<Module>
    <Type from="model" as="State" />

    <Args in={State.Step} out={State.Step} />

    <Store from="state" as="collection" />

    <Call
        fn="next_queued"
        in={{
            queue: $store.collection.queue,
            index: $in.index
        }}
    />

    <If on={!$ctx.next_queued.found}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />
    </If>

    <Call
        module="item"
        in={{
            collection: $in.collection,
            root: $in.root,
            canonical_root: $in.canonical_root,
            has_bundle: $in.has_bundle,
            path: $ctx.next_queued.path,
            source: $ctx.next_queued.source,
            from_present: $ctx.next_queued.from_present,
            from_path: $ctx.next_queued.from_path,
            flags: $in.flags
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            flags: $ctx.item,
            running: $ctx.item.valid
        }}
    />
</Module>
