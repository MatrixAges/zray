import host from "native_resource_host"

import item from "./item.rx"

import type { Walk as Input, Decision as Output } from "./model"

export default function (in: Input): Output {
    const { collection, has_bundle, header } = in

    return loop({
        index: 0,
        flags: {
            valid: true,
            dynamic_resources: false,
            c_imports: header
        }
    }, {
        while: state =>
            state.flags.valid && state.index < host.pendingCount(collection),
        next: state => {
            state.flags = item({
                collection,
                has_bundle,
                index: state.index,
                flags: state.flags
            })

            state.index += 1
        },
        return: state => state.flags
    })
}
