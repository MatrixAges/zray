import { ascii_dot, ascii_null, ascii_slash } from "core/ascii/const"

import { parent_path } from "../const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    return loop({
        index: 0,
        segment: 0,
        dots: 0,
        valid: true
    }, {
        while: state => state.valid && state.index <= in.length,
        next: state => {
            const byte = state.index == in.length ? ascii_slash : in[state.index]

            if (byte == ascii_null) {
                state.valid = false
            } else if (byte == ascii_slash) {
                const regular = state.segment > parent_path.length ||
                    state.segment != state.dots

                state.valid = state.segment > 0 && regular
                state.segment = 0
                state.dots = 0
            } else {
                state.segment += 1
                if (byte == ascii_dot) {
                    state.dots += 1
                }
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
