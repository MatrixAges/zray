<Module>
    <Type from="model" as="Inventory" />

    <Args in={Inventory.Input} out={bool} />

    <If on={$in.absolute}>
        <Return value={false} />
    </If>

    <Call fn="components" in={$in.path} />

    <If on={!$ctx.components}>
        <Return value={false} />
    </If>

    <Call fn="native" in={$in.path} />

    <If on={$ctx.native || $in.native_only}>
        <Return value={$ctx.native} />
    </If>

    <Call fn="category" in={$in.path} />

    <Return value={$ctx.category} />
</Module>
