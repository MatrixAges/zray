import { joinNativeParts } from "publication_host"

import type { Input, Step as Output } from "./model"

export default function (in: Input): Output {
    return {
        ...in.omit(["name"]),
        destination: joinNativeParts([
            "native",
            in.name,
            "source"
        ]),
        paths: [],
        relocations: [],
        valid: true,
        index: 0
    }
}
