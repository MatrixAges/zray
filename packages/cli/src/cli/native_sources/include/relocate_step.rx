<Module>
    <Type from="model" as="Relocate" />

    <Args in={Relocate.Step} out={Relocate.Step} />

    <Call
        fn="target"
        in={{
            project_root: $in.project_root,
            root: $in.root,
            configured: $in.include_paths[$in.index],
            separator: $in.separator
        }}
    />

    <If on={$ctx.target.within}>
        <Call
            fn="find"
            in={{
                seen: $in.seen,
                directory: $ctx.target.relative,
                separator: $in.separator,
                windows: $in.windows
            }}
        />

        <If on={$ctx.find}>
            <Call
                fn="../index.readBundle"
                in={[
                    $in.collection,
                    $ctx.target.absolute
                ]}
            />

            <Call
                fn="all_seen"
                in={{
                    root: $in.root,
                    files: $ctx.readBundle,
                    seen: $in.seen
                }}
            />

            <If on={!$ctx.all_seen}>
                <Return
                    value={{
                        ...$in,
                        valid: false
                    }}
                />
            </If>

            <Call
                fn="append"
                in={{
                    step: $in,
                    absolute: $ctx.target.absolute,
                    relative: $ctx.target.relative
                }}
            />

            <Return value={$ctx.append} />
        </If>
    </If>

    <Call
        fn="append"
        in={{
            step: $in,
            absolute: $ctx.target.absolute
        }}
    />

    <Return value={$ctx.append} />
</Module>
