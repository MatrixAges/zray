import bytes from "std:bytes"
import { ascii_slash } from "core/ascii/const"

import { current_path } from "../const"

export type Input = {
    directory: string,
    file: string,
    primary_separator: u8,
    windows: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { directory, file, windows } = in

    if (directory == current_path || directory.length == 0) {
        return true
    }

    const size = directory.length

    if (file.length <= size) {
        return false
    }

    const separator = file[size]

    const separated =
        separator == in.primary_separator || (windows && separator == ascii_slash)

    return separated && bytes.startsWithText(bytes.fromText(file), 0, directory)
}
