import { relativePathFrom } from "publication_host"

import type { Seen } from "../collect/model"

export type Input = {
    root: string,
    files: string[],
    seen: Seen
}

export type Output = bool

export default function (in: Input): Output {
    const { root, files, seen } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: row => row.valid && row.index < files.length,
        next: row => {
            const target = relativePathFrom(root, files[row.index])

            const admitted = loop(0, {
                while: item =>
                    item < seen.relative_paths.length &&
                    seen.relative_paths[item] != target,
                next: item => {
                    item += 1
                },
                return: item => item < seen.relative_paths.length
            })

            row.valid = admitted
            row.index += 1
        },
        return: row => row.valid
    })
}
