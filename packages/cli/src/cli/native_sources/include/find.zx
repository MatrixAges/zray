import asset from "./asset"

import type { Seen } from "../collect/model"

export type Input = {
    seen: Seen,
    directory: string,
    separator: u8,
    windows: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { seen, directory, separator, windows } = in

    return loop({
        index: 0,
        found: false
    }, {
        while: row => row.index < seen.relative_paths.length && !row.found,
        next: row => {
            if (seen.is_asset[row.index]) {
                row.found = asset({
                    directory,
                    file: seen.relative_paths[row.index],
                    primary_separator: separator,
                    windows
                })
            }

            row.index += 1
        },
        return: row => row.found
    })
}
