import host from "native_resource_host"

import type { Context as Input } from "native_resource_host"

export type Output = bool

export default function (in: Input): Output {
    const files = host.includeFiles(in)

    return loop({
        index: 0,
        valid: true
    }, {
        while: row => row.valid && row.index < files.length,
        next: row => {
            row.valid = host.includesFile(in, files[row.index])
            row.index += 1
        },
        return: row => row.valid
    })
}
