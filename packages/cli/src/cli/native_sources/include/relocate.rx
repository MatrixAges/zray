<Module>
    <Type from="model" as="Relocate" />

    <Args in={Relocate.Input} out={Relocate.Output} />

    <Call fn="begin" in={$in} />

    <Loop on={$in.valid && $in.index < $in.include_paths.length}>
        <Call module="relocate_step" />
    </Loop>

    <Return
        value={$ctx.relocate_step.pick([
            "destination",
            "paths",
            "relocations",
            "valid"
        ])}
    />
</Module>
