import type { Root } from "../collect/model"
import type { Seen } from "../collect/model"

export type Input = Root & {
    name: string,
    project_root: string,
    include_paths: string[],
    seen: Seen,
    separator: u8,
    windows: bool
}

export type Relocation = {
    source: string,
    index: u64
}

export type Output = {
    destination: string,
    paths: string[],
    relocations: Relocation[],
    valid: bool
}

export type Step = Input.Omit("name") & Output & {
    index: u64
}
