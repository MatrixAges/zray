import type { Context } from "native_resource_host"
import type { Discovery, Flags } from "../collect/model"

export type Input = Discovery.Omit("entry_path") & {
    header_absolute: bool,
    include_paths: string[],
    separator: u8,
    windows: bool
}

export enum Status {
    Published,
    AbsoluteHeader,
    OutputOverlap,
    MissingBundle,
    IncompleteInclude
}

export type Output = Flags & {
    status: Status
}

export type FileWalk = {
    collection: Context,
    count: u64,
    index: u64
}
