import type { Discovery, Flags, Root, Seen } from "../collect/model"
import type { Output as IncludeOutput } from "../include/model"
import type { Issue } from "../path/model"

export type Input = Discovery.Omit("root") & {
    directory: string,
    project_root: string,
    name: string,
    header_absolute: bool,
    include_paths: string[],
    windows: bool
}

export enum Status {
    Published,
    AbsoluteHeader,
    OutputOverlap,
    MissingBundle,
    IncompleteInclude,
    InvalidResource
}

export type Output = Flags & {
    status: Status,
    issue?: Issue,
    files: File[],
    entry?: string,
    includes?: IncludeOutput
}

export type File = {
    path: string,
    asset: bool,
    sha256: string,
    referenced_from?: string
}

export type FileWalk = {
    directory: string,
    destination: string,
    seen: Seen,
    index: u64,
    files: File[]
}

export type OutputCheck = Root & {
    bundle_files: string[],
    output: string,
    physical_output?: string
}

export type OutputStep = OutputCheck & {
    index: u64,
    valid: bool,
    issue?: Issue
}

export type OutputSafety = OutputStep.Pick("valid", "issue")
