import type { Context } from "native_resource_host"
import type { Discovery, Flags, Seen } from "../collect/model"

export type Input = Discovery.Omit("entry_path") & {
    directory: string,
    header_absolute: bool,
    include_paths: string[],
    separator: u8,
    windows: bool
}

export enum Status {
    Published,
    AbsoluteHeader,
    OutputOverlap,
    MissingBundle,
    IncompleteInclude
}

export type Output = Flags & {
    status: Status,
    files: File[]
}

export type File = {
    path: string,
    asset: bool,
    sha256: string,
    referenced_from?: string
}

export type FileWalk = {
    directory: string,
    destination: string,
    seen: Seen,
    index: u64,
    files: File[]
}

export type OutputCheck = {
    collection: Context,
    bundle_files: string[],
    output: string,
    physical_output?: string,
    separator: u8
}

export type OutputStep = OutputCheck & {
    index: u64,
    valid: bool
}
