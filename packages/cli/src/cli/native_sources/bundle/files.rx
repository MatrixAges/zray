<Module>
    <Type from="model" as="Model" />

    <Args in={Model.FileWalk} out={Model.FileWalk} />

    <Call fn="plan_file" in={$in} />

    <Call module="../../workspace_files/write_artifact" in={$ctx.plan_file.artifact} />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            files: $ctx.plan_file.files
        }}
    />
</Module>
