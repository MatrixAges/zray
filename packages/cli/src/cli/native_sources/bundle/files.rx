<Module>
    <Type from="model" as="Model" />

    <Args in={Model.FileWalk} out={Model.FileWalk} />

    <Call
        fn="../index.publishFile"
        in={[
            $in.collection,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
