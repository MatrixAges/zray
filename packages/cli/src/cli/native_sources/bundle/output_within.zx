import path from "std:path"
import { relativePathFrom } from "publication_host"

import within from "../path/within"

export type Input = {
    resource: string,
    output: string,
    separator: u8
}

export type Output = bool

export default function (in: Input): Output {
    const { resource, output, separator } = in

    const relative = relativePathFrom(resource, output)

    return within({
        path: relative,
        absolute: path.isAbsolute(relative),
        separator
    })
}
