<Module>
    <Type from="model" as="Bundle" />

    <Args in={Bundle.Input} out={Bundle.Output} />

    <Store from="../collect/state" as="collection" />

    <If on={$in.header_absolute}>
        <Return
            value={{
                status: Bundle.Status.AbsoluteHeader,
                dynamic_resources: false,
                c_imports: false,
                files: []
            }}
        />
    </If>

    <Call
        fn="locations"
        in={$in.pick([
            "project_root",
            "entry_path",
            "directory"
        ])}
    />

    <Call
        fn="../index.physicalOutput"
        in={[
            $in.collection,
            $ctx.locations.output
        ]}
    />

    <Call
        module="check_output"
        in={{
            collection: $in.collection,
            root: $ctx.locations.root,
            bundle_files: $in.bundle_files,
            output: $ctx.locations.output,
            physical_output: $ctx.physicalOutput,
            separator: $in.separator
        }}
    />

    <If on={!$ctx.check_output}>
        <Return
            value={{
                status: Bundle.Status.OutputOverlap,
                dynamic_resources: false,
                c_imports: false,
                files: []
            }}
        />
    </If>

    <Call
        module="../collect/discover"
        in={{
            collection: $in.collection,
            root: $ctx.locations.root,
            entry_path: $ctx.locations.entry,
            bundle_files: $in.bundle_files,
            header: $in.header
        }}
    />

    <If on={!$ctx.discover.valid}>
        <Return
            value={{
                status: Bundle.Status.MissingBundle,
                dynamic_resources: false,
                c_imports: false,
                files: []
            }}
        />
    </If>

    <Call
        module="../include/relocate"
        in={{
            collection: $in.collection,
            root: $ctx.locations.root,
            name: $in.name,
            project_root: $in.project_root,
            include_paths: $in.include_paths,
            seen: $store.collection.seen,
            separator: $in.separator,
            windows: $in.windows
        }}
    />

    <If on={!$ctx.relocate.valid}>
        <Return
            value={{
                status: Bundle.Status.IncompleteInclude,
                dynamic_resources: false,
                c_imports: false,
                files: []
            }}
        />
    </If>

    <Loop on={$in.index < $in.seen.relative_paths.length}>
        <Call
            module="files"
            in={{
                directory: $in.directory,
                destination: $ctx.relocate.destination,
                seen: $store.collection.seen,
                index: 0,
                files: []
            }}
        />
    </Loop>

    <Call
        fn="entry"
        in={{
            path: $ctx.locations.entry,
            destination: $ctx.relocate.destination
        }}
    />

    <Return
        value={{
            status: Bundle.Status.Published,
            dynamic_resources: $ctx.discover.dynamic_resources,
            c_imports: $ctx.discover.c_imports,
            files: $ctx.files.files,
            entry: $ctx.entry,
            includes: $ctx.relocate
        }}
    />
</Module>
