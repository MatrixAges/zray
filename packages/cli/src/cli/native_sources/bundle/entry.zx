import { pathBasename } from "lexical_path"
import { joinNativeParts } from "publication_host"

export type Input = {
    path?: string,
    destination: string
}

export type Output = string?

export default function (in: Input): Output {
    const entry = in.path

    if (entry == null) {
        return null
    }

    return joinNativeParts([
        in.destination,
        pathBasename(entry)
    ])
}
