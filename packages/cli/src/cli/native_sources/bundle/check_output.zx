import host from "native_resource_host"

import type { Input as Bundle } from "./model"

export type Input = Bundle.Pick("collection", "bundle_files")

export type Output = bool

export default function (in: Input): Output {
    const { collection, bundle_files } = in

    return loop({
        index: 0,
        valid: true
    }, {
        while: row => row.valid && row.index < bundle_files.length,
        next: row => {
            const resource = host.bundlePath(collection, bundle_files[row.index])

            row.valid = !host.logicalOutputInside(collection, resource) &&
                !host.physicalOutputInside(collection, resource)
            row.index += 1
        },
        return: row => row.valid
    })
}
