import host from "publication_host"
import { ResourceKind } from "publication_host"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    return loop({
        reading: true,
        valid: true
    }, {
        while: state => state.reading,
        next: state => {
            const kind = host.nextResource(in)

            if (kind == ResourceKind.End) {
                state.reading = false
            } else {
                const directory = kind == ResourceKind.Directory

                host.observeResource(in, directory)

                if (!directory) {
                    const link_to_file =
                        kind == ResourceKind.Symlink && host.resourceLinkIsFile(in)

                    if (kind == ResourceKind.Regular || link_to_file) {
                        host.keepResource(in)
                    } else {
                        state.valid = false
                        state.reading = false
                    }
                }
            }
        },
        return: state => state.valid
    })
}
