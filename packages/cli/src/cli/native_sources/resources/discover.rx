<Module>
    <Type from="model" as="Resource" />

    <Args in={Resource.Input} out={Resource.Output} />

    <Store from="collected" as="state" />

    <Call fn="index.resourceRoot" in={$in.walk} />

    <If on={$ctx.resourceRoot.kind == Resource.ResourceKind.Regular}>
        <Return
            value={{
                supported: true,
                paths: [$ctx.resourceRoot.path]
            }}
        />
    </If>

    <If on={$ctx.resourceRoot.kind != Resource.ResourceKind.Directory}>
        <Return
            value={{
                supported: false,
                paths: []
            }}
        />
    </If>

    <Call fn="index.openResources" in={$in.walk} />

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                walk: $in.walk,
                running: true,
                valid: true
            }}
        />
    </Loop>

    <If on={!$ctx.step.valid}>
        <Return
            value={{
                supported: false,
                paths: []
            }}
        />
    </If>

    <Call fn="finish" in={$store.state.discovered} />

    <Return value={$ctx.finish} />
</Module>
