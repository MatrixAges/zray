export type Context = mutable_opaque

export type Builtin = {
    name: string,
    arguments: u64,
    literal?: string
}

export type IncludeTarget = {
    absolute: string,
    relative: string,
    within: bool
}

export declare function prepareBundle(collection: Context): string? throws { NativeResourceFailure }
export declare function bundlePath(collection: Context, path: string): string throws { NativeResourceFailure }
export declare function logicalOutputInside(collection: Context, resource: string): bool throws { NativeResourceFailure }
export declare function physicalOutputInside(collection: Context, resource: string): bool throws { NativeResourceFailure }

export declare function openCollection(collection: Context): void throws { NativeResourceFailure }
export declare function readBundle(collection: Context, path: string): string[] throws { NativeResourceFailure }
export declare function relativePath(collection: Context, path: string): string throws { NativeResourceFailure }
export declare function resolveReference(
    collection: Context,
    current_path: string,
    reference_path: string
): string throws { NativeResourceFailure }
export declare function checkPending(collection: Context, path: string): void throws { NativeResourceFailure }
export declare function readPending(collection: Context, path: string): void throws { NativeResourceFailure }
export declare function reusePending(collection: Context, index: u64): void
export declare function observePending(collection: Context, path: string): void throws { NativeResourceFailure }
export declare function addSource(
    collection: Context,
    relative: string,
    source: bool,
    from_present: bool,
    from_path: string
): void throws { NativeResourceFailure }
export declare function promoteSource(collection: Context, index: u64): void

export declare function prepareIncludes(collection: Context): void throws { NativeResourceFailure }
export declare function selectInclude(collection: Context, path: string): IncludeTarget throws {
    NativeResourceFailure
}
export declare function includeFiles(collection: Context, absolute: string): string[] throws {
    NativeResourceFailure
}
export declare function writeInclude(
    collection: Context,
    index: u64,
    bundled: bool,
    absolute: string,
    relative: string
): void throws { NativeResourceFailure }

export declare function prepareFiles(collection: Context): void throws { NativeResourceFailure }
export declare function publishFile(collection: Context, index: u64): void throws { NativeResourceFailure }

export declare function scanBuiltins(collection: Context): Builtin[] throws { NativeResourceFailure }
export declare function decodeLiteral(collection: Context, raw: string): string throws { NativeResourceFailure }
export declare function invalidBuiltin(collection: Context, invalid_import: bool): void throws { NativeResourceFailure }
