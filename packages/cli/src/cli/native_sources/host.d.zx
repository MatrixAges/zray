export type Context = mutable_opaque

export declare function absoluteHeader(collection: Context): bool
export declare function prepareBundle(collection: Context): void throws { NativeResourceFailure }
export declare function bundlePath(collection: Context, path: string): string throws { NativeResourceFailure }
export declare function logicalOutputInside(collection: Context, resource: string): bool throws { NativeResourceFailure }
export declare function physicalOutputInside(collection: Context, resource: string): bool throws { NativeResourceFailure }

export declare function openCollection(collection: Context): void throws { NativeResourceFailure }
export declare function entryPath(collection: Context): string?
export declare function readBundle(collection: Context, path: string): string[] throws { NativeResourceFailure }
export declare function enqueue(collection: Context, path: string, source: bool): void throws { NativeResourceFailure }
export declare function pendingCount(collection: Context): u64
export declare function selectPending(collection: Context, index: u64): bool? throws { NativeResourceFailure }
export declare function sourcePending(collection: Context): bool
export declare function checkPending(collection: Context): void throws { NativeResourceFailure }
export declare function readPending(collection: Context): void throws { NativeResourceFailure }
export declare function reusePending(collection: Context): void
export declare function observePending(collection: Context): void throws { NativeResourceFailure }
export declare function addPending(collection: Context): void throws { NativeResourceFailure }
export declare function promotePending(collection: Context): void
export declare function referenceCount(collection: Context): u64
export declare function enqueueReference(collection: Context, index: u64): void throws { NativeResourceFailure }

export declare function prepareIncludes(collection: Context): void throws { NativeResourceFailure }
export declare function selectInclude(collection: Context, path: string): string? throws { NativeResourceFailure }
export declare function includeFiles(collection: Context): string[] throws { NativeResourceFailure }
