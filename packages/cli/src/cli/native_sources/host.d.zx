export declare function sourceCount(collection: Context): u64
export declare function sourceIsAsset(collection: Context, index: u64): bool
export declare function sourcePath(collection: Context, index: u64): string

export declare function prepareFiles(collection: Context): void throws { NativeResourceFailure }
export declare function publishFile(collection: Context, index: u64): void throws { NativeResourceFailure }

export declare function openAst(collection: Context): void throws { NativeResourceFailure }
export declare function closeAst(collection: Context): void
export declare function nextBuiltin(collection: Context): bool
export declare function builtinName(collection: Context): string
