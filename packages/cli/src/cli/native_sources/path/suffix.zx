import bytes from "std:bytes"

export type Input = {
    path: string,
    suffix: string
}

export type Output = bool

export default function (in: Input): Output {
    const { path, suffix } = in

    return path.length >= suffix.length &&
        bytes.startsWithText(
            bytes.fromText(path),
            path.length - suffix.length,
            suffix
        )
}
