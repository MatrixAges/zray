import bytes from "std:bytes"

import { parent_path } from "../const"

export type Input = {
    path: string,
    absolute: bool,
    separator: u8
}

export type Output = bool

export default function (in: Input): Output {
    const { path, absolute, separator } = in

    if (absolute || path == parent_path) {
        return false
    }

    const width = parent_path.length
    const prefixed = bytes.startsWithText(bytes.fromText(path), 0, parent_path)

    const parent_prefix = (
        - prefixed
        - and path.length > width
        - and path[width] == separator
    )

    return !parent_prefix
}
