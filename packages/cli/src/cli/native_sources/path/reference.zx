import bytes from "std:bytes"
import { ascii_null } from "core/ascii/const"

export type Input = {
    path: string,
    absolute: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { path, absolute } = in

    if (absolute || path.length == 0) {
        return false
    }

    return bytes.indexOfScalar(bytes.fromText(path), 0, ascii_null) == null
}
