import path from "std:path"

import {
    app_name,
    cache_name,
    mac_caches,
    mac_library,
    user_cache
} from "../const"
import { Platform, Status } from "./model"

import type { Input, Output } from "./model"

export default function (in: Input): Output {
    if (in.configured != null) {
        if (!path.isAbsolute(in.configured)) {
            return {
                status: Status.InvalidZxcCacheDirectory
            }
        }

        return {
            status: Status.Ready,
            path: in.configured
        }
    }

    const xdg = match in.platform {
        Platform.Other => in.xdg,
        _ => null
    }

    const base: string? = xdg == null ? in.home : xdg

    if (base == null) {
        return {
            status: Status.MissingUserCacheDirectory
        }
    }

    if (!path.isAbsolute(base)) {
        return {
            status: Status.InvalidUserCacheDirectory
        }
    }

    const resolved = match {
        in.platform == Platform.Windows => path.join([
            base,
            app_name,
            cache_name
        ]),
        in.platform == Platform.Mac => path.join([
            base,
            mac_library,
            mac_caches,
            app_name
        ]),
        xdg == null => path.join([
            base,
            user_cache,
            app_name
        ]),
        _ => path.join([
            base,
            app_name
        ])
    }

    return {
        status: Status.Ready,
        path: resolved
    }
}
