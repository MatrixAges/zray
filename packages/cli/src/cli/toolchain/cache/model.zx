export enum Platform {
    Windows,
    Mac,
    Other
}

export enum Status {
    Ready,
    InvalidZxcCacheDirectory,
    MissingUserCacheDirectory,
    InvalidUserCacheDirectory
}

export type Input = {
    platform: Platform,
    configured?: string,
    xdg?: string,
    home?: string
}

export type Output = {
    status: Status,
    path?: string
}
