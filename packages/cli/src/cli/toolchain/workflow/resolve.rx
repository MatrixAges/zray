<Module>
    <Type from="model" as="Toolchain" />

    <Args in={Toolchain.Input} out={Toolchain.Output} />

    <If on={$in.override != null}>
        <Call
            fn="index.resolveExecutable"
            in={[
                $in.toolchain,
                $in.override
            ]}
        />

        <Call module="cache" in={$in} />

        <If on={$ctx.cache != Toolchain.Status.Ready}>
            <Return
                value={{
                    status: $ctx.cache
                }}
            />
        </If>

        <Call
            module="library"
            in={{
                toolchain: $in.toolchain,
                executable: $ctx.resolveExecutable,
                suffixes: $in.library_suffixes
            }}
        />

        <If on={$ctx.library == null}>
            <Return
                value={{
                    status: Toolchain.Status.ZxcZigLibraryNotFound
                }}
            />
        </If>

        <Return
            value={{
                status: Toolchain.Status.Ready,
                executable: $ctx.resolveExecutable,
                library: $ctx.library
            }}
        />
    </If>

    <Call module="cache" in={$in} />

    <Return
        value={{
            status: $ctx.cache
        }}
    />
</Module>
