<Module>
    <Type from="model" as="Toolchain" />

    <Args in={Toolchain.Input} out={Toolchain.Output} />

    <If on={$in.override != null}>
        <Call fn="executable" in={$in.override} />

        <If on={$ctx.executable != null}>
            <Call module="cache" in={$in} />

            <If on={$ctx.cache.status != Toolchain.Status.Ready}>
                <Return
                    value={{
                        status: $ctx.cache.status
                    }}
                />
            </If>

            <Call
                module="library"
                in={{
                    executable: $ctx.executable,
                    suffixes: $in.library_suffixes
                }}
            />

            <If on={$ctx.library == null}>
                <Return
                    value={{
                        status: Toolchain.Status.ZxcZigLibraryNotFound
                    }}
                />
            </If>

            <Return
                value={{
                    status: Toolchain.Status.Ready,
                    root: $ctx.cache.root,
                    executable: $ctx.executable,
                    library: $ctx.library
                }}
            />
        </If>

        <Return
            value={{
                status: Toolchain.Status.ZxcZigNotFound
            }}
        />
    </If>

    <Call module="cache" in={$in} />

    <Return
        value={{
            status: $ctx.cache.status,
            root: $ctx.cache.root
        }}
    />
</Module>
