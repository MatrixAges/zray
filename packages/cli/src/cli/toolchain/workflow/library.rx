<Module>
    <Type from="model" as="Toolchain" />

    <Args in={Toolchain.Probe} out={string?} />

    <Call fn="index.pathParent" in={$in.executable} />

    <If on={$ctx.pathParent != null}>
        <Call
            fn="find_library"
            in={{
                parent: $ctx.pathParent,
                suffixes: $in.suffixes
            }}
        />

        <Return value={$ctx.find_library} />
    </If>

    <Return value={null} />
</Module>
