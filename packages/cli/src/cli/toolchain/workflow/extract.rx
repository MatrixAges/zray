<Module>
    <Type from="model" as="Toolchain" />

    <Args in={Toolchain.CacheInput} out={Toolchain.Status} />

    <Call
        fn="index.createStaging"
        in={[
            $in.toolchain,
            $in.paths.staging
        ]}
    />

    <If on={$in.override == null}>
        <Call fn="index.loadZig" in={$in.toolchain} />

        <Call
            fn="hash"
            in={{
                archive: $ctx.loadZig,
                expected: $in.zig_digest
            }}
        />

        <If on={!$ctx.hash}>
            <Return value={Toolchain.Status.CorruptBundledToolchain} />
        </If>

        <If on={$in.zip}>
            <Call
                fn="index.extractZip"
                in={[
                    $in.toolchain,
                    $ctx.loadZig
                ]}
            />

            <Else>
                <Call
                    fn="index.extractTar"
                    in={[
                        $in.toolchain,
                        $ctx.loadZig
                    ]}
                />
            </Else>
        </If>

        <Call fn="index.renameZig" in={$in.toolchain} />
    </If>

    <Call module="standard" in={$in.omit(["paths"])} />

    <If on={$ctx.standard != Toolchain.Status.Ready}>
        <Return value={$ctx.standard} />
    </If>

    <Call fn="index.closeDirectory" in={$in.toolchain} />

    <Call
        module="../../workspace_files/write_artifact"
        in={{
            path: $in.paths.marker,
            source: $in.expected_marker
        }}
    />

    <Call
        fn="index.openStaging"
        in={[
            $in.toolchain,
            $in.paths.staging
        ]}
    />

    <If on={!$ctx.openStaging}>
        <Return value={Toolchain.Status.IncompleteToolchainCache} />
    </If>

    <Call fn="ready" in={$in.omit(["paths"])} />

    <If on={!$ctx.ready}>
        <Return value={Toolchain.Status.IncompleteToolchainCache} />
    </If>

    <Call fn="index.closeDirectory" in={$in.toolchain} />

    <Call
        fn="index.publish"
        in={[
            $in.toolchain,
            $in.paths.root
        ]}
    />

    <Return value={Toolchain.Status.Ready} />
</Module>
