import host from "toolchain_host"

import { official_lib, sibling_lib, system_lib } from "../const"

import type { Handle as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    if (host.probeLibrary(in, official_lib)) {
        return true
    }

    if (host.probeLibrary(in, system_lib)) {
        return true
    }

    return host.probeLibrary(in, sibling_lib)
}
