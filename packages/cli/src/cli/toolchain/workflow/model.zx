import type { Toolchain } from "toolchain_host"
import type { Input as CacheConfig } from "../cache/model"

export enum Status {
    Ready,
    IncompleteToolchainCache,
    ZxcZigNotFound,
    ZxcZigLibraryNotFound,
    CorruptBundledToolchain,
    InvalidZxcCacheDirectory,
    MissingUserCacheDirectory,
    InvalidUserCacheDirectory
}

export type LibrarySuffixes = {
    official: string,
    system: string,
    sibling: string
}

export type Input = {
    toolchain: Toolchain,
    cache_config: CacheConfig,
    override?: string,
    windows: bool,
    expected_marker: string,
    zip: bool,
    standard_archive: u8[],
    standard_digest: string,
    zig_digest: string,
    library_suffixes: LibrarySuffixes
}

export type Output = {
    status: Status,
    root?: string,
    executable?: string,
    library?: string
}

export type Probe = {
    toolchain: Toolchain,
    executable: string,
    suffixes: LibrarySuffixes
}

export type CachePaths = {
    parent: string,
    root: string,
    lock: string,
    staging: string,
    marker: string
}

export type CacheInput = Input & {
    paths: CachePaths
}

export type CacheOutput = Output.Pick("status", "root")
