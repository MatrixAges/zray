import type { Toolchain } from "toolchain_host"

export enum Status {
    Ready,
    IncompleteToolchainCache,
    ZxcZigLibraryNotFound,
    CorruptBundledToolchain
}

export type LibrarySuffixes = {
    official: string,
    system: string,
    sibling: string
}

export type Input = {
    toolchain: Toolchain,
    override?: string,
    windows: bool,
    expected_marker: string,
    zip: bool,
    standard_archive: u8[],
    standard_digest: string,
    zig_digest: string,
    library_suffixes: LibrarySuffixes
}

export type Output = {
    status: Status,
    executable?: string,
    library?: string
}

export type Probe = {
    toolchain: Toolchain,
    executable: string,
    suffixes: LibrarySuffixes
}
