import host from "toolchain_host"

import {
    standard_probe,
    windows_zig_probe,
    zig_library_probe,
    zig_probe
} from "../const"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const toolchain = in.toolchain
    const text = host.marker(toolchain)

    if (text != host.expectedMarker(toolchain)) {
        return false
    }

    if (!in.external) {
        const executable = in.windows ? windows_zig_probe : zig_probe

        if (!host.regularFile(toolchain, executable)) {
            return false
        }

        if (!host.regularFile(toolchain, zig_library_probe)) {
            return false
        }
    }

    return host.regularFile(toolchain, standard_probe)
}
