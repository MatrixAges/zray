import host from "toolchain_host"

import {
    standard_probe,
    windows_zig_probe,
    zig_library_probe,
    zig_probe
} from "../const"

import type { Readiness as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const toolchain = in.toolchain
    const text = host.marker(toolchain, in.directory)

    if (text != in.expected_marker) {
        return false
    }

    if (in.override == null) {
        const executable = in.windows ? windows_zig_probe : zig_probe

        if (!host.regularFile(toolchain, in.directory, executable)) {
            return false
        }

        if (!host.regularFile(toolchain, in.directory, zig_library_probe)) {
            return false
        }
    }

    return host.regularFile(toolchain, in.directory, standard_probe)
}
