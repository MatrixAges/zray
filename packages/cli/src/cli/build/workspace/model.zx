import type { FileSystem } from "artifact_io"
import type { TextColumn } from "memory"

export type Identity = {
    entry: string,
    abi: string,
    runner: string,
    result: string,
    configuration: string,
    graph: string
}

export type Files = {
    count: u64,
    paths: TextColumn,
    sources: TextColumn
}

export type Workspace = {
    fs: FileSystem,
    directory: string,
    separator: string
}

export type HostResources = Workspace & {
    node: Files,
    napi: Files
}

export type Input = {
    fs: FileSystem,
    separator: string,
    identity: Identity,
    views: Files,
    modules: Files
}

export type Output = {
    directory: string,
    module_paths: string[]
}

export type Artifact = {
    fs: FileSystem,
    path: string,
    source: string
}

export type Paths = Workspace.Pick("directory", "separator")

export type ViewGroup = Workspace & {
    files: Files
}

export type ViewWrite = ViewGroup & {
    index: u64
}

export type ColumnRow = {
    files: Files,
    index: u64
}

export type File = {
    path: string,
    source: string
}
