export type FileSystem = mutable_opaque

export declare function quoteJsonString(allocator, value: string): string throws {
    OutOfMemory
} concurrent

export declare function matches(fs: FileSystem, path: string, expected: string): bool throws {
    ArtifactIoFailure
}

export declare function matchesPrefix(fs: FileSystem, path: string, prefix: string): bool?
    throws { ArtifactIoFailure }

export declare function writeAtomic(fs: FileSystem, path: string, source: string): void throws {
    ArtifactIoFailure
}
