import { directory_separator as slash } from "compiler_rules/path/const"

import { native_directory, zig_extension } from "./const"

export type Input = {
    directory: string,
    name: string,
    extension?: string
}

export type Output = string

export default function (in: Input): Output {
    const { directory, name } = in

    const extension = in.extension ?? zig_extension

    return `${directory}${slash}${native_directory}${slash}${name}${extension}`
}
