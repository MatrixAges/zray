import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"

import { build_root, identity_domain } from "./const"

import type { Identity as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const { hash } = in

    crypto.resetSha256(hash)
    crypto.updateSha256(hash, bytes.fromText(identity_domain))

    const fields = [
        in.entry,
        in.abi,
        in.runner,
        in.result,
        in.configuration,
        in.graph
    ]

    return loop({
        index: 0,
        hash
    }, {
        while: current => current.index < fields.length,
        next: current => {
            const data = bytes.fromText(fields[current.index])

            crypto.updateSha256U64Le(current.hash, data.length)
            crypto.updateSha256(current.hash, data)

            current.index += 1
        },
        return: current => {
            const digest = encoding.encodeHex(crypto.digestSha256(current.hash))

            return `${build_root}/${digest}`
        }
    })
}
