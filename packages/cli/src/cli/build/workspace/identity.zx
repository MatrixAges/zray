import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"

import { build_root, identity_domain } from "./const"

import type { Identity as Input } from "./model"

export type Output = string

export default function (in: Input): Output {
    const fields = [
        in.entry,
        in.abi,
        in.runner,
        in.result,
        in.configuration,
        in.graph
    ]

    const start_index: u64 = 0

    const { parts } = loop(
        {
            index: start_index,
            parts: [
                bytes.fromText(identity_domain)
            ]
        },
        {
            while: current => current.index < fields.length,
            next: current => {
                const data = bytes.fromText(fields[current.index])

                current.parts = current.parts
                    .push(bytes.encodeU64Le(data.length))[0]
                    .push(
                        data
                    )[0]
                current.index += 1
            }
        }
    )

    const digest = encoding.encodeHex(crypto.sha256Parts(parts))

    return `${build_root}/${digest}`
}
