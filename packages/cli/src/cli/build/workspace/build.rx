<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Input} out={Workspace.Output} />

    <Call fn="identity" in={$in.identity} />

    <Call
        fn="entry"
        in={{
            fs: $in.fs,
            directory: $ctx.identity,
            separator: $in.separator,
            identity: $in.identity
        }}
    />

    <Call
        fn="views"
        in={{
            fs: $in.fs,
            directory: $ctx.identity,
            separator: $in.separator,
            files: $in.views
        }}
    />

    <Call
        fn="runner"
        in={{
            fs: $in.fs,
            directory: $ctx.identity,
            separator: $in.separator,
            identity: $in.identity
        }}
    />

    <Call
        fn="modules"
        in={{
            fs: $in.fs,
            files: $in.modules
        }}
    />

    <Return
        value={{
            directory: $ctx.identity,
            module_paths: $ctx.modules
        }}
    />
</Module>
