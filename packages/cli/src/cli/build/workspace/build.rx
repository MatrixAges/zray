<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Input} out={Workspace.Output} />

    <Call fn="identity" in={$in.identity} />

    <Call
        fn="entry"
        in={{
            directory: $ctx.identity,
            separator: $in.separator
        }}
    />

    <Call
        module="retain_file"
        in={{
            fs: $in.fs,
            path: $ctx.entry.entry,
            source: $in.identity.entry
        }}
    />

    <Call
        module="retain_file"
        in={{
            fs: $in.fs,
            path: $ctx.entry.abi,
            source: $in.identity.abi
        }}
    />

    <Call
        module="write_views"
        in={{
            fs: $in.fs,
            directory: $ctx.identity,
            separator: $in.separator,
            files: $in.views
        }}
    />

    <Call
        fn="runner"
        in={{
            directory: $ctx.identity,
            separator: $in.separator
        }}
    />

    <Call
        module="retain_file"
        in={{
            fs: $in.fs,
            path: $ctx.runner.runner,
            source: $in.identity.runner
        }}
    />

    <Call
        module="retain_file"
        in={{
            fs: $in.fs,
            path: $ctx.runner.result,
            source: $in.identity.result
        }}
    />

    <Call
        fn="modules"
        in={{
            fs: $in.fs,
            files: $in.modules
        }}
    />

    <Return
        value={{
            directory: $ctx.identity,
            module_paths: $ctx.modules
        }}
    />
</Module>
