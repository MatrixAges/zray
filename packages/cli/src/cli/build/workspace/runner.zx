import { root_source } from "../command/const"
import { result_source } from "./const"

import type { Paths as Input } from "./model"

export type Output = {
    runner: string,
    result: string
}

export default function (in: Input): Output {
    const { directory, separator } = in

    return {
        runner: `${directory}${separator}${root_source}`,
        result: `${directory}${separator}${result_source}`
    }
}
