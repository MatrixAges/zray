<Module>
    <Type from="model" as="Model" />

    <Args in={Model.ViewWrite} out={Model.ViewWrite} />

    <Call fn="views" in={$in} />

    <Call
        module="retain_file"
        in={{
            ...$ctx.views
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
