import { abi_source, application_source } from "../command/const"

import type { Paths as Input } from "./model"

export type Output = {
    entry: string,
    abi: string
}

export default function (in: Input): Output {
    const { directory, separator } = in

    return {
        entry: `${directory}${separator}${application_source}`,
        abi: `${directory}${separator}${abi_source}`
    }
}
