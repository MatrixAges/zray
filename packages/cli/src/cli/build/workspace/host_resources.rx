<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.HostResources} out={void} />

    <Call
        fn="host_directories"
        in={$in.pick([
            "directory",
            "separator"
        ])}
    />

    <Call
        module="write_views"
        in={{
            directory: $ctx.host_directories.node,
            separator: $in.separator,
            files: $in.node
        }}
    />

    <Call
        module="write_views"
        in={{
            directory: $ctx.host_directories.napi,
            separator: $in.separator,
            files: $in.napi
        }}
    />
</Module>
