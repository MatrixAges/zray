import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"

import { modules_root, zig_extension } from "./const"
import file from "./file"

import type { Artifact, ModuleWrite as Input } from "./model"

export type Output = {
    artifact: Artifact,
    next: Input
}

export default function (in: Input): Output {
    const { path: name, source } = file({
        files: in.files,
        index: in.index
    })

    const digest = encoding.encodeHex(crypto.sha256(bytes.fromText(source)))

    const path = `${modules_root}/${name}/${digest}${zig_extension}`

    return {
        artifact: {
            path,
            source
        },
        next: {
            ...in,
            index: in.index + 1,
            paths: in.paths.push(path)[0]
        }
    }
}
