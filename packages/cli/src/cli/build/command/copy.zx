import memory from "memory"

import type { StringBuffer } from "memory"

export type Input = {
    out: StringBuffer,
    at: u64,
    values: string[]
}

export type Output = u64

export default function (in: Input): Output {
    const { out, at, values } = in

    return loop(0, {
        while: index => index < values.length,
        next: index => {
            memory.writeString(out, at + index, values[index])
            index += 1
        },
        return: index => at + index
    })
}
