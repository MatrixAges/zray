import append from "./append"
import {
    cache_flag,
    global_cache_flag,
    include_flag,
    libc_flag,
    library_directory_flag,
    listen_flag,
    translate_c
} from "./const"
import pairs from "./pairs"

import type { Cache, Toolchain } from "./prefix/model"

export type Spec = Toolchain & Cache & {
    settings: string[],
    includes: string[],
    header: string
}

export type Input = {
    spec: Spec
}

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const head: string[] = [
        spec.tool,
        translate_c,
        library_directory_flag,
        spec.library,
        libc_flag,
        listen_flag,
        cache_flag,
        spec.local,
        global_cache_flag,
        spec.global
    ]

    const includes = pairs({
        flag: include_flag,
        values: spec.includes
    })

    const tail: string[] = [spec.header]

    return append([
        head,
        spec.settings,
        includes,
        tail
    ])
}
