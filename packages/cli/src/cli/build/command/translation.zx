import memory from "memory"

import {
    cache_flag,
    global_cache_flag,
    include_flag,
    libc_flag,
    library_directory_flag,
    listen_flag,
    translate_c
} from "./const"
import copy from "./copy"
import pairs from "./pairs"

import type { StringBuffer } from "memory"
import type { Cache, Toolchain } from "./prefix/model"

export type Spec = Toolchain & Cache & {
    settings: string[],
    includes: string[],
    header: string
}

export type Input = {
    out: StringBuffer,
    spec: Spec
}

export type Output = u64

export default function (in: Input): Output {
    const { out, spec } = in

    memory.writeString(out, 0, spec.tool)
    memory.writeString(out, 1, translate_c)
    memory.writeString(out, 2, library_directory_flag)
    memory.writeString(out, 3, spec.library)
    memory.writeString(out, 4, libc_flag)
    memory.writeString(out, 5, listen_flag)
    memory.writeString(out, 6, cache_flag)
    memory.writeString(out, 7, spec.local)
    memory.writeString(out, 8, global_cache_flag)
    memory.writeString(out, 9, spec.global)

    const settings = copy({
        out,
        at: 10,
        values: spec.settings
    })

    const includes = pairs({
        out,
        at: settings,
        flag: include_flag,
        values: spec.includes
    })

    memory.writeString(out, includes, spec.header)

    return includes + 1
}
