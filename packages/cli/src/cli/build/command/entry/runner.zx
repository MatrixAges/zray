import memory from "memory"

import {
    application_module,
    dependency_flag,
    module_prefix,
    napi_module,
    root_module,
    root_source
} from "../const"
import copy from "../copy"

import type { Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { out, spec } = in

    const base = copy({
        out,
        at: 0,
        values: spec.settings
    })

    if (spec.node) {
        memory.writeString(out, base, dependency_flag)
        memory.writeString(out, base + 1, napi_module)
    }

    const after_node = spec.node ? base + 2 : base
    const state = spec.state

    if (state != null) {
        memory.writeString(out, after_node, dependency_flag)
        memory.writeString(out, after_node + 1, state)
    }

    const next = state == null ? after_node : after_node + 2
    const directory = spec.directory

    memory.writeString(out, next, dependency_flag)
    memory.writeString(out, next + 1, application_module)

    memory.writeString(
        out,
        next + 2,
        `${module_prefix}${root_module}=${directory}/${root_source}`
    )

    return next + 3
}
