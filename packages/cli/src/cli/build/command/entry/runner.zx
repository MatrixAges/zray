import append from "../append"
import {
    application_module,
    dependency_flag,
    module_prefix,
    napi_module,
    root_module,
    root_source
} from "../const"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const node_args: string[] = match {
        spec.node => [
            dependency_flag,
            napi_module
        ],
        _ => []
    }

    const state = spec.state

    const state_args: string[] = match {
        state == null => [],
        _ => [
            dependency_flag,
            state
        ]
    }

    const tail: string[] = [
        dependency_flag,
        application_module,
        `${module_prefix}${root_module}=${spec.directory}/${root_source}`
    ]

    return append([
        spec.settings,
        node_args,
        state_args,
        tail
    ])
}
