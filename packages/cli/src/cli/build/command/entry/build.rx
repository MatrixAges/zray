<Module>
    <Type from="model" as="Entry" />

    <Args in={Entry.Input} out={string[]} />

    <Call fn="runner" in={$in} />
    <Call fn="application" in={$in} />

    <Call
        fn="../append"
        in={[
            $ctx.runner,
            $ctx.application
        ]}
    />

    <Return value={$ctx.append} />
</Module>
