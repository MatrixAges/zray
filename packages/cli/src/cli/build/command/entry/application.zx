import append from "../append"
import {
    abi_module,
    application_module,
    application_source,
    dependency_flag,
    module_prefix
} from "../const"
import pairs from "../pairs"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const head: string[] = [
        dependency_flag,
        abi_module
    ]

    const imports = pairs({
        flag: dependency_flag,
        values: spec.imports
    })

    const natives = pairs({
        flag: dependency_flag,
        values: spec.natives
    })

    const tail: string[] = [
        `${module_prefix}${application_module}=${spec.directory}/${application_source}`
    ]

    return append([
        spec.settings,
        head,
        imports,
        natives,
        tail
    ])
}
