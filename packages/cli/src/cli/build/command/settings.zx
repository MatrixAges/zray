import { cpu_flag, optimize_flag, target_flag } from "./const"

export type Spec = {
    optimize: string,
    target?: string,
    cpu?: string
}

export type Input = {
    spec: Spec
}

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const base: string[] = [
        optimize_flag,
        spec.optimize
    ]

    const with_target: string[] = match {
        spec.target == null => base,
        _ => base.push(target_flag)[0].push(spec.target)[0]
    }

    if (spec.cpu == null) {
        return with_target
    }

    return with_target.push(cpu_flag)[0].push(spec.cpu)[0]
}
