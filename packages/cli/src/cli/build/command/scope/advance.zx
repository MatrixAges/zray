import memory from "memory"

import type { U64Buffer } from "memory"

export type Input = {
    cursor: U64Buffer,
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const next = memory.readU64(in.cursor, 0) + 1

    memory.writeU64(in.cursor, 0, next)

    return next < in.count
}
