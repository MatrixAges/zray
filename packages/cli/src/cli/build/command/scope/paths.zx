import resolvePathParts from "../../standard/path/resolve"

export type Input = {
    root: string,
    paths: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const empty: string[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < in.paths.length,
        next: state => {
            const path = resolvePathParts([
                in.root,
                in.paths[state.row]
            ])

            state.out = state.out.push(path)[0]
            state.row += 1
        },
        return: state => state.out
    })
}
