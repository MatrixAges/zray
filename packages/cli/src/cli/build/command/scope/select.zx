import locate from "./locate"

import type { Setup } from "./model"

export type Input = {
    setup: Setup,
    name: string
}

export type Output = u64?

export default function (in: Input): Output {
    const { setup, name } = in
    const { settings } = setup

    return locate({
        count: settings.count,
        names: settings.names,
        name,
        last: false
    })
}
