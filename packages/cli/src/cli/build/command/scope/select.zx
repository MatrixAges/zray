import memory from "memory"

import type { Selection as Input, Output } from "./model"

export default function (in: Input): Output {
    const { index, explicit } = in

    if (index == null) {
        return {
            root: in.default_root,
            paths: explicit ?? in.default_paths
        }
    }

    const resolved = match {
        explicit == null => memory.readTextListColumn(in.includes, index),
        _ => explicit
    }

    return {
        root: memory.readTextColumn(in.roots, index),
        paths: resolved
    }
}
