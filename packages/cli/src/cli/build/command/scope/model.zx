import type { Allocator, ReadColumn, TextColumn } from "memory"
import type { Input as Locator } from "./locate"

export type Columns = Locator.Omit("last", "name") & {
    roots: TextColumn,
    includes: ReadColumn
}

export type Setup = {
    owner: Allocator,
    root: string,
    includes: string[],
    libraries: string[],
    settings: Columns
}

export type Selection = {
    setup: Setup,
    index?: u64,
    explicit?: string[]
}

export type Views = {
    names: TextColumn,
    targets: TextColumn,
    count: u64
}
