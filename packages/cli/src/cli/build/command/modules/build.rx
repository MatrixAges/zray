<Module>
    <Type from="model" as="ModuleCommand" />

    <Args in={ModuleCommand.Input} out={string[]} />

    <Call fn="abi" in={$in} />
    <Call fn="imports" in={$in} />
    <Call fn="define" in={$in} />

    <Call
        fn="../append"
        in={[
            $in.spec.settings,
            $ctx.abi,
            $ctx.imports,
            $ctx.define
        ]}
    />

    <Return value={$ctx.append} />
</Module>
