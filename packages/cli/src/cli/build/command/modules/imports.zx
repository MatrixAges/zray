import append from "../append"
import { dependency_flag, include_flag } from "../const"
import pairs from "../pairs"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const imports = pairs({
        flag: dependency_flag,
        values: spec.imports
    })

    const includes = pairs({
        flag: include_flag,
        values: spec.includes
    })

    return append([
        imports,
        includes
    ])
}
