import { abi_module, dependency_flag } from "../const"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    if (!spec.canonical) {
        return []
    }

    const view = spec.abi

    const binding = match {
        view == null => abi_module,
        _ => `${abi_module}=${view}`
    }

    return [
        dependency_flag,
        binding
    ]
}
