import append from "../append"
import {
    dependency_flag,
    module_prefix,
    translation_dependency,
    translation_prefix
} from "../const"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in
    const { name, path, translated } = spec

    const definition = `${module_prefix}${name}=${path}`

    if (translated == null) {
        return [definition]
    }

    const translated_name = `${translation_prefix}${name}`

    const head: string[] = [
        dependency_flag,
        `${translation_dependency}${translated_name}`,
        definition
    ]

    const tail: string[] = [`${module_prefix}${translated_name}=${translated}`]

    return append([
        head,
        spec.settings,
        tail
    ])
}
