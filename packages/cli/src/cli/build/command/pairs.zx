export type Input = {
    flag: string,
    values: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { flag, values } = in

    const empty: string[] = []

    return loop({
        index: 0,
        out: empty
    }, {
        while: current => current.index < values.length,
        next: current => {
            const with_flag = current.out.push(flag)[0]

            current.out = with_flag.push(values[current.index])[0]
            current.index += 1
        },
        return: current => current.out
    })
}
