import {
    assembly_flag,
    build_root_flag,
    cache_flag,
    global_cache_flag,
    listen_flag,
    name_flag
} from "../const"

import type { Server } from "./model"

export type Input = {
    server: Server
}

export type Output = string[]

export default function (in: Input): Output {
    const { server } = in

    const base: string[] = [
        listen_flag,
        name_flag,
        server.name,
        build_root_flag,
        server.root,
        cache_flag,
        server.local,
        global_cache_flag,
        server.global
    ]

    if (server.assembly) {
        return base.push(assembly_flag)[0]
    }

    return base
}
