import append from "../append"
import { libc_flag, library_path_flag, library_prefix } from "../const"
import pairs from "../pairs"

export type Input = {
    libraries: string[],
    paths: string[],
    libc: bool
}

export type Output = string[]

export default function (in: Input): Output {
    const { libraries } = in

    const empty: string[] = []

    const lib_flags = loop({
        index: 0,
        out: empty
    }, {
        while: state => state.index < libraries.length,
        next: state => {
            state.out =
                state.out.push(`${library_prefix}${libraries[state.index]}`)[0]
            state.index += 1
        },
        return: state => state.out
    })

    const linked = pairs({
        flag: library_path_flag,
        values: in.paths
    })

    const combined = append([
        lib_flags,
        linked
    ])

    if (!in.libc) {
        return combined
    }

    return combined.push(libc_flag)[0]
}
