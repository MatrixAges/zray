import { assembly_prefix, binary_prefix } from "../const"

import type { Files } from "./model"

export type Input = {
    files: Files
}

export type Output = string[]

export default function (in: Input): Output {
    const { files } = in

    const assembly = files.assembly
    const base: string[] = [`${binary_prefix}${files.binary}`]

    if (assembly != null) {
        return base.push(`${assembly_prefix}${assembly}`)[0]
    }

    return base
}
