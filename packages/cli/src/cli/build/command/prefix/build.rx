<Module>
    <Type from="model" as="Prefix" />

    <Args in={Prefix.Input} out={string[]} />

    <Call fn="start" in={$in} />

    <Call module="destination" in={$in} />

    <Call
        fn="link"
        in={{
            libraries: $in.spec.libraries,
            paths: $in.spec.library_paths,
            libc: $in.spec.libc
        }}
    />

    <Call
        fn="../append"
        in={[
            $ctx.start,
            $ctx.destination,
            $ctx.link
        ]}
    />

    <Return value={$ctx.append} />
</Module>
