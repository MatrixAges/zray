<Module>
    <Type from="model" as="Prefix" />

    <Args in={Prefix.Input} out={string[]} />

    <If on={$in.spec.server != null}>
        <Call
            fn="listen"
            in={{
                server: $in.spec.server
            }}
        />

        <Return value={$ctx.listen} />
    </If>

    <If on={$in.spec.files != null}>
        <Call
            fn="output"
            in={{
                files: $in.spec.files
            }}
        />

        <Return value={$ctx.output} />
    </If>

    <Return value={[]} />
</Module>
