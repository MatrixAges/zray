import {
    allow_undefined_flag,
    build_executable,
    build_library,
    dynamic_flag,
    dynamic_symbols_flag,
    export_memory_flag,
    library_directory_flag,
    no_entry_flag
} from "../const"

import type { Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { spec } = in

    const command = spec.node ? build_library : build_executable

    const base: string[] = [
        spec.tool,
        command,
        library_directory_flag,
        spec.library
    ]

    if (spec.node) {
        return base.push(dynamic_flag)[0].push(
            spec.node_library ?? allow_undefined_flag
        )[0]
    }

    if (spec.wasm) {
        return base.push(no_entry_flag)[0].push(export_memory_flag)[0].push(
            dynamic_symbols_flag
        )[0]
    }

    return base
}
