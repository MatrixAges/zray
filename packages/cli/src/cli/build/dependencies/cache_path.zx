import encoding from "std:encoding"

import { cached_objects, zig_extension } from "./const"

export type Input = {
    digest: u8[],
    stem?: string,
    separator: string
}

export type Output = string

export default function (in: Input): Output {
    const { separator, stem } = in

    const hash = encoding.encodeHex(in.digest)

    if (stem != null) {
        return `${cached_objects}/${hash}/${stem}${zig_extension}`
    }

    return `${cached_objects}${separator}${hash}`
}
