import { directory_separator as slash } from "compiler_rules/path/const"

import { cached_objects, zig_extension } from "./const"

export type Input = {
    root: string,
    hash: string,
    stem: string
}

export type Output = string

export default function (in: Input): Output {
    const { root, hash, stem } = in

    return `${root}${slash}${cached_objects}${slash}${hash}${slash}${stem}${zig_extension}`
}
