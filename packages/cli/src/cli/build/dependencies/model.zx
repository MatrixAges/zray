import type { ReadColumn, TextColumn } from "memory"
import type { Registration } from "snapshot_host"

export type Roots = {
    cwd: string,
    library: string,
    local: string,
    global: string
}

export type Batch = {
    paths: TextColumn,
    prefixes: ReadColumn,
    count: u64,
    complete: bool
}

export type Input = {
    registration: Registration,
    roots: Roots,
    batches: Batch[]
}

export type Output = {
    complete: bool,
    new_inputs: bool,
    paths: string[]
}

export type BatchWalk = Input & {
    index: u64,
    new_inputs: bool,
    paths: string[]
}

export type RowWalk = Input.Omit("batches") & {
    batch: Batch,
    row: u64,
    new_inputs: bool,
    paths: string[]
}
