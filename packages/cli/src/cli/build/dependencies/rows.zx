import { resolvePathParts } from "lexical_path"
import memory from "memory"

import { prefix_zig_lib, prefix_local_cache, prefix_global_cache } from "./const"

import type { RowWalk } from "./model"

export type Input = RowWalk.Pick("batch", "roots", "row", "paths")

export type Output = {
    path: string,
    paths: string[]
}

export default function (in: Input): Output {
    const { batch, roots, row } = in

    const prefix = memory.readColumnU8(batch.prefixes, row)

    const root = match prefix {
        prefix_zig_lib => roots.library,
        prefix_local_cache => roots.local,
        prefix_global_cache => roots.global,
        _ => roots.cwd
    }

    const path = resolvePathParts([
        root,
        memory.readTextColumn(batch.paths, row)
    ])

    return {
        path,
        paths: in.paths.push(path)[0]
    }
}
