import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { batches } = in

    return loop({
        index: 0,
        complete: true
    }, {
        while: state => state.complete && state.index < batches.length,
        next: state => {
            const batch = batches[state.index]

            state.complete = batch.complete
            state.index += 1
        },
        return: state => state.complete
    })
}
