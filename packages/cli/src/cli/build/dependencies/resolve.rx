<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.Input} out={Backend.Output} />

    <Call fn="scan" in={$in} />

    <Loop on={$in.index < $in.batches.length}>
        <Call
            module="register_batch"
            in={{
                ...$in,
                index: 0,
                new_inputs: false,
                paths: []
            }}
        />
    </Loop>

    <Return
        value={{
            complete: $ctx.scan,
            new_inputs: $ctx.register_batch.new_inputs,
            paths: $ctx.register_batch.paths
        }}
    />
</Module>
