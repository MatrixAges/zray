import bytes from "std:bytes"
import encoding from "std:encoding"

import { rx_suffix } from "./const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const length = in.length
    const width = rx_suffix.length

    if (length < width) {
        return false
    }

    const suffix = encoding.sliceBytes(in, length - width, length)

    return bytes.equals(bytes.fromText(suffix), bytes.fromText(rx_suffix))
}
