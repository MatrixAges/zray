import type { Template } from "source_loader_host"

export type Input = {
    source: Template,
    root: string,
    path: string,
    count: u64
}

export type Row = [Template, string, u64]

export type Walk = {
    source: Template,
    owner: string,
    count: u64,
    index: u64,
    running: bool
}

export type Loaded = {
    paths: string[]
}

export type AdmitInput = {
    loaded: Loaded,
    path: string
}
