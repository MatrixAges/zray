import { templateReferenceCount } from "source_loader_host"

import load from "./load.rx"

import type { Template as Input } from "source_loader_host"

export type Output = void

export default function (in: Input): Output {
    const count = templateReferenceCount(in)

    const loaded = loop(0, {
        while: index => index < count,
        next: index => {
            load([
                in,
                index
            ])

            index += 1
        }
    })
}
