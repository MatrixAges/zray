<Module>
    <Type from="model" as="Template" />

    <Args in={Template.Row} out={void} />

    <Store from="seen" as="seen" />

    <Call fn="index.resolveTemplateReference" in={$in} />

    <If on={$ctx.resolveTemplateReference != null}>
        <Call
            fn="admit_path"
            in={{
                loaded: store.seen.loaded,
                path: $ctx.resolveTemplateReference
            }}
            setter={[store.seen.loaded]}
        />

        <If on={$ctx.admit_path}>
            <Call
                fn="index.readTemplateFile"
                in={[
                    $in[0],
                    $ctx.resolveTemplateReference
                ]}
            />
        </If>
    </If>
</Module>
