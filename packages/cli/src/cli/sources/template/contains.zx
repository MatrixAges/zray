import bytes from "std:bytes"
import { templateFileCount, templateFilePath } from "source_loader_host"

import type { File as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { template, path } = in

    const count = templateFileCount(template)
    const wanted = bytes.fromText(path)

    return loop({
        index: 0,
        found: false
    }, {
        while: current => current.index < count && !current.found,
        next: current => {
            const existing = templateFilePath(template, current.index)

            current.found = bytes.equals(bytes.fromText(existing), wanted)
            current.index += 1
        },
        return: current => current.found
    })
}
