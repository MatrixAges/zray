<Module>
    <Type from="model" as="Template" />

    <Args in={Template.Input} out={void} />

    <Store from="seen" as="seen" />

    <Call
        fn="index.resolveOwner"
        in={[
            $in.root,
            $in.path
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="references"
            in={{
                source: $in.source,
                owner: $ctx.resolveOwner,
                count: $in.count,
                index: 0,
                running: true
            }}
        />
    </Loop>

    <Call fn="index.expandSourceTemplate" in={$in.source} />
</Module>
