<Module>
    <Type from="index" as="Template" />

    <Args in={Template.Input} out={void} />

    <Call fn="index.templateReferenceCount" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="references"
            in={{
                source: $in,
                count: $ctx.templateReferenceCount,
                index: 0,
                running: $ctx.templateReferenceCount != 0
            }}
        />
    </Loop>

    <Call fn="index.expandSourceTemplate" in={$in} />
</Module>
