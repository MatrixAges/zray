<Module>
    <Type from="model" as="State" />

    <Args in={State.SourceRow} out={void} />

    <Call
        fn="index.prepareSource"
        in={[
            $in.discovery,
            $in.row
        ]}
    />

    <Call
        fn="index.openHeader"
        in={[
            $in.discovery,
            $in.row
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="load_import"
            in={{
                discovery: $in.discovery,
                count: $ctx.openHeader,
                index: 0,
                running: $ctx.openHeader != 0
            }}
        />
    </Loop>

    <Call fn="index.closeHeader" in={$in.discovery} />
</Module>
