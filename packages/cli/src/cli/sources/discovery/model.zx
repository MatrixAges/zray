import type { Discovery } from "source_loader_host"

export type Range = {
    discovery: Discovery,
    first: u64
}

export type SourceRow = {
    discovery: Discovery,
    row: u64
}

export type Header = {
    discovery: Discovery,
    count: u64,
    index: u64,
    running: bool
}

export type Walk = Range.Omit("first") & {
    index: u64,
    running: bool
}
