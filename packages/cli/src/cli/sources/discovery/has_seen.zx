import bytes from "std:bytes"

import type { HasSeenInput as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const wanted = bytes.fromText(in.path)

    return loop(0, {
        while: i =>
            i < in.paths.length &&
            !bytes.equals(bytes.fromText(in.paths[i]), wanted),
        next: i => {
            i += 1
        },
        return: i => i < in.paths.length
    })
}
