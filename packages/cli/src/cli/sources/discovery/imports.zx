import load from "./load_import.rx"

import type { Header as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { discovery, count } = in

    const loaded = loop(0, {
        while: index => index < count,
        next: index => {
            load([
                discovery,
                index
            ])

            index += 1
        }
    })
}
