<Module>
    <Type from="model" as="State" />

    <Args in={State.Walk} out={State.Walk} />

    <Call fn="index.sourceCount" in={$in.discovery} />

    <If on={$in.index >= $ctx.sourceCount}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />
    </If>

    <Call
        module="source"
        in={{
            discovery: $in.discovery,
            row: $in.index
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
