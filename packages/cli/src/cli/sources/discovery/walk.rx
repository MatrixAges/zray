<Module>
    <Type from="model" as="State" />

    <Args in={State.Walk} out={State.Walk} />

    <Store from="seen" as="seen" />

    <Call
        fn="has_row"
        in={{
            paths: $store.seen.state.paths,
            row: $in.index
        }}
    />

    <If on={!$ctx.has_row}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />
    </If>

    <Call
        module="source"
        in={{
            discovery: $in.discovery,
            row: $in.index
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
