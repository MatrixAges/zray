<Module>
    <Type from="model" as="State" />

    <Args in={State.RootInput} out={void} />

    <Store from="seen" as="seen" />

    <Call fn="index.registerRoot" in={$in.discovery} />

    <Call
        fn="record_seen"
        in={{
            state: $store.seen.state,
            path: $in.path
        }}
        setter={[$store.seen.state]}
    />

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                discovery: $in.discovery,
                index: $ctx.registerRoot,
                running: true
            }}
        />
    </Loop>
</Module>
