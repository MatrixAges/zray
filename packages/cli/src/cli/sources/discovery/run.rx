<Module>
    <Type from="index" as="Discovery" />

    <Args in={Discovery.Input} out={void} />

    <Call fn="index.registerRoot" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                discovery: $in,
                index: $ctx.registerRoot,
                running: true
            }}
        />
    </Loop>
</Module>
