import integer from "std:integer"

import {
    max_expanded,
    message_notes,
    message_text,
    message_words,
    word_range
} from "./const"
import { Status } from "./model"
import validString from "./string"

import type { Node as Input } from "./model"

export type Output = Status

export default function (in: Input): Output {
    const { words, strings, key } = in

    if (key > words.length || message_words > words.length - key) {
        return Status.InvalidBackendProtocol
    }

    const start = key + message_words
    const count = integer.widen(words[key + message_notes])

    if (start >= word_range || count > words.length - start) {
        return Status.InvalidBackendProtocol
    }

    if (!validString({
        strings,
        index: integer.widen(words[key + message_text])
    })) {
        return Status.InvalidBackendProtocol
    }

    if (count > max_expanded) {
        return Status.BackendDiagnosticsTooComplex
    }

    return Status.Valid
}
