import integer from "std:integer"
import host from "backend_diagnostics"

import {
    max_expanded,
    message_notes,
    message_source,
    message_text,
    message_words,
    source_key,
    word_range
} from "./const"
import { Status } from "./model"
import validString from "./string"

import type { Node as Input } from "./model"

export type Output = Status

export default function (in: Input): Output {
    const { graph, words, strings, key } = in

    if (key > words.length || message_words > words.length - key) {
        return Status.InvalidBackendProtocol
    }

    const start = key + message_words
    const count = integer.widen(words[key + message_notes])

    if (start >= word_range || count > words.length - start) {
        return Status.InvalidBackendProtocol
    }

    if (!validString({
        strings,
        index: integer.widen(words[key + message_text])
    })) {
        return Status.InvalidBackendProtocol
    }

    if (count > max_expanded) {
        return Status.BackendDiagnosticsTooComplex
    }

    const source = words[key + message_source]

    if (source != 0) {
        host.appendChild(graph, source_key + integer.widen(source))
    }

    const appended = loop({
        at: start
    }, {
        while: state => state.at < start + count,
        next: state => {
            host.appendChild(graph, integer.widen(words[state.at]))

            state.at += 1
        }
    })

    return Status.Valid
}
