import integer from "std:integer"
import { readU64U32Entry } from "memory/maps"

import { max_expanded, metric_stride, root_length, root_start } from "./const"
import { Status } from "./model"

import type { Root as Input } from "./model"

export type Output = Status

export default function (in: Input): Output {
    const { metrics, words } = in

    const start = integer.widen(words[root_start])
    const end = start + integer.widen(words[root_length])

    return loop({
        at: start,
        sum: 0,
        overflow: false
    }, {
        while: state => !state.overflow && state.at < end,
        next: state => {
            const key = integer.widen(words[state.at])
            const metric = readU64U32Entry(metrics, key)

            const expanded = integer.widen(metric) % metric_stride

            if (expanded > max_expanded - state.sum) {
                state.overflow = true
            } else {
                state.sum += expanded
            }

            state.at += 1
        },
        return: state => match {
            state.overflow => Status.BackendDiagnosticsTooComplex,
            _ => Status.Valid
        }
    })
}
