import type { U64U32Map } from "memory/maps"

export enum Status {
    Valid,
    InvalidBackendProtocol,
    BackendDiagnosticsTooComplex
}

export type Input = {
    metrics: U64U32Map,
    words: u32[],
    strings: u8[]
}

export type Node = Input & {
    key: u64
}

export type Root = Input.Omit("strings")

export type Children = {
    first: u64,
    count: u64,
    traces: bool,
    source?: u64
}
