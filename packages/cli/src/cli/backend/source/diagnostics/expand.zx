import integer from "std:integer"
import { readU64U32Entry } from "memory/maps"

import child from "./child"
import layout from "./children"
import { max_depth, max_expanded, metric_stride, visiting } from "./const"

import type { Node } from "./model"

export type Input = Node.Omit("strings")

export type Output = u32?

export default function (in: Input): Output {
    const { metrics, words, key } = in

    const children = layout({
        words,
        key
    })

    const source = children.source

    const inherited = match {
        source != null => readU64U32Entry(metrics, source),
        _ => visiting
    }

    const first = integer.widen(inherited)
    const initial = first % metric_stride

    const record = loop({
        index: 0,
        height: first / metric_stride + 1,
        expanded: initial + 1,
        overflow: initial >= max_expanded
    }, {
        while: state => !state.overflow && state.index < children.count,
        next: state => {
            const next = child({
                words,
                children,
                index: state.index
            })

            if (next != null) {
                const metric = integer.widen(readU64U32Entry(metrics, next))

                const expanded = metric % metric_stride
                const height = metric / metric_stride + 1

                if (height > state.height) {
                    state.height = height
                }

                if (expanded > max_expanded - state.expanded) {
                    state.overflow = true
                } else {
                    state.expanded += expanded
                }
            }

            state.index += 1
        }
    })

    return match {
        record.overflow => null,
        record.height > max_depth => null,
        _ => integer.narrow(record.height * metric_stride + record.expanded)
    }
}
