import bytes from "std:bytes"
import encoding from "std:encoding"

import { cached_flag } from "./const"

export type Input = {
    body: string,
    size: u64,
    seen: bool
}

export type Digest = {
    bytes: string,
    cached: bool
}

export type Output = Digest?

export default function (in: Input): Output {
    const data = bytes.fromText(in.body)

    if (in.seen || data.length != 1 + in.size) {
        return null
    }

    if (data[0] > cached_flag) {
        return null
    }

    return {
        bytes: encoding.sliceBytes(in.body, 1, data.length),
        cached: data[0] == cached_flag
    }
}
