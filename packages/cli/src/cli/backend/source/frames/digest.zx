import bytes from "std:bytes"

import { cached_flag } from "./const"

export type Input = {
    body: string,
    size: u64,
    seen: bool
}

export type Output = bool?

export default function (in: Input): Output {
    const data = bytes.fromText(in.body)

    if (in.seen || data.length != 1 + in.size) {
        return null
    }

    if (data[0] > cached_flag) {
        return null
    }

    return data[0] == cached_flag
}
