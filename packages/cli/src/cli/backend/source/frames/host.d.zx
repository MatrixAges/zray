export type Response = opaque

export declare function commitInputs(response: Response, body: string, layout: u64?): void
export declare function commitDigest(response: Response, body: string, cached: bool?): void
export declare function commitDiagnostics(response: Response, body: string): void throws {
    BackendProtocolFailure
}
export declare function hasDiagnostics(response: Response): bool
export declare function hasInputs(response: Response): bool
export declare function inputLayout(response: Response): u64
export declare function selectedInputBytes(response: Response): string
export declare function reserveInputs(response: Response, count: u64, length: u64): void
    throws { BackendProtocolFailure }
export declare function writeInput(
    response: Response,
    row: u64,
    prefix: u8,
    offset: u64,
    spelling: string
): void
