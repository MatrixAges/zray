<Module>
    <Type from="model" as="Protocol" />

    <Args in={Protocol.Input} out={Protocol.Status} />

    <Call
        module="step"
        while="running"
        in={{
            ...$in,
            offset: 0,
            status: Protocol.Status.Success,
            saw_version: false,
            saw_digest: false,
            finished: false,
            running: $in.bytes.length != 0
        }}
    />

    <If on={$ctx.step.status != Protocol.Status.Success}>
        <Return value={$ctx.step.status} />
    </If>

    <If on={!$ctx.step.saw_version || !$ctx.step.finished}>
        <Return value={Protocol.Status.IncompleteBackendResponse} />
    </If>

    <Return
        value={$ctx.step.saw_digest ? Protocol.Status.SuccessWithDigest :
            Protocol.Status.Success}
    />
</Module>
