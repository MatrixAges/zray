<Module>
    <Type from="model" as="Protocol" />

    <Args in={Protocol.Input} out={Protocol.FrameResult} />

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                ...$in,
                offset: 0,
                status: Protocol.Status.Success,
                selection: {
                    cached: false
                },
                saw_version: false,
                finished: false,
                running: $in.bytes.length != 0
            }}
        />
    </Loop>

    <If on={$ctx.step.status != Protocol.Status.Success}>
        <Return
            value={$ctx.step.pick([
                "status",
                "selection"
            ])}
        />
    </If>

    <If on={!$ctx.step.saw_version || !$ctx.step.finished}>
        <Return
            value={{
                status: Protocol.Status.IncompleteBackendResponse,
                selection: $ctx.step.selection
            }}
        />
    </If>

    <Return
        value={$ctx.step.pick([
            "status",
            "selection"
        ])}
    />
</Module>
