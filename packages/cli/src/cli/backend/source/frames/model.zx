import type { DiagnosticBundle } from "backend_frames"

export enum Status {
    Success,
    SuccessWithInputs,
    BackendFailed,
    InvalidBackendProtocol,
    BackendVersionMismatch,
    IncompleteBackendResponse
}

export enum Tag {
    Version,
    Config,
    Inputs,
    Digest,
    Diagnostics,
    Invalid
}

export type Input = {
    bytes: string,
    version: string,
    config_size: u64,
    digest_size: u64,
    translation: bool,
    exited: bool
}

export type Layout = {
    body: string,
    count: u64,
    length: u64
}

export type Selection = {
    inputs?: Layout,
    digest?: string,
    cached: bool,
    diagnostics?: DiagnosticBundle
}

export type Frame = Input.Pick("version", "config_size", "digest_size") & {
    tag: Tag,
    body: string,
    size: u64,
    saw_version: bool,
    selection: Selection
}

export type FrameResult = {
    status: Status,
    selection: Selection
}

export type Reader = Input & FrameResult & {
    offset: u64,
    saw_version: bool,
    finished: bool,
    running: bool
}

export type InputPath = {
    kind: u8,
    path: string
}

export type Paths = {
    rows: InputPath[],
    length: u64
}

export type Output = {
    status: Status,
    paths: Paths,
    digest?: string,
    cached: bool,
    diagnostics?: DiagnosticBundle
}
