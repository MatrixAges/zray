<Module>
    <Type from="model" as="Protocol" />
    <Type from="../diagnostics/model" as="Diagnostics" />

    <Args in={Protocol.Frame} out={Protocol.FrameResult} />

    <If on={!$in.saw_version && $in.tag != Protocol.Tag.Version}>
        <Return
            value={{
                status: Protocol.Status.InvalidBackendProtocol,
                selection: $in.selection
            }}
        />
    </If>

    <Switch on={$in.tag}>
        <Case value={Protocol.Tag.Version}>
            <If on={$in.saw_version}>
                <Return
                    value={{
                        status: Protocol.Status.InvalidBackendProtocol,
                        selection: $in.selection
                    }}
                />
            </If>

            <If on={$in.body != $in.version}>
                <Return
                    value={{
                        status: Protocol.Status.BackendVersionMismatch,
                        selection: $in.selection
                    }}
                />
            </If>
        </Case>

        <Case value={Protocol.Tag.Config}>
            <If on={$in.size != $in.config_size}>
                <Return
                    value={{
                        status: Protocol.Status.InvalidBackendProtocol,
                        selection: $in.selection
                    }}
                />
            </If>
        </Case>

        <Case value={Protocol.Tag.Inputs}>
            <Call fn="paths" in={$in.body} />

            <If on={$ctx.paths != null}>
                <Return
                    value={{
                        status: Protocol.Status.Success,
                        selection: {
                            ...$in.selection,
                            inputs: $ctx.paths
                        }
                    }}
                />
            </If>

            <Return
                value={{
                    status: Protocol.Status.InvalidBackendProtocol,
                    selection: $in.selection
                }}
            />
        </Case>

        <Case value={Protocol.Tag.Digest}>
            <Call
                fn="digest"
                in={{
                    body: $in.body,
                    size: $in.digest_size,
                    seen: $in.selection.digest != null
                }}
            />

            <If on={$ctx.digest != null}>
                <Return
                    value={{
                        status: Protocol.Status.Success,
                        selection: {
                            ...$in.selection,
                            digest: $ctx.digest.bytes,
                            cached: $ctx.digest.cached
                        }
                    }}
                />
            </If>

            <Return
                value={{
                    status: Protocol.Status.InvalidBackendProtocol,
                    selection: $in.selection
                }}
            />
        </Case>

        <Case value={Protocol.Tag.Diagnostics}>
            <Call fn="bundle" in={$in.body} />

            <If on={$ctx.bundle != null}>
                <Call
                    module="../diagnostics/validate"
                    in={{
                        words: $ctx.bundle.words,
                        strings: $ctx.bundle.strings,
                        metrics: $in.metrics
                    }}
                />

                <If on={$ctx.validate != Diagnostics.Status.Valid}>
                    <If
                        on={$ctx.validate ==
                            Diagnostics.Status.BackendDiagnosticsTooComplex}
                    >
                        <Return
                            value={{
                                status: Protocol.Status.BackendDiagnosticsTooComplex,
                                selection: $in.selection
                            }}
                        />
                    </If>

                    <Return
                        value={{
                            status: Protocol.Status.InvalidBackendProtocol,
                            selection: $in.selection
                        }}
                    />
                </If>

                <Return
                    value={{
                        status: Protocol.Status.Success,
                        selection: {
                            ...$in.selection,
                            diagnostics: $ctx.bundle
                        }
                    }}
                />
            </If>

            <Return
                value={{
                    status: Protocol.Status.InvalidBackendProtocol,
                    selection: $in.selection
                }}
            />
        </Case>

        <Case value={Protocol.Tag.Invalid}>
            <Return
                value={{
                    status: Protocol.Status.InvalidBackendProtocol,
                    selection: $in.selection
                }}
            />
        </Case>
    </Switch>

    <Return
        value={{
            status: Protocol.Status.Success,
            selection: $in.selection
        }}
    />
</Module>
