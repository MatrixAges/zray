import bytes from "std:bytes"
import encoding from "std:encoding"
import integer from "std:integer"

import type { InputCursor as Input, InputRow as Output } from "./model"

export default function (in: Input): Output {
    const data = bytes.fromText(in.body)

    const start = loop(in.at, {
        while: at => data[at] == 0,
        next: at => {
            at += 1
        }
    })

    const first = start + 1
    const end = bytes.indexOfScalar(data, first, 0) ?? data.length
    const prefix = data[start]

    return {
        kind: integer.narrowByte(integer.widenByte(prefix) - 1),
        path: encoding.sliceBytes(in.body, first, end),
        next: end + 1
    }
}
