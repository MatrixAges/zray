import bytes from "std:bytes"
import encoding from "std:encoding"
import integer from "std:integer"

import type { InputPath, Layout, Paths as Output } from "./model"

export type Input = Layout?

export default function (in: Input): Output {
    const rows: InputPath[] = []

    if (in == null) {
        return {
            rows,
            length: 0
        }
    }

    const { body, count, length } = in

    const data = bytes.fromText(body)

    return loop({
        at: 0,
        rows
    }, {
        while: state => state.rows.length < count,
        next: state => {
            const start = loop(state.at, {
                while: at => data[at] == 0,
                next: at => {
                    at += 1
                }
            })

            const first = start + 1
            const end = bytes.indexOfScalar(data, first, 0) ?? data.length
            const prefix = integer.widenByte(data[start])

            state.rows = state.rows.push({
                kind: integer.narrowByte(prefix - 1),
                path: encoding.sliceBytes(body, first, end)
            })[0]

            state.at = end + 1
        },
        return: state => ({
            rows: state.rows,
            length
        })
    })
}
