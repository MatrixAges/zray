import bytes from "std:bytes"
import encoding from "std:encoding"
import integer from "std:integer"

import { frame_header_size, word_size } from "./const"
import frame from "./frame.rx"
import { Status, Tag } from "./model"
import tag from "./tag"

import type { Input } from "./model"

export type Output = Status

export default function (in: Input): Output {
    const stream = bytes.fromText(in.bytes)

    return loop({
        offset: 0,
        status: Status.Success,
        saw_version: false,
        saw_digest: false,
        finished: false
    }, {
        while: state => state.status == Status.Success && state.offset < stream.length,
        next: state => {
            const remaining = stream.length - state.offset

            if (state.finished || remaining < frame_header_size) {
                state.status = Status.InvalidBackendProtocol
            } else {
                const kind = tag(bytes.readU32(stream, state.offset, true))
                const width = bytes.readU32(stream, state.offset + word_size, true)
                const length = integer.widen(width)

                if (length > remaining - frame_header_size) {
                    state.status = Status.InvalidBackendProtocol
                } else {
                    const payload = state.offset + frame_header_size
                    const end = payload + length

                    state.status = frame({
                        response: in.response,
                        tag: kind,
                        size: length,
                        body: encoding.sliceBytes(in.bytes, payload, end),
                        version: in.version,
                        config_size: in.config_size,
                        digest_size: in.digest_size,
                        saw_version: state.saw_version,
                        saw_digest: state.saw_digest
                    })
                    state.offset = end

                    if (kind == Tag.Version) {
                        state.saw_version = true
                    } else if (kind == Tag.Digest) {
                        state.saw_digest = true
                        state.finished = in.translation
                    } else if (kind == Tag.Diagnostics) {
                        state.finished = true
                    }
                }
            }
        },
        return: state => {
            const incomplete = !state.saw_version || !state.finished

            return match {
                state.status != Status.Success => state.status,
                incomplete => Status.IncompleteBackendResponse,
                state.saw_digest => Status.SuccessWithDigest,
                _ => Status.Success
            }
        }
    })
}
