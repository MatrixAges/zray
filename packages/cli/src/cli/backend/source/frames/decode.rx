<Module>
    <Type from="model" as="Protocol" />

    <Args in={Protocol.Input} out={Protocol.Output} />

    <Call module="read" in={$in} />

    <If on={$ctx.read.status != Protocol.Status.Success}>
        <Return
            value={{
                status: $ctx.read.status,
                paths: {
                    rows: [],
                    length: 0
                },
                cached: false
            }}
        />
    </If>

    <Call fn="materialize" in={$ctx.read.selection.inputs} />

    <Call
        fn="status"
        in={{
            exited: $in.exited,
            selection: $ctx.read.selection
        }}
    />

    <Return
        value={{
            status: $ctx.status,
            paths: $ctx.materialize,
            ...$ctx.read.selection.pick([
                "digest",
                "cached",
                "diagnostics"
            ])
        }}
    />
</Module>
