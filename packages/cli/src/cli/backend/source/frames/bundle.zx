import bytes from "std:bytes"
import encoding from "std:encoding"
import integer from "std:integer"

import { root_words } from "../diagnostics/const"
import { error_bundle_header_size, word_size } from "./const"

import type { DiagnosticBundle } from "backend_frames"

export type Input = string

export type Output = DiagnosticBundle?

export default function (in: Input): Output {
    const data = bytes.fromText(in)

    if (data.length < error_bundle_header_size) {
        return null
    }

    const extra = integer.widen(bytes.readU32(data, 0, true))
    const strings = integer.widen(bytes.readU32(data, word_size, true))
    const size = error_bundle_header_size + extra * word_size + strings

    const invalid_root = extra != 0 && extra < root_words

    if (size != data.length || invalid_root) {
        return null
    }

    const strings_start = error_bundle_header_size + extra * word_size

    return {
        words: bytes.readU32sLe(data, error_bundle_header_size, strings_start),
        strings: bytes.fromText(encoding.sliceBytes(in, strings_start, size))
    }
}
