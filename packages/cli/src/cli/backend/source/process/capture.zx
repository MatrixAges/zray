import { readChunk } from "backend_process"

import { output_limit, reserve_bytes } from "./const"

import type { Pipes as Input } from "backend_process"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        length: readChunk(in, reserve_bytes)
    }, {
        while: state => state.length != null && state.length <= output_limit,
        next: state => {
            state.length = readChunk(in, reserve_bytes)
        },
        return: state => state.length == null
    })
}
