import bytes from "std:bytes"

import { empty_payload, exit_tag, update_tag } from "./const"

export type Input = void

export type Output = u8[]

export default function (in: Input): Output {
    return bytes.join(bytes.fromText(""), [
        bytes.encodeU32Le(update_tag),
        bytes.encodeU32Le(empty_payload),
        bytes.encodeU32Le(exit_tag),
        bytes.encodeU32Le(empty_payload)
    ])
}
