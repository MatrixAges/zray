export type Input = {
    cwd: string,
    path: string,
    logical_inputs: string[],
    physical_inputs: string[]
}

export type Ancestor = {
    path: string,
    prefix: u64
}

export enum Status {
    Ready,
    MissingParent,
    Overlap
}

export type Outcome = {
    status: Status,
    path?: string
}
