import { pathParent } from "lexical_path"
import { resolvePublicationPath } from "publication_host"

import type { Ancestor as Output } from "./model"

export type Input = string

export default function (in: Input): Output {
    const initial = pathParent(in) ?? in

    return loop({
        logical: initial,
        physical: "",
        searching: true
    }, {
        while: state => state.searching,
        next: state => {
            const physical = resolvePublicationPath(state.logical, true)

            if (physical.length != 0) {
                state.physical = physical
                state.searching = false
            } else {
                const parent = pathParent(state.logical)

                if (parent == null) {
                    state.searching = false
                } else {
                    state.logical = parent
                }
            }
        },
        return: state => ({
            path: state.physical,
            prefix: state.logical.length
        })
    })
}
