export type Input = {
    logical: string,
    physical: string,
    logical_inputs: string[],
    physical_inputs: string[]
}

export type Output = bool

export default function (in: Input): Output {
    const { logical, physical, logical_inputs, physical_inputs } = in

    const logical_overlap = loop(0, {
        while: index =>
            index < logical_inputs.length && logical_inputs[index] != logical,
        next: index => {
            index += 1
        },
        return: index => index < logical_inputs.length
    })

    if (logical_overlap) {
        return true
    }

    return loop(0, {
        while: index =>
            index < physical_inputs.length && physical_inputs[index] != physical,
        next: index => {
            index += 1
        },
        return: index => index < physical_inputs.length
    })
}
