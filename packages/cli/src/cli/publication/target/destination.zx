import encoding from "std:encoding"
import path from "std:path"

import type { Ancestor } from "./model"

export type Input = {
    logical: string,
    ancestor: Ancestor
}

export type Output = string

export default function (in: Input): Output {
    const { logical, ancestor } = in

    const tail = encoding.sliceBytes(logical, ancestor.prefix, logical.length)

    return path.join([
        ancestor.path,
        tail
    ])
}
