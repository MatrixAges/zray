import encoding from "std:encoding"
import path from "std:path"
import host from "publication_host"

import type { OutputTarget } from "publication_host"
import type { Ancestor } from "./model"

export type Input = {
    target: OutputTarget,
    logical: string,
    ancestor: Ancestor
}

export type Output = string

export default function (in: Input): Output {
    const { target, logical, ancestor } = in

    if (host.isDirectOutput(target, logical)) {
        return host.readOutputPath(target, logical, false)
    }

    const tail = encoding.sliceBytes(logical, ancestor.prefix, logical.length)

    return path.join([
        ancestor.path,
        tail
    ])
}
