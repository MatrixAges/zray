<Module>
    <Type from="model" as="Output" />

    <Args in={Output.Input} out={Output.Outcome} />

    <Call
        fn="index.resolvePathParts"
        in={[
            $in.cwd,
            $in.path
        ]}
    />

    <Call
        fn="ancestor"
        in={[
            $in.target,
            $ctx.resolvePathParts
        ]}
    />

    <If on={$ctx.ancestor.path.length == 0}>
        <Return
            value={{
                status: Output.Status.MissingParent
            }}
        />
    </If>

    <Call
        fn="destination"
        in={{
            target: $in.target,
            logical: $ctx.resolvePathParts,
            ancestor: $ctx.ancestor
        }}
    />

    <Call
        fn="overlap"
        in={{
            logical: $ctx.resolvePathParts,
            physical: $ctx.destination,
            logical_inputs: $in.logical_inputs,
            physical_inputs: $in.physical_inputs
        }}
    />

    <If on={$ctx.overlap}>
        <Return
            value={{
                status: Output.Status.Overlap
            }}
        />
    </If>

    <Return
        value={{
            status: Output.Status.Ready,
            path: $ctx.destination
        }}
    />
</Module>
