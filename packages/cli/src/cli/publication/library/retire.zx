import host from "publication_host"

import type { Directory } from "publication_host"

export type Input = [Directory, string[]]

export type Output = void

export default function (in: Input): Output {
    const [directory, paths] = in

    const removed = loop(0, {
        while: index => index < paths.length,
        next: index => {
            host.removeRetiredFile(directory, paths[index])
            index += 1
        }
    })
}
