<Module>
    <Type from="model" as="Library" />

    <Args in={Library.Input} out={Library.Output} />

    <Call fn="../index.capture" in={$in.verification} />

    <Call
        fn="disjoint"
        in={{
            destination: $in.destination,
            observed: $in.observed,
            separator: $in.separator,
            count: $ctx.capture
        }}
    />

    <If on={!$ctx.disjoint}>
        <Return value={Library.Output.Overlap} />
    </If>

    <Call fn="../index.verify" in={$in.verification} />

    <If on={!$ctx.verify}>
        <Return value={Library.Output.Changed} />
    </If>

    <Call
        fn="../index.prepareRetirement"
        in={[
            $in.verification,
            $in.destination,
            $in.managed
        ]}
    />

    <Call fn="../index.openDirectory" in={$in.directory} />

    <Call
        fn="preflight"
        in={$in.pick([
            "directory",
            "destination",
            "verification"
        ])}
    />

    <If on={$ctx.preflight.manifest.length == 0}>
        <Return value={Library.Output.MissingInventory} />
    </If>

    <Loop on={$in.index < $in.paths.length}>
        <Call
            module="copy_content"
            in={{
                directory: $in.directory,
                paths: $ctx.preflight.targets,
                prefix: $ctx.preflight.prefix,
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.index < $in.paths.length}>
        <Call
            module="retire"
            in={{
                directory: $in.directory,
                paths: $ctx.prepareRetirement,
                index: 0
            }}
        />
    </Loop>

    <Call
        fn="../index.copyStagedFile"
        in={[
            $in.directory,
            $ctx.preflight.manifest,
            $ctx.preflight.prefix
        ]}
    />

    <Call fn="../index.retain" in={$in.verification} />

    <Return value={Library.Output.Published} />
</Module>
