import bytes from "std:bytes"
import host from "publication_host"

import { inventory_name } from "../../library/publication/const"
import { end_of_directory, named_regular_entry, regular_entry } from "../const"

import type { Files, Inventory as Input } from "./model"

export type Output = Files

export default function (in: Input): Output {
    const { library, directory } = in

    const targets: string[] = []

    return loop({
        reading: true,
        targets,
        manifest: "",
        prefix: 0
    }, {
        while: state => state.reading,
        next: state => {
            const kind = host.nextEntry(directory, inventory_name)

            if (kind == end_of_directory) {
                state.reading = false
            } else if (kind == regular_entry || kind == named_regular_entry) {
                const path = host.entryPath(directory)
                const target = host.validatePublishedPath(library, path)

                if (kind == named_regular_entry) {
                    state.manifest = target
                    state.prefix = bytes.fromText(target).length -
                        bytes.fromText(path).length
                } else {
                    state.targets = state.targets.push(target)[0]
                }
            }
        },
        return: state => ({
            targets: state.targets,
            manifest: state.manifest,
            prefix: state.prefix
        })
    })
}
