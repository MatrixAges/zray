import bytes from "std:bytes"
import fsPath from "std:path"
import host from "publication_host"
import { ResourceKind } from "publication_host"

import { inventory_name } from "../../library/publication/const"

import type { Files, Inventory as Input } from "./model"

export type Output = Files

export default function (in: Input): Output {
    const { destination, directory, verification } = in

    const targets: string[] = []

    return loop({
        reading: true,
        targets,
        manifest: "",
        prefix: 0
    }, {
        while: state => state.reading,
        next: state => {
            const entry = host.nextEntry(directory)
            const kind = entry.kind

            if (kind == ResourceKind.End) {
                state.reading = false
            } else if (kind == ResourceKind.Regular) {
                const path = entry.path
                const target = fsPath.join([
                    destination,
                    path
                ])

                const checked_target = host.checkPublishedTarget(verification, target)

                if (path == inventory_name) {
                    state.manifest = target
                    state.prefix = bytes.fromText(target).length -
                        bytes.fromText(path).length
                } else {
                    state.targets = state.targets.push(target)[0]
                }
            }
        },
        return: state => ({
            targets: state.targets,
            manifest: state.manifest,
            prefix: state.prefix
        })
    })
}
