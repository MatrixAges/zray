import type { TextColumn } from "memory"
import type { Directory, Library, Verification } from "publication_host"

export type Inventory = {
    library: Library,
    directory: Directory
}

export type Input = Inventory & {
    verification: Verification,
    observed: TextColumn,
    separator: u8
}

export type Files = {
    targets: string[],
    manifest: string,
    prefix: u64
}

export enum Output {
    Changed,
    Overlap,
    MissingInventory,
    Published
}
