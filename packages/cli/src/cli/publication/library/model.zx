import type { TextColumn } from "memory"
import type { Directory, Verification } from "publication_host"

export type Inventory = {
    directory: Directory,
    destination: string,
    verification: Verification
}

export type Input = Inventory & {
    retired?: string[],
    observed: TextColumn,
    versioned: bool,
    separator: u8
}

export type Files = {
    targets: string[],
    manifest: string,
    prefix: u64
}

export enum Output {
    Changed,
    Overlap,
    MissingInventory,
    Retirement,
    Published
}

export type Copy = {
    directory: Directory,
    paths: string[],
    prefix: u64,
    index: u64
}

export type Retire = Copy.Pick("paths", "index")
