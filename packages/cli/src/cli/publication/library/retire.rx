<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Retire} out={Model.Retire} />

    <Call
        fn="../index.removeRetiredFile"
        in={[
            $in.directory,
            $in.paths[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
