<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Copy} out={Model.Copy} />

    <Call
        fn="relative_source"
        in={{
            target: $in.paths[$in.index],
            prefix: $in.prefix
        }}
    />

    <Call
        fn="../index.copyDirectoryFile"
        in={[
            $in.directory,
            $ctx.relative_source,
            $in.paths[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
