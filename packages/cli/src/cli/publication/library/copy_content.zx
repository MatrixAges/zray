import host from "publication_host"

import type { Directory } from "publication_host"

export type Input = [Directory, string[], u64]

export type Output = void

export default function (in: Input): Output {
    const [directory, targets, prefix] = in

    const copied = loop(0, {
        while: index => index < targets.length,
        next: index => {
            host.copyStagedFile(directory, targets[index], prefix)
            index += 1
        }
    })
}
