import path from "std:path"
import memory from "memory"
import { relativePathFrom } from "publication_host"

import within from "../../native_sources/path/within"

import type { Input as Request } from "./model"

export type Input = Request.Pick("destination", "observed", "separator") & {
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { count, destination, observed, separator } = in

    return loop({
        index: 0,
        disjoint: true
    }, {
        while: state => state.disjoint && state.index < count,
        next: state => {
            const observed_path = memory.readTextColumn(observed, state.index)
            const relative = relativePathFrom(destination, observed_path)

            state.disjoint = !within({
                path: relative,
                absolute: path.isAbsolute(relative),
                separator
            })
            state.index += 1
        },
        return: state => state.disjoint
    })
}
