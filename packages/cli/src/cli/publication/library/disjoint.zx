import memory from "memory"
import host from "publication_host"

import within from "../../native_sources/path/within"

import type { Input as Request } from "./model"

export type Input = Request.Pick("library", "observed", "separator") & {
    count: u64
}

export type Output = bool

export default function (in: Input): Output {
    const { count, library, observed, separator } = in

    return loop({
        index: 0,
        disjoint: true
    }, {
        while: state => state.disjoint && state.index < count,
        next: state => {
            const observed_path = memory.readTextColumn(observed, state.index)
            const path = host.relativeInput(library, observed_path)

            state.disjoint = !within({
                path,
                absolute: host.absolutePath(path),
                separator
            })
            state.index += 1
        },
        return: state => state.disjoint
    })
}
