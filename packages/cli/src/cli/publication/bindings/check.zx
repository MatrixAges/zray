import { compareFile } from "artifact_io"

import resolvePathParts from "../../standard/path/resolve"
import { binding_marker } from "../const"

export type Input = {
    module: string,
    declaration: string,
    assembly?: string
}

export enum Status {
    Ready,
    ConflictingPaths,
    ForeignFile
}

export type Output = Status

export default function (in: Input): Output {
    const requested = in.assembly

    const assembly: string? = match {
        requested != null => resolvePathParts([requested]),
        _ => null
    }

    return loop({
        paths: [
            in.module,
            in.declaration
        ],
        index: 0,
        status: Status.Ready
    }, {
        while: state => state.index < state.paths.length && state.status == Status.Ready,
        next: state => {
            const path = state.paths[state.index]

            if (assembly != null && resolvePathParts([path]) == assembly) {
                state.status = Status.ConflictingPaths
            } else {
                const generated = compareFile(path, binding_marker, true)

                if (generated == false) {
                    state.status = Status.ForeignFile
                }
            }

            state.index += 1
        },
        return: state => state.status
    })
}
