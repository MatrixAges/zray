<Module>
    <Type from="model" as="Staged" />

    <Args in={Staged.Input} out={bool} />

    <If on={$in.assembly_source != null}>
        <If on={$in.assembly_target != null}>
            <Call
                fn="../index.copyPublishedFile"
                in={[
                    $in.assembly_source,
                    $in.assembly_target
                ]}
            />
        </If>
    </If>

    <Call fn="../index.openDirectory" in={$in.directory} />

    <Call
        fn="sidecars"
        in={$in.pick([
            "directory",
            "primary"
        ])}
    />

    <If on={!$ctx.sidecars}>
        <Return value={false} />
    </If>

    <Call
        fn="../index.copyPublishedFile"
        in={[
            $in.binary_source,
            $in.binary_target
        ]}
    />

    <Return value={true} />
</Module>
