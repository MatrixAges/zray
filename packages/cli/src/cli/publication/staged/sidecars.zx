import host from "publication_host"

import { end_of_directory, other_entry, regular_entry } from "../const"

import type { Sidecars as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { directory, primary } = in

    return loop({
        reading: true,
        valid: true
    }, {
        while: state => state.reading,
        next: state => {
            const kind = host.nextEntry(directory, primary)

            if (kind == end_of_directory) {
                state.reading = false
            } else if (kind == regular_entry) {
                host.copyEntry(directory)
            } else if (kind == other_entry) {
                state.valid = false
                state.reading = false
            }
        },
        return: state => state.valid
    })
}
