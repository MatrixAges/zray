import host from "publication_host"
import { ResourceKind } from "publication_host"

import basename from "../../standard/path/basename"
import join from "../../standard/path/join"
import parent from "../../standard/path/parent"

import type { Sidecars as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { directory } = in

    const primary = basename(in.binary_source)
    const destination = parent(in.binary_target) ?? "."

    return loop({
        reading: true,
        valid: true
    }, {
        while: state => state.reading,
        next: state => {
            const entry = host.nextEntry(directory)
            const kind = entry.kind
            const named = entry.path == primary
            const other = kind != ResourceKind.Regular && kind != ResourceKind.Directory

            if (kind == ResourceKind.End) {
                state.reading = false
            } else if (kind == ResourceKind.Regular && !named) {
                const target = join([
                    destination,
                    entry.path
                ])

                host.copyDirectoryFile(directory, entry.path, target)
            } else if (other && !named) {
                state.valid = false
                state.reading = false
            }
        },
        return: state => state.valid
    })
}
