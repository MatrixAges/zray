import host from "publication_host"

import basename from "../../standard/path/basename"
import join from "../../standard/path/join"
import parent from "../../standard/path/parent"
import { end_of_directory, other_entry, regular_entry } from "../const"

import type { Sidecars as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { directory } = in

    const primary = basename(in.binary_source)
    const destination = parent(in.binary_target) ?? "."

    return loop({
        reading: true,
        valid: true
    }, {
        while: state => state.reading,
        next: state => {
            const entry = host.nextEntry(directory, primary)
            const kind = entry.kind

            if (kind == end_of_directory) {
                state.reading = false
            } else if (kind == regular_entry) {
                const target = join([
                    destination,
                    entry.path
                ])

                host.copyDirectoryFile(directory, entry.path, target)
            } else if (kind == other_entry) {
                state.valid = false
                state.reading = false
            }
        },
        return: state => state.valid
    })
}
