export type Directory = opaque
export type Output = mutable_opaque
export type Library = mutable_opaque
export type Verification = mutable_opaque
export type OutputTarget = mutable_opaque

export type ResourceWalk = opaque
export type InventoryCollector = opaque
export type Retirement = opaque

export type RetirementPath = {
    path: string,
    relative: string,
    absolute: bool
}

export enum ResourceKind {
    End,
    Directory,
    Regular,
    Symlink,
    Other
}

export enum RetirementFile {
    Missing,
    Regular,
    Other
}

export declare function copyAssembly(output: Output): void throws { PublicationFailure }
export declare function copyBinary(output: Output): void throws { PublicationFailure }

export declare function openDirectory(directory: Directory): void throws { PublicationFailure }
export declare function nextEntry(directory: Directory, name: string): u8 throws { PublicationFailure }
export declare function copyEntry(directory: Directory): void throws { PublicationFailure }
export declare function entryPath(directory: Directory): string
export declare function copyStagedFile(
    directory: Directory,
    target: string,
    prefix: u64
): void throws { PublicationFailure }
export declare function removeRetiredFile(directory: Directory, target: string): void
    throws { PublicationFailure }

export declare function capture(verification: Verification): void throws { PublicationFailure }
export declare function verify(verification: Verification): bool throws { PublicationFailure }
export declare function retain(verification: Verification): void

export declare function checkBinary(output: Output): string throws { PublicationFailure }
export declare function checkAssembly(output: Output): string throws { PublicationFailure }
export declare function checkBindings(output: Output): void throws { PublicationFailure }
export declare function writeBindings(output: Output): void throws { PublicationFailure }

export declare function captureLibraryInputs(library: Library): u64 throws {
    PublicationFailure
}
export declare function relativeInput(library: Library, path: string): string throws {
    PublicationFailure
}
export declare function prepareRetirement(library: Library): string[] throws {
    PublicationFailure
}
export declare function validatePublishedPath(library: Library, path: string): string
    throws { PublicationFailure }
export declare function absolutePath(path: string): bool

export declare function readOutputPath(
    target: OutputTarget,
    path: string,
    allow_missing: bool
): string throws { PublicationFailure }
export declare function isDirectOutput(target: OutputTarget, path: string): bool
    throws { PublicationFailure }
export declare function keepOutputPath(
    target: OutputTarget,
    base: string,
    logical: string,
    prefix: u64
): string throws { PublicationFailure }

export declare function resourceRoot(walk: ResourceWalk): ResourceKind throws { PublicationFailure }
export declare function openResources(walk: ResourceWalk): void throws { PublicationFailure }
export declare function nextResource(walk: ResourceWalk): ResourceKind throws { PublicationFailure }
export declare function observeResource(walk: ResourceWalk, is_directory: bool): void throws { PublicationFailure }
export declare function resourceLinkIsFile(walk: ResourceWalk): bool throws { PublicationFailure }
export declare function keepResource(walk: ResourceWalk): void throws { PublicationFailure }

export declare function openInventory(collector: InventoryCollector): void throws { PublicationFailure }
export declare function nextInventory(collector: InventoryCollector): u8 throws { PublicationFailure }
export declare function inventoryPath(collector: InventoryCollector): string throws { PublicationFailure }
export declare function addInventoryFile(collector: InventoryCollector, path: string): void throws { PublicationFailure }

export declare function readRetirement(plan: Retirement): bool throws { PublicationFailure }
export declare function reserveTargets(plan: Retirement): string[] throws { PublicationFailure }

export declare function retirementSpelling(plan: Retirement, path: string): RetirementPath
    throws { PublicationFailure }
export declare function retirementFileKind(plan: Retirement, path: string): RetirementFile
    throws { PublicationFailure }
export declare function retirementPhysical(plan: Retirement, path: string): RetirementPath
    throws { PublicationFailure }
export declare function retirementPhysicalMatches(
    plan: Retirement,
    target: string,
    physical: string
): bool throws { PublicationFailure }
export declare function checkRetirementInput(plan: Retirement, path: string): void
    throws { PublicationFailure }
export declare function retirementDigest(plan: Retirement, path: string): string
    throws { PublicationFailure }
