export type Directory = opaque
export type Verification = opaque

export enum ResourceKind {
    End,
    Directory,
    Regular,
    Symlink,
    Other
}

export type ResourceEntry = {
    kind: ResourceKind,
    path: string
}

export enum PublicationFileKind {
    Missing,
    Regular,
    Symlink,
    Other
}

export declare function relativePathFrom(allocator, base: string, target: string): string
    throws { OutOfMemory } concurrent

export declare function copyPublishedFile(io, source: string, destination: string): void throws {
    AccessDenied, AntivirusInterference, BadPathName, BrokenPipe, Canceled,
    ConnectionResetByPeer, CrossDevice, DeviceBusy, DirNotEmpty, DiskQuota, FileBusy,
    FileLocksUnsupported, FileNotFound, FileTooBig, HardwareFailure, InputOutput,
    InvalidFileName, IsDir, LinkQuotaExceeded, LockViolation, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, NotOpenForReading, NotOpenForWriting, OperationUnsupported,
    PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, ReadOnlyFileSystem,
    SocketUnconnected, Streaming, SymLinkLoop, SystemFdQuotaExceeded, SystemResources,
    Unexpected, WouldBlock
}

export declare function openDirectory(directory: Directory, follow_symlinks: bool): void throws { PublicationFailure }
export declare function nextEntry(directory: Directory): ResourceEntry
    throws { PublicationFailure }
export declare function copyDirectoryFile(
    directory: Directory,
    relative: string,
    target: string
): void throws { PublicationFailure }
export declare function removeRetiredFile(io, target: string): void throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileNotFound, IsDir, NameTooLong, NetworkNotFound, NoDevice, NotDir, PermissionDenied,
    ReadOnlyFileSystem, FileSystem, SymLinkLoop, SystemResources, Unexpected
}
export declare function listPublicationDirectory(allocator, io, path: string): ResourceEntry[]
    throws {
        AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
        FileNotFound, FileSystem, InputOutput, IsDir, NameTooLong, NetworkNotFound, NoDevice,
        NotDir, OperationUnsupported, OutOfMemory, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded,
        ReadOnlyFileSystem, SymLinkLoop, SystemFdQuotaExceeded, SystemResources, Unexpected
    }

export declare function capture(verification: Verification): u64 throws { PublicationFailure }
export declare function verify(verification: Verification, versioned: bool): bool throws { PublicationFailure }
export declare function retain(verification: Verification): void

export declare function checkPublishedTarget(
    allocator,
    verification: Verification,
    path: string
): string throws { PublicationFailure }

export declare function prepareRetirement(
    allocator,
    verification: Verification,
    destination: string,
    managed: string[]
): string[] throws { PublicationFailure }

export declare function resolvePublicationPath(
    allocator,
    io,
    path: string,
    allow_missing: bool
): string throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileNotFound, FileSystem, FileTooBig, InputOutput, IsDir, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, OperationUnsupported, OutOfMemory, PathAlreadyExists,
    PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, SymLinkLoop, SystemFdQuotaExceeded,
    SystemResources, Unexpected, UnrecognizedVolume
}

export declare function publicationPathMatches(io, path: string, physical: string): bool throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileNotFound, FileSystem, FileTooBig, InputOutput, IsDir, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, OperationUnsupported, OutOfMemory, PathAlreadyExists,
    PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, SymLinkLoop, SystemFdQuotaExceeded,
    SystemResources, Unexpected, UnrecognizedVolume
}

export declare function readPublicationFileKind(io, path: string): PublicationFileKind throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileLocksUnsupported, FileTooBig, IsDir, NameTooLong, NetworkNotFound, NoDevice,
    NoSpaceLeft, NotDir, PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded,
    ReadOnlyFileSystem, Streaming, SymLinkLoop, SystemFdQuotaExceeded, SystemResources,
    Unexpected, WouldBlock
}

export declare function resourceRoot(walk: Directory): ResourceEntry throws { PublicationFailure }
export declare function nextResource(walk: Directory): ResourceEntry throws { PublicationFailure }
export declare function observeResource(
    walk: Directory,
    path: string,
    is_directory: bool
): void throws { PublicationFailure }
export declare function resourceLinkIsFile(walk: Directory, path: string): bool
    throws { PublicationFailure }

export declare function digestPublishedFile(allocator, io, path: string): string throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, ConnectionResetByPeer,
    DeviceBusy, FileBusy, FileLocksUnsupported, FileNotFound, FileTooBig, InputOutput, IsDir,
    LockViolation, NameTooLong, NetworkNotFound, NoDevice, NoSpaceLeft, NotDir,
    NotOpenForReading, OutOfMemory, PathAlreadyExists, PermissionDenied, PipeBusy,
    ProcessFdQuotaExceeded, ReadOnlyFileSystem, SocketUnconnected, Streaming, SymLinkLoop,
    SystemFdQuotaExceeded, SystemResources, Unexpected, WouldBlock
}
