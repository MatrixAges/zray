export type Directory = opaque
export type Verification = opaque
export type Snapshot = opaque

export type Captured = {
    snapshot: Snapshot,
    count: u64
}

export type ResourceWalk = opaque
export type Retirement = opaque

export type DirectoryEntry = {
    kind: u8,
    path: string
}

export type InventoryEntry = {
    path: string,
    digest: string
}

export enum ResourceKind {
    End,
    Directory,
    Regular,
    Symlink,
    Other
}

export type ResourceEntry = {
    kind: ResourceKind,
    path: string
}

export type RetirementPath = {
    path: string,
    relative: string,
    absolute: bool
}

export enum PublicationFileKind {
    Missing,
    Regular,
    Symlink,
    Other
}

export declare function joinNativeParts(allocator, parts: string[]): string
    throws { OutOfMemory } concurrent

export declare function relativePathFrom(allocator, base: string, target: string): string
    throws { OutOfMemory } concurrent

export declare function copyPublishedFile(io, source: string, destination: string): void throws {
    AccessDenied, AntivirusInterference, BadPathName, BrokenPipe, Canceled,
    ConnectionResetByPeer, CrossDevice, DeviceBusy, DirNotEmpty, DiskQuota, FileBusy,
    FileLocksUnsupported, FileNotFound, FileTooBig, HardwareFailure, InputOutput,
    InvalidFileName, IsDir, LinkQuotaExceeded, LockViolation, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, NotOpenForReading, NotOpenForWriting, OperationUnsupported,
    PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, ReadOnlyFileSystem,
    SocketUnconnected, Streaming, SymLinkLoop, SystemFdQuotaExceeded, SystemResources,
    Unexpected, WouldBlock
}

export declare function openDirectory(directory: Directory): void throws { PublicationFailure }
export declare function nextEntry(directory: Directory, name: string): DirectoryEntry
    throws { PublicationFailure }
export declare function copyEntry(directory: Directory): void throws { PublicationFailure }
export declare function copyStagedFile(
    directory: Directory,
    target: string,
    prefix: u64
): void throws { PublicationFailure }
export declare function removeRetiredFile(directory: Directory, target: string): void
    throws { PublicationFailure }
export declare function digestEntry(directory: Directory, path: string): InventoryEntry
    throws { PublicationFailure }

export declare function capture(verification: Verification): Captured throws { PublicationFailure }
export declare function verify(verification: Verification, snapshot: Snapshot, versioned: bool): bool throws { PublicationFailure }
export declare function retain(verification: Verification, snapshot: Snapshot): void

export declare function checkPublishedTarget(
    allocator,
    verification: Verification,
    path: string
): string throws { PublicationFailure }

export declare function prepareRetirement(
    allocator,
    verification: Verification,
    destination: string,
    managed: string[]
): string[] throws { PublicationFailure }

export declare function resolvePublicationPath(
    allocator,
    io,
    path: string,
    allow_missing: bool
): string throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileNotFound, FileSystem, FileTooBig, InputOutput, IsDir, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, OperationUnsupported, OutOfMemory, PathAlreadyExists,
    PermissionDenied, PipeBusy, ProcessFdQuotaExceeded, SymLinkLoop, SystemFdQuotaExceeded,
    SystemResources, Unexpected, UnrecognizedVolume
}

export declare function readPublicationFileKind(io, path: string): PublicationFileKind throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileLocksUnsupported, FileTooBig, IsDir, NameTooLong, NetworkNotFound, NoDevice,
    NoSpaceLeft, NotDir, PathAlreadyExists, PermissionDenied, PipeBusy, ProcessFdQuotaExceeded,
    ReadOnlyFileSystem, Streaming, SymLinkLoop, SystemFdQuotaExceeded, SystemResources,
    Unexpected, WouldBlock
}

export declare function resourceRoot(walk: ResourceWalk): ResourceEntry throws { PublicationFailure }
export declare function openResources(walk: ResourceWalk): void throws { PublicationFailure }
export declare function nextResource(walk: ResourceWalk): ResourceEntry throws { PublicationFailure }
export declare function observeResource(
    walk: ResourceWalk,
    path: string,
    is_directory: bool
): void throws { PublicationFailure }
export declare function resourceLinkIsFile(walk: ResourceWalk, path: string): bool
    throws { PublicationFailure }

export declare function readRetirement(plan: Retirement): bool throws { PublicationFailure }
export declare function reserveTargets(plan: Retirement): string[] throws { PublicationFailure }

export declare function retirementSpelling(plan: Retirement, path: string): RetirementPath
    throws { PublicationFailure }
export declare function retirementPhysical(plan: Retirement, path: string): RetirementPath
    throws { PublicationFailure }
export declare function retirementPhysicalMatches(
    plan: Retirement,
    target: string,
    physical: string
): bool throws { PublicationFailure }
export declare function checkRetirementInput(plan: Retirement, path: string): void
    throws { PublicationFailure }
export declare function retirementDigest(plan: Retirement, path: string): string
    throws { PublicationFailure }
