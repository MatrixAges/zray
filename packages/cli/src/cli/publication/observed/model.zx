import type { Verification } from "publication_host"

export type Bindings = {
    module: string,
    declaration: string,
    module_source: string,
    declaration_source: string
}

export type Input = {
    verification: Verification,
    versioned: bool,
    succeeded: bool,
    complete: bool,
    new_inputs: bool,
    binary_source?: string,
    binary_target: string,
    assembly_source?: string,
    assembly_target?: string,
    bindings?: Bindings
}

export enum Output {
    Skipped,
    ConflictingPaths,
    ForeignFile,
    Published
}
