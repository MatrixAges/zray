<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={Compile.Outcome} />

    <Call fn="index.readCompilationSource" in={$in.compilation} />

    <If on={$ctx.readCompilationSource.failure != null}>
        <Call fn="stage_diagnostic" in={$ctx.readCompilationSource.failure} />

        <Return
            value={{
                status: IO.Status.Failed,
                diagnostic: $ctx.stage_diagnostic,
                defer_diagnostic_flush: true
            }}
        />
    </If>

    <Call
        fn="index.readCompilationDependencies"
        in={[
            $in.compilation,
            $ctx.readCompilationSource.bytes,
            $in.settings.cache
        ]}
    />

    <If on={$ctx.readCompilationDependencies.failure != null}>
        <Call fn="stage_diagnostic" in={$ctx.readCompilationDependencies.failure} />

        <Return
            value={{
                status: IO.Status.Failed,
                diagnostic: $ctx.stage_diagnostic
            }}
        />
    </If>

    <If on={$ctx.readCompilationDependencies.has_rx}>
        <Return
            value={{
                status: IO.Status.RunRx
            }}
        />
    </If>

    <Call
        module="cache/load"
        in={{
            ...$in,
            has_compiled_libraries:
                $ctx.readCompilationDependencies.has_compiled_libraries
        }}
    />

    <If on={$in.settings.verifying || $in.settings.fpga}>
        <Call
            module="query"
            in={{
                ...$in,
                proof: $in.settings.verifying
            }}
        />

        <Return value={$ctx.query} />
    </If>

    <If on={$in.settings.native}>
        <Call
            module="native"
            in={{
                ...$in,
                source: $ctx.readCompilationSource.bytes
            }}
        />

        <Return
            value={{
                status: $ctx.native
            }}
        />
    </If>

    <Call
        fn="index.emitCompilationText"
        in={[
            $in.compilation,
            $ctx.readCompilationSource.bytes
        ]}
    />

    <If on={$ctx.emitCompilationText == null}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />

        <Else>
            <Call module="cache/finish" in={$in} />

            <Call
                module="output"
                in={{
                    ...$in,
                    text: $ctx.emitCompilationText
                }}
            />

            <Return value={$ctx.output} />
        </Else>
    </If>
</Module>
