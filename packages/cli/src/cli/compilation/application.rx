<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={Compile.Outcome} />

    <Call fn="index.readCompilationSource" in={$in.compilation} />

    <If on={!$ctx.readCompilationSource}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />
    </If>

    <Call fn="index.openCompilationCaches" in={$in.compilation} />
    <Call fn="index.readCompilationDependencies" in={$in.compilation} />

    <If on={$ctx.readCompilationDependencies == IO.Dependencies.Invalid}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />
    </If>

    <If on={$ctx.readCompilationDependencies == IO.Dependencies.Rx}>
        <Return
            value={{
                status: IO.Status.RunRx
            }}
        />
    </If>

    <Call
        module="cache/load"
        in={{
            ...$in,
            has_compiled_libraries:
                $ctx.readCompilationDependencies == IO.Dependencies.WithLibraries
        }}
    />

    <If on={$in.settings.verifying || $in.settings.fpga}>
        <Call
            module="query"
            in={{
                ...$in,
                proof: $in.settings.verifying
            }}
        />

        <Return value={$ctx.query} />
    </If>

    <Call fn="index.openCompilationGeneration" in={$in.compilation} />

    <If on={$in.settings.native}>
        <Call module="native" in={$in} />

        <Return
            value={{
                status: $ctx.native
            }}
        />
    </If>

    <Call fn="index.emitCompilationText" in={$in.compilation} />

    <If on={$ctx.emitCompilationText == null}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />

        <Else>
            <Call module="cache/finish" in={$in} />

            <Call
                module="output"
                in={{
                    ...$in,
                    text: $ctx.emitCompilationText
                }}
            />

            <Return value={$ctx.output} />
        </Else>
    </If>
</Module>
