import type { Compilation } from "compilation_host"

export type Settings = {
    formatting: bool,
    linting: bool,
    library: bool,
    verifying: bool,
    fpga: bool,
    native: bool,
    cache: bool,
    cache_stats: bool,
    json_result: bool,
    check: bool,
    write: bool,
    output?: string
}

export type Request = {
    compilation: Compilation,
    settings: Settings,
    watching: bool,
    input: u8[],
    explicit_config: bool
}

export type Query = Request & {
    proof: bool
}

export type CacheLoad = Request & {
    has_compiled_libraries: bool
}
