<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={IO.Status} />

    <Call fn="index.emitCompilationModules" in={$in.compilation} />

    <If on={!$ctx.emitCompilationModules}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call module="cache/finish" in={$in} />

    <Call fn="index.reportCompilationGeneration" in={$in.compilation} />
    <Call fn="index.resolveCompilationToolchain" in={$in.compilation} />

    <If on={!$ctx.resolveCompilationToolchain}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call fn="index.buildCompilationModules" in={$in.compilation} />

    <Return value={$ctx.buildCompilationModules} />
</Module>
