<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={IO.Status} />

    <If on={$in.settings.check}>
        <Call fn="index.checkCompilationText" in={$in.compilation} />

        <If on={!$ctx.checkCompilationText}>
            <Return value={IO.Status.Failed} />
        </If>

        <Return value={IO.Status.Success} />
    </If>

    <If on={$in.settings.write || $in.settings.output != null}>
        <Call fn="index.writeCompilationText" in={$in.compilation} />

        <Else>
            <Call fn="index.printCompilationText" in={$in.compilation} />
        </Else>
    </If>

    <Return value={IO.Status.Success} />
</Module>
