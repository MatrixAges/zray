<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.TextPublication} out={Compile.Outcome} />

    <If on={$in.settings.check}>
        <Call
            fn="text_diagnostic"
            in={{
                source: $in.text.source,
                original: $in.text.original,
                path: $in.text.input_path,
                notice: $in.formatting_notice
            }}
        />

        <If on={$ctx.text_diagnostic == null}>
            <Return
                value={{
                    status: IO.Status.Success
                }}
            />

            <Else>
                <Return
                    value={{
                        status: IO.Status.Failed,
                        diagnostic: $ctx.text_diagnostic
                    }}
                />
            </Else>
        </If>
    </If>

    <If on={$in.settings.write}>
        <Call
            module="../workspace_files/write_program_text"
            in={{
                path: $in.text.input_path,
                source: $in.text.source,
                abi: $in.text.abi,
                abi_base: $in.settings.output
            }}
        />

        <Return
            value={{
                status: IO.Status.Success
            }}
        />
    </If>

    <If on={$in.settings.output == null}>
        <Return
            value={{
                status: IO.Status.Success,
                stdout: $in.text.source
            }}
        />

        <Else>
            <Call
                module="../workspace_files/write_program_text"
                in={{
                    path: $in.settings.output,
                    source: $in.text.source,
                    abi: $in.text.abi,
                    abi_base: $in.settings.output
                }}
            />
        </Else>
    </If>

    <Return
        value={{
            status: IO.Status.Success
        }}
    />
</Module>
