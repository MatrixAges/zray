<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Compilation} out={IO.Status} />

    <Call fn="index.compilationCheckingText" in={$in} />

    <If on={$ctx.compilationCheckingText}>
        <Call fn="index.checkCompilationText" in={$in} />

        <If on={!$ctx.checkCompilationText}>
            <Return value={IO.Status.Failed} />
        </If>

        <Return value={IO.Status.Success} />
    </If>

    <Call fn="index.compilationWritingText" in={$in} />

    <If on={$ctx.compilationWritingText}>
        <Call fn="index.writeCompilationText" in={$in} />

        <Else>
            <Call fn="index.printCompilationText" in={$in} />
        </Else>
    </If>

    <Return value={IO.Status.Success} />
</Module>
