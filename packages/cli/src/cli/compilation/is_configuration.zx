import endsWith from "../lint/ends_with"
import { json_suffix, yaml_suffix } from "./const"

export type Input = {
    path: u8[],
    explicit: bool
}

export type Output = bool

export default function (in: Input): Output {
    if (in.explicit) {
        return true
    }

    return endsWith({
        text: in.path,
        suffix: yaml_suffix
    }) || endsWith({
        text: in.path,
        suffix: json_suffix
    })
}
