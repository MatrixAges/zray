import type { FpgaManifest, FpgaProgram } from "compilation_host"

export type ProofInput = {
    local_required: bool,
    function_contracts: bool[]
}

export type Input = ProofInput & {
    program: FpgaProgram,
    output: string,
    clocked: bool,
    ir_version: u32
}

export type Publication = {
    path: string,
    notice: string,
    manifest: FpgaManifest
}
