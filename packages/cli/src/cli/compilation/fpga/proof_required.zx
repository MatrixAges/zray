import type { ProofInput as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    if (in.local_required) {
        return true
    }

    return loop(0, {
        while: row =>
            row < in.function_contracts.length && !in.function_contracts[row],
        next: row => {
            row += 1
        },
        return: row => row < in.function_contracts.length
    })
}
