import {
    fpgaFunctionCount,
    fpgaFunctionHasContract,
    fpgaLocalProofRequired
} from "rx_execution_host"

import type { FpgaProgram as Input } from "rx_execution_host"

export type Output = bool

export default function (in: Input): Output {
    if (fpgaLocalProofRequired(in)) {
        return true
    }

    const count = fpgaFunctionCount(in)
    const first: u64 = 0

    return loop({
        row: first,
        required: false
    }, {
        while: state => !state.required && state.row < count,
        next: state => {
            state.required = fpgaFunctionHasContract(in, state.row)
            state.row += 1
        },
        return: state => state.required
    })
}
