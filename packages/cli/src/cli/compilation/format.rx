<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={IO.Status} />

    <Call
        fn="is_configuration"
        in={{
            path: $in.input,
            explicit: $in.explicit_config
        }}
    />

    <If on={$ctx.is_configuration}>
        <Return value={IO.Status.Configuration} />
    </If>

    <Call
        fn="index.resolveCompilationEntry"
        in={[
            $in.compilation,
            false
        ]}
    />

    <Call fn="index.readCompilationSource" in={$in.compilation} />

    <If on={!$ctx.readCompilationSource}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call fn="index.formatCompilationSource" in={$in.compilation} />

    <If on={!$ctx.formatCompilationSource}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call module="output" in={$in} />

    <Return value={$ctx.output} />
</Module>
