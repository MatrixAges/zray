<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={Compile.Outcome} />

    <Call
        fn="is_configuration"
        in={{
            path: $in.input,
            explicit: $in.explicit_config
        }}
    />

    <If on={$ctx.is_configuration}>
        <Return
            value={{
                status: IO.Status.Configuration
            }}
        />
    </If>

    <Call
        fn="index.resolveCompilationEntry"
        in={[
            $in.compilation,
            false
        ]}
    />

    <Call fn="index.readCompilationSource" in={$in.compilation} />

    <If on={$ctx.readCompilationSource.failure != null}>
        <Call fn="stage_diagnostic" in={$ctx.readCompilationSource.failure} />

        <Return
            value={{
                status: IO.Status.Failed,
                diagnostic: $ctx.stage_diagnostic,
                defer_diagnostic_flush: true
            }}
        />
    </If>

    <Call
        fn="index.formatCompilationSource"
        in={[
            $in.compilation,
            $ctx.readCompilationSource.bytes
        ]}
    />

    <If on={$ctx.formatCompilationSource == null}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />

        <Else>
            <Call
                module="output"
                in={{
                    ...$in,
                    text: $ctx.formatCompilationSource
                }}
            />

            <Return value={$ctx.output} />
        </Else>
    </If>
</Module>
