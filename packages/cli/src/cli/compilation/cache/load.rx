<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Compile" />

    <Args in={Compile.CacheLoad} out={void} />

    <If on={$in.settings.cache}>
        <If on={$in.has_compiled_libraries}>
            <If on={$in.settings.cache_stats}>
                <Call fn="cache_notice" in={true} />

                <Call
                    fn="../index.writeCompilationDiagnostic"
                    in={[
                        $in.compilation,
                        $ctx.cache_notice
                    ]}
                />
            </If>

            <Else>
                <Call fn="../index.loadCompilationCache" in={$in.compilation} />
            </Else>
        </If>
    </If>
</Module>
