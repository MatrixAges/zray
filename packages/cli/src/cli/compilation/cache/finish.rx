<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Compile" />

    <Args in={Compile.Request} out={void} />

    <If on={$in.settings.cache}>
        <Call fn="../index.saveCompilationCache" in={$in.compilation} />
    </If>

    <If on={$in.settings.cache_stats}>
        <If on={$in.settings.cache}>
            <Call fn="../index.reportCompilationCache" in={$in.compilation} />

            <Else>
                <Call fn="../index.reportCompilationCacheDisabled" in={$in.compilation} />
            </Else>
        </If>
    </If>
</Module>
