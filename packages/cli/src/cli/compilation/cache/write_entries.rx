<Module>
    <Type from="model" as="Model" />

    <Args in={Model.WriteWalk} out={Model.WriteWalk} />

    <If on={$in.dirty[$in.index]}>
        <Call
            fn="../index.saveDiskSemanticEntry"
            in={[
                $in.disk,
                $in.is_native,
                $in.index
            ]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
