import { loadDiskSemanticSource } from "rx_execution_host"

import type { ReadInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const loaded = loop(0, {
        while: row => row < in.count,
        next: row => {
            loadDiskSemanticSource(in.disk, row)

            row += 1
        }
    })
}
