import { diskSemanticSourceCount, loadDiskSemanticSource } from "rx_execution_host"

import type { SemanticDiskRead as Input } from "rx_execution_host"

export type Output = void

export default function (in: Input): Output {
    const count = diskSemanticSourceCount(in)

    const loaded = loop(0, {
        while: row => row < count,
        next: row => {
            loadDiskSemanticSource(in, row)

            row += 1
        }
    })
}
