import type { SemanticDisk } from "compilation_host"

export type ReadInput = {
    disk: SemanticDisk,
    count: u64
}

export type WriteInput = {
    disk: SemanticDisk,
    source_dirty: bool[],
    native_dirty: bool[]
}

export type WriteEntries = {
    disk: SemanticDisk,
    is_native: bool,
    dirty: bool[]
}

export type WriteWalk = WriteEntries & {
    index: u64
}
