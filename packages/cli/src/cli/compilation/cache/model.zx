import type { Compilation } from "compilation_host"

export type ReadInput = {
    compilation: Compilation,
    count: u64
}

export type ReadWalk = ReadInput & {
    index: u64
}

export type Input = {
    compilation: Compilation,
    read_count?: u64,
    source_dirty: bool[],
    native_dirty: bool[]
}

export type WriteEntries = {
    compilation: Compilation,
    is_native: bool,
    dirty: bool[]
}

export type WriteWalk = WriteEntries & {
    index: u64
}
