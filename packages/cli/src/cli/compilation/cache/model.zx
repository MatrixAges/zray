import type { SemanticDiskRead, SemanticDiskWrite } from "rx_execution_host"

export type ReadInput = {
    disk: SemanticDiskRead,
    count: u64
}

export type WriteInput = {
    disk: SemanticDiskWrite,
    source_dirty: bool[],
    native_dirty: bool[]
}

export type WriteEntries = {
    disk: SemanticDiskWrite,
    is_native: bool,
    dirty: bool[]
}
