<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.ReadWalk} out={Cache.ReadWalk} />

    <Call
        fn="../index.loadDiskSemanticSource"
        in={[
            $in.compilation,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
