<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.WriteInput} out={void} />

    <Call
        module="write_batch"
        in={{
            disk: $in.disk,
            is_native: false,
            dirty: $in.source_dirty
        }}
    />

    <Call
        module="write_batch"
        in={{
            disk: $in.disk,
            is_native: true,
            dirty: $in.native_dirty
        }}
    />
</Module>
