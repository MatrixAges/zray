<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.WriteInput} out={void} />

    <If on={$in.source_dirty.length > 0}>
        <Call
            fn="write_entries"
            in={{
                disk: $in.disk,
                is_native: false,
                dirty: $in.source_dirty
            }}
        />
    </If>

    <If on={$in.native_dirty.length > 0}>
        <Call
            fn="write_entries"
            in={{
                disk: $in.disk,
                is_native: true,
                dirty: $in.native_dirty
            }}
        />
    </If>
</Module>
