import { saveDiskSemanticEntry } from "rx_execution_host"

import type { WriteEntries as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { disk, is_native, dirty } = in

    const written = loop(0, {
        while: row => row < dirty.length,
        next: row => {
            if (dirty[row]) {
                saveDiskSemanticEntry(disk, is_native, row)
            }

            row += 1
        }
    })
}
