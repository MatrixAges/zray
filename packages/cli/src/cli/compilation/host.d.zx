export type Compilation = opaque

export type SemanticDisk = opaque

export type FpgaProgram = opaque

export enum Status {
    Success,
    Failed,
    BackendFailed,
    Retry,
    Linting,
    Configuration,
    RunRx,
    LibraryProof,
    LibraryBuild
}

export enum Dependencies {
    Invalid,
    Rx,
    Zx,
    WithLibraries
}

export declare function resolveCompilationEntry(check: Compilation, track_library: bool): u8[] throws { SourceLoadFailure }
export declare function loadCompilationProject(check: Compilation): bool throws { SourceLoadFailure }
export declare function readCompilationSource(check: Compilation): bool throws { SourceLoadFailure }
export declare function openCompilationCaches(check: Compilation): void throws { SourceLoadFailure }
export declare function readCompilationDependencies(check: Compilation): Dependencies throws { SourceLoadFailure }

export declare function writeCompilationDiagnostic(check: Compilation, message: string): void throws { SourceLoadFailure }
export declare function loadCompilationCache(check: Compilation): void throws { SourceLoadFailure }
export declare function saveCompilationCache(check: Compilation): void throws { SourceLoadFailure }
export declare function reportCompilationCache(check: Compilation): void throws { SourceLoadFailure }
export declare function analyzeCompilation(check: Compilation, cache: bool): string? throws { SourceLoadFailure }
export declare function verifyCompilationProgram(check: Compilation): bool throws { SourceLoadFailure }
export declare function generateCompilationFpga(check: Compilation): bool throws { SourceLoadFailure }
export declare function flushCompilationDiagnostics(check: Compilation): void throws { SourceLoadFailure }
export declare function openCompilationGeneration(check: Compilation): void throws { SourceLoadFailure }
export declare function formatCompilationSource(check: Compilation): bool throws { SourceLoadFailure }
export declare function emitCompilationText(check: Compilation): bool throws { SourceLoadFailure }
export declare function emitCompilationModules(check: Compilation): bool throws { SourceLoadFailure }
export declare function reportCompilationGeneration(check: Compilation): void throws { SourceLoadFailure }
export declare function resolveCompilationToolchain(check: Compilation): bool throws { SourceLoadFailure }
export declare function buildCompilationModules(check: Compilation): Status throws { SourceLoadFailure }
export declare function checkCompilationText(check: Compilation): bool throws { SourceLoadFailure }
export declare function writeCompilationText(check: Compilation): void throws { SourceLoadFailure }
export declare function printCompilationText(check: Compilation): void throws { SourceLoadFailure }

export declare function loadDiskSemanticSource(check: SemanticDisk, index: u64): void throws { SourceLoadFailure }
export declare function saveDiskSemanticEntry(
    check: SemanticDisk,
    is_native: bool,
    index: u64
): void throws { SourceLoadFailure }

export declare function verifyFpgaProgram(check: FpgaProgram): bool throws { SourceLoadFailure }
export declare function lowerFpgaProgram(check: FpgaProgram): bool throws { SourceLoadFailure }
export declare function renderFpgaProgram(check: FpgaProgram): void throws { SourceLoadFailure }
export declare function publishFpgaProgram(check: FpgaProgram): void throws { SourceLoadFailure }
