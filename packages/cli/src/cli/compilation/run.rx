<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={IO.Status} />

    <If on={$in.settings.linting}>
        <Call fn="index.runCompilationLint" in={$in.compilation} />

        <Return value={$ctx.runCompilationLint} />
    </If>

    <If on={$in.settings.formatting}>
        <Call module="format" in={$in} />

        <Return value={$ctx.format} />
    </If>

    <If on={$in.settings.library && !$in.watching}>
        <Call fn="index.openCompilationInputs" in={$in.compilation} />
    </If>

    <Call fn="index.resolveCompilationEntry" in={$in.compilation} />

    <Call fn="../lint/is_rx" />

    <If on={$ctx.is_rx && !$in.settings.library}>
        <Call fn="index.runCompilationRx" in={$in.compilation} />

        <Return value={$ctx.runCompilationRx} />
    </If>

    <Call fn="index.loadCompilationProject" in={$in.compilation} />

    <If on={!$ctx.loadCompilationProject}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call fn="../lint/is_manifest" in={$ctx.resolveCompilationEntry} />

    <If on={$in.settings.verifying && $ctx.is_manifest}>
        <Call fn="index.runCompilationLibraryProof" in={$in.compilation} />

        <Return value={$ctx.runCompilationLibraryProof} />
    </If>

    <If on={$in.settings.native && $in.settings.library}>
        <Call fn="index.runCompilationLibraryBuild" in={$in.compilation} />

        <Return value={$ctx.runCompilationLibraryBuild} />
    </If>

    <If on={$ctx.is_rx}>
        <Call fn="index.runCompilationRx" in={$in.compilation} />

        <Return value={$ctx.runCompilationRx} />
    </If>

    <Call module="application" in={$in} />

    <Return value={$ctx.application} />
</Module>
