<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Compile" />

    <Args in={Compile.Request} out={IO.Status} />

    <If on={$in.settings.linting}>
        <Return value={IO.Status.Linting} />
    </If>

    <If on={$in.settings.formatting}>
        <Call module="format" in={$in} />

        <Return value={$ctx.format} />
    </If>

    <Call
        fn="index.resolveCompilationEntry"
        in={[
            $in.compilation,
            $in.settings.library && !$in.watching
        ]}
    />

    <Call fn="../lint/is_rx" />

    <If on={$ctx.is_rx && !$in.settings.library}>
        <Return value={IO.Status.RunRx} />
    </If>

    <Call fn="index.loadCompilationProject" in={$in.compilation} />

    <If on={!$ctx.loadCompilationProject}>
        <Return value={IO.Status.Failed} />
    </If>

    <Call fn="../lint/is_manifest" in={$ctx.resolveCompilationEntry} />

    <If on={$in.settings.verifying && $ctx.is_manifest}>
        <Return value={IO.Status.LibraryProof} />
    </If>

    <If on={$in.settings.native && $in.settings.library}>
        <Return value={IO.Status.LibraryBuild} />
    </If>

    <If on={$ctx.is_rx}>
        <Return value={IO.Status.RunRx} />
    </If>

    <Call module="application" in={$in} />

    <Return value={$ctx.application} />
</Module>
