import bytes from "std:bytes"

import { slash } from "./const"

export type Input = {
    path: u8[],
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    const end = loop(in.path.length, {
        while: i => i > 0 && in.path[i - 1] == slash,
        next: i => {
            i -= 1
        },
        return: i => i
    })

    if (end == 0) {
        return false
    }

    const start = loop(end, {
        while: i => i > 0 && in.path[i - 1] != slash,
        next: i => {
            i -= 1
        },
        return: i => i
    })

    const expected = bytes.fromText(in.name)

    return end - start == expected.length &&
        bytes.startsWithText(in.path, start, in.name)
}
