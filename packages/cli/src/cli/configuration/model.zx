import type { Layout } from "../lint/index"

export type LayoutQuery = {
    explicit_kind: Layout,
    input_path: u8[]
}

export type Input = {
    path: string,
    input_path: u8[],
    explicit_kind: Layout,
    linting: bool,
    check: bool,
    write: bool
}

export type Result = {
    valid: bool,
    output?: u8[],
    diagnostic?: string,
    error_name?: string
}

export type Finalize = Input.Pick("path", "linting", "check", "write") & {
    source: u8[],
    formatted: u8[]
}
