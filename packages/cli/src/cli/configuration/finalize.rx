<Module>
    <Type from="model" as="Config" />

    <Args in={Config.Finalize} out={Config.Result} />

    <If on={$in.linting || $in.check}>
        <Call
            fn="format_status"
            in={$in.omit([
                "linting",
                "check",
                "write"
            ])}
        />

        <Return value={$ctx.format_status} />
    </If>

    <If on={$in.write}>
        <Call
            module="../workspace_files/write_bytes"
            in={{
                path: $in.path,
                data: $in.formatted
            }}
        />

        <Return
            value={{
                valid: true
            }}
        />
    </If>

    <Return
        value={{
            valid: true,
            output: $in.formatted
        }}
    />
</Module>
