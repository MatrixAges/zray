<Module>
    <Type from="../lint/index" as="IO" />

    <Args in={IO.Configuration} out={bool} />

    <Call fn="../lint/index.configurationLayout" in={$in} />

    <If on={$ctx.configurationLayout == IO.Layout.Unknown}>
        <Call fn="../lint/index.reportConfigurationKind" in={$in} />

        <Return value={false} />
    </If>

    <Call
        fn="../lint/index.readConfiguration"
        in={[
            $in,
            $ctx.configurationLayout
        ]}
    />

    <If on={$ctx.configurationLayout == IO.Layout.Lock}>
        <Call fn="../lint/index.validateConfigurationLock" in={$in} />
        <Call fn="../lint/index.configurationLinting" in={$in} />

        <If on={!$ctx.configurationLinting}>
            <Call fn="../lint/index.reportManagedLock" in={$in} />
        </If>

        <Return value={$ctx.configurationLinting} />
    </If>

    <If on={$ctx.configurationLayout == IO.Layout.Manifest}>
        <Call fn="../lint/index.formatConfigurationManifest" in={$in} />

        <If on={!$ctx.formatConfigurationManifest}>
            <Return value={false} />
        </If>

        <Else>
            <Call fn="../lint/index.validateConfigurationIndex" in={$in} />
            <Call fn="../lint/index.formatConfigurationIndex" in={$in} />
        </Else>
    </If>

    <Call fn="../lint/index.configurationChecking" in={$in} />

    <If on={$ctx.configurationChecking}>
        <Call fn="../lint/index.checkConfigurationFormatting" in={$in} />

        <Return value={$ctx.checkConfigurationFormatting} />
    </If>

    <Call fn="../lint/index.configurationWriting" in={$in} />

    <If on={$ctx.configurationWriting}>
        <Call fn="../lint/index.writeConfiguration" in={$in} />

        <Else>
            <Call fn="../lint/index.printConfiguration" in={$in} />
        </Else>
    </If>

    <Return value={true} />
</Module>
