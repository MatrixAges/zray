<Module>
    <Type from="../lint/index" as="IO" />
    <Type from="model" as="Config" />

    <Args in={Config.Input} out={bool} />

    <Call
        fn="resolve_layout"
        in={{
            explicit_kind: $in.explicit_kind,
            input_path: $in.input_path
        }}
    />

    <If on={$ctx.resolve_layout == IO.Layout.Unknown}>
        <Call fn="../lint/index.reportConfigurationKind" in={$in.host} />

        <Return value={false} />
    </If>

    <Call fn="maximum_bytes" in={$ctx.resolve_layout} />

    <Call
        fn="../lint/index.readConfiguration"
        in={[
            $in.host,
            $ctx.maximum_bytes
        ]}
    />

    <If on={$ctx.resolve_layout == IO.Layout.Lock}>
        <Call fn="../lint/index.validateConfigurationLock" in={$in.host} />

        <If on={!$in.linting}>
            <Call fn="../lint/index.reportManagedLock" in={$in.host} />
        </If>

        <Return value={$in.linting} />
    </If>

    <If on={$ctx.resolve_layout == IO.Layout.Manifest}>
        <Call fn="../lint/index.formatConfigurationManifest" in={$in.host} />

        <If on={!$ctx.formatConfigurationManifest}>
            <Return value={false} />
        </If>

        <Else>
            <Call fn="../lint/index.validateConfigurationIndex" in={$in.host} />
            <Call fn="../lint/index.formatConfigurationIndex" in={$in.host} />
        </Else>
    </If>

    <If on={$in.linting || $in.check}>
        <Call fn="../lint/index.checkConfigurationFormatting" in={$in.host} />

        <Return value={$ctx.checkConfigurationFormatting} />
    </If>

    <If on={$in.write}>
        <Call fn="../lint/index.writeConfiguration" in={$in.host} />

        <Else>
            <Call fn="../lint/index.printConfiguration" in={$in.host} />
        </Else>
    </If>

    <Return value={true} />
</Module>
