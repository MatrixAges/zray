<Module>
    <Type from="../lint/index" as="IO" />
    <Type from="model" as="Config" />

    <Args in={Config.Input} out={Config.Result} />

    <Call
        fn="resolve_layout"
        in={{
            explicit_kind: $in.explicit_kind,
            input_path: $in.input_path
        }}
    />

    <If on={$ctx.resolve_layout == IO.Layout.Unknown}>
        <Return
            value={{
                valid: false,
                diagnostic:
                    "configuration kind is unknown; use --kind manifest, index or lock\n"
            }}
        />
    </If>

    <Call fn="maximum_bytes" in={$ctx.resolve_layout} />

    <Call
        fn="../lint/index.readConfiguration"
        in={[
            $in.path,
            $ctx.maximum_bytes
        ]}
    />

    <If on={$ctx.readConfiguration.bytes == null}>
        <Return
            value={{
                valid: false,
                error_name: $ctx.readConfiguration.error_name
            }}
        />

        <Else>
            <If on={$ctx.resolve_layout == IO.Layout.Manifest}>
                <Call
                    fn="../lint/index.formatConfigurationManifest"
                    in={[
                        $ctx.readConfiguration.bytes,
                        $in.path
                    ]}
                />

                <If on={$ctx.formatConfigurationManifest.bytes == null}>
                    <Return
                        value={{
                            valid: false,
                            diagnostic: $ctx.formatConfigurationManifest.diagnostic,
                            error_name: $ctx.formatConfigurationManifest.error_name
                        }}
                    />

                    <Else>
                        <Call
                            module="finalize"
                            in={{
                                ...$in.pick([
                                    "path",
                                    "linting",
                                    "check",
                                    "write"
                                ]),
                                source: $ctx.readConfiguration.bytes,
                                formatted: $ctx.formatConfigurationManifest.bytes
                            }}
                        />

                        <Return value={$ctx.finalize} />
                    </Else>
                </If>
            </If>

            <Call
                fn="../lint/index.checkConfigurationJson"
                in={[
                    $ctx.readConfiguration.bytes,
                    $ctx.resolve_layout == IO.Layout.Lock
                ]}
            />

            <If on={$ctx.checkConfigurationJson != null}>
                <Return
                    value={{
                        valid: false,
                        error_name: $ctx.checkConfigurationJson
                    }}
                />
            </If>

            <If on={$ctx.resolve_layout == IO.Layout.Lock}>
                <If on={!$in.linting}>
                    <Return
                        value={{
                            valid: false,
                            diagnostic:
                                "pkg.lock.json is managed by zxc pkg install; use zxc lint for read-only validation\n"
                        }}
                    />
                </If>

                <Return
                    value={{
                        valid: true
                    }}
                />
            </If>

            <Call
                fn="../lint/index.formatConfigurationIndex"
                in={$ctx.readConfiguration.bytes}
            />

            <If on={$ctx.formatConfigurationIndex.bytes == null}>
                <Return
                    value={{
                        valid: false,
                        error_name: $ctx.formatConfigurationIndex.error_name
                    }}
                />

                <Else>
                    <Call
                        module="finalize"
                        in={{
                            ...$in.pick([
                                "path",
                                "linting",
                                "check",
                                "write"
                            ]),
                            source: $ctx.readConfiguration.bytes,
                            formatted: $ctx.formatConfigurationIndex.bytes
                        }}
                    />

                    <Return value={$ctx.finalize} />
                </Else>
            </If>
        </Else>
    </If>
</Module>
