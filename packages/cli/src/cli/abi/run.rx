<Module>
    <Type from="workflow" as="Abi" />
    <Type from="plan/model" as="Plan" />

    <Args in={Abi.Input} out={Abi.Output} />

    <Call fn="../compiler_rules/source_abi/scoped" in={$in.identities} />

    <If on={!$ctx.scoped}>
        <Return
            value={{
                status: Plan.Status.Valid,
                source: $in.source,
                views: []
            }}
        />
    </If>

    <Call module="plan/build" in={$in.plan} />

    <If on={$ctx.build.status != Plan.Status.Valid}>
        <Return
            value={{
                status: $ctx.build.status,
                source: $in.source,
                views: []
            }}
        />
    </If>

    <Call
        fn="files"
        in={[
            $in.names,
            $ctx.build.views
        ]}
    />

    <Call
        fn="index.renderAbiRoot"
        in={[
            $in.source,
            $ctx.build.aliases
        ]}
    />

    <Return
        value={{
            status: Plan.Status.Valid,
            source: $ctx.renderAbiRoot,
            views: $ctx.files
        }}
    />
</Module>
