import { renderAbiFile } from "bundle_abi_host"

import type { View } from "./plan/model"
import type { RenderedFile } from "./workflow"

export type Input = [string[], View[]]

export type Output = RenderedFile[]

export default function (in: Input): Output {
    const [names, views] = in

    const empty: RenderedFile[] = []

    if (views.length == 0) {
        return empty
    }

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < views.length,
        next: state => {
            const { module, name, path, aliases } = views[state.row]
            const source = renderAbiFile(names, aliases)

            state.items = state.items.push({
                module,
                name,
                path,
                source
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
