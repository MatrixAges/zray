import type { AbiFrame } from "bundle_abi_host"
import type { Input as Plan } from "./plan/model"

export type RenderedFile = {
    module: string,
    name: string,
    path: string,
    source: string
}

export type Input = {
    frame: AbiFrame,
    source: string,
    identities: string?[],
    plan: Plan
}

export type Output = {
    source: string,
    views: RenderedFile[]
}
