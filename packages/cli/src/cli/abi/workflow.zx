import type { Input as Plan, Status } from "./plan/model"

export type RenderedFile = {
    module: string,
    name: string,
    path: string,
    source: string
}

export type Input = {
    names: string[],
    source: string,
    identities: string?[],
    plan: Plan
}

export type Output = {
    status: Status,
    source: string,
    views: RenderedFile[]
}
