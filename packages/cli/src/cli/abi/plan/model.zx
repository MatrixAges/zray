import type { Bindings, Scopes } from "compiler_rules/source_abi/model"
import type { Alias } from "genz/abi/model"
import type { OptionalListColumn, TextColumn } from "memory"

export enum Status {
    Valid,
    ConflictingAlias,
    NameConflict
}

export type Natives = {
    count: u64,
    names: TextColumn,
    alias_names: OptionalListColumn,
    alias_identities: OptionalListColumn
}

export type Settings = {
    count: u64,
    names: TextColumn,
    roots: TextColumn
}

export type Input = {
    modules: Bindings,
    root: string,
    scopes: Scopes,
    natives: Natives,
    settings: Settings,
    file_count: u64,
    files: TextColumn
}

export type ViewInput = {
    source: Input,
    module: string,
    row: u64,
    count: u64
}

export type Resolved = {
    status: Status,
    aliases: Alias[],
    explicit: Alias[]
}

export type View = {
    module: string,
    name: string,
    path: string,
    aliases: Alias[]
}

export type ViewResult = {
    status: Status,
    view?: View,
    roots: Alias[]
}

export type Defaults = {
    aliases: Alias[],
    conflicts: bool[]
}

export type ViewsInput = {
    source: Input,
    defaults: Defaults
}

export type Views = {
    status: Status,
    views: View[],
    defaults: Defaults
}

export type Output = {
    status: Status,
    aliases: Alias[],
    views: View[]
}

export type Traversal = Views & {
    source: Input,
    index: u64,
    running: bool
}

export type ViewWrite = {
    state: Traversal,
    selected: ViewResult
}
