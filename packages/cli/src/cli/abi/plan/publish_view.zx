import append from "./append"

import type { ViewWrite as Input, Traversal as Output } from "./model"

export default function (in: Input): Output {
    const { state, selected } = in

    const index = state.index + 1
    const view = selected.view

    if (view == null) {
        return {
            ...state,
            status: selected.status,
            index,
            running: false
        }
    }

    const views = state.views.push(view)[0]

    const defaults = loop({
        state: state.defaults,
        index: 0
    }, {
        while: entry => entry.index < selected.roots.length,
        next: entry => {
            entry.state = append({
                state: entry.state,
                alias: selected.roots[entry.index]
            })
            entry.index += 1
        },
        return: entry => entry.state
    })

    return {
        ...state,
        views,
        defaults,
        index,
        running: index < state.source.natives.count
    }
}
