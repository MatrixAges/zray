import bytes from "std:bytes"
import memory from "memory"

import { view_prefix, view_directory, source_suffix } from "./const"
import { Status } from "./model"

import type { ViewInput as Input } from "./model"

export type Output = {
    status: Status,
    name: string,
    path: string
}

export default function (in: Input): Output {
    const name = `${view_prefix}${in.module}`

    const natives = loop({
        source: in.source.natives,
        name: bytes.fromText(name),
        index: 0,
        conflict: false
    }, {
        while: current => !current.conflict && current.index < current.source.count,
        next: current => {
            current.conflict =
                bytes.equals(
                    bytes.fromText(
                        memory.readTextColumn(
                            current.source.names,
                            current.index
                        )
                    ),
                    current.name
                )
            current.index += 1
        }
    })

    const files = loop({
        source: in.source.files,
        name: bytes.fromText(name),
        module: bytes.fromText(in.module),
        index: 0,
        count: in.source.file_count,
        conflict: natives.conflict
    }, {
        while: current => !current.conflict && current.index < current.count,
        next: current => {
            const candidate =
                bytes.fromText(memory.readTextColumn(
                    current.source,
                    current.index
                ))

            current.conflict = bytes.equals(candidate, current.name) ||
                bytes.equals(candidate, current.module)
            current.index += 1
        }
    })

    return {
        status: files.conflict ? Status.NameConflict : Status.Valid,
        name,
        path: match {
            files.conflict => "",
            _ => `${view_directory}${name}${source_suffix}`
        }
    }
}
