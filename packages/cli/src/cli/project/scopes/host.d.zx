export type NativeScopeLoad = opaque

export enum Admission {
    Valid,
    InvalidSpecifier,
    InvalidExternalSpecifier,
    InvalidNativeInterfacePath,
    InvalidNativeModule,
    ReservedNativeModule,
    DuplicateNativeModule,
    UnknownNativeDependency,
    ConflictingNativeAbiAlias,
    UnknownNativeAbiAlias
}

export type ScopeOwner = {
    owner: string,
    entry_root: string,
    compiled: bool
}

export type ScopeWindow = {
    frame: NativeScopeLoad,
    scope: ScopeOwner,
    declarations: u64,
    externals: u64,
    modules: u64,
    artifact?: string,
    library_paths: string[]
}

export type DeclarationBinding = {
    specifier: string,
    module: string
}

export type PublishedDeclaration = {
    specifier: string,
    path: string,
    module: string,
    namespace: string[]
}

export type PublishedSetting = {
    name: string,
    root: string,
    includes: string[]
}

export declare function openNativeScope(frame: NativeScopeLoad, index: u64): ScopeWindow
export declare function openNativeScopeArtifact(frame: NativeScopeLoad, path: string): void
    throws { SourceLoadFailure }
export declare function reserveNativeScopeInterfaces(frame: NativeScopeLoad): void
    throws { OutOfMemory }
export declare function readNativeScopeInterface(frame: NativeScopeLoad, row: u64): void
    throws { SourceLoadFailure }
export declare function reserveNativeScopeIndex(frame: NativeScopeLoad): void
    throws { SourceLoadFailure }
export declare function publishNativeScopeNames(
    frame: NativeScopeLoad,
    buckets: u64[],
    names: string[]
): void throws { OutOfMemory }
export declare function nativeScopeDeclaration(
    frame: NativeScopeLoad,
    row: u64,
    external: bool
): DeclarationBinding
export declare function writeNativeScopeDeclaration(
    frame: NativeScopeLoad,
    row: u64,
    external: bool,
    identity: string,
    module: string,
    copy_module: bool
): void throws { OutOfMemory }
export declare function reserveNativeScopeDeclarations(frame: NativeScopeLoad): void
    throws { OutOfMemory }
export declare function finishNativeScopeDeclarations(
    frame: NativeScopeLoad,
    declarations: PublishedDeclaration[],
    externals: string[]
): void throws { SourceLoadFailure }
export declare function publishNativeScopeLibraryPaths(
    frame: NativeScopeLoad,
    paths: string[]
): void throws { OutOfMemory }
export declare function resolveNativeScopePath(frame: NativeScopeLoad, path: string): string
    throws { OutOfMemory }
export declare function reserveNativeScopeModules(frame: NativeScopeLoad): void
    throws { OutOfMemory }
export declare function prepareNativeScopeModule(
    frame: NativeScopeLoad,
    row: u64,
    name: string,
    path: string?,
    dependencies: string[],
    includes: string[]
): void throws { OutOfMemory }
export declare function prepareNativeScopeAliases(frame: NativeScopeLoad): void
export declare function publishNativeScopeModule(
    frame: NativeScopeLoad,
    names: string[],
    specifiers: string[]
): void throws { SourceLoadFailure }
export declare function reserveNativeScopeSettings(frame: NativeScopeLoad): void
    throws { OutOfMemory }
export declare function publishNativeScopeSettings(
    frame: NativeScopeLoad,
    rows: PublishedSetting[]
): void throws { OutOfMemory }
export declare function closeNativeScope(frame: NativeScopeLoad): void
