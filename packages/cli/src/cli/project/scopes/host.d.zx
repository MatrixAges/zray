export type NativeScopeLoad = opaque

export enum Admission {
    Valid,
    InvalidSpecifier,
    InvalidExternalSpecifier,
    InvalidNativeInterfacePath,
    InvalidNativeModule,
    ReservedNativeModule,
    DuplicateNativeModule,
    UnknownNativeDependency,
    ConflictingNativeAbiAlias,
    UnknownNativeAbiAlias
}

export type ScopeOwner = {
    owner: string,
    entry_root: string,
    compiled: bool
}

export type ScopeWindow = {
    frame: NativeScopeLoad,
    scope: ScopeOwner,
    declarations: u64,
    externals: u64,
    modules: u64,
    artifact?: string,
    library_paths: string[]
}

export type Resolved = {
    identity: string,
    module: string,
    copy_module: bool
}

export type PublishedDeclaration = {
    specifier: string,
    path: string,
    module: string,
    namespace: string[]
}

export type PreparedModule = {
    name: string,
    path?: string,
    dependencies: string[],
    includes: string[]
}

export declare function openNativeScope(frame: NativeScopeLoad, index: u64): ScopeWindow
export declare function openNativeScopeArtifact(frame: NativeScopeLoad, path: string): void
    throws { SourceLoadFailure }
export declare function reserveNativeScopeInterfaces(frame: NativeScopeLoad): void
    throws { OutOfMemory }
export declare function readNativeScopeInterface(frame: NativeScopeLoad, row: u64): void
    throws { SourceLoadFailure }
export declare function publishNativeScopeNames(
    frame: NativeScopeLoad,
    buckets: u64[],
    names: string[]
): void throws { OutOfMemory }
export declare function finishNativeScopeDeclarations(
    frame: NativeScopeLoad,
    declarations: PublishedDeclaration[],
    externals: string[],
    bindings: Resolved[]
): void throws { SourceLoadFailure }
export declare function prepareNativeScopeAliases(frame: NativeScopeLoad, row: u64): void
export declare function publishNativeScopeModule(
    frame: NativeScopeLoad,
    row: u64,
    prepared: PreparedModule,
    names: string[],
    specifiers: string[]
): void throws { SourceLoadFailure }
export declare function closeNativeScope(frame: NativeScopeLoad): void
