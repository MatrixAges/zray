<Module>
    <Type from="workflow" as="Scopes" />
    <Type from="../compiler_rules/compiled/identity/aliases/model" as="Alias" />
    <Type from="index" as="Host" />

    <Args in={Scopes.Traversal} out={Scopes.Traversal} />

    <Call fn="prepare_module" in={$in} />

    <If on={$ctx.prepare_module != null}>
        <Call
            fn="index.prepareNativeScopeAliases"
            in={[
                $in.binding.window.frame,
                $in.row
            ]}
        />

        <Call
            module="../compiler_rules/compiled/identity/aliases/build"
            in={$in.aliases}
        />

        <Switch on={$ctx.build.status}>
            <Case value={Alias.Status.Conflict}>
                <Return
                    value={{
                        ...$in,
                        status: Host.Admission.ConflictingNativeAbiAlias
                    }}
                />
            </Case>

            <Case value={Alias.Status.Unknown}>
                <Return
                    value={{
                        ...$in,
                        status: Host.Admission.UnknownNativeAbiAlias
                    }}
                />
            </Case>
        </Switch>

        <Call
            fn="index.publishNativeScopeModule"
            in={[
                $in.binding.window.frame,
                $in.row,
                $ctx.prepare_module,
                $ctx.build.names,
                $ctx.build.specifiers
            ]}
        />

        <Return
            value={{
                ...$in,
                row: $in.row + 1
            }}
        />

        <Else>
            <Return
                value={{
                    ...$in,
                    status: Host.Admission.UnknownNativeDependency
                }}
            />
        </Else>
    </If>
</Module>
