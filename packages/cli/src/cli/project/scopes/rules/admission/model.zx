import type { ReadColumn, TextColumn } from "memory"
import type { Admission } from "native_scope_host"

export { Admission as Status } from "native_scope_host"

export type Index = {
    names: TextColumn,
    capacity: u64
}

export type Modules = {
    index: Index,
    count: u64,
    paths: ReadColumn,
    headers: ReadColumn
}

export type Result = {
    status: Admission,
    buckets: u64[]
}
