import { ascii_minus } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_underscore,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import {
    abi_module,
    application_module,
    builtin_module,
    root_module,
    runtime_module,
    standard_module
} from "../const"
import { Status } from "./model"

export type Input = string

export type Output = Status

export default function (in: Input): Output {
    const valid = loop({
        index: 0,
        valid: in.length != 0
    }, {
        while: current => current.valid && current.index < in.length,
        next: current => {
            const byte = in[current.index]
            const digit = byte >= ascii_digit_first && byte <= ascii_digit_last
            const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
            const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
            const word = digit || lower || upper

            current.valid = word || byte == ascii_underscore || byte == ascii_minus
            current.index += 1
        },
        return: current => current.valid
    })

    if (!valid) {
        return Status.InvalidNativeModule
    }

    return match in {
        standard_module => Status.ReservedNativeModule,
        builtin_module => Status.ReservedNativeModule,
        root_module => Status.ReservedNativeModule,
        application_module => Status.ReservedNativeModule,
        abi_module => Status.ReservedNativeModule,
        runtime_module => Status.ReservedNativeModule,
        _ => Status.Valid
    }
}
