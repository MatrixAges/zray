import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { Status } from "./model"
import moduleName from "./module_name"

import type { Modules, Result as Output } from "./model"

export type Input = Modules

export default function (in: Input): Output {
    const { names, count, paths, headers } = in

    const capacity = loop(count == 0 ? 0 : 2, {
        while: size => size < count * 2,
        next: size => {
            size *= 2
        }
    })

    const empty: u64[] = []

    const buckets = loop(empty, {
        while: items => items.length < capacity,
        next: items => {
            items = items.push(0)[0]
        }
    })

    const mask = capacity == 0 ? 0 : capacity - 1

    return loop({
        index: 0,
        status: Status.Valid,
        buckets
    }, {
        while: current => current.index < count && current.status == Status.Valid,
        next: current => {
            const path = memory.readOptionalTextColumn(paths, current.index)
            const header = memory.readOptionalTextColumn(headers, current.index)
            const name = memory.readTextColumn(names, current.index)

            current.status = match (path == null) == (header == null) {
                true => Status.InvalidNativeModule,
                _ => moduleName(name)
            }

            if (current.status == Status.Valid) {
                const key = bytes.fromText(name)
                const probe = loop({
                    slot: integers.andBits(bytes.hash(key), mask),
                    entry: 0,
                    done: false
                }, {
                    while: state => !state.done,
                    next: state => {
                        const row = current.buckets[state.slot]

                        if (row == 0) {
                            state.done = true
                        } else {
                            const candidate =
                                memory.readTextColumn(names, row - 1)

                            if (
                                bytes.equals(
                                    bytes.fromText(
                                        candidate
                                    ),
                                    key
                                )
                            ) {
                                state.entry = row
                                state.done = true
                            } else {
                                state.slot = integers.andBits(
                                    state.slot + 1,
                                    mask
                                )
                            }
                        }
                    }
                })

                if (probe.entry == 0) {
                    current.buckets =
                        current.buckets.splice(probe.slot, 1, [current.index + 1])[0]
                } else {
                    current.status = Status.DuplicateNativeModule
                }
            }

            current.index += 1
        },
        return: current => current.pick([
            "status",
            "buckets"
        ])
    })
}
