import slot from "core/bytes/index/borrowed/wide_slot"
import memory from "memory"

import { Status } from "./model"
import moduleName from "./module_name"

import type { Modules } from "./model"

export type Input = Modules

export type Output = Status

export default function (in: Input): Output {
    const { index, count, paths, headers } = in

    return loop({
        index: 0,
        status: Status.Valid
    }, {
        while: current => current.index < count && current.status == Status.Valid,
        next: current => {
            const path = memory.readOptionalTextColumn(paths, current.index)
            const header = memory.readOptionalTextColumn(headers, current.index)
            const name = memory.readTextColumn(index.names, current.index)

            current.status = match (path == null) == (header == null) {
                true => Status.InvalidNativeModule,
                _ => moduleName(name)
            }

            if (current.status == Status.Valid) {
                const previous = slot({
                    ...index,
                    name
                })

                if (previous.entry == 0) {
                    memory.writeU64(
                        index.buckets,
                        previous.slot,
                        current.index + 1
                    )
                } else {
                    current.status = Status.DuplicateNativeModule
                }
            }

            current.index += 1
        },
        return: current => current.status
    })
}
