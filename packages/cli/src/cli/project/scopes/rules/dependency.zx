import bytes from "std:bytes"
import { ascii_equals } from "core/ascii/const"
import memory from "memory"
import { Admission, requireNativeScopeAdmission } from "native_scope_host"

import registered from "./naming/registered"

import type { Binding } from "../workflow"

export type Input = {
    binding: Binding,
    dependencies: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { binding, dependencies } = in
    const { resources, registry } = binding

    if (dependencies.length == 0) {
        return dependencies
    }

    const output = memory.requireTextSlots(
        memory.allocateTextSlots(
            resources.owner,
            dependencies.length,
            null
        )
    )

    const valid = loop({
        index: 0,
        valid: true
    }, {
        while: current => current.valid && current.index < dependencies.length,
        next: current => {
            const value = dependencies[current.index]
            const separator =
                bytes.indexOfScalar(bytes.fromText(value), 0, ascii_equals)
            const first: u64 = separator == null ? 0 : separator + 1
            const size = value.length
            const target = memory.borrowTextRange(value, first, size - first)
            const resolved = registered({
                registry,
                value: target
            })

            if (resolved == null) {
                current.valid = false
            } else {
                const alias = memory.borrowTextRange(value, 0, separator ?? size)

                memory.writeTextSlot(
                    output,
                    current.index,
                    memory.copyColumnText(
                        resources.owner,
                        `${alias}=${resolved}`
                    )
                )
            }

            current.index += 1
        },
        return: current => current.valid
    })

    if (!valid) {
        requireNativeScopeAdmission(
            binding.window.frame,
            Admission.UnknownNativeDependency
        )
    }

    return memory.borrowTextSlots(output, dependencies.length)
}
