import find from "compiler_rules/compiled/identity/declaration"
import own from "compiler_rules/compiled/identity/own_declaration"
import { Admission } from "native_scope_host"

import type { Binding } from "../../workflow"

export type Input = {
    binding: Binding,
    requested: string
}

export type Output = {
    status: Admission,
    identity?: string
}

export default function (in: Input): Output {
    const { binding, requested } = in
    const { library } = binding

    const found = find({
        modules: library.modules,
        requested
    })

    if (found.conflict) {
        return {
            status: Admission.ConflictingNativeAbiAlias
        }
    }

    const identity = found.identity

    if (identity == null) {
        return {
            status: Admission.UnknownNativeAbiAlias
        }
    }

    return {
        status: Admission.Valid,
        identity: own({
            instance: library.instance,
            value: identity,
            shared: found.shared
        })
    }
}
