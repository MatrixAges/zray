import find from "compiler_rules/compiled/identity/declaration"
import own from "compiler_rules/compiled/identity/own_declaration"
import { Admission, requireNativeScopeAdmission } from "native_scope_host"

import type { Binding } from "../../workflow"

export type Input = {
    binding: Binding,
    requested: string
}

export type Output = string?

export default function (in: Input): Output {
    const { binding, requested } = in
    const { library, window } = binding

    const found = find({
        modules: library.modules,
        requested
    })

    if (found.conflict) {
        requireNativeScopeAdmission(
            window.frame,
            Admission.ConflictingNativeAbiAlias
        )
    }

    const identity = found.identity

    if (identity == null) {
        requireNativeScopeAdmission(window.frame, Admission.UnknownNativeAbiAlias)

        return null
    }

    return own({
        instance: library.instance,
        value: identity,
        shared: found.shared
    })
}
