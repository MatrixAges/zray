<Module>
    <Type from="workflow" as="Model" />
    <Type from="index" as="Host" />

    <Args in={Model.InterfaceRead} out={Model.InterfaceRead} />

    <Call fn="interface_row" in={$in} />

    <Call fn="rules/admission/interface" />

    <If on={$ctx.interface != Host.Admission.Valid}>
        <Return
            value={{
                ...$in,
                status: $ctx.interface
            }}
        />
    </If>

    <Call
        fn="index.readNativeScopeInterface"
        in={[
            $in.window.frame,
            $in.row
        ]}
    />

    <Return
        value={{
            ...$in,
            row: $in.row + 1
        }}
    />
</Module>
