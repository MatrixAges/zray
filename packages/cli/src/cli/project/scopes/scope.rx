<Module>
    <Type from="workflow" as="Scopes" />

    <Args in={Scopes.Input} out={void} />

    <Call
        fn="index.readU64"
        in={[
            $in.index,
            0
        ]}
    />

    <Call
        fn="index.openNativeScope"
        in={[
            $in.frame,
            $ctx.readU64
        ]}
    />

    <Call fn="index.checkExternals" in={$in.workspace.externals} />

    <Call
        fn="index.requireNativeScopeAdmission"
        in={[
            $in.frame,
            $ctx.checkExternals
        ]}
    />

    <Call fn="index.reserveNativeScopeInterfaces" in={$in.frame} />
    <Call fn="read" in={$ctx.openNativeScope} />
    <Call fn="index.reserveNativeScopeIndex" in={$in.frame} />
    <Call fn="index.checkModules" in={$in.workspace.modules} />

    <Call
        fn="index.requireNativeScopeAdmission"
        in={[
            $in.frame,
            $ctx.checkModules
        ]}
    />

    <Call fn="index.reserveNativeScopeNames" in={$in.frame} />

    <Call
        fn="resolve_names"
        in={{
            window: $ctx.openNativeScope,
            local: {
                items: $in.workspace.modules.index.names,
                length: $in.workspace.modules.count
            },
            resolved: $ctx.reserveNativeScopeNames,
            resources: $in.resources
        }}
    />

    <Call fn="bind" in={$in.workspace.binding} />
    <Call fn="index.publishNativeScopeDeclarations" in={$in.frame} />
    <Call fn="index.reserveNativeScopeLibraryPaths" in={$in.frame} />

    <Call
        fn="paths"
        in={{
            frame: $in.frame,
            source: $ctx.openNativeScope.library_paths,
            target: $ctx.reserveNativeScopeLibraryPaths
        }}
    />

    <Call fn="index.reserveNativeScopeModules" in={$in.frame} />
    <Call fn="modules" in={$in.workspace.binding} />
    <Call fn="index.publishNativeScopeSettings" in={$in.frame} />
    <Call fn="index.closeNativeScope" in={$in.frame} />
</Module>
