<Module>
    <Type from="workflow" as="Scopes" />
    <Type from="index" as="Host" />

    <Args in={Scopes.Input} out={Host.Admission} />

    <Call
        fn="index.openNativeScope"
        in={[
            $in.frame,
            $in.row
        ]}
    />

    <Call
        fn="../library/consumption/native_artifact"
        in={{
            path: $ctx.openNativeScope.artifact,
            modules: $ctx.openNativeScope.modules,
            interfaces: $ctx.openNativeScope.declarations,
            externals: $ctx.openNativeScope.externals
        }}
    />

    <If on={$ctx.native_artifact != null}>
        <Call
            fn="index.resolvePath"
            in={[
                $ctx.openNativeScope.scope.owner,
                $ctx.native_artifact
            ]}
        />

        <Call
            fn="index.openNativeScopeArtifact"
            in={[
                $in.frame,
                $ctx.resolvePath
            ]}
        />
    </If>

    <Call fn="index.checkExternals" in={$in.workspace.externals} />

    <If on={$ctx.checkExternals != Host.Admission.Valid}>
        <Return value={$ctx.checkExternals} />
    </If>

    <Call fn="index.reserveNativeScopeInterfaces" in={$in.frame} />

    <Loop on={$in.status == Host.Admission.Valid && $in.row < $in.window.declarations}>
        <Call
            module="read"
            in={{
                window: $ctx.openNativeScope,
                interfaces: $in.workspace.interfaces,
                row: 0,
                status: Host.Admission.Valid
            }}
        />
    </Loop>

    <If on={$ctx.read.status != Host.Admission.Valid}>
        <Return value={$ctx.read.status} />
    </If>

    <Call fn="index.reserveNativeScopeIndex" in={$in.frame} />
    <Call fn="index.checkModules" in={$in.workspace.modules} />

    <If on={$ctx.checkModules.status != Host.Admission.Valid}>
        <Return value={$ctx.checkModules.status} />
    </If>

    <Call
        fn="resolve_names"
        in={{
            window: $ctx.openNativeScope,
            local: {
                items: $in.workspace.modules.index.names,
                length: $in.workspace.modules.count
            }
        }}
    />

    <Call
        fn="index.publishNativeScopeNames"
        in={[
            $in.frame,
            $ctx.checkModules.buckets,
            $ctx.resolve_names
        ]}
    />

    <Loop
        on={$in.status == Host.Admission.Valid &&
            $in.index < $in.binding.window.declarations + $in.binding.window.externals}
    >
        <Call
            module="bind_row"
            in={{
                ...$in.workspace.pick([
                    "binding",
                    "externals",
                    "external_modules",
                    "interfaces"
                ]),
                index: 0,
                status: Host.Admission.Valid
            }}
        />
    </Loop>

    <If on={$ctx.bind_row.status != Host.Admission.Valid}>
        <Return value={$ctx.bind_row.status} />
    </If>

    <Call fn="index.reserveNativeScopeDeclarations" in={$in.frame} />

    <Call module="publish" in={$in.workspace.declarations} />

    <Call
        fn="index.finishNativeScopeDeclarations"
        in={[
            $in.frame,
            $ctx.publish.declarations,
            $ctx.publish.externals
        ]}
    />

    <Call
        fn="paths"
        in={{
            frame: $in.frame,
            source: $ctx.openNativeScope.library_paths
        }}
    />

    <Call
        fn="index.publishNativeScopeLibraryPaths"
        in={[
            $in.frame,
            $ctx.paths
        ]}
    />

    <Call fn="index.reserveNativeScopeModules" in={$in.frame} />

    <If on={$ctx.openNativeScope.modules != 0}>
        <Call module="modules" in={$in.workspace.traversal} />

        <If on={$ctx.modules != Host.Admission.Valid}>
            <Return value={$ctx.modules} />
        </If>

        <Call
            fn="settings"
            in={{
                names: $in.workspace.binding.registry.names,
                root: $ctx.openNativeScope.scope.owner,
                includes: $in.workspace.traversal.sources.default_includes
            }}
        />

        <Call
            fn="index.publishNativeScopeSettings"
            in={[
                $in.frame,
                $ctx.settings
            ]}
        />
    </If>

    <Call fn="index.closeNativeScope" in={$in.frame} />

    <Return value={Host.Admission.Valid} />
</Module>
