import { resolveNativeScopePath } from "native_scope_host"

import type { NativeScopeLoad } from "native_scope_host"

export type Input = {
    frame: NativeScopeLoad,
    source: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { frame, source } = in

    const empty: string[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < source.length,
        next: state => {
            const path = resolveNativeScopePath(frame, source[state.row])

            state.items = state.items.push(path)[0]
            state.row += 1
        },
        return: state => state.items
    })
}
