import { resolvePathParts as resolve } from "lexical_path"

export type Input = {
    root: string,
    source: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { root, source } = in

    const empty: string[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < source.length,
        next: state => {
            const path = resolve([
                root,
                source[state.row]
            ])

            state.items = state.items.push(path)[0]
            state.row += 1
        },
        return: state => state.items
    })
}
