import memory from "memory"

import type { DeclarationBinding as Output } from "./model"
import type { BindingWalk as Input } from "./workflow"

export default function (in: Input): Output {
    const { index } = in
    const { declarations } = in.binding.window

    const external = index >= declarations

    const row = external ? index - declarations : index
    const specifiers = external ? in.externals.items : in.interfaces.specifiers
    const modules = external ? in.external_modules : in.interfaces.modules

    return {
        specifier: memory.readTextColumn(specifiers, row),
        module: memory.readTextColumn(modules, row)
    }
}
