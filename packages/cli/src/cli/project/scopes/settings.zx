import memory from "memory"

import type { PublishedSetting, Settings as Input } from "./model"

export type Output = PublishedSetting[]

export default function (in: Input): Output {
    const empty: PublishedSetting[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const name = memory.readTextColumn(in.names, state.row)

            state.items = state.items.push({
                name,
                root: in.root,
                includes: in.includes
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
