import memory from "memory"
import {
    nativeScopeModulePaths,
    prepareNativeScopeModule,
    resolveNativeScopePath
} from "native_scope_host"

import paths from "./paths"
import resolveDependencies from "./rules/dependency"

import type { Traversal as Input } from "./workflow"

export type Output = void

export default function (in: Input): Output {
    const { binding, index } = in

    const row = memory.readU64(index, 0)

    const { frame } = binding.window

    const source = nativeScopeModulePaths(frame, row)

    const original = source.path

    const path: string? = match {
        original != null => resolveNativeScopePath(frame, original),
        _ => null
    }

    const dependencies = resolveDependencies({
        binding,
        dependencies: source.dependencies
    })

    const includes = prepareNativeScopeModule(
        frame,
        row,
        binding.registry.names[row],
        path,
        dependencies,
        source.includes.length
    )

    paths({
        frame,
        source: source.includes,
        target: includes
    })
}
