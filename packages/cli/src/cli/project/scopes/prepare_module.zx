import memory from "memory"
import { resolveNativeScopePath } from "native_scope_host"

import paths from "./paths"
import resolveDependencies from "./rules/dependency"

import type { Traversal as Input } from "./workflow"

export type Output = {
    name: string,
    path?: string,
    dependencies: string[],
    includes: string[]
}

export default function (in: Input): Output {
    const { binding, row, sources } = in

    const { frame } = binding.window

    const original = memory.readOptionalTextColumn(sources.paths, row)
    const explicit = memory.readOptionalTextListColumn(sources.includes, row)

    const path: string? = match {
        original != null => resolveNativeScopePath(frame, original),
        _ => null
    }

    const dependencies = resolveDependencies({
        binding,
        dependencies: memory.readTextListColumn(sources.dependencies, row)
    })

    const includes = paths({
        frame,
        source: explicit ?? sources.default_includes
    })

    return {
        name: binding.registry.names[row],
        path,
        dependencies,
        includes
    }
}
