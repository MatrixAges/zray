<Module>
    <Type from="workflow" as="Model" />

    <Args in={Model.BindingWalk} out={Model.BindingWalk} />

    <Call fn="declaration_row" in={$in} />

    <Call
        fn="bind"
        in={{
            binding: $in.binding,
            declaration: $ctx.declaration_row
        }}
    />

    <Call
        fn="advance_binding"
        in={{
            walk: $in,
            result: $ctx.bind
        }}
    />

    <Return value={$ctx.advance_binding} />
</Module>
