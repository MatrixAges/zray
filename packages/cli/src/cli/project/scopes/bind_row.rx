<Module>
    <Type from="workflow" as="Model" />

    <Args in={Model.BindingWalk} out={Model.BindingWalk} />

    <Call fn="declaration_row" in={$in} />

    <Call
        fn="bind"
        in={{
            binding: $in.binding,
            declaration: $ctx.declaration_row.declaration
        }}
    />

    <If on={$ctx.bind.resolved != null}>
        <Call
            fn="index.writeNativeScopeDeclaration"
            in={[
                $in.binding.window.frame,
                $ctx.declaration_row.row,
                $ctx.declaration_row.external,
                $ctx.bind.resolved.identity,
                $ctx.bind.resolved.module,
                $ctx.bind.resolved.copy_module
            ]}
        />

        <Return
            value={{
                ...$in,
                index: $in.index + 1
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            status: $ctx.bind.status
        }}
    />
</Module>
