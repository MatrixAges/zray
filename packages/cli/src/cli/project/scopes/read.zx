import { readNativeScopeInterface } from "native_scope_host"

import type { Read as Input } from "./workflow"

export type Output = void

export default function (in: Input): Output {
    const { frame, count } = in

    const loaded = loop(0, {
        while: row => row < count,
        next: row => {
            readNativeScopeInterface(frame, row)
            row += 1
        }
    })
}
