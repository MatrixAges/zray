import {
    nativeScopeInterfacePath,
    readNativeScopeInterface,
    requireNativeScopeAdmission
} from "native_scope_host"

import admission from "./rules/admission/interface"

import type { ScopeWindow as Input } from "native_scope_host"

export type Output = void

export default function (in: Input): Output {
    const loaded = loop(0, {
        while: row => row < in.declarations,
        next: row => {
            const { frame } = in
            const path = nativeScopeInterfacePath(frame, row)

            requireNativeScopeAdmission(frame, admission(path))
            readNativeScopeInterface(frame, row)
            row += 1
        }
    })
}
