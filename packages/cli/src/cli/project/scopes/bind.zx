import backend from "./rules/naming/backend"
import compiledIdentity from "./rules/naming/compiled"
import declaration from "./rules/naming/declaration"
import registered from "./rules/naming/registered"

import type { DeclarationBinding } from "native_scope_host"
import type { Binding } from "./workflow"

export type Input = {
    binding: Binding,
    declaration: DeclarationBinding
}

export type Resolved = {
    identity: string,
    module: string,
    copy_module: bool
}

export type Output = Resolved?

export default function (in: Input): Output {
    const { binding } = in
    const { specifier, module } = in.declaration
    const { scope } = binding.window

    const identity = match scope.compiled {
        true => compiledIdentity({
            binding,
            requested: specifier
        }),
        _ => declaration({
            owner: scope.owner,
            value: specifier
        })
    }

    if (identity == null) {
        return null
    }

    const known = registered({
        registry: binding.registry,
        value: module
    })

    const resolved = known ?? backend({
        scope,
        value: module
    })

    return {
        identity,
        module: resolved,
        copy_module: known == null
    }
}
