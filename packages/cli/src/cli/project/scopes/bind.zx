import { Admission } from "native_scope_host"

import backend from "./rules/naming/backend"
import compiledIdentity from "./rules/naming/compiled"
import declaration from "./rules/naming/declaration"
import registered from "./rules/naming/registered"

import type { DeclarationBinding } from "./model"
import type { Output as Identity } from "./rules/naming/compiled"
import type { Binding } from "./workflow"

export type Input = {
    binding: Binding,
    declaration: DeclarationBinding
}

export type Resolved = {
    identity: string,
    module: string,
    copy_module: bool
}

export type Output = {
    status: Admission,
    resolved?: Resolved
}

export default function (in: Input): Output {
    const { binding } = in
    const { specifier, module } = in.declaration
    const { scope } = binding.window

    const result: Identity = match scope.compiled {
        true => compiledIdentity({
            binding,
            requested: specifier
        }),
        _ => {
            status: Admission.InvalidExternalSpecifier,
            identity: declaration({
                owner: scope.owner,
                value: specifier
            })
        }
    }

    const { identity } = result

    if (identity == null) {
        return {
            status: result.status
        }
    }

    const known = registered({
        registry: binding.registry,
        value: module
    })

    const resolved = known ?? backend({
        scope,
        value: module
    })

    return {
        status: Admission.Valid,
        resolved: {
            identity,
            module: resolved,
            copy_module: known == null
        }
    }
}
