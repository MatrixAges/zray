import memory from "memory"
import {
    Admission,
    nativeScopeDeclaration,
    requireNativeScopeAdmission,
    writeNativeScopeDeclaration
} from "native_scope_host"

import backend from "./rules/naming/backend"
import compiledIdentity from "./rules/naming/compiled"
import declaration from "./rules/naming/declaration"
import registered from "./rules/naming/registered"

import type { Binding as Input } from "./workflow"

export type Output = void

export default function (in: Input): Output {
    const bound = loop(0, {
        while: index => index < in.window.declarations + in.window.externals,
        next: index => {
            const { window, registry, resources } = in
            const { frame, scope } = window
            const external = index >= window.declarations
            const row = match external {
                true => index - window.declarations,
                _ => index
            }

            const { specifier, module } = nativeScopeDeclaration(frame, row, external)

            const generated: string? = match scope.compiled {
                true => compiledIdentity({
                    binding: in,
                    requested: specifier
                }),
                _ => declaration({
                    owner: scope.owner,
                    value: specifier
                })
            }

            if (generated == null) {
                requireNativeScopeAdmission(
                    frame,
                    Admission.InvalidExternalSpecifier
                )
            } else {
                const identity = match scope.compiled {
                    true => generated,
                    _ => memory.copyColumnText(resources.owner, generated)
                }

                const known = registered({
                    registry,
                    value: module
                })

                const resolved =
                    known ?? memory.copyColumnText(resources.owner, backend({
                        scope,
                        value: module
                    }))

                writeNativeScopeDeclaration(
                    frame,
                    row,
                    external,
                    identity,
                    resolved
                )
            }

            index += 1
        }
    })
}
