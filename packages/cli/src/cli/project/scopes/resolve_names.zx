import memory from "memory"

import backend from "./rules/naming/backend"

import type { Rows } from "compiler_rules/project/target/select"
import type { ScopeWindow } from "native_scope_host"

export type Input = {
    window: ScopeWindow,
    local: Rows
}

export type Output = string[]

export default function (in: Input): Output {
    const { local } = in

    const empty: string[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < local.length,
        next: state => {
            const value = memory.readTextColumn(local.items, state.row)
            const name = backend({
                scope: in.window.scope,
                value
            })

            state.items = state.items.push(name)[0]
            state.row += 1
        },
        return: state => state.items
    })
}
