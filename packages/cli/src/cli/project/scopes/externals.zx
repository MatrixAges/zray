import type { Resolved } from "native_scope_host"

export type Input = {
    first: u64,
    resolved: Resolved[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { first, resolved } = in

    const empty: string[] = []

    return loop({
        row: first,
        items: empty
    }, {
        while: state => state.row < resolved.length,
        next: state => {
            state.items = state.items.push(resolved[state.row].identity)[0]
            state.row += 1
        },
        return: state => state.items
    })
}
