import memory from "memory"

import type { ExternalRows as Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const empty: string[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const identity = memory.readOptionalTextColumn(in.identities, state.row)
            const specifier = identity ?? memory.readTextColumn(in.names, state.row)

            state.items = state.items.push(specifier)[0]
            state.row += 1
        },
        return: state => state.items
    })
}
