import bytes from "std:bytes"
import memory from "memory"
import columns from "memory/columns"

import type { Externals as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { rows, output } = in

    const end = loop(0, {
        while: row => row < rows.count,
        next: row => {
            const identity = memory.readOptionalTextColumn(rows.identities, row)
            const specifier = identity ?? memory.readTextColumn(rows.names, row)

            memory.writeColumnBytes(
                output.specifiers,
                row,
                bytes.fromText(specifier)
            )
            columns.writeColumnOptionalText(output.identities, row, null)
            row += 1
        }
    })
}
