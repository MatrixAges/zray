<Module>
    <Type from="model" as="Scope" />

    <Args in={Scope.PublishInput} out={Scope.Published} />

    <Call
        fn="declarations"
        in={{
            rows: $in.declarations,
            resolved: $in.resolved
        }}
    />

    <Call
        fn="externals"
        in={{
            first: $in.declarations.count,
            resolved: $in.resolved
        }}
    />

    <Return
        value={{
            declarations: $ctx.declarations,
            externals: $ctx.externals
        }}
    />
</Module>
