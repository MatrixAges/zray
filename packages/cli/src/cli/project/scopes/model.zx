import type { ReadColumn, TextColumn, WriteColumn } from "memory"
import type { WriteColumn as Column } from "memory/columns"

export type DeclarationRows = {
    identities: ReadColumn,
    specifiers: TextColumn,
    paths: TextColumn,
    modules: TextColumn,
    namespaces: ReadColumn,
    count: u64
}

export type DeclarationOutput = {
    specifiers: WriteColumn,
    paths: WriteColumn,
    modules: WriteColumn,
    namespaces: Column
}

export type Declarations = {
    rows: DeclarationRows,
    output: DeclarationOutput
}

export type ExternalRows = {
    identities: ReadColumn,
    names: TextColumn,
    count: u64
}

export type ExternalOutput = {
    specifiers: WriteColumn,
    identities: Column
}

export type Externals = {
    rows: ExternalRows,
    output: ExternalOutput
}

export type Publication = {
    declarations: Declarations,
    externals: Externals
}

export type SettingsOutput = {
    names: WriteColumn,
    roots: WriteColumn,
    includes: Column
}

export type Settings = {
    names: TextColumn,
    root: string,
    includes: string[],
    count: u64,
    output: SettingsOutput
}
