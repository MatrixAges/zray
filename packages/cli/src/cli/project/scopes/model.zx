import type { ReadColumn, TextColumn } from "memory"

export type DeclarationBinding = {
    specifier: string,
    module: string
}

export type PublishedDeclaration = {
    specifier: string,
    path: string,
    module: string,
    namespace: string[]
}

export type PublishedSetting = {
    name: string,
    root: string,
    includes: string[]
}

export type Published = {
    declarations: PublishedDeclaration[],
    externals: string[]
}

export type DeclarationRows = {
    identities: ReadColumn,
    specifiers: TextColumn,
    paths: TextColumn,
    modules: TextColumn,
    namespaces: ReadColumn,
    count: u64
}

export type Declarations = DeclarationRows

export type ExternalRows = {
    identities: ReadColumn,
    names: TextColumn,
    count: u64
}

export type Externals = ExternalRows

export type Publication = {
    declarations: Declarations,
    externals: Externals
}

export type Settings = {
    names: string[],
    root: string,
    includes: string[]
}
