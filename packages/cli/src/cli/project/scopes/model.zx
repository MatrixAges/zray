import type { ReadColumn, TextColumn } from "memory"
import type { Resolved } from "native_scope_host"

export type DeclarationBinding = {
    specifier: string,
    module: string
}

export type PublishedDeclaration = {
    specifier: string,
    path: string,
    module: string,
    namespace: string[]
}

export type PublishedSetting = {
    name: string,
    root: string,
    includes: string[]
}

export type Published = {
    declarations: PublishedDeclaration[],
    externals: string[]
}

export type DeclarationRows = {
    paths: TextColumn,
    namespaces: ReadColumn,
    count: u64
}

export type Declarations = DeclarationRows

export type Publication = {
    declarations: Declarations
}

export type PublishInput = Publication & {
    resolved: Resolved[]
}

export type Settings = {
    names: string[],
    root: string,
    includes: string[]
}

export type Results = {
    paths: string[],
    settings: PublishedSetting[]
}
