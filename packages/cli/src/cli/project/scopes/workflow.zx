import type { Compiled, Request } from "compiler_rules/compiled/identity/aliases/model"
import type { Rows } from "compiler_rules/project/target/select"
import type { NativeScopeLoad, ScopeWindow } from "native_scope_host"
import type { Publication, Settings } from "./model"
import type { Modules } from "./rules/admission/model"
import type { Registry } from "./rules/naming/model"

export type Workspace = {
    externals: Rows,
    modules: Modules,
    binding: Binding,
    traversal: Traversal,
    declarations: Publication,
    settings: Settings
}

export type Input = {
    frame: NativeScopeLoad,
    count: u64,
    row: u64,
    workspace: Workspace
}

export type Binding = {
    window: ScopeWindow,
    registry: Registry,
    library: Compiled
}

export type Traversal = {
    binding: Binding,
    row: u64,
    aliases: Request
}
