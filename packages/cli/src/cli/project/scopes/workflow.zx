import type { Compiled, Request } from "compiler_rules/compiled/identity/aliases/model"
import type { Rows } from "compiler_rules/project/target/select"
import type { ReadColumn, TextColumn } from "memory"
import type {
    Admission,
    NativeScopeLoad,
    Resolved,
    ScopeWindow
} from "native_scope_host"
import type { Publication } from "./model"
import type { Modules } from "./rules/admission/model"
import type { Registry } from "./rules/naming/model"

export type Workspace = {
    externals: Rows,
    external_modules: TextColumn,
    interfaces: InterfacePaths,
    modules: Modules,
    binding: Binding,
    traversal: Traversal,
    declarations: Publication
}

export type Input = {
    frame: NativeScopeLoad,
    count: u64,
    row: u64,
    status: Admission,
    workspace: Workspace
}

export type Binding = {
    window: ScopeWindow,
    registry: Registry,
    library: Compiled
}

export type ModuleSources = {
    paths: ReadColumn,
    includes: ReadColumn,
    dependencies: ReadColumn,
    default_includes: string[]
}

export type Traversal = {
    binding: Binding,
    sources: ModuleSources,
    row: u64,
    status: Admission,
    aliases: Request
}

export type InterfacePaths = {
    specifiers: TextColumn,
    paths: TextColumn,
    modules: TextColumn
}

export type InterfaceRead = {
    window: ScopeWindow,
    interfaces: InterfacePaths,
    row: u64,
    status: Admission
}

export type BindingWalk =
    Workspace.Pick("externals", "external_modules", "interfaces", "binding") & {
        index: u64,
        status: Admission,
        resolved: Resolved[]
    }
