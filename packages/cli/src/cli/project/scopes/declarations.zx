import memory from "memory"

import type { Resolved } from "native_scope_host"
import type { DeclarationRows, PublishedDeclaration } from "./model"

export type Input = {
    rows: DeclarationRows,
    resolved: Resolved[]
}

export type Output = PublishedDeclaration[]

export default function (in: Input): Output {
    const { rows, resolved } = in

    const empty: PublishedDeclaration[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const { row } = state
            const { identity, module } = resolved[row]
            const path = memory.readTextColumn(rows.paths, row)
            const namespace = memory.readTextListColumn(rows.namespaces, row)

            state.items = state.items.push({
                specifier: identity,
                path,
                module,
                namespace
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
