import memory from "memory"

import type { DeclarationRows as Input, PublishedDeclaration } from "./model"

export type Output = PublishedDeclaration[]

export default function (in: Input): Output {
    const empty: PublishedDeclaration[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const { row } = state
            const identity = memory.readOptionalTextColumn(in.identities, row)
            const specifier = identity ?? memory.readTextColumn(in.specifiers, row)
            const path = memory.readTextColumn(in.paths, row)
            const module = memory.readTextColumn(in.modules, row)
            const namespace = memory.readTextListColumn(in.namespaces, row)

            state.items = state.items.push({
                specifier,
                path,
                module,
                namespace
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
