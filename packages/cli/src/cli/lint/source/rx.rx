<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SourceDocument} out={Lint.SourceResult} />

    <Call
        fn="../index.parseLintRx"
        in={[
            $in.document,
            $in.source
        ]}
    />

    <If on={$ctx.parseLintRx == null}>
        <Call
            fn="../index.validateLintRx"
            in={[
                $in.document,
                $in.input_path
            ]}
        />

        <If on={$ctx.validateLintRx != null}>
            <Return
                value={{
                    status: Lint.SourceOutcome.Invalid,
                    issue: $ctx.validateLintRx
                }}
            />
        </If>

        <Call
            fn="../index.checkLintRxValues"
            in={[
                $in.document,
                $in.input_path
            ]}
        />

        <If on={$ctx.checkLintRxValues != null}>
            <Return
                value={{
                    status: Lint.SourceOutcome.Invalid,
                    issue: $ctx.checkLintRxValues
                }}
            />
        </If>

        <Call
            fn="../index.formatLintRx"
            in={[
                $in.document,
                $in.source
            ]}
        />

        <Call
            fn="same_format"
            in={[
                $in.source,
                $ctx.formatLintRx
            ]}
        />

        <If on={$ctx.same_format}>
            <Return
                value={{
                    status: Lint.SourceOutcome.Valid
                }}
            />
        </If>

        <Return
            value={{
                status: Lint.SourceOutcome.Unformatted
            }}
        />
    </If>

    <Return
        value={{
            status: Lint.SourceOutcome.Invalid,
            issue: $ctx.parseLintRx
        }}
    />
</Module>
