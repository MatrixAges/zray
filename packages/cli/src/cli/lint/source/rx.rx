<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SourceDocument} out={Lint.SourceOutcome} />

    <Call fn="../index.parseLintRx" in={$in.host} />

    <If on={!$ctx.parseLintRx}>
        <Return value={Lint.SourceOutcome.Invalid} />
    </If>

    <Call fn="../index.validateLintRx" in={$in.host} />

    <If on={!$ctx.validateLintRx}>
        <Return value={Lint.SourceOutcome.Invalid} />
    </If>

    <Call fn="../index.checkLintRxValues" in={$in.host} />

    <If on={!$ctx.checkLintRxValues}>
        <Return value={Lint.SourceOutcome.Invalid} />
    </If>

    <Call fn="../index.formatLintRx" in={$in.host} />

    <Call
        fn="same_format"
        in={[
            $in.source,
            $ctx.formatLintRx
        ]}
    />

    <If on={$ctx.same_format}>
        <Return value={Lint.SourceOutcome.Valid} />
    </If>

    <Return value={Lint.SourceOutcome.Unformatted} />
</Module>
