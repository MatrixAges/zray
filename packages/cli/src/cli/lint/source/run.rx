<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SourceInput} out={Lint.SourceResult} />

    <Call fn="../../workspace_files/index.fromText" in={$in.input_path} />

    <Call fn="../is_rx" />

    <If on={$ctx.is_rx}>
        <Call
            module="rx"
            in={$in.pick([
                "document",
                "input_path",
                "source"
            ])}
        />

        <Return value={$ctx.rx} />
    </If>

    <Call
        fn="../index.checkLintZx"
        in={[
            $in.source,
            $in.input_path
        ]}
    />

    <If on={$ctx.checkLintZx != null}>
        <Return
            value={{
                status: Lint.SourceOutcome.Invalid,
                issue: $ctx.checkLintZx
            }}
        />
    </If>

    <Call
        fn="../index.formatLintZx"
        in={[
            $in.source,
            $in.input_path
        ]}
    />

    <Call
        fn="same_format"
        in={[
            $in.source,
            $ctx.formatLintZx
        ]}
    />

    <If on={!$ctx.same_format}>
        <Return
            value={{
                status: Lint.SourceOutcome.Unformatted
            }}
        />
    </If>

    <Call
        fn="length_diagnostic"
        in={{
            source: $in.source,
            maximum: $in.maximum_lines
        }}
    />

    <If on={$ctx.length_diagnostic == null}>
        <Return
            value={{
                status: Lint.SourceOutcome.Valid
            }}
        />
    </If>

    <Return
        value={{
            status: Lint.SourceOutcome.Invalid,
            diagnostic: $ctx.length_diagnostic
        }}
    />
</Module>
