<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SourceInput} out={bool} />

    <Call fn="../is_rx" in={$in.input_path} />

    <If on={$ctx.is_rx}>
        <Call module="rx" in={$in.host} />

        <Return value={$ctx.rx} />
    </If>

    <Call fn="../index.checkLintZx" in={$in.host} />

    <If on={!$ctx.checkLintZx}>
        <Return value={false} />
    </If>

    <Call fn="../index.formatLintZx" in={$in.host} />
    <Call fn="../index.checkLintFormatting" in={$in.host} />

    <If on={!$ctx.checkLintFormatting}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkLintLength" in={$in.host} />

    <Return value={$ctx.checkLintLength} />
</Module>
