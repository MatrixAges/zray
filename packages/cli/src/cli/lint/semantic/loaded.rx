<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SemanticLoaded} out={Lint.SemanticPass} />

    <Call fn="entry_kind" in={$in.project.entry} />

    <If on={$ctx.entry_kind != Lint.Entry.Ordinary}>
        <Call
            fn="../index.prepareSemanticSpecial"
            in={[
                $in.host,
                $in.project.entry
            ]}
        />

        <Call
            module="../special/run"
            in={{
                check: $in.host,
                store: $ctx.entry_kind == Lint.Entry.Store,
                document: $in.document,
                maximum_lines: $in.maximum_lines
            }}
        />

        <Return value={$ctx.run} />
    </If>

    <Call
        fn="../index.analyzeSemanticLibrary"
        in={[
            $in.host,
            !$in.manifest || !$in.project.has_exports,
            $in.project.entry
        ]}
    />

    <If on={$ctx.analyzeSemanticLibrary != null}>
        <Call
            module="../reachable/run"
            in={{
                items: $ctx.analyzeSemanticLibrary,
                document: $in.document,
                maximum_lines: $in.maximum_lines
            }}
        />

        <If on={$ctx.run != null}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Invalid,
                    failure: $ctx.run
                }}
            />
        </If>

        <Call
            fn="../index.linkSemanticLibrary"
            in={[
                $in.host,
                false
            ]}
        />

        <Return
            value={{
                outcome: Lint.SemanticOutcome.Valid
            }}
        />
    </If>

    <Return
        value={{
            outcome: Lint.SemanticOutcome.Invalid
        }}
    />
</Module>
