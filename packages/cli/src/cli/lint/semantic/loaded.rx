<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SemanticLoaded} out={Lint.SemanticOutcome} />

    <Call fn="entry_kind" in={$in.project.entry} />

    <If on={$ctx.entry_kind != Lint.Entry.Ordinary}>
        <Call
            fn="../index.prepareSemanticSpecial"
            in={[
                $in.host,
                $in.project.entry
            ]}
        />

        <Call
            module="../special/run"
            in={{
                check: $in.host,
                store: $ctx.entry_kind == Lint.Entry.Store
            }}
        />

        <If on={$ctx.run}>
            <Return value={Lint.SemanticOutcome.Valid} />
        </If>

        <Return value={Lint.SemanticOutcome.Invalid} />
    </If>

    <Call
        fn="../index.analyzeSemanticLibrary"
        in={[
            $in.host,
            !$in.manifest || !$in.project.has_exports,
            $in.project.entry
        ]}
    />

    <If on={!$ctx.analyzeSemanticLibrary}>
        <Return value={Lint.SemanticOutcome.Invalid} />
    </If>

    <Call fn="../index.checkSemanticSources" in={$in.host} />

    <If on={!$ctx.checkSemanticSources}>
        <Return value={Lint.SemanticOutcome.Invalid} />
    </If>

    <Call
        fn="../index.linkSemanticLibrary"
        in={[
            $in.host,
            false
        ]}
    />

    <Return value={Lint.SemanticOutcome.Valid} />
</Module>
