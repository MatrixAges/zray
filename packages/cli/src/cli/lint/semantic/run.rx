<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Lint" />

    <Args in={Lint.SemanticInput} out={bool} />

    <Call fn="../is_manifest" in={$in.input_path} />

    <If on={$ctx.is_manifest}>
        <Call fn="../index.checkSemanticManifest" in={$in.host} />

        <If on={!$ctx.checkSemanticManifest}>
            <Return value={false} />
        </If>

        <Else>
            <Call fn="../is_source" in={$in.input_path} />

            <If on={!$ctx.is_source}>
                <Call fn="../index.rejectSemanticLintInput" in={$in.host} />
            </If>
        </Else>
    </If>

    <Call fn="../index.loadSemanticProject" in={$in.host} />

    <If on={!$ctx.loadSemanticProject}>
        <Return value={false} />
    </If>

    <If on={!$ctx.is_manifest}>
        <Call fn="../index.clearSemanticLibrary" in={$in.host} />
    </If>

    <Call
        fn="../index.semanticEntry"
        in={[
            $in.host,
            $ctx.is_manifest
        ]}
    />

    <If on={$ctx.semanticEntry != IO.Entry.Ordinary}>
        <Call
            fn="../index.checkSemanticSpecial"
            in={[
                $in.host,
                $ctx.is_manifest,
                $ctx.semanticEntry == IO.Entry.Store
            ]}
        />

        <Return value={$ctx.checkSemanticSpecial} />
    </If>

    <Call fn="../index.semanticHasExports" in={$in.host} />

    <If on={!$ctx.is_manifest || !$ctx.semanticHasExports}>
        <Call
            fn="../index.useSemanticEntryExport"
            in={[
                $in.host,
                $ctx.is_manifest
            ]}
        />
    </If>

    <Call fn="../index.analyzeSemanticLibrary" in={$in.host} />

    <If on={!$ctx.analyzeSemanticLibrary}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkSemanticSources" in={$in.host} />

    <If on={!$ctx.checkSemanticSources}>
        <Return value={false} />
    </If>

    <Call fn="../index.linkSemanticLibrary" in={$in.host} />

    <Return value={true} />
</Module>
