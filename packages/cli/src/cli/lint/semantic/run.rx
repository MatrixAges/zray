<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SemanticInput} out={Lint.SemanticOutcome} />

    <Call fn="../is_manifest" in={$in.input_path} />

    <If on={$ctx.is_manifest}>
        <Call fn="../index.checkSemanticManifest" in={$in.host} />

        <If on={!$ctx.checkSemanticManifest}>
            <Return value={Lint.SemanticOutcome.Invalid} />
        </If>

        <Else>
            <Call fn="../is_source" in={$in.input_path} />

            <If on={!$ctx.is_source}>
                <Return value={Lint.SemanticOutcome.InvalidInput} />
            </If>
        </Else>
    </If>

    <Call
        fn="../index.loadSemanticProject"
        in={[
            $in.host,
            $ctx.is_manifest
        ]}
    />

    <If on={$ctx.loadSemanticProject != null}>
        <Call
            module="loaded"
            in={{
                host: $in.host,
                manifest: $ctx.is_manifest,
                project: $ctx.loadSemanticProject
            }}
        />

        <Return value={$ctx.loaded} />
    </If>

    <Return value={Lint.SemanticOutcome.Invalid} />
</Module>
