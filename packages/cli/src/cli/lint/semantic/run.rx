<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.SemanticInput} out={Lint.SemanticResult} />

    <Call fn="../is_manifest" in={$in.configuration.input_path} />

    <Call
        module="configuration"
        in={{
            manifest: $ctx.is_manifest,
            request: $in.configuration
        }}
    />

    <If on={$ctx.configuration != null}>
        <If on={!$ctx.configuration.valid}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Invalid,
                    configuration: $ctx.configuration
                }}
            />
        </If>

        <Else>
            <Call fn="../is_source" in={$in.configuration.input_path} />

            <If on={!$ctx.is_source}>
                <Return
                    value={{
                        outcome: Lint.SemanticOutcome.InvalidInput
                    }}
                />
            </If>
        </Else>
    </If>

    <Call
        fn="../index.loadSemanticProject"
        in={[
            $in.host,
            $ctx.is_manifest
        ]}
    />

    <If on={$ctx.loadSemanticProject != null}>
        <Call
            module="loaded"
            in={{
                host: $in.host,
                document: $in.document,
                maximum_lines: $in.maximum_lines,
                manifest: $ctx.is_manifest,
                project: $ctx.loadSemanticProject
            }}
        />

        <Return
            value={{
                ...$ctx.loaded,
                configuration: $ctx.configuration
            }}
        />
    </If>

    <Return
        value={{
            outcome: Lint.SemanticOutcome.Invalid,
            configuration: $ctx.configuration
        }}
    />
</Module>
