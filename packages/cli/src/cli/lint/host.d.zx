export type SourceLint = opaque

export type SemanticLint = opaque

export type WorkspaceLint = opaque

export type SemanticProject = {
    entry?: string,
    has_exports: bool
}

export enum Layout {
    Unknown,
    Manifest,
    Index,
    Lock
}


export type ConfigurationContent = {
    bytes?: u8[],
    diagnostic?: string,
    error_name?: string
}

export declare function parseLintRx(check: SourceLint): bool throws { SourceLoadFailure }
export declare function validateLintRx(check: SourceLint): bool throws { SourceLoadFailure }
export declare function checkLintRxValues(check: SourceLint): bool throws { SourceLoadFailure }
export declare function formatLintRx(check: SourceLint): u8[] throws { SourceLoadFailure }
export declare function checkLintZx(check: SourceLint): bool throws { SourceLoadFailure }
export declare function formatLintZx(check: SourceLint): u8[] throws { SourceLoadFailure }

export declare function loadSemanticProject(
    check: SemanticLint,
    manifest: bool
): SemanticProject? throws { SourceLoadFailure }
export declare function prepareSemanticSpecial(check: SemanticLint, entry: string?): void throws { SourceLoadFailure }
export declare function analyzeSemanticLibrary(check: SemanticLint, use_entry: bool, entry: string?): bool throws { SourceLoadFailure }
export declare function checkSemanticSources(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function linkSemanticLibrary(check: SemanticLint, gateway: bool): void throws { SourceLoadFailure }

export declare function checkSpecialSource(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function collectLintStore(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function collectLintStoreTypes(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function checkLintStoreTypes(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function analyzeLintGateway(check: SemanticLint): bool? throws { SourceLoadFailure }
export declare function checkLintServices(check: SemanticLint): bool throws { SourceLoadFailure }

export declare function discoverLintWorkspace(check: WorkspaceLint): bool throws { SourceLoadFailure }
export declare function resolveLintWorkspace(check: WorkspaceLint): string? throws { SourceLoadFailure }
export declare function lintMemberSemantics(check: WorkspaceLint, path: string): bool throws { SourceLoadFailure }
export declare function lintMemberConfiguration(check: WorkspaceLint, path: string): bool throws { SourceLoadFailure }

export declare function checkReachableLintSource(check: SourceLint, path: u8[], source: u8[]): bool
    throws { SourceLoadFailure }

export declare function checkReachableLintStore(check: SourceLint, path: u8[]): bool
    throws { SourceLoadFailure }

export declare function readConfiguration(
    allocator,
    io,
    path: string,
    maximum_bytes: u64
): ConfigurationContent throws { OutOfMemory, Canceled }

export declare function formatConfigurationManifest(
    allocator,
    input: u8[],
    path: string
): ConfigurationContent throws { OutOfMemory, Canceled }

export declare function checkConfigurationJson(allocator, input: u8[], lock: bool): string?
    throws { OutOfMemory, Canceled }

export declare function formatConfigurationIndex(allocator, input: u8[]): ConfigurationContent
    throws { OutOfMemory, Canceled }
