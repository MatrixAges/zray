export type SourceLint = opaque

export type SemanticLint = opaque

export type WorkspaceLint = opaque

export type SemanticProject = {
    entry?: string,
    has_exports: bool
}

export type LintItem = {
    path: string,
    source?: u8[]
}

export type LintGateway = {
    valid: bool,
    services?: LintItem[]
}

export enum Layout {
    Unknown,
    Manifest,
    Index,
    Lock
}


export type ConfigurationContent = {
    bytes?: u8[],
    diagnostic?: string,
    error_name?: string
}

export type SourceIssue = {
    line: u64,
    column: u64,
    code: string,
    message: string
}

export type WorkspaceMember = {
    path: string,
    entry?: string,
    export_count: u64
}

export type WorkspacePlan = {
    root: string,
    root_manifest: string,
    members: WorkspaceMember[]
}

export declare function parseLintRx(
    allocator,
    document: SourceLint,
    source: u8[]
): SourceIssue? throws { OutOfMemory }
export declare function validateLintRx(
    allocator,
    document: SourceLint,
    path: string
): SourceIssue? throws { OutOfMemory }
export declare function checkLintRxValues(
    allocator,
    document: SourceLint,
    path: string
): SourceIssue? throws { OutOfMemory }
export declare function formatLintRx(allocator, document: SourceLint, source: u8[]): u8[]
    throws { OutOfMemory }
export declare function checkLintZx(allocator, source: u8[], path: string): SourceIssue?
    throws { OutOfMemory }
export declare function formatLintZx(allocator, source: u8[], path: string): u8[]
    throws { OutOfMemory }

export declare function loadSemanticProject(
    check: SemanticLint,
    manifest: bool
): SemanticProject? throws { SourceLoadFailure }
export declare function prepareSemanticSpecial(check: SemanticLint, entry: string?): void throws { SourceLoadFailure }
export declare function analyzeSemanticLibrary(
    check: SemanticLint,
    use_entry: bool,
    entry: string?
): LintItem[]? throws { SourceLoadFailure }
export declare function linkSemanticLibrary(check: SemanticLint, gateway: bool): void throws { SourceLoadFailure }

export declare function checkSpecialSource(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function collectLintStore(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function collectLintStoreTypes(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function checkLintStoreTypes(check: SemanticLint): bool throws { SourceLoadFailure }
export declare function analyzeLintGateway(check: SemanticLint): LintGateway throws { SourceLoadFailure }

export declare function discoverLintWorkspace(check: WorkspaceLint): bool throws { SourceLoadFailure }
export declare function resolveLintWorkspace(allocator, check: WorkspaceLint): WorkspacePlan? throws { SourceLoadFailure, OutOfMemory }
export declare function lintMemberSemantics(check: WorkspaceLint, path: string, root_manifest: string): bool throws { SourceLoadFailure }
export declare function lintMemberConfiguration(check: WorkspaceLint, path: string, root_manifest: string): bool throws { SourceLoadFailure }

export declare function readConfiguration(
    allocator,
    io,
    path: string,
    maximum_bytes: u64
): ConfigurationContent throws { OutOfMemory, Canceled }

export declare function formatConfigurationManifest(
    allocator,
    input: u8[],
    path: string
): ConfigurationContent throws { OutOfMemory, Canceled }

export declare function checkConfigurationJson(allocator, input: u8[], lock: bool): string?
    throws { OutOfMemory, Canceled }

export declare function formatConfigurationIndex(allocator, input: u8[]): ConfigurationContent
    throws { OutOfMemory, Canceled }
