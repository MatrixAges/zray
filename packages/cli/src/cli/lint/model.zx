import type {
    Layout,
    SemanticLint,
    SemanticProject,
    SourceLint,
    WorkspaceLint
} from "./index"
import type { MemberRows } from "./workspace/model"

export enum Entry {
    Ordinary,
    Store,
    Gateway
}

export enum SemanticOutcome {
    Valid,
    Invalid,
    InvalidInput
}

export enum WorkspaceOutcome {
    Valid,
    Invalid,
    ManifestRequired
}

export enum CommandAction {
    Workspace,
    Semantic,
    Configuration,
    InvalidInput,
    Source
}

export type CommandInput = {
    input_path: u8[],
    explicit_kind: Layout,
    workspace: bool,
    semantic: bool
}

export enum SourceOutcome {
    Valid,
    Invalid,
    Unformatted
}

export type SourceResult = {
    status: SourceOutcome,
    diagnostic?: string
}

export type SourceDocument = {
    host: SourceLint,
    source: u8[]
}

export type SourceInput = SourceDocument & {
    maximum_lines: u64,
    input_path: u8[]
}

export type SemanticInput = {
    host: SemanticLint,
    input_path: u8[]
}

export type SemanticLoaded = {
    host: SemanticLint,
    manifest: bool,
    project: SemanticProject
}

export type WorkspaceInput = {
    host: WorkspaceLint,
    input_path: u8[],
    members: MemberRows
}
