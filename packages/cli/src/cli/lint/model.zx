import type {
    Command,
    Layout,
    SemanticLint,
    SemanticProject,
    SourceLint,
    WorkspaceLint
} from "./index"

export enum Entry {
    Ordinary,
    Store,
    Gateway
}

export enum SemanticOutcome {
    Valid,
    Invalid,
    InvalidInput
}

export enum WorkspaceOutcome {
    Valid,
    Invalid,
    ManifestRequired
}

export type CommandInput = {
    host: Command,
    input_path: u8[],
    explicit_kind: Layout,
    workspace: bool,
    semantic: bool
}

export type SourceInput = {
    host: SourceLint,
    input_path: u8[]
}

export type SemanticInput = {
    host: SemanticLint,
    input_path: u8[]
}

export type SemanticLoaded = {
    host: SemanticLint,
    manifest: bool,
    project: SemanticProject
}

export type WorkspaceInput = {
    host: WorkspaceLint,
    input_path: u8[]
}
