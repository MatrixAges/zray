import type {
    Input as ConfigurationInput,
    Result as ConfigurationResult
}
from "../configuration/model"
import type {
    Layout,
    SemanticLint,
    SemanticProject,
    SourceIssue,
    SourceLint,
    WorkspaceLint
} from "./index"

export enum Entry {
    Ordinary,
    Store,
    Gateway
}

export enum SemanticOutcome {
    Valid,
    Invalid,
    InvalidInput
}

export enum WorkspaceOutcome {
    Valid,
    Invalid,
    ManifestRequired
}

export enum CommandAction {
    Workspace,
    Semantic,
    Configuration,
    InvalidInput,
    Source
}

export type CommandInput = {
    input_path: u8[],
    explicit_kind: Layout,
    workspace: bool,
    semantic: bool
}

export enum SourceOutcome {
    Valid,
    Invalid,
    Unformatted
}

export type SourceResult = {
    status: SourceOutcome,
    diagnostic?: string,
    issue?: SourceIssue
}

export type SourceDocument = {
    document: SourceLint,
    input_path: string,
    source: u8[]
}

export type SourceInput = SourceDocument & {
    maximum_lines?: u64
}

export type ReachableFailure = {
    path: string,
    result?: SourceResult,
    error_name?: string
}

export type SourceOptions = {
    document: SourceLint,
    maximum_lines?: u64
}

export type SemanticInput = SourceOptions & {
    host: SemanticLint,
    configuration: ConfigurationInput
}

export type SemanticConfiguration = {
    manifest: bool,
    request: ConfigurationInput
}

export type SemanticPass = {
    outcome: SemanticOutcome,
    failure?: ReachableFailure
}

export type SemanticResult = SemanticPass & {
    configuration?: ConfigurationResult
}

export type SemanticLoaded = SourceOptions & {
    host: SemanticLint,
    manifest: bool,
    project: SemanticProject
}

export type WorkspaceInput = {
    host: WorkspaceLint,
    input_path: u8[]
}
