import { rx_suffix, zx_suffix } from "./const"
import endsWith from "./ends_with"

export type Input = u8[]

export type Output = bool

export default function (in: Input): Output {
    if (endsWith({
        text: in,
        suffix: zx_suffix
    })) {
        return true
    }

    return endsWith({
        text: in,
        suffix: rx_suffix
    })
}
