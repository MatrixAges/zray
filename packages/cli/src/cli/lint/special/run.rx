<Module>
    <Type from="model" as="Special" />
    <Type from="../model" as="Lint" />

    <Args in={Special.Input} out={Lint.SemanticPass} />

    <Call fn="../index.checkSpecialSource" in={$in.check} />

    <If on={!$ctx.checkSpecialSource}>
        <Return
            value={{
                outcome: Lint.SemanticOutcome.Invalid
            }}
        />
    </If>

    <If on={$in.store}>
        <Call fn="../index.collectLintStore" in={$in.check} />

        <If on={!$ctx.collectLintStore}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Invalid
                }}
            />
        </If>

        <Call fn="../index.collectLintStoreTypes" in={$in.check} />

        <If on={!$ctx.collectLintStoreTypes}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Invalid
                }}
            />
        </If>

        <Call fn="../index.checkLintStoreTypes" in={$in.check} />

        <If on={$ctx.checkLintStoreTypes}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Valid
                }}
            />
        </If>

        <Return
            value={{
                outcome: Lint.SemanticOutcome.Invalid
            }}
        />
    </If>

    <Call fn="../index.analyzeLintGateway" in={$in.check} />

    <If on={!$ctx.analyzeLintGateway.valid}>
        <Return
            value={{
                outcome: Lint.SemanticOutcome.Invalid
            }}
        />
    </If>

    <If on={$ctx.analyzeLintGateway.services != null}>
        <Call
            module="../reachable/run"
            in={{
                items: $ctx.analyzeLintGateway.services,
                document: $in.document,
                maximum_lines: $in.maximum_lines
            }}
        />

        <If on={$ctx.run != null}>
            <Return
                value={{
                    outcome: Lint.SemanticOutcome.Invalid,
                    failure: $ctx.run
                }}
            />
        </If>
    </If>

    <Call
        fn="../index.linkSemanticLibrary"
        in={[
            $in.check,
            true
        ]}
    />

    <Return
        value={{
            outcome: Lint.SemanticOutcome.Valid
        }}
    />
</Module>
