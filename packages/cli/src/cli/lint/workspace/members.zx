import lintMember from "./member.rx"

import type { Members as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { check, count } = in

    const first: u64 = 0

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.index < count,
        next: state => {
            const valid = lintMember([
                check,
                state.index
            ])

            state.valid = valid && state.valid
            state.index += 1
        },
        return: state => state.valid
    })
}
