<Module>
    <Type from="../model" as="Lint" />

    <Args in={Lint.WorkspaceInput} out={Lint.WorkspaceOutcome} />

    <Call fn="../is_manifest" in={$in.input_path} />

    <If on={!$ctx.is_manifest}>
        <Return value={Lint.WorkspaceOutcome.ManifestRequired} />
    </If>

    <Call fn="../index.discoverLintWorkspace" in={$in.host} />

    <If on={!$ctx.discoverLintWorkspace}>
        <Return value={Lint.WorkspaceOutcome.Invalid} />
    </If>

    <Call fn="../index.resolveLintWorkspace" in={$in.host} />

    <If on={$ctx.resolveLintWorkspace != null}>
        <Loop on={$in.running}>
            <Call
                module="members"
                in={{
                    check: $in.host,
                    root: $ctx.resolveLintWorkspace,
                    members: $in.members,
                    index: 0,
                    valid: true,
                    running: $in.members.count != 0
                }}
            />
        </Loop>

        <If on={$ctx.members.valid}>
            <Return value={Lint.WorkspaceOutcome.Valid} />
        </If>
    </If>

    <Return value={Lint.WorkspaceOutcome.Invalid} />
</Module>
