<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Members} out={Step.Members} />

    <Call
        module="member"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.member && $in.valid,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
