import type { WorkspaceLint } from "lint_workflow_host"
import type { ListColumn, ReadColumn, TextColumn } from "memory"

export type MemberRows = {
    paths: TextColumn,
    entries: ReadColumn,
    exports: ListColumn,
    count: u64
}

export type Member = {
    check: WorkspaceLint,
    members: MemberRows,
    root: string,
    index: u64
}

export type Members = Member & {
    valid: bool,
    running: bool
}
