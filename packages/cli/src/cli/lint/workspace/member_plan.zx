import resolvePathParts from "../../standard/path/resolve"
import { manifest_file } from "../const"

import type { Member as Input } from "./model"

export type Output = {
    path: string,
    semantic: bool
}

export default function (in: Input): Output {
    const { plan, index } = in

    const member = plan.members[index]

    const path = resolvePathParts([
        plan.root,
        member.path,
        manifest_file
    ])

    return {
        path,
        semantic: member.entry != null || member.export_count != 0
    }
}
