<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Member} out={bool} />

    <Call fn="member_plan" in={$in} />

    <If on={$ctx.member_plan.semantic}>
        <Call
            fn="../index.lintMemberSemantics"
            in={[
                $in.check,
                $ctx.member_plan.path
            ]}
        />

        <Return value={$ctx.lintMemberSemantics} />
    </If>

    <Call
        fn="../index.lintMemberConfiguration"
        in={[
            $in.check,
            $ctx.member_plan.path
        ]}
    />

    <Return value={$ctx.lintMemberConfiguration} />
</Module>
