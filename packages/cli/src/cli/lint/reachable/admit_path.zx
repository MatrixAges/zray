import type { AdmitInput as Input } from "./model"

export type Output = bool

export default function (in: Input, {
    $store
}): Output {
    const existing = loop(0, {
        while: i =>
            i < in.visited.paths.length &&
            in.visited.paths[i] != in.path,
        next: i => {
            i += 1
        },
        return: i => i < in.visited.paths.length
    })

    if (existing) {
        return false
    }

    $store.seen.visited = {
        paths: in.visited.paths.push(in.path)[0]
    }

    return true
}
