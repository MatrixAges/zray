import { admitReachableLintSource, checkReachableLintSource } from "lint_workflow_host"

import type { Rows as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { check, count } = in

    const first: u64 = 0

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            if (admitReachableLintSource(check, state.index)) {
                state.valid = checkReachableLintSource(check)
            }

            state.index += 1
        },
        return: state => state.valid
    })
}
