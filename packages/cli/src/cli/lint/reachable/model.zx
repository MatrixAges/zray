import type { LintItem } from "lint_workflow_host"
import type { ReachableFailure, SourceOptions, SourceResult } from "../model"

export type Visited = {
    paths: string[]
}

export type Item = LintItem

export type Input = SourceOptions & {
    items: Item[]
}

export type Walk = Input & {
    index: u64,
    failure?: Failure,
    running: bool
}

export type AdmitInput = {
    path: string,
    visited: Visited
}

export type Failure = ReachableFailure

export type Check = SourceOptions & {
    item: Item
}

export type CheckedItem = {
    path: string,
    result: SourceResult
}
