import type { SourceLint } from "../index"
import type { SourceResult } from "../model"

export type Visited = {
    paths: string[]
}

export type Item = {
    path: string,
    source?: u8[]
}

export type Input = {
    document: SourceLint,
    maximum_lines: u64,
    items: Item[]
}

export type Walk = Input & {
    index: u64,
    failure?: Failure,
    running: bool
}

export type AdmitInput = {
    path: string,
    visited: Visited
}

export type Failure = {
    path: string,
    result?: SourceResult,
    error_name?: string
}

export type Check = {
    document: SourceLint,
    item: Item,
    maximum_lines: u64
}

export type CheckedItem = {
    path: string,
    result: SourceResult
}
