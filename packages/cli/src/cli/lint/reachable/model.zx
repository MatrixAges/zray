import type { SourceLint } from "lint_workflow_host"

export type Visited = {
    paths: u8[][]
}

export type Item = {
    path: u8[],
    source?: u8[]
}

export type Input = {
    check: SourceLint,
    items: Item[]
}

export type Walk = {
    check: SourceLint,
    items: Item[],
    index: u64,
    valid: bool,
    running: bool
}

export type AdmitInput = {
    path: u8[],
    visited: Visited
}
