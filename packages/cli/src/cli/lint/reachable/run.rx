<Module>
    <Type from="../index" as="IO" />

    <Args in={IO.ReachableLint} out={bool} />

    <Call fn="../index.reachableLintModuleCount" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                check: $in,
                count: $ctx.reachableLintModuleCount,
                index: 0,
                valid: true,
                running: $ctx.reachableLintModuleCount != 0
            }}
        />
    </Loop>

    <Return value={$ctx.walk.valid} />
</Module>
