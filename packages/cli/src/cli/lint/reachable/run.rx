<Module>
    <Type from="model" as="Reachable" />

    <Args in={Reachable.Input} out={bool} />

    <Store from="seen" as="seen" />

    <If on={$in.items.length == 0}>
        <Return value={true} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                check: $in.check,
                items: $in.items,
                index: 0,
                valid: true,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.step.valid} />
</Module>
