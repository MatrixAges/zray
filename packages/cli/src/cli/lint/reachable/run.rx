<Module>
    <Type from="model" as="Reachable" />

    <Args in={Reachable.Input} out={Reachable.Failure?} />

    <Store from="seen" as="seen" />

    <If on={$in.items.length == 0}>
        <Return value={null} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                ...$in,
                index: 0,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.step.failure} />
</Module>
