import { reachableLintModuleCount } from "lint_workflow_host"

import lintModule from "./module.rx"

import type { ReachableLint as Input } from "lint_workflow_host"

export type Output = bool

export default function (in: Input): Output {
    const count = reachableLintModuleCount(in)
    const first: u64 = 0

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            state.valid = lintModule([
                in,
                state.index
            ])

            state.index += 1
        },
        return: state => state.valid
    })
}
