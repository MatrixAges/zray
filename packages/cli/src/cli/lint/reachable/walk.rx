<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Walk} out={Step.Walk} />

    <Call
        module="module"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.module,
            running: $ctx.module && $in.index + 1 < $in.count
        }}
    />
</Module>
