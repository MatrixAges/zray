<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Walk} out={Step.Walk} />

    <Store from="seen" as="seen" />

    <Call fn="item" in={$in} />

    <Call
        fn="admit_path"
        in={{
            path: $ctx.item.path,
            visited: $store.seen.visited
        }}
        setter={[$store.seen.visited]}
    />

    <If on={$ctx.admit_path}>
        <Call
            module="check"
            in={{
                document: $in.document,
                item: $ctx.item,
                maximum_lines: $in.maximum_lines
            }}
        />

        <If on={$ctx.check != null}>
            <Return
                value={{
                    ...$in,
                    failure: $ctx.check,
                    running: false
                }}
            />
        </If>
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.items.length
        }}
    />
</Module>
