<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Walk} out={Step.Walk} />

    <Store from="seen" as="seen" />

    <Call
        fn="admit_path"
        in={{
            path: $in.items[$in.index].path,
            visited: store.seen.visited
        }}
        setter={[store.seen.visited]}
    />

    <If on={$ctx.admit_path}>
        <If on={$in.items[$in.index].is_store}>
            <Call
                fn="../index.checkReachableLintStore"
                in={[
                    $in.check,
                    $in.items[$in.index].row
                ]}
            />

            <Return
                value={{
                    ...$in,
                    index: $in.index + 1,
                    valid: $ctx.checkReachableLintStore,
                    running:
                        $ctx.checkReachableLintStore &&
                        $in.index + 1 < $in.items.length
                }}
            />

            <Else>
                <Call
                    fn="../index.checkReachableLintSource"
                    in={[
                        $in.check,
                        $in.items[$in.index].row
                    ]}
                />

                <Return
                    value={{
                        ...$in,
                        index: $in.index + 1,
                        valid: $ctx.checkReachableLintSource,
                        running:
                            $ctx.checkReachableLintSource &&
                            $in.index + 1 < $in.items.length
                    }}
                />
            </Else>
        </If>

        <Else>
            <Return
                value={{
                    ...$in,
                    index: $in.index + 1,
                    running: $in.index + 1 < $in.items.length
                }}
            />
        </Else>
    </If>
</Module>
