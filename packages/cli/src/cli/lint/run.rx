<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Lint" />

    <Args in={Lint.CommandInput} out={Lint.CommandAction} />

    <If on={$in.workspace}>
        <Return value={Lint.CommandAction.Workspace} />
    </If>

    <If on={$in.semantic}>
        <Return value={Lint.CommandAction.Semantic} />
    </If>

    <Call
        fn="../configuration/resolve_layout"
        in={{
            explicit_kind: $in.explicit_kind,
            input_path: $in.input_path
        }}
    />

    <If on={$ctx.resolve_layout != IO.Layout.Unknown}>
        <Return value={Lint.CommandAction.Configuration} />
    </If>

    <Call fn="is_source" in={$in.input_path} />

    <If on={!$ctx.is_source}>
        <Return value={Lint.CommandAction.InvalidInput} />
    </If>

    <Return value={Lint.CommandAction.Source} />
</Module>
