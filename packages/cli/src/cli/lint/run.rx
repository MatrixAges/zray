<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Lint" />

    <Args in={Lint.CommandInput} out={bool} />

    <If on={$in.workspace}>
        <Call fn="index.lintWorkspace" in={$in.host} />

        <Return value={$ctx.lintWorkspace} />
    </If>

    <If on={$in.semantic}>
        <Call fn="index.lintSemantic" in={$in.host} />

        <Return value={$ctx.lintSemantic} />
    </If>

    <Call
        fn="../configuration/resolve_layout"
        in={{
            explicit_kind: $in.explicit_kind,
            input_path: $in.input_path
        }}
    />

    <If on={$ctx.resolve_layout != IO.Layout.Unknown}>
        <Call fn="index.lintConfiguration" in={$in.host} />

        <Return value={$ctx.lintConfiguration} />
    </If>

    <Call fn="is_source" in={$in.input_path} />

    <If on={!$ctx.is_source}>
        <Call fn="index.reportLintInput" in={$in.host} />

        <Return value={false} />
    </If>

    <Call fn="index.lintSourceFile" in={$in.host} />

    <Return value={$ctx.lintSourceFile} />
</Module>
