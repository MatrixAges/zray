import { recordGatewayService } from "rx_execution_host"

import type { GatewayAnalysis } from "rx_execution_host"

export type Input = {
    analysis: GatewayAnalysis,
    count: u64
}

export type Output = void

export default function (in: Input): Output {
    const { analysis, count } = in

    const recorded = loop(0, {
        while: index => index < count,
        next: index => {
            recordGatewayService(analysis, index)

            index += 1
        }
    })
}
