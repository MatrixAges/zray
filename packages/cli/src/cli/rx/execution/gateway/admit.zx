import { build_mode } from "./const"

import type { Settings as Input } from "../../../compilation/model"

export type Output = {
    valid: bool,
    diagnostic?: string
}

export default function (in: Input): Output {
    const permitted = (
        - in.native
        - and !in.verifying
        - and !in.fpga
        - and in.json_result
    )

    return {
        valid: permitted,
        diagnostic: permitted ? null : build_mode
    }
}
