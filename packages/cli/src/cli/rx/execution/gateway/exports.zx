import integer from "std:integer"

import type { GatewayRoutes, GatewayService } from "rx_execution_host"

export type Input = GatewayRoutes

export type Output = GatewayService[]

export default function (in: Input): Output {
    const empty: GatewayService[] = []

    return loop({
        index: 0,
        services: empty
    }, {
        while: row => row.index < in.service_routes.length,
        next: row => {
            const route = integer.widen(in.service_routes[row.index])

            const service = in.route_services[route]

            row.services = row.services.push({
                name: service,
                source: service
            })[0]
            row.index += 1
        },
        return: row => row.services
    })
}
