<Module>
    <Type from="model" as="Gateway" />

    <Args in={Gateway.AnalysisInput} out={Gateway.AnalysisOutcome} />

    <If on={$in.has_library}>
        <Return value={Gateway.AnalysisOutcome.SourceRequired} />
    </If>

    <Call
        fn="paths"
        in={$in.pick([
            "root",
            "entry"
        ])}
    />

    <Call fn="../../collection/files/escape_diagnostic" in={$ctx.paths.owner} />

    <If on={$ctx.escape_diagnostic != null}>
        <Return value={Gateway.AnalysisOutcome.OutsideProject} />
    </If>

    <Call
        fn="../index.collectGatewayDocuments"
        in={[
            $in.analysis,
            $ctx.paths.root,
            $ctx.paths.owner
        ]}
    />

    <If on={!$ctx.collectGatewayDocuments}>
        <Return value={Gateway.AnalysisOutcome.Invalid} />
    </If>

    <Call fn="../index.analyzeGatewayDocument" in={$in.analysis} />

    <If on={$ctx.analyzeGatewayDocument != null}>
        <Call fn="exports" in={$ctx.analyzeGatewayDocument} />

        <If on={$ctx.exports.length == 0}>
            <Return value={Gateway.AnalysisOutcome.Valid} />
        </If>

        <Call
            fn="../index.analyzeGatewayServices"
            in={[
                $in.analysis,
                $ctx.exports
            ]}
        />

        <If on={$ctx.analyzeGatewayServices}>
            <Return value={Gateway.AnalysisOutcome.Valid} />
        </If>
    </If>

    <Return value={Gateway.AnalysisOutcome.Invalid} />
</Module>
