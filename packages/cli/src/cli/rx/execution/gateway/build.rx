<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Execution" />

    <Args in={Execution.Request} out={Execution.EntryOutcome} />

    <Call fn="admit" in={$in.settings} />

    <If on={!$ctx.admit.valid}>
        <Return
            value={{
                status: IO.Status.Failed,
                diagnostic: $ctx.admit.diagnostic
            }}
        />
    </If>

    <Call fn="../index.loadGatewayBuild" in={$in.application} />

    <If on={!$ctx.loadGatewayBuild}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />
    </If>

    <Call fn="../index.linkGatewayBuild" in={$in.application} />
    <Call fn="../index.bindGatewayBuildRoutes" in={$in.application} />
    <Call fn="../index.openRxApplicationCache" in={$in.application} />

    <If on={$ctx.linkGatewayBuild}>
        <Call fn="../index.collectGatewayBuildSources" in={$in.application} />
        <Call fn="../index.emitGatewayBuildServices" in={$in.application} />

        <If on={!$ctx.emitGatewayBuildServices}>
            <Return
                value={{
                    status: IO.Status.Failed
                }}
            />
        </If>

        <Call fn="../index.assembleGatewayBuild" in={$in.application} />

        <Else>
            <Call fn="../index.assembleEmptyGatewayBuild" in={$in.application} />
        </Else>
    </If>

    <Call fn="../index.attachGatewayRunner" in={$in.application} />

    <Call module="../native_backend" in={$in.application} />

    <Return
        value={{
            status: $ctx.native_backend
        }}
    />
</Module>
