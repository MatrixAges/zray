<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Execution" />

    <Args in={Execution.Request} out={Execution.EntryOutcome} />

    <Call fn="index.emitRxApplicationText" in={$in.application} />

    <If on={$ctx.emitRxApplicationText == null}>
        <Return
            value={{
                status: IO.Status.Failed
            }}
        />

        <Else>
            <If on={$in.settings.output == null}>
                <Return
                    value={{
                        status: IO.Status.Success,
                        stdout: $ctx.emitRxApplicationText.source
                    }}
                />

                <Else>
                    <Call
                        module="../../workspace_files/write_program_text"
                        in={{
                            path: $in.settings.output,
                            source: $ctx.emitRxApplicationText.source,
                            abi: $ctx.emitRxApplicationText.abi,
                            abi_base: $in.settings.output
                        }}
                    />
                </Else>
            </If>

            <Return
                value={{
                    status: IO.Status.Success
                }}
            />
        </Else>
    </If>
</Module>
