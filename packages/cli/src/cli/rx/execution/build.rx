<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Execution" />

    <Args in={Execution.Build} out={IO.Status} />

    <Call fn="index.emitRxApplicationModules" in={$in.application} />

    <If on={!$ctx.emitRxApplicationModules}>
        <Return value={IO.Status.Failed} />
    </If>

    <If on={$in.stores > 0}>
        <Call fn="index.collectRxInitializers" in={$in.application} />
        <Call fn="index.emitRxInitializers" in={$in.application} />
        <Call fn="index.emitRxState" in={$in.application} />
    </If>

    <Call module="native_backend" in={$in.application} />

    <Return value={$ctx.native_backend} />
</Module>
