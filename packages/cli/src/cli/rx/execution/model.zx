import type { RxApplication, Status } from "rx_execution_host"
import type { Settings } from "../../compilation/model"

export type Request = {
    application: RxApplication,
    input_path: string,
    settings: Settings
}

export type Loaded = Request & {
    entry: string
}

export type Analyzed = Request & {
    stores: u64
}

export type Build = {
    application: RxApplication,
    stores: u64
}

export type EntryOutcome = {
    status: Status,
    diagnostic?: string,
    stdout?: string
}
