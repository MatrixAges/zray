<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Execution" />

    <Args in={Execution.Request} out={Execution.EntryOutcome} />

    <Call fn="admit" in={$in.settings.library} />

    <If on={$ctx.admit != null}>
        <Return value={$ctx.admit} />
    </If>

    <Call fn="index.loadRxApplication" in={$in.application} />

    <If on={$ctx.loadRxApplication != null}>
        <Call
            module="loaded"
            in={{
                ...$in,
                entry: $ctx.loadRxApplication
            }}
        />

        <Return value={$ctx.loaded} />
    </If>

    <Return
        value={{
            status: IO.Status.Failed
        }}
    />
</Module>
