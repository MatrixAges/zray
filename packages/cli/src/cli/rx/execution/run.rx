<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Execution" />

    <Args in={Execution.Request} out={IO.Status} />

    <If on={$in.settings.library}>
        <Call fn="index.reportRxLibraryEntry" in={$in.application} />

        <Return value={IO.Status.Failed} />
    </If>

    <Call fn="index.loadRxApplication" in={$in.application} />

    <If on={$ctx.loadRxApplication != null}>
        <Call
            module="loaded"
            in={{
                ...$in,
                entry: $ctx.loadRxApplication
            }}
        />

        <Return value={$ctx.loaded} />
    </If>

    <Return value={IO.Status.Failed} />
</Module>
