export type RxApplication = opaque

export type GatewayAnalysis = opaque

export type GatewayRoutes = {
    route_services: string[],
    service_routes: u32[]
}

export type GatewayService = {
    name: string,
    source: string
}

export type ApplicationLoad = {
    entry?: string,
    diagnostic?: string,
    error_name?: string
}

export enum Status {
    Success,
    Failed,
    BackendFailed,
    Retry
}

export type ApplicationText = {
    source: string,
    abi: string
}

export declare function loadRxApplication(allocator, check: RxApplication): ApplicationLoad
    throws { SourceLoadFailure, OutOfMemory }
export declare function analyzeRxApplication(check: RxApplication): u64? throws { SourceLoadFailure }
export declare function verifyRxApplication(check: RxApplication): bool throws { SourceLoadFailure }
export declare function generateRxFpga(check: RxApplication): bool throws { SourceLoadFailure }
export declare function openRxApplicationCache(check: RxApplication): void throws { SourceLoadFailure }
export declare function emitRxApplicationText(check: RxApplication): ApplicationText? throws { SourceLoadFailure }
export declare function emitRxApplicationModules(check: RxApplication): bool throws { SourceLoadFailure }
export declare function collectRxInitializers(check: RxApplication): void throws { SourceLoadFailure }
export declare function emitRxInitializers(check: RxApplication): void throws { SourceLoadFailure }
export declare function emitRxState(check: RxApplication): void throws { SourceLoadFailure }
export declare function reportRxApplicationCache(check: RxApplication): void throws { SourceLoadFailure }
export declare function resolveRxToolchain(check: RxApplication): bool throws { SourceLoadFailure }
export declare function resolveRxNativeProject(check: RxApplication): void throws { SourceLoadFailure }
export declare function runRxBackend(check: RxApplication): Status throws { SourceLoadFailure }

export declare function collectGatewayDocuments(
    check: GatewayAnalysis,
    root: string,
    owner: string
): bool throws { SourceLoadFailure }
export declare function analyzeGatewayDocument(allocator, check: GatewayAnalysis): GatewayRoutes?
    throws { SourceLoadFailure, OutOfMemory }
export declare function analyzeGatewayServices(check: GatewayAnalysis, services: GatewayService[]): bool throws { SourceLoadFailure }

export declare function loadGatewayBuild(check: RxApplication): bool throws { SourceLoadFailure }
export declare function linkGatewayBuild(check: RxApplication): bool throws { SourceLoadFailure }
export declare function bindGatewayBuildRoutes(check: RxApplication): void throws { SourceLoadFailure }
export declare function collectGatewayBuildSources(check: RxApplication): void throws { SourceLoadFailure }
export declare function emitGatewayBuildServices(check: RxApplication): bool throws { SourceLoadFailure }
export declare function assembleGatewayBuild(check: RxApplication): void throws { SourceLoadFailure }
export declare function assembleEmptyGatewayBuild(check: RxApplication): void throws { SourceLoadFailure }
export declare function attachGatewayRunner(check: RxApplication): void throws { SourceLoadFailure }
