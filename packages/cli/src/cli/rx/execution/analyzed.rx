<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Execution" />

    <Args in={Execution.Analyzed} out={Execution.EntryOutcome} />

    <If on={$in.settings.verifying}>
        <Call fn="index.verifyRxApplication" in={$in.application} />

        <If on={$ctx.verifyRxApplication}>
            <Return
                value={{
                    status: IO.Status.Success
                }}
            />
        </If>

        <Return
            value={{
                status: IO.Status.Failed
            }}
        />
    </If>

    <If on={$in.settings.fpga}>
        <Call fn="index.generateRxFpga" in={$in.application} />

        <If on={$ctx.generateRxFpga}>
            <Return
                value={{
                    status: IO.Status.Success
                }}
            />
        </If>

        <Return
            value={{
                status: IO.Status.Failed
            }}
        />
    </If>

    <If on={$in.settings.native}>
        <Call
            module="build"
            in={{
                application: $in.application,
                stores: $in.stores
            }}
        />

        <Return
            value={{
                status: $ctx.build
            }}
        />
    </If>

    <Call module="text" in={$in.omit(["stores"])} />

    <Return value={$ctx.text} />
</Module>
