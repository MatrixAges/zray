<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Backend" />

    <Args in={Backend.BindingRequest} out={IO.NodeBindings?} />

    <If on={$in.node}>
        <Call fn="../index.createBuildBindings" in={$in.build} />

        <Return value={$ctx.createBuildBindings} />
    </If>

    <Return value={null} />
</Module>
