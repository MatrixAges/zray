<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.NodeResources} out={string?} />

    <If on={$in.node}>
        <Call
            fn="index.retainNodeResources"
            in={[
                $in.build,
                $in.target
            ]}
        />

        <Return value={$ctx.retainNodeResources} />
    </If>

    <Return value={null} />
</Module>
