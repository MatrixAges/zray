import {
    abi_module,
    abi_source,
    application_module,
    napi_module,
    napi_source
} from "../../../../command/const"

import type { SupportModule } from "../model"

export type Input = bool

export type Output = SupportModule[]

export default function (in: Input): Output {
    const abi: SupportModule = {
        name: abi_module,
        file: abi_source,
        dependencies: []
    }

    if (!in) {
        return [abi]
    }

    const napi: SupportModule = {
        name: napi_module,
        file: napi_source,
        dependencies: [application_module]
    }

    return [
        abi,
        napi
    ]
}
