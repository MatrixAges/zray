<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.NativeWalk} out={bool} />

    <Loop on={$in.running}>
        <Call
            module="native"
            in={{
                ...$in,
                index: 0,
                failed: false,
                running: true
            }}
        />
    </Loop>

    <Return value={!$ctx.native.failed} />
</Module>
