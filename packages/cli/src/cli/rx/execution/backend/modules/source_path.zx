import resolvePathParts from "../../../../standard/path/resolve"

export type Input = {
    root: string,
    path?: string
}

export type Output = string?

export default function (in: Input): Output {
    const { root, path } = in

    return match {
        path != null => resolvePathParts([
            root,
            path
        ]),
        _ => null
    }
}
