import { appendGeneratedModule } from "rx_execution_host"

import type { RangeInput as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const written = loop(0, {
        while: row => row < in.count,
        next: row => {
            appendGeneratedModule(in.build, row)

            row += 1
        }
    })
}
