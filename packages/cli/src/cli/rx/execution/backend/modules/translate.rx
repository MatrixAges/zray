<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.BuildMode} out={bool} />

    <Call fn="../index.writeNativeHeader" in={$in.build} />

    <Call
        fn="../index.spawnNativeTranslation"
        in={[
            $in.build,
            $ctx.writeNativeHeader
        ]}
    />

    <If on={!$ctx.spawnNativeTranslation}>
        <Return value={false} />
    </If>

    <Call fn="../index.bindNativeTranslation" in={$in.build} />

    <If on={$in.observed}>
        <Call fn="../index.retainNativeTranslation" in={$in.build} />

        <Else>
            <Call fn="../index.releaseNativeTranslation" in={$in.build} />
        </Else>
    </If>

    <Call fn="../index.writeNativeAdapter" in={$in.build} />

    <Return value={true} />
</Module>
