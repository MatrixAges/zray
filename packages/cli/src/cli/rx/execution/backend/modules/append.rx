<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.NativeWalk} out={bool} />

    <Call
        fn="../index.readU64"
        in={[
            $in.cursor,
            0
        ]}
    />

    <Call
        fn="../index.nativeBackendModule"
        in={[
            $in.build,
            $ctx.readU64
        ]}
    />

    <Call
        fn="../../../../command/scope/abi"
        in={{
            views: $in.abi_views,
            name: $ctx.nativeBackendModule.name
        }}
    />

    <Call
        fn="../../../../command/scope/select"
        in={{
            setup: $in.setup,
            name: $ctx.nativeBackendModule.name
        }}
    />

    <Call
        fn="../../../../command/scope/root"
        in={{
            setup: $in.setup,
            index: $ctx.select
        }}
    />

    <Call
        fn="../../../../command/scope/includes"
        in={{
            setup: $in.setup,
            index: $ctx.select,
            explicit: $ctx.nativeBackendModule.includes,
            root: $ctx.root
        }}
    />

    <Call
        fn="source_path"
        in={{
            root: $in.setup.root,
            path: $ctx.nativeBackendModule.path
        }}
    />

    <Call
        fn="../index.bindBackendModule"
        in={[
            $in.build,
            $ctx.readU64,
            $ctx.includes,
            $ctx.abi,
            $ctx.source_path
        ]}
    />

    <If on={$ctx.source_path == null}>
        <Call module="translate" in={$in.build} />

        <If on={!$ctx.translate}>
            <Return value={false} />
        </If>
    </If>

    <Call fn="../index.appendNativeModule" in={$in.build} />

    <Return value={true} />
</Module>
