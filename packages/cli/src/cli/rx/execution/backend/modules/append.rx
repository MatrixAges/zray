<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.AppendInput} out={bool} />

    <Call
        fn="native_module"
        in={{
            modules: $in.modules,
            index: $in.index
        }}
    />

    <Call
        fn="../../../../command/scope/abi"
        in={{
            views: $in.abi_views,
            name: $ctx.native_module.name
        }}
    />

    <Call
        fn="../../../../command/scope/select"
        in={{
            setup: $in.setup,
            name: $ctx.native_module.name
        }}
    />

    <Call
        fn="../../../../command/scope/root"
        in={{
            setup: $in.setup,
            index: $ctx.select
        }}
    />

    <Call
        fn="../../../../command/scope/includes"
        in={{
            setup: $in.setup,
            index: $ctx.select,
            explicit: $ctx.native_module.includes,
            root: $ctx.root
        }}
    />

    <Call
        fn="source_path"
        in={{
            root: $in.setup.root,
            path: $ctx.native_module.path
        }}
    />

    <Call
        fn="../index.bindBackendModule"
        in={[
            $in.build,
            $in.index,
            $ctx.includes,
            $ctx.abi,
            $ctx.source_path
        ]}
    />

    <If on={$ctx.source_path == null}>
        <Call
            module="translate"
            in={$in.pick([
                "build",
                "observed"
            ])}
        />

        <If on={!$ctx.translate}>
            <Return value={false} />
        </If>
    </If>

    <Call fn="../index.appendNativeModule" in={$in.build} />

    <Return value={true} />
</Module>
