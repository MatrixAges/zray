<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.AppendInput} out={string[]?} />

    <Call
        fn="native_module"
        in={{
            modules: $in.modules,
            imports: $in.imports,
            index: $in.index
        }}
    />

    <Call
        fn="../../../../command/scope/abi"
        in={{
            views: $in.abi_views,
            name: $ctx.native_module.name
        }}
    />

    <Call
        fn="../../../../command/scope/select"
        in={{
            setup: $in.setup,
            name: $ctx.native_module.name
        }}
    />

    <Call
        fn="../../../../command/scope/root"
        in={{
            setup: $in.setup,
            index: $ctx.select
        }}
    />

    <Call
        fn="../../../../command/scope/includes"
        in={{
            setup: $in.setup,
            index: $ctx.select,
            explicit: $ctx.native_module.includes,
            root: $ctx.root
        }}
    />

    <Call
        fn="source_path"
        in={{
            root: $in.setup.root,
            path: $ctx.native_module.path
        }}
    />

    <If on={$ctx.source_path == null}>
        <Call
            module="translate"
            in={{
                build: $in.build,
                observed: $in.observed,
                options: $in.options,
                settings: $in.settings,
                name: $ctx.native_module.name,
                header: $ctx.native_module.header ?? "",
                includes: $ctx.includes
            }}
        />

        <If on={$ctx.translate == null}>
            <Return value={null} />

            <Else>
                <Call
                    module="../../../../command/modules/build"
                    in={{
                        spec: {
                            settings: $in.settings,
                            name: $ctx.native_module.name,
                            path: $ctx.translate.path,
                            imports: $ctx.native_module.imports,
                            includes: $ctx.includes,
                            canonical: true,
                            abi: $ctx.abi,
                            translated: $ctx.translate.source
                        }
                    }}
                />

                <Return value={$ctx.build} />
            </Else>
        </If>

        <Else>
            <Call
                module="../../../../command/modules/build"
                in={{
                    spec: {
                        settings: $in.settings,
                        name: $ctx.native_module.name,
                        path: $ctx.source_path,
                        imports: $ctx.native_module.imports,
                        includes: $ctx.includes,
                        canonical: true,
                        abi: $ctx.abi,
                        translated: null
                    }
                }}
            />

            <Return value={$ctx.build} />
        </Else>
    </If>
</Module>
