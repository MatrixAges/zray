import memory from "memory"

import { canonical_dependency } from "../../../../command/const"

import type { AbiWalk, SupportModule } from "../model"

export type Input = AbiWalk

export type Output = SupportModule

export default function (in: Input): Output {
    return {
        name: memory.readTextColumn(in.views.names, in.index),
        file: memory.readTextColumn(in.views.files, in.index),
        dependencies: [canonical_dependency]
    }
}
