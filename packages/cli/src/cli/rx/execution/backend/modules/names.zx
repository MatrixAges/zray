import { recordNativeName } from "rx_execution_host"

import type { Modules as Input } from "../model"

export type Output = bool

export default function (in: Input): Output {
    const { build, count } = in

    return loop({
        row: 0,
        libc: false
    }, {
        while: state => state.row < count,
        next: state => {
            state.libc = recordNativeName(build, state.row) || state.libc
            state.row += 1
        },
        return: state => state.libc
    })
}
