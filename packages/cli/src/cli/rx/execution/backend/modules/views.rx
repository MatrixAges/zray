<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ModuleWalk} out={Model.ModuleWalk} />

    <Call
        fn="../index.appendAbiView"
        in={[
            $in.build,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
