<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.AbiWalk} out={Backend.AbiWalk} />

    <Call fn="support_spec" in={$in} />

    <Call module="../../../../command/modules/build" />

    <Call
        fn="append_chunk"
        in={[
            $in.chunks,
            $ctx.build
        ]}
    />

    <Return
        value={{
            ...$in,
            chunks: $ctx.append_chunk,
            index: $in.index + 1
        }}
    />
</Module>
