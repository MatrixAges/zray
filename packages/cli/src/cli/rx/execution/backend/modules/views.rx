<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.AbiWalk} out={Model.AbiWalk} />

    <Call fn="view_file" in={$in} />

    <Call
        fn="../index.appendSupportModule"
        in={[
            $in.build,
            $ctx.view_file.name,
            $ctx.view_file.file,
            $ctx.view_file.dependencies
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
