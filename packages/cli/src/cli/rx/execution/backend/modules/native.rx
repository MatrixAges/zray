<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.NativeStep} out={Backend.NativeStep} />

    <Call
        module="append"
        in={$in.omit([
            "failed",
            "running"
        ])}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            failed: !$ctx.append,
            running: $ctx.append && $in.index + 1 < $in.count
        }}
    />
</Module>
