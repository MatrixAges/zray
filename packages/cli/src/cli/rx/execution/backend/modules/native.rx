<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.NativeWalk?} out={Backend.NativeWalk?} />

    <If on={$in != null}>
        <Call module="append" in={$in} />

        <If on={$ctx.append}>
            <Call
                fn="../../../../command/scope/advance"
                in={$in.pick([
                    "cursor",
                    "count"
                ])}
            />

            <If on={$ctx.advance}>
                <Return value={$in} />
            </If>
        </If>
    </If>

    <Return value={null} />
</Module>
