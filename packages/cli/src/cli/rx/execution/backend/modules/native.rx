<Module>
    <Type from="../model" as="Backend" />

    <Args in={Backend.NativeStep} out={Backend.NativeStep} />

    <Call
        module="append"
        in={$in.omit([
            "chunks",
            "failed",
            "running"
        ])}
    />

    <If on={$ctx.append == null}>
        <Return
            value={{
                ...$in,
                failed: true,
                running: false
            }}
        />

        <Else>
            <Call
                fn="append_chunk"
                in={[
                    $in.chunks,
                    $ctx.append
                ]}
            />

            <Return
                value={{
                    ...$in,
                    chunks: $ctx.append_chunk,
                    index: $in.index + 1
                }}
            />
        </Else>
    </If>
</Module>
