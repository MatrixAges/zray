import append from "./append.rx"

import type { Modules as Input } from "../model"

export type Output = bool

export default function (in: Input): Output {
    const { build, count } = in

    return loop({
        row: 0,
        ready: true
    }, {
        while: state => state.ready && state.row < count,
        next: state => {
            state.ready = append({
                build,
                index: state.row
            })
            state.row += 1
        },
        return: state => state.ready
    })
}
