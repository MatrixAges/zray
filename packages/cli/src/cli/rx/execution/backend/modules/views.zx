import { abiViewCount, appendAbiView } from "rx_execution_host"

import type { NativeBuild as Input } from "rx_execution_host"

export type Output = void

export default function (in: Input): Output {
    const count = abiViewCount(in)

    const written = loop(0, {
        while: row => row < count,
        next: row => {
            appendAbiView(in, row)

            row += 1
        }
    })
}
