import host from "native_build_host"

import type { ExpireInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const expired = loop(0, {
        while: index => index < in.paths.length,
        next: index => {
            host.expireBackendPath(in.build, in.paths[index])

            index += 1
        }
    })
}
