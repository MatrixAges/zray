import host from "rx_execution_host"

import type { NativeBuild as Input } from "./index"

export type Output = void

export default function (in: Input): Output {
    const paths = host.preloadedBackendPaths(in)

    const expired = loop(0, {
        while: index => index < paths.length,
        next: index => {
            host.expireBackendPath(in, paths[index])

            index += 1
        }
    })
}
