<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.CommandInvocation} out={bool} />

    <Call fn="index.reserveNativeNames" in={$in.build} />

    <Call
        fn="modules/names"
        in={{
            build: $in.build,
            count: $ctx.reserveNativeNames
        }}
    />

    <Call
        fn="../../../command/scope/paths"
        in={{
            owner: $in.native.setup.owner,
            root: $in.native.setup.root,
            paths: $in.native.setup.libraries
        }}
    />

    <Call
        fn="index.appendBackendPrefix"
        in={[
            $in.build,
            $ctx.names,
            $ctx.paths,
            $in.wasm
        ]}
    />

    <Call fn="index.appendBackendEntry" in={$in.build} />
    <Call fn="modules/generated" in={$in.build} />

    <If on={$in.native.count != 0}>
        <Call module="modules/walk" in={$in.native} />
    </If>

    <Call
        fn="index.readU64"
        in={[
            $in.native.cursor,
            0
        ]}
    />

    <If on={$ctx.readU64 != $in.native.count}>
        <Return value={false} />
    </If>

    <Call fn="modules/views" in={$in.build} />
    <Call fn="index.appendCanonicalAbi" in={$in.build} />

    <If on={$in.node}>
        <Call fn="index.appendNapiModule" in={$in.build} />
    </If>

    <Call fn="index.writeBackendCommand" in={$in.build} />

    <Return value={true} />
</Module>
