<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.CommandInvocation} out={string[]?} />

    <Call fn="index.readBackendCommandOptions" in={$in.build} />

    <Call
        fn="modules/requires_libc"
        in={{
            headers: $in.native.modules.headers,
            count: $in.native.count
        }}
    />

    <Call
        fn="../../../command/scope/paths"
        in={{
            root: $in.native.setup.root,
            paths: $in.native.setup.libraries
        }}
    />

    <Task name="prefix" out={$ctx.build}>
        <Call
            module="../../../command/prefix/build"
            in={{
                spec: {
                    tool: $ctx.readBackendCommandOptions.tool,
                    library: $ctx.readBackendCommandOptions.library,
                    node: $in.node,
                    wasm: $in.wasm,
                    node_library: $ctx.readBackendCommandOptions.node_library,
                    server: $ctx.readBackendCommandOptions.server,
                    files: $ctx.readBackendCommandOptions.files,
                    libraries: $ctx.readBackendCommandOptions.libraries,
                    library_paths: $ctx.paths,
                    libc: $ctx.requires_libc
                }
            }}
        />
    </Task>

    <Call
        fn="../../../command/settings"
        in={{
            spec: {
                optimize: $ctx.readBackendCommandOptions.optimize,
                target: $ctx.readBackendCommandOptions.target,
                cpu: $ctx.readBackendCommandOptions.cpu
            }
        }}
    />

    <Call
        fn="modules/native_names"
        in={{
            names: $in.native.modules.names,
            count: $in.native.count
        }}
    />

    <Task name="entry" out={$ctx.build}>
        <Call
            module="../../../command/entry/build"
            in={{
                spec: {
                    settings: $ctx.settings,
                    directory: $ctx.readBackendCommandOptions.directory,
                    node: $in.node,
                    state: $ctx.readBackendCommandOptions.state,
                    imports: $ctx.readBackendCommandOptions.imports,
                    natives: $ctx.native_names
                }
            }}
        />
    </Task>

    <Loop on={$in.index < $in.generated.count}>
        <Call
            module="modules/generated"
            in={{
                options: $ctx.readBackendCommandOptions,
                settings: $ctx.settings,
                generated: $in.generated,
                chunks: [
                    $ctx.task.prefix,
                    $ctx.task.entry
                ],
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.running && $in.index < $in.count}>
        <Call
            module="modules/native"
            in={{
                ...$in.native,
                options: $ctx.readBackendCommandOptions,
                settings: $ctx.settings,
                chunks: $ctx.generated.chunks,
                index: 0,
                failed: false,
                running: true
            }}
        />
    </Loop>

    <If on={$ctx.native.failed}>
        <Return value={null} />
    </If>

    <Call fn="modules/support_modules" in={$in.node} />

    <Loop on={$in.index < $in.view_count + $in.builtins.length}>
        <Call
            module="modules/views"
            in={{
                views: $in.native.abi_views,
                view_count: $in.abi_count,
                builtins: $ctx.support_modules,
                directory: $ctx.readBackendCommandOptions.directory,
                settings: $ctx.settings,
                chunks: $ctx.native.chunks,
                index: 0
            }}
        />
    </Loop>

    <Call fn="../../../command/append" in={$ctx.views.chunks} />

    <Return value={$ctx.append} />
</Module>
