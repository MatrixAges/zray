<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.CommandInvocation} out={bool} />

    <Call
        fn="modules/requires_libc"
        in={{
            headers: $in.native.modules.headers,
            count: $in.native.count
        }}
    />

    <Call
        fn="../../../command/scope/paths"
        in={{
            root: $in.native.setup.root,
            paths: $in.native.setup.libraries
        }}
    />

    <Call
        fn="index.appendBackendPrefix"
        in={[
            $in.build,
            $ctx.requires_libc,
            $ctx.paths,
            $in.wasm
        ]}
    />

    <Call fn="index.appendBackendEntry" in={$in.build} />

    <Loop on={$in.index < $in.count}>
        <Call
            module="modules/generated"
            in={{
                build: $in.build,
                count: $in.generated_count,
                index: 0
            }}
        />
    </Loop>

    <If on={$in.native.count != 0}>
        <Call module="modules/walk" in={$in.native} />

        <If on={!$ctx.walk}>
            <Return value={false} />
        </If>
    </If>

    <Loop on={$in.index < $in.count}>
        <Call
            module="modules/views"
            in={{
                build: $in.build,
                views: $in.native.abi_views,
                count: $in.abi_count,
                index: 0
            }}
        />
    </Loop>

    <Call fn="modules/support_modules" in={$in.node} />

    <Call
        fn="index.appendSupportModule"
        in={[
            $in.build,
            $ctx.support_modules.abi.name,
            $ctx.support_modules.abi.file,
            $ctx.support_modules.abi.dependencies
        ]}
    />

    <If on={$ctx.support_modules.napi != null}>
        <Call
            fn="index.appendSupportModule"
            in={[
                $in.build,
                $ctx.support_modules.napi.name,
                $ctx.support_modules.napi.file,
                $ctx.support_modules.napi.dependencies
            ]}
        />
    </If>

    <Call fn="index.writeBackendCommand" in={$in.build} />

    <Return value={true} />
</Module>
