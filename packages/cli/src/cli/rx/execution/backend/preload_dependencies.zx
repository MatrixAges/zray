import host from "rx_execution_host"

import type { PreloadInput as Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const empty_paths: string[] = []

    return loop({
        index: 0,
        preloaded: empty_paths
    }, {
        while: row => row.index < in.previous.length,
        next: row => {
            const path = in.previous[row.index]

            const seen = loop(0, {
                while: i => i < in.observed.length && in.observed[i] != path,
                next: i => {
                    i += 1
                },
                return: i => i < in.observed.length
            })

            if (!seen) {
                host.preloadBackendPath(in.build, path)
                row.preloaded = row.preloaded.push(path)[0]
            }

            row.index += 1
        },
        return: row => row.preloaded
    })
}
