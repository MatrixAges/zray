<Module>
    <Type from="model" as="Model" />

    <Args in={Model.PathWalk} out={Model.PathWalk} />

    <Call
        fn="index.preloadBackendPath"
        in={[
            $in.build,
            $in.paths[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
