<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Backend" />

    <Args in={Backend.Invocation} out={IO.Status} />

    <If on={$in.node}>
        <Call fn="index.createStagedBindings" in={$in.build} />
    </If>

    <Call fn="index.openStagedOutput" in={$in.build} />
    <Call fn="index.openBackendEnvironment" in={$in.build} />
    <Call fn="index.openBackendTranslation" in={$in.build} />

    <Call module="prepare" in={$in} />

    <If on={$ctx.prepare == null}>
        <Call fn="index.reportStagedTranslationFailure" in={$in.build} />

        <Return value={IO.Status.Failed} />

        <Else>
            <Call
                fn="index.writeBackendCommand"
                in={[
                    $in.build,
                    $ctx.prepare
                ]}
            />

            <Call
                fn="index.spawnStagedBackend"
                in={[
                    $in.build,
                    $ctx.prepare
                ]}
            />

            <If on={!$ctx.spawnStagedBackend}>
                <Return value={IO.Status.Failed} />
            </If>

            <If on={$in.node}>
                <Call fn="index.retainStagedBindings" in={$in.build} />
            </If>

            <Call fn="index.publishStagedBackend" in={$in.build} />

            <Return value={IO.Status.Success} />
        </Else>
    </If>
</Module>
