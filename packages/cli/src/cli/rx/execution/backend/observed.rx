<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Backend" />

    <Args in={Backend.Invocation} out={IO.Status} />

    <Call
        fn="preload_dependencies"
        in={{
            build: $in.build,
            previous: $in.previous_backend,
            observed: $in.observed_paths
        }}
    />

    <Call fn="index.openBackendTranslation" in={$in.build} />
    <Call fn="index.openBackendEnvironment" in={$in.build} />

    <Call module="prepare" in={$in} />

    <If on={$ctx.prepare}>
        <Call fn="index.spawnObservedBackend" in={$in.build} />

        <Else>
            <Call fn="index.takeTranslationFailure" in={$in.build} />
        </Else>
    </If>

    <Call fn="index.resolveObservedNativeInputs" in={$in.build} />

    <If on={$in.node}>
        <Call fn="index.createObservedBindings" in={$in.build} />
    </If>

    <Call
        fn="expire_dependencies"
        in={{
            build: $in.build,
            paths: $ctx.preload_dependencies
        }}
    />

    <Call fn="index.publishBackendPaths" in={$in.build} />
    <Call fn="index.reportObservedNativeBuild" in={$in.build} />

    <If on={$ctx.reportObservedNativeBuild == null}>
        <Return value={IO.Status.BackendFailed} />
    </If>

    <If on={$ctx.reportObservedNativeBuild == false}>
        <Call fn="index.rejectIncompleteBackendInputs" in={$in.build} />
    </If>

    <Call fn="index.publishObservedNativeBuild" in={$in.build} />

    <If on={!$ctx.publishObservedNativeBuild}>
        <Return value={IO.Status.Retry} />
    </If>

    <Return value={IO.Status.Success} />
</Module>
