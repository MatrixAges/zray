<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Backend" />

    <Args in={Backend.Invocation} out={IO.Status} />

    <Call
        fn="preload_dependencies"
        in={{
            previous: $in.previous_backend,
            observed: $in.observed_paths
        }}
    />

    <Loop on={$in.index < $in.paths.length}>
        <Call
            module="preload_dependency"
            in={{
                build: $in.build,
                paths: $ctx.preload_dependencies,
                index: 0
            }}
        />
    </Loop>

    <Call fn="index.openBackendTranslation" in={$in.build} />
    <Call fn="index.openBackendEnvironment" in={$in.build} />

    <Call
        module="prepare"
        in={{
            ...$in,
            cache: $ctx.openBackendTranslation
        }}
    />

    <If on={$ctx.prepare != null}>
        <Call
            fn="index.writeBackendCommand"
            in={[
                $in.build,
                $ctx.prepare
            ]}
        />

        <Call
            fn="index.spawnObservedBackend"
            in={[
                $in.build,
                $ctx.prepare
            ]}
        />
    </If>

    <Call
        fn="index.resolveObservedNativeInputs"
        in={[
            $in.build,
            $ctx.prepare == null
        ]}
    />

    <Call
        module="bindings/create"
        in={$in.pick([
            "build",
            "node"
        ])}
    />

    <Loop on={$in.index < $in.paths.length}>
        <Call
            module="expire_dependencies"
            in={{
                build: $in.build,
                paths: $ctx.preload_dependencies,
                index: 0
            }}
        />
    </Loop>

    <Call fn="index.publishBackendPaths" in={$in.build} />
    <Call fn="index.reportObservedNativeBuild" in={$in.build} />

    <If on={!$ctx.reportObservedNativeBuild.succeeded}>
        <Return value={IO.Status.BackendFailed} />
    </If>

    <If on={!$ctx.reportObservedNativeBuild.inputs_complete}>
        <Return value={IO.Status.IncompleteInputs} />
    </If>

    <Call
        fn="index.publishObservedNativeBuild"
        in={[
            $in.build,
            $ctx.create
        ]}
    />

    <If on={!$ctx.publishObservedNativeBuild}>
        <Return value={IO.Status.Retry} />
    </If>

    <Return value={IO.Status.Success} />
</Module>
