<Module>
    <Type from="model" as="Model" />

    <Args in={Model.ExpireWalk} out={Model.ExpireWalk} />

    <Call
        fn="index.expireBackendPath"
        in={[
            $in.build,
            $in.paths[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
