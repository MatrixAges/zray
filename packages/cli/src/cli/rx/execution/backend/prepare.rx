<Module>
    <Type from="model" as="Backend" />

    <Args in={Backend.Invocation} out={bool} />

    <Call fn="index.validateNativePorts" in={$in.build} />

    <If on={$in.node}>
        <Call fn="index.generateNodeResources" in={$in.build} />
    </If>

    <Call fn="index.encodeBackendConfiguration" in={$in.build} />
    <Call fn="index.prepareBackendAbi" in={$in.build} />
    <Call fn="index.readNativeTarget" in={$in.build} />

    <Call fn="target" />

    <If on={$in.node}>
        <Call
            fn="index.generateNodeRunner"
            in={[
                $in.build,
                $ctx.target.wasm
            ]}
        />
    </If>

    <If on={$ctx.target.wasm}>
        <Call fn="index.generateWasmRunner" in={$in.build} />
    </If>

    <Call fn="index.writeBackendWorkspace" in={$in.build} />

    <If on={$in.node}>
        <Call
            fn="index.retainNodeResources"
            in={[
                $in.build,
                $ctx.target.node
            ]}
        />
    </If>

    <Call fn="index.releaseBackendSources" in={$in.build} />

    <If on={!$in.observed}>
        <Call fn="index.prepareStagedParents" in={$in.build} />
    </If>

    <Call
        module="command"
        in={{
            ...$in,
            wasm: $ctx.target.wasm,
            abi_count: $ctx.prepareBackendAbi
        }}
    />

    <Return value={$ctx.command} />
</Module>
