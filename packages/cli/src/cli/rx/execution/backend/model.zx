import type { NativeBuild } from "rx_execution_host"
import type { Setup, Views } from "../../../command/scope/model"

export type BuildMode = {
    build: NativeBuild,
    observed: bool
}

export type Invocation = BuildMode & {
    node: bool,
    native: NativeWalk,
    previous_backend: string[],
    observed_paths: string[],
    native_headers: bool[],
    generated_count: u64
}

export type CommandInvocation = Invocation & {
    wasm: bool,
    abi_count: u64
}

export type RangeInput = {
    build: NativeBuild,
    count: u64
}

export type NativeWalk = RangeInput & {
    observed: bool,
    setup: Setup,
    abi_views: Views
}

export type NativeStep = NativeWalk & {
    index: u64,
    failed: bool,
    running: bool
}

export type AppendInput = NativeWalk & {
    index: u64
}

export type PreloadInput = {
    build: NativeBuild,
    previous: string[],
    observed: string[]
}

export type ExpireInput = {
    build: NativeBuild,
    paths: string[]
}
