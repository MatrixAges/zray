import type { ReadColumn, TextColumn } from "memory"
import type { CommandOptions, NativeBuild } from "native_build_host"
import type { NativeModules, Setup, Views } from "../../../command/scope/model"

export type BuildMode = {
    build: NativeBuild,
    observed: bool
}

export type Invocation = BuildMode & {
    node: bool,
    native: NativeWalk,
    previous_backend: string[],
    observed_paths: string[],
    generated: Generated
}

export type CommandInvocation = Invocation & {
    wasm: bool,
    abi_count: u64
}

export type NativeWalk = {
    build: NativeBuild,
    count: u64,
    observed: bool,
    modules: NativeModules,
    imports: ReadColumn,
    setup: Setup,
    abi_views: Views
}

export type CommandContext = {
    options: CommandOptions,
    settings: string[]
}

export type Chunks = {
    chunks: string[][],
    index: u64
}

export type Generated = {
    count: u64,
    names: TextColumn,
    imports: ReadColumn
}

export type GeneratedWalk = CommandContext & Chunks & {
    generated: Generated
}

export type NativeStep = NativeWalk & CommandContext & Chunks & {
    failed: bool,
    running: bool
}

export type AppendInput = NativeWalk & CommandContext & {
    index: u64
}

export type Translation = BuildMode & CommandContext & {
    name: string,
    header: string,
    includes: string[]
}

export type TranslatedModule = {
    path: string,
    source: string
}

export type PreloadInput = {
    previous: string[],
    observed: string[]
}

export type PathWalk = {
    build: NativeBuild,
    paths: string[],
    index: u64
}

export type AbiWalk = Chunks & {
    view_count: u64,
    builtins: SupportModule[],
    views: Views,
    directory: string,
    settings: string[]
}

export type SupportModule = {
    name: string,
    file: string,
    dependencies: string[]
}
