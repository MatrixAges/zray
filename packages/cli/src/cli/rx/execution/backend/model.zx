import type { ReadColumn, TextColumn } from "memory"
import type {
    BackendCache,
    CommandDestination,
    CommandOptions,
    NativeBuild,
    NodeBindings,
    NodeTarget,
    WorkspaceFiles
} from "native_build_host"
import type { NativeModules, Setup, Views } from "../../../command/scope/model"

export type BuildMode = {
    build: NativeBuild,
    observed: bool
}

export type Invocation = BuildMode & {
    node: bool,
    assembly?: string,
    command: CommandSettings,
    native: NativeWalk,
    previous_backend: string[],
    observed_paths: string[],
    generated: Generated
}

export type Preparation = Invocation & {
    cache: BackendCache,
    files?: CommandDestination
}

export type CommandSettings = CommandOptions.Pick(
    "tool",
    "library",
    "optimize",
    "target",
    "cpu",
    "libraries",
    "state",
    "imports"
)

export type CommandOptionsInput = WorkspaceFiles & {
    settings: CommandSettings,
    cache: BackendCache,
    files?: CommandDestination,
    node_library?: string,
    assembly: bool
}

export type CommandInvocation = {
    native: NativeWalk,
    generated: Generated,
    node: bool,
    wasm: bool,
    abi_count: u64,
    options: CommandOptions
}

export type NodeResources = {
    build: NativeBuild,
    node: bool,
    target: NodeTarget
}

export type NativeWalk = {
    build: NativeBuild,
    count: u64,
    observed: bool,
    modules: NativeModules,
    imports: ReadColumn,
    setup: Setup,
    abi_views: Views
}

export type CommandContext = {
    options: CommandOptions,
    settings: string[]
}

export type Chunks = {
    chunks: string[][],
    index: u64
}

export type Generated = {
    count: u64,
    names: TextColumn,
    imports: ReadColumn
}

export type GeneratedWalk = CommandContext & Chunks & {
    generated: Generated
}

export type NativeStep = NativeWalk & CommandContext & Chunks & {
    failed: bool,
    running: bool
}

export type AppendInput = NativeWalk & CommandContext & {
    index: u64
}

export type Translation = BuildMode & CommandContext & {
    name: string,
    header: string,
    includes: string[]
}

export type TranslatedModule = {
    path: string,
    source: string
}

export type PreloadInput = {
    previous: string[],
    observed: string[]
}

export type PathWalk = {
    build: NativeBuild,
    paths: string[],
    index: u64
}

export type AbiWalk = Chunks & {
    view_count: u64,
    builtins: SupportModule[],
    views: Views,
    directory: string,
    settings: string[]
}

export type SupportModule = {
    name: string,
    file: string,
    dependencies: string[]
}

export type BindingRequest = {
    build: NativeBuild,
    node: bool
}

export type BindingCheck = {
    bindings: NodeBindings,
    assembly?: string
}

export type BindingFiles = {
    bindings: NodeBindings,
    binary: string
}

export type BindingArtifact = {
    path: string,
    source: string
}

export type BindingStage = BindingCheck & BindingFiles
