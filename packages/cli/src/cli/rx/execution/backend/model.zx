import type { U64Buffer } from "memory"
import type { NativeBuild } from "rx_execution_host"
import type { Setup, Views } from "../../../command/scope/model"

export type BuildMode = {
    build: NativeBuild,
    observed: bool
}

export type Invocation = BuildMode & {
    node: bool,
    native: NativeWalk
}

export type CommandInvocation = Invocation & {
    wasm: bool
}

export type Modules = {
    build: NativeBuild,
    count: u64
}

export type NativeWalk = Modules & {
    observed: bool,
    cursor: U64Buffer,
    setup: Setup,
    abi_views: Views
}
