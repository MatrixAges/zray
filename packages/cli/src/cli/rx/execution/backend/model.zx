import type { NativeBuild } from "native_build_host"
import type { NativeModules, Setup, Views } from "../../../command/scope/model"

export type BuildMode = {
    build: NativeBuild,
    observed: bool
}

export type Invocation = BuildMode & {
    node: bool,
    native: NativeWalk,
    previous_backend: string[],
    observed_paths: string[],
    generated_count: u64
}

export type CommandInvocation = Invocation & {
    wasm: bool,
    abi_count: u64
}

export type RangeInput = {
    build: NativeBuild,
    count: u64
}

export type NativeWalk = RangeInput & {
    observed: bool,
    modules: NativeModules,
    setup: Setup,
    abi_views: Views
}

export type NativeStep = NativeWalk & {
    index: u64,
    failed: bool,
    running: bool
}

export type AppendInput = NativeWalk & {
    index: u64
}

export type PreloadInput = {
    previous: string[],
    observed: string[]
}

export type PathWalk = {
    build: NativeBuild,
    paths: string[],
    index: u64
}

export type ModuleWalk = RangeInput & {
    index: u64
}

export type AbiWalk = ModuleWalk & {
    views: Views
}

export type SupportModule = {
    name: string,
    file: string,
    dependencies: string[]
}
