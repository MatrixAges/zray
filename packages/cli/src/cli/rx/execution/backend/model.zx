import type { U64Buffer } from "memory"
import type { NativeBuild } from "rx_execution_host"
import type { Setup, Views } from "../../../command/scope/model"

export type Invocation = {
    build: NativeBuild,
    node: bool,
    observed: bool,
    native: NativeWalk
}

export type Modules = {
    build: NativeBuild,
    count: u64
}

export type NativeWalk = Modules & {
    cursor: U64Buffer,
    setup: Setup,
    abi_views: Views
}
