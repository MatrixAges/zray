<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Backend" />

    <Args in={Backend.Invocation} out={IO.Status} />

    <If on={$in.observed}>
        <Call module="observed" in={$in} />

        <Return value={$ctx.observed} />
    </If>

    <Call module="staged" in={$in} />

    <Return value={$ctx.staged} />
</Module>
