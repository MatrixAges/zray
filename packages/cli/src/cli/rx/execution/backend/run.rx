<Module>
    <Type from="index" as="IO" />

    <Args in={IO.NativeBuild} out={IO.Status} />

    <Call fn="index.watchesNativeBuild" in={$in} />
    <Call fn="index.nativeNodeHost" in={$in} />

    <If on={$ctx.watchesNativeBuild}>
        <Call
            module="observed"
            in={{
                build: $in,
                node: $ctx.nativeNodeHost,
                observed: true
            }}
        />

        <Return value={$ctx.observed} />
    </If>

    <Call
        module="staged"
        in={{
            build: $in,
            node: $ctx.nativeNodeHost,
            observed: false
        }}
    />

    <Return value={$ctx.staged} />
</Module>
