export type NativeBuild = opaque

export enum Status {
    Success,
    Failed,
    BackendFailed,
    Retry,
    IncompleteInputs
}

export type BackendTarget = {
    arch?: string,
    os?: string,
    host_arch: string,
    host_os: string,
    node_library?: string
}

export enum NodeTarget {
    Ready,
    UnsupportedNodeTarget,
    NodeImportLibraryRequired
}

export type CommandDestination = {
    binary: string,
    assembly?: string
}

export type CommandServer = {
    name: string,
    root: string,
    local: string,
    global: string,
    assembly: bool
}

export type CommandOptions = {
    directory: string,
    module_paths: string[],
    tool: string,
    library: string,
    local: string,
    global: string,
    node_library?: string,
    server?: CommandServer,
    files?: CommandDestination,
    optimize: string,
    target?: string,
    cpu?: string,
    libraries: string[],
    state?: string,
    imports: string[]
}

