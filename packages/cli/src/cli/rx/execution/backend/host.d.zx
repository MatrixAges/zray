export type NativeBuild = opaque

export enum Status {
    Success,
    Failed,
    BackendFailed,
    Retry,
    IncompleteInputs
}

export type BackendTarget = {
    arch?: string,
    os?: string,
    host_arch: string,
    host_os: string,
    node_library?: string
}

export enum NodeTarget {
    Ready,
    UnsupportedNodeTarget,
    NodeImportLibraryRequired
}

