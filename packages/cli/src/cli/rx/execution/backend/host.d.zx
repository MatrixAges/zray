export type NativeBuild = opaque

export enum Status {
    Success,
    Failed,
    BackendFailed,
    Retry,
    IncompleteInputs,
    ConflictingOutputPaths,
    NodeBindingWouldOverwriteFile
}

export type BackendTarget = {
    arch?: string,
    os?: string,
    host_arch: string,
    host_os: string,
    node_library?: string
}

export enum NodeTarget {
    Ready,
    UnsupportedNodeTarget,
    NodeImportLibraryRequired
}

export type CommandDestination = {
    binary: string,
    assembly?: string
}

export type CommandServer = {
    name: string,
    root: string,
    local: string,
    global: string,
    assembly: bool
}

export type CommandOptions = {
    directory: string,
    module_paths: string[],
    tool: string,
    library: string,
    local: string,
    global: string,
    node_library?: string,
    server?: CommandServer,
    files?: CommandDestination,
    optimize: string,
    target?: string,
    cpu?: string,
    libraries: string[],
    state?: string,
    imports: string[]
}

export type BackendCache = {
    cwd: string,
    local: string,
    global: string
}

export type WorkspaceFiles = {
    directory: string,
    module_paths: string[]
}

export type ObservedResult = {
    succeeded: bool,
    inputs_complete: bool
}

export type NodeBindings = {
    module: string,
    declaration: string,
    module_source: string,
    declaration_source: string
}

export declare function createBuildBindings(allocator, build: NativeBuild): NodeBindings
    throws { SourceLoadFailure, OutOfMemory }
export declare function openStagedOutput(allocator, build: NativeBuild): CommandDestination
    throws { SourceLoadFailure, OutOfMemory }
export declare function openBackendEnvironment(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function openBackendTranslation(allocator, build: NativeBuild): BackendCache
    throws { SourceLoadFailure, OutOfMemory }
export declare function reportStagedTranslationFailure(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function spawnStagedBackend(build: NativeBuild, arguments: string[]): bool throws {
    SourceLoadFailure
}
export declare function publishStagedBackend(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function preloadBackendPath(build: NativeBuild, path: string): void throws {
    SourceLoadFailure
}
export declare function expireBackendPath(build: NativeBuild, path: string): void
export declare function spawnObservedBackend(build: NativeBuild, arguments: string[]): void throws {
    SourceLoadFailure
}
export declare function resolveObservedNativeInputs(
    build: NativeBuild,
    translation_failed: bool
): void throws {
    SourceLoadFailure
}
export declare function publishBackendPaths(build: NativeBuild): void
export declare function reportObservedNativeBuild(allocator, build: NativeBuild): ObservedResult throws {
    SourceLoadFailure, OutOfMemory
}
export declare function publishObservedNativeBuild(build: NativeBuild, bindings: NodeBindings?): bool throws {
    SourceLoadFailure
}

export declare function validateNativePorts(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function generateNodeResources(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function encodeBackendConfiguration(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function prepareBackendAbi(build: NativeBuild): u64 throws {
    SourceLoadFailure
}
export declare function readNativeTarget(build: NativeBuild): BackendTarget throws {
    SourceLoadFailure
}
export declare function generateNodeRunner(build: NativeBuild, wasm: bool): void throws {
    SourceLoadFailure
}
export declare function generateWasmRunner(build: NativeBuild): void throws {
    SourceLoadFailure
}
export declare function writeBackendWorkspace(allocator, build: NativeBuild): WorkspaceFiles
    throws { SourceLoadFailure, OutOfMemory }
export declare function retainNodeResources(build: NativeBuild, target: NodeTarget): string? throws {
    SourceLoadFailure
}
export declare function prepareStagedParents(build: NativeBuild): void throws {
    SourceLoadFailure
}

export declare function writeBackendCommand(build: NativeBuild, arguments: string[]): void
    throws { SourceLoadFailure }

export declare function spawnNativeTranslation(
    allocator,
    build: NativeBuild,
    arguments: string[],
    observed: bool
): u8[]? throws { SourceLoadFailure, OutOfMemory }
export declare function writeNativeAdapter(build: NativeBuild, path: string): void
    throws { SourceLoadFailure }
