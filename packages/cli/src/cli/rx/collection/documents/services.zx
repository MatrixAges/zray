import { collectGatewayService } from "rx_collection_host"

import type { ServicesInput as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const collected = loop(0, {
        while: index => index < in.count,
        next: index => {
            collectGatewayService(in.collection, index)

            index += 1
        }
    })
}
