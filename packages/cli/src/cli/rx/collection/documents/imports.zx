import { collectZxHeaderImport } from "rx_collection_host"

import type { Imports as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { collection, count } = in

    const collected = loop(0, {
        while: index => index < count,
        next: index => {
            collectZxHeaderImport(collection, index)

            index += 1
        }
    })
}
