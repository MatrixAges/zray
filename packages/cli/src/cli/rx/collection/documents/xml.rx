<Module>
    <Type from="../index" as="IO" />

    <Args in={IO.Collection} out={bool} />

    <Call fn="../index.parseCollectionXml" in={$in} />

    <If on={!$ctx.parseCollectionXml}>
        <Return value={false} />
    </If>

    <Call fn="../index.validateCollectionXml" in={$in} />

    <If on={$ctx.validateCollectionXml == IO.XmlValidation.Invalid}>
        <Return value={false} />
    </If>

    <If on={$ctx.validateCollectionXml == IO.XmlValidation.HttpGateway}>
        <Call fn="../index.prepareCollectionGateway" in={$in} />

        <If on={$ctx.prepareCollectionGateway != null}>
            <Loop on={$in.index < $in.routes.service_routes.length}>
                <Call
                    module="services"
                    in={{
                        collection: $in,
                        routes: $ctx.prepareCollectionGateway,
                        index: 0
                    }}
                />
            </Loop>

            <Return value={true} />
        </If>

        <Return value={false} />
    </If>

    <Call fn="../index.collectXmlReferences" in={$in} />

    <Return value={$ctx.collectXmlReferences} />
</Module>
