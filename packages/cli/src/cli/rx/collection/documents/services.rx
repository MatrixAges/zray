<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ServiceWalk} out={Model.ServiceWalk} />

    <Call
        fn="service_path"
        in={$in.pick([
            "routes",
            "index"
        ])}
    />

    <Call
        fn="../index.collectGatewayService"
        in={[
            $in.collection,
            $ctx.service_path
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
