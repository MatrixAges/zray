<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ServiceWalk} out={Model.ServiceWalk} />

    <Call
        fn="../index.collectGatewayService"
        in={[
            $in.collection,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
