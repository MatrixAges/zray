export type Collection = opaque

export enum Kind {
    Zx,
    Gateway,
    Store,
    Module
}

export enum Availability {
    Ready,
    Missing,
    Failed
}

export type PhysicalResolution = {
    availability: Availability,
    real: string,
    relative: string,
    problem: string
}

export type FileRead = {
    availability: Availability,
    problem: string
}

export enum XmlValidation {
    Invalid,
    Valid,
    HttpGateway
}

export type GatewayRoutes = {
    route_services: string[],
    service_routes: u32[]
}

export declare function selectCollectionPath(collection: Collection, row: u64, first: string): string? throws { SourceLoadFailure }
export declare function resolveCollectionPhysicalPath(collection: Collection): PhysicalResolution throws { SourceLoadFailure }
export declare function readCollectionFile(collection: Collection, retained: bool): FileRead throws { SourceLoadFailure }
export declare function collectZxReferences(collection: Collection): void throws { SourceLoadFailure }

export declare function parseCollectionXml(collection: Collection): bool throws { SourceLoadFailure }
export declare function validateCollectionXml(collection: Collection): XmlValidation throws { SourceLoadFailure }
export declare function prepareCollectionGateway(allocator, collection: Collection): GatewayRoutes? throws { SourceLoadFailure, OutOfMemory }
export declare function collectGatewayService(collection: Collection, path: string): void throws { SourceLoadFailure }
export declare function collectXmlReferences(collection: Collection): bool throws { SourceLoadFailure }
