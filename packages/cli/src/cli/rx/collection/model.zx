import type { Availability, Collection, Kind } from "rx_collection_host"

export type Request = {
    collection: Collection,
    entry: string
}

export enum Readiness {
    Ready,
    Skipped,
    Invalid
}

export type SeenPhysical = {
    real_paths: string[],
    logical_paths: string[]
}

export type RegisterPhysicalInput = {
    seen: SeenPhysical,
    real: string,
    path: string
}

export enum PhysicalRegistration {
    Registered,
    SamePath,
    AliasConflict
}

export type PhysicalRegistrationResult = {
    status: PhysicalRegistration,
    previous: string
}

export type ServicesInput = {
    collection: Collection,
    count: u64
}

export type Visit = {
    collection: Collection,
    path: string,
    first: bool
}

export type Document = {
    collection: Collection,
    kind: Kind
}

export type File = Document & {
    path: string,
    first: bool
}

export type Unavailable = File & {
    availability: Availability,
    problem: string
}

export type Walk = {
    collection: Collection,
    entry: string,
    index: u64,
    valid: bool,
    running: bool
}

export type ServiceWalk = ServicesInput & {
    index: u64
}
