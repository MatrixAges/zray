import type { Availability, Collection, GatewayRoutes, Kind } from "rx_collection_host"

export type Request = {
    collection: Collection,
    entry: string
}

export enum Readiness {
    Ready,
    Skipped,
    Invalid
}

export type VisitResult = {
    readiness: Readiness,
    problem?: string
}

export type Issue = {
    path: string,
    message: string
}

export type Result = {
    records?: Records,
    issue?: Issue
}

export type SeenPhysical = {
    real_paths: string[],
    logical_paths: string[]
}

export type RegisterPhysicalInput = {
    seen: SeenPhysical,
    real: string,
    path: string
}

export enum PhysicalRegistration {
    Registered,
    SamePath,
    AliasConflict
}

export type PhysicalRegistrationResult = {
    status: PhysicalRegistration,
    previous: string
}

export type ServicesInput = {
    collection: Collection,
    routes: GatewayRoutes
}

export type Visit = Document & {
    path: string,
    first: bool
}

export type Document = {
    collection: Collection,
    kind: Kind
}

export type File = Document & {
    path: string,
    first: bool
}

export type Unavailable = {
    kind: Kind,
    first: bool,
    availability: Availability,
    problem: string
}

export type Walk = {
    collection: Collection,
    entry: string,
    index: u64,
    valid: bool,
    running: bool,
    issue?: Issue
}

export type ServiceWalk = ServicesInput & {
    index: u64
}

export type Records = {
    functions: u64[],
    modules: u64[],
    stores: u64[],
    gateway?: u64
}

export type RecordInput = {
    records: Records,
    kind: Kind,
    index: u64
}
