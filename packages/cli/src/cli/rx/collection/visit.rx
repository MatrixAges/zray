<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Collection" />

    <Args in={Collection.Visit} out={bool} />

    <Call fn="kind" in={$in.path} />

    <Call
        module="files/read"
        in={{
            collection: $in.collection,
            kind: $ctx.kind,
            path: $in.path,
            first: $in.first
        }}
    />

    <If on={$ctx.read != Collection.Readiness.Ready}>
        <Return value={$ctx.read == Collection.Readiness.Skipped} />
    </If>

    <If on={$ctx.kind == IO.Kind.Zx}>
        <Call module="documents/zx" in={$in.collection} />

        <Return value={true} />
    </If>

    <Call
        module="documents/xml"
        in={{
            collection: $in.collection,
            kind: $ctx.kind
        }}
    />

    <Return value={$ctx.xml} />
</Module>
