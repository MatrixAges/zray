<Module>
    <Type from="index" as="IO" />
    <Type from="model" as="Collection" />

    <Args in={Collection.Visit} out={Collection.VisitResult} />

    <Call
        module="files/read"
        in={{
            collection: $in.collection,
            kind: $in.kind,
            path: $in.path,
            first: $in.first
        }}
    />

    <If on={$ctx.read.readiness != Collection.Readiness.Ready}>
        <Return value={$ctx.read} />
    </If>

    <If on={$in.kind == IO.Kind.Zx}>
        <Call fn="index.collectZxReferences" in={$in.collection} />

        <Return
            value={{
                readiness: Collection.Readiness.Ready
            }}
        />
    </If>

    <Call module="documents/xml" in={$in.collection} />

    <If on={$ctx.xml}>
        <Return
            value={{
                readiness: Collection.Readiness.Ready
            }}
        />
    </If>

    <Return
        value={{
            readiness: Collection.Readiness.Invalid
        }}
    />
</Module>
