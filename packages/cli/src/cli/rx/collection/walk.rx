<Module>
    <Type from="model" as="State" />

    <Args in={State.Walk} out={State.Walk} />

    <Call
        fn="index.selectCollectionPath"
        in={[
            $in.collection,
            $in.index
        ]}
    />

    <If on={$ctx.selectCollectionPath != null}>
        <Call
            module="visit"
            in={{
                collection: $in.collection,
                path: $ctx.selectCollectionPath,
                first: $in.index == 0
            }}
        />

        <Return
            value={{
                ...$in,
                index: $in.index + 1,
                valid: $ctx.visit,
                running: $ctx.visit
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
