<Module>
    <Type from="model" as="State" />

    <Args in={State.Walk} out={State.Walk} />

    <Store from="records" as="records" />

    <Call
        fn="index.selectCollectionPath"
        in={[
            $in.collection,
            $in.index,
            $in.entry
        ]}
    />

    <If on={$ctx.selectCollectionPath != null}>
        <Call fn="kind" in={$ctx.selectCollectionPath} />

        <Call
            module="visit"
            in={{
                collection: $in.collection,
                path: $ctx.selectCollectionPath,
                kind: $ctx.kind,
                first: $in.index == 0
            }}
        />

        <If on={$ctx.visit.readiness == State.Readiness.Ready}>
            <Call
                fn="record"
                in={{
                    records: $store.records.selected,
                    kind: $ctx.kind,
                    index: $in.index
                }}
                setter={[$store.records.selected]}
            />
        </If>

        <If on={$ctx.visit.problem != null}>
            <Return
                value={{
                    ...$in,
                    valid: false,
                    running: false,
                    issue: {
                        path: $ctx.selectCollectionPath,
                        message: $ctx.visit.problem
                    }
                }}
            />
        </If>

        <Return
            value={{
                ...$in,
                index: $in.index + 1,
                valid: $ctx.visit.readiness != State.Readiness.Invalid,
                running: $ctx.visit.readiness != State.Readiness.Invalid
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
