<Module>
    <Type from="model" as="State" />

    <Args in={State.Walk} out={State.Walk} />

    <Call fn="index.collectionQueueLength" in={$in.collection} />

    <If on={$in.index >= $ctx.collectionQueueLength}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />
    </If>

    <Call
        module="visit"
        in={$in.pick([
            "collection",
            "index"
        ])}
    />

    <Call fn="index.releaseRxDocument" in={$in.collection} />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.visit,
            running: $ctx.visit
        }}
    />
</Module>
