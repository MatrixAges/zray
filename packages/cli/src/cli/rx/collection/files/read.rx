<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Collection" />

    <Args in={Collection.File} out={Collection.VisitResult} />

    <Store from="../physical" as="physical" />

    <Call fn="../index.resolveCollectionPhysicalPath" in={$in.collection} />

    <If on={$ctx.resolveCollectionPhysicalPath.availability != IO.Availability.Ready}>
        <Call
            module="unavailable"
            in={{
                kind: $in.kind,
                first: $in.first,
                availability: $ctx.resolveCollectionPhysicalPath.availability,
                problem: $ctx.resolveCollectionPhysicalPath.problem
            }}
        />

        <Return value={$ctx.unavailable} />
    </If>

    <Call fn="escape_diagnostic" in={$ctx.resolveCollectionPhysicalPath.relative} />

    <If on={$ctx.escape_diagnostic != null}>
        <Return
            value={{
                readiness: Collection.Readiness.Invalid,
                problem: $ctx.escape_diagnostic
            }}
        />
    </If>

    <Call
        fn="register_physical"
        in={{
            seen: $store.physical.seen,
            real: $ctx.resolveCollectionPhysicalPath.real,
            path: $in.path
        }}
        setter={[$store.physical.seen]}
    />

    <If on={$ctx.register_physical.status == Collection.PhysicalRegistration.SamePath}>
        <Return
            value={{
                readiness: Collection.Readiness.Skipped
            }}
        />
    </If>

    <If
        on={$ctx.register_physical.status ==
            Collection.PhysicalRegistration.AliasConflict}
    >
        <Call fn="alias_message" in={$ctx.register_physical.previous} />

        <Return
            value={{
                readiness: Collection.Readiness.Invalid,
                problem: $ctx.alias_message
            }}
        />
    </If>

    <Call
        fn="../index.readCollectionFile"
        in={[
            $in.collection,
            $in.kind == IO.Kind.Module || $in.kind == IO.Kind.Zx
        ]}
    />

    <If on={$ctx.readCollectionFile.availability != IO.Availability.Ready}>
        <Call
            module="unavailable"
            in={{
                kind: $in.kind,
                first: $in.first,
                availability: $ctx.readCollectionFile.availability,
                problem: $ctx.readCollectionFile.problem
            }}
        />

        <Return value={$ctx.unavailable} />
    </If>

    <Return
        value={{
            readiness: Collection.Readiness.Ready
        }}
    />
</Module>
