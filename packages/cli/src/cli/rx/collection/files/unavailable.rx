<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Collection" />

    <Args in={Collection.Unavailable} out={Collection.VisitResult} />

    <If on={$in.availability == IO.Availability.Missing}>
        <If on={!$in.first && $in.kind == IO.Kind.Zx}>
            <Return
                value={{
                    readiness: Collection.Readiness.Skipped
                }}
            />
        </If>
    </If>

    <Return
        value={{
            readiness: Collection.Readiness.Invalid,
            problem: $in.problem
        }}
    />
</Module>
