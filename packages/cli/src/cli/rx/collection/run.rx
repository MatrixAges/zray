<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Collection} out={bool} />

    <Call fn="index.collectionEntry" in={$in} />

    <Call fn="kind" />

    <Call
        fn="index.registerCollectionEntry"
        in={[
            $in,
            $ctx.kind
        ]}
    />

    <If on={!$ctx.registerCollectionEntry}>
        <Return value={false} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                collection: $in,
                index: 0,
                valid: true,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.walk.valid} />
</Module>
