<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Request} out={bool} />

    <Store from="physical" as="physical" />

    <Call fn="kind" in={$in.entry} />

    <Call
        fn="index.registerCollectionEntry"
        in={[
            $in.collection,
            $ctx.kind
        ]}
    />

    <If on={!$ctx.registerCollectionEntry}>
        <Return value={false} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                collection: $in.collection,
                index: 0,
                valid: true,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.walk.valid} />
</Module>
