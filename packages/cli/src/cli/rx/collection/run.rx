<Module>
    <Type from="model" as="Collection" />

    <Args in={Collection.Request} out={Collection.Records?} />

    <Store from="physical" as="physical" />
    <Store from="records" as="records" />

    <Call fn="kind" in={$in.entry} />

    <Call
        fn="files/entry_path"
        in={{
            path: $in.entry,
            kind: $ctx.kind
        }}
    />

    <If on={$ctx.entry_path != null}>
        <Loop on={$in.running}>
            <Call
                module="walk"
                in={{
                    collection: $in.collection,
                    entry: $ctx.entry_path,
                    index: 0,
                    valid: true,
                    running: true
                }}
            />
        </Loop>

        <Call
            fn="selected_records"
            in={{
                valid: $ctx.walk.valid,
                records: $store.records.selected
            }}
        />

        <Return value={$ctx.selected_records} />
    </If>

    <Call
        fn="index.writeCollectionDiagnostic"
        in={[
            $in.collection,
            $in.entry,
            "invalid RX entry path"
        ]}
    />

    <Return value={null} />
</Module>
