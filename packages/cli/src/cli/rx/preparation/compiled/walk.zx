import {
    Role,
    preparationModuleCount,
    preparationReferenceRole,
    selectPreparationModule
} from "rx_preparation_host"

import { module_executable_required } from "../const"
import load from "./reference.rx"

import type { References as Input } from "rx_preparation_host"

export type Output = bool

export default function (in: Input): Output {
    const count = preparationModuleCount(in)

    const target = {
        references: in,
        diagnostic: module_executable_required
    }

    return loop({
        index: 0,
        valid: true
    }, {
        while: row => row.index < count && row.valid,
        next: row => {
            const end = selectPreparationModule(in, row.index)

            row.valid = loop({
                index: 0,
                valid: true
            }, {
                while: item => item.index < end && item.valid,
                next: item => {
                    if (
                        preparationReferenceRole(in, item.index) == Role.ModuleCall
                    ) {
                        item.valid = load(target)
                    }

                    item.index += 1
                },
                return: item => item.valid
            })
            row.index += 1
        },
        return: row => row.valid
    })
}
