<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.CompiledReference} out={Preparation.PassResult} />

    <Call
        fn="../index.resolvePreparationTarget"
        in={[
            $in.references,
            $in.reference,
            false
        ]}
    />

    <If on={$ctx.resolvePreparationTarget.target != IO.Target.Compiled}>
        <Return
            value={{
                valid: $ctx.resolvePreparationTarget.target == IO.Target.Source
            }}
        />
    </If>

    <If on={$ctx.resolvePreparationTarget.compiled != null}>
        <Call
            fn="../index.prepareCompiledReference"
            in={[
                $in.references,
                $ctx.resolvePreparationTarget.compiled
            ]}
        />

        <If on={$ctx.prepareCompiledReference}>
            <Return
                value={{
                    valid: true
                }}
            />
        </If>
    </If>

    <Return
        value={{
            valid: false,
            issue: {
                reference: $in.reference,
                message: $in.diagnostic
            }
        }}
    />
</Module>
