<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.CompiledWalk} out={Preparation.CompiledWalk} />

    <Call
        fn="../index.selectPreparationModule"
        in={[
            $in.references,
            $in.index
        ]}
    />

    <If on={$ctx.selectPreparationModule.length != 0}>
        <Loop on={$in.running}>
            <Call
                module="walk_reference"
                in={{
                    references: $in.references,
                    diagnostic: $in.diagnostic,
                    items: $ctx.selectPreparationModule,
                    index: 0,
                    valid: true,
                    running: true
                }}
            />
        </Loop>

        <Return
            value={{
                ...$in,
                index: $in.index + 1,
                valid: $ctx.walk_reference.valid,
                running: $ctx.walk_reference.valid && $in.index + 1 < $in.count
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: true,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
