<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.CompiledWalk} out={Preparation.CompiledWalk} />

    <Call
        fn="../index.selectPreparationModule"
        in={[
            $in.references,
            $in.index
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="walk_reference"
            in={{
                ...$in,
                count: $ctx.selectPreparationModule,
                index: 0,
                running: $ctx.selectPreparationModule != 0
            }}
        />
    </Loop>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.walk_reference.valid,
            running: $ctx.walk_reference.valid && $in.index + 1 < $in.count
        }}
    />
</Module>
