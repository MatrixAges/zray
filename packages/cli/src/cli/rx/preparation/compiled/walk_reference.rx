<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.CompiledRefWalk} out={Preparation.CompiledRefWalk} />

    <If on={$in.items[$in.index].role == IO.Role.ModuleCall}>
        <If on={$in.items[$in.index].is_package}>
            <Call
                module="reference"
                in={{
                    references: $in.references,
                    diagnostic: $in.diagnostic,
                    reference: $in.items[$in.index]
                }}
            />

            <If on={!$ctx.reference.valid}>
                <Return
                    value={{
                        ...$in,
                        index: $in.index + 1,
                        valid: false,
                        running: false,
                        issue: $ctx.reference.issue
                    }}
                />
            </If>
        </If>
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.items.length
        }}
    />
</Module>
