<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.CompiledPass} out={Preparation.PassResult} />

    <Call fn="cursor" in={$in} />

    <Loop on={$in.running}>
        <Call module="walk_module" />
    </Loop>

    <Return
        value={$ctx.walk_module.pick([
            "valid",
            "issue"
        ])}
    />
</Module>
