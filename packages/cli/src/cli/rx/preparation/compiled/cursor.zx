import { module_executable_required } from "../const"

import type { CompiledPass, CompiledWalk } from "../model"

export type Input = CompiledPass

export type Output = CompiledWalk

export default function (in: Input): Output {
    return {
        references: in.references,
        diagnostic: module_executable_required,
        count: in.module_count,
        index: 0,
        valid: true,
        running: in.module_count != 0
    }
}
