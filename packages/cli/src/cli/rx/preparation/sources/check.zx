import { validatePreparedSource } from "rx_preparation_host"

import type { NewSources as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { preparation, first, count } = in

    const checked = loop(first, {
        while: index => index < count,
        next: index => {
            validatePreparedSource(preparation, index)

            index += 1
        }
    })
}
