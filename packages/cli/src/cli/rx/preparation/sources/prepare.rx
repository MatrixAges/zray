<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.Request} out={void} />

    <Call fn="../index.reservePreparationRoots" in={$in.preparation} />

    <Loop on={$in.index < $in.count}>
        <Call
            module="register"
            in={{
                preparation: $in.preparation,
                count: $ctx.reservePreparationRoots,
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.running}>
        <Call
            module="roots"
            in={{
                ...$in,
                count: $ctx.reservePreparationRoots,
                index: 0,
                running: $ctx.reservePreparationRoots != 0
            }}
        />
    </Loop>
</Module>
