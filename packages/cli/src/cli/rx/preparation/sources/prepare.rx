<Module>
    <Type from="../index" as="IO" />

    <Args in={IO.Preparation} out={void} />

    <Call fn="../index.reservePreparationRoots" in={$in} />

    <Call
        fn="register"
        in={{
            preparation: $in,
            count: $ctx.reservePreparationRoots
        }}
    />

    <Loop on={$in.running}>
        <Call
            module="roots"
            in={{
                preparation: $in,
                count: $ctx.reservePreparationRoots,
                index: 0,
                running: $ctx.reservePreparationRoots != 0
            }}
        />
    </Loop>
</Module>
