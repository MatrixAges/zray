<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.SourcePass} out={void} />

    <Loop on={$in.index < $in.count}>
        <Call
            module="register"
            in={{
                preparation: $in.preparation,
                count: $in.count,
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.running}>
        <Call
            module="roots"
            in={{
                ...$in,
                index: 0,
                running: $in.count != 0
            }}
        />
    </Loop>
</Module>
