import read from "./root.rx"

import type { Range as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { preparation, count } = in

    const loaded = loop(0, {
        while: index => index < count,
        next: index => {
            read([
                preparation,
                index
            ])

            index += 1
        }
    })
}
