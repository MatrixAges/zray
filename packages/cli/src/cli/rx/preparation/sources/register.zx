import { registerPreparationRoot } from "rx_preparation_host"

import type { Range as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const { preparation, count } = in

    const completed = loop(0, {
        while: index => index < count,
        next: index => {
            registerPreparationRoot(preparation, index)

            index += 1
        }
    })
}
