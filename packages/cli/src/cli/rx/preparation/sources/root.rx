<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.Root} out={void} />

    <Call
        fn="../index.hasPreparedRoot"
        in={[
            $in.preparation,
            $in.index
        ]}
    />

    <If on={!$ctx.hasPreparedRoot}>
        <Call
            fn="../index.loadPreparationRoot"
            in={[
                $in.preparation,
                $in.index
            ]}
        />

        <If on={!$in.scoped}>
            <Call
                fn="check"
                in={{
                    preparation: $in.preparation,
                    first: $ctx.loadPreparationRoot + 1
                }}
            />
        </If>
    </If>
</Module>
