<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.Root} out={void} />

    <Call
        fn="../index.loadPreparationRoot"
        in={[
            $in.preparation,
            $in.index
        ]}
    />

    <If on={$ctx.loadPreparationRoot != null}>
        <If on={!$in.scoped}>
            <Loop on={$in.index < $in.count}>
                <Call
                    module="check"
                    in={{
                        preparation: $in.preparation,
                        count: $ctx.loadPreparationRoot.count,
                        index: $ctx.loadPreparationRoot.first + 1
                    }}
                />
            </Loop>
        </If>
    </If>
</Module>
