<Module>
    <Type from="../model" as="Step" />

    <Args in={Step.RootWalk} out={Step.RootWalk} />

    <Call
        module="root"
        in={$in.pick([
            "preparation",
            "scoped",
            "index"
        ])}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
