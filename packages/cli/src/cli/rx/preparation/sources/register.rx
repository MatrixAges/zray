<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.RangeWalk} out={Model.RangeWalk} />

    <Call
        fn="../index.registerPreparationRoot"
        in={[
            $in.preparation,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
