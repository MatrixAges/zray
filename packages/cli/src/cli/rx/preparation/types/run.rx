<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.TypePass} out={Preparation.PassResult} />

    <Store from="seen" as="seen" />

    <Call
        fn="seed_seen"
        in={{
            paths: $in.initial_paths
        }}
        setter={[$store.seen.visited]}
    />

    <Call module="walk" in={$in.omit(["initial_paths"])} />

    <Return value={$ctx.walk} />
</Module>
