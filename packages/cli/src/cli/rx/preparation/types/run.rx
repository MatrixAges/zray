<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.TypePass} out={bool} />

    <Call fn="../index.copyInitialTypeSources" in={$in.types} />

    <Call
        fn="initial"
        in={{
            types: $in.types,
            count: $ctx.copyInitialTypeSources
        }}
    />

    <Call module="walk" in={$in} />

    <Return value={$ctx.walk} />
</Module>
