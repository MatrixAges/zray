<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.TypeRefWalk} out={Preparation.TypeRefWalk} />

    <If on={$in.items[$in.index - 1].role == IO.Role.TypeImport}>
        <If on={$in.items[$in.index - 1].is_package}>
            <Call
                module="reference"
                in={{
                    types: $in.types,
                    references: $in.references,
                    scoped: $in.scoped,
                    diagnostic: $in.diagnostic,
                    ref_index: $in.index - 1
                }}
            />

            <If on={!$ctx.reference}>
                <Return
                    value={{
                        ...$in,
                        index: $in.index - 1,
                        valid: false,
                        running: false
                    }}
                />
            </If>
        </If>
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index - 1,
            running: $in.index > 1
        }}
    />
</Module>
