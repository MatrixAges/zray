import { type_zx_required } from "../const"

import type { TypeWalk, TypeWalkStart } from "../model"

export type Input = TypeWalkStart

export type Output = TypeWalk

export default function (in: Input): Output {
    return {
        references: in.references,
        scoped: in.scoped,
        diagnostic: type_zx_required,
        count: in.module_count,
        index: 0,
        valid: true,
        running: in.module_count != 0
    }
}
