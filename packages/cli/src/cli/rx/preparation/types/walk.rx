<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.TypePass} out={bool} />

    <Call fn="../index.preparationModuleCount" in={$in.references} />

    <Call
        fn="cursor"
        in={{
            ...$in,
            count: $ctx.preparationModuleCount
        }}
    />

    <Loop on={$in.running}>
        <Call module="walk_module" />
    </Loop>

    <Return value={$ctx.walk_module.valid} />
</Module>
