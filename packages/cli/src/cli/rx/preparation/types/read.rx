<Module>
    <Type from="../model" as="Preparation" />

    <Args in={Preparation.TypeRead} out={bool} />

    <Store from="seen" as="seen" />

    <Call
        fn="admit_path"
        in={{
            visited: $store.seen.visited,
            path: $in.path
        }}
        setter={[$store.seen.visited]}
    />

    <If on={!$ctx.admit_path}>
        <Return value={true} />
    </If>

    <Call
        fn="../index.validateTypeSourceFile"
        in={[
            $in.types,
            $in.path
        ]}
    />

    <If on={!$in.scoped}>
        <Call
            fn="../index.validateTypeSourceRoot"
            in={[
                $in.types,
                $in.path
            ]}
        />
    </If>

    <Call
        fn="../index.readPreparedTypeSource"
        in={[
            $in.types,
            $in.ref_index,
            $in.path
        ]}
    />

    <Return value={$ctx.readPreparedTypeSource} />
</Module>
