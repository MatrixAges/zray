<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />
    <Type from="../../collection/index" as="Collection" />

    <Args in={Preparation.TypeReference} out={bool} />

    <Call fn="../index.isPreparationPackage" in={$in.references} />

    <If on={!$ctx.isPreparationPackage}>
        <Return value={true} />
    </If>

    <Call
        fn="../index.resolvePreparationTarget"
        in={[
            $in.references,
            true
        ]}
    />

    <If on={$ctx.resolvePreparationTarget == IO.Target.Invalid}>
        <Return value={false} />
    </If>

    <If on={$ctx.resolvePreparationTarget == IO.Target.Source}>
        <Call fn="../index.preparationSourcePath" in={$in.references} />

        <Call fn="../../collection/kind" />

        <If on={$ctx.kind == Collection.Kind.Zx}>
            <Call module="read" in={$in.types} />

            <Return value={$ctx.read} />
        </If>
    </If>

    <Call
        fn="../index.reportPreparationReference"
        in={[
            $in.references,
            $in.diagnostic
        ]}
    />

    <Return value={false} />
</Module>
