<Module>
    <Type from="../index" as="IO" />
    <Type from="../model" as="Preparation" />
    <Type from="../../collection/index" as="Collection" />

    <Args in={Preparation.TypeReference} out={Preparation.PassResult} />

    <Call
        fn="../index.resolvePreparationTarget"
        in={[
            $in.references,
            $in.reference,
            true
        ]}
    />

    <If on={$ctx.resolvePreparationTarget.target == IO.Target.Invalid}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <If on={$ctx.resolvePreparationTarget.target == IO.Target.Source}>
        <Call fn="../../collection/kind" in={$ctx.resolvePreparationTarget.source_path} />

        <If on={$ctx.kind == Collection.Kind.Zx}>
            <Call
                module="read"
                in={{
                    references: $in.references,
                    reference: $in.reference,
                    scoped: $in.scoped,
                    path: $ctx.resolvePreparationTarget.source_path
                }}
            />

            <Return
                value={{
                    valid: $ctx.read
                }}
            />
        </If>
    </If>

    <Return
        value={{
            valid: false,
            issue: {
                reference: $in.reference,
                message: $in.diagnostic
            }
        }}
    />
</Module>
