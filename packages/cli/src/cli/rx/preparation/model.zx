import type { TextColumn } from "memory"
import type {
    ModuleReference,
    Preparation,
    References
} from "rx_preparation_host"

export type TypePass = {
    references: References,
    module_count: u64,
    scoped: bool,
    initial_paths: string[]
}

export type TypeWalkStart =
    TypePass.Omit("initial_paths")

export type TypeModuleState = {
    references: References,
    scoped: bool,
    diagnostic: string
}

export type TypeReference = TypeModuleState & {
    reference: ModuleReference
}

export type TypeRead = {
    references: References,
    reference: ModuleReference,
    scoped: bool,
    path: string
}

export type Visited = {
    paths: string[]
}

export type SeedSeenInput = {
    paths: string[]
}

export type AdmitPathInput = {
    visited: Visited,
    path: string
}

export type CompiledPass = {
    references: References,
    module_count: u64
}

export type Range = {
    preparation: Preparation,
    count: u64
}

export type Request = {
    preparation: Preparation,
    scoped: bool
}

export type ProjectRequest = Request & {
    root: string,
    evidence_paths: TextColumn
}

export type Evidence = {
    root: string,
    paths: TextColumn,
    count: u64
}

export type SourcePass = Request & Range

export type Root = Request & {
    index: u64
}

export type CompiledModuleState = {
    references: References,
    diagnostic: string
}

export type CompiledReference = CompiledModuleState & {
    reference: ModuleReference
}

export type RootWalk = Root & Range & {
    running: bool
}

export type Cursor = {
    count: u64,
    index: u64,
    valid: bool,
    running: bool,
    issue?: ReferenceIssue
}

export type ReferenceIssue = {
    reference: ModuleReference,
    message: string
}

export type PassResult = {
    valid: bool,
    issue?: ReferenceIssue
}

export type CompiledWalk = CompiledModuleState & Cursor

export type TypeWalk = TypeModuleState & Cursor

export type CompiledRefWalk = CompiledModuleState & {
    items: ModuleReference[],
    index: u64,
    valid: bool,
    running: bool,
    issue?: ReferenceIssue
}

export type TypeRefWalk = TypeModuleState & {
    items: ModuleReference[],
    index: u64,
    valid: bool,
    running: bool,
    issue?: ReferenceIssue
}

export type RangeWalk = Range & {
    index: u64
}
