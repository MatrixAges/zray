import type { Preparation, References, TypeSources } from "rx_preparation_host"

export type TypePass = {
    types: TypeSources,
    references: References,
    module_count: u64,
    scoped: bool,
    initial_paths: string[]
}

export type TypeWalkStart =
    TypePass.Pick("types", "references", "module_count", "scoped")

export type TypeReference = {
    types: TypeSources,
    references: References,
    scoped: bool,
    diagnostic: string
}

export type TypeRead = {
    types: TypeSources,
    scoped: bool,
    path: string
}

export type Visited = {
    paths: string[]
}

export type SeedSeenInput = {
    paths: string[]
}

export type AdmitPathInput = {
    visited: Visited,
    path: string
}

export type CompiledPass = {
    references: References,
    module_count: u64
}

export type Range = {
    preparation: Preparation,
    count: u64
}

export type NewSources = {
    preparation: Preparation,
    first: u64,
    count: u64
}

export type Request = {
    preparation: Preparation,
    scoped: bool
}

export type Root = Request & {
    index: u64
}

export type CompiledReference = {
    references: References,
    diagnostic: string
}

export type RootWalk = Root & Range & {
    running: bool
}

export type Cursor = {
    count: u64,
    index: u64,
    valid: bool,
    running: bool
}

export type CompiledWalk = CompiledReference & Cursor

export type TypeWalk = TypeReference & Cursor
