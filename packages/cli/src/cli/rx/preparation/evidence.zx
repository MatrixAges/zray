import { preparationEvidenceCount, recordPreparationEvidence } from "rx_preparation_host"

import type { Preparation as Input } from "rx_preparation_host"

export type Output = void

export default function (in: Input): Output {
    const count = preparationEvidenceCount(in)

    const recorded = loop(0, {
        while: index => index < count,
        next: index => {
            recordPreparationEvidence(in, index)

            index += 1
        }
    })
}
