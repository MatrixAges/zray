import { recordPreparationEvidence } from "rx_preparation_host"

import type { Range as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const recorded = loop(0, {
        while: index => index < in.count,
        next: index => {
            recordPreparationEvidence(in.preparation, index)

            index += 1
        }
    })
}
