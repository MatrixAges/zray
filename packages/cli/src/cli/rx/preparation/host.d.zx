export type Preparation = opaque

export type References = opaque

export type TypeSources = opaque

export enum Role {
    TypeImport,
    ModuleCall,
    Other
}

export enum Target {
    Source,
    Compiled,
    Invalid
}

export type ResolvedTarget = {
    target: Target,
    source_path: string
}

export type LoadedRange = {
    first: u64,
    count: u64
}

export declare function selectPreparationModule(references: References, index: u64): u64 throws { SourceLoadFailure }
export declare function preparationReferenceRole(references: References, index: u64): Role
export declare function isPreparationPackage(references: References): bool
export declare function resolvePreparationTarget(references: References, at_attribute: bool): ResolvedTarget throws {
    SourceLoadFailure
}
export declare function reportPreparationReference(references: References, message: string): void throws { SourceLoadFailure }
export declare function prepareCompiledReference(references: References): bool throws { SourceLoadFailure }

export declare function validateTypeSourceFile(types: TypeSources, path: string): void throws { SourceLoadFailure }
export declare function validateTypeSourceRoot(types: TypeSources, path: string): void throws { SourceLoadFailure }
export declare function readPreparedTypeSource(types: TypeSources, path: string): bool throws { SourceLoadFailure }

export declare function loadPreparationDocuments(preparation: Preparation): bool throws { SourceLoadFailure }
export declare function preparePhysicalRoot(preparation: Preparation): u64 throws { SourceLoadFailure }
export declare function validatePreparedModule(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function collectPreparationTypes(preparation: Preparation): bool throws { SourceLoadFailure }
export declare function reservePreparationRoots(preparation: Preparation): u64 throws { SourceLoadFailure }
export declare function registerPreparationRoot(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function loadPreparationRoot(preparation: Preparation, index: u64): LoadedRange? throws {
    SourceLoadFailure
}
export declare function validatePreparedSource(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function collectPreparationLibraries(preparation: Preparation): bool throws { SourceLoadFailure }
export declare function inferPreparedProject(preparation: Preparation): u64? throws { SourceLoadFailure }
export declare function recordPreparationEvidence(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
