export type Preparation = opaque

export type References = opaque

export enum Role {
    TypeImport,
    ModuleCall,
    Other
}

export enum Target {
    Source,
    Compiled,
    Invalid
}

export type ResolvedTarget = {
    target: Target,
    source_path: string
}

export type LoadedRange = {
    first: u64,
    count: u64
}

export type ModuleReference = {
    role: Role,
    is_package: bool
}

export declare function selectPreparationModule(references: References, index: u64): ModuleReference[] throws {
    SourceLoadFailure
}
export declare function resolvePreparationTarget(
    references: References,
    index: u64,
    at_attribute: bool
): ResolvedTarget throws { SourceLoadFailure }
export declare function reportPreparationReference(
    references: References,
    index: u64,
    message: string
): void throws { SourceLoadFailure }
export declare function prepareCompiledReference(references: References): bool throws { SourceLoadFailure }

export declare function validateTypeSourceFile(references: References, path: string): void throws { SourceLoadFailure }
export declare function validateTypeSourceRoot(references: References, path: string): void throws { SourceLoadFailure }
export declare function readPreparedTypeSource(references: References, index: u64, path: string): bool throws {
    SourceLoadFailure
}

export declare function loadPreparationDocuments(preparation: Preparation): bool throws { SourceLoadFailure }
export declare function preparePhysicalRoot(preparation: Preparation): u64 throws { SourceLoadFailure }
export declare function validatePreparedModule(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function collectPreparationTypes(preparation: Preparation): u64? throws { SourceLoadFailure }
export declare function registerPreparationRoot(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function loadPreparationRoot(preparation: Preparation, index: u64): LoadedRange? throws {
    SourceLoadFailure
}
export declare function validatePreparedSource(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
export declare function collectPreparationLibraries(preparation: Preparation): bool throws { SourceLoadFailure }
export declare function inferPreparedProject(preparation: Preparation): u64? throws { SourceLoadFailure }
export declare function recordPreparationEvidence(preparation: Preparation, index: u64): void throws { SourceLoadFailure }
