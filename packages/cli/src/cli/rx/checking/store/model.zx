import type { StoreCheck, StoreImport } from "rx_checking_host"

export type Visited = {
    paths: string[],
    imports: StoreImport[]
}

export type Input = {
    check: StoreCheck,
    root_count: u64
}

export type RootStep = {
    check: StoreCheck,
    root_count: u64,
    index: u64,
    running: bool
}

export type AdmitInput = {
    batch: u64,
    visited: Visited,
    paths: string[]
}
