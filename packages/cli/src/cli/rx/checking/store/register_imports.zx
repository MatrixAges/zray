import { registerStoreCheckImport } from "rx_checking_host"

import type { RegisterInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const registered = loop(0, {
        while: item => item < in.indices.length,
        next: item => {
            registerStoreCheckImport(in.check, in.indices[item])
            item += 1
        }
    })
}
