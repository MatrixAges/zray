<Module>
    <Type from="model" as="Model" />

    <Args in={Model.ImportWalk} out={Model.ImportWalk} />

    <Call
        fn="../index.registerStoreCheckImport"
        in={[
            $in.check,
            $in.indices[$in.index]
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
