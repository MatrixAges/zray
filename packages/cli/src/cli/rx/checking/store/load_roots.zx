import { storeCheckRootCount } from "rx_checking_host"

import loadRoot from "./load_root"

import type { StoreCheck as Input } from "rx_checking_host"

export type Output = void

export default function (in: Input): Output {
    const count = storeCheckRootCount(in)

    const loaded = loop(0, {
        while: root => root < count,
        next: root => {
            loadRoot([
                in,
                root
            ])

            root += 1
        }
    })
}
