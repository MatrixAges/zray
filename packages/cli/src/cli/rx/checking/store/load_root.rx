<Module>
    <Type from="model" as="Store" />

    <Args in={Store.RootStep} out={Store.RootStep} />

    <Store from="seen" as="seen" />

    <Call
        fn="../index.loadStoreCheckRoot"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <If on={$ctx.loadStoreCheckRoot.length != 0}>
        <Call
            fn="admit_imports"
            in={{
                batch: $in.index,
                visited: $store.seen.visited,
                paths: $ctx.loadStoreCheckRoot
            }}
            setter={[$store.seen.visited]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.root_count
        }}
    />
</Module>
