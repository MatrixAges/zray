export type ProjectCheck = opaque

export type StoreCheck = opaque

export type CheckRows = {
    source_count: u64,
    gateway: bool,
    owner: string,
    roots: string[]
}

export type CallEdge = {
    is_call: bool,
    named: bool,
    target_source: u64
}

export type CallReference = {
    is_call: bool,
    is_function: bool,
    value: string,
    line: u64,
    column: u64
}

export type ModuleCalls = {
    edges: CallEdge[],
    references: CallReference[]
}

export type MatchedCall = {
    target_source: u64,
    line: u64,
    column: u64,
    member?: string
}

export type SelectedCall = {
    owner: string,
    line: u64,
    column: u64,
    member?: string
}

export type SignatureCheck = {
    valid: bool,
    default_call: bool,
    deferred_sources: string[]
}

export type StoreImport = [u64, u64]

export declare function loadCheckProject(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function collectCheckDocuments(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function collectCheckTypes(check: ProjectCheck): CheckRows? throws { SourceLoadFailure }
export declare function buildCheckGraph(
    check: ProjectCheck,
    entry: string,
    roots: string[]
): bool throws { SourceLoadFailure }
export declare function readCheckCallModule(check: ProjectCheck, index: u64): ModuleCalls throws { SourceLoadFailure }
export declare function checkStoreTypes(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function prepareCheckFunction(
    check: ProjectCheck,
    index: u64,
    calls: SelectedCall[]
): string throws { SourceLoadFailure }
export declare function checkCompiledModules(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function checkModulePaths(check: ProjectCheck): bool throws { SourceLoadFailure }

export declare function loadStoreCheckRoot(check: StoreCheck, index: u64): string[] throws { SourceLoadFailure }
export declare function buildStoreCheckGraph(check: StoreCheck, imports: StoreImport[]): bool throws { SourceLoadFailure }
export declare function analyzeStoreCheckSignatures(check: StoreCheck): bool throws { SourceLoadFailure }
export declare function checkStoreRegistry(check: StoreCheck): bool throws { SourceLoadFailure }

export declare function loadFunctionProject(check: ProjectCheck): string? throws { SourceLoadFailure }
export declare function loadFunctionSources(check: ProjectCheck): bool? throws { SourceLoadFailure }
export declare function analyzeFunctionSignatures(check: ProjectCheck): SignatureCheck throws { SourceLoadFailure }
export declare function analyzeCheckedFunction(check: ProjectCheck): bool throws { SourceLoadFailure }
