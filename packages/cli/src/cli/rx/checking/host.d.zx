export type ProjectCheck = opaque

export type StoreCheck = opaque

export type FunctionCheck = opaque

export type CheckRows = {
    source_count: u64,
    module_count: u64,
    gateway: bool,
    owner: string,
    first_module: string
}

export type CallEdge = {
    is_call: bool,
    named: bool,
    target_source: u64
}

export type CallReference = {
    is_call: bool,
    is_function: bool,
    value: string,
    line: u64,
    column: u64
}

export type ModuleCalls = {
    edges: CallEdge[],
    references: CallReference[]
}

export type MatchedCall = {
    target_source: u64,
    line: u64,
    column: u64,
    member?: string
}

export type SignatureCheck = {
    valid: bool,
    default_call: bool,
    deferred_sources: string[]
}

export declare function loadCheckProject(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function collectCheckDocuments(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function collectCheckTypes(check: ProjectCheck): CheckRows? throws { SourceLoadFailure }
export declare function reserveCheckGraph(check: ProjectCheck, entry: string): void throws { SourceLoadFailure }
export declare function registerCheckSource(check: ProjectCheck, index: u64): void
export declare function registerCheckRoot(check: ProjectCheck, index: u64): void
export declare function buildCheckGraph(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function readCheckCallModule(check: ProjectCheck, index: u64): ModuleCalls throws { SourceLoadFailure }
export declare function recordCheckFunctionCalls(
    check: ProjectCheck,
    module: u64,
    calls: MatchedCall[]
): void throws { SourceLoadFailure }
export declare function closeCheckGraph(check: ProjectCheck): void
export declare function checkStoreTypes(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function checkFunction(check: ProjectCheck, index: u64): bool throws { SourceLoadFailure }
export declare function closeCheckFunctions(check: ProjectCheck): void
export declare function checkCompiledModules(check: ProjectCheck): bool throws { SourceLoadFailure }
export declare function checkModulePaths(check: ProjectCheck): bool throws { SourceLoadFailure }

export declare function loadStoreCheckRoot(check: StoreCheck, index: u64): string[] throws { SourceLoadFailure }
export declare function registerStoreCheckImport(check: StoreCheck, index: u64): void throws { SourceLoadFailure }
export declare function buildStoreCheckGraph(check: StoreCheck): bool throws { SourceLoadFailure }
export declare function analyzeStoreCheckSignatures(check: StoreCheck): bool throws { SourceLoadFailure }
export declare function checkStoreRegistry(check: StoreCheck): bool throws { SourceLoadFailure }

export declare function loadFunctionProject(check: FunctionCheck): bool throws { SourceLoadFailure }
export declare function loadFunctionSources(check: FunctionCheck): bool? throws { SourceLoadFailure }
export declare function analyzeFunctionSignatures(check: FunctionCheck): SignatureCheck throws { SourceLoadFailure }
export declare function resolveFunctionModules(check: FunctionCheck): string[] throws { SourceLoadFailure }
export declare function reportFunctionDelegate(check: FunctionCheck): void throws { SourceLoadFailure }
export declare function closeFunctionSignatures(check: FunctionCheck): void
export declare function analyzeCheckedFunction(check: FunctionCheck): bool throws { SourceLoadFailure }
