<Module>
    <Type from="model" as="Project" />

    <Args in={Project.Graph} out={bool} />

    <If on={!$in.gateway || $in.module_count > 0}>
        <Call module="graph" in={$in} />

        <If on={!$ctx.graph}>
            <Return value={false} />
        </If>
    </If>

    <Call fn="../index.checkStoreTypes" in={$in.check} />

    <If on={!$ctx.checkStoreTypes}>
        <Return value={false} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="function_row"
            in={{
                check: $in.check,
                count: $in.source_count,
                index: 0,
                valid: true,
                running: $in.source_count != 0
            }}
        />
    </Loop>

    <Call fn="../index.closeCheckFunctions" in={$in.check} />

    <If on={!$ctx.function_row.valid}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkCompiledModules" in={$in.check} />

    <If on={!$ctx.checkCompiledModules}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkModulePaths" in={$in.check} />

    <Return value={$ctx.checkModulePaths} />
</Module>
