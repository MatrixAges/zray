<Module>
    <Type from="model" as="Project" />
    <Type from="../function/model" as="Function" />

    <Args in={Project.Graph} out={Function.Result} />

    <Call module="graph" in={$in} />

    <If on={!$ctx.graph.valid}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <Call fn="../index.checkStoreTypes" in={$in.check} />

    <If on={!$ctx.checkStoreTypes}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <Loop on={$in.running}>
        <Call
            module="function_row"
            in={{
                check: $in.check,
                roots: $in.roots,
                buckets: $ctx.graph.buckets,
                index: 0,
                valid: true,
                running: $ctx.graph.buckets.length != 0
            }}
        />
    </Loop>

    <If on={!$ctx.function_row.valid}>
        <Return
            value={{
                valid: false,
                diagnostic: $ctx.function_row.diagnostic
            }}
        />
    </If>

    <Call fn="../index.checkCompiledModules" in={$in.check} />

    <If on={!$ctx.checkCompiledModules}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <Call fn="../index.checkModulePaths" in={$in.check} />

    <Return
        value={{
            valid: $ctx.checkModulePaths
        }}
    />
</Module>
