<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Graph} out={Graph.CallIndex} />

    <Call fn="empty_calls" in={$in.source_count} />

    <If on={$in.gateway && $in.roots.length == 0}>
        <Return
            value={{
                valid: true,
                buckets: $ctx.empty_calls
            }}
        />
    </If>

    <Call
        fn="../index.buildCheckGraph"
        in={[
            $in.check,
            $in.gateway ? $in.roots[0] : $in.owner,
            $in.roots
        ]}
    />

    <If on={$ctx.buildCheckGraph}>
        <Loop on={$in.index < $in.roots.length}>
            <Call
                module="index_module"
                in={{
                    check: $in.check,
                    roots: $in.roots,
                    index: 0,
                    buckets: $ctx.empty_calls
                }}
            />
        </Loop>

        <Return
            value={{
                valid: true,
                buckets: $ctx.index_module.buckets
            }}
        />
    </If>

    <Return
        value={{
            valid: false,
            buckets: []
        }}
    />
</Module>
