<Module>
    <Type from="model" as="Graph" />

    <Args in={Graph.Graph} out={bool} />

    <Call
        fn="../index.reserveCheckGraph"
        in={[
            $in.check,
            $in.gateway ? $in.first_module : $in.owner
        ]}
    />

    <Loop on={$in.index < $in.count}>
        <Call
            module="source_row"
            in={{
                check: $in.check,
                count: $in.source_count,
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.index < $in.count}>
        <Call
            module="root_row"
            in={{
                check: $in.check,
                count: $in.module_count,
                index: 0
            }}
        />
    </Loop>

    <Call fn="../index.buildCheckGraph" in={$in.check} />

    <If on={$ctx.buildCheckGraph}>
        <Call
            module="index_calls"
            in={{
                check: $in.check,
                count: $in.module_count
            }}
        />
    </If>

    <Return value={$ctx.buildCheckGraph} />
</Module>
