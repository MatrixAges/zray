<Module>
    <Type from="model" as="Model" />

    <Args in={Model.GraphWalk} out={Model.GraphWalk} />

    <Call
        fn="../index.registerCheckSource"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
