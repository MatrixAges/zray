<Module>
    <Type from="model" as="Project" />

    <Args in={Project.ModuleStep} out={Project.ModuleStep} />

    <Call
        fn="../index.readCheckCallModule"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <Call fn="match_calls" />

    <Call
        fn="group_calls"
        in={{
            owner: $in.roots[$in.index],
            calls: $ctx.match_calls,
            buckets: $in.buckets
        }}
    />

    <Return
        value={{
            check: $in.check,
            roots: $in.roots,
            index: $in.index + 1,
            buckets: $ctx.group_calls
        }}
    />
</Module>
