<Module>
    <Type from="model" as="Project" />

    <Args in={Project.ModuleStep} out={Project.ModuleStep} />

    <Call
        fn="../index.readCheckCallModule"
        in={[
            $in.check,
            $in.index
        ]}
    />

    <Call fn="match_calls" />

    <If on={$ctx.match_calls.length != 0}>
        <Call
            fn="../index.recordCheckFunctionCalls"
            in={[
                $in.check,
                $in.index,
                $ctx.match_calls
            ]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
