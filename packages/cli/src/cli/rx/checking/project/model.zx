import type { CheckRows, ProjectCheck } from "rx_checking_host"

export type Graph = CheckRows & {
    check: ProjectCheck
}

export type Range = {
    check: ProjectCheck,
    count: u64
}

export type ModuleStep = Range & {
    index: u64,
    running: bool
}

export type GraphWalk = {
    check: ProjectCheck,
    count: u64,
    index: u64
}
