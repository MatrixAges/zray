import type { CheckRows, ProjectCheck, SelectedCall } from "rx_checking_host"

export type Graph = CheckRows & {
    check: ProjectCheck
}

export type CallBucket = {
    calls: SelectedCall[]
}

export type CallIndex = {
    valid: bool,
    buckets: CallBucket[]
}

export type ModuleStep = {
    check: ProjectCheck,
    roots: string[],
    index: u64,
    buckets: CallBucket[]
}

export type FunctionWalk = {
    check: ProjectCheck,
    roots: string[],
    index: u64,
    buckets: CallBucket[],
    valid: bool,
    diagnostic?: string,
    running: bool
}
