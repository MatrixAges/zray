import { checkFunction } from "rx_checking_host"

import type { Range as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { check, count } = in

    const first: u64 = 0

    return loop({
        index: first,
        valid: true
    }, {
        while: state => state.valid && state.index < count,
        next: state => {
            state.valid = checkFunction(check, state.index)
            state.index += 1
        },
        return: state => state.valid
    })
}
