<Module>
    <Type from="../index" as="IO" />
    <Type from="../function/model" as="Function" />

    <Args in={IO.ProjectCheck} out={Function.Result} />

    <Call fn="../index.loadCheckProject" in={$in} />

    <If on={!$ctx.loadCheckProject}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <Call fn="../index.collectCheckDocuments" in={$in} />

    <If on={!$ctx.collectCheckDocuments}>
        <Return
            value={{
                valid: false
            }}
        />
    </If>

    <Call fn="../index.collectCheckTypes" in={$in} />

    <If on={$ctx.collectCheckTypes != null}>
        <Call
            module="check_types"
            in={{
                ...$ctx.collectCheckTypes,
                check: $in
            }}
        />

        <Return value={$ctx.check_types} />
    </If>

    <Return
        value={{
            valid: false
        }}
    />
</Module>
