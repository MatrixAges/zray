<Module>
    <Type from="../index" as="IO" />

    <Args in={IO.ProjectCheck} out={bool} />

    <Call fn="../index.loadCheckProject" in={$in} />

    <If on={!$ctx.loadCheckProject}>
        <Return value={false} />
    </If>

    <Call fn="../index.collectCheckDocuments" in={$in} />

    <If on={!$ctx.collectCheckDocuments}>
        <Return value={false} />
    </If>

    <Call fn="../index.collectCheckTypes" in={$in} />

    <If on={!$ctx.collectCheckTypes}>
        <Return value={false} />
    </If>

    <Call fn="../index.reserveCheckCalls" in={$in} />

    <If on={!$ctx.reserveCheckCalls.gateway || $ctx.reserveCheckCalls.module_count > 0}>
        <Call
            module="graph"
            in={{
                ...$ctx.reserveCheckCalls,
                check: $in
            }}
        />

        <If on={!$ctx.graph}>
            <Return value={false} />
        </If>
    </If>

    <Call fn="../index.checkStoreTypes" in={$in} />

    <If on={!$ctx.checkStoreTypes}>
        <Return value={false} />
    </If>

    <Call fn="../index.beginCheckFunctions" in={$in} />

    <Call
        fn="functions"
        in={{
            check: $in,
            count: $ctx.reserveCheckCalls.source_count
        }}
    />

    <Call fn="../index.closeCheckFunctions" in={$in} />

    <If on={!$ctx.functions}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkCompiledModules" in={$in} />

    <If on={!$ctx.checkCompiledModules}>
        <Return value={false} />
    </If>

    <Call fn="../index.checkModulePaths" in={$in} />

    <Return value={$ctx.checkModulePaths} />
</Module>
