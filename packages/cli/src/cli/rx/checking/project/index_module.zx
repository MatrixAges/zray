import {
    isCheckCallEdge,
    recordCheckFunctionCall,
    selectCheckCallModule,
    takeCheckCallReference
} from "rx_checking_host"

import type { ProjectCheck } from "rx_checking_host"

export type Input = [ProjectCheck, u64]

export type Output = void

export default function (in: Input): Output {
    const [check, module] = in

    const count = selectCheckCallModule(check, module)

    const indexed = loop(0, {
        while: edge => edge < count,
        next: edge => {
            if (isCheckCallEdge(check, edge)) {
                const found = loop(false, {
                    while: found => !found,
                    next: found => {
                        found = takeCheckCallReference(check)
                    }
                })

                recordCheckFunctionCall(check, edge)
            }

            edge += 1
        }
    })
}
