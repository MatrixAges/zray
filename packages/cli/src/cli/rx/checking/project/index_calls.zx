import indexModule from "./index_module"

import type { Range as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { check, count } = in

    const indexed = loop(0, {
        while: module => module < count,
        next: module => {
            indexModule([
                check,
                module
            ])

            module += 1
        }
    })
}
