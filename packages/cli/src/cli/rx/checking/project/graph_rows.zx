import { registerCheckRoot, registerCheckSource } from "rx_checking_host"

import type { Graph as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { check, source_count, module_count } = in

    const sources = loop(0, {
        while: index => index < source_count,
        next: index => {
            registerCheckSource(check, index)

            index += 1
        }
    })

    const roots = loop(0, {
        while: index => index < module_count,
        next: index => {
            registerCheckRoot(check, index)

            index += 1
        }
    })
}
