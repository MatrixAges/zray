import { resolvePathFrom } from "lexical_path"
import memory from "memory"

import type { DelegateMatch as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { root, module_paths, module_count, delegate } = in

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < module_count,
        next: state => {
            const path = memory.readTextColumn(module_paths, state.index)

            state.found = resolvePathFrom(root, path) == delegate
            state.index += 1
        },
        return: state => state.found
    })
}
