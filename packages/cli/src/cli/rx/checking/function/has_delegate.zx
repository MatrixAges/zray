import type { DelegateMatch as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop(0, {
        while: index =>
            index < in.module_paths.length &&
            in.module_paths[index] != in.delegate,
        next: index => {
            index += 1
        },
        return: index => index < in.module_paths.length
    })
}
