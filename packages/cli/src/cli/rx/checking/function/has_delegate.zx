import resolvePathParts from "../../../standard/path/resolve"

import type { DelegateMatch as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { root, module_paths, delegate } = in

    return loop({
        index: 0,
        found: false
    }, {
        while: state => !state.found && state.index < module_paths.length,
        next: state => {
            const path = module_paths[state.index]

            state.found = resolvePathParts([
                root,
                path
            ]) == delegate
            state.index += 1
        },
        return: state => state.found
    })
}
