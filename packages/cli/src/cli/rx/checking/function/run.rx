<Module>
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={bool} />

    <Call fn="../index.loadFunctionProject" in={$in.check} />

    <If on={$ctx.loadFunctionProject == null}>
        <Return value={false} />

        <Else>
            <Call fn="../index.loadFunctionSources" in={$in.check} />

            <If on={$ctx.loadFunctionSources == null}>
                <Return value={false} />
            </If>

            <If on={!$in.has_calls || $ctx.loadFunctionSources == true}>
                <Call fn="../index.analyzeFunctionSignatures" in={$in.check} />

                <If on={!$ctx.analyzeFunctionSignatures.valid}>
                    <Return value={false} />
                </If>

                <If on={!$ctx.analyzeFunctionSignatures.default_call}>
                    <Return value={true} />
                </If>

                <If on={$ctx.analyzeFunctionSignatures.deferred_sources.length != 0}>
                    <Call
                        fn="has_delegate"
                        in={{
                            delegate:
                                $ctx.analyzeFunctionSignatures.deferred_sources[0],
                            root: $ctx.loadFunctionProject,
                            module_paths: $in.module_paths,
                            module_count: $in.module_count
                        }}
                    />

                    <If on={!$ctx.has_delegate}>
                        <Call fn="../index.reportFunctionDelegate" in={$in.check} />
                    </If>

                    <Return value={$ctx.has_delegate} />
                </If>
            </If>

            <Call fn="../index.analyzeCheckedFunction" in={$in.check} />

            <Return value={$ctx.analyzeCheckedFunction} />
        </Else>
    </If>
</Module>
