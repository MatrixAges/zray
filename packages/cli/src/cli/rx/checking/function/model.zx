import type { ProjectCheck } from "rx_checking_host"

export type Input = {
    check: ProjectCheck,
    path: string,
    has_calls: bool,
    module_paths: string[]
}

export type Result = {
    valid: bool,
    diagnostic?: string
}

export type DelegateMatch = {
    delegate: string,
    root: string,
    module_paths: string[]
}
