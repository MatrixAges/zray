import locate from "cli/native_module_lookup"

import type { Addition, Names } from "./model"

export type Input = {
    configured: Names,
    additions: Addition[],
    name: string
}

export type Output = bool

export default function (in: Input): Output {
    const { configured, additions, name } = in

    const added = loop({
        index: 0,
        found: false
    }, {
        while: state => state.index < additions.length && !state.found,
        next: state => {
            state.found = additions[state.index].name == name
            state.index += 1
        },
        return: state => state.found
    })

    return added || locate({
        ...configured,
        name,
        last: false
    }) != null
}
