import bytes from "std:bytes"
import os from "std:os"

import driveWidth from "./drive_width"
import separator from "./separator"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const data = bytes.fromText(in)

    if (data.length == 0) {
        return false
    }

    const windows = os.platform() == "win32"

    if (separator([
        data[0],
        windows
    ])) {
        return true
    }

    if (!windows) {
        return false
    }

    const width = driveWidth(data)
    const after_colon = width + 1

    return width != 0 && after_colon < data.length && separator([
        data[after_colon],
        true
    ])
}
