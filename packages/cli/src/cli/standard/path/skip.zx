import separator from "./separator"

export type Input = [u8[], u64, bool, bool]

export type Output = u64

export default function (in: Input): Output {
    const [data, start, windows, separators] = in

    return loop({
        index: start
    }, {
        while: state => state.index < data.length && separator([
            data[state.index],
            windows
        ]) == separators,
        next: state => {
            state.index += 1
        },
        return: state => state.index
    })
}
