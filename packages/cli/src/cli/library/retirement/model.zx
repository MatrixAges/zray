import type { TextColumn } from "memory"
import type { Retirement } from "publication_host"

export enum Selection {
    Invalid,
    Retain,
    Inspect
}

export enum Inspection {
    Skip,
    Resolve,
    Modified
}

export type Entries = {
    paths: TextColumn,
    digests: TextColumn,
    count: u64,
    native_only: bool
}

export type Plan = {
    retirement: Retirement,
    previous: Entries,
    separator: u8
}

export type Candidate = Plan & {
    index: u64
}

export enum Status {
    Ready,
    InvalidInventory,
    Modified,
    OutsideOutput
}

export type Walk = Candidate & {
    status: Status,
    running: bool
}
