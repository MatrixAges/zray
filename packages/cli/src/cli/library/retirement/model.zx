import type { TextColumn } from "memory"

export type Kept = {
    paths: string[]
}

export type KeepInput = {
    kept: Kept,
    path: string
}

export enum Selection {
    Invalid,
    Retain,
    Inspect
}

export enum Inspection {
    Skip,
    Resolve,
    Modified
}

export type Entries = {
    paths: TextColumn,
    digests: TextColumn,
    count: u64,
    native_only: bool
}

export type Observed = {
    cwd: string,
    logical: string[],
    physical: string[]
}

export type Plan = {
    directory: string,
    physical_root: string,
    managed: string[],
    observed: Observed,
    previous: Entries,
    separator: u8
}

export type Candidate = Plan.Omit("managed") & {
    targets: string[],
    index: u64
}

export enum Status {
    Ready,
    InvalidInventory,
    Modified,
    OutsideOutput,
    Overlap,
    MissingParent
}

export type Walk = Candidate & {
    status: Status,
    running: bool
}
