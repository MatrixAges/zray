import type { Retirement } from "publication_host"
import type { Input as InventoryPath } from "../../native_sources/inventory/model"

export type Input = InventoryPath & {
    retained: bool
}

export enum Selection {
    Invalid,
    Retain,
    Inspect
}

export enum Inspection {
    Skip,
    Resolve,
    Modified
}

export type Plan = Retirement

export type Candidate = {
    retirement: Retirement,
    index: u64,
    native_only: bool
}

export enum Status {
    Ready,
    InvalidInventory,
    Modified,
    OutsideOutput
}

export type Walk = Candidate & {
    count: u64,
    status: Status,
    running: bool
}
