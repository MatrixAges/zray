import { RetirementFile } from "publication_host"

import { Inspection } from "./model"

export type Input = RetirementFile

export type Output = Inspection

export default function (in: Input): Output {
    return match in {
        RetirementFile.Missing => Inspection.Skip,
        RetirementFile.Regular => Inspection.Resolve,
        _ => Inspection.Modified
    }
}
