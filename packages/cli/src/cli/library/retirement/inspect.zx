import { PublicationFileKind } from "publication_host"

import { Inspection } from "./model"

export type Input = PublicationFileKind

export type Output = Inspection

export default function (in: Input): Output {
    return match in {
        PublicationFileKind.Missing => Inspection.Skip,
        PublicationFileKind.Regular => Inspection.Resolve,
        _ => Inspection.Modified
    }
}
