import host from "publication_host"

import type { Retirement as Input } from "publication_host"

export type Output = void

export default function (in: Input): Output {
    const count = host.retirementTargetCount(in)

    const registered = loop({
        index: 0
    }, {
        while: state => state.index < count,
        next: state => {
            host.registerRetirementTarget(in, state.index)
            state.index += 1
        }
    })
}
