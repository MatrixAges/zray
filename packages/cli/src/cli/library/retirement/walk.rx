<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Walk} out={Step.Walk} />

    <Store from="kept" as="kept" />

    <Call
        module="check"
        in={$in.pick([
            "directory",
            "physical_root",
            "observed",
            "previous",
            "separator",
            "targets",
            "index"
        ])}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            status: $ctx.check,
            running: $ctx.check == Step.Status.Ready &&
                $in.index + 1 < $in.previous.count
        }}
    />
</Module>
