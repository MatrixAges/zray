<Module>
    <Type from="model" as="Retirement" />

    <Args in={Retirement.Candidate} out={Retirement.Status} />

    <Store from="kept" as="kept" />

    <Call fn="candidate" in={$in} />

    <If on={$ctx.candidate.selection == Retirement.Selection.Invalid}>
        <Return value={Retirement.Status.InvalidInventory} />
    </If>

    <If on={$ctx.candidate.selection == Retirement.Selection.Retain}>
        <Return value={Retirement.Status.Ready} />
    </If>

    <Call
        fn="index.retirementFileKind"
        in={[
            $in.retirement,
            $ctx.candidate.path
        ]}
    />

    <Call fn="inspect" />

    <If on={$ctx.inspect == Retirement.Inspection.Skip}>
        <Return value={Retirement.Status.Ready} />
    </If>

    <If on={$ctx.inspect == Retirement.Inspection.Modified}>
        <Return value={Retirement.Status.Modified} />
    </If>

    <Call
        fn="physical"
        in={{
            retirement: $in.retirement,
            path: $ctx.candidate.path,
            separator: $in.separator
        }}
    />

    <If on={!$ctx.physical.inside}>
        <Return value={Retirement.Status.OutsideOutput} />
    </If>

    <Call
        fn="search"
        in={{
            retirement: $in.retirement,
            targets: $in.targets,
            physical: $ctx.physical.path
        }}
    />

    <If on={$ctx.search}>
        <Return value={Retirement.Status.Ready} />
    </If>

    <Call
        fn="index.checkRetirementInput"
        in={[
            $in.retirement,
            $ctx.candidate.path
        ]}
    />

    <Call
        fn="verify"
        in={{
            retirement: $in.retirement,
            previous: $in.previous,
            index: $in.index,
            path: $ctx.candidate.path
        }}
    />

    <If on={!$ctx.verify}>
        <Return value={Retirement.Status.Modified} />
    </If>

    <Call
        fn="keep_path"
        in={{
            kept: store.kept.kept,
            path: $ctx.candidate.path
        }}
        setter={[store.kept.kept]}
    />

    <Return value={Retirement.Status.Ready} />
</Module>
