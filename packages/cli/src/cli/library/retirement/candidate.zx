import os from "std:os"
import strings from "std:string"
import { resolvePathParts as resolve } from "lexical_path"
import memory from "memory"
import { relativePathFrom } from "publication_host"

import admit from "../../native_sources/inventory/admit"
import { backslash, slash } from "../../package/workspace/const"
import isAbsolute from "../../standard/path/absolute"
import { Selection } from "./model"

import type { Candidate as Input } from "./model"

export type Output = {
    path: string,
    selection: Selection
}

export default function (in: Input): Output {
    const { directory, previous, targets, index } = in

    const entry = memory.readTextColumn(previous.paths, index)

    const path = resolve([
        directory,
        entry
    ])

    const spelling = relativePathFrom(directory, path)

    const relative = match {
        os.platform() == "win32" => strings.replaceAll(spelling, backslash, slash),
        _ => spelling
    }

    const valid = admit({
        path: relative,
        absolute: isAbsolute(relative),
        native_only: previous.native_only
    })

    if (!valid) {
        return {
            path,
            selection: Selection.Invalid
        }
    }

    const retained = loop(0, {
        while: i => i < targets.length && targets[i] != path,
        next: i => {
            i += 1
        },
        return: i => i < targets.length
    })

    return {
        path,
        selection: retained ? Selection.Retain : Selection.Inspect
    }
}
