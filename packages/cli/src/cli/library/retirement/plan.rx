<Module>
    <Type from="model" as="Retirement" />

    <Args in={Retirement.Plan} out={Retirement.Status} />

    <Call fn="index.readRetirement" in={$in} />

    <If on={!$ctx.readRetirement}>
        <Return value={Retirement.Status.Ready} />
    </If>

    <Call fn="index.reserveTargets" in={$in} />
    <Call fn="targets" in={$in} />
    <Call fn="index.retirementOldCount" in={$in} />
    <Call fn="index.retirementNativeOnly" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="walk"
            in={{
                retirement: $in,
                native_only: $ctx.retirementNativeOnly,
                count: $ctx.retirementOldCount,
                index: 0,
                status: Retirement.Status.Ready,
                running: $ctx.retirementOldCount != 0
            }}
        />
    </Loop>

    <Return value={$ctx.walk.status} />
</Module>
