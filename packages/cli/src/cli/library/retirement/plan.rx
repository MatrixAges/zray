<Module>
    <Type from="model" as="Retirement" />

    <Args in={Retirement.Plan} out={Retirement.Status} />

    <Store from="kept" as="kept" />

    <Call fn="index.readRetirement" in={$in.retirement} />

    <If on={$ctx.readRetirement != null}>
        <Loop on={$in.running}>
            <Call
                module="walk"
                in={{
                    ...$in,
                    targets: $ctx.readRetirement,
                    index: 0,
                    status: Retirement.Status.Ready,
                    running: $in.previous.count != 0
                }}
            />
        </Loop>

        <Return value={$ctx.walk.status} />
    </If>

    <Return value={Retirement.Status.Ready} />
</Module>
