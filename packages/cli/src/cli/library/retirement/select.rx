<Module>
    <Type from="model" as="Retirement" />

    <Args in={Retirement.Input} out={Retirement.Selection} />

    <Call module="../../native_sources/inventory/admit" in={$in.omit(["retained"])} />

    <If on={!$ctx.admit}>
        <Return value={Retirement.Selection.Invalid} />
    </If>

    <If on={$in.retained}>
        <Return value={Retirement.Selection.Retain} />
    </If>

    <Return value={Retirement.Selection.Inspect} />
</Module>
