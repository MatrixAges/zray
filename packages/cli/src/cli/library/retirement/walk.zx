import host from "publication_host"

import check from "./check.rx"
import { Status } from "./model"

import type { Plan as Input } from "./model"

export type Output = Status

export default function (in: Input): Output {
    const count = host.retirementOldCount(in)
    const native_only = host.retirementNativeOnly(in)

    return loop({
        index: 0,
        status: Status.Ready
    }, {
        while: row => row.index < count && row.status == Status.Ready,
        next: row => {
            row.status = check({
                retirement: in,
                index: row.index,
                native_only
            })
            row.index += 1
        },
        return: row => row.status
    })
}
