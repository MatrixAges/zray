import { relativePathFrom, resolvePublicationPath } from "publication_host"

import within from "../../native_sources/path/within"
import isAbsolute from "../../standard/path/absolute"

export type Input = {
    root: string,
    path: string,
    separator: u8
}

export type Output = {
    path: string,
    inside: bool
}

export default function (in: Input): Output {
    const path = resolvePublicationPath(in.path, false)
    const relative = relativePathFrom(in.root, path)

    const inside = within({
        path: relative,
        absolute: isAbsolute(relative),
        separator: in.separator
    })

    return {
        path,
        inside
    }
}
