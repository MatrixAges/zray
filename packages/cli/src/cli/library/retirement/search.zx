import {
    PublicationFileKind,
    readPublicationFileKind,
    publicationPathMatches
} from "publication_host"

export type Input = {
    targets: string[],
    physical: string
}

export type Output = bool

export default function (in: Input): Output {
    const { targets, physical } = in

    return loop({
        index: 0,
        found: false
    }, {
        while: row => !row.found && row.index < targets.length,
        next: row => {
            const target = targets[row.index]

            if (readPublicationFileKind(target) == PublicationFileKind.Regular) {
                row.found = publicationPathMatches(target, physical)
            }

            row.index += 1
        },
        return: row => row.found
    })
}
