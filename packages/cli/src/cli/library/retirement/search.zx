import host from "publication_host"
import { RetirementFile } from "publication_host"

import type { Retirement } from "publication_host"

export type Input = {
    retirement: Retirement,
    targets: string[],
    physical: string
}

export type Output = bool

export default function (in: Input): Output {
    const { retirement, targets, physical } = in

    return loop({
        index: 0,
        found: false
    }, {
        while: row => !row.found && row.index < targets.length,
        next: row => {
            const target = targets[row.index]

            if (
                host.retirementFileKind(retirement, target) == RetirementFile.Regular
            ) {
                row.found = host.retirementPhysicalMatches(
                    retirement,
                    target,
                    physical
                )
            }

            row.index += 1
        },
        return: row => row.found
    })
}
