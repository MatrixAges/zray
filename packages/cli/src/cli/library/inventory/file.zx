import host from "publication_host"

import admit from "../../native_sources/inventory/admit"

import type { InventoryCollector as Input } from "publication_host"

export type Output = bool

export default function (in: Input): Output {
    const path = host.inventoryPath(in)

    const valid = admit({
        path,
        absolute: host.absolutePath(path),
        native_only: false
    })

    if (valid) {
        host.addInventoryFile(in, path)
    }

    return valid
}
