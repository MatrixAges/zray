<Module>
    <Type from="model" as="Inventory" />

    <Args in={Inventory.Input} out={Inventory.Output} />

    <Store from="collected" as="state" />

    <Call fn="index.listPublicationDirectory" in={$in.directory} />

    <Loop on={$in.valid && $in.index < $in.entries.length}>
        <Call
            module="step"
            in={{
                ...$in,
                entries: $ctx.listPublicationDirectory,
                index: 0,
                valid: true
            }}
        />
    </Loop>

    <If on={!$ctx.step.valid}>
        <Return
            value={{
                valid: false,
                paths: [],
                digests: []
            }}
        />
    </If>

    <Call fn="finish" in={$store.state.entries} />

    <Return value={$ctx.finish} />
</Module>
