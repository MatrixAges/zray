import host from "publication_host"

import {
    directory_entry,
    end_of_directory,
    named_regular_entry,
    regular_entry
} from "../../publication/const"
import file from "./file"

import type { Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        reading: true,
        valid: true
    }, {
        while: row => row.reading && row.valid,
        next: row => {
            const kind = host.nextInventory(in)

            switch (kind) {
                case end_of_directory:
                    row.reading = false
                case regular_entry:
                    row.valid = file(in)
                default:
                    row.valid = kind == directory_entry || kind == named_regular_entry
            }
        },
        return: row => row.valid
    })
}
