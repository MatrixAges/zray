import path from "std:path"
import string from "std:string"
import { ResourceKind } from "publication_host"

import admit from "../../native_sources/inventory/admit"
import { backslash, slash } from "../../package/workspace/const"
import { Action } from "./model"

import type { ResourceEntry } from "publication_host"
import type { Decision as Output } from "./model"

export type Input = {
    entry: ResourceEntry,
    name: string
}

export default function (in: Input): Output {
    const { entry, name } = in

    const regular = entry.kind == ResourceKind.Regular

    if (regular && entry.path != name) {
        const portable = string.replaceAll(entry.path, backslash, slash)

        const valid = admit({
            path: portable,
            absolute: path.isAbsolute(portable),
            native_only: false
        })

        if (!valid) {
            return {
                action: Action.Invalid
            }
        }

        return {
            action: Action.Keep,
            path: portable
        }
    }

    const skipped = entry.kind == ResourceKind.Directory || regular

    return {
        action: skipped ? Action.Skip : Action.Invalid
    }
}
