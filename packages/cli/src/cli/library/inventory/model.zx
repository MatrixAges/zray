import type { ResourceEntry } from "publication_host"

export enum Action {
    Keep,
    Skip,
    Invalid
}

export type Input = {
    directory: string,
    name: string
}

export type Step = Input & {
    entries: ResourceEntry[],
    index: u64,
    valid: bool
}

export type Decision = {
    action: Action,
    path?: string
}

export type Entries = {
    paths: string[],
    digests: string[]
}

export type Append = {
    entries: Entries,
    path: string,
    digest: string
}

export type Output = {
    valid: bool,
    paths: string[],
    digests: string[]
}
