<Module>
    <Type from="model" as="Inventory" />

    <Args in={Inventory.Step} out={Inventory.Step} />

    <Store from="collected" as="state" />

    <Call
        fn="classify_entry"
        in={{
            entry: $in.entries[$in.index],
            name: $in.name
        }}
    />

    <If on={$ctx.classify_entry.action == Inventory.Action.Invalid}>
        <Return
            value={{
                ...$in,
                valid: false
            }}
        />
    </If>

    <If on={$ctx.classify_entry.path != null}>
        <Call
            fn="../../standard/path/join"
            in={[
                $in.directory,
                $in.entries[$in.index].path
            ]}
        />

        <Call fn="index.digestPublishedFile" />

        <Call
            fn="append_entry"
            in={{
                entries: $store.state.entries,
                path: $ctx.classify_entry.path,
                digest: $ctx.digestPublishedFile
            }}
            setter={[$store.state.entries]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
