import type { ReadColumn, TextColumn } from "memory"

export enum Kind {
    Generated,
    Public,
    Legacy
}

export type Rows = {
    count: u64,
    names: TextColumn
}

export type Modules = Rows & {
    basenames: TextColumn,
    dependencies: ReadColumn
}

export type ExportRow = {
    path: string,
    module?: string,
    source: string
}

export type ModuleRow = {
    name: string,
    path: string,
    dependencies: string[]
}

export type Package = {
    name: string,
    version: string
}

export type ManifestOutput = {
    package: Package,
    exports: ExportRow[]
}

export type Input = {
    package: Package,
    legacy: bool,
    exports: Rows,
    generated: Modules,
    public: Modules
}

export type Output = {
    package: Package,
    valid: bool,
    exports: ExportRow[],
    generated: ModuleRow[],
    public: ModuleRow[]
}
