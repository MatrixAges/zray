<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.Input} out={Layout.Output} />

    <Call
        fn="manifest"
        in={{
            package: $in.package,
            exports: $in.exports
        }}
    />

    <Task name="generated" out={$ctx.modules}>
        <Call
            fn="modules"
            in={{
                kind: Layout.Kind.Generated,
                modules: $in.generated
            }}
        />
    </Task>

    <Task name="public" out={$ctx.modules}>
        <Call
            fn="modules"
            in={{
                kind: $in.legacy ? Layout.Kind.Legacy : Layout.Kind.Public,
                modules: $in.public
            }}
        />
    </Task>

    <If on={$ctx.task.public == null}>
        <Return
            value={{
                package: $ctx.manifest.package,
                valid: false,
                exports: [],
                generated: [],
                public: []
            }}
        />
    </If>

    <Return
        value={{
            package: $ctx.manifest.package,
            valid: true,
            exports: $ctx.manifest.exports,
            generated: $ctx.task.generated ?? [],
            public: $ctx.task.public ?? []
        }}
    />
</Module>
