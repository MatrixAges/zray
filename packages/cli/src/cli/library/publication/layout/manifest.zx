import memory from "memory"

import { default_version, legacy_module } from "../const"

import type { ExportRow, ManifestOutput, Package, Rows } from "./model"

export type Input = {
    package: Package,
    exports: Rows
}

export type Output = ManifestOutput

export default function (in: Input): Output {
    const { exports } = in

    const empty: ExportRow[] = []

    const items = loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < exports.count,
        next: state => {
            const name = memory.readTextColumn(exports.names, state.index)
            const module: string? = name

            state.items = state.items.push({
                path: name,
                module,
                source: ""
            })[0]
            state.index += 1
        },
        return: state => state.items
    })

    const { name, version } = in.package

    return {
        package: {
            name: name == "" ? legacy_module : name,
            version: version == "" ? default_version : version
        },
        exports: items
    }
}
