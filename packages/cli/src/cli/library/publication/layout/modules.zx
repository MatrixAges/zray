import locate from "cli/native_module_lookup"
import memory from "memory"

import {
    module_prefix,
    public_prefix,
    root_file,
    zig_extension
} from "../../../native_sources/const"
import { legacy_module } from "../const"
import { Kind } from "./model"

import type { ModuleRow, Modules } from "./model"

export type Input = {
    kind: Kind,
    modules: Modules
}

export type Output = ModuleRow[]?

export default function (in: Input): Output {
    const { kind, modules } = in

    const legacy = kind == Kind.Legacy
    const prefix = kind == Kind.Generated ? module_prefix : public_prefix
    const empty: ModuleRow[] = []

    return loop({
        index: 0,
        valid: true,
        items: empty
    }, {
        while: state => state.valid && state.index < modules.count,
        next: state => {
            const index = state.index
            const exported = memory.readTextColumn(modules.names, index)
            const name = legacy ? legacy_module : exported

            const repeated = match kind {
                Kind.Generated => false,
                Kind.Legacy => index != 0,
                _ => locate({
                    count: index,
                    names: modules.names,
                    name,
                    last: false
                }) != null
            }

            if (repeated) {
                state.valid = false
            } else {
                const basename = memory.readTextColumn(modules.basenames, index)
                const path = match {
                    legacy => root_file,
                    _ => `${prefix}${basename}${zig_extension}`
                }
                const dependencies =
                    memory.readTextListColumn(modules.dependencies, index)

                state.items = state.items.push({
                    name,
                    path,
                    dependencies
                })[0]
            }

            state.index += 1
        },
        return: state => match state.valid {
            true => state.items,
            _ => null
        }
    })
}
