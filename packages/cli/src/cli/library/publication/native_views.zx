import locate from "cli/native_module_lookup"
import memory from "memory"

import type { ReadColumn, TextColumn } from "memory"
import type { Rows } from "./layout/model"

export type NativeModules = Rows & {
    paths: ReadColumn,
    headers: ReadColumn,
    dependencies: ReadColumn,
    include_paths: ReadColumn
}

export type View = {
    name: string,
    path?: string,
    header?: string,
    dependencies: string[],
    include_paths: string[],
    abi_view?: string
}

export type Input = {
    modules: NativeModules,
    views: Rows & {
        paths: TextColumn
    },
    includes: string[]
}

export type Output = View[]

export default function (in: Input): Output {
    const { modules, views } = in

    const empty: View[] = []

    return loop({
        index: 0,
        items: empty
    }, {
        while: state => state.index < modules.count,
        next: state => {
            const index = state.index
            const name = memory.readTextColumn(modules.names, index)
            const path = memory.readOptionalTextColumn(modules.paths, index)
            const header = memory.readOptionalTextColumn(modules.headers, index)
            const dependencies = memory.readTextListColumn(modules.dependencies, index)
            const includes =
                memory.readOptionalTextListColumn(modules.include_paths, index) ??
                in.includes
            const view = locate({
                count: views.count,
                names: views.names,
                name,
                last: true
            })

            const abi: string? = match {
                view != null => memory.readTextColumn(views.paths, view),
                _ => null
            }

            state.items = state.items.push({
                name,
                path,
                header,
                dependencies,
                include_paths: includes,
                abi_view: abi
            })[0]
            state.index += 1
        },
        return: state => state.items
    })
}
