import memory from "memory"

import type { Reference, Rows } from "./model"

export type Input = Rows

export type Output = Reference[]?

export default function (in: Input): Output {
    const empty: Reference[] = []

    return loop({
        index: 0,
        valid: true,
        items: empty
    }, {
        while: state => state.valid && state.index < in.count,
        next: state => {
            const index = state.index
            const module = memory.readOptionalTextColumn(in.modules, index)

            if (module == null) {
                state.valid = false
            } else {
                const name = memory.readTextColumn(in.names, index)

                state.items = state.items.push({
                    name,
                    module
                })[0]
                state.index += 1
            }
        },
        return: state => match state.valid {
            true => state.items,
            _ => null
        }
    })
}
