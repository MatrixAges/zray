<Module>
    <Type from="model" as="Selection" />

    <Args in={Selection.Input} out={Selection.Output} />

    <Call fn="references" in={$in.omit(["preserve_legacy"])} />

    <If on={$ctx.references && $in.preserve_legacy && $in.source.count == 1}>
        <Call fn="legacy_candidate" in={$in.source} />

        <Return
            value={{
                valid: true,
                legacy: $ctx.legacy_candidate
            }}
        />
    </If>

    <Return
        value={{
            valid: $ctx.references,
            legacy: false
        }}
    />
</Module>
