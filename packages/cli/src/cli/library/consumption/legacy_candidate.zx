import memory from "memory"

import legacy from "../publication/legacy"
import { Form } from "../publication/legacy"

import type { Rows as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return legacy({
        count: in.count,
        name: memory.readOptionalTextColumn(in.modules, 0),
        path: memory.readTextColumn(in.names, 0),
        form: Form.Export
    })
}
