import type { ReadColumn, TextColumn } from "memory"

export type Rows = {
    count: u64,
    names: TextColumn,
    modules: ReadColumn
}

export type Reference = {
    name: string,
    module: string
}

export type Input = {
    source: Rows,
    preserve_legacy: bool
}

export type Output = {
    valid: bool,
    legacy: bool,
    references: Reference[]
}
