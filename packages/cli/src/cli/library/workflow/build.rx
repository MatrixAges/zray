<Module>
    <Type from="index" as="Library" />

    <Args in={Library.Build} out={Library.BuildStatus} />

    <Call fn="index.hasBuildExports" in={$in} />

    <If on={!$ctx.hasBuildExports}>
        <Call fn="index.configureLibraryEntry" in={$in} />
    </If>

    <Call fn="index.analyzeLibraryBuild" in={$in} />

    <If on={!$ctx.analyzeLibraryBuild}>
        <Return value={Library.BuildStatus.Failed} />
    </If>

    <Call fn="index.linkLibraryBuild" in={$in} />
    <Call fn="index.collectBuildSources" in={$in} />
    <Call fn="index.openLibraryBuildCache" in={$in} />
    <Call fn="index.generateLibraryBundle" in={$in} />

    <If on={!$ctx.generateLibraryBundle}>
        <Return value={Library.BuildStatus.Failed} />
    </If>

    <Call fn="index.reportLibraryBuildCache" in={$in} />
    <Call fn="index.resolveLibraryToolchain" in={$in} />
    <Call fn="index.resolveLibraryNativeProject" in={$in} />
    <Call fn="index.createLibraryStaging" in={$in} />
    <Call fn="index.stageLibraryBuild" in={$in} />
    <Call fn="index.publishLibraryBuild" in={$in} />

    <If on={$ctx.publishLibraryBuild}>
        <Return value={Library.BuildStatus.Success} />
    </If>

    <Call fn="index.libraryBuildWatching" in={$in} />

    <If on={$ctx.libraryBuildWatching}>
        <Return value={Library.BuildStatus.Retry} />
    </If>

    <Call fn="index.rejectChangedLibraryBuild" in={$in} />

    <Return value={Library.BuildStatus.Failed} />
</Module>
