<Module>
    <Type from="index" as="Library" />
    <Type from="model" as="Model" />

    <Args in={Model.Input} out={Library.BuildStatus} />

    <If on={!$in.has_exports && $in.fallback_entry == null}>
        <Return value={Library.BuildStatus.MissingEntry} />
    </If>

    <Call
        fn="index.analyzeLibraryBuild"
        in={[
            $in.compilation,
            $in.has_exports ? null : $in.fallback_entry
        ]}
    />

    <If on={!$ctx.analyzeLibraryBuild}>
        <Return value={Library.BuildStatus.Failed} />
    </If>

    <Call fn="index.linkLibraryBuild" in={$in.compilation} />
    <Call fn="index.collectBuildSources" in={$in.compilation} />
    <Call fn="../../compilation/index.openCompilationGeneration" in={$in.compilation} />
    <Call fn="index.generateLibraryBundle" in={$in.compilation} />

    <If on={!$ctx.generateLibraryBundle}>
        <Return value={Library.BuildStatus.Failed} />
    </If>

    <Call fn="../../compilation/index.reportCompilationGeneration" in={$in.compilation} />
    <Call fn="index.resolveLibraryToolchain" in={$in.compilation} />
    <Call fn="index.resolveLibraryNativeProject" in={$in.compilation} />
    <Call fn="index.createLibraryStaging" in={$in.compilation} />
    <Call fn="index.stageLibraryBuild" in={$in.compilation} />
    <Call fn="index.publishLibraryBuild" in={$in.compilation} />

    <If on={$ctx.publishLibraryBuild}>
        <Return value={Library.BuildStatus.Success} />
    </If>

    <If on={$in.watching}>
        <Return value={Library.BuildStatus.Retry} />
    </If>

    <Return value={Library.BuildStatus.Changed} />
</Module>
