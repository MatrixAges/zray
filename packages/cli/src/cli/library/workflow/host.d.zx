export type Build = opaque

export enum BuildStatus {
    Success,
    Failed,
    Retry
}

export type Analysis = opaque

export type Link = opaque

export type SourceRows = opaque

export type Proof = opaque

export declare function hasBuildExports(build: Build): bool
export declare function configureLibraryEntry(build: Build): void throws { LibraryWorkflowFailure }
export declare function analyzeLibraryBuild(build: Build): bool throws { LibraryWorkflowFailure }
export declare function linkLibraryBuild(build: Build): void throws { LibraryWorkflowFailure }
export declare function collectBuildSources(build: Build): void throws { LibraryWorkflowFailure }
export declare function openLibraryBuildCache(build: Build): void throws { LibraryWorkflowFailure }
export declare function generateLibraryBundle(build: Build): bool throws { LibraryWorkflowFailure }
export declare function reportLibraryBuildCache(build: Build): void throws { LibraryWorkflowFailure }
export declare function resolveLibraryToolchain(build: Build): void throws { LibraryWorkflowFailure }
export declare function resolveLibraryNativeProject(build: Build): void throws { LibraryWorkflowFailure }
export declare function createLibraryStaging(build: Build): void throws { LibraryWorkflowFailure }
export declare function stageLibraryBuild(build: Build): void throws { LibraryWorkflowFailure }
export declare function publishLibraryBuild(build: Build): bool throws { LibraryWorkflowFailure }
export declare function libraryBuildWatching(build: Build): bool
export declare function rejectChangedLibraryBuild(build: Build): void throws { LibraryWorkflowFailure }

export declare function analysisExportCount(analysis: Analysis): u64
export declare function missingLibraryExports(analysis: Analysis): void throws { LibraryWorkflowFailure }
export declare function isCompiledLibrary(analysis: Analysis): bool
export declare function loadCompiledLibrary(analysis: Analysis): void throws { LibraryWorkflowFailure }
export declare function beginLibraryAnalysis(analysis: Analysis): void throws { LibraryWorkflowFailure }
export declare function selectLibraryExport(analysis: Analysis, index: u64): void throws { LibraryWorkflowFailure }
export declare function libraryEntryPath(analysis: Analysis): string
export declare function readLibraryDependencies(analysis: Analysis): bool throws { LibraryWorkflowFailure }
export declare function inferLibraryRx(analysis: Analysis): bool throws { LibraryWorkflowFailure }
export declare function inferLibraryZx(analysis: Analysis): void throws { LibraryWorkflowFailure }
export declare function recordLibraryAnalysis(analysis: Analysis): bool throws { LibraryWorkflowFailure }

export declare function linkHasCompiled(link: Link): bool
export declare function takeCompiledLibrary(link: Link): void
export declare function allocateLinkInputs(link: Link): void throws { LibraryWorkflowFailure }
export declare function linkInputCount(link: Link): u64
export declare function prepareLibraryLinkInput(link: Link, index: u64): void throws { LibraryWorkflowFailure }
export declare function linkLibraryInputs(link: Link): void throws { LibraryWorkflowFailure }
export declare function librarySourceCount(sources: SourceRows): u64
export declare function appendLibrarySources(sources: SourceRows, index: u64): void throws { LibraryWorkflowFailure }

export declare function proofExportCount(proof: Proof): u64
export declare function selectProofExport(proof: Proof, index: u64): void
export declare function hasExecutableProof(proof: Proof): bool
export declare function confirmProofInterface(proof: Proof): void throws { LibraryWorkflowFailure }
export declare function proofExportName(proof: Proof): string
export declare function proofOutputBase(proof: Proof): string?
export declare function writeProofHeading(proof: Proof): void throws { LibraryWorkflowFailure }
export declare function verifyPublicExport(proof: Proof, output: string?): bool throws { LibraryWorkflowFailure }
