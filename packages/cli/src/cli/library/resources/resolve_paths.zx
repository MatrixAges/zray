import { pathCount, resolveResourcePath } from "library_stage_host"

import type { NativeResources as Input } from "library_stage_host"

export type Output = void

export default function (in: Input): Output {
    const count = pathCount(in)

    const resolved = loop(0, {
        while: index => index < count,
        next: index => {
            resolveResourcePath(in, index)

            index += 1
        }
    })
}
