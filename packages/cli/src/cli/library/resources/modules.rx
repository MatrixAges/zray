<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Step} out={Step.Step} />

    <Call
        fn="index.libraryNativeModule"
        in={[
            $in.resources,
            $in.index
        ]}
    />

    <Call
        fn="../../command/scope/select"
        in={{
            setup: $in.setup,
            name: $ctx.libraryNativeModule.name
        }}
    />

    <Call
        fn="../../command/scope/root"
        in={{
            setup: $in.setup,
            index: $ctx.select
        }}
    />

    <Call
        fn="../../command/scope/includes"
        in={{
            setup: $in.setup,
            index: $ctx.select,
            explicit: $ctx.libraryNativeModule.includes,
            root: $ctx.root
        }}
    />

    <Call
        fn="index.bindLibraryModule"
        in={[
            $in.resources,
            $ctx.root,
            $ctx.includes
        ]}
    />

    <Call
        module="module"
        in={{
            resources: $in.resources,
            includes: $ctx.includes,
            has_bundle: $ctx.libraryNativeModule.has_bundle,
            has_header: $ctx.libraryNativeModule.has_header
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
