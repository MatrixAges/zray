<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Step} out={Step.Step} />

    <Call
        fn="native_module"
        in={{
            modules: $in.modules,
            index: $in.index
        }}
    />

    <Call
        fn="../../command/scope/select"
        in={{
            setup: $in.setup,
            name: $ctx.native_module.name
        }}
    />

    <Call
        fn="../../command/scope/root"
        in={{
            setup: $in.setup,
            index: $ctx.select
        }}
    />

    <Call
        fn="../../command/scope/includes"
        in={{
            setup: $in.setup,
            index: $ctx.select,
            explicit: $ctx.native_module.includes,
            root: $ctx.root
        }}
    />

    <Call
        fn="index.bindLibraryModule"
        in={[
            $in.resources,
            $in.index,
            $ctx.root,
            $ctx.includes
        ]}
    />

    <Call
        module="module"
        in={{
            resources: $in.resources,
            directory: $in.directory,
            name: $ctx.native_module.name,
            includes: $ctx.includes,
            external_includes: $in.external_includes,
            has_bundle: $ctx.native_module.has_bundle,
            header: $ctx.native_module.header
        }}
    />

    <Return
        value={{
            ...$in,
            external_includes: $ctx.module,
            index: $in.index + 1,
            running: $in.index + 1 < $in.count
        }}
    />
</Module>
