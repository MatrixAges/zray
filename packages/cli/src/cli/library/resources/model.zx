import type { Stage } from "library_stage_host"
import type { NativeModules, Setup } from "../../command/scope/model"

export type Preparation = {
    resources: Stage,
    setup: Setup,
    modules: NativeModules,
    count: u64
}

export type Step = Preparation & {
    index: u64,
    running: bool
}

export type ModuleInput = {
    resources: Stage,
    includes: string[],
    has_bundle: bool,
    has_header: bool
}
