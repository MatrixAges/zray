import type { NativeResources } from "library_stage_host"
import type { Setup } from "../../command/scope/model"

export type Preparation = {
    resources: NativeResources,
    setup: Setup,
    count: u64
}

export type Step = Preparation & {
    index: u64,
    running: bool
}

export type ModuleInput = {
    resources: NativeResources,
    includes: string[],
    has_bundle: bool,
    has_header: bool
}
