import { addExternalInclude } from "library_stage_host"
import { absolutePath } from "publication_host"

import type { NativeResources } from "library_stage_host"

export type Input = [NativeResources, string[]]

export type Output = void

export default function (in: Input): Output {
    const [resources, paths] = in

    const collected = loop(0, {
        while: index => index < paths.length,
        next: index => {
            const path = paths[index]

            if (absolutePath(path)) {
                addExternalInclude(resources, path)
            }

            index += 1
        }
    })
}
