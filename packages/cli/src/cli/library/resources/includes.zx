import path from "std:path"

export type Input = {
    paths: string[],
    external_includes: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const { paths, external_includes } = in

    return loop({
        index: 0,
        paths: external_includes
    }, {
        while: state => state.index < paths.length,
        next: state => {
            const item = paths[state.index]

            if (path.isAbsolute(item)) {
                state.paths = state.paths.push(item)[0]
            }

            state.index += 1
        },
        return: state => state.paths
    })
}
