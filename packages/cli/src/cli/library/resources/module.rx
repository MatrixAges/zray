<Module>
    <Type from="model" as="Resources" />

    <Args in={Resources.ModuleInput} out={void} />

    <If on={$in.has_bundle}>
        <Call
            fn="index.bundleNativeModule"
            in={[
                $in.resources,
                $in.has_header
            ]}
        />

        <Call
            fn="includes"
            in={[
                $in.resources,
                $ctx.bundleNativeModule
            ]}
        />

        <Else>
            <Call
                fn="includes"
                in={[
                    $in.resources,
                    $in.includes
                ]}
            />
        </Else>
    </If>

    <If on={$in.has_header}>
        <Call fn="index.writeLibraryNativeHeader" in={$in.resources} />
        <Call fn="index.writeLibraryNativeAdapter" in={$in.resources} />
    </If>
</Module>
