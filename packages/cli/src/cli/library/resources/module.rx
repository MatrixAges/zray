<Module>
    <Type from="model" as="Resources" />

    <Args in={Resources.ModuleInput} out={string[]} />

    <Call module="include_paths" in={$in} />

    <If on={$in.header != null}>
        <Call
            fn="../../workspace_files/native_header"
            in={{
                directory: $in.directory,
                name: $in.name,
                header: $in.header
            }}
        />

        <Call module="../../workspace_files/write_artifact" />

        <Call
            fn="../../workspace_files/native_path"
            in={{
                directory: $in.directory,
                name: $in.name
            }}
        />

        <Call fn="index.renderLibraryNativeAdapter" />

        <Call
            module="../../workspace_files/write_artifact"
            in={{
                path: $ctx.native_path,
                source: $ctx.renderLibraryNativeAdapter
            }}
        />
    </If>

    <Return value={$ctx.include_paths} />
</Module>
