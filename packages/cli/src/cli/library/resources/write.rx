<Module>
    <Type from="model" as="Resources" />

    <Args in={Resources.Preparation} out={string[]} />

    <Call
        fn="../../command/scope/paths"
        in={{
            root: $in.setup.root,
            paths: $in.setup.libraries
        }}
    />

    <If on={$in.count != 0}>
        <Call
            module="walk"
            in={{
                resources: $in.resources,
                setup: $in.setup,
                count: $in.count,
                modules: $in.modules,
                index: 0,
                running: true
            }}
        />
    </If>

    <Return value={$ctx.paths} />
</Module>
