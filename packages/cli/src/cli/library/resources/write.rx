<Module>
    <Type from="model" as="Resources" />

    <Args in={Resources.Preparation} out={Resources.Output} />

    <Call
        fn="../../command/scope/paths"
        in={{
            root: $in.setup.root,
            paths: $in.setup.libraries
        }}
    />

    <Loop on={$in.running}>
        <Call
            module="modules"
            in={{
                ...$in,
                external_includes: [],
                index: 0,
                running: $in.count != 0
            }}
        />
    </Loop>

    <Return
        value={{
            library_paths: $ctx.paths,
            external_includes: $ctx.modules.external_includes
        }}
    />
</Module>
