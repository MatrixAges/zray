<Module>
    <Type from="model" as="Resources" />

    <Args in={Resources.Preparation} out={void} />

    <Call fn="index.allocateNativeRows" in={$in.resources} />

    <Call
        fn="../../command/scope/paths"
        in={{
            owner: $in.setup.owner,
            root: $in.setup.root,
            paths: $in.setup.libraries
        }}
    />

    <Call
        fn="index.bindLibraryPaths"
        in={[
            $in.resources,
            $ctx.paths
        ]}
    />

    <If on={$in.count != 0}>
        <Call module="walk" in={$in} />
    </If>
</Module>
