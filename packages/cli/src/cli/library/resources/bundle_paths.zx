import { bundleFileCount, recordBundlePath } from "library_stage_host"

import type { NativeResources as Input } from "library_stage_host"

export type Output = void

export default function (in: Input): Output {
    const count = bundleFileCount(in)

    const recorded = loop(0, {
        while: index => index < count,
        next: index => {
            recordBundlePath(in, index)

            index += 1
        }
    })
}
