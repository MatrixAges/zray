import bytes from "std:bytes"
import { libraryEntryPath } from "library_workflow_host"

import { rx_suffix } from "./const"

import type { Analysis as Input } from "library_workflow_host"

export type Output = bool

export default function (in: Input): Output {
    const path = bytes.fromText(libraryEntryPath(in))
    const suffix = bytes.fromText(rx_suffix)

    if (path.length < suffix.length) {
        return false
    }

    const start = path.length - suffix.length

    return loop({
        index: 0,
        equal: true
    }, {
        while: current => current.index < suffix.length && current.equal,
        next: current => {
            const index = current.index

            current.equal = path[start + index] == suffix[index]
            current.index += 1
        },
        return: current => current.equal
    })
}
