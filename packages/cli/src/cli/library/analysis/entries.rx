<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Entries} out={Step.Entries} />

    <Call
        fn="index.selectLibraryExport"
        in={[
            $in.analysis,
            $in.index
        ]}
    />

    <Call module="entry" in={$in.analysis} />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.entry,
            running: $ctx.entry && $in.index + 1 < $in.count
        }}
    />
</Module>
