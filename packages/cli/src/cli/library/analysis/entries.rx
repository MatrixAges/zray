<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Entries} out={Step.Entries} />

    <Call
        fn="export_entry"
        in={{
            exports: $in.exports,
            index: $in.index
        }}
    />

    <Call
        module="entry"
        in={{
            analysis: $in.analysis,
            entry: $ctx.export_entry
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.entry,
            running: $ctx.entry && $in.index + 1 < $in.count
        }}
    />
</Module>
