<Module>
    <Type from="model" as="Analysis" />

    <Args in={Analysis.Input} out={bool} />

    <If on={$in.export_count == 0}>
        <Call fn="index.missingLibraryExports" in={$in.analysis} />

        <Return value={false} />
    </If>

    <If on={$in.compiled}>
        <Call fn="index.loadCompiledLibrary" in={$in.analysis} />

        <Return value={true} />
    </If>

    <Call fn="index.beginLibraryAnalysis" in={$in.analysis} />

    <Loop on={$in.running}>
        <Call
            module="entries"
            in={{
                analysis: $in.analysis,
                count: $in.export_count,
                index: 0,
                valid: true,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.entries.valid} />
</Module>
