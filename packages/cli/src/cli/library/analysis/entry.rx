<Module>
    <Type from="model" as="Analysis" />

    <Args in={Analysis.EntryInput} out={bool} />

    <Call module="discover" in={$in} />

    <If on={$ctx.discover}>
        <Call fn="index.inferLibraryRx" in={$in.analysis} />

        <If on={!$ctx.inferLibraryRx}>
            <Return value={false} />
        </If>

        <Else>
            <Call fn="index.inferLibraryZx" in={$in.analysis} />
        </Else>
    </If>

    <Call fn="index.recordLibraryAnalysis" in={$in.analysis} />

    <Return value={$ctx.recordLibraryAnalysis} />
</Module>
