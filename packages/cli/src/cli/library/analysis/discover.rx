<Module>
    <Type from="model" as="Analysis" />

    <Args in={Analysis.EntryInput} out={bool} />

    <Call fn="../../sources/path/is_rx" in={$in.entry.path} />

    <If on={$ctx.is_rx}>
        <Return value={true} />
    </If>

    <Call
        fn="index.readLibraryDependencies"
        in={[
            $in.analysis,
            $in.entry.path
        ]}
    />

    <Return value={$ctx.readLibraryDependencies} />
</Module>
