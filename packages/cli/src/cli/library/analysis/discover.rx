<Module>
    <Type from="model" as="Analysis" />

    <Args in={Analysis.EntryInput} out={bool} />

    <Call fn="../../sources/path/is_rx" in={$in.entry_path} />

    <If on={$ctx.is_rx}>
        <Return value={true} />
    </If>

    <Call fn="index.readLibraryDependencies" in={$in.analysis} />

    <Return value={$ctx.readLibraryDependencies} />
</Module>
