import type { Stage } from "library_stage_host"
import type { Files } from "../../workspace_files/model"
import type { Preparation } from "../resources/model"

export type Input = {
    stage: Stage,
    resources: Preparation,
    files: StageFiles
}

export type StageFiles = {
    abi_path: string,
    build_path: string,
    abi: string,
    aliases: Files,
    generated: Files,
    public: Files
}

export type File = {
    directory: string,
    path: string,
    source: string
}

export type FileGroup = {
    directory: string,
    files: Files
}

export type FileWrite = FileGroup & {
    index: u64
}
