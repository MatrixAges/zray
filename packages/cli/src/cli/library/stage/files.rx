<Module>
    <Type from="model" as="Model" />

    <Args in={Model.FileWrite} out={Model.FileWrite} />

    <Call
        fn="../../workspace_files/file"
        in={{
            files: $in.files,
            index: $in.index
        }}
    />

    <Call
        module="write_file"
        in={{
            directory: $in.directory,
            path: $ctx.file.path,
            source: $ctx.file.source
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
