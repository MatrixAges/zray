<Module>
    <Type from="model" as="Model" />

    <Args in={Model.FileWrite} out={Model.FileWrite} />

    <Call
        fn="../../workspace_files/file"
        in={{
            files: $in.files,
            index: $in.index
        }}
    />

    <Call
        fn="index.writeStageFile"
        in={[
            $in.stage,
            $ctx.file.path,
            $ctx.file.source
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
