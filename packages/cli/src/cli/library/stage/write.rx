<Module>
    <Type from="model" as="Stage" />

    <Args in={Stage.Input} out={void} />

    <Call fn="index.prepareStageAbi" in={$in.stage} />

    <Call module="../resources/write" in={$in.resources} />

    <Call
        fn="index.prepareStageLayout"
        in={[
            $in.stage,
            $ctx.write.library_paths
        ]}
    />

    <Call fn="index.writeStageArtifact" in={$in.stage} />

    <Call
        module="write_file"
        in={{
            directory: $in.resources.directory,
            path: $in.files.abi_path,
            source: $in.files.abi
        }}
    />

    <Call
        module="write_files"
        in={{
            directory: $in.resources.directory,
            files: $in.files.aliases
        }}
    />

    <Call
        module="write_files"
        in={{
            directory: $in.resources.directory,
            files: $in.files.generated
        }}
    />

    <Call
        module="write_files"
        in={{
            directory: $in.resources.directory,
            files: $in.files.public
        }}
    />

    <Call fn="index.writeStageManifest" in={$in.stage} />

    <Task name="build">
        <Call fn="index.renderStageBuild" in={$in.stage} />

        <Call
            module="write_file"
            in={{
                directory: $in.resources.directory,
                path: $in.files.build_path,
                source: $ctx.renderStageBuild
            }}
        />
    </Task>

    <Call fn="index.collectStageInventory" in={$in.stage} />

    <Call
        fn="index.writeStageInventory"
        in={[
            $in.stage,
            $ctx.write.external_includes
        ]}
    />
</Module>
