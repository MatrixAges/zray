import { writeAtomic } from "artifact_io"
import memory from "memory"

import type { FileSystem } from "artifact_io"
import type { Files } from "../../workspace_files/model"

export type Input = [FileSystem, Files]

export type Output = void

export default function (in: Input): Output {
    const [fs, files] = in

    const written = loop(0, {
        while: index => index < files.count,
        next: index => {
            writeAtomic(
                fs,
                memory.readTextColumn(files.paths, index),
                memory.readTextColumn(files.sources, index)
            )

            index += 1
        }
    })
}
