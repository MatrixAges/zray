export type Stage = opaque

export type NativeResources = opaque

export type LibraryNativeModule = {
    name: string,
    includes?: string[],
    has_bundle: bool,
    has_header: bool
}


export declare function prepareStageAbi(stage: Stage): void throws { PublicationFailure }
export declare function prepareStageLayout(stage: Stage): void throws { PublicationFailure }
export declare function collectStageInventory(stage: Stage): void throws { PublicationFailure }
export declare function writeStageArtifact(stage: Stage): void throws { PublicationFailure }
export declare function writeStageManifest(stage: Stage): void throws { PublicationFailure }
export declare function writeStageBuild(stage: Stage): void throws { PublicationFailure }
export declare function writeStageInventory(stage: Stage): void throws { PublicationFailure }

export declare function allocateNativeRows(resources: NativeResources): void throws { PublicationFailure }
export declare function bindLibraryPaths(resources: NativeResources, paths: string[]): void
export declare function libraryNativeModule(resources: NativeResources, index: u64): LibraryNativeModule
export declare function bindLibraryModule(
    resources: NativeResources,
    root: string,
    includes: string[]
): void
export declare function bundleNativeModule(
    resources: NativeResources,
    record_bundle: bool
): string[] throws { PublicationFailure }
export declare function addExternalIncludes(resources: NativeResources, paths: string[]): void
    throws { PublicationFailure }
export declare function writeLibraryNativeHeader(resources: NativeResources): void throws { PublicationFailure }
export declare function writeLibraryNativeAdapter(resources: NativeResources): void throws { PublicationFailure }
