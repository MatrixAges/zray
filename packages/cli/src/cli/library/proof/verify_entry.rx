<Module>
    <Type from="model" as="Step" />

    <Args in={Step.Entries} out={Step.Entries} />

    <Call
        module="entry"
        in={{
            compilation: $in.compilation,
            index: $in.index,
            item: $in.exports[$in.index],
            output_base: $in.output_base
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            valid: $ctx.entry && $in.valid,
            running: $in.index + 1 < $in.exports.length
        }}
    />
</Module>
