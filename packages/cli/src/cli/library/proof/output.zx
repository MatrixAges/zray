import bytes from "std:bytes"
import crypto from "std:crypto"
import encoding from "std:encoding"

import { proof_extension } from "./const"

import type { OutputInput as Input } from "./model"

export type Output = string?

export default function (in: Input): Output {
    if (in.output_base == null) {
        return null
    }

    const name = bytes.fromText(in.name)
    const digest = encoding.encodeHex(crypto.sha256(name))

    return `${in.output_base}.${digest}.${proof_extension}`
}
