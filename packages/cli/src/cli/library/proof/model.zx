import type { Compilation } from "compilation_host"

export type Export = {
    name: string,
    executable: bool
}

export type Input = {
    compilation: Compilation,
    exports: Export[],
    output_base?: string
}

export type Entries = {
    compilation: Compilation,
    exports: Export[],
    output_base?: string,
    index: u64,
    valid: bool,
    running: bool
}

export type Entry = {
    compilation: Compilation,
    index: u64,
    item: Export,
    output_base?: string
}

export type OutputInput = {
    name: string,
    output_base?: string
}
