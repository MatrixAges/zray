import { proofExportCount, selectProofExport } from "library_workflow_host"

import entry from "./entry.rx"

import type { Proof as Input } from "library_workflow_host"

export type Output = bool

export default function (in: Input): Output {
    const count = proofExportCount(in)

    return loop({
        index: 0,
        valid: true
    }, {
        while: current => current.index < count,
        next: current => {
            selectProofExport(in, current.index)

            const verified = entry(in)

            current.valid = verified && current.valid
            current.index += 1
        },
        return: current => current.valid
    })
}
