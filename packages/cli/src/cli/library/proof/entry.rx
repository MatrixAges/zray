<Module>
    <Type from="model" as="Proof" />

    <Args in={Proof.Entry} out={bool} />

    <If on={!$in.item.executable}>
        <Call
            fn="index.confirmProofInterface"
            in={[
                $in.proof,
                $in.index
            ]}
        />

        <Return value={true} />
    </If>

    <Call
        fn="output"
        in={{
            name: $in.item.name,
            output_base: $in.output_base
        }}
    />

    <Call
        fn="index.writeProofHeading"
        in={[
            $in.proof,
            $in.index
        ]}
    />

    <Call
        fn="index.verifyPublicExport"
        in={[
            $in.proof,
            $in.index,
            $ctx.output
        ]}
    />

    <Return value={$ctx.verifyPublicExport} />
</Module>
