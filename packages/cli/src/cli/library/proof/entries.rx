<Module>
    <Type from="model" as="Proof" />

    <Args in={Proof.Input} out={bool} />

    <If on={$in.exports.length == 0}>
        <Return value={true} />
    </If>

    <Loop on={$in.running}>
        <Call
            module="verify_entry"
            in={{
                proof: $in.proof,
                exports: $in.exports,
                output_base: $in.output_base,
                index: 0,
                valid: true,
                running: true
            }}
        />
    </Loop>

    <Return value={$ctx.verify_entry.valid} />
</Module>
