<Module>
    <Type from="index" as="Proof" />

    <Args in={Proof.Input} out={bool} />

    <Call fn="index.proofExportCount" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="verify_entry"
            in={{
                proof: $in,
                count: $ctx.proofExportCount,
                index: 0,
                valid: true,
                running: $ctx.proofExportCount != 0
            }}
        />
    </Loop>

    <Return value={$ctx.verify_entry.valid} />
</Module>
