import { appendLibrarySources, librarySourceCount } from "library_workflow_host"

import type { SourceRows as Input } from "library_workflow_host"

export type Output = void

export default function (in: Input): Output {
    const count = librarySourceCount(in)

    const collected = loop(0, {
        while: index => index < count,
        next: index => {
            appendLibrarySources(in, index)

            index += 1
        }
    })
}
