import { appendLibrarySources } from "library_workflow_host"

import type { SourcesInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const collected = loop(0, {
        while: index => index < in.count,
        next: index => {
            appendLibrarySources(in.sources, index)

            index += 1
        }
    })
}
