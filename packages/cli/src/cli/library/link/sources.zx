export type Input = u64[]

export type Output = {
    offsets: u64[],
    total: u64
}

export default function (in: Input): Output {
    const offsets: u64[] = []

    return loop({
        index: 0,
        offsets,
        total: 0
    }, {
        while: state => state.index < in.length,
        next: state => {
            state.offsets = state.offsets.push(state.total)[0]
            state.total += in[state.index]
            state.index += 1
        },
        return: state => ({
            offsets: state.offsets,
            total: state.total
        })
    })
}
