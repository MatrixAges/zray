<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Input} out={void} />

    <If on={$in.has_compiled}>
        <Call fn="index.takeCompiledLibrary" in={$in.link} />

        <Else>
            <Call fn="index.allocateLinkInputs" in={$in.link} />

            <Loop on={$in.index < $in.count}>
                <Call
                    module="collect"
                    in={{
                        link: $in.link,
                        count: $in.count,
                        index: 0
                    }}
                />
            </Loop>

            <Call fn="index.linkLibraryInputs" in={$in.link} />
        </Else>
    </If>
</Module>
