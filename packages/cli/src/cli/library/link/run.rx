<Module>
    <Type from="model" as="Link" />

    <Args in={Link.Input} out={bool} />

    <If on={$in.has_compiled}>
        <Return value={true} />
    </If>

    <Loop on={$in.index < $in.count}>
        <Call
            module="collect"
            in={{
                link: $in.link,
                count: $in.count,
                index: 0
            }}
        />
    </Loop>

    <Call fn="index.linkLibraryInputs" in={$in.link} />

    <Return value={false} />
</Module>
