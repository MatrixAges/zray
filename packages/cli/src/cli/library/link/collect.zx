import { prepareLibraryLinkInput } from "library_workflow_host"

import type { CollectInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const prepared = loop(0, {
        while: index => index < in.count,
        next: index => {
            prepareLibraryLinkInput(in.link, index)

            index += 1
        }
    })
}
