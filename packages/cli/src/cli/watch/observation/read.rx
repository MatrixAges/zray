<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.ReadInput} out={void} />

    <Call fn="index.classify" in={$in.observation} />

    <Switch on={$ctx.classify}>
        <Case value={Snapshot.PathKind.Directory}>
            <Call
                fn="index.readDirectory"
                in={[
                    $in.observation,
                    $in.directory_entries
                ]}
            />
        </Case>

        <Case value={Snapshot.PathKind.File}>
            <Call fn="index.readFile" in={$in.observation} />
        </Case>
    </Switch>
</Module>
