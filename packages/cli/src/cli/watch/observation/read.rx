<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.ReadInput} out={Snapshot.Reading} />

    <Call
        fn="index.classify"
        in={[
            $in.path,
            null
        ]}
    />

    <If
        on={$ctx.classify.kind == Snapshot.PathKind.Directory ||
            $ctx.classify.kind == Snapshot.PathKind.File}
    >
        <Call
            fn="index.readObservationContent"
            in={{
                ...$in,
                directory: $ctx.classify.kind == Snapshot.PathKind.Directory
            }}
        />

        <Return value={$ctx.readObservationContent} />
    </If>

    <Call fn="probe_fact" in={$ctx.classify} />

    <Return value={$ctx.probe_fact} />
</Module>
