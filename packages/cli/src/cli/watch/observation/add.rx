<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.AddInput} out={Snapshot.Admission} />

    <Call
        fn="index.openRegistration"
        in={[
            $in.registration,
            $in.path,
            $in.directory_entries
        ]}
    />

    <Call
        fn="admit"
        in={[
            $ctx.openRegistration,
            $in.directory_entries
        ]}
    />

    <If on={$ctx.admit == Snapshot.Admission.Unchanged}>
        <If on={$in.backend_input && $ctx.openRegistration.backend_preloaded}>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    {
                        directory_entries: $ctx.openRegistration.directory_entries,
                        consumed: $ctx.openRegistration.consumed,
                        consistent: true,
                        backend_preloaded: false
                    }
                ]}
            />
        </If>

        <Return value={$ctx.admit} />
    </If>

    <If on={$ctx.openRegistration.reusable != null}>
        <Call
            fn="index.readCurrent"
            in={[
                $in.registration,
                {
                    path: $ctx.openRegistration.path,
                    directory_entries: false,
                    previous: $ctx.openRegistration.reusable.request
                }
            ]}
        />

        <If on={$ctx.readCurrent.fact.kind == Snapshot.FactKind.Failed}>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    {
                        directory_entries: false,
                        consumed: false,
                        consistent: true,
                        backend_preloaded: false,
                        fact: $ctx.readCurrent.fact
                    }
                ]}
            />

            <Return value={$ctx.admit} />
        </If>

        <If on={$ctx.readCurrent.unchanged}>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    {
                        directory_entries: false,
                        consumed: false,
                        consistent: true,
                        backend_preloaded: false,
                        fact: $ctx.openRegistration.reusable.fact
                    }
                ]}
            />

            <Return value={$ctx.admit} />
        </If>
    </If>

    <Call
        module="read_current"
        in={{
            registration: $in.registration,
            slot: $ctx.openRegistration,
            directory_entries: $in.directory_entries,
            backend_input: $in.backend_input
        }}
    />

    <Call
        fn="index.publishObservation"
        in={[
            $in.registration,
            $ctx.read_current
        ]}
    />

    <Return value={$ctx.admit} />
</Module>
