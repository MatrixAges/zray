<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.AddInput} out={Snapshot.Admission} />

    <Call
        fn="index.openRegistration"
        in={[
            $in.registration,
            $in.path
        ]}
    />

    <Call
        fn="admit"
        in={[
            $ctx.openRegistration,
            $in.directory_entries
        ]}
    />

    <If on={$ctx.admit == Snapshot.Admission.Unchanged}>
        <If on={$in.backend_input && $ctx.openRegistration.backend_preloaded}>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    $ctx.openRegistration.directory_entries,
                    $ctx.openRegistration.consumed,
                    true,
                    false,
                    false
                ]}
            />
        </If>

        <Return value={$ctx.admit} />
    </If>

    <If on={!$in.directory_entries && $ctx.admit == Snapshot.Admission.New}>
        <Call fn="index.reusePrior" in={$in.registration} />

        <If on={$ctx.reusePrior != Snapshot.Reuse.Unavailable}>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    false,
                    false,
                    true,
                    false,
                    true
                ]}
            />

            <Return value={$ctx.admit} />
        </If>
    </If>

    <Call
        fn="index.readCurrent"
        in={[
            $in.registration,
            $in.directory_entries
        ]}
    />

    <If on={$ctx.readCurrent && $ctx.admit == Snapshot.Admission.Upgrade}>
        <Call fn="index.comparePrevious" in={$in.registration} />

        <Call
            fn="index.publishObservation"
            in={[
                $in.registration,
                $in.directory_entries,
                $ctx.openRegistration.consumed,
                $ctx.comparePrevious,
                $ctx.openRegistration.backend_preloaded && !$in.backend_input,
                true
            ]}
        />

        <Return value={$ctx.admit} />
    </If>

    <Call
        fn="index.publishObservation"
        in={[
            $in.registration,
            $in.directory_entries,
            false,
            $ctx.readCurrent || !$ctx.openRegistration.existing,
            $ctx.openRegistration.backend_preloaded && !$in.backend_input,
            true
        ]}
    />

    <Return value={$ctx.admit} />
</Module>
