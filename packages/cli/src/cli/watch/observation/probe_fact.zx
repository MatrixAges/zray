import { FactKind, PathKind } from "snapshot_host"

import type { Classification as Input, Reading as Output } from "snapshot_host"

export default function (in: Input): Output {
    const kind = match {
        in.failure != null => FactKind.Failed,
        in.kind == PathKind.Other => FactKind.Other,
        _ => FactKind.Missing
    }

    return {
        fact: {
            kind,
            tag: in.failure ?? in.tag,
            digest: [],
            physical_path: ""
        }
    }
}
