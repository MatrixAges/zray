<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.ScanInput} out={bool} />

    <If on={!$in.consistent}>
        <Return value={false} />
    </If>

    <If on={$in.versioned}>
        <Call fn="index.startVersions" in={$in.scan} />
    </If>

    <Call fn="scan_rows" in={$in.omit(["consistent"])} />

    <Return value={$ctx.scan_rows} />
</Module>
