<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.ScanInput} out={Snapshot.ScanResult} />

    <If on={!$in.consistent}>
        <Return
            value={{
                same: false,
                updates: []
            }}
        />
    </If>

    <Loop on={$in.same && $in.index < $in.rows.length}>
        <Call
            module="scan_row"
            in={{
                ...$in.omit(["consistent"]),
                index: 0,
                same: true,
                updates: []
            }}
        />
    </Loop>

    <Return
        value={$ctx.scan_row.pick([
            "same",
            "updates",
            "failure"
        ])}
    />
</Module>
