<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.ScanInput} out={bool} />

    <If on={!$in.consistent}>
        <Return value={false} />
    </If>

    <Loop on={$in.same && $in.index < $in.count}>
        <Call
            module="scan_row"
            in={{
                ...$in.omit(["consistent"]),
                index: 0,
                same: true
            }}
        />
    </Loop>

    <Return value={$ctx.scan_row.same} />
</Module>
