import bytes from "std:bytes"

export enum Kind {
    Missing,
    Failed,
    Other,
    File,
    Directory
}

export type State = {
    kind: Kind,
    tag: u32,
    digest: u8[],
    physical_path: string
}

export type Input = {
    left: State,
    right: State
}

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (left.kind != right.kind) {
        return false
    }

    return match left.kind {
        Kind.Missing => true,
        Kind.Failed => left.tag == right.tag,
        Kind.Other => left.tag == right.tag,
        _ => bytes.equals(left.digest, right.digest) &&
            left.physical_path == right.physical_path
    }
}
