import bytes from "std:bytes"
import { FactKind } from "snapshot_host"

import type { Comparison as Input } from "snapshot_host"

export type Output = bool

export default function (in: Input): Output {
    const { left, right } = in

    if (left.kind != right.kind) {
        return false
    }

    return match left.kind {
        FactKind.Missing => true,
        FactKind.Failed => left.tag == right.tag,
        FactKind.Other => left.tag == right.tag,
        _ => bytes.equals(left.digest, right.digest) &&
            left.physical_path == right.physical_path
    }
}
