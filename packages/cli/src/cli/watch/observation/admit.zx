import { Admission } from "./model"

import type { Slot } from "snapshot_host"

export type Input = [Slot, bool]

export type Output = Admission

export default function (in: Input): Output {
    const [slot, directory_entries] = in

    return match {
        !slot.existing => Admission.New,
        directory_entries && !slot.directory_entries => Admission.Upgrade,
        _ => Admission.Unchanged
    }
}
