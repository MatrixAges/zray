import host from "snapshot_host"

import type { Capture as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const count = host.captureCount(in)

    const captured = loop({
        index: 0
    }, {
        while: row => row.index < count,
        next: row => {
            host.captureEntry(in, row.index)

            row.index += 1
        }
    })
}
