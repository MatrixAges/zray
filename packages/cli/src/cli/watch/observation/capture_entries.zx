import host from "snapshot_host"

import type { CaptureInput as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const { capture, count } = in

    const captured = loop({
        index: 0
    }, {
        while: row => row.index < count,
        next: row => {
            host.captureEntry(capture, row.index)

            row.index += 1
        }
    })
}
