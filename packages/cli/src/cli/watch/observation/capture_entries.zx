import host from "snapshot_host"

import type { CaptureInput as Input } from "./model"

export type Output = string[]

export default function (in: Input): Output {
    const { capture, count } = in

    const empty: string[] = []

    return loop({
        index: 0,
        paths: empty
    }, {
        while: row => row.index < count,
        next: row => {
            row.paths = row.paths.push(host.captureEntry(capture, row.index))[0]

            row.index += 1
        },
        return: row => row.paths
    })
}
