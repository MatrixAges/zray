<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.RecordInput} out={Snapshot.Publication} />

    <If on={$in.physical_path != null}>
        <Call
            fn="record_fact"
            in={{
                bytes: $in.bytes,
                physical_path: $in.physical_path
            }}
        />

        <Call
            fn="same"
            in={{
                left: $in.prior ?? $ctx.record_fact,
                right: $ctx.record_fact
            }}
        />

        <Return
            value={{
                directory_entries: false,
                consumed: true,
                consistent: $ctx.same,
                backend_preloaded: $in.backend_preloaded,
                fact: $ctx.record_fact
            }}
        />
    </If>

    <Return
        value={{
            directory_entries: false,
            consumed: false,
            consistent: false,
            backend_preloaded: $in.backend_preloaded,
            fact: {
                kind: Snapshot.FactKind.Failed,
                tag: $in.failure,
                digest: [],
                physical_path: ""
            }
        }}
    />
</Module>
