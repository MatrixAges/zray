<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.RecordInput} out={void} />

    <Call
        fn="index.openRegistration"
        in={[
            $in.registration,
            $in.path
        ]}
    />

    <Call fn="index.recordFile" in={$in.registration} />

    <If on={$ctx.recordFile && $ctx.openRegistration.consumed}>
        <Call fn="index.compareRecorded" in={$in.registration} />

        <Call
            fn="index.publishObservation"
            in={[
                $in.registration,
                false,
                true,
                $ctx.compareRecorded,
                $ctx.openRegistration.backend_preloaded,
                true
            ]}
        />

        <Else>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    false,
                    $ctx.recordFile,
                    $ctx.recordFile,
                    $ctx.openRegistration.backend_preloaded,
                    true
                ]}
            />
        </Else>
    </If>
</Module>
