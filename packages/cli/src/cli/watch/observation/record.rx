<Module>
    <Type from="model" as="Snapshot" />

    <Args in={Snapshot.RecordInput} out={void} />

    <Call
        fn="index.openRegistration"
        in={[
            $in.registration,
            $in.path
        ]}
    />

    <Call fn="index.resolveRecordedPath" in={$in.registration} />

    <If on={$ctx.resolveRecordedPath != null}>
        <Call
            fn="record_fact"
            in={{
                bytes: $in.bytes,
                physical_path: $ctx.resolveRecordedPath
            }}
        />

        <Call
            fn="same"
            in={{
                left: $ctx.openRegistration.prior ?? $ctx.record_fact,
                right: $ctx.record_fact
            }}
        />

        <Call
            fn="index.publishObservation"
            in={[
                $in.registration,
                {
                    directory_entries: false,
                    consumed: true,
                    consistent: $ctx.same,
                    backend_preloaded: $ctx.openRegistration.backend_preloaded,
                    update_state: true,
                    recorded: $ctx.record_fact
                }
            ]}
        />

        <Else>
            <Call
                fn="index.publishObservation"
                in={[
                    $in.registration,
                    {
                        directory_entries: false,
                        consumed: false,
                        consistent: false,
                        backend_preloaded: $ctx.openRegistration.backend_preloaded,
                        update_state: true
                    }
                ]}
            />
        </Else>
    </If>
</Module>
