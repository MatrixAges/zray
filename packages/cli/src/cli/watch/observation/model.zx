export { PathKind, Reuse } from "snapshot_host"

import type { Observation, Registration } from "snapshot_host"

export type { Registration } from "snapshot_host"

export type ScanInput = {
    scan: Observation,
    count: u64,
    consistent: bool,
    versioned: bool,
    reuse_versions: bool
}

export type ScanRows = ScanInput.Omit("consistent")

export type ReadInput = {
    observation: Observation,
    directory_entries: bool
}

export type AddInput = {
    registration: Registration,
    path: string,
    directory_entries: bool,
    backend_input: bool
}

export type RecordInput = AddInput.Pick("registration", "path")

export enum Admission {
    Unchanged,
    New,
    Upgrade
}

export type ScanRow = ScanRows & {
    index: u64,
    same: bool
}
