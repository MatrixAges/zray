export { FactKind, PathKind } from "snapshot_host"

import type {
    Fact,
    FileVersion,
    Reading,
    Registration,
    Slot,
    Timestamp
} from "snapshot_host"

export type { Classification, Publication, Reading, Registration } from "snapshot_host"

export type Observation = {
    path: string,
    directory_entries: bool,
    fact: Fact,
    verified?: FileVersion
}

export type Update = {
    row: u64,
    verified?: FileVersion
}

export type ScanResult = {
    same: bool,
    updates: Update[],
    failure?: u32
}

export type ScanInput = {
    rows: Observation[],
    consistent: bool,
    started?: Timestamp,
    reuse_versions: bool
}

export type ScanRows = ScanInput.Omit("consistent")

export type ReadInput = {
    path: string,
    directory_entries: bool,
    started?: Timestamp
}

export type AddInput = {
    registration: Registration,
    path: string,
    directory_entries: bool,
    backend_input: bool
}

export type RecordInput = {
    bytes: u8[],
    physical_path?: string,
    failure: u32,
    backend_preloaded: bool,
    prior?: Fact
}

export type AddReading = {
    registration: Registration,
    slot: Slot,
    directory_entries: bool,
    backend_input: bool
}

export type CompareReading = AddReading & {
    current: Fact,
    prior: Fact
}

export enum Admission {
    Unchanged,
    New,
    Upgrade
}

export type ScanRow = ScanRows & ScanResult & {
    index: u64
}

export type CompareRow = {
    cursor: ScanRow,
    reading: Reading,
    same: bool
}
