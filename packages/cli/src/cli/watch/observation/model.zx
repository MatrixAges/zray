export { FactKind, PathKind, Reuse } from "snapshot_host"

import type { Fact, FileVersion, Reading, Registration, Timestamp } from "snapshot_host"

export type { Classification, Reading, Registration } from "snapshot_host"

export type Observation = {
    path: string,
    directory_entries: bool,
    fact: Fact,
    verified?: FileVersion
}

export type Update = {
    row: u64,
    verified?: FileVersion
}

export type ScanResult = {
    same: bool,
    updates: Update[],
    failure?: u32
}

export type ScanInput = {
    rows: Observation[],
    consistent: bool,
    started?: Timestamp,
    reuse_versions: bool
}

export type ScanRows = ScanInput.Omit("consistent")

export type ReadInput = {
    path: string,
    directory_entries: bool,
    started?: Timestamp
}

export type AddInput = {
    registration: Registration,
    path: string,
    directory_entries: bool,
    backend_input: bool
}

export type RecordInput = AddInput.Pick("registration", "path") & {
    bytes: u8[]
}

export enum Admission {
    Unchanged,
    New,
    Upgrade
}

export type ScanRow = ScanRows & ScanResult & {
    index: u64
}

export type CompareRow = {
    cursor: ScanRow,
    reading: Reading,
    same: bool
}
