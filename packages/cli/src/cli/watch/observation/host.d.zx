export type Observation = opaque
export type Registration = opaque
export enum FactKind {
    Missing,
    Failed,
    Other,
    File,
    Directory
}

export type Fact = {
    kind: FactKind,
    tag: u32,
    digest: u8[],
    physical_path: string
}

export type Comparison = {
    left: Fact,
    right: Fact
}

export type Publication = {
    directory_entries: bool,
    consumed: bool,
    consistent: bool,
    backend_preloaded: bool,
    update_state: bool,
    recorded?: Fact
}

export type Slot = {
    existing: bool,
    consumed: bool,
    directory_entries: bool,
    backend_preloaded: bool,
    prior?: Fact
}

export enum PathKind {
    Missing,
    Other,
    Directory,
    File
}

export type Classification = {
    kind: PathKind,
    tag: u32
}

export enum Reuse {
    Unavailable,
    Read,
    Failed
}

export declare function versionMatches(scan: Observation, index: u64): bool throws { ObservationFailure }
export declare function readRow(scan: Observation, index: u64, versioned: bool): Comparison throws {
    ObservationFailure
}
export declare function acceptVersion(scan: Observation, index: u64): void

export declare function classify(allocator, io, path: string): Classification throws {
    AccessDenied, AntivirusInterference, BadPathName, Canceled, DeviceBusy, FileBusy,
    FileLocksUnsupported, FileNotFound, FileTooBig, IsDir, NameTooLong, NetworkNotFound,
    NoDevice, NoSpaceLeft, NotDir, OutOfMemory, PathAlreadyExists, PermissionDenied, PipeBusy,
    ProcessFdQuotaExceeded, ReadOnlyFileSystem, Streaming, SymLinkLoop, SystemFdQuotaExceeded,
    SystemResources, Unexpected, WouldBlock
}
export declare function readDirectory(
    observation: Observation,
    all_entries: bool
): void throws { ObservationFailure }
export declare function readFile(observation: Observation): void throws { ObservationFailure }

export declare function openRegistration(registration: Registration, path: string): Slot throws {
    ObservationFailure
}
export declare function reusePrior(registration: Registration): Reuse
export declare function readCurrent(registration: Registration, directory_entries: bool): bool
export declare function comparePrevious(registration: Registration): bool throws {
    ObservationFailure
}
export declare function resolveRecordedPath(registration: Registration): string?
export declare function publishObservation(
    registration: Registration,
    next: Publication
): void throws { ObservationFailure }
