export type Registration = opaque
export enum FactKind {
    Missing,
    Failed,
    Other,
    File,
    Directory
}

export type Fact = {
    kind: FactKind,
    tag: u32,
    digest: u8[],
    physical_path: string
}

export type Comparison = {
    left: Fact,
    right: Fact
}

export type Publication = {
    directory_entries: bool,
    consumed: bool,
    consistent: bool,
    backend_preloaded: bool,
    update_state: bool,
    recorded?: Fact
}

export type Slot = {
    existing: bool,
    consumed: bool,
    directory_entries: bool,
    backend_preloaded: bool,
    prior?: Fact
}

export enum PathKind {
    Missing,
    Other,
    Directory,
    File
}

export type Timestamp = {
    high: i32,
    low: u64
}

export type FileVersion = {
    inode: u64,
    size: u64,
    modified: Timestamp,
    changed: Timestamp,
    read_at: Timestamp
}

export type VersionRequest = {
    previous: FileVersion,
    physical_path: string
}

export type Classification = {
    kind: PathKind,
    tag: u32,
    unchanged: bool,
    failure?: u32
}

export type Reading = {
    fact: Fact,
    verified?: FileVersion
}

export type ContentRequest = {
    path: string,
    directory: bool,
    directory_entries: bool,
    started?: Timestamp
}

export enum Reuse {
    Unavailable,
    Read,
    Failed
}

export declare function classify(
    allocator,
    io,
    path: string,
    previous: VersionRequest?
): Classification throws { OutOfMemory }

export declare function readObservationContent(
    allocator,
    io,
    request: ContentRequest
): Reading throws { OutOfMemory }

export declare function openRegistration(registration: Registration, path: string): Slot throws {
    ObservationFailure
}
export declare function reusePrior(registration: Registration): Reuse
export declare function readCurrent(registration: Registration, directory_entries: bool): bool
export declare function comparePrevious(registration: Registration): bool throws {
    ObservationFailure
}
export declare function resolveRecordedPath(registration: Registration): string?
export declare function publishObservation(
    registration: Registration,
    next: Publication
): void throws { ObservationFailure }
