export type Scan = opaque
export type Observation = opaque
export type Registration = opaque
export type Capture = opaque
export type Directory = opaque

export type DirectoryEntry = {
    name: string,
    is_directory: bool
}

export type Slot = {
    existing: bool,
    consumed: bool,
    directory_entries: bool
}

export enum PathKind {
    Classified,
    Directory,
    File
}

export enum Reuse {
    Unavailable,
    Read,
    Failed
}

export declare function startVersions(scan: Scan): void
export declare function versionMatches(scan: Scan, index: u64): bool throws { ObservationFailure }
export declare function readRow(scan: Scan, index: u64, versioned: bool): bool throws {
    ObservationFailure
}
export declare function acceptVersion(scan: Scan, index: u64): void

export declare function classify(observation: Observation): PathKind throws { ObservationFailure }
export declare function readDirectory(
    observation: Observation,
    all_entries: bool
): void throws { ObservationFailure }
export declare function readFile(observation: Observation): void throws { ObservationFailure }

export declare function nextDirectoryEntry(directory: Directory): DirectoryEntry? throws {
    ObservationFailure
}
export declare function retainDirectoryEntry(
    directory: Directory,
    separator: u8,
    suffix_width: u8
): void throws { ObservationFailure }
export declare function sortDirectoryEntries(directory: Directory, suffix_width: u8): u64
export declare function feedDirectoryEntry(directory: Directory, index: u64): void

export declare function openRegistration(registration: Registration): Slot throws {
    ObservationFailure
}
export declare function reusePrior(registration: Registration): Reuse
export declare function readCurrent(registration: Registration, directory_entries: bool): bool
export declare function comparePrevious(registration: Registration): bool throws {
    ObservationFailure
}
export declare function recordFile(registration: Registration): bool
export declare function compareRecorded(registration: Registration): bool
export declare function publishObservation(
    registration: Registration,
    directory_entries: bool,
    consumed: bool,
    consistent: bool
): void throws { ObservationFailure }

export declare function captureCount(capture: Capture): u64
export declare function captureEntry(capture: Capture, index: u64): void throws { ObservationFailure }
export declare function sortCapture(capture: Capture): void
