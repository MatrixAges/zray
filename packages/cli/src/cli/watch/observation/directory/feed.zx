import host from "snapshot_host"

import type { Feed as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const [directory, count] = in

    const fed = loop(0, {
        while: index => index < count,
        next: index => {
            host.feedDirectoryEntry(directory, index)

            index += 1
        }
    })
}
