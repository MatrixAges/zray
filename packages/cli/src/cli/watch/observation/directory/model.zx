export type Collect = {
    directory_tag: u8,
    names: string[],
    tags: u8[],
    all_entries: bool
}

export type Step = Collect & {
    index: u64
}

export type Admit = {
    all_entries: bool,
    directory_tag: u8,
    name: string,
    tag: u8
}

export type Collected = {
    names: string[],
    tags: u8[]
}

export type AppendInput = {
    collected: Collected,
    name: string,
    tag: u8
}

export type PayloadInput = {
    collected: Collected,
    all_entries: bool
}

export type MergeInput = {
    names: string[],
    order: u64[],
    start: u64,
    mid: u64,
    end: u64,
    merged: u64[]
}
