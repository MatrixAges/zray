import mergeRanges from "./merge_ranges"

export type Input = string[]

export type Output = u64[]

export default function (in: Input): Output {
    const empty: u64[] = []

    const initial = loop({
        index: 0,
        order: empty
    }, {
        while: row => row.index < in.length,
        next: row => {
            row.order = row.order.push(row.index)[0]
            row.index += 1
        },
        return: row => row.order
    })

    return loop({
        width: 1,
        order: initial
    }, {
        while: pass => pass.width < in.length,
        next: pass => {
            const empty_pass: u64[] = []
            const width = pass.width
            const current = pass.order

            const next_order = loop({
                start: 0,
                out: empty_pass
            }, {
                while: span => span.start < in.length,
                next: span => {
                    const mid_raw = span.start + width
                    const mid = mid_raw < in.length ? mid_raw : in.length
                    const end_raw = span.start + width + width
                    const end = end_raw < in.length ? end_raw : in.length

                    span.out = mergeRanges({
                        names: in,
                        order: current,
                        start: span.start,
                        mid,
                        end,
                        merged: span.out
                    })

                    span.start = end
                },
                return: span => span.out
            })

            pass.order = next_order
            pass.width = width + width
        },
        return: pass => pass.order
    })
}
