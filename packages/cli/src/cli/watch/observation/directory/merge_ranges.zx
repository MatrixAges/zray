import bytes from "std:bytes"

import type { MergeInput as Input } from "./model"

export type Output = u64[]

export default function (in: Input): Output {
    const merged = loop({
        left: in.start,
        right: in.mid,
        out: in.merged
    }, {
        while: state => state.left < in.mid && state.right < in.end,
        next: state => {
            const left_item = in.order[state.left]
            const right_item = in.order[state.right]
            const left_bytes = bytes.fromText(in.names[left_item])
            const right_bytes = bytes.fromText(in.names[right_item])

            if (bytes.lessThan(left_bytes, right_bytes)) {
                state.out = state.out.push(left_item)[0]
                state.left += 1
            } else {
                state.out = state.out.push(right_item)[0]
                state.right += 1
            }
        },
        return: state => state
    })

    const with_left = loop({
        pos: merged.left,
        out: merged.out
    }, {
        while: tail => tail.pos < in.mid,
        next: tail => {
            tail.out = tail.out.push(in.order[tail.pos])[0]
            tail.pos += 1
        },
        return: tail => tail.out
    })

    return loop({
        pos: merged.right,
        out: with_left
    }, {
        while: tail => tail.pos < in.end,
        next: tail => {
            tail.out = tail.out.push(in.order[tail.pos])[0]
            tail.pos += 1
        },
        return: tail => tail.out
    })
}
