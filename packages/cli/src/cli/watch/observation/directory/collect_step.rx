<Module>
    <Type from="model" as="Digest" />

    <Args in={Digest.Step} out={Digest.Step} />

    <Store from="entries" as="state" />

    <Call fn="index.nextDirectoryEntry" in={$in.directory} />

    <If on={$ctx.nextDirectoryEntry != null}>
        <Call
            fn="admit_entry"
            in={{
                all_entries: $in.all_entries,
                entry: $ctx.nextDirectoryEntry
            }}
        />

        <If on={$ctx.admit_entry}>
            <Call
                fn="append_entry"
                in={{
                    collected: store.state.collected,
                    entry: $ctx.nextDirectoryEntry
                }}
                setter={[store.state.collected]}
            />
        </If>

        <Return value={$in} />
    </If>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
