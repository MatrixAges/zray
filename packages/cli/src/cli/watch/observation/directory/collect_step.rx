<Module>
    <Type from="model" as="Digest" />

    <Args in={Digest.Step} out={Digest.Step} />

    <Store from="entries" as="state" />

    <Call
        fn="admit_entry"
        in={{
            all_entries: $in.all_entries,
            directory_tag: $in.directory_tag,
            name: $in.names[$in.index],
            tag: $in.tags[$in.index]
        }}
    />

    <If on={$ctx.admit_entry}>
        <Call
            fn="append_entry"
            in={{
                collected: $store.state.collected,
                name: $in.names[$in.index],
                tag: $in.tags[$in.index]
            }}
            setter={[$store.state.collected]}
        />
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
