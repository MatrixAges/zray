<Module>
    <Type from="model" as="Digest" />

    <Args in={Digest.Collect} out={u8[]} />

    <Store from="entries" as="state" />

    <Loop on={$in.running}>
        <Call
            module="collect_step"
            in={{
                directory: $in.directory,
                all_entries: $in.all_entries,
                running: true
            }}
        />
    </Loop>

    <Call
        fn="build_payload"
        in={{
            collected: $store.state.collected,
            all_entries: $in.all_entries
        }}
    />

    <Call fn="index.sha256" />

    <Return value={$ctx.sha256} />
</Module>
