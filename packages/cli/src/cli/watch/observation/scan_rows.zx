import host from "snapshot_host"

import type { ScanRows as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const { scan, versioned, reuse_versions } = in

    const count = host.scanCount(scan)

    return loop({
        index: 0,
        same: true
    }, {
        while: current => current.same && current.index < count,
        next: current => {
            const index = current.index
            const reused = reuse_versions && host.versionMatches(scan, index)

            if (!reused) {
                current.same = host.readRow(scan, index, versioned)
            }

            current.index += 1
        },
        return: current => current.same
    })
}
