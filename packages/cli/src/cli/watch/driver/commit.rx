<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Wait} out={void} />

    <Store from="state" as="watch_state" />

    <If on={$in[1] == Driver.Status.Success}>
        <Call fn="index.adoptPublishedSnapshot" in={$in[0]} />

        <If on={!$ctx.adoptPublishedSnapshot}>
            <Call
                fn="index.captureSnapshot"
                in={[
                    $in[0],
                    Driver.SnapshotSlot.Success
                ]}
            />
        </If>

        <Call
            fn="index.releaseSnapshot"
            in={[
                $in[0],
                Driver.SnapshotSlot.Failure
            ]}
        />

        <Call
            fn="record_snapshot"
            in={{
                snapshots: $store.watch_state.snapshots,
                success: true
            }}
            setter={[$store.watch_state.snapshots]}
        />

        <Else>
            <Call
                module="restore"
                in={{
                    watch: $in[0],
                    has_success: $store.watch_state.snapshots.has_success
                }}
            />

            <Call
                fn="index.captureSnapshot"
                in={[
                    $in[0],
                    Driver.SnapshotSlot.Failure
                ]}
            />

            <Call
                fn="record_snapshot"
                in={{
                    snapshots: $store.watch_state.snapshots,
                    success: false
                }}
                setter={[$store.watch_state.snapshots]}
            />
        </Else>
    </If>
</Module>
