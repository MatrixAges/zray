<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.BuildResult} out={void} />

    <Store from="state" as="watch_state" />

    <If on={$in.status == Driver.Status.Success}>
        <Call fn="index.adoptPublishedSnapshot" in={$in.watch} />

        <If on={$ctx.adoptPublishedSnapshot == null}>
            <Call
                fn="index.captureSnapshot"
                in={[
                    $in.watch,
                    Driver.SnapshotSlot.Success
                ]}
            />

            <Call
                fn="record_snapshot"
                in={{
                    snapshots: $store.watch_state.snapshots,
                    observed: $ctx.captureSnapshot
                }}
                setter={[$store.watch_state.snapshots]}
            />

            <Else>
                <Call
                    fn="record_snapshot"
                    in={{
                        snapshots: $store.watch_state.snapshots,
                        observed: $ctx.adoptPublishedSnapshot
                    }}
                    setter={[$store.watch_state.snapshots]}
                />
            </Else>
        </If>

        <Call
            fn="index.releaseSnapshot"
            in={[
                $in.watch,
                Driver.SnapshotSlot.Failure
            ]}
        />

        <Else>
            <Call
                module="restore"
                in={{
                    watch: $in.watch,
                    observed: $store.watch_state.snapshots.observed
                }}
            />

            <Call
                fn="index.captureSnapshot"
                in={[
                    $in.watch,
                    Driver.SnapshotSlot.Failure
                ]}
            />

            <Call
                fn="record_snapshot"
                in={{
                    snapshots: $store.watch_state.snapshots
                }}
                setter={[$store.watch_state.snapshots]}
            />
        </Else>
    </If>
</Module>
