import host from "watch_host"

import { SnapshotSlot, Status } from "./model"

import type { Cycle as Input, Poll as Output } from "./model"

export default function (in: Input): Output {
    const { watch, status } = in

    const snapshot = match status {
        Status.Success => SnapshotSlot.Success,
        _ => SnapshotSlot.Failure
    }

    return host.writePoll(
        watch,
        snapshot,
        status == Status.BackendFailed,
        true,
        0,
        false,
        null
    )
}
