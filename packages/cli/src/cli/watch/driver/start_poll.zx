import { SnapshotSlot, Status } from "./model"

import type { Cycle as Input, Poll as Output } from "./model"

export default function (in: Input): Output {
    const snapshot = match in.status {
        Status.Success => SnapshotSlot.Success,
        _ => SnapshotSlot.Failure
    }

    return {
        watch: in.watch,
        snapshot,
        retry_backend: in.status == Status.BackendFailed,
        running: true,
        scans: 0,
        changed: false,
        canceled: false,
        scan_error: null
    }
}
