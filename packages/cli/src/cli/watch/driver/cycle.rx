<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Cycle} out={Driver.Cycle} />

    <Store from="state" as="watch_state" />

    <If on={$in.run_application}>
        <Call fn="index.interrupted" in={$in.watch} />

        <If on={$ctx.interrupted}>
            <Return
                value={{
                    ...$in,
                    running: false
                }}
            />
        </If>
    </If>

    <If on={$in.status != Driver.Status.Initial}>
        <Call module="wait" in={$in} />

        <If on={$ctx.wait == Driver.WaitOutcome.Canceled}>
            <Return
                value={{
                    ...$in,
                    running: false,
                    canceled: true
                }}
            />
        </If>

        <If on={$ctx.wait == Driver.WaitOutcome.Changed}>
            <Call
                fn="clear_diagnostic"
                in={$store.watch_state.diagnostics}
                setter={[$store.watch_state.diagnostics]}
            />
        </If>
    </If>

    <Call
        fn="previous"
        in={{
            cache: $in.cache,
            snapshots: $store.watch_state.snapshots
        }}
    />

    <Call
        fn="index.begin"
        in={[
            $in.watch,
            $in.cache,
            $ctx.previous
        ]}
    />

    <Call fn="index.compileTurn" in={$in.watch} />
    <Call fn="index.refreshParseCache" in={$in.watch} />
    <Call fn="index.adoptBackend" in={$in.watch} />

    <Call
        fn="report_diagnostic"
        in={{
            watch: $in.watch,
            normalize: $ctx.compileTurn == Driver.Status.BackendFailed,
            diagnostics: $store.watch_state.diagnostics
        }}
        setter={[$store.watch_state.diagnostics]}
    />

    <Call
        module="commit"
        in={{
            watch: $in.watch,
            status: $ctx.compileTurn
        }}
    />

    <If on={$ctx.compileTurn == Driver.Status.Success}>
        <Call fn="notice_prefix" in={Driver.Notice.Built} />

        <Call
            fn="index.writeWatchNotice"
            in={[
                $in.watch,
                $ctx.notice_prefix,
                $in.output_path,
                false
            ]}
        />

        <If on={$in.run_application}>
            <Call fn="index.interrupted" in={$in.watch} />

            <If on={$ctx.interrupted}>
                <Return
                    value={{
                        ...$in,
                        running: false
                    }}
                />
            </If>

            <Call fn="index.flush" in={$in.watch} />
            <Call fn="index.restart" in={$in.watch} />
        </If>
    </If>

    <Call fn="index.flush" in={$in.watch} />
    <Call fn="index.releaseTurn" in={$in.watch} />

    <Return
        value={{
            ...$in,
            running: true,
            status: $ctx.compileTurn
        }}
    />
</Module>
