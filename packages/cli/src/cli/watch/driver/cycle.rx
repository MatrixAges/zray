<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Cycle} out={Driver.Cycle} />

    <If on={$in.run_application}>
        <Call fn="index.interrupted" in={$in.watch} />

        <If on={$ctx.interrupted}>
            <Call
                fn="index.writeCycle"
                in={[
                    $in.watch,
                    false,
                    $in.status
                ]}
            />

            <Return value={$ctx.writeCycle} />
        </If>
    </If>

    <If on={$in.status != Driver.Status.Initial}>
        <Call module="wait" in={$in} />

        <If on={$ctx.wait}>
            <Call fn="index.clearDiagnostic" in={$in.watch} />
        </If>
    </If>

    <Call fn="previous" in={$in} />

    <Call
        fn="index.begin"
        in={[
            $in.watch,
            $in.cache,
            $ctx.previous
        ]}
    />

    <Call fn="index.compileTurn" in={$in.watch} />
    <Call fn="index.refreshParseCache" in={$in.watch} />
    <Call fn="index.adoptBackend" in={$in.watch} />

    <Call
        fn="index.reportDiagnostic"
        in={[
            $in.watch,
            $ctx.compileTurn == Driver.Status.BackendFailed
        ]}
    />

    <Call
        module="commit"
        in={[
            $in.watch,
            $ctx.compileTurn
        ]}
    />

    <If on={$ctx.compileTurn == Driver.Status.Success}>
        <Call fn="index.announceBuilt" in={$in.watch} />

        <If on={$in.run_application}>
            <Call fn="index.interrupted" in={$in.watch} />

            <If on={$ctx.interrupted}>
                <Call
                    fn="index.writeCycle"
                    in={[
                        $in.watch,
                        false,
                        $in.status
                    ]}
                />

                <Return value={$ctx.writeCycle} />
            </If>

            <Call fn="index.flush" in={$in.watch} />
            <Call fn="index.restart" in={$in.watch} />
        </If>
    </If>

    <Call fn="index.flush" in={$in.watch} />
    <Call fn="index.releaseTurn" in={$in.watch} />

    <Call
        fn="index.writeCycle"
        in={[
            $in.watch,
            true,
            $ctx.compileTurn
        ]}
    />

    <Return value={$ctx.writeCycle} />
</Module>
