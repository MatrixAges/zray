export type Watch = opaque
export type Snapshot = opaque

export enum Status {
    Initial,
    Success,
    Failed,
    Retry,
    BackendFailed
}

export enum SnapshotSlot {
    Success,
    Failure
}

export enum Delay {
    Poll,
    Retry
}

export type ScanResult = {
    changed: bool,
    error_code?: u16
}

export declare function announce(watch: Watch): void throws { WatchFailure }
export declare function interrupted(watch: Watch): bool
export declare function delay(watch: Watch, interval: Delay): void throws { WatchFailure }
export declare function checkCanceled(watch: Watch): void throws { WatchFailure }
export declare function applicationFinished(watch: Watch): bool throws { WatchFailure }
export declare function prepareApplication(watch: Watch): void throws { WatchFailure }
export declare function stopApplication(watch: Watch): void throws { WatchFailure }
export declare function startApplication(watch: Watch): void throws { WatchFailure }
export declare function reportApplicationExit(watch: Watch): void throws { WatchFailure }
export declare function scanInputs(watch: Watch, slot: SnapshotSlot): ScanResult throws {
    WatchFailure
}
export declare function reportScanError(watch: Watch, code: u16): void throws { WatchFailure }
export declare function begin(watch: Watch, cache: bool, previous: Snapshot?): void throws {
    WatchFailure
}
export declare function compileTurn(watch: Watch): Status throws { WatchFailure }
export declare function refreshParseCache(watch: Watch): void
export declare function adoptBackend(watch: Watch): void
export declare function reportDiagnostic(
    watch: Watch,
    normalize: bool,
    has_last: bool,
    last: string
): string? throws { WatchFailure }
export declare function adoptPublishedSnapshot(watch: Watch): bool
export declare function captureSnapshot(watch: Watch, slot: SnapshotSlot): void throws { WatchFailure }
export declare function releaseSnapshot(watch: Watch, slot: SnapshotSlot): void
export declare function announceBuilt(watch: Watch): void throws { WatchFailure }
export declare function restart(watch: Watch): void throws { WatchFailure }
export declare function borrowSnapshot(watch: Watch, slot: SnapshotSlot): Snapshot?
export declare function snapshotLength(snapshot: Snapshot): u64
export declare function reobserve(watch: Watch, snapshot: Snapshot, index: u64): void throws {
    WatchFailure
}
export declare function flush(watch: Watch): void throws { WatchFailure }
export declare function releaseTurn(watch: Watch): void
