export type Watch = opaque

export enum Status {
    Initial,
    Success,
    Failed,
    Retry,
    BackendFailed
}

export type CompilationTurn = {
    status: Status,
    diagnostic: string
}

export enum SnapshotSlot {
    Success,
    Failure
}

export type ScanResult = {
    changed: bool,
    error_name?: string
}

export type ObservedEntry = {
    path: string,
    directory: bool
}

export declare function writeWatchNotice(watch: Watch, prefix: string, detail: string, flush_now: bool): void throws { WatchFailure }
export declare function interrupted(watch: Watch): bool
export declare function delay(io, milliseconds: u64): void throws { Canceled }
export declare function applicationFinished(watch: Watch): bool throws { WatchFailure }
export declare function prepareApplication(watch: Watch): string? throws { WatchFailure }
export declare function stopApplication(watch: Watch, report_exit: bool): string? throws { WatchFailure }
export declare function startApplication(watch: Watch): string? throws { WatchFailure }
export declare function scanInputs(watch: Watch, slot: SnapshotSlot): ScanResult throws {
    WatchFailure
}
export declare function begin(watch: Watch, cache: bool, previous: SnapshotSlot?): void throws {
    WatchFailure
}
export declare function compileTurn(watch: Watch): CompilationTurn throws { WatchFailure }
export declare function refreshParseCache(watch: Watch): void
export declare function adoptBackend(watch: Watch): void
export declare function writeWatchDiagnostic(
    watch: Watch,
    message: string,
    key: string
): string throws { WatchFailure }
export declare function adoptPublishedSnapshot(watch: Watch): ObservedEntry[]? throws {
    WatchFailure
}
export declare function captureSnapshot(watch: Watch, slot: SnapshotSlot): ObservedEntry[] throws { WatchFailure }
export declare function releaseSnapshot(watch: Watch, slot: SnapshotSlot): void
export declare function reobservePath(
    watch: Watch,
    path: string,
    directory: bool
): void throws { WatchFailure }
export declare function flush(watch: Watch): void throws { WatchFailure }
export declare function releaseTurn(watch: Watch): void
