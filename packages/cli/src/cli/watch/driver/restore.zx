import host from "watch_host"

import { SnapshotSlot } from "./model"

import type { Watch as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const snapshot = host.borrowSnapshot(in, SnapshotSlot.Success)

    if (snapshot != null) {
        const restored = loop(0, {
            while: index => index < host.snapshotLength(snapshot),
            next: index => {
                host.reobserve(in, snapshot, index)

                index += 1
            }
        })
    }
}
