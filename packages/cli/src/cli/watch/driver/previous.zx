import { SnapshotSlot } from "./model"

import type { PreviousInput as Input } from "./model"

export type Output = SnapshotSlot?

export default function (in: Input): Output {
    if (!in.cache) {
        return null
    }

    return match {
        in.snapshots.has_success => SnapshotSlot.Success,
        in.snapshots.has_failure => SnapshotSlot.Failure,
        _ => null
    }
}
