import type { RecordSnapshotInput as Input } from "./model"

export type Output = void

export default function (in: Input, {
    $store
}): Output {
    if (in.observed == null) {
        $store.watch_state.snapshots = {
            ...in.snapshots,
            has_failure: true
        }
    } else {
        $store.watch_state.snapshots = {
            has_success: true,
            has_failure: false,
            observed: in.observed
        }
    }
}
