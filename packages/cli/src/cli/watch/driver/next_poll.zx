import host from "watch_host"

import { backend_retry_polls } from "./const"

import type { Poll as Input } from "./model"

export type Output = Input

export default function (in: Input): Output {
    const outcome = host.scanInputs(in.watch, in.snapshot)

    const scans = in.scans + 1
    const changed = outcome.changed
    const retry = !changed && outcome.error_code == null && in.retry_backend

    const running = match {
        changed => false,
        retry => scans < backend_retry_polls,
        _ => true
    }

    return {
        watch: in.watch,
        snapshot: in.snapshot,
        retry_backend: in.retry_backend,
        running,
        scans,
        changed,
        scan_error: outcome.error_code
    }
}
