import host from "watch_host"

import { backend_retry_polls } from "./const"

import type { Poll as Input } from "./model"

export type Output = Input

export default function (in: Input): Output {
    const state = in
    const outcome = host.scanInputs(state.watch, state.snapshot)

    const scans = state.scans + 1
    const changed = outcome.changed
    const retry = !changed && outcome.error_code == null && state.retry_backend

    const running = match {
        changed => false,
        retry => scans < backend_retry_polls,
        _ => true
    }

    return host.writePoll(
        state.watch,
        state.snapshot,
        state.retry_backend,
        running,
        scans,
        changed,
        outcome.error_code
    )
}
