import { backend_retry_polls } from "./const"

import type { Poll as Output, PollResult as Input } from "./model"

export default function (in: Input): Output {
    const { poll, result } = in

    const scans = poll.scans + 1
    const changed = result.changed
    const retry = !changed && result.error_name == null && poll.retry_backend

    const running = match {
        changed => false,
        retry => scans < backend_retry_polls,
        _ => true
    }

    return {
        ...poll,
        running,
        scans,
        changed,
        scan_error: result.error_name
    }
}
