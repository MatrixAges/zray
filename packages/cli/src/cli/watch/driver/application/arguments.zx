export type Input = {
    path: string,
    tail: string[]
}

export type Output = string[]

export default function (in: Input): Output {
    const initial: string[] = [in.path]

    return loop({
        index: 0,
        out: initial
    }, {
        while: state => state.index < in.tail.length,
        next: state => {
            state.out = state.out.push(in.tail[state.index])[0]
            state.index += 1
        },
        return: state => state.out
    })
}
