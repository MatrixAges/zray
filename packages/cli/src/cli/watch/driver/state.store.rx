<Store name="watch_driver" version={2}>
    <Type from="observation" as="Observation" />

    <Object name="diagnostics">
        <Field name="has_last" type={bool} value={false} />
        <Field name="last" type={string} value={""} />
    </Object>

    <Object name="snapshots">
        <Field name="has_success" type={bool} value={false} />
        <Field name="has_failure" type={bool} value={false} />
        <Field name="observed" type={Observation.Entry[]} value={[]} />
    </Object>
</Store>
