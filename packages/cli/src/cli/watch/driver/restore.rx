<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.RestoreInput} out={void} />

    <Loop on={$in.running}>
        <Call
            module="reobserve_step"
            in={{
                watch: $in.watch,
                entries: $in.observed,
                index: 0,
                running: $in.observed.length != 0
            }}
        />
    </Loop>
</Module>
