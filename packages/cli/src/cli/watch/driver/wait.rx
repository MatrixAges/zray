<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Cycle} out={Driver.WaitOutcome} />

    <If on={$in.status == Driver.Status.Retry}>
        <Call fn="delay_interval" in={true} />

        <Call
            fn="index.delay"
            in={[
                $in.watch,
                $ctx.delay_interval
            ]}
        />

        <Return value={Driver.WaitOutcome.Idle} />
    </If>

    <Call fn="start_poll" in={$in} />

    <Loop on={$in.running}>
        <Call module="poll" />
    </Loop>

    <If on={$ctx.poll.canceled}>
        <Return value={Driver.WaitOutcome.Canceled} />
    </If>

    <If on={$ctx.poll.changed}>
        <Return value={Driver.WaitOutcome.Changed} />
    </If>

    <Return value={Driver.WaitOutcome.Idle} />
</Module>
