<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Watch} out={bool} />

    <Call fn="index.lastStatus" in={$in} />

    <If on={$ctx.lastStatus == Driver.Status.Retry}>
        <Call fn="index.delayRetry" in={$in} />

        <Return value={false} />
    </If>

    <Call fn="index.clearScanError" in={$in} />

    <Call
        module="poll"
        while="running"
        in={{
            watch: $in,
            retry_backend: $ctx.lastStatus == Driver.Status.BackendFailed,
            running: true,
            scans: 0,
            changed: false
        }}
    />

    <Return value={$ctx.poll.changed} />
</Module>
