<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Cycle} out={bool} />

    <If on={$in.status == Driver.Status.Retry}>
        <Call
            fn="index.delay"
            in={[
                $in.watch,
                Driver.Delay.Retry
            ]}
        />

        <Return value={false} />
    </If>

    <Call fn="start_poll" in={$in} />

    <Loop on={$in.running}>
        <Call module="poll" />
    </Loop>

    <Return value={$ctx.poll.changed} />
</Module>
