<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Watch} out={void} />

    <Call fn="index.announce" in={$in} />

    <Call
        fn="index.writeCycle"
        in={[
            $in,
            true,
            Driver.Status.Initial
        ]}
    />

    <Loop on={$in.running}>
        <Call module="cycle" />
    </Loop>
</Module>
