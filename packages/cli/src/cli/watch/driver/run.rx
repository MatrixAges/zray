<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Input} out={void} />

    <Call fn="index.announce" in={$in.watch} />

    <Loop on={$in.running}>
        <Call
            module="cycle"
            in={{
                ...$in,
                running: true
            }}
        />
    </Loop>
</Module>
