<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.WatchInput} out={void} />

    <Store from="state" as="watch_state" />

    <Call fn="index.announce" in={$in.watch} />

    <Loop on={$in.running}>
        <Call
            module="cycle"
            in={{
                watch: $in.watch,
                cache: $in.cache,
                run_application: $in.run_application,
                running: true,
                status: Driver.Status.Initial
            }}
        />
    </Loop>
</Module>
