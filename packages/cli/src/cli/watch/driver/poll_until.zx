import { backend_retry_polls } from "./const"
import { Scan } from "./model"
import poll from "./poll.rx"

import type { Poll as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        scans: 0,
        done: false,
        changed: false
    }, {
        while: current => !current.done,
        next: current => {
            const outcome = poll(in.watch)

            current.scans += 1

            if (outcome == Scan.Changed) {
                current.done = true
                current.changed = true
            } else if (outcome == Scan.Unchanged && in.retry_backend) {
                current.done = current.scans >= backend_retry_polls
            }
        },
        return: current => current.changed
    })
}
