import normalizeDiagnostic from "../watch_diagnostics/normalize"

import type { DiagnosticKey as Input } from "./model"

export type Output = string?

export default function (in: Input): Output {
    const { diagnostic, previous } = in

    const key = match {
        in.normalize => normalizeDiagnostic({
            message: diagnostic,
            windows: in.windows
        }) ?? diagnostic,
        _ => diagnostic
    }

    return previous.has_last && key == previous.last ? null : key
}
