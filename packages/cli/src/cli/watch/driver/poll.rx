<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Poll} out={Driver.Poll} />

    <Call
        fn="index.delay"
        in={[
            $in.watch,
            Driver.Delay.Poll
        ]}
    />

    <Call fn="index.checkCanceled" in={$in.watch} />
    <Call fn="index.pollApplication" in={$in.watch} />
    <Call fn="next_poll" in={$in} />

    <If
        on={$ctx.next_poll.scan_error != $in.scan_error &&
            $ctx.next_poll.scan_error != null}
    >
        <Call
            fn="index.reportScanError"
            in={[
                $in.watch,
                $ctx.next_poll.scan_error
            ]}
        />
    </If>

    <Return value={$ctx.next_poll} />
</Module>
