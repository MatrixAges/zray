<Module>
    <Type from="model" as="Driver" />

    <Args in={Driver.Poll} out={Driver.Poll} />

    <Call fn="delay_interval" in={false} />

    <Call
        fn="index.delay"
        in={[
            $in.watch,
            $ctx.delay_interval
        ]}
    />

    <Call fn="index.interrupted" in={$in.watch} />

    <If on={$ctx.interrupted}>
        <Return
            value={{
                ...$in,
                running: false,
                canceled: true
            }}
        />
    </If>

    <Call module="application/poll" in={$in.watch} />

    <Call
        fn="index.scanInputs"
        in={[
            $in.watch,
            $in.snapshot
        ]}
    />

    <Call
        fn="next_poll"
        in={{
            poll: $in,
            result: $ctx.scanInputs
        }}
    />

    <If
        on={$ctx.next_poll.scan_error != $in.scan_error &&
            $ctx.next_poll.scan_error != null}
    >
        <Call fn="notice_prefix" in={Driver.Notice.ScanError} />

        <Call
            fn="index.writeWatchNotice"
            in={[
                $in.watch,
                $ctx.notice_prefix,
                $ctx.next_poll.scan_error,
                true
            ]}
        />
    </If>

    <Return value={$ctx.next_poll} />
</Module>
