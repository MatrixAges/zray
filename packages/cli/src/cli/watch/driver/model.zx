import { SnapshotSlot, Status } from "watch_host"

import type { ScanResult, Watch } from "watch_host"
import type { Entry as ObservedEntry } from "./observation"

export { SnapshotSlot, Status } from "watch_host"

export type { ScanResult, Watch } from "watch_host"

export type SnapshotStore = {
    has_success: bool,
    has_failure: bool,
    observed: ObservedEntry[]
}

export type PreviousInput = {
    cache: bool,
    snapshots: SnapshotStore
}

export type RecordSnapshotInput = {
    snapshots: SnapshotStore,
    observed?: ObservedEntry[]
}

export type ReobserveStep = {
    watch: Watch,
    entries: ObservedEntry[],
    index: u64,
    running: bool
}

export type RestoreInput = {
    watch: Watch,
    observed: ObservedEntry[]
}

export type WatchInput = {
    watch: Watch,
    cache: bool,
    run_application: bool,
    windows: bool,
    input_path: string,
    output_path: string
}

export type Cycle = WatchInput & {
    running: bool,
    canceled: bool,
    status: Status
}

export type Poll = {
    watch: Watch,
    snapshot: SnapshotSlot,
    retry_backend: bool,
    running: bool,
    scans: u64,
    changed: bool,
    canceled: bool,
    scan_error?: string
}

export type DiagnosticStore = {
    has_last: bool,
    last: string
}

export type DiagnosticKey = {
    diagnostic: string,
    previous: DiagnosticStore,
    normalize: bool,
    windows: bool
}

export type BuildResult = {
    watch: Watch,
    status: Status
}

export enum Notice {
    Watching,
    Built,
    ScanError
}

export enum WaitOutcome {
    Idle,
    Changed,
    Canceled
}

export type PollResult = {
    poll: Poll,
    result: ScanResult
}
