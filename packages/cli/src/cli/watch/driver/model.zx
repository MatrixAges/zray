import { SnapshotSlot, Status } from "watch_host"

import type { ObservedEntry, ScanResult, Watch } from "watch_host"

export { Delay, SnapshotSlot, Status } from "watch_host"

export type { ObservedEntry, ScanResult, Watch } from "watch_host"

export type SnapshotStore = {
    has_success: bool,
    has_failure: bool
}

export type PreviousInput = {
    cache: bool,
    snapshots: SnapshotStore
}

export type RecordSnapshotInput = {
    snapshots: SnapshotStore,
    success: bool
}

export type ReobserveStep = {
    watch: Watch,
    entries: ObservedEntry[],
    index: u64,
    running: bool
}

export type RestoreInput = {
    watch: Watch,
    has_success: bool
}

export type WatchInput = {
    watch: Watch,
    cache: bool,
    run_application: bool
}

export type Cycle = WatchInput & {
    running: bool,
    status: Status
}

export type Poll = {
    watch: Watch,
    snapshot: SnapshotSlot,
    retry_backend: bool,
    running: bool,
    scans: u64,
    changed: bool,
    scan_error?: u16
}

export type DiagnosticStore = {
    has_last: bool,
    last: string
}

export type ReportDiagnosticInput = {
    watch: Watch,
    normalize: bool,
    diagnostics: DiagnosticStore
}

export type Wait = [Watch, Status]
