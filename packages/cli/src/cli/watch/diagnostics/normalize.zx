import bytes from "std:bytes"
import encoding from "std:encoding"
import strings from "std:string"
import { ascii_backslash, ascii_slash } from "core/ascii/const"

import { unix_backend_temporary, windows_backend_temporary } from "./const"
import hexName from "./hex_name"

export type Input = {
    message: string,
    windows: bool
}

export type Output = string?

export default function (in: Input): Output {
    const { message, windows } = in

    const text = bytes.fromText(message)
    const prefix = windows ? windows_backend_temporary : unix_backend_temporary
    const separator = windows ? ascii_backslash : ascii_slash
    const prefix_length = bytes.fromText(prefix).length
    const parts: string[] = []

    const normalized = loop({
        search: 0,
        written: 0,
        done: false,
        parts
    }, {
        while: state => !state.done && state.search < text.length,
        next: state => {
            const found = bytes.indexOfText(text, state.search, prefix)

            if (found == null) {
                state.done = true
            } else {
                const start = found + prefix_length
                const end = bytes.indexOfScalar(text, start, separator)

                if (end == null) {
                    state.done = true
                } else {
                    if (hexName({
                        bytes: text,
                        start,
                        end
                    })) {
                        const before =
                            encoding.sliceBytes(message, state.written, start)

                        state.parts = state.parts.push(before)[0].push("*")[0]
                        state.written = end
                    }

                    state.search = end
                }
            }
        },
        return: state => ({
            written: state.written,
            parts: state.parts
        })
    })

    if (normalized.written == 0) {
        return null
    }

    const tail = encoding.sliceBytes(message, normalized.written, text.length)

    return strings.join("", normalized.parts.push(tail)[0])
}
