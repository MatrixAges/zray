import { host_node, mode_lib } from "./const"
import { Command } from "./model"

import type { State } from "./model"

export type Input = {
    args: string[],
    state: State
}

export type Output = bool

export default function (in: Input): Output {
    const { args, state } = in

    const target = state.target != 0
    const result = state.result != 0
    const assembly = state.assembly != 0
    const optimization = state.optimize != 0 || state.cpu != 0
    const backend = assembly || target || optimization
    const host = state.host != 0 || state.node_library != 0
    const execution = state.watch || state.run || result

    if (state.command != Command.Build) {
        const only_build = (
            - backend
            - or host
            - or execution
            - or state.mode != 0
        )

        return !only_build
    }

    const library = state.mode != 0 && args[state.mode] == mode_lib
    const node = state.host != 0 && args[state.host] == host_node

    const app_options = backend || result
    const process_options = library || result

    if (library && app_options) {
        return false
    }

    if (node && process_options) {
        return false
    }

    if (state.node_library != 0 && !node) {
        return false
    }

    const cannot_run = (
        - !state.watch
        - or library
        - or node
        - or target
    )

    return !state.run || !cannot_run
}
