import { Command } from "./model"

import type { State as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const format = in.command == Command.Format
    const lint = in.command == Command.Lint
    const format_only = in.check || in.write
    const style_command = format || lint

    if (format_only && !format) {
        return false
    }

    if (in.check && in.write) {
        return false
    }

    if (in.kind != 0 && !style_command) {
        return false
    }

    const lint_only = in.workspace || in.semantic || in.max_lines != null

    if (!lint) {
        return !lint_only
    }

    const has_project = in.project != 0
    const has_kind = in.kind != 0

    const per_file = has_project || has_kind

    if (in.workspace && per_file) {
        return false
    }

    const project_ok = !has_project || in.semantic
    const kind_ok = !in.semantic || !has_kind

    return project_ok && kind_ok
}
