import buildOptions from "./build_options"
import lintOptions from "./lint_options"
import { Command } from "./model"

import type { Input } from "./build_options"

export type Output = bool

export default function (in: Input): Output {
    const { state } = in

    if (!state.valid || !lintOptions(state)) {
        return false
    }

    const format = state.command == Command.Format
    const lint = state.command == Command.Lint
    const hardware = state.command == Command.Hardware
    const needs_output = hardware || state.command == Command.Build

    if (needs_output && state.output == 0) {
        return false
    }

    if (state.clocked && !hardware) {
        return false
    }

    if (format && state.project != 0) {
        return false
    }

    const cache = state.no_cache || state.cache_stats
    const compiler_option = cache || state.solver != 0 || state.output != 0

    const style_command = format || lint

    if (style_command && compiler_option) {
        return false
    }

    return buildOptions(in)
}
