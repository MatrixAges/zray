<Module>
    <Type from="bounds" as="Bounds" />

    <Args in={Bounds.Input} out={Bounds.Result} />

    <Call fn="bounds" in={$in} />

    <Call
        fn="components"
        in={{
            ...$in,
            ...$ctx.bounds
        }}
    />

    <Return
        value={{
            ...$ctx.bounds,
            valid: $ctx.components
        }}
    />
</Module>
