export type Archive = mutable_opaque

export enum EntryKind {
    Directory,
    File,
    Other
}

export type Entry = {
    name: string,
    kind: EntryKind,
    executable: bool
}

export declare function nextTar(archive: Archive): Entry? throws { ArchiveHostFailure }
export declare function makeTarDirectory(archive: Archive, path: string): void throws {
    ArchiveHostFailure
}
export declare function writeTarFile(
    archive: Archive,
    path: string,
    executable: bool
): void throws { ArchiveHostFailure }
