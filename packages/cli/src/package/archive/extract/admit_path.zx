import bytes from "std:bytes"

import type { AdmitInput as Input } from "./model"

export type Output = bool

export default function (in: Input, {
    $store
}): Output {
    const wanted = bytes.fromText(in.path)

    const existing = loop(0, {
        while: i =>
            i < in.claimed.paths.length &&
            !bytes.equals(bytes.fromText(in.claimed.paths[i]), wanted),
        next: i => {
            i += 1
        },
        return: i => i < in.claimed.paths.length
    })

    if (existing) {
        return false
    }

    $store.seen.claimed = {
        paths: in.claimed.paths.push(in.path)[0]
    }

    return true
}
