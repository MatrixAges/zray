<Module>
    <Type from="model" as="Extract" />

    <Args in={Extract.Input} out={Extract.Output} />

    <Store from="seen" as="seen" />

    <Loop on={$in.running}>
        <Call
            module="step"
            in={{
                ...$in,
                offset: 0,
                files: [],
                status: Extract.Status.Valid,
                running: true
            }}
        />
    </Loop>

    <Return
        value={$ctx.step.pick([
            "status",
            "files"
        ])}
    />
</Module>
