import host from "package_extract_host"
import { EntryKind } from "package_extract_host"

import normalize from "../package/archive/path/normalize"
import { Status } from "./model"

import type { EntryInput as Input, Output } from "./model"

export default function (in: Input): Output {
    const directory = in.entry.kind == EntryKind.Directory

    const path = normalize({
        name: in.entry.name,
        directory
    })

    if (path == null) {
        return Status.InvalidPackageArchivePath
    }

    if (path == "") {
        return Status.Valid
    }

    const claimed = host.claimTarPath(in.archive, path)

    if (claimed == null) {
        return Status.DuplicatePackageArchivePath
    }

    if (directory) {
        host.makeTarDirectory(in.archive, claimed)

        return Status.Valid
    }

    if (in.entry.kind != EntryKind.File) {
        return Status.UnsupportedPackageTarEntry
    }

    host.writeTarFile(in.archive, claimed, in.entry.executable)

    return Status.Valid
}
