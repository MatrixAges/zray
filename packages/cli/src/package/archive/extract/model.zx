import type { Directory } from "package_extract_host"

export type Input = {
    directory: Directory,
    source: u8[]
}

export type Claimed = {
    paths: string[]
}

export type AdmitInput = {
    claimed: Claimed,
    path: string
}

export enum Action {
    Skip,
    Directory,
    File,
    Unsupported
}

export enum Status {
    Valid,
    InvalidPackageArchivePath,
    DuplicatePackageArchivePath,
    UnsupportedPackageTarEntry
}

export type Classified = {
    status: Status,
    action: Action,
    next: u64,
    path: string,
    executable: bool
}

export type File = {
    path: string,
    sha256: string,
    executable: bool
}

export type Output = {
    status: Status,
    files: File[]
}

export type Step = Input & Output & {
    offset: u64,
    running: bool
}
