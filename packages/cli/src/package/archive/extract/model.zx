import type { Archive } from "package_extract_host"

export type Input = Archive

export type Claimed = {
    paths: string[]
}

export type AdmitInput = {
    claimed: Claimed,
    path: string
}

export enum Action {
    Skip,
    Directory,
    File,
    Unsupported
}

export enum Status {
    Valid,
    InvalidPackageArchivePath,
    DuplicatePackageArchivePath,
    UnsupportedPackageTarEntry
}

export type Classified = {
    status: Status,
    action: Action,
    path: string,
    executable: bool
}

export type Step = {
    archive: Archive,
    status: Status,
    running: bool
}

export type Output = Status
