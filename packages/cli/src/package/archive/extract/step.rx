<Module>
    <Type from="model" as="Extract" />

    <Args in={Extract.Step} out={Extract.Step} />

    <Store from="seen" as="seen" />

    <Call
        fn="index.nextTar"
        in={[
            $in.source,
            $in.offset
        ]}
    />

    <If on={$ctx.nextTar != null}>
        <Call fn="classify_entry" in={$ctx.nextTar} />

        <If on={$ctx.classify_entry.status != Extract.Status.Valid}>
            <Return
                value={{
                    ...$in,
                    status: $ctx.classify_entry.status,
                    running: false
                }}
            />
        </If>

        <If on={$ctx.classify_entry.action != Extract.Action.Skip}>
            <Call
                fn="admit_path"
                in={{
                    claimed: $store.seen.claimed,
                    path: $ctx.classify_entry.path
                }}
                setter={[$store.seen.claimed]}
            />

            <If on={!$ctx.admit_path}>
                <Return
                    value={{
                        ...$in,
                        status: Extract.Status.DuplicatePackageArchivePath,
                        running: false
                    }}
                />
            </If>

            <Switch on={$ctx.classify_entry.action}>
                <Case value={Extract.Action.Directory}>
                    <Call
                        fn="index.makeTarDirectory"
                        in={[
                            $in.directory,
                            $ctx.classify_entry.path
                        ]}
                    />
                </Case>

                <Case value={Extract.Action.Unsupported}>
                    <Return
                        value={{
                            ...$in,
                            status: Extract.Status.UnsupportedPackageTarEntry,
                            running: false
                        }}
                    />
                </Case>

                <Case value={Extract.Action.File}>
                    <Call fn="parent" in={$ctx.classify_entry.path} />

                    <If on={$ctx.parent != null}>
                        <Call
                            fn="index.makeTarDirectory"
                            in={[
                                $in.directory,
                                $ctx.parent
                            ]}
                        />
                    </If>

                    <Call
                        fn="index.writeTarFile"
                        in={[
                            $in.directory,
                            $ctx.classify_entry.path,
                            $ctx.nextTar.content,
                            $ctx.classify_entry.executable
                        ]}
                    />

                    <Call
                        fn="record_file"
                        in={{
                            files: $in.files,
                            path: $ctx.classify_entry.path,
                            content: $ctx.nextTar.content,
                            executable: $ctx.classify_entry.executable
                        }}
                    />

                    <Return
                        value={{
                            ...$in,
                            offset: $ctx.classify_entry.next,
                            files: $ctx.record_file
                        }}
                    />
                </Case>
            </Switch>
        </If>

        <Return
            value={{
                ...$in,
                offset: $ctx.classify_entry.next
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            running: false
        }}
    />
</Module>
