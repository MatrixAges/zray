import { entry_and_exports, library_exports, mixed_exports } from "../const"

import type { Surface as Input } from "./model"

export type Output = string?

export default function (in: Input): Output {
    const has_exports = in.exports != 0

    if (in.entry && has_exports) {
        return entry_and_exports
    }

    const invalid_library = in.entry || !has_exports

    if (in.library && invalid_library) {
        return library_exports
    }

    const valid = match in.library {
        true => in.compiled_exports == in.exports,
        _ => in.compiled_exports == 0
    }

    return valid ? null : mixed_exports
}
