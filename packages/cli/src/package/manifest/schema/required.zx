import {
    missing_interface,
    missing_module_name,
    missing_module_target,
    missing_alias,
    missing_external
} from "./const"
import { Mapping } from "./model"

export type Input = {
    mapping: Mapping,
    name: bool,
    specifier: bool,
    path: bool,
    module: bool,
    header: bool,
    signature: bool,
    member: bool
}

export type Output = string?

export default function (in: Input): Output {
    const { mapping, name, specifier, path, module, header, signature, member } = in

    return match mapping {
        Mapping.NativeInterface => match {
            specifier && path && module => null,
            _ => missing_interface
        },
        Mapping.NativeModule => match {
            !name => missing_module_name,
            path == header => missing_module_target,
            _ => null
        },
        Mapping.AbiAlias => match {
            name && specifier => null,
            _ => missing_alias
        },
        Mapping.External => match {
            !specifier || !signature => missing_external,
            !module || !member => missing_external,
            _ => null
        },
        _ => null
    }
}
