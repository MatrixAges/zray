<Module>
    <Type from="scan" as="Scan" />
    <Type from="project" as="Positions" />

    <Args
        in={{
            tokens: Scan.Input,
            source: u8[]
        }}
        out={Positions.Output}
    />

    <Call fn="scan" in={$in.tokens} />

    <Call
        fn="project"
        in={{
            source: $in.source,
            fields: $ctx.scan
        }}
    />

    <Return value={$ctx.project} />
</Module>
