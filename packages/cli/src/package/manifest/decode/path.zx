import extension from "../../workspace/paths/extension"
import { Kind } from "../../workspace/paths/model"
import relative from "../../workspace/paths/relative"
import { bad_entry, bad_library } from "./const"
import issue from "./issue"
import text from "./text"

import type { Output } from "./text"
import type { Input as Value } from "./value"

export type Input = Value & {
    entry: bool
}

export default function (in: Input): Output {
    const { node, entry } = in

    const parsed = text(in.pick([
        "document",
        "node"
    ]))

    const [value, problem] = parsed

    if (problem != null) {
        return parsed
    }

    const valid = (!entry || extension(value)) && relative({
        text: value,
        kind: Kind.Relative
    })

    if (!valid) {
        return [
            value,
            issue([
                node,
                entry ? bad_entry : bad_library
            ])
        ]
    }

    return parsed
}
