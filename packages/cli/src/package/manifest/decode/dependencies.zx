import { allocateRows } from "core/row_buffer"
import yaml from "manifest_yaml_document"
import columns from "memory/columns"

import { mapping_size } from "./const"
import mapping from "./mapping"
import name from "./name"
import string from "./string"

import type { DependencyOutput } from "./model"
import type { Input as Value } from "./value"

export type Input = Value & {
    target: DependencyOutput
}

export type Output = void

export default function (in: Input): Output {
    const { document, target } = in

    const pairs = mapping({
        document: in.document,
        node: in.node
    })

    const count = pairs.length / mapping_size

    allocateRows({
        target: target.buffer,
        count
    })

    const written = loop(0, {
        while: row => row < count,
        next: row => {
            const offset = row * mapping_size
            const dependency = name({
                document,
                node: yaml.node(document, pairs[offset], null)
            })
            const requirement = string({
                document,
                node: yaml.node(document, pairs[offset + 1], null)
            })

            columns.writeColumnText(target.columns.name, row, dependency)
            columns.writeColumnText(target.columns.requirement, row, requirement)
            row += 1
        }
    })
}
