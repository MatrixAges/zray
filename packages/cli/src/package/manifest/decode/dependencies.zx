import { mapping_size } from "./const"
import mapping from "./mapping"
import name from "./name"
import nodeAt from "./node_at"
import text from "./text"

import type { Dependency } from "./model"
import type { Diagnostic, Input } from "./value"

export type Output = [Dependency[], Diagnostic?]

export default function (in: Input): Output {
    const { document } = in
    const { pairs, problem } = mapping(in)

    const empty: Dependency[] = []

    return loop({
        offset: 0,
        out: empty,
        problem
    }, {
        while: state => state.problem == null && state.offset < pairs.length,
        next: state => {
            const [dependency, name_issue] = name({
                document,
                node: nodeAt({
                    document,
                    id: pairs[state.offset]
                })
            })

            if (name_issue != null) {
                state.problem = name_issue
            } else {
                const [requirement, text_issue] = text({
                    document,
                    node: nodeAt({
                        document,
                        id: pairs[state.offset + 1]
                    })
                })

                if (text_issue != null) {
                    state.problem = text_issue
                } else {
                    state.out = state.out.push({
                        name: dependency,
                        requirement
                    })[0]
                }
            }

            state.offset += mapping_size
        },
        return: state => [
            state.out,
            state.problem
        ]
    })
}
