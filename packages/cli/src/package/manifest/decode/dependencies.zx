import { mapping_size } from "./const"
import mapping from "./mapping"
import name from "./name"
import nodeAt from "./node_at"
import string from "./string"

import type { Dependency } from "./model"
import type { Input as Value } from "./value"

export type Input = Value

export type Output = Dependency[]

export default function (in: Input): Output {
    const { document } = in

    const pairs = mapping(in)
    const count = pairs.length / mapping_size
    const empty: Dependency[] = []

    return loop({
        row: 0,
        items: empty
    }, {
        while: state => state.row < count,
        next: state => {
            const offset = state.row * mapping_size
            const dependency = name({
                document,
                node: nodeAt({
                    document,
                    id: pairs[offset]
                })
            })
            const requirement = string({
                document,
                node: nodeAt({
                    document,
                    id: pairs[offset + 1]
                })
            })

            state.items = state.items.push({
                name: dependency,
                requirement
            })[0]
            state.row += 1
        },
        return: state => state.items
    })
}
