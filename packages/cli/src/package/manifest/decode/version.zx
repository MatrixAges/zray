import yaml from "manifest_yaml_document"

import { bad_version } from "./const"
import issue from "./issue"
import text from "./text"

import type { Output } from "./text"
import type { Input } from "./value"

export default function (in: Input): Output {
    const parsed = text(in)

    const [value, problem] = parsed

    if (problem == null && !yaml.semanticVersion(value)) {
        return [
            value,
            issue([
                in.node,
                bad_version
            ])
        ]
    }

    return parsed
}
