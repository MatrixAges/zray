import { bad_version } from "./const"
import issue from "./issue"
import text from "./text"
import validVersion from "./version/valid"

import type { Output } from "./text"
import type { Input as Value } from "./value"

export type Input = Value & {
    limit: u64
}

export default function (in: Input): Output {
    const parsed = text(in.omit(["limit"]))

    const [value, problem] = parsed

    if (problem == null && !validVersion({
        text: value,
        limit: in.limit
    })) {
        return [
            value,
            issue([
                in.node,
                bad_version
            ])
        ]
    }

    return parsed
}
