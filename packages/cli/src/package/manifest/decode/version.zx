import yaml from "manifest_yaml_document"

import { bad_version } from "./const"
import string from "./string"

import type { Input } from "./value"

export type Output = string

export default function (in: Input): Output {
    const version = string({
        document: in.document,
        node: in.node
    })

    if (!yaml.semanticVersion(version)) {
        yaml.reject(in.document.parser, in.node, bad_version)
    }

    return version
}
