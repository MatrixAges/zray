import yaml from "manifest_yaml_document"

import check from "../schema/scalar"
import { empty_text } from "./const"

import type { Input } from "./value"

export type Output = string

export default function (in: Input): Output {
    const text = in.node.scalar

    const diagnostic = check({
        text
    })

    if (diagnostic != null) {
        yaml.reject(in.document.parser, in.node, diagnostic)
    }

    return text ?? empty_text
}
