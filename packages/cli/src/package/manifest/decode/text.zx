import check from "../schema/scalar"
import { empty_text } from "./const"
import issue from "./issue"

import type { Diagnostic, Input } from "./value"

export type Output = [string, Diagnostic?]

export default function (in: Input): Output {
    const text = in.node.scalar

    const problem = check({
        text
    })

    if (problem != null) {
        return [
            empty_text,
            issue([
                in.node,
                problem
            ])
        ]
    }

    return [
        text ?? empty_text,
        null
    ]
}
