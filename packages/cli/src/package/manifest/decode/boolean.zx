import yaml from "manifest_yaml_document"

import check from "../schema/boolean"
import { empty_text } from "./const"

import type { Input } from "./value"

export type Output = bool

export default function (in: Input): Output {
    const plain = in.node.plain

    const result = check({
        plain,
        allowed_tag: plain && in.node.boolean_tag,
        text: plain ? in.node.text : empty_text
    })

    if (result.diagnostic != null) {
        yaml.reject(in.document.parser, in.node, result.diagnostic)
    }

    return result.value
}
