import check from "../schema/boolean"
import { empty_text } from "./const"
import issue from "./issue"

import type { Diagnostic, Input } from "./value"

export type Output = [bool, Diagnostic?]

export default function (in: Input): Output {
    const plain = in.node.plain

    const result = check({
        plain,
        allowed_tag: plain && in.node.boolean_tag,
        text: plain ? in.node.text : empty_text
    })

    const problem = result.diagnostic

    if (problem != null) {
        return [
            result.value,
            issue([
                in.node,
                problem
            ])
        ]
    }

    return [
        result.value,
        null
    ]
}
