import yaml from "manifest_yaml_document"

import { bad_sequence } from "./const"

import type { Input } from "./value"

export type Output = i32[]

export default function (in: Input): Output {
    const items = yaml.items(in.node)

    if (items == null) {
        yaml.reject(in.document, in.node, bad_sequence)

        return []
    }

    return items
}
