import { bad_sequence } from "./const"
import issue from "./issue"

import type { Diagnostic, Input } from "./value"

export type Output = [u32[], Diagnostic?]

export default function (in: Input): Output {
    const items = in.node.items

    if (items == null) {
        return [
            [],
            issue([
                in.node,
                bad_sequence
            ])
        ]
    }

    return [
        items,
        null
    ]
}
