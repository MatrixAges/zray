import yaml from "manifest_yaml_document"

import { bad_sequence } from "./const"

import type { Input } from "./value"

export type Output = u32[]

export default function (in: Input): Output {
    const items = in.node.items

    if (items == null) {
        yaml.reject(in.document.parser, in.node, bad_sequence)

        return []
    }

    return items
}
