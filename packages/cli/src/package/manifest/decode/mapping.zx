import bytes from "std:bytes"

import { bad_mapping, duplicate_key, mapping_size } from "./const"
import issue from "./issue"
import locate from "./mapping/locate"
import nodeAt from "./node_at"
import text from "./text"

import type { Diagnostic, Input } from "./value"

export type Output = {
    pairs: u32[],
    problem?: Diagnostic
}

export default function (in: Input): Output {
    const { document, node } = in

    const pairs = node.pairs

    if (pairs == null) {
        return {
            pairs: [],
            problem: issue([
                node,
                bad_mapping
            ])
        }
    }

    if (pairs.length == 0) {
        return {
            pairs
        }
    }

    if (pairs.length == mapping_size) {
        const validated = text({
            document,
            node: nodeAt({
                document,
                id: pairs[0]
            })
        })

        return {
            pairs,
            problem: validated[1]
        }
    }

    const zero: u64 = 0
    const no_issue: Diagnostic? = null
    const slots = bytes.repeat(pairs.length, 0).map(byte => zero)[0]

    const checked = loop({
        index: 0,
        problem: no_issue,
        slots
    }, {
        while: state => state.problem == null && state.index < pairs.length,
        next: state => {
            const key = nodeAt({
                document,
                id: pairs[state.index]
            })
            const [value, problem] = text({
                document,
                node: key
            })

            if (problem != null) {
                state.problem = problem
            } else {
                const slot = locate({
                    document,
                    pairs,
                    slots: state.slots,
                    key: value
                })

                if (state.slots[slot] == 0) {
                    state.slots[slot] = state.index + 1
                } else {
                    state.problem = issue([
                        key,
                        duplicate_key
                    ])
                }
            }

            state.index += mapping_size
        },
        return: state => state.problem
    })

    return {
        pairs,
        problem: checked
    }
}
