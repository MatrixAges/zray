import { empty_exports, mapping_size } from "./const"
import readRow from "./exports/row"
import issue from "./issue"
import mapping from "./mapping"
import nodeAt from "./node_at"

import type { Export } from "./model"
import type { Diagnostic, Input } from "./value"

export type Output = {
    rows: Export[],
    compiled_exports: u64,
    problem?: Diagnostic
}

export default function (in: Input): Output {
    const { document, node } = in
    const { pairs, problem } = mapping(in)

    if (pairs.length == 0 && problem == null) {
        return {
            rows: [],
            compiled_exports: 0,
            problem: issue([
                node,
                empty_exports
            ])
        }
    }

    const empty: Export[] = []

    return loop({
        offset: 0,
        rows: empty,
        compiled_exports: 0,
        problem
    }, {
        while: state => state.problem == null && state.offset < pairs.length,
        next: state => {
            const [item, row_issue] = readRow({
                document,
                key: nodeAt({
                    document,
                    id: pairs[state.offset]
                }),
                node: nodeAt({
                    document,
                    id: pairs[state.offset + 1]
                })
            })

            state.problem = row_issue

            if (item != null && row_issue == null) {
                state.rows = state.rows.push(item)[0]
                state.compiled_exports += item.module == null ? 0 : 1
            }

            state.offset += mapping_size
        },
        return: state => state.omit(["offset"])
    })
}
