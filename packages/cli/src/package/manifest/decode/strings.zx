import yaml from "manifest_yaml_document"

import { Kind } from "../../workspace/paths/model"
import relative from "../../workspace/paths/relative"
import { bad_sequence, workspace_path, workspace_sequence } from "./const"
import nodeAt from "./node_at"
import string from "./string"

import type { Input as Value } from "./value"

export type Input = Value & {
    workspace: bool
}

export type Output = string[]

export default function (in: Input): Output {
    const { document, node, workspace } = in

    const items = node.items

    if (items == null) {
        yaml.reject(
            document.parser,
            node,
            workspace ? workspace_sequence : bad_sequence
        )

        return []
    }

    const empty: string[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < items.length,
        next: state => {
            const item = nodeAt({
                document,
                id: items[state.row]
            })
            const value = string({
                document,
                node: item
            })

            if (workspace) {
                const valid = relative({
                    text: value,
                    kind: Kind.Workspace
                })

                if (!valid) {
                    yaml.reject(document.parser, item, workspace_path)
                }
            }

            state.out = state.out.push(value)[0]
            state.row += 1
        },
        return: state => state.out
    })
}
