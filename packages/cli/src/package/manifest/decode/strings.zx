import { Kind } from "../../workspace/paths/model"
import relative from "../../workspace/paths/relative"
import { bad_sequence, workspace_path, workspace_sequence } from "./const"
import issue from "./issue"
import nodeAt from "./node_at"
import text from "./text"

import type { Diagnostic, Input as Value } from "./value"

export type Input = Value & {
    workspace: bool
}

export type Output = [string[], Diagnostic?]

export default function (in: Input): Output {
    const { document, node, workspace } = in

    const items = node.items

    if (items == null) {
        return [
            [],
            issue([
                node,
                workspace ? workspace_sequence : bad_sequence
            ])
        ]
    }

    const empty: string[] = []
    const no_issue: Diagnostic? = null

    return loop({
        row: 0,
        out: empty,
        problem: no_issue
    }, {
        while: state => state.problem == null && state.row < items.length,
        next: state => {
            const item = nodeAt({
                document,
                id: items[state.row]
            })
            const [value, problem] = text({
                document,
                node: item
            })

            if (problem != null) {
                state.problem = problem
            } else if (workspace && !relative({
                text: value,
                kind: Kind.Workspace
            })) {
                state.problem = issue([
                    item,
                    workspace_path
                ])
            } else {
                state.out = state.out.push(value)[0]
            }

            state.row += 1
        },
        return: state => [
            state.out,
            state.problem
        ]
    })
}
