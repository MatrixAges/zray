import field from "../schema/field"
import { Field, Mapping } from "../schema/model"
import boolean from "./boolean"
import { empty_text, mapping_size, unknown_manifest_field } from "./const"
import dependencies from "./dependencies"
import exports from "./exports"
import issue from "./issue"
import name from "./name"
import externals from "./native/externals"
import interfaces from "./native/interfaces"
import modules from "./native/modules"
import nodeAt from "./node_at"
import path from "./path"
import strings from "./strings"
import version from "./version"
import workspace from "./workspace"

import type { Values } from "./model"
import type { Diagnostic, Document } from "./value"

export type Input = {
    document: Document,
    pairs: u32[],
    version_limit: u64
}

export type State = {
    index: u64,
    problem?: Diagnostic,
    values: Values
}

export type Output = State.Omit("index")

export default function (in: Input): Output {
    const { document, pairs } = in

    const initial: State = {
        index: 0,
        values: {
            name: empty_text,
            version: empty_text,
            entry: null,
            library: null,
            exports: [],
            private: false,
            dependencies: [],
            dev_dependencies: [],
            workspace: null,
            native_interfaces: [],
            externals: [],
            native_modules: [],
            libraries: [],
            include_paths: [],
            library_paths: [],
            compiled_exports: 0
        }
    }

    return loop(initial, {
        while: state => state.problem == null && state.index < pairs.length,
        next: state => {
            const key = nodeAt({
                document,
                id: pairs[state.index]
            })
            const item = nodeAt({
                document,
                id: pairs[state.index + 1]
            })
            const value = {
                document,
                node: item
            }
            const selected = field({
                mapping: Mapping.Manifest,
                key: key.text
            })

            switch (selected) {
                case Field.Name:
                    const [parsed, problem] = name(value)

                    state.values.name = parsed
                    state.problem = problem
                case Field.Version:
                    const [parsed, problem] = version({
                        ...value,
                        limit: in.version_limit
                    })

                    state.values.version = parsed
                    state.problem = problem
                case Field.Entry:
                    const [parsed, problem] = path({
                        ...value,
                        entry: true
                    })

                    state.values.entry = parsed
                    state.problem = problem
                case Field.Library:
                    const [parsed, problem] = path({
                        ...value,
                        entry: false
                    })

                    state.values.library = parsed
                    state.problem = problem
                case Field.Exports:
                    const surface = exports(value)

                    state.values.exports = surface.rows
                    state.values.compiled_exports = surface.compiled_exports
                    state.problem = surface.problem
                case Field.Private:
                    const [parsed, problem] = boolean(value)

                    state.values.private = parsed
                    state.problem = problem
                case Field.Dependencies:
                    const [parsed, problem] = dependencies(value)

                    state.values.dependencies = parsed
                    state.problem = problem
                case Field.DevDependencies:
                    const [parsed, problem] = dependencies(value)

                    state.values.dev_dependencies = parsed
                    state.problem = problem
                case Field.Workspace:
                    const [parsed, problem] = workspace(value)

                    state.values.workspace = parsed
                    state.problem = problem
                case Field.NativeInterfaces:
                    const [parsed, problem] = interfaces(value)

                    state.values.native_interfaces = parsed
                    state.problem = problem
                case Field.NativeModules:
                    const [parsed, problem] = modules(value)

                    state.values.native_modules = parsed
                    state.problem = problem
                case Field.Externals:
                    const [parsed, problem] = externals(value)

                    state.values.externals = parsed
                    state.problem = problem
                case Field.Libraries:
                    const [parsed, problem] = strings({
                        ...value,
                        workspace: false
                    })

                    state.values.libraries = parsed
                    state.problem = problem
                case Field.IncludePaths:
                    const [parsed, problem] = strings({
                        ...value,
                        workspace: false
                    })

                    state.values.include_paths = parsed
                    state.problem = problem
                case Field.LibraryPaths:
                    const [parsed, problem] = strings({
                        ...value,
                        workspace: false
                    })

                    state.values.library_paths = parsed
                    state.problem = problem
                default:
                    state.problem = issue([
                        key,
                        unknown_manifest_field
                    ])
            }

            state.index += mapping_size
        },
        return: state => state.omit(["index"])
    })
}
