import yaml from "manifest_yaml_document"

import field from "../schema/field"
import { Field, Mapping } from "../schema/model"
import boolean from "./boolean"
import { empty_text, mapping_size, unknown_manifest_field } from "./const"
import dependencies from "./dependencies"
import exports from "./exports"
import name from "./name"
import externals from "./native/externals"
import interfaces from "./native/interfaces"
import modules from "./native/modules"
import nodeAt from "./node_at"
import path from "./path"
import strings from "./strings"
import version from "./version"
import workspace from "./workspace"

import type { Values } from "./model"
import type { Document } from "./value"

export type Input = {
    document: Document,
    pairs: u32[]
}

export type State = {
    index: u64,
    values: Values
}

export type Output = Values

export default function (in: Input): Output {
    const { document, pairs } = in

    const initial: State = {
        index: 0,
        values: {
            name: empty_text,
            version: empty_text,
            entry: null,
            library: null,
            exports: [],
            private: false,
            dependencies: [],
            dev_dependencies: [],
            workspace: null,
            native_interfaces: [],
            externals: [],
            native_modules: [],
            libraries: [],
            include_paths: [],
            library_paths: [],
            compiled_exports: 0
        }
    }

    return loop(initial, {
        while: state => state.index < pairs.length,
        next: state => {
            const key = nodeAt({
                document,
                id: pairs[state.index]
            })
            const item = nodeAt({
                document,
                id: pairs[state.index + 1]
            })
            const value = {
                document,
                node: item
            }
            const selected = field({
                mapping: Mapping.Manifest,
                key: key.text
            })

            switch (selected) {
                case Field.Name:
                    state.values.name = name(value)
                case Field.Version:
                    state.values.version = version(value)
                case Field.Entry:
                    state.values.entry = path({
                        ...value,
                        entry: true
                    })
                case Field.Library:
                    state.values.library = path({
                        ...value,
                        entry: false
                    })
                case Field.Exports:
                    const surface = exports(value)

                    state.values.exports = surface.rows
                    state.values.compiled_exports = surface.compiled_exports
                case Field.Private:
                    state.values.private = boolean(value)
                case Field.Dependencies:
                    state.values.dependencies = dependencies(value)
                case Field.DevDependencies:
                    state.values.dev_dependencies = dependencies(value)
                case Field.Workspace:
                    state.values.workspace = workspace(value)
                case Field.NativeInterfaces:
                    state.values.native_interfaces = interfaces(value)
                case Field.NativeModules:
                    state.values.native_modules = modules(value)
                case Field.Externals:
                    state.values.externals = externals(value)
                case Field.Libraries:
                    state.values.libraries = strings({
                        ...value,
                        workspace: false
                    })
                case Field.IncludePaths:
                    state.values.include_paths = strings({
                        ...value,
                        workspace: false
                    })
                case Field.LibraryPaths:
                    state.values.library_paths = strings({
                        ...value,
                        workspace: false
                    })
                default:
                    yaml.reject(document.parser, key, unknown_manifest_field)
            }

            state.index += mapping_size
        },
        return: state => state.values
    })
}
