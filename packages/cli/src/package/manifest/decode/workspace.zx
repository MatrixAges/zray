import field from "../schema/field"
import { Field, Mapping } from "../schema/model"
import {
    mapping_size,
    missing_workspace_packages,
    unknown_workspace_field
} from "./const"
import issue from "./issue"
import mapping from "./mapping"
import nodeAt from "./node_at"
import strings from "./strings"

import type { Output } from "./strings"
import type { Input } from "./value"

export default function (in: Input): Output {
    const { document, node } = in
    const { pairs, problem } = mapping(in)

    if (problem != null) {
        return [
            [],
            problem
        ]
    }

    if (pairs.length == 0) {
        return [
            [],
            issue([
                node,
                missing_workspace_packages
            ])
        ]
    }

    const key = nodeAt({
        document,
        id: pairs[0]
    })

    if (field({
        mapping: Mapping.Workspace,
        key: key.text
    }) != Field.Packages) {
        return [
            [],
            issue([
                key,
                unknown_workspace_field
            ])
        ]
    }

    const parsed = strings({
        document,
        node: nodeAt({
            document,
            id: pairs[1]
        }),
        workspace: true
    })

    if (parsed[1] == null && pairs.length > mapping_size) {
        const extra = nodeAt({
            document,
            id: pairs[mapping_size]
        })

        return [
            parsed[0],
            issue([
                extra,
                unknown_workspace_field
            ])
        ]
    }

    return parsed
}
