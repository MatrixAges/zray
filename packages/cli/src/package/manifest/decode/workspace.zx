import yaml from "manifest_yaml_document"

import field from "../schema/field"
import { Field, Mapping } from "../schema/model"
import {
    mapping_size,
    missing_workspace_packages,
    unknown_workspace_field
} from "./const"
import mapping from "./mapping"
import nodeAt from "./node_at"
import strings from "./strings"

import type { Input as Value } from "./value"

export type Input = Value

export type Output = string[]

export default function (in: Input): Output {
    const { document, node } = in

    const pairs = mapping({
        document: in.document,
        node: in.node
    })

    if (pairs.length == 0) {
        yaml.reject(document.parser, node, missing_workspace_packages)
    }

    const empty: string[] = []

    return loop({
        index: 0,
        packages: empty
    }, {
        while: state => state.index < pairs.length,
        next: state => {
            const key = nodeAt({
                document,
                id: pairs[state.index]
            })

            if (field({
                mapping: Mapping.Workspace,
                key: key.text
            }) != Field.Packages) {
                yaml.reject(document.parser, key, unknown_workspace_field)
            }

            state.packages = strings({
                document,
                node: nodeAt({
                    document,
                    id: pairs[state.index + 1]
                }),
                workspace: true
            })

            state.index += mapping_size
        },
        return: state => state.packages
    })
}
