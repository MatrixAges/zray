import yaml from "manifest_yaml_document"

import { missing_interface } from "../../schema/const"
import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import { empty_text, mapping_size, unknown_interface_field } from "../const"
import mapping from "../mapping"
import sequence from "../sequence"
import string from "../string"
import strings from "../strings"

import type { NativeInterface } from "../model"
import type { Input as Value } from "../value"

export type Input = Value

export type Output = NativeInterface[]

export default function (in: Input): Output {
    const { document } = in

    const items = sequence(in)
    const empty: NativeInterface[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < items.length,
        next: state => {
            const node = yaml.node(document, items[state.row], null)
            const pairs = mapping({
                document,
                node
            })
            const namespace: string[] = []
            const data = loop({
                index: 0,
                specifier: empty_text,
                path: empty_text,
                module: empty_text,
                namespace
            }, {
                while: pair => pair.index < pairs.length,
                next: pair => {
                    const key = yaml.node(document, pairs[pair.index], null)
                    const item = yaml.node(document, pairs[pair.index + 1], null)
                    const value = {
                        document,
                        node: item
                    }
                    const selected = field({
                        mapping: Mapping.NativeInterface,
                        key: yaml.text(key)
                    })

                    switch (selected) {
                        case Field.Specifier:
                            pair.specifier = string(value)
                        case Field.Path:
                            pair.path = string(value)
                        case Field.Module:
                            pair.module = string(value)
                        case Field.Namespace:
                            pair.namespace = strings({
                                ...value,
                                workspace: false
                            })
                        default:
                            yaml.reject(
                                document,
                                key,
                                unknown_interface_field
                            )
                    }

                    pair.index += mapping_size
                }
            })

            const missing = (
                - data.specifier == empty_text
                - or data.path == empty_text
                - or data.module == empty_text
            )

            if (missing) {
                yaml.reject(document, node, missing_interface)
            }

            state.out = state.out.push({
                specifier: data.specifier,
                path: data.path,
                module: data.module,
                namespace: data.namespace
            })[0]
            state.row += 1
        },
        return: state => state.out
    })
}
