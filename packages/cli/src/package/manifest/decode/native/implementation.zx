import yaml from "manifest_yaml_document"

import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import boolean from "../boolean"
import { empty_text, mapping_size, unknown_implementation_field } from "../const"
import mapping from "../mapping"
import string from "../string"
import strings from "../strings"

import type { ExternalImplementation } from "../model"
import type { Input as Value } from "../value"

export type Input = Value

export type State = ExternalImplementation & {
    index: u64
}

export type Output = ExternalImplementation?

export default function (in: Input): Output {
    const { document } = in

    const pairs = mapping(in)

    const initial: State = {
        index: 0,
        module: empty_text,
        member: empty_text,
        allocator_argument: false,
        io_argument: false,
        process_argument: false,
        expand_tuple: false,
        errors: null,
        fallible: false,
        concurrent: false
    }

    const data = loop(initial, {
        while: state => state.index < pairs.length,
        next: state => {
            const key = yaml.node(document, pairs[state.index], null)
            const item = yaml.node(document, pairs[state.index + 1], null)
            const value = {
                document,
                node: item
            }
            const selected = field({
                mapping: Mapping.Implementation,
                key: yaml.text(key)
            })

            switch (selected) {
                case Field.Module:
                    state.module = string(value)
                case Field.Member:
                    state.member = string(value)
                case Field.AllocatorArgument:
                    state.allocator_argument = boolean(value)
                case Field.IoArgument:
                    state.io_argument = boolean(value)
                case Field.ProcessArgument:
                    state.process_argument = boolean(value)
                case Field.ExpandTuple:
                    state.expand_tuple = boolean(value)
                case Field.Fallible:
                    state.fallible = boolean(value)
                case Field.Concurrent:
                    state.concurrent = boolean(value)
                case Field.Errors:
                    state.errors = strings({
                        ...value,
                        workspace: false
                    })
                default:
                    yaml.reject(document, key, unknown_implementation_field)
            }

            state.index += mapping_size
        }
    })

    if (data.module == empty_text || data.member == empty_text) {
        return null
    }

    return data.omit(["index"])
}
