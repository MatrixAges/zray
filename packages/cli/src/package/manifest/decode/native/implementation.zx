import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import boolean from "../boolean"
import { empty_text, mapping_size, unknown_implementation_field } from "../const"
import issue from "../issue"
import mapping from "../mapping"
import nodeAt from "../node_at"
import strings from "../strings"
import text from "../text"

import type { ExternalImplementation } from "../model"
import type { Diagnostic, Input as Value } from "../value"

export type Input = Value

export type State = ExternalImplementation & {
    index: u64,
    problem?: Diagnostic
}

export type Output = [ExternalImplementation?, Diagnostic?]

export default function (in: Input): Output {
    const { document } = in
    const { pairs, problem } = mapping(in)

    const initial: State = {
        index: 0,
        problem,
        module: empty_text,
        member: empty_text,
        allocator_argument: false,
        io_argument: false,
        process_argument: false,
        expand_tuple: false,
        errors: null,
        fallible: false,
        concurrent: false
    }

    const data = loop(initial, {
        while: state => state.problem == null && state.index < pairs.length,
        next: state => {
            const key = nodeAt({
                document,
                id: pairs[state.index]
            })
            const item = nodeAt({
                document,
                id: pairs[state.index + 1]
            })
            const value = {
                document,
                node: item
            }
            const selected = field({
                mapping: Mapping.Implementation,
                key: key.text
            })

            switch (selected) {
                case Field.Module:
                    const [parsed, field_issue] = text(value)

                    state.module = parsed
                    state.problem = field_issue
                case Field.Member:
                    const [parsed, field_issue] = text(value)

                    state.member = parsed
                    state.problem = field_issue
                case Field.AllocatorArgument:
                    const [parsed, field_issue] = boolean(value)

                    state.allocator_argument = parsed
                    state.problem = field_issue
                case Field.IoArgument:
                    const [parsed, field_issue] = boolean(value)

                    state.io_argument = parsed
                    state.problem = field_issue
                case Field.ProcessArgument:
                    const [parsed, field_issue] = boolean(value)

                    state.process_argument = parsed
                    state.problem = field_issue
                case Field.ExpandTuple:
                    const [parsed, field_issue] = boolean(value)

                    state.expand_tuple = parsed
                    state.problem = field_issue
                case Field.Fallible:
                    const [parsed, field_issue] = boolean(value)

                    state.fallible = parsed
                    state.problem = field_issue
                case Field.Concurrent:
                    const [parsed, field_issue] = boolean(value)

                    state.concurrent = parsed
                    state.problem = field_issue
                case Field.Errors:
                    const [parsed, field_issue] = strings({
                        ...value,
                        workspace: false
                    })

                    state.errors = parsed
                    state.problem = field_issue
                default:
                    state.problem = issue([
                        key,
                        unknown_implementation_field
                    ])
            }

            state.index += mapping_size
        }
    })

    if (data.problem != null) {
        return [
            null,
            data.problem
        ]
    }

    if (data.module == empty_text || data.member == empty_text) {
        return [
            null,
            null
        ]
    }

    return [
        data.omit([
            "index",
            "problem"
        ]),
        null
    ]
}
