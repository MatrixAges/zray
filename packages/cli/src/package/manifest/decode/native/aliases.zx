import yaml from "manifest_yaml_document"

import { missing_alias } from "../../schema/const"
import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import { empty_text, mapping_size, unknown_alias_field } from "../const"
import mapping from "../mapping"
import sequence from "../sequence"
import string from "../string"

import type { AbiAlias } from "../model"
import type { Input as Value } from "../value"

export type Input = Value

export type Output = AbiAlias[]

export default function (in: Input): Output {
    const { document } = in

    const items = sequence(in)
    const empty: AbiAlias[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < items.length,
        next: state => {
            const node = yaml.node(document, items[state.row], null)
            const pairs = mapping({
                document,
                node
            })
            const data = loop({
                index: 0,
                name: empty_text,
                specifier: empty_text
            }, {
                while: pair => pair.index < pairs.length,
                next: pair => {
                    const key = yaml.node(document, pairs[pair.index], null)
                    const text = string({
                        document,
                        node: yaml.node(
                            document,
                            pairs[pair.index + 1],
                            null
                        )
                    })
                    const selected = field({
                        mapping: Mapping.AbiAlias,
                        key: yaml.text(key)
                    })

                    switch (selected) {
                        case Field.Name:
                            pair.name = text
                        case Field.Specifier:
                            pair.specifier = text
                        default:
                            yaml.reject(document, key, unknown_alias_field)
                    }

                    pair.index += mapping_size
                }
            })

            if (data.name == empty_text || data.specifier == empty_text) {
                yaml.reject(document, node, missing_alias)
            }

            state.out = state.out.push({
                name: data.name,
                specifier: data.specifier
            })[0]
            state.row += 1
        },
        return: state => state.out
    })
}
