import { allocateRows } from "core/row_buffer"
import yaml from "manifest_yaml_document"
import columns from "memory/columns"

import { missing_external } from "../../schema/const"
import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import { empty_text, mapping_size, unknown_external_field } from "../const"
import mapping from "../mapping"
import sequence from "../sequence"
import string from "../string"
import implementation from "./implementation"

import type { ExternalOutput } from "../model"
import type { Input as Value } from "../value"

export type Input = Value & {
    target: ExternalOutput
}

export type Record = {
    index: u64,
    specifier: string,
    signature: string,
    export_name?: string,
    implementation: bool
}

export type Output = void

export default function (in: Input): Output {
    const { document, target } = in

    const items = sequence({
        document: in.document,
        node: in.node
    })

    allocateRows({
        target: target.buffer,
        count: items.length
    })

    const written = loop(0, {
        while: row => row < items.length,
        next: row => {
            const node = yaml.node(document, items[row], null)
            const pairs = mapping({
                document,
                node
            })
            const initial: Record = {
                index: 0,
                specifier: empty_text,
                signature: empty_text,
                export_name: null,
                implementation: false
            }
            const data = loop(initial, {
                while: state => state.index < pairs.length,
                next: state => {
                    const key = yaml.node(document, pairs[state.index], null)
                    const item = yaml.node(document, pairs[state.index + 1], null)
                    const value = {
                        document,
                        node: item
                    }
                    const selected = field({
                        mapping: Mapping.External,
                        key: yaml.text(key)
                    })

                    switch (selected) {
                        case Field.Specifier:
                            state.specifier = string(value)
                        case Field.Signature:
                            state.signature = string(value)
                        case Field.ExportName:
                            state.export_name = string(value)
                        case Field.Implementation:
                            state.implementation = implementation({
                                ...value,
                                target: target.columns,
                                row
                            })
                        default:
                            yaml.reject(
                                document,
                                key,
                                unknown_external_field
                            )
                    }

                    state.index += mapping_size
                }
            })

            const missing = (
                - data.specifier == empty_text
                - or data.signature == empty_text
                - or !data.implementation
            )

            if (missing) {
                yaml.reject(document, node, missing_external)
            }

            columns.writeColumnOptionalText(target.columns.identity, row, null)
            columns.writeColumnText(target.columns.specifier, row, data.specifier)
            columns.writeColumnText(target.columns.signature, row, data.signature)
            columns.writeColumnOptionalText(
                target.columns.export_name,
                row,
                data.export_name
            )
            row += 1
        }
    })
}
