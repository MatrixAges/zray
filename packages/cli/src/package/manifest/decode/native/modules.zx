import yaml from "manifest_yaml_document"

import { missing_module_name, missing_module_target } from "../../schema/const"
import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import { empty_text, mapping_size, unknown_module_field } from "../const"
import mapping from "../mapping"
import nodeAt from "../node_at"
import sequence from "../sequence"
import string from "../string"
import strings from "../strings"
import aliases from "./aliases"

import type { NativeModule } from "../model"
import type { Input as Value } from "../value"

export type Input = Value

export type Record = NativeModule & {
    index: u64
}

export type Output = NativeModule[]

export default function (in: Input): Output {
    const { document } = in

    const items = sequence(in)
    const empty: NativeModule[] = []

    return loop({
        row: 0,
        out: empty
    }, {
        while: state => state.row < items.length,
        next: state => {
            const node = nodeAt({
                document,
                id: items[state.row]
            })
            const pairs = mapping({
                document,
                node
            })
            const initial: Record = {
                index: 0,
                name: empty_text,
                path: null,
                header: null,
                dependencies: [],
                bundle_files: [],
                include_paths: null,
                abi_aliases: null
            }
            const data = loop(initial, {
                while: pair => pair.index < pairs.length,
                next: pair => {
                    const key = nodeAt({
                        document,
                        id: pairs[pair.index]
                    })
                    const item = nodeAt({
                        document,
                        id: pairs[pair.index + 1]
                    })
                    const value = {
                        document,
                        node: item
                    }
                    const selected = field({
                        mapping: Mapping.NativeModule,
                        key: key.text
                    })

                    switch (selected) {
                        case Field.Name:
                            pair.name = string(value)
                        case Field.Path:
                            pair.path = string(value)
                        case Field.Header:
                            pair.header = string(value)
                        case Field.Dependencies:
                            pair.dependencies = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.BundleFiles:
                            pair.bundle_files = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.IncludePaths:
                            pair.include_paths = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.AbiAliases:
                            pair.abi_aliases = aliases(value)
                        default:
                            yaml.reject(
                                document.parser,
                                key,
                                unknown_module_field
                            )
                    }

                    pair.index += mapping_size
                }
            })

            if (data.name == empty_text) {
                yaml.reject(document.parser, node, missing_module_name)
            }

            if ((data.path == null) == (data.header == null)) {
                yaml.reject(document.parser, node, missing_module_target)
            }

            state.out = state.out.push(data.omit(["index"]))[0]
            state.row += 1
        },
        return: state => state.out
    })
}
