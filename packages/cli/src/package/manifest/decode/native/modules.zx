import { allocateRows } from "core/row_buffer"
import yaml from "manifest_yaml_document"
import columns from "memory/columns"

import { missing_module_name, missing_module_target } from "../../schema/const"
import field from "../../schema/field"
import { Field, Mapping } from "../../schema/model"
import { empty_text, mapping_size, unknown_module_field } from "../const"
import mapping from "../mapping"
import sequence from "../sequence"
import string from "../string"
import strings from "../strings"
import aliases from "./aliases"

import type { AliasOutput, ModuleOutput } from "../model"
import type { Input as Value } from "../value"

export type Input = Value & {
    target: ModuleOutput,
    alias_target: AliasOutput
}

export type Record = {
    index: u64,
    name: string,
    path?: string,
    header?: string,
    dependencies: string[],
    bundle_files: string[],
    include_paths?: string[],
    aliases: bool
}

export type Output = void

export default function (in: Input): Output {
    const { document, target, alias_target } = in

    const items = sequence({
        document: in.document,
        node: in.node
    })

    allocateRows({
        target: target.buffer,
        count: items.length
    })

    const written = loop(0, {
        while: row => row < items.length,
        next: row => {
            const node = yaml.node(document, items[row], null)
            const pairs = mapping({
                document,
                node
            })
            const initial: Record = {
                index: 0,
                name: empty_text,
                path: null,
                header: null,
                dependencies: [],
                bundle_files: [],
                include_paths: null,
                aliases: false
            }
            const data = loop(initial, {
                while: state => state.index < pairs.length,
                next: state => {
                    const key = yaml.node(document, pairs[state.index], null)
                    const item = yaml.node(document, pairs[state.index + 1], null)
                    const value = {
                        document,
                        node: item
                    }
                    const selected = field({
                        mapping: Mapping.NativeModule,
                        key: yaml.text(key)
                    })

                    switch (selected) {
                        case Field.Name:
                            state.name = string(value)
                        case Field.Path:
                            state.path = string(value)
                        case Field.Header:
                            state.header = string(value)
                        case Field.Dependencies:
                            state.dependencies = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.BundleFiles:
                            state.bundle_files = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.IncludePaths:
                            state.include_paths = strings({
                                ...value,
                                workspace: false
                            })
                        case Field.AbiAliases:
                            aliases({
                                ...value,
                                target: alias_target,
                                aliases: target.columns.abi_aliases,
                                row
                            })

                            state.aliases = true
                        default:
                            yaml.reject(document, key, unknown_module_field)
                    }

                    state.index += mapping_size
                }
            })

            if (data.name == empty_text) {
                yaml.reject(document, node, missing_module_name)
            }

            if ((data.path == null) == (data.header == null)) {
                yaml.reject(document, node, missing_module_target)
            }

            columns.writeColumnText(target.columns.name, row, data.name)
            columns.writeColumnOptionalText(target.columns.path, row, data.path)
            columns.writeColumnOptionalText(
                target.columns.header,
                row,
                data.header
            )
            columns.writeColumnTextList(
                target.columns.dependencies,
                row,
                data.dependencies
            )
            columns.writeColumnTextList(
                target.columns.bundle_files,
                row,
                data.bundle_files
            )
            columns.writeColumnOptionalTextList(
                target.columns.include_paths,
                row,
                data.include_paths
            )

            if (!data.aliases) {
                columns.clearOptionalRowList(target.columns.abi_aliases, row)
            }

            row += 1
        }
    })
}
