import nodeAt from "../node_at"
import sequence from "../sequence"
import readRow from "./modules/row"

import type { NativeModule } from "../model"
import type { Diagnostic, Input } from "../value"

export type Output = [NativeModule[], Diagnostic?]

export default function (in: Input): Output {
    const { document } = in
    const [items, problem] = sequence(in)

    const empty: NativeModule[] = []

    return loop({
        row: 0,
        out: empty,
        problem
    }, {
        while: state => state.problem == null && state.row < items.length,
        next: state => {
            const [item, row_issue] = readRow({
                document,
                node: nodeAt({
                    document,
                    id: items[state.row]
                })
            })

            state.problem = row_issue

            if (item != null) {
                state.out = state.out.push(item)[0]
            }

            state.row += 1
        },
        return: state => [
            state.out,
            state.problem
        ]
    })
}
