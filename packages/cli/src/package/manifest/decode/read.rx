<Module>
    <Type from="model" as="Manifest" />

    <Args in={Manifest.Input} out={Manifest.Values} />

    <Call fn="mapping" in={$in} />

    <Call
        fn="fields"
        in={{
            document: $in.document,
            pairs: $ctx.mapping
        }}
    />

    <Call
        module="../schema/root/check"
        in={{
            entry: $ctx.fields.entry != null,
            library: $ctx.fields.library != null,
            exports: $ctx.fields.exports.length,
            compiled_exports: $ctx.fields.compiled_exports,
            name: $ctx.fields.name != "",
            version: $ctx.fields.version != ""
        }}
    />

    <If on={$ctx.check != null}>
        <Call
            fn="index.reject"
            in={[
                $in.document,
                $in.node,
                $ctx.check
            ]}
        />

        <Return value={$ctx.fields} />
    </If>

    <Return value={$ctx.fields} />
</Module>
