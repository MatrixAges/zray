<Module>
    <Type from="model" as="Manifest" />

    <Args in={Manifest.Input} out={Manifest.Result} />

    <Call fn="mapping" in={$in.omit(["version_limit"])} />

    <If on={$ctx.mapping.problem != null}>
        <Return
            value={{
                diagnostic: $ctx.mapping.problem
            }}
        />
    </If>

    <Call
        fn="fields"
        in={{
            document: $in.document,
            pairs: $ctx.mapping.pairs,
            version_limit: $in.version_limit
        }}
    />

    <If on={$ctx.fields.problem != null}>
        <Return
            value={{
                diagnostic: $ctx.fields.problem
            }}
        />
    </If>

    <Call
        module="../schema/root/check"
        in={{
            entry: $ctx.fields.values.entry != null,
            library: $ctx.fields.values.library != null,
            exports: $ctx.fields.values.exports.length,
            compiled_exports: $ctx.fields.values.compiled_exports,
            name: $ctx.fields.values.name != "",
            version: $ctx.fields.values.version != ""
        }}
    />

    <If on={$ctx.check != null}>
        <Call
            fn="issue"
            in={[
                $in.node,
                $ctx.check
            ]}
        />

        <Return
            value={{
                diagnostic: $ctx.issue
            }}
        />
    </If>

    <Return
        value={{
            data: $ctx.fields.values
        }}
    />
</Module>
