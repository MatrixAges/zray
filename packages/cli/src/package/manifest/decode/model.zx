import type { Diagnostic, Input as Value } from "./value"

export type Export = {
    path: string,
    source: string,
    module?: string
}

export type Dependency = {
    name: string,
    requirement: string
}

export type NativeInterface = {
    specifier: string,
    path: string,
    module: string,
    namespace: string[]
}

export type AbiAlias = {
    name: string,
    specifier: string
}

export type NativeModule = {
    name: string,
    path?: string,
    header?: string,
    dependencies: string[],
    bundle_files: string[],
    include_paths?: string[],
    abi_aliases?: AbiAlias[]
}

export type ExternalImplementation = {
    module: string,
    member: string,
    allocator_argument: bool,
    io_argument: bool,
    process_argument: bool,
    expand_tuple: bool,
    errors?: string[],
    fallible: bool,
    concurrent: bool
}

export type External = {
    specifier: string,
    signature: string,
    export_name?: string,
    implementation: ExternalImplementation
}

export type Input = Value & {
    version_limit: u64
}

export type Values = {
    name: string,
    version: string,
    entry?: string,
    library?: string,
    exports: Export[],
    private: bool,
    dependencies: Dependency[],
    dev_dependencies: Dependency[],
    workspace?: string[],
    native_interfaces: NativeInterface[],
    externals: External[],
    native_modules: NativeModule[],
    libraries: string[],
    include_paths: string[],
    library_paths: string[],
    compiled_exports: u64
}

export type Result = {
    data?: Values,
    diagnostic?: Diagnostic
}
