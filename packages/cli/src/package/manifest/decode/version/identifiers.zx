import { ascii_dot, ascii_minus } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import number from "./number"

import type { Input as Digits } from "./number"

export type Input = Digits & {
    prerelease: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { text, start, end, limit, prerelease } = in

    return loop({
        offset: start,
        first: start,
        numeric: true,
        valid: true
    }, {
        while: state => state.valid && state.offset <= end,
        next: state => {
            const offset = state.offset

            if (offset == end || text[offset] == ascii_dot) {
                if (offset == state.first) {
                    state.valid = false
                } else if (prerelease && state.numeric) {
                    state.valid = number({
                        text,
                        start: state.first,
                        end: offset,
                        limit
                    })
                }

                state.first = offset + 1
                state.numeric = true
            } else {
                const byte = text[offset]
                const digit = byte >= ascii_digit_first && byte <= ascii_digit_last
                const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
                const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
                const letter = lower || upper

                state.valid = digit || letter || byte == ascii_minus
                state.numeric = state.numeric && digit
            }

            state.offset += 1
        },
        return: state => state.valid
    })
}
