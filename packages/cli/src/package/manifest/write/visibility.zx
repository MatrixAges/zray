import { private_key, true_scalar } from "../schema/const"
import { field_separator, line_end } from "./const"

export type Input = {
    private: bool,
    has_exports: bool
}

export type Output = string

export default function (in: Input): Output {
    if (!in.private) {
        return ""
    }

    const prefix = in.has_exports ? line_end : ""

    return `${prefix}${private_key}${field_separator}${true_scalar}${line_end}`
}
