import strings from "std:string"
import memory from "memory"

import { abi_aliases_key, name_key, specifier_key } from "../schema/const"
import object from "./json/object"
import quote from "./json/quote"
import textField from "./json/text_field"

import type { AbiAliases } from "./model"

export type Input = {
    aliases: AbiAliases,
    row: u64
}

export type Output = string?

export default function (in: Input): Output {
    const { aliases, row } = in

    const count = memory.optionalListLength(aliases.name, row)

    if (count == null) {
        return null
    }

    const initial: string[] = []

    const items = loop({
        index: 0,
        out: initial
    }, {
        while: state => state.index < count,
        next: state => {
            const fields: string[] = [
                textField({
                    key: name_key,
                    value:
                        memory.readOptionalTextListItem(
                            aliases.name,
                            row,
                            state.index
                        )
                }),
                textField({
                    key: specifier_key,
                    value: memory.readOptionalTextListItem(
                        aliases.specifier,
                        row,
                        state.index
                    )
                })
            ]

            state.out = state.out.push(object(fields))[0]
            state.index += 1
        },
        return: state => state.out
    })

    return `${quote(abi_aliases_key)}:[${strings.join(",", items)}]`
}
