<Module>
    <Type from="model" as="Manifest" />

    <Args in={Manifest.Input} out={string} />

    <Call fn="identity" in={$in.identity} />
    <Call fn="exports" in={$in.exports} />

    <Call
        fn="visibility"
        in={{
            private: $in.private,
            has_exports: $in.exports.count != 0
        }}
    />

    <Call
        fn="dependency_sections"
        in={{
            dependencies: $in.dependencies,
            dev_dependencies: $in.dev_dependencies
        }}
    />

    <Call fn="workspace" in={$in.workspace} />
    <Call fn="interfaces" in={$in.interfaces} />

    <Call
        fn="externals"
        in={{
            rows: $in.externals,
            implementations: $in.implementations
        }}
    />

    <Call
        fn="modules"
        in={{
            rows: $in.modules,
            aliases: $in.aliases
        }}
    />

    <Call
        fn="paths"
        in={{
            libraries: $in.libraries,
            include_paths: $in.include_paths,
            library_paths: $in.library_paths
        }}
    />

    <Call
        fn="text.join"
        in={[
            "",
            [
                $ctx.identity,
                $ctx.exports,
                $ctx.visibility,
                $ctx.dependency_sections,
                $ctx.workspace,
                $ctx.interfaces,
                $ctx.externals,
                $ctx.modules,
                $ctx.paths
            ]
        ]}
    />

    <Return value={$ctx.join} />
</Module>
