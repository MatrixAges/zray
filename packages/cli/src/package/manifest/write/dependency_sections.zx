import { dependencies_key, dev_dependencies_key } from "../schema/const"
import dependencies from "./dependencies"

import type { Dependencies, Writer } from "./model"

export type Input = Writer & {
    dependencies: Dependencies,
    dev_dependencies: Dependencies
}

export type Output = void

export default function (in: Input): Output {
    const { writer } = in

    dependencies({
        writer,
        key: dependencies_key,
        rows: in.dependencies
    })

    dependencies({
        writer,
        key: dev_dependencies_key,
        rows: in.dev_dependencies
    })
}
