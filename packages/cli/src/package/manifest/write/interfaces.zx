import strings from "std:string"
import memory from "memory"

import {
    module_key,
    namespace_key,
    native_interfaces_key,
    path_key,
    specifier_key
} from "../schema/const"
import { line_end, list_item } from "./const"
import object from "./json/object"
import stringsField from "./json/strings_field"
import textField from "./json/text_field"
import section from "./section"

import type { Interfaces } from "./model"

export type Input = Interfaces

export type Output = string

export default function (in: Input): Output {
    if (in.count == 0) {
        return ""
    }

    const initial: string[] = [section(native_interfaces_key)]

    const parts = loop({
        row: 0,
        out: initial
    }, {
        while: state => state.row < in.count,
        next: state => {
            const fields: string[] = [
                textField({
                    key: specifier_key,
                    value: memory.readTextColumn(in.specifier, state.row)
                }),
                textField({
                    key: path_key,
                    value: memory.readTextColumn(in.path, state.row)
                }),
                textField({
                    key: module_key,
                    value: memory.readTextColumn(in.module, state.row)
                }),
                stringsField({
                    key: namespace_key,
                    values: memory.readTextListColumn(in.namespace, state.row)
                })
            ]

            state.out = state.out.push(`${list_item}${object(fields)}${line_end}`)[0]
            state.row += 1
        },
        return: state => state.out
    })

    return strings.join("", parts)
}
