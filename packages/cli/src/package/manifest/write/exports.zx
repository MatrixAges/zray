import strings from "std:string"
import memory from "memory"

import { exports_key, module_key } from "../schema/const"
import { indent, nested_indent, section_end } from "./const"
import field from "./field"
import section from "./section"

import type { Exports } from "./model"

export type Input = Exports

export type Output = string

export default function (in: Input): Output {
    if (in.count == 0) {
        return ""
    }

    const initial: string[] = [section(exports_key)]

    const parts = loop({
        row: 0,
        out: initial
    }, {
        while: state => state.row < in.count,
        next: state => {
            const path = memory.readTextColumn(in.path, state.row)
            const module = memory.readOptionalTextColumn(in.module, state.row)

            const line = match {
                module != null =>
                    `${indent}${path}${section_end}${nested_indent}${field({
                        key: module_key,
                        text: module
                    })}`,
                _ =>
                    `${indent}${field({
                    key: path,
                    text: memory.readTextColumn(in.source, state.row)
                })}`
            }

            state.out = state.out.push(line)[0]
            state.row += 1
        },
        return: state => state.out
    })

    return strings.join("", parts)
}
