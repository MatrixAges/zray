import strings from "std:string"

import { line_end, list_item } from "./const"
import quote from "./json/quote"
import section from "./section"

export type Input = {
    key: string,
    values: string[]
}

export type Output = string

export default function (in: Input): Output {
    const { key, values } = in

    if (values.length == 0) {
        return ""
    }

    const initial: string[] = [section(key)]

    const parts = loop({
        index: 0,
        out: initial
    }, {
        while: state => state.index < values.length,
        next: state => {
            const line = `${list_item}${quote(values[state.index])}${line_end}`

            state.out = state.out.push(line)[0]
            state.index += 1
        },
        return: state => state.out
    })

    return strings.join("", parts)
}
