import { packages_key, workspace_key } from "../schema/const"
import { field_separator, indent, line_end } from "./const"
import quoteStrings from "./json/strings"
import section from "./section"

export type Input = string[]?

export type Output = string

export default function (in: Input): Output {
    if (in == null) {
        return ""
    }

    return `${section(workspace_key)}${indent}${packages_key}${field_separator}${quoteStrings(in)}${line_end}`
}
