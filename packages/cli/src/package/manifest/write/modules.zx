import strings from "std:string"
import memory from "memory"

import {
    bundle_files_key,
    dependencies_key,
    header_key,
    include_paths_key,
    name_key,
    native_modules_key,
    path_key
} from "../schema/const"
import aliasField from "./aliases"
import { line_end, list_item } from "./const"
import object from "./json/object"
import stringsField from "./json/strings_field"
import textField from "./json/text_field"
import section from "./section"

import type { AbiAliases, NativeModules } from "./model"

export type Input = {
    rows: NativeModules,
    aliases: AbiAliases
}

export type Output = string

export default function (in: Input): Output {
    const { rows, aliases } = in

    if (rows.count == 0) {
        return ""
    }

    const initial: string[] = [section(native_modules_key)]

    const parts = loop({
        row: 0,
        out: initial
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const base: string[] = [textField({
                key: name_key,
                value: memory.readTextColumn(rows.name, state.row)
            })]

            const path = memory.readOptionalTextColumn(rows.path, state.row)

            const with_path: string[] = match {
                path == null => base,
                _ => base.push(textField({
                    key: path_key,
                    value: path
                }))[0]
            }

            const header = memory.readOptionalTextColumn(rows.header, state.row)

            const with_header: string[] = match {
                header == null => with_path,
                _ => with_path.push(textField({
                    key: header_key,
                    value: header
                }))[0]
            }

            const with_deps = with_header.push(stringsField({
                key: dependencies_key,
                values: memory.readTextListColumn(
                    rows.dependencies,
                    state.row
                )
            }))[0].push(stringsField({
                key: bundle_files_key,
                values: memory.readTextListColumn(
                    rows.bundle_files,
                    state.row
                )
            }))[0]

            const include_paths = memory.readOptionalTextListColumn(
                rows.include_paths,
                state.row
            )

            const with_include: string[] = match {
                include_paths == null => with_deps,
                _ => with_deps.push(stringsField({
                    key: include_paths_key,
                    values: include_paths
                }))[0]
            }

            const alias = aliasField({
                aliases,
                row: state.row
            })

            const fields: string[] = match {
                alias == null => with_include,
                _ => with_include.push(alias)[0]
            }

            state.out = state.out.push(`${list_item}${object(fields)}${line_end}`)[0]
            state.row += 1
        },
        return: state => state.out
    })

    return strings.join("", parts)
}
