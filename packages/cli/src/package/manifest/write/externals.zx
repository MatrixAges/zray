import strings from "std:string"
import memory from "memory"

import {
    export_name_key,
    externals_key,
    signature_key,
    specifier_key
} from "../schema/const"
import { line_end, list_item } from "./const"
import implementation from "./implementation"
import object from "./json/object"
import textField from "./json/text_field"
import section from "./section"

import type { Externals, Implementations } from "./model"

export type Input = {
    rows: Externals,
    implementations: Implementations
}

export type Output = string

export default function (in: Input): Output {
    const { rows, implementations } = in

    if (rows.count == 0) {
        return ""
    }

    const initial: string[] = [section(externals_key)]

    const parts = loop({
        row: 0,
        out: initial
    }, {
        while: state => state.row < rows.count,
        next: state => {
            const base: string[] = [textField({
                key: specifier_key,
                value: memory.readTextColumn(rows.specifier, state.row)
            })]

            const export_name =
                memory.readOptionalTextColumn(rows.export_name, state.row)

            const with_export: string[] = match {
                export_name == null => base,
                _ => base.push(textField({
                    key: export_name_key,
                    value: export_name
                }))[0]
            }

            const fields = with_export.push(textField({
                key: signature_key,
                value: memory.readTextColumn(rows.signature, state.row)
            }))[0].push(implementation({
                rows: implementations,
                row: state.row
            }))[0]

            state.out = state.out.push(`${list_item}${object(fields)}${line_end}`)[0]
            state.row += 1
        },
        return: state => state.out
    })

    return strings.join("", parts)
}
