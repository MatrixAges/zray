import memory from "memory"

import {
    allocator_argument_key,
    concurrent_key,
    errors_key,
    expand_tuple_key,
    fallible_key,
    implementation_key,
    io_argument_key,
    member_key,
    module_key,
    process_argument_key
} from "../schema/const"
import boolField from "./json/bool_field"
import object from "./json/object"
import quote from "./json/quote"
import stringsField from "./json/strings_field"
import textField from "./json/text_field"

import type { Implementations } from "./model"

export type Input = {
    rows: Implementations,
    row: u64
}

export type Output = string

export default function (in: Input): Output {
    const { rows, row } = in

    const base: string[] = [
        textField({
            key: module_key,
            value: memory.readTextColumn(rows.module, row)
        }),
        textField({
            key: member_key,
            value: memory.readTextColumn(rows.member, row)
        }),
        boolField({
            key: allocator_argument_key,
            value: memory.readColumnBool(rows.allocator_argument, row)
        }),
        boolField({
            key: io_argument_key,
            value: memory.readColumnBool(rows.io_argument, row)
        }),
        boolField({
            key: process_argument_key,
            value: memory.readColumnBool(rows.process_argument, row)
        }),
        boolField({
            key: expand_tuple_key,
            value: memory.readColumnBool(rows.expand_tuple, row)
        }),
        boolField({
            key: fallible_key,
            value: memory.readColumnBool(rows.fallible, row)
        })
    ]

    const errors = memory.readOptionalTextListColumn(rows.errors, row)

    const with_errors: string[] = match {
        errors == null => base,
        _ => base.push(stringsField({
            key: errors_key,
            values: errors
        }))[0]
    }

    const fields = with_errors.push(boolField({
        key: concurrent_key,
        value: memory.readColumnBool(rows.concurrent, row)
    }))[0]

    return `${quote(implementation_key)}:${object(fields)}`
}
