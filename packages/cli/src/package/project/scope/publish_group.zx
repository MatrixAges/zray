import memory from "memory"

import specifier from "./specifier"

import type { Entry, Group as Input } from "./model"

export type Output = Entry[]

export default function (in: Input): Output {
    const empty: Entry[] = []

    return loop({
        row: 0,
        entries: empty
    }, {
        while: state => state.row < in.count,
        next: state => {
            const path = memory.readListText(in.paths, in.target, state.row)
            const name = specifier({
                path,
                name: in.name
            })

            state.entries = state.entries.push({
                target: in.target,
                row: state.row,
                specifier: name
            })[0]
            state.row += 1
        },
        return: state => state.entries
    })
}
