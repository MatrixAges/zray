import bytes from "std:bytes"
import memory from "memory"

import specifier from "./specifier"

import type { Group as Input } from "./model"

export type Output = u64

export default function (in: Input): Output {
    const { rows, width, output } = in

    const count = rows.length / width

    const end = loop(0, {
        while: row => row < count,
        next: row => {
            const path = memory.readListText(in.paths, in.target, row)
            const name = specifier({
                path,
                name: in.name
            })
            const source = memory.borrowU8Range(rows, row * width, width)
            const target = in.first + row

            memory.copyColumnValue(output.records, target, source)
            memory.writeColumnBytes(
                output.specifiers,
                target,
                bytes.fromText(name)
            )
            row += 1
        }
    })

    return in.first + end
}
