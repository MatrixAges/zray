import { writeCompiledExport, writeSourceExport } from "package_workspace_host"

import type { Exports as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const written = loop(0, {
        while: index => index < in.count,
        next: index => {
            if (in.compiled) {
                writeCompiledExport(in.binding, index)
            } else {
                writeSourceExport(in.binding, index)
            }

            index += 1
        }
    })
}
