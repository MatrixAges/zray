import { bindScope } from "package_workspace_host"

import type { Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const published = loop({
        index: 0,
        valid: true
    }, {
        while: state => state.valid && state.index < in.count,
        next: state => {
            state.valid = bindScope(in.binding, state.index)
            state.index += 1
        }
    })
}
