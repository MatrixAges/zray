import type { ScopeBinding } from "package_workspace_host"

export type Input = {
    binding: ScopeBinding,
    count: u64
}

export type Row = {
    binding: ScopeBinding,
    index: u64
}

export type Exports = Input & {
    compiled: bool
}

export type Prepare = Input & {
    index: u64,
    running: bool
}

export type ExportWalk = Exports & {
    index: u64
}

export type PublishWalk = Input & {
    index: u64,
    valid: bool
}
