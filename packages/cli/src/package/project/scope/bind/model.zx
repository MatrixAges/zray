import type { Project } from "package_workspace_host"

export type Input = {
    binding: Project,
    count: u64
}

export type Row = {
    binding: Project,
    index: u64
}

export type Prepare = Input & {
    index: u64,
    running: bool
}

export type PublishWalk = Input & {
    index: u64,
    valid: bool
}
