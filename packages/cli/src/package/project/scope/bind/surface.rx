<Module>
    <Type from="model" as="Scopes" />

    <Args in={Scopes.Row} out={void} />

    <Call
        fn="index.prepareSurface"
        in={[
            $in.binding,
            $in.index
        ]}
    />

    <If on={$ctx.prepareSurface.entry != null}>
        <Call
            fn="index.writeScopeEntry"
            in={[
                $in.binding,
                $ctx.prepareSurface.entry
            ]}
        />

        <Else>
            <If on={$ctx.prepareSurface.library != null}>
                <Call
                    fn="index.prepareLibrarySurface"
                    in={[
                        $in.binding,
                        $ctx.prepareSurface.library
                    ]}
                />
            </If>

            <Call
                fn="exports"
                in={{
                    binding: $in.binding,
                    count: $ctx.prepareSurface.exports,
                    compiled: $ctx.prepareSurface.library != null
                }}
            />
        </Else>
    </If>
</Module>
