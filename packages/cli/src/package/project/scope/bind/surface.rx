<Module>
    <Type from="model" as="Scopes" />

    <Args in={Scopes.Row} out={void} />

    <Call
        fn="index.readScopeSurface"
        in={[
            $in.binding,
            $in.index
        ]}
    />

    <Call fn="resolve_surface" />

    <Call
        fn="index.publishScopeSurface"
        in={[
            $in.binding,
            $in.index,
            $ctx.resolve_surface
        ]}
    />
</Module>
