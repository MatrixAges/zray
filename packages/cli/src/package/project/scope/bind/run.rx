<Module>
    <Type from="model" as="Scopes" />

    <Args in={Scopes.Input} out={void} />

    <Loop on={$in.running}>
        <Call
            module="prepare"
            in={{
                ...$in,
                index: 0,
                running: $in.count != 0
            }}
        />
    </Loop>

    <Call fn="index.borrowScopeColumns" in={$in.binding} />
    <Call fn="publish" in={$in} />
</Module>
