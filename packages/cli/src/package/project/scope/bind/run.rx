<Module>
    <Type from="model" as="Scopes" />

    <Args in={Scopes.Input} out={void} />

    <Loop on={$in.running}>
        <Call
            module="prepare"
            in={{
                ...$in,
                index: 0,
                running: $in.count != 0
            }}
        />
    </Loop>

    <Loop on={$in.valid && $in.index < $in.count}>
        <Call
            module="publish"
            in={{
                ...$in,
                index: 0,
                valid: true
            }}
        />
    </Loop>
</Module>
