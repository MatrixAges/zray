import memory from "memory"

import appendEntries from "./append_entries"
import publishGroup from "./publish_group"

import type { Entry, Input } from "./model"

export type Output = Entry[]

export default function (in: Input): Output {
    const { owner, targets, aliases, paths } = in

    const edges = memory.listLength(targets, owner)
    const empty: Entry[] = []

    return loop({
        index: 0,
        entries: empty
    }, {
        while: state => state.index <= edges,
        next: state => {
            const own = state.index == edges
            const target = match own {
                true => owner,
                _ => memory.readListIndex(targets, owner, state.index)
            }
            const name = match own {
                true => in.name,
                _ => memory.readListText(aliases, owner, state.index)
            }

            const items = publishGroup({
                count: memory.listLength(paths, target),
                paths,
                target,
                name
            })

            state.entries = appendEntries({
                target: state.entries,
                items
            })
            state.index += 1
        },
        return: state => state.entries
    })
}
