<Module>
    <Type from="model" as="Scope" />

    <Args in={Scope.Input} out={Scope.Result} />

    <Call
        fn="measure"
        in={$in.pick([
            "owner",
            "targets",
            "paths"
        ])}
    />

    <If on={$ctx.measure.missing != null}>
        <Return
            value={{
                ...$ctx.measure,
                entries: []
            }}
        />
    </If>

    <Call fn="write" in={$in} />

    <Return
        value={{
            ...$ctx.measure,
            entries: $ctx.write
        }}
    />
</Module>
