import type { ListColumn } from "memory"

export type Routes = {
    owner: u64,
    targets: ListColumn,
    paths: ListColumn
}

export type Entry = {
    target: u64,
    row: u64,
    specifier: string
}

export type Input = Routes & {
    name: string,
    aliases: ListColumn
}

export type Measurement = {
    count: u64,
    missing?: u64
}

export type Result = Measurement & {
    entries: Entry[]
}

export type Group = {
    count: u64,
    paths: ListColumn,
    target: u64,
    name: string
}
