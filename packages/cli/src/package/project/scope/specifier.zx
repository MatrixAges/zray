import encoding from "std:encoding"

import { export_prefix_length, root_export } from "./const"

export type Input = {
    name: string,
    path: string
}

export type Output = string

export default function (in: Input): Output {
    const { name, path } = in

    if (path == root_export) {
        return name
    }

    const suffix = encoding.sliceBytes(path, export_prefix_length, path.length)

    return `${name}/${suffix}`
}
