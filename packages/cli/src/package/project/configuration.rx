<Module>
    <Type from="model" as="Project" />

    <Args in={Project.Input} out={string?} />

    <If on={$in.config_path != null}>
        <Return value={$in.config_path} />
    </If>

    <Call fn="index.findProjectConfiguration" in={$in.project} />

    <Return value={$ctx.findProjectConfiguration} />
</Module>
