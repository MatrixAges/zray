<Module>
    <Type from="model" as="Project" />

    <Args in={Project.Input} out={Project.Outcome} />

    <Call module="configuration" in={$in} />

    <If on={$ctx.configuration != null}>
        <Call
            fn="index.loadProjectGraph"
            in={[
                $in.project,
                $ctx.configuration
            ]}
        />

        <If on={$ctx.loadProjectGraph != null}>
            <Call
                module="scope/bind/run"
                in={{
                    binding: $in.project,
                    count: $ctx.loadProjectGraph
                }}
            />

            <If on={$ctx.run}>
                <Call fn="index.owningProjectScope" in={$in.project} />

                <If on={$ctx.owningProjectScope != null}>
                    <Return
                        value={{
                            owner: $ctx.owningProjectScope,
                            outside_package: false
                        }}
                    />

                    <Else>
                        <Return
                            value={{
                                outside_package: true
                            }}
                        />
                    </Else>
                </If>
            </If>
        </If>
    </If>

    <Return
        value={{
            outside_package: false
        }}
    />
</Module>
