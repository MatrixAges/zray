<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Project} out={void} />

    <Call module="configuration" in={$in} />

    <If on={$ctx.configuration != null}>
        <Call
            fn="index.loadProjectGraph"
            in={[
                $in,
                $ctx.configuration
            ]}
        />

        <If on={$ctx.loadProjectGraph}>
            <Call fn="index.bindProjectScopes" in={$in} />

            <If on={$ctx.bindProjectScopes}>
                <Call fn="index.owningProjectScope" in={$in} />

                <If on={$ctx.owningProjectScope != null}>
                    <Call
                        fn="index.publishProject"
                        in={[
                            $in,
                            $ctx.owningProjectScope
                        ]}
                    />

                    <Else>
                        <Call fn="index.reportProjectEntry" in={$in} />
                    </Else>
                </If>
            </If>
        </If>
    </If>
</Module>
