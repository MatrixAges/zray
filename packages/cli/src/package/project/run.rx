<Module>
    <Type from="model" as="Project" />

    <Args in={Project.Input} out={Project.Outcome} />

    <Call module="configuration" in={$in} />

    <If on={$ctx.configuration != null}>
        <Call
            fn="index.loadProjectGraph"
            in={[
                $in.project,
                $ctx.configuration
            ]}
        />

        <If on={$ctx.loadProjectGraph}>
            <Call fn="index.bindProjectScopes" in={$in.project} />

            <If on={$ctx.bindProjectScopes}>
                <Call fn="index.owningProjectScope" in={$in.project} />

                <If on={$ctx.owningProjectScope != null}>
                    <Call
                        fn="index.publishProject"
                        in={[
                            $in.project,
                            $ctx.owningProjectScope
                        ]}
                    />

                    <Return value={Project.Outcome.Complete} />

                    <Else>
                        <Return value={Project.Outcome.OutsidePackage} />
                    </Else>
                </If>
            </If>
        </If>
    </If>

    <Return value={Project.Outcome.Complete} />
</Module>
