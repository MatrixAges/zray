<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.ArchiveSource} out={Installation.ArchiveOutcome} />

    <Call
        fn="../effects.fetchArchive"
        in={[
            $in.session,
            $in.source,
            $in.release
        ]}
    />

    <Call
        fn="../effects.readArchive"
        in={[
            $in.session,
            $ctx.fetchArchive
        ]}
    />

    <Call
        fn="../effects.verifyArchive"
        in={[
            $in.session,
            $ctx.readArchive,
            $in.release
        ]}
    />

    <Call
        fn="../effects.recordArchive"
        in={[
            $in.catalog.build,
            $in.source,
            $in.release,
            $ctx.readArchive
        ]}
    />

    <Call
        fn="../effects.canonicalPath"
        in={[
            $in.session,
            $ctx.fetchArchive
        ]}
    />

    <Return
        value={{
            target: $ctx.recordArchive,
            path: $ctx.canonicalPath
        }}
    />
</Module>
