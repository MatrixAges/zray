<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.ArchiveSource} out={Installation.ArchiveOutcome} />

    <Call
        fn="../effects.fetchArchive"
        in={[
            $in.session,
            $in.root,
            $in.fetch.cache,
            $in.fetch.offline,
            $in.source,
            $in.release
        ]}
    />

    <Call
        fn="../effects.readArchive"
        in={[
            $in.catalog.build,
            $ctx.fetchArchive
        ]}
    />

    <Call
        fn="archive_admission"
        in={{
            manifest: $ctx.readArchive,
            release: $in.release
        }}
    />

    <Call
        fn="../effects.recordArchive"
        in={[
            $in.catalog.build,
            $in.source,
            $in.release.sha256,
            $ctx.archive_admission
        ]}
    />

    <Call fn="../effects.realpath" in={$ctx.fetchArchive} />

    <Return
        value={{
            target: $ctx.recordArchive,
            path: $ctx.realpath
        }}
    />
</Module>
