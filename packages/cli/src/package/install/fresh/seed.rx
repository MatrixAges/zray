<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.MemberWalk} out={Model.MemberWalk} />

    <Call
        fn="../effects.seedMember"
        in={[
            $in.host,
            $in.index
        ]}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
