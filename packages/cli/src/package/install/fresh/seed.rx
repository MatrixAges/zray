<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.MemberWalk} out={Model.MemberWalk} />

    <Call
        fn="../effects.seedMember"
        in={[
            $in.catalog.build,
            $in.index
        ]}
    />

    <Call
        fn="seed_next"
        in={{
            walk: $in,
            path: $ctx.seedMember
        }}
    />

    <Return value={$ctx.seed_next} />
</Module>
