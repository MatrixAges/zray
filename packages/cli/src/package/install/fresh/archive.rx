<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Archive} out={Installation.ArchiveOutcome} />

    <Call
        fn="../effects.findArchive"
        in={[
            $in.catalog.build,
            $in.members,
            $in.release
        ]}
    />

    <If on={$ctx.findArchive.existing != null}>
        <Return
            value={{
                target: $ctx.findArchive.existing
            }}
        />
    </If>

    <If on={$ctx.findArchive.local}>
        <Call fn="local_source" in={$in} />

        <Call
            module="install_archive"
            in={{
                ...$in.pick([
                    "session",
                    "catalog",
                    "release"
                ]),
                source: $ctx.local_source
            }}
        />

        <Return value={$ctx.install_archive} />
    </If>

    <Call
        module="install_archive"
        in={{
            ...$in.pick([
                "session",
                "catalog",
                "release"
            ]),
            source: $in.release.archive
        }}
    />

    <Return value={$ctx.install_archive} />
</Module>
