<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Archive} out={u64} />

    <Call
        fn="../effects.findArchive"
        in={[
            $in.host,
            $in.members
        ]}
    />

    <If on={$ctx.findArchive.existing != null}>
        <Return value={$ctx.findArchive.existing} />
    </If>

    <If on={$ctx.findArchive.local}>
        <Call fn="../effects.relativeArchive" in={$in.host} />

        <Call
            module="install_archive"
            in={{
                host: $in.host,
                source: $ctx.relativeArchive
            }}
        />

        <Return value={$ctx.install_archive} />
    </If>

    <Call
        module="install_archive"
        in={{
            host: $in.host,
            source: $ctx.findArchive.archive
        }}
    />

    <Return value={$ctx.install_archive} />
</Module>
