import type { Catalog } from "installation_host"
import type { Fresh } from "../model"

export type Closure = Fresh & {
    catalog: Catalog,
    owner: u64,
    consumed: u64,
    count: u64,
    paths: string[],
    running: bool
}

export type Edges = Closure.Omit("maximum_edges", "consumed", "running") & {
    remaining: u64
}

export type Dependency = Edges.Omit("owner") & {
    running: bool
}

export type EdgeResult = {
    consumed: u64,
    count: u64,
    paths: string[]
}
