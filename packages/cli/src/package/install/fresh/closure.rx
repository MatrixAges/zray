<Module>
    <Type from="model" as="Fresh" />

    <Args in={Fresh.Closure} out={Fresh.Closure} />

    <If on={$in.owner >= $in.count}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />
    </If>

    <Call
        module="edges"
        in={{
            ...$in.pick([
                "session",
                "fetch",
                "catalog",
                "root",
                "paths",
                "members",
                "owner",
                "count"
            ]),
            remaining: $in.maximum_edges - $in.consumed
        }}
    />

    <Return
        value={{
            ...$in,
            owner: $in.owner + 1,
            consumed: $in.consumed + $ctx.edges.consumed,
            count: $ctx.edges.count,
            paths: $ctx.edges.paths
        }}
    />
</Module>
