<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Fresh} out={void} />

    <Call fn="../effects.prepareIndex" in={$in.host} />

    <Call
        fn="seed"
        in={$in.pick([
            "host",
            "members"
        ])}
    />

    <Loop on={$in.running}>
        <Call
            module="closure"
            in={{
                ...$in,
                owner: 0,
                consumed: 0,
                running: true
            }}
        />
    </Loop>

    <Call fn="../effects.finishFresh" in={$in.host} />
</Module>
