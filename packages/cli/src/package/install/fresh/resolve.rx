<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Fresh} out={void} />

    <Call fn="../effects.prepareIndex" in={$in.host} />

    <Loop on={$in.index < $in.members}>
        <Call
            module="seed"
            in={{
                host: $in.host,
                members: $in.members,
                index: 0
            }}
        />
    </Loop>

    <Loop on={$in.running}>
        <Call
            module="closure"
            in={{
                ...$in,
                owner: 0,
                consumed: 0,
                count: $in.members,
                running: true
            }}
        />
    </Loop>

    <Call fn="../effects.finishFresh" in={$in.host} />
</Module>
