<Module>
    <Type from="model" as="Fresh" />

    <Args in={Fresh.Edges} out={Fresh.EdgeResult} />

    <Call
        fn="../effects.beginDependencies"
        in={[
            $in.catalog.build,
            $in.owner,
            $in.owner < $in.members
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="dependency"
            in={{
                ...$in.omit(["owner"]),
                running: true
            }}
        />
    </Loop>

    <Call
        fn="../effects.finishDependencies"
        in={[
            $in.catalog.build,
            $in.owner
        ]}
    />

    <Return
        value={{
            consumed: $ctx.finishDependencies,
            count: $ctx.dependency.count,
            paths: $ctx.dependency.paths
        }}
    />
</Module>
