<Module>
    <Type from="model" as="Fresh" />

    <Args in={Fresh.Edges} out={u64} />

    <Call
        fn="../effects.beginDependencies"
        in={[
            $in.host,
            $in.owner,
            $in.owner < $in.members
        ]}
    />

    <Loop on={$in.running}>
        <Call
            module="dependency"
            in={{
                ...$in.omit(["owner"]),
                running: true
            }}
        />
    </Loop>

    <Call
        fn="../effects.finishDependencies"
        in={[
            $in.host,
            $in.owner
        ]}
    />

    <Return value={$ctx.finishDependencies} />
</Module>
