<Module>
    <Type from="model" as="Fresh" />

    <Args in={Fresh.Dependency} out={Fresh.Dependency} />

    <Call
        fn="../effects.advanceDependency"
        in={[
            $in.catalog.build,
            $in.remaining
        ]}
    />

    <If on={$ctx.advanceDependency == null}>
        <Return
            value={{
                ...$in,
                running: false
            }}
        />

        <Else>
            <Call
                module="archive"
                in={{
                    ...$in.pick([
                        "session",
                        "catalog",
                        "root",
                        "members"
                    ]),
                    release: $ctx.advanceDependency
                }}
            />

            <Call
                fn="../effects.acceptArchive"
                in={[
                    $in.catalog.build,
                    $ctx.archive.target
                ]}
            />

            <Call
                fn="next"
                in={{
                    dependency: $in,
                    archive: $ctx.archive
                }}
            />

            <Return value={$ctx.next} />
        </Else>
    </If>
</Module>
