import host from "installation_host"

import type { Fresh } from "../model"

export type Input = Fresh.Pick("host", "members")

export type Output = void

export default function (in: Input): Output {
    const first: u64 = 0

    const traversal = loop({
        row: first
    }, {
        while: current => current.row < in.members,
        next: current => {
            const row = current.row

            host.seedMember(in.host, row)

            current.row += 1
        }
    })
}
