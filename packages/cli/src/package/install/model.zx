import type { Host } from "installation_host"

export enum Status {
    Installed,
    LockFileMissing,
    LockFileOutdated,
    WorkspaceChangedDuringInstall,
    LockChangedDuringInstall,
    PackageInstallationTooLarge
}

export type Input = {
    host: Host,
    members: u64,
    maximum_edges: u64,
    locked_rows: u64,
    root: string,
    has_lock: bool,
    reuse: bool,
    frozen: bool
}

export type Fresh = Input.Pick("host", "members", "maximum_edges")

export type Archive = Fresh.Pick("host", "members")

export type ArchiveSource = {
    host: Host,
    source: string
}

export type Replay = Input.Pick("host", "locked_rows", "root")

export type ReplayPaths = {
    host: Host,
    workspace: string?[],
    root: string
}

export type Publication = Input.Pick("host", "reuse")

export type Result = Status

export type MemberWalk = Fresh.Pick("host", "members") & {
    index: u64
}

export type ReplayWalk = ReplayPaths & {
    index: u64
}
