import type { Catalog, InstallIO, LockData, Release } from "installation_host"

export enum Status {
    Installed,
    LockFileMissing,
    LockFileOutdated,
    WorkspaceChangedDuringInstall,
    LockChangedDuringInstall,
    PackageInstallationTooLarge
}

export type Input = {
    session: InstallIO,
    members: u64,
    maximum_edges: u64,
    maximum_bytes: u64,
    root: string,
    previous?: LockData,
    locked_workspace: string?[],
    reuse: bool,
    frozen: bool
}

export type Fresh = Input.Pick("session", "members", "maximum_edges", "root")

export type Archive = {
    session: InstallIO,
    catalog: Catalog,
    members: u64,
    root: string,
    release: Release
}

export type ArchiveSource = Archive.Pick("session", "catalog", "release") & {
    source: string
}

export type ArchiveOutcome = {
    target: u64,
    path?: string
}

export type Replay = Input.Pick("session", "locked_workspace", "root") & {
    lock: LockData
}

export type Prepared = {
    lock: LockData,
    paths: string[]
}

export type Publication = Input.Pick("session", "reuse", "maximum_bytes") & {
    prepared: Prepared
}

export type Result = {
    status: Status,
    count?: u64
}

export type MemberWalk = Fresh.Pick("members") & {
    catalog: Catalog,
    paths: string[],
    index: u64
}

export type ReplayWalk = Replay & {
    index: u64,
    paths: string[]
}
