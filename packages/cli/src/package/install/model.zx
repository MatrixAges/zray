import type { Catalog, InstallIO, Release } from "installation_host"

export enum Status {
    Installed,
    LockFileMissing,
    LockFileOutdated,
    WorkspaceChangedDuringInstall,
    LockChangedDuringInstall,
    PackageInstallationTooLarge
}

export type Input = {
    session: InstallIO,
    members: u64,
    maximum_edges: u64,
    maximum_bytes: u64,
    root: string,
    has_lock: bool,
    locked_workspace: string?[],
    reuse: bool,
    frozen: bool
}

export type Fresh = {
    session: InstallIO,
    members: u64,
    maximum_edges: u64,
    root: string
}

export type Archive = {
    session: InstallIO,
    catalog: Catalog,
    members: u64,
    root: string,
    release: Release
}

export type ArchiveSource = {
    session: InstallIO,
    catalog: Catalog,
    release: Release,
    source: string
}

export type ArchiveOutcome = {
    target: u64,
    path?: string
}

export type Replay = {
    session: InstallIO,
    locked_workspace: string?[],
    root: string
}

export type Publication = {
    session: InstallIO,
    reuse: bool,
    maximum_bytes: u64,
    paths: string[]
}

export type Result = {
    status: Status,
    count?: u64
}

export type MemberWalk = {
    members: u64,
    catalog: Catalog,
    paths: string[],
    index: u64
}

export type ReplayWalk = Replay & {
    index: u64,
    paths: string[]
}
