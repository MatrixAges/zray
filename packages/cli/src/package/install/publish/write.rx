<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Publication} out={Installation.Result} />

    <Call
        fn="../effects.currentWorkspaceMatches"
        in={[
            $in.session,
            $in.prepared.lock
        ]}
    />

    <If on={!$ctx.currentWorkspaceMatches}>
        <Return
            value={{
                status: Installation.Status.WorkspaceChangedDuringInstall
            }}
        />
    </If>

    <Call
        fn="../effects.renderInstallation"
        in={[
            $in.session,
            $in.prepared.lock,
            $in.prepared.paths
        ]}
    />

    <If
        on={$ctx.renderInstallation.lock.length > $in.maximum_bytes ||
            $ctx.renderInstallation.mapping.length > $in.maximum_bytes}
    >
        <Return
            value={{
                status: Installation.Status.PackageInstallationTooLarge
            }}
        />
    </If>

    <Call
        fn="../effects.publishMapping"
        in={[
            $in.session,
            $ctx.renderInstallation.digest,
            $ctx.renderInstallation.mapping
        ]}
    />

    <If on={$in.reuse}>
        <Call
            fn="../effects.lockUnchanged"
            in={[
                $in.session,
                $ctx.renderInstallation.lock
            ]}
        />

        <If on={!$ctx.lockUnchanged}>
            <Return
                value={{
                    status: Installation.Status.LockChangedDuringInstall
                }}
            />
        </If>

        <Else>
            <Call
                fn="../effects.publishLock"
                in={[
                    $in.session,
                    $ctx.renderInstallation.lock
                ]}
            />
        </Else>
    </If>

    <Return
        value={{
            status: Installation.Status.Installed,
            count: $in.prepared.paths.length
        }}
    />
</Module>
