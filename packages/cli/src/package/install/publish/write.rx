<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Publication} out={Installation.Result} />

    <Call fn="../effects.currentWorkspaceMatches" in={$in.session} />

    <If on={!$ctx.currentWorkspaceMatches}>
        <Return
            value={{
                status: Installation.Status.WorkspaceChangedDuringInstall
            }}
        />
    </If>

    <Call
        fn="../effects.renderInstallation"
        in={[
            $in.session,
            $in.paths
        ]}
    />

    <If
        on={$ctx.renderInstallation.lock.length > $in.maximum_bytes ||
            $ctx.renderInstallation.mapping.length > $in.maximum_bytes}
    >
        <Return
            value={{
                status: Installation.Status.PackageInstallationTooLarge
            }}
        />
    </If>

    <Call
        fn="artifacts"
        in={{
            root: $in.root,
            rendered: $ctx.renderInstallation
        }}
    />

    <Call
        module="../../../workspace_files/write_bytes"
        in={$ctx.artifacts.mapping}
    />

    <If on={$in.reuse}>
        <Call
            fn="../effects.readFile"
            in={{
                path: $ctx.artifacts.lock.path,
                max_bytes: $in.maximum_bytes - 1
            }}
        />

        <Call
            fn="../effects.equals"
            in={[
                $ctx.readFile,
                $ctx.artifacts.lock.data
            ]}
        />

        <If on={!$ctx.equals}>
            <Return
                value={{
                    status: Installation.Status.LockChangedDuringInstall
                }}
            />
        </If>

        <Else>
            <Call
                module="../../../workspace_files/write_bytes"
                in={$ctx.artifacts.lock}
            />
        </Else>
    </If>

    <Return
        value={{
            status: Installation.Status.Installed,
            count: $in.paths.length
        }}
    />
</Module>
