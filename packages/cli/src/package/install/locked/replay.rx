<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Replay} out={void} />

    <Call
        fn="../effects.beginReplay"
        in={[
            $in.host,
            $in.locked_rows
        ]}
    />

    <Call
        fn="paths"
        in={{
            host: $in.host,
            is_archive: $ctx.beginReplay
        }}
    />
</Module>
