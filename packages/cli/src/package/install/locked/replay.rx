<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Replay} out={Installation.Prepared} />

    <Call fn="begin" in={$in} />

    <Loop on={$in.index < $in.locked_workspace.length}>
        <Call module="paths" />
    </Loop>

    <Return
        value={{
            lock: $in.lock,
            paths: $ctx.paths.paths
        }}
    />
</Module>
