<Module>
    <Type from="../model" as="Installation" />

    <Args in={Installation.Replay} out={void} />

    <Call
        fn="../effects.beginReplay"
        in={[
            $in.host,
            $in.locked_rows
        ]}
    />

    <Loop on={$in.index < $in.is_archive.length}>
        <Call
            module="paths"
            in={{
                host: $in.host,
                is_archive: $ctx.beginReplay,
                index: 0
            }}
        />
    </Loop>
</Module>
