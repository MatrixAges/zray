<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ReplayWalk} out={Model.ReplayWalk} />

    <Call
        fn="workspace_path"
        in={{
            root: $in.root,
            relative: $in.workspace[$in.index]
        }}
    />

    <If on={$ctx.workspace_path != null}>
        <Call
            fn="../effects.recordLockedPath"
            in={[
                $in.host,
                $in.index,
                $ctx.workspace_path
            ]}
        />

        <Else>
            <Call
                fn="../effects.fetchLocked"
                in={[
                    $in.host,
                    $in.index
                ]}
            />

            <Call
                fn="../effects.recordLockedPath"
                in={[
                    $in.host,
                    $in.index,
                    $ctx.fetchLocked
                ]}
            />

            <Call
                fn="../effects.verifyLockedManifest"
                in={[
                    $in.host,
                    $in.index,
                    $ctx.recordLockedPath
                ]}
            />
        </Else>
    </If>

    <Return
        value={{
            ...$in,
            index: $in.index + 1
        }}
    />
</Module>
