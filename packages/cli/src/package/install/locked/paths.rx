<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ReplayWalk} out={Model.ReplayWalk} />

    <Call
        fn="workspace_path"
        in={{
            root: $in.root,
            relative: $in.locked_workspace[$in.index]
        }}
    />

    <If on={$ctx.workspace_path != null}>
        <Call
            fn="../effects.canonicalPath"
            in={[
                $in.session,
                $ctx.workspace_path
            ]}
        />

        <Call
            fn="append"
            in={{
                walk: $in,
                path: $ctx.canonicalPath
            }}
        />

        <Return value={$ctx.append} />
    </If>

    <Call
        fn="../effects.fetchLocked"
        in={[
            $in.session,
            $in.lock,
            $in.index
        ]}
    />

    <Call
        fn="../effects.canonicalPath"
        in={[
            $in.session,
            $ctx.fetchLocked
        ]}
    />

    <Call
        fn="../effects.verifyLockedManifest"
        in={[
            $in.session,
            $in.lock,
            $in.index,
            $ctx.canonicalPath
        ]}
    />

    <Call
        fn="append"
        in={{
            walk: $in,
            path: $ctx.canonicalPath
        }}
    />

    <Return value={$ctx.append} />
</Module>
