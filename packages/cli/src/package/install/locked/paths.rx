<Module>
    <Type from="../model" as="Model" />

    <Args in={Model.ReplayWalk} out={Model.ReplayWalk} />

    <Call
        fn="workspace_path"
        in={{
            root: $in.root,
            relative: $in.locked_workspace[$in.index]
        }}
    />

    <If on={$ctx.workspace_path != null}>
        <Call fn="../effects.realpath" in={$ctx.workspace_path} />

        <Call
            fn="append"
            in={{
                walk: $in,
                path: $ctx.realpath
            }}
        />

        <Return value={$ctx.append} />
    </If>

    <Call
        fn="release"
        in={{
            archives: $in.locked_archives,
            row: $in.index
        }}
    />

    <Call
        fn="../effects.fetchArchive"
        in={[
            $in.session,
            $ctx.release.archive,
            $ctx.release
        ]}
    />

    <Call fn="../effects.realpath" />

    <Call
        fn="../effects.verifyLockedManifest"
        in={[
            $in.session,
            $in.index,
            $ctx.realpath
        ]}
    />

    <Call
        fn="append"
        in={{
            walk: $in,
            path: $ctx.realpath
        }}
    />

    <Return value={$ctx.append} />
</Module>
