<Module>
    <Type from="model" as="Installation" />

    <Args in={Installation.Input} out={Installation.Result} />

    <If on={$in.reuse && $in.has_lock}>
        <Call
            module="locked/replay"
            in={$in.pick([
                "session",
                "fetch",
                "locked_workspace",
                "locked_archives",
                "root"
            ])}
        />

        <Call
            module="publish/write"
            in={{
                ...$in.pick([
                    "session",
                    "root",
                    "reuse",
                    "maximum_bytes"
                ]),
                paths: $ctx.replay
            }}
        />

        <Return value={$ctx.write} />
    </If>

    <If on={$in.frozen}>
        <Call fn="frozen" in={$in.has_lock} />

        <Return
            value={{
                status: $ctx.frozen
            }}
        />
    </If>

    <Call
        module="fresh/resolve"
        in={$in.pick([
            "session",
            "fetch",
            "members",
            "maximum_edges",
            "root"
        ])}
    />

    <Call
        module="publish/write"
        in={{
            ...$in.pick([
                "session",
                "root",
                "reuse",
                "maximum_bytes"
            ]),
            paths: $ctx.resolve
        }}
    />

    <Return value={$ctx.write} />
</Module>
