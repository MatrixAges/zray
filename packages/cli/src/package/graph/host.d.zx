export type GraphIO = opaque
export enum WorkspaceStatus {
    Valid,
    Duplicate,
    InvalidSpecifier,
    Missing,
    InvalidRange,
    InvalidVersion,
    Overflow,
    LockVersionMismatch,
    CyclicPackageDependencies,
    PackageDependencyDepthExceeded
}

export type Mapping = {
    version: u32,
    digest: string,
    expected: string,
    paths: string[],
    is_archive: bool[],
    sources: string[],
    root: string
}

export type AssemblyOutcome = {
    status: WorkspaceStatus,
    failed_owner: u64,
    owner_path: string,
    owner_name: string,
    edge_name: string
}

export declare function openLock(allocator, graph: GraphIO, root: string): bool?
    throws { PackageGraphHostFailure }

export declare function openMapping(allocator, graph: GraphIO, root: string): Mapping?
    throws { PackageGraphHostFailure }

export declare function canonical(allocator, graph: GraphIO, path: string): string
    throws { PackageGraphHostFailure }

export declare function verifyReceipt(allocator, graph: GraphIO, directory: string, digest: string): void
    throws { PackageGraphHostFailure }

export declare function readInstalledArchive(allocator, graph: GraphIO, row: u64, path: string): bool
    throws { PackageGraphHostFailure }

export declare function matchWorkspaceMember(graph: GraphIO, ordinal: u64, relative: string): u64?

export declare function assembleWorkspace(
    allocator,
    graph: GraphIO,
    root: string,
    counts: u64[],
    firsts: u64[],
    total: u64
): AssemblyOutcome throws { PackageGraphHostFailure }
