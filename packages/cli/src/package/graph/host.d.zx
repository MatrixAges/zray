export type GraphIO = opaque
export type LockFile = opaque
export type PackageManifest = opaque
export type WorkspaceGraph = opaque

export type LoadedLock = {
    lock: LockFile,
    matches: bool
}

export enum WorkspaceStatus {
    Valid,
    Duplicate,
    InvalidSpecifier,
    Missing,
    InvalidRange,
    InvalidVersion,
    Overflow,
    LockVersionMismatch,
    CyclicPackageDependencies,
    PackageDependencyDepthExceeded
}

export type Mapping = {
    version: u32,
    digest: string,
    expected: string,
    paths: string[],
    is_archive: bool[],
    sources: string[],
    root: string
}

export type AssemblyOutcome = {
    workspace: WorkspaceGraph,
    status: WorkspaceStatus,
    failed_owner: u64,
    owner_path: string,
    owner_name: string,
    edge_name: string
}

export declare function openLock(allocator, graph: GraphIO, root: string): LoadedLock?
    throws { PackageGraphHostFailure }

export declare function openMapping(allocator, graph: GraphIO, root: string, lock: LockFile): Mapping?
    throws { PackageGraphHostFailure }

export declare function canonical(allocator, graph: GraphIO, path: string): string
    throws { PackageGraphHostFailure }

export declare function verifyReceipt(allocator, graph: GraphIO, directory: string, digest: string): void
    throws { PackageGraphHostFailure }

export declare function readInstalledArchive(allocator, graph: GraphIO, lock: LockFile, row: u64, path: string): PackageManifest?
    throws { PackageGraphHostFailure }

export declare function borrowMember(graph: GraphIO, ordinal: u64, relative: string): PackageManifest?

export declare function assembleWorkspace(
    allocator,
    graph: GraphIO,
    root: string,
    counts: u64[],
    firsts: u64[],
    total: u64
): AssemblyOutcome throws { PackageGraphHostFailure }
