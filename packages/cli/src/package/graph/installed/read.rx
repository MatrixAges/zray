<Module>
    <Type from="../model" as="Project" />

    <Args in={Project.Installed} out={Project.Result} />

    <Call
        fn="../effects.openLock"
        in={[
            $in.graph,
            $in.root
        ]}
    />

    <If on={$ctx.openLock == null}>
        <Return
            value={{
                status: Project.Status.PackagesNotInstalled
            }}
        />

        <Else>
            <If on={!$ctx.openLock}>
                <Return
                    value={{
                        status: Project.Status.LockFileOutdated
                    }}
                />
            </If>

            <Call
                fn="../effects.openMapping"
                in={[
                    $in.graph,
                    $in.root
                ]}
            />

            <If on={$ctx.openMapping != null}>
                <Call
                    module="loaded"
                    in={{
                        ...$in.omit(["root"]),
                        mapping: $ctx.openMapping
                    }}
                />

                <Return value={$ctx.loaded} />
            </If>

            <Return
                value={{
                    status: Project.Status.PackagesNotInstalled
                }}
            />
        </Else>
    </If>
</Module>
