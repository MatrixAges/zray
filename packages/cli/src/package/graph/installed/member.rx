<Module>
    <Type from="../model" as="Project" />
    <Type from="member_path" as="Member" />

    <Args in={Member.Input} out={Project.RowResult} />

    <Call fn="member_path" in={$in} />

    <Call
        fn="../effects.canonical"
        in={[
            $in.graph,
            $ctx.member_path
        ]}
    />

    <Call
        fn="find_member"
        in={$in.omit([
            "graph",
            "root"
        ])}
    />

    <If on={$ctx.find_member == null}>
        <Return
            value={{
                status: Project.Status.LockFileOutdated
            }}
        />

        <Else>
            <Return
                value={{
                    status: Project.Status.Valid,
                    row: {
                        path: $ctx.canonical,
                        member: $ctx.find_member
                    }
                }}
            />
        </Else>
    </If>
</Module>
