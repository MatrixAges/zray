import path from "std:path"

import { mapping_version } from "../const"

import type { Mapping as Input } from "package_graph_host"

export type Output = bool

export default function (in: Input): Output {
    const matches_version = in.version == mapping_version
    const matches_digest = in.digest == in.expected
    const matches_count = in.paths.length == in.is_archive.length

    const valid = (
        - matches_version
        - and matches_digest
        - and matches_count
    )

    return valid && in.paths.every(item => path.isAbsolute(item))
}
