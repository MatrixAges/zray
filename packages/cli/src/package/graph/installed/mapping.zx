import host from "package_graph_host"

import { mapping_version } from "../const"

import type { Host as Input } from "package_graph_host"

export type Output = bool

export default function (in: Input): Output {
    const paths = host.mappedPaths(in)
    const version = host.mappingVersion(in)
    const digest = host.mappingDigest(in)
    const expected = host.expectedDigest(in)
    const count = host.lockedCount(in)

    const valid = (
        - version == mapping_version
        - and digest == expected
        - and paths.length == count
    )

    return valid && paths.every(path => host.isAbsolute(path))
}
