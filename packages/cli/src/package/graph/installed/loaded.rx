<Module>
    <Type from="../model" as="Project" />

    <Args in={Project.InstalledLoaded} out={Project.Result} />

    <Call fn="mapping" in={$in.mapping} />

    <If on={!$ctx.mapping}>
        <Return
            value={{
                status: Project.Status.InvalidPackageInstallation
            }}
        />
    </If>

    <Call fn="begin" in={$in} />

    <Loop
        on={$in.status == Project.Status.Valid && $in.index < $in.mapping.paths.length}
    >
        <Call module="step" />
    </Loop>

    <If on={$ctx.step.status != Project.Status.Valid}>
        <Return
            value={{
                status: $ctx.step.status
            }}
        />
    </If>

    <Return
        value={{
            status: Project.Status.Valid,
            installed: {
                lock: $in.lock,
                rows: $ctx.step.rows
            }
        }}
    />
</Module>
