import path from "std:path"
import host from "package_graph_host"

import { archive_directory } from "../const"
import { Status } from "../model"

import type { Row as Input, Result as Output } from "../model"

export default function (in: Input): Output {
    const parent = path.dirname(in.path)
    const leaf = path.basename(in.path)
    const directory = path.basename(parent)
    const wrong_parent = parent == in.path
    const wrong_leaf = leaf != archive_directory
    const wrong_digest = directory != in.digest

    const invalid_layout = (
        - wrong_parent
        - or wrong_leaf
        - or wrong_digest
    )

    if (invalid_layout) {
        return Status.InvalidPackageInstallation
    }

    const canonical = host.canonical(in.host, in.path)

    if (canonical != in.path) {
        return Status.InvalidPackageInstallation
    }

    host.verifyReceipt(in.host, parent, in.digest)

    if (!host.readInstalledArchive(in.host, in.row, canonical)) {
        return Status.InstalledManifestDoesNotMatchLock
    }

    host.recordInstalledArchive(in.host, in.row, canonical)

    return Status.Valid
}
