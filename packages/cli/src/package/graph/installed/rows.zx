import { resolvePathParts } from "lexical_path"
import host from "package_graph_host"

import { Status } from "../model"
import archive from "./archive"

import type { InstalledLoaded as Input, Result as Output } from "../model"

export default function (in: Input): Output {
    return loop({
        row: 0,
        ordinal: 0,
        status: Status.Valid
    }, {
        while: state =>
            state.status == Status.Valid && state.row < in.mapping.is_archive.length,
        next: state => {
            const row = state.row

            if (in.mapping.is_archive[row]) {
                state.status = archive({
                    host: in.host,
                    row,
                    path: in.mapping.paths[row],
                    digest: in.mapping.sources[row]
                })
            } else {
                const logical = resolvePathParts([
                    in.mapping.root,
                    in.mapping.sources[row]
                ])
                const path = host.canonical(in.host, logical)

                if (host.recordMember(in.host, row, state.ordinal, path)) {
                    state.ordinal += 1
                } else {
                    state.status = Status.LockFileOutdated
                }
            }

            state.row += 1
        },
        return: state => state.status
    })
}
