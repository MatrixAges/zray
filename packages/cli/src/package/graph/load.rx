<Module>
    <Type from="model" as="Project" />

    <Args in={Project.Input} out={Project.Result} />

    <If on={$in.external}>
        <Call
            module="installed/read"
            in={$in.pick([
                "graph",
                "member_paths",
                "member_count",
                "root"
            ])}
        />

        <If on={$ctx.read.status == Project.Status.PackagesNotInstalled}>
            <Call
                fn="missing"
                in={$in.pick([
                    "missing_path",
                    "missing_name"
                ])}
            />

            <Return
                value={{
                    status: $ctx.read.status,
                    diagnostic: $ctx.missing
                }}
            />
        </If>

        <Return value={$ctx.read} />

        <Else>
            <Call
                module="workspace/read"
                in={$in.omit([
                    "external",
                    "missing_path",
                    "missing_name"
                ])}
            />

            <Return value={$ctx.read} />
        </Else>
    </If>
</Module>
