import host from "package_graph_host"
import { WorkspaceStatus } from "package_graph_host"

import { Status } from "../model"
import diagnostic from "./diagnostic"

import type { Workspace as Input, Result as Output } from "../model"

export default function (in: Input): Output {
    const status = host.assembleWorkspace(in.host, WorkspaceStatus.Valid)

    return match status {
        WorkspaceStatus.Valid => Status.Valid,
        _ => diagnostic({
            ...in,
            status
        })
    }
}
