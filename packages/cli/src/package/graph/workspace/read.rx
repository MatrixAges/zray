<Module>
    <Type from="../model" as="Project" />
    <Type from="diagnostic" as="Assembly" />

    <Args in={Project.Workspace} out={Project.Result} />

    <Call
        fn="offsets"
        in={$in.pick([
            "declarations",
            "member_count"
        ])}
    />

    <Call
        fn="../effects.assembleWorkspace"
        in={[
            $in.graph,
            $in.root,
            $ctx.offsets.counts,
            $ctx.offsets.firsts,
            $ctx.offsets.total
        ]}
    />

    <If on={$ctx.assembleWorkspace.status == Assembly.WorkspaceStatus.Valid}>
        <Return
            value={{
                status: Project.Status.Valid
            }}
        />
    </If>

    <Call
        fn="diagnostic"
        in={{
            assembly: $ctx.assembleWorkspace,
            paths: $in.member_paths,
            declarations: $in.declarations
        }}
    />

    <Return value={$ctx.diagnostic} />
</Module>
