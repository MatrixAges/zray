<Module>
    <Type from="../model" as="Project" />

    <Args in={Project.Workspace} out={Project.Result} />

    <Call fn="../effects.prepareWorkspace" in={$in.host} />

    <Loop on={$in.index < $in.edge_counts.length}>
        <Call
            module="seed"
            in={{
                host: $in.host,
                edge_counts: $ctx.prepareWorkspace,
                index: 0,
                first: 0
            }}
        />
    </Loop>

    <Call fn="assemble" in={$in} />

    <Return value={$ctx.assemble} />
</Module>
