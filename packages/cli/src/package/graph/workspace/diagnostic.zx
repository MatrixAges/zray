import memory from "memory"
import { WorkspaceStatus } from "package_graph_host"

import {
    cyclic_dependencies,
    dependency_depth,
    duplicate_dependency,
    invalid_range,
    invalid_specifier,
    missing_dependency,
    version_mismatch
} from "../const"
import { Status } from "../model"

import type { TextColumn } from "memory"
import type { AssemblyOutcome } from "package_graph_host"
import type { Declarations, Result as Output } from "../model"

export { WorkspaceStatus } from "package_graph_host"

export type Input = {
    assembly: AssemblyOutcome,
    paths: TextColumn,
    declarations: Declarations
}

export default function (in: Input): Output {
    const { status, owner, edge } = in.assembly

    const package_issue = match status {
        WorkspaceStatus.CyclicPackageDependencies => cyclic_dependencies,
        WorkspaceStatus.PackageDependencyDepthExceeded => dependency_depth,
        _ => ""
    }

    if (package_issue != "") {
        const owner_path = memory.readTextColumn(in.paths, owner)
        const owner_name = memory.readTextColumn(in.declarations.names, owner)

        return {
            status: Status.InvalidPackageGraph,
            diagnostic:
                `${owner_path}/pkg.yaml: dependency ${owner_name}: ${package_issue}`
        }
    }

    const message = match status {
        WorkspaceStatus.Duplicate => duplicate_dependency,
        WorkspaceStatus.InvalidSpecifier => invalid_specifier,
        WorkspaceStatus.Missing => missing_dependency,
        WorkspaceStatus.InvalidRange => invalid_range,
        WorkspaceStatus.LockVersionMismatch => version_mismatch,
        _ => ""
    }

    if (message != "") {
        const owner_path = memory.readTextColumn(in.paths, owner)
        const production = in.declarations.production
        const count = memory.listLength(production, owner)

        const edge_name = match {
            edge < count => memory.readListText(production, owner, edge),
            _ => memory.readListText(in.declarations.development, owner, edge - count)
        }

        return {
            status: Status.InvalidPackageGraph,
            keep_rows: owner,
            diagnostic: `${owner_path}/pkg.yaml: dependency ${edge_name}: ${message}`
        }
    }

    return {
        status: match status {
            WorkspaceStatus.InvalidVersion => Status.InvalidVersion,
            WorkspaceStatus.Overflow => Status.Overflow,
            _ => Status.InvalidPackageGraph
        },
        keep_rows: owner
    }
}
