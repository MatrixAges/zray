import { WorkspaceStatus } from "package_graph_host"

import {
    cyclic_dependencies,
    dependency_depth,
    duplicate_dependency,
    invalid_range,
    invalid_specifier,
    missing_dependency,
    version_mismatch
} from "../const"
import { Status } from "../model"

import type { AssemblyOutcome as Input } from "package_graph_host"
import type { Result as Output } from "../model"

export { WorkspaceStatus } from "package_graph_host"

export default function (in: Input): Output {
    const { workspace, status, failed_owner, owner_path, owner_name, edge_name } = in

    const package_issue = match status {
        WorkspaceStatus.CyclicPackageDependencies => cyclic_dependencies,
        WorkspaceStatus.PackageDependencyDepthExceeded => dependency_depth,
        _ => ""
    }

    if (package_issue != "") {
        return {
            status: Status.InvalidPackageGraph,
            workspace,
            diagnostic:
                `${owner_path}/pkg.yaml: dependency ${owner_name}: ${package_issue}`
        }
    }

    const message = match status {
        WorkspaceStatus.Duplicate => duplicate_dependency,
        WorkspaceStatus.InvalidSpecifier => invalid_specifier,
        WorkspaceStatus.Missing => missing_dependency,
        WorkspaceStatus.InvalidRange => invalid_range,
        WorkspaceStatus.LockVersionMismatch => version_mismatch,
        _ => ""
    }

    const diagnostic: string? = match {
        message == "" => null,
        _ => `${owner_path}/pkg.yaml: dependency ${edge_name}: ${message}`
    }

    return {
        status: match status {
            WorkspaceStatus.InvalidVersion => Status.InvalidVersion,
            WorkspaceStatus.Overflow => Status.Overflow,
            _ => Status.InvalidPackageGraph
        },
        workspace,
        keep_rows: failed_owner,
        diagnostic
    }
}
