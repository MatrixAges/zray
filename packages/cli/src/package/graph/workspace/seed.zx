import host from "package_graph_host"

import type { SeedInput as Input } from "../model"

export type Output = void

export default function (in: Input): Output {
    const traversal = loop({
        row: 0,
        first: 0
    }, {
        while: state => state.row < in.edge_counts.length,
        next: state => {
            const length = in.edge_counts[state.row]

            host.seedLocal(in.host, state.row, state.first, length)

            state.first += length
            state.row += 1
        }
    })
}
