export type Input = u64[]

export type Output = {
    firsts: u64[],
    total: u64
}

export default function (in: Input): Output {
    const empty: u64[] = []

    return loop({
        row: 0,
        firsts: empty,
        total: 0
    }, {
        while: state => state.row < in.length,
        next: state => {
            state.firsts = state.firsts.push(state.total)[0]
            state.total += in[state.row]
            state.row += 1
        },
        return: state => state.omit(["row"])
    })
}
