import type { GraphIO, Mapping } from "package_graph_host"

export enum Status {
    Valid,
    PackagesNotInstalled,
    LockFileOutdated,
    InvalidPackageInstallation,
    InstalledManifestDoesNotMatchLock,
    InvalidPackageGraph,
    InvalidVersion,
    Overflow
}

export type Read = {
    graph: GraphIO,
    root: string
}

export type Input = Read & {
    external: bool,
    missing_path: string,
    missing_name: string,
    counts: u64[]
}

export type Workspace = Read & {
    counts: u64[]
}

export type InstalledRow = {
    path: string,
    member?: u64
}

export type Result = {
    status: Status,
    diagnostic?: string,
    keep_rows?: u64,
    installed?: InstalledRow[]
}

export type InstalledLoaded = {
    graph: GraphIO,
    mapping: Mapping
}

export type InstalledWalk = InstalledLoaded & {
    index: u64,
    ordinal: u64,
    rows: InstalledRow[],
    status: Status
}

export type Archive = {
    graph: GraphIO,
    index: u64,
    path: string,
    digest: string
}

export type RowResult = {
    status: Status,
    row?: InstalledRow
}
