import type { ListColumn, TextColumn } from "memory"
import type { GraphIO, Mapping } from "package_graph_host"

export enum Status {
    Valid,
    PackagesNotInstalled,
    LockFileOutdated,
    InvalidPackageInstallation,
    InstalledManifestDoesNotMatchLock,
    InvalidPackageGraph,
    InvalidVersion,
    Overflow
}

export type Read = {
    graph: GraphIO,
    root: string
}

export type Members = {
    member_paths: TextColumn,
    member_count: u64
}

export type Installed = Read & Members

export type Declarations = {
    names: TextColumn,
    production: ListColumn,
    development: ListColumn
}

export type Input = Workspace & {
    external: bool,
    missing_path: string,
    missing_name: string
}

export type Workspace = Installed & {
    declarations: Declarations
}

export type InstalledRow = {
    path: string,
    member?: u64
}

export type Result = {
    status: Status,
    diagnostic?: string,
    keep_rows?: u64,
    installed?: InstalledRow[]
}

export type InstalledLoaded = Members & {
    graph: GraphIO,
    mapping: Mapping
}

export type InstalledWalk = InstalledLoaded & {
    index: u64,
    ordinal: u64,
    rows: InstalledRow[],
    status: Status
}

export type Archive = {
    graph: GraphIO,
    index: u64,
    path: string,
    digest: string
}

export type RowResult = {
    status: Status,
    row?: InstalledRow
}
