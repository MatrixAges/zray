import type { Host, Mapping } from "package_graph_host"

export enum Status {
    Valid,
    PackagesNotInstalled,
    LockFileOutdated,
    InvalidPackageInstallation,
    InstalledManifestDoesNotMatchLock,
    InvalidPackageGraph,
    InvalidVersion,
    Overflow
}

export type Input = {
    host: Host,
    external: bool,
    count: u64
}

export type Workspace = Input.Pick("host", "count")

export type SeedInput = {
    host: Host,
    edge_counts: u64[]
}

export type InstalledLoaded = {
    host: Host,
    mapping: Mapping
}

export type InstalledHost = Host

export type Row = {
    host: Host,
    row: u64,
    path: string,
    digest: string
}

export type Result = Status

export type SeedWalk = SeedInput & {
    index: u64,
    first: u64
}
