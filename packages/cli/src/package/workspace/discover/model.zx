import type { Project } from "package_workspace_host"

export type SearchInput = {
    search: Project,
    directory: string
}

export type Cursor = SearchInput & {
    has_nearest: bool,
    progress: Progress,
    running: bool
}

export enum Progress {
    Advance,
    Retained,
    Stop,
    Current,
    Nearest,
    Ancestor
}
