<Module>
    <Type from="index" as="IO" />
    <Type from="decision" as="Choice" />
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Cursor} out={Workspace.Progress} />

    <Call fn="../paths/manifest" in={$in.directory} />

    <Call
        fn="index.readCandidate"
        in={[
            $in.search,
            $ctx.manifest,
            $in.progress == Workspace.Progress.Retained
        ]}
    />

    <If on={$ctx.readCandidate == IO.Probe.Invalid}>
        <Return value={Workspace.Progress.Stop} />
    </If>

    <If on={$ctx.readCandidate == IO.Probe.Missing}>
        <Return value={Workspace.Progress.Advance} />
    </If>

    <Call
        fn="decision"
        in={{
            has_nearest: $in.has_nearest,
            has_workspace: $ctx.readCandidate == IO.Probe.Workspace
        }}
    />

    <If on={$ctx.decision == Choice.Decision.Remember}>
        <Return value={Workspace.Progress.Retained} />
    </If>

    <If on={$ctx.decision == Choice.Decision.Select}>
        <Return value={Workspace.Progress.Current} />
    </If>

    <If on={$ctx.decision == Choice.Decision.Inspect}>
        <Call
            module="ancestor"
            in={$in.pick([
                "search",
                "directory"
            ])}
        />

        <Return value={$ctx.ancestor} />
    </If>

    <Return value={Workspace.Progress.Advance} />
</Module>
