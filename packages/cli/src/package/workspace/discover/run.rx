<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Search} out={void} />

    <Call fn="index.startSearch" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="search"
            in={{
                search: $in,
                complete: false,
                running: true
            }}
        />
    </Loop>

    <If on={!$ctx.search.complete}>
        <Call fn="index.selectNearest" in={$in} />
    </If>
</Module>
