<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Search} out={void} />

    <Call fn="index.startSearch" in={$in} />

    <Loop on={$in.running}>
        <Call
            module="search"
            in={{
                search: $in,
                directory: $ctx.startSearch,
                has_nearest: false,
                complete: false,
                running: true
            }}
        />
    </Loop>

    <If on={!$ctx.search.complete && $ctx.search.has_nearest}>
        <Call
            fn="index.selectCandidate"
            in={[
                $in,
                true
            ]}
        />
    </If>
</Module>
