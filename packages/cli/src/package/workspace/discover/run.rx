<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.SearchInput} out={Workspace.Progress} />

    <Loop on={$in.running}>
        <Call
            module="search"
            in={{
                ...$in,
                has_nearest: false,
                progress: Workspace.Progress.Advance,
                running: true
            }}
        />
    </Loop>

    <If
        on={$ctx.search.progress == Workspace.Progress.Advance ||
            $ctx.search.progress == Workspace.Progress.Retained}
    >
        <If on={$ctx.search.has_nearest}>
            <Return value={Workspace.Progress.Nearest} />
        </If>

        <Return value={Workspace.Progress.Advance} />
    </If>

    <Return value={$ctx.search.progress} />
</Module>
