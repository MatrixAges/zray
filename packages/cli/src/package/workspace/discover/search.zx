import { moveParent } from "package_workspace_host"

import step from "./step.rx"

import type { Search as Input } from "package_workspace_host"

export type Output = bool

export default function (in: Input): Output {
    return loop({
        active: true,
        complete: false
    }, {
        while: state => state.active,
        next: state => {
            state.complete = step(in)
            state.active = !state.complete && moveParent(in)
        },
        return: state => state.complete
    })
}
