<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Cursor.Pick("search", "directory")} out={bool} />

    <Call
        fn="index.loadAncestor"
        in={[
            $in.search,
            $in.directory
        ]}
    />

    <If on={$ctx.loadAncestor != null}>
        <Call fn="member" in={$ctx.loadAncestor} />

        <If on={$ctx.member}>
            <Call fn="index.selectAncestor" in={$in.search} />
        </If>

        <Return value={$ctx.member} />
    </If>

    <Return value={true} />
</Module>
