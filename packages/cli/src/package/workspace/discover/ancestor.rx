<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Cursor.Pick("search", "directory")} out={Workspace.Progress} />

    <Call
        fn="index.loadAncestor"
        in={[
            $in.search,
            $in.directory
        ]}
    />

    <If on={$ctx.loadAncestor != null}>
        <Call fn="member" in={$ctx.loadAncestor} />

        <If on={$ctx.member}>
            <Return value={Workspace.Progress.Ancestor} />
        </If>

        <Return value={Workspace.Progress.Advance} />
    </If>

    <Return value={Workspace.Progress.Stop} />
</Module>
