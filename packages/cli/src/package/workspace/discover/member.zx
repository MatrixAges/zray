import { workspacePackagePath } from "package_workspace_host"

import type { MemberSearch } from "package_workspace_host"

export type Input = MemberSearch

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        found: false
    }, {
        while: state => state.row < in.count && !state.found,
        next: state => {
            state.found = workspacePackagePath(in.search, state.row) == in.target
            state.row += 1
        },
        return: state => state.found
    })
}
