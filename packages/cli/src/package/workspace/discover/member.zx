import memory from "memory"

import type { TextColumn } from "memory"

export type Input = {
    paths: TextColumn,
    count: u64,
    target: string
}

export type Output = bool

export default function (in: Input): Output {
    return loop({
        row: 0,
        found: false
    }, {
        while: state => state.row < in.count && !state.found,
        next: state => {
            state.found = memory.readTextColumn(in.paths, state.row) == in.target
            state.row += 1
        },
        return: state => state.found
    })
}
