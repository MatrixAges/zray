<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Cursor} out={Workspace.Cursor} />

    <Call module="step" in={$in} />

    <If on={$ctx.step == Workspace.Progress.Stop}>
        <Return
            value={{
                ...$in,
                complete: true,
                running: false
            }}
        />
    </If>

    <Call fn="index.discardCandidates" in={$in.search} />
    <Call fn="../paths/parent" in={$in.directory} />

    <If on={$ctx.parent != null}>
        <Return
            value={{
                ...$in,
                directory: $ctx.parent,
                has_nearest: $in.has_nearest || $ctx.step == Workspace.Progress.Retained
            }}
        />
    </If>

    <Return
        value={{
            ...$in,
            has_nearest: $in.has_nearest || $ctx.step == Workspace.Progress.Retained,
            running: false
        }}
    />
</Module>
