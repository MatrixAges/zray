<Module>
    <Type from="model" as="Workspace" />

    <Args
        in={Workspace.Patterns & {
            path: string
        }}
        out={string[]}
    />

    <Store from="state" as="state" />

    <Call fn="../../../standard/path/basename" in={$in.path} />

    <Call
        module="../choose"
        in={{
            patterns: $in.patterns,
            path: $in.path,
            name: $ctx.basename
        }}
    />

    <If on={$ctx.choose.included}>
        <Call
            fn="record_path"
            in={{
                discovered: $store.state.discovered,
                path: $in.path
            }}
            setter={[$store.state.discovered]}
        />
    </If>

    <If on={$ctx.choose.descendants}>
        <Call
            fn="index.listWorkspaceDirectories"
            in={[
                $in.collection,
                $in.path
            ]}
        />

        <Return value={$ctx.listWorkspaceDirectories} />
    </If>

    <Return value={[]} />
</Module>
