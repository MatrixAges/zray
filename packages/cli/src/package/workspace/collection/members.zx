import member from "./member.rx"

import type { Members as Input } from "./model"

export type Output = void

export default function (in: Input): Output {
    const visited = loop(0, {
        while: index => index < in.count,
        next: index => {
            member({
                collection: in.collection,
                index
            })

            index += 1
        }
    })
}
