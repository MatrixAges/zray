<Module>
    <Type from="index" as="IO" />

    <Args in={IO.Collection} out={void} />

    <Call fn="index.readRoot" in={$in} />

    <If on={$ctx.readRoot.length > 0}>
        <Call fn="../glob/invalid" in={$ctx.readRoot} />

        <If on={$ctx.invalid != null}>
            <Call
                fn="index.invalidPattern"
                in={[
                    $in,
                    $ctx.readRoot[$ctx.invalid]
                ]}
            />
        </If>

        <Call fn="index.openDirectory" in={$in} />

        <Call
            module="walk"
            while="running"
            in={{
                collection: $in,
                patterns: $ctx.readRoot,
                running: true
            }}
        />

        <Call fn="index.orderMembers" in={$in} />

        <Call
            module="members"
            while="running"
            in={{
                collection: $in,
                count: $ctx.orderMembers,
                index: 0,
                running: $ctx.orderMembers != 0
            }}
        />
    </If>
</Module>
