<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Input} out={Workspace.Output} />

    <Store from="state" as="state" />

    <If on={$in.patterns.length > 0}>
        <Call fn="../glob/invalid" in={$in.patterns} />

        <If on={$ctx.invalid != null}>
            <Call
                fn="invalid_pattern"
                in={{
                    path: $in.path,
                    pattern: $in.patterns[$ctx.invalid]
                }}
            />

            <Return
                value={{
                    paths: [],
                    rows: [],
                    diagnostic: $ctx.invalid_pattern
                }}
            />
        </If>

        <Call
            fn="seed_seen"
            in={{
                seen: $store.state.seen,
                root_name: $in.root_name
            }}
            setter={[$store.state.seen]}
        />

        <Call
            fn="index.listWorkspaceDirectories"
            in={[
                $in.collection,
                ""
            ]}
        />

        <Call
            fn="queue"
            in={{
                stack: [],
                children: $ctx.listWorkspaceDirectories
            }}
        />

        <Loop on={$in.pending.length != 0}>
            <Call
                module="walk"
                in={{
                    collection: $in.collection,
                    patterns: $in.patterns,
                    pending: $ctx.queue
                }}
            />
        </Loop>

        <Call fn="sort_paths" in={$store.state.discovered} />

        <Loop on={$in.running}>
            <Call
                module="members"
                in={{
                    collection: $in.collection,
                    paths: $ctx.sort_paths,
                    index: 0,
                    running: $ctx.sort_paths.length != 0
                }}
            />
        </Loop>

        <Call fn="result" in={$store.state.accepted} />

        <Return
            value={{
                ...$ctx.result,
                diagnostic: $ctx.members.diagnostic
            }}
        />
    </If>

    <Return
        value={{
            paths: [],
            rows: []
        }}
    />
</Module>
