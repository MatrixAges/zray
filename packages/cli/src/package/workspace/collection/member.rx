<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Member} out={string?} />

    <Store from="state" as="state" />

    <Call
        fn="index.readMember"
        in={[
            $in.collection,
            $in.path
        ]}
    />

    <If on={$ctx.readMember != null}>
        <Call
            fn="register_name"
            in={{
                seen: $store.state.seen,
                name: $ctx.readMember.name,
                location: $in.path
            }}
            setter={[$store.state.seen]}
        />

        <If on={$ctx.register_name != null}>
            <Call
                fn="duplicate_member"
                in={{
                    path: $ctx.readMember.path,
                    name: $ctx.readMember.name,
                    first: $ctx.register_name
                }}
            />

            <Return value={$ctx.duplicate_member} />
        </If>

        <Call fn="../paths/portable" in={$in.path} />

        <Call
            fn="accept_member"
            in={{
                accepted: $store.state.accepted,
                path: $ctx.portable,
                row: $ctx.readMember.row
            }}
            setter={[$store.state.accepted]}
        />
    </If>

    <Return value={null} />
</Module>
