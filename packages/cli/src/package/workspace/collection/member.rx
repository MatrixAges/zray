<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Member} out={void} />

    <Store from="state" as="state" />

    <Call
        fn="index.readMember"
        in={[
            $in.collection,
            $in.path
        ]}
    />

    <If on={$ctx.readMember != null}>
        <Call
            fn="register_name"
            in={{
                seen: store.state.seen,
                name: $ctx.readMember,
                location: $in.path
            }}
            setter={[store.state.seen]}
        />

        <If on={$ctx.register_name != null}>
            <Call
                fn="index.duplicateMember"
                in={[
                    $in.collection,
                    $ctx.register_name
                ]}
            />
        </If>

        <Call fn="../paths/portable" in={$in.path} />

        <Call
            fn="index.publishMember"
            in={[
                $in.collection,
                $ctx.portable
            ]}
        />
    </If>
</Module>
