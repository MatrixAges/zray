<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Directories} out={Workspace.Directories} />

    <Call
        module="visit"
        in={{
            ...$in.omit(["pending"]),
            path: $in.pending[$in.pending.length - 1]
        }}
    />

    <Call
        fn="next_directory"
        in={{
            ...$in,
            children: $ctx.visit
        }}
    />

    <Return value={$ctx.next_directory} />
</Module>
