<Module>
    <Type from="model" as="Workspace" />

    <Args in={Workspace.Members} out={Workspace.Members} />

    <Call
        module="member"
        in={{
            collection: $in.collection,
            path: $in.paths[$in.index]
        }}
    />

    <Return
        value={{
            ...$in,
            index: $in.index + 1,
            diagnostic: $ctx.member,
            running: $ctx.member == null && $in.index + 1 < $in.paths.length
        }}
    />
</Module>
