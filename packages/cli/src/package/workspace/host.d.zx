export type Collection = opaque

export type Project = opaque

export enum Probe {
    Missing,
    Invalid,
    Package,
    Workspace
}

export type ManifestMember = {
    name: string,
    path: string,
    row: u64
}

export type MemberSearch = {
    paths: string[],
    target: string
}

export type SurfaceExport = {
    specifier: string,
    source: string,
    module?: string
}

export type Surface = {
    root: string,
    path: string,
    exports: SurfaceExport[],
    entry?: string,
    library?: string
}

export type PublishedSurface = {
    root: string,
    rows: SurfaceExport[],
    artifact?: string
}

export declare function listWorkspaceDirectories(
    allocator,
    collection: Collection,
    path: string
): string[] throws { SourceLoadFailure }
export declare function readMember(collection: Collection, path: string): ManifestMember? throws {
    SourceLoadFailure
}

export declare function readCandidate(search: Project, path: string, keep_previous: bool): Probe
    throws { SourceLoadFailure }
export declare function loadAncestor(search: Project, directory: string): MemberSearch?
    throws { SourceLoadFailure }

export declare function hasPackageManifest(io, path: string): bool throws {
    AccessDenied, BadPathName, Canceled, FileBusy, FileNotFound, InputOutput,
    NameTooLong, NetworkNotFound, NoDevice, NotDir, PermissionDenied, ReadOnlyFileSystem,
    SymLinkLoop, SystemResources, Unexpected
}

export declare function findProjectConfiguration(project: Project): string? throws {
    SourceLoadFailure
}
export declare function loadProjectGraph(project: Project, path: string): u64? throws {
    SourceLoadFailure
}
export declare function owningProjectScope(project: Project): u64? throws { SourceLoadFailure }

export declare function readScopeSurface(binding: Project, index: u64): Surface throws {
    SourceLoadFailure
}
export declare function publishScopeSurface(
    binding: Project,
    index: u64,
    surface: PublishedSurface
): void throws { SourceLoadFailure }
export declare function bindScope(binding: Project, index: u64): bool throws {
    SourceLoadFailure
}
