export type Collection = opaque

export type Search = opaque

export type Source = opaque

export type Project = opaque

export type ScopeBinding = opaque

export enum Probe {
    Missing,
    Invalid,
    Package,
    Workspace
}

export type MemberSearch = {
    search: Search,
    count: u64,
    target: string
}

export type Directory = {
    path: string,
    name: string
}

export declare function readRoot(collection: Collection): string[] throws { SourceLoadFailure }
export declare function invalidPattern(collection: Collection, pattern: string): void throws {
    SourceLoadFailure
}

export declare function openDirectory(collection: Collection): void throws { SourceLoadFailure }
export declare function nextDirectory(collection: Collection): Directory? throws { SourceLoadFailure }
export declare function recordDirectory(collection: Collection): void throws { SourceLoadFailure }
export declare function enterDirectory(collection: Collection): void throws { SourceLoadFailure }

export declare function orderMembers(collection: Collection): u64 throws { SourceLoadFailure }
export declare function readMember(collection: Collection, index: u64): bool throws {
    SourceLoadFailure
}
export declare function registerMember(collection: Collection, index: u64): u64? throws {
    SourceLoadFailure
}
export declare function duplicateMember(collection: Collection, previous: u64): void throws {
    SourceLoadFailure
}
export declare function publishMember(collection: Collection, index: u64): void throws {
    SourceLoadFailure
}

export declare function startSearch(search: Search): string throws { SourceLoadFailure }
export declare function readCandidate(search: Search, directory: string): Probe
    throws { SourceLoadFailure }
export declare function rememberCandidate(search: Search): void
export declare function selectCandidate(search: Search, nearest: bool): void
export declare function loadAncestor(search: Search, directory: string): MemberSearch?
    throws { SourceLoadFailure }
export declare function workspacePackagePath(search: Search, row: u64): string
export declare function selectAncestor(search: Search): void
export declare function discardCandidates(search: Search): void

export declare function scopeRoot(source: Source, path: string): string?
export declare function physicalSource(source: Source, path: string): string throws {
    SourceLoadFailure
}
export declare function parentDirectory(path: string): string?
export declare function hasPackageManifest(source: Source, directory: string): bool throws {
    SourceLoadFailure
}

export declare function projectConfiguration(project: Project): string?
export declare function findProjectConfiguration(project: Project): string? throws {
    SourceLoadFailure
}
export declare function loadProjectGraph(project: Project, path: string): bool throws {
    SourceLoadFailure
}
export declare function bindProjectScopes(project: Project): bool throws { SourceLoadFailure }
export declare function owningProjectScope(project: Project): u64? throws { SourceLoadFailure }
export declare function reportProjectEntry(project: Project): void
export declare function publishProject(project: Project, owner: u64): void throws {
    SourceLoadFailure
}

export declare function prepareSurface(binding: ScopeBinding, index: u64): u64 throws {
    SourceLoadFailure
}
export declare function scopeEntry(binding: ScopeBinding): string?
export declare function scopeLibrary(binding: ScopeBinding): string?
export declare function writeScopeEntry(binding: ScopeBinding, entry: string): void throws {
    SourceLoadFailure
}
export declare function prepareLibrarySurface(binding: ScopeBinding, library: string): void throws {
    SourceLoadFailure
}
export declare function writeCompiledExport(binding: ScopeBinding, index: u64): void
export declare function writeSourceExport(binding: ScopeBinding, index: u64): void throws {
    SourceLoadFailure
}
export declare function borrowScopeColumns(binding: ScopeBinding): void
export declare function bindScope(binding: ScopeBinding, index: u64): bool throws {
    SourceLoadFailure
}
