import { ascii_backslash, ascii_dot, ascii_slash } from "core/ascii/const"

export type Input = {
    path: string,
    absolute: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { path, absolute } = in

    if (absolute) {
        return false
    }

    const parent_prefix = (
        - path.length >= 2
        - and path[0] == ascii_dot
        - and path[1] == ascii_dot
    )

    if (!parent_prefix) {
        return true
    }

    if (path.length == 2) {
        return false
    }

    return match path[2] {
        ascii_slash => false,
        ascii_backslash => false,
        _ => true
    }
}
