import bytes from "std:bytes"

import { rx_extension, zx_extension } from "../const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    const text = bytes.fromText(in)
    const width = bytes.fromText(zx_extension).length

    if (text.length < width) {
        return false
    }

    const start = text.length - width

    return bytes.startsWithText(text, start, zx_extension) ||
        bytes.startsWithText(text, start, rx_extension)
}
