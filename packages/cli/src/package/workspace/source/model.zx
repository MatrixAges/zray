import type { Source } from "package_workspace_host"

export enum Status {
    Valid,
    Outside,
    Alias,
    Undeclared
}

export type Input = {
    source: Source,
    path: string,
    root?: string
}

export type Scan = {
    source: Source,
    directory: string,
    root: string
}

export type Cursor = Scan & {
    status: Status
}
