import type { Registration } from "snapshot_host"

export enum Status {
    Valid,
    Outside,
    Alias,
    Undeclared
}

export type Input = {
    registration?: Registration,
    path: string,
    root?: string
}

export type Scan = {
    registration?: Registration,
    directory: string,
    root: string
}

export type Cursor = Scan & {
    status: Status
}
