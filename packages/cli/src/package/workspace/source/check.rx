<Module>
    <Type from="model" as="Ownership" />

    <Args in={Ownership.Input} out={Ownership.Status} />

    <Call
        fn="index.scopeRoot"
        in={[
            $in.source,
            $in.path
        ]}
    />

    <If on={$ctx.scopeRoot != null}>
        <Call
            fn="index.physicalSource"
            in={[
                $in.source,
                $in.path
            ]}
        />

        <If on={$ctx.physicalSource != $in.path}>
            <Return value={Ownership.Status.Alias} />
        </If>

        <Call fn="../paths/parent" in={$in.path} />

        <If on={$ctx.parent != null}>
            <Call
                fn="scan"
                in={{
                    source: $in.source,
                    directory: $ctx.parent,
                    root: $ctx.scopeRoot
                }}
            />

            <Return value={$ctx.scan} />
        </If>
    </If>

    <Return value={Ownership.Status.Outside} />
</Module>
