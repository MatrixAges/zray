import {
    git_directory,
    node_modules,
    zig_cache,
    zig_output,
    zig_packages,
    zxc_directory
} from "./const"

export type Input = string

export type Output = bool

export default function (in: Input): Output {
    return match in {
        git_directory => true,
        zxc_directory => true,
        zig_cache => true,
        zig_output => true,
        zig_packages => true,
        node_modules => true,
        _ => false
    }
}
