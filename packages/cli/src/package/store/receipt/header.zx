import { maximum_entries, receipt_version } from "../const"

import type { HeaderInput as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const version = in.loaded.format_version == receipt_version
    const digest = in.loaded.archive_hash == in.expected
    const count = in.loaded.paths.length <= maximum_entries

    const valid = (
        - version
        - and digest
        - and count
    )

    return valid
}
