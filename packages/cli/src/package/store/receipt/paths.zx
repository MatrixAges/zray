import bytes from "std:bytes"

import normalize from "../../package/archive/path/normalize"
import { digest_width } from "../const"
import { Status } from "./model"

import type { Output, PathsInput as Input } from "./model"

export default function (in: Input): Output {
    const count = in.paths.length

    return loop({
        row: 0,
        status: Status.Valid
    }, {
        while: state => state.status == Status.Valid && state.row < count,
        next: state => {
            const row = state.row
            const path = in.paths[row]

            const normal = normalize({
                name: path,
                directory: false
            })

            if (normal == null) {
                state.status = Status.InvalidPackageArchivePath
            } else {
                const digest = in.hashes[row]
                const matching = normal == path
                const sized = digest.length == digest_width

                if (!matching || !sized) {
                    state.status = Status.InvalidPackageReceipt
                } else {
                    const wanted = bytes.fromText(path)

                    const duplicate = loop(0, {
                        while: prev =>
                            prev < row &&
                            !bytes.equals(
                                bytes.fromText(in.paths[prev]),
                                wanted
                            ),
                        next: prev => {
                            prev += 1
                        },
                        return: prev => prev < row
                    })

                    if (duplicate) {
                        state.status = Status.InvalidPackageReceipt
                    }
                }
            }

            state.row += 1
        },
        return: state => state.status
    })
}
