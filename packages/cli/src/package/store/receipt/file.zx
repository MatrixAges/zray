import host from "package_receipt_host"

import type { FileInput as Input } from "./model"

export type Output = u64?

export default function (in: Input): Output {
    const { receipt, remaining, expected, executable } = in

    const actual = host.openTreeFile(receipt)

    if (actual != null && actual != executable) {
        host.closeTreeFile(receipt)

        return null
    }

    const hashed = host.hashTreeFile(receipt, remaining)

    host.closeTreeFile(receipt)

    if (hashed == null) {
        return null
    }

    return hashed.digest == expected ? hashed.length : null
}
