import host from "package_receipt_host"
import { TreeKind } from "package_receipt_host"

import { maximum_entries, maximum_unpacked } from "../const"
import file from "./file"
import lookup from "./lookup"
import { Status } from "./model"

import type { Entries, ScanInput as Input, Output } from "./model"

export default function (in: Input): Output {
    const count = in.hashes.length

    const initial: Entries = {
        files: 0,
        bytes: 0,
        visited: 0,
        more: true,
        status: Status.Valid
    }

    return loop(initial, {
        while: current => current.more && current.status == Status.Valid,
        next: current => {
            const entry = host.nextTreeEntry(in.receipt)

            if (entry == null) {
                current.more = false
            } else if (current.visited == maximum_entries) {
                current.status = Status.TooManyPackageEntries
            } else {
                current.visited += 1

                if (entry.kind == TreeKind.File) {
                    const index = lookup({
                        paths: in.paths,
                        path: entry.path
                    })

                    if (index == null) {
                        current.status = Status.CorruptPackageStore
                    } else {
                        const bytes = file({
                            receipt: in.receipt,
                            remaining: maximum_unpacked - current.bytes,
                            expected: in.hashes[index],
                            executable: in.executables[index]
                        })

                        if (bytes == null) {
                            current.status = Status.CorruptPackageStore
                        } else {
                            current.bytes += bytes
                            current.files += 1
                        }
                    }
                } else if (entry.kind != TreeKind.Directory) {
                    current.status = Status.CorruptPackageStore
                }
            }
        },
        return: current => match {
            current.status != Status.Valid => current.status,
            current.files != count => Status.CorruptPackageStore,
            _ => Status.Valid
        }
    })
}
