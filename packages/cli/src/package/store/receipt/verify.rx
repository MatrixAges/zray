<Module>
    <Type from="model" as="Receipt" />

    <Args in={Receipt.Input} out={Receipt.Output} />

    <Call fn="index.receiptIsFile" in={$in.receipt} />

    <If on={!$ctx.receiptIsFile}>
        <Return value={Receipt.Status.InvalidPackageReceipt} />
    </If>

    <Call fn="index.loadReceipt" in={$in.receipt} />

    <Call
        fn="header"
        in={{
            loaded: $ctx.loadReceipt,
            expected: $in.expected
        }}
    />

    <If on={!$ctx.header}>
        <Return value={Receipt.Status.InvalidPackageReceipt} />
    </If>

    <Call
        fn="paths"
        in={{
            receipt: $in.receipt,
            paths: $ctx.loadReceipt.paths,
            hashes: $ctx.loadReceipt.hashes
        }}
    />

    <If on={$ctx.paths != Receipt.Status.Valid}>
        <Return value={$ctx.paths} />
    </If>

    <Call fn="index.openTree" in={$in.receipt} />

    <Call
        fn="scan"
        in={{
            receipt: $in.receipt,
            hashes: $ctx.loadReceipt.hashes,
            executables: $ctx.loadReceipt.executables
        }}
    />

    <Return value={$ctx.scan} />
</Module>
