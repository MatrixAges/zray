import type { LoadedReceipt, Receipt } from "package_receipt_host"

export enum Status {
    Valid,
    InvalidPackageReceipt,
    InvalidPackageArchivePath,
    CorruptPackageStore,
    TooManyPackageEntries
}

export type Input = {
    receipt: Receipt,
    expected: string
}

export type Output = Status

export type HeaderInput = {
    loaded: LoadedReceipt,
    expected: string
}

export type PathsInput = {
    paths: string[],
    hashes: string[]
}

export type LookupInput = {
    paths: string[],
    path: string
}

export type FileInput = {
    receipt: Receipt,
    remaining: u64,
    expected: string,
    executable: bool
}

export type ScanInput = {
    receipt: Receipt,
    paths: string[],
    hashes: string[],
    executables: bool[]
}

export type Entries = {
    files: u64,
    bytes: u64,
    visited: u64,
    more: bool,
    status: Status
}
