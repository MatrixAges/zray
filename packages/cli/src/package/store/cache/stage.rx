<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Stage} out={Cache.StageResult} />

    <Call
        fn="verify"
        in={{
            bytes: $in.bytes,
            hex: $in.hex
        }}
    />

    <If on={$ctx.verify != Cache.Status.Ready}>
        <Return
            value={{
                status: $ctx.verify,
                staging: ""
            }}
        />
    </If>

    <Call
        fn="index.createStaging"
        in={[
            $in.cache,
            $in.root
        ]}
    />

    <Call fn="receipt_path" />

    <Call
        fn="index.unpack"
        in={[
            $in.cache,
            $ctx.createStaging,
            $in.bytes,
            $in.hex
        ]}
    />

    <Call
        module="../../workspace_files/write_bytes"
        in={{
            path: $ctx.receipt_path,
            data: $ctx.unpack
        }}
    />

    <Call
        fn="index.checkStaging"
        in={[
            $in.cache,
            $ctx.createStaging,
            $in.hex
        ]}
    />

    <If on={!$ctx.checkStaging}>
        <Return
            value={{
                status: Cache.Status.CorruptPackageStore,
                staging: ""
            }}
        />
    </If>

    <Return
        value={{
            status: Cache.Status.Ready,
            staging: $ctx.createStaging
        }}
    />
</Module>
