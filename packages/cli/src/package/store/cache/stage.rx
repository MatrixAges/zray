<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Stage} out={void} />

    <Call
        fn="index.verifyBlob"
        in={[
            $in.cache,
            $in.bytes
        ]}
    />

    <Call fn="index.createStaging" in={$in.cache} />

    <Call
        fn="index.unpack"
        in={[
            $in.cache,
            $in.bytes
        ]}
    />

    <Call fn="index.writeReceipt" in={$in.cache} />
    <Call fn="index.checkStaging" in={$in.cache} />
    <Call fn="index.closeStaging" in={$in.cache} />
</Module>
