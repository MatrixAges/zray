<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Stage} out={Cache.Status} />

    <Call
        fn="verify"
        in={{
            bytes: $in.bytes,
            hex: $in.hex
        }}
    />

    <If on={$ctx.verify != Cache.Status.Ready}>
        <Return value={$ctx.verify} />
    </If>

    <Call
        fn="index.createStaging"
        in={[
            $in.cache,
            $in.root
        ]}
    />

    <Call fn="receipt_path" />

    <Call
        fn="index.unpack"
        in={[
            $in.cache,
            $in.bytes,
            $in.hex
        ]}
    />

    <Call
        module="../../workspace_files/write_bytes"
        in={{
            path: $ctx.receipt_path,
            data: $ctx.unpack
        }}
    />

    <Call
        fn="index.checkStaging"
        in={[
            $in.cache,
            $in.hex
        ]}
    />

    <Return value={Cache.Status.Ready} />
</Module>
