<Module>
    <Type from="model" as="Cache" />

    <Args in={Cache.Input} out={Cache.Output} />

    <Call fn="index.cached" in={$in.cache} />

    <If on={$ctx.cached}>
        <Return value={Cache.Status.Ready} />
    </If>

    <Call
        fn="blob_path"
        in={$in.pick([
            "root",
            "hex"
        ])}
    />

    <Call
        module="acquire"
        in={{
            ...$in.pick([
                "cache",
                "offline",
                "source",
                "base"
            ]),
            path: $ctx.blob_path
        }}
    />

    <If on={$ctx.acquire.bytes != null}>
        <Call
            module="stage"
            in={{
                cache: $in.cache,
                bytes: $ctx.acquire.bytes
            }}
        />

        <If on={$ctx.acquire.downloaded}>
            <Call
                fn="index.write"
                in={[
                    $ctx.blob_path,
                    $ctx.acquire.bytes
                ]}
            />
        </If>

        <Call fn="index.publishStaging" in={$in.cache} />

        <If on={!$ctx.publishStaging}>
            <Call fn="index.winnerAvailable" in={$in.cache} />

            <If on={!$ctx.winnerAvailable}>
                <Return value={Cache.Status.CorruptPackageStore} />
            </If>
        </If>

        <Return value={Cache.Status.Ready} />
    </If>

    <Return value={Cache.Status.PackageNotCached} />
</Module>
