import type { Cache } from "package_cache_host"

export enum Status {
    Ready,
    PackageNotCached,
    CorruptPackageStore
}

export type Input = {
    cache: Cache,
    offline: bool,
    root: string,
    hex: string,
    source: string,
    base: string
}

export type Output = Status

export type Archive = Input.Pick("cache", "offline", "source", "base") & {
    path: string
}

export type Payload = {
    bytes?: u8[],
    downloaded: bool
}

export type Stage = {
    cache: Cache,
    bytes: u8[]
}
