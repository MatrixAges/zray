import type { ResponseReader } from "package_download_host"

export type Input = {
    reader: ResponseReader,
    source: string,
    base: string,
    is_local: bool,
    maximum_archive: u64
}

export enum Status {
    Ready,
    PackageArchiveTooLarge,
    PackageDownloadFailed,
    UnsupportedPackageContentEncoding
}

export type Output = {
    status: Status,
    body?: u8[]
}
