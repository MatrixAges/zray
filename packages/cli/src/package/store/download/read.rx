<Module>
    <Type from="model" as="Download" />

    <Args in={Download.Input} out={Download.Output} />

    <If on={$in.is_local}>
        <Call fn="local" in={$in.download} />

        <Return value={$ctx.local} />
    </If>

    <Call fn="index.receiveHead" in={$in.download} />

    <Call
        fn="body"
        in={{
            download: $in.download,
            head: $ctx.receiveHead
        }}
    />

    <Return value={$ctx.body} />
</Module>
