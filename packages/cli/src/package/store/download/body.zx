import { Status } from "./model"

import type { ResponseHead } from "package_download_host"

export type Input = {
    head: ResponseHead,
    maximum_archive: u64
}

export type Output = Status

export default function (in: Input): Output {
    const { head, maximum_archive } = in

    if (!head.ok) {
        return Status.PackageDownloadFailed
    }

    if (!head.identity) {
        return Status.UnsupportedPackageContentEncoding
    }

    if (head.length != null && head.length > maximum_archive) {
        return Status.PackageArchiveTooLarge
    }

    return Status.Ready
}
