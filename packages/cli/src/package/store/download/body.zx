import host from "package_download_host"

import { maximum_archive } from "../const"
import { Status } from "./model"

import type { BodyInput as Input, Output } from "./model"

export default function (in: Input): Output {
    if (!in.head.ok) {
        return Status.PackageDownloadFailed
    }

    if (!in.head.identity) {
        return Status.UnsupportedPackageContentEncoding
    }

    if (in.head.length != null && in.head.length > maximum_archive) {
        return Status.PackageArchiveTooLarge
    }

    host.readBody(in.download, maximum_archive)

    return Status.Ready
}
