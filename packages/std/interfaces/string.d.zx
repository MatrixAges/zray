export declare function join(allocator, separator: string, values: string[]): string throws { OutOfMemory } concurrent

export declare function copy(allocator, value: string): string throws { OutOfMemory } concurrent

export declare function sameStorage(left: string, right: string): bool concurrent

export declare function replaceAll(
    allocator,
    value: string,
    pattern: string,
    replacement: string
): string throws { OutOfMemory, EmptyPattern } concurrent

export declare function copyList(
    allocator,
    values: string[]
): string[] throws { OutOfMemory } concurrent
