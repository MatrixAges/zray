<Module>
    <Type from="model" as="Rx" />

    <Args in={Rx.EntryInput} out={Rx.EntryOutput} />

    <If on={$in.mode == Rx.Mode.Structure}>
        <Call fn="structure" in={$in} />

        <Call
            fn="render_edits"
            in={{
                edits: $ctx.structure,
                sort_edits: true
            }}
        />

        <Call
            fn="../source/apply_edits"
            in={{
                source: $in.source,
                edits: $ctx.render_edits
            }}
        />

        <Return value={$ctx.apply_edits} />

        <Else>
            <Call module="layout" in={$in} />

            <Call
                fn="render_edits"
                in={{
                    edits: $ctx.layout,
                    sort_edits: false
                }}
            />

            <Call
                fn="../source/apply_edits"
                in={{
                    source: $in.source,
                    edits: $ctx.render_edits
                }}
            />

            <Return value={$ctx.apply_edits} />
        </Else>
    </If>
</Module>
