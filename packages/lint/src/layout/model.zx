export type Token = {
    text: string,
    start: u64,
    end: u64,
    gap: u64,
    object: bool,
    multiline: bool,
    opening: bool,
    closing: bool,
    separator: bool,
    block: bool,
    comment: bool,
    boundary: bool,
    newline: bool
}

export type Input = {
    tokens: Token[],
    width: u64,
    level: u64,
    indent_only: bool,
    prefix: u64,
    suffix: u64
}

export type Graph = {
    input: Input,
    partners: u64?[],
    owners: u64?[],
    depths: u64[],
    widths: u64[],
    prefixes: u64[],
    vertical_counts: u64[],
    gaps: u64[],
    trailers: u64[],
    selections: bool[]
}

export type Plan = {
    graph: Graph,
    wraps: bool[]
}

export type Break = {
    index: u64,
    level: u64,
    count: u64
}

export type Edit = {
    start: u64,
    end: u64,
    newline: bool,
    count: u64
}

export type RawSpan = {
    start: u64,
    end: u64
}

export enum OpKind {
    ExcludeStart,
    ExcludeEnding,
    MultilineEnding,
    Boundary,
    List,
    Condition,
    ExcludeRange
}

export type Op = {
    kind: OpKind,
    start: u64,
    end: u64,
    count: u64,
    flag: bool
}

export type ProjectionInput = {
    source_text: string,
    raw_tokens: RawSpan[],
    raw_comments: RawSpan[],
    ops: Op[]
}

export type EntryInput = {
    source: u8[],
    layout: Input,
    check_attribute: bool,
    projection: ProjectionInput
}

export type EntryOutput = {
    required: bool,
    edits: Edit[]
}
