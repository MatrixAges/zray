import bytes from "std:bytes"

import crlf from "../rx/crlf"

import type { EntryInput } from "./model"

export type Input = EntryInput.Pick("source", "newline") & {
    indent_only: bool
}

export type Output = u8[]

export default function (in: Input): Output {
    if (in.indent_only) {
        return bytes.fromText("\n")
    }

    if (in.newline != null) {
        return in.newline
    }

    const ending = crlf(in.source) ? "\r\n" : "\n"

    return bytes.fromText(ending)
}
