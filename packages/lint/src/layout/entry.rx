<Module>
    <Type from="model" as="Layout" />

    <Args in={Layout.EntryInput} out={Layout.EntryOutput} />

    <If on={$in.check_attribute}>
        <Call
            fn="attribute_required"
            in={{
                source: $in.source,
                level: $in.layout.level,
                prefix: $in.layout.prefix
            }}
        />

        <Return
            value={{
                required: $ctx.attribute_required,
                formatted: []
            }}
        />

        <Else>
            <Call
                fn="projection"
                in={{
                    source: $in.source,
                    input: $in.projection
                }}
            />

            <Call
                module="layout"
                in={{
                    tokens: $ctx.projection,
                    width: $in.layout.width,
                    level: $in.layout.level,
                    indent_only: $in.layout.indent_only,
                    prefix: $in.layout.prefix,
                    suffix: $in.layout.suffix
                }}
            />

            <Call
                fn="edits"
                in={{
                    source: $in.source,
                    tokens: $ctx.projection,
                    breaks: $ctx.layout
                }}
            />

            <Call
                fn="line_ending"
                in={{
                    source: $in.source,
                    newline: $in.newline,
                    indent_only: $in.layout.indent_only
                }}
            />

            <Call
                fn="render_edits"
                in={{
                    edits: $ctx.edits,
                    newline: $ctx.line_ending
                }}
            />

            <Call
                fn="../source/apply_edits"
                in={{
                    source: $in.source,
                    edits: $ctx.render_edits
                }}
            />

            <Return
                value={{
                    required: false,
                    formatted: $ctx.apply_edits
                }}
            />
        </Else>
    </If>
</Module>
