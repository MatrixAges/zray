<Module>
    <Type from="yaml/model" as="Config" />

    <Args in={Config.EntryInput} out={Config.EntryOutput} />

    <If on={$in.check_length}>
        <Call fn="../length/count" in={$in.source} />

        <If on={$in.maximum == null || $ctx.count > $in.maximum}>
            <Return
                value={{
                    lines: $ctx.count,
                    formatted: null
                }}
            />

            <Else>
                <Return
                    value={{
                        lines: null,
                        formatted: null
                    }}
                />
            </Else>
        </If>

        <Else>
            <Call
                fn="yaml/edits"
                in={{
                    source: $in.source,
                    fields: $in.fields
                }}
            />

            <If on={$ctx.edits.length == 0}>
                <Return
                    value={{
                        lines: null,
                        formatted: null
                    }}
                />

                <Else>
                    <Call fn="yaml/render_edits" in={$ctx.edits} />

                    <Call
                        fn="../source/apply_edits"
                        in={{
                            source: $in.source,
                            edits: $ctx.render_edits
                        }}
                    />

                    <Return
                        value={{
                            lines: null,
                            formatted: $ctx.apply_edits
                        }}
                    />
                </Else>
            </If>
        </Else>
    </If>
</Module>
