import bytes from "std:bytes"

import editParts from "./edit_parts"

import type { Input as EditInput } from "./edit_parts"

export type Input = EditInput

export type Output = u8[]

export default function (in: Input): Output {
    if (in.edits.length == 0) {
        return in.source
    }

    return bytes.join(bytes.fromText(""), editParts(in))
}
