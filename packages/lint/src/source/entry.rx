<Module>
    <Type from="model" as="Source" />

    <Args in={Source.PlanInput} out={Source.Output} />

    <Call
        fn="../imports/plan/plan"
        in={$in.pick([
            "source",
            "comments",
            "imports"
        ])}
    />

    <Call
        fn="../spacing/header"
        in={$in.pick([
            "source",
            "comments",
            "imports",
            "declarations",
            "constants",
            "function_start"
        ])}
    />

    <Call
        fn="../spacing/body"
        in={$in.pick([
            "source",
            "comments",
            "boundaries"
        ])}
    />

    <Call
        fn="merge"
        in={{
            ordered: $ctx.plan,
            header: $ctx.header,
            body: $ctx.body
        }}
    />

    <If on={$in.apply}>
        <Call
            fn="apply_edits"
            in={{
                source: $in.source,
                edits: $ctx.merge
            }}
        />

        <Return
            value={{
                has_edits: false,
                first_start: 0,
                first_end: 0,
                formatted: $ctx.apply_edits
            }}
        />

        <Else>
            <Call fn="first_edit" in={$ctx.merge} />

            <Return value={$ctx.first_edit} />
        </Else>
    </If>
</Module>
