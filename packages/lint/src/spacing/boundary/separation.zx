import bytes from "std:bytes"
import memory from "memory"

import type { BoundaryItem } from "../../source/model"

export type Input = {
    source: u8[],
    item: BoundaryItem
}

export type Output = bool?

export default function (in: Input): Output {
    const { source, item } = in

    if (!item.adjacent) {
        return false
    }

    if (!item.same_kind) {
        return true
    }

    const left =
        memory.borrowU8Range(source, item.left_start, item.left - item.left_start)

    const right = memory.borrowU8Range(source, item.right, item.right_end - item.right)
    const left_multiline = bytes.indexOfScalar(left, 0, 10) != null
    const right_multiline = bytes.indexOfScalar(right, 0, 10) != null

    if (left_multiline || right_multiline) {
        return true
    }

    return item.same_shape ? false : null
}
