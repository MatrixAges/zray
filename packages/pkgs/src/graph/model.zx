import type { ListColumn } from "memory"

export enum Status {
    Valid,
    CyclicPackageDependencies,
    PackageDependencyDepthExceeded,
    UnreachableLockPackage
}

export type Input = {
    targets: ListColumn,
    count: u64,
    limit: u64,
    ranked: bool,
    initial_marks?: u8[]
}

export type Result = {
    status: Status,
    owner: u64
}
