import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import { finished, visiting, workspace_root } from "./const"
import { Status } from "./model"

import type { Input, Result } from "./model"

export type Output = Result & {
    completed: u64
}

export default function (in: Input): Output {
    const { ranked, targets } = in

    const initial_heights: u8[] = match {
        ranked => bytes.repeat(in.count, 0),
        _ => []
    }

    const empty_stack: u64[] = []

    return loop({
        root: 0,
        completed: 0,
        marks: in.initial_marks,
        heights: initial_heights,
        nodes: empty_stack,
        cursors: empty_stack,
        status: Status.Valid,
        owner: 0
    }, {
        while: s => {
            const more = s.root < in.count || s.nodes.length != 0

            return more && s.status == Status.Valid
        },
        next: s => {
            if (s.nodes.length == 0) {
                const row = s.root
                const mark = s.marks[row]
                s.root += 1

                if (mark == workspace_root) {
                    s.marks = s.marks.splice(row, 1, [visiting])[0]
                    s.nodes = [row]
                    s.cursors = [0]
                }
            } else {
                const frame = s.nodes.length - 1
                const owner = s.nodes[frame]
                const edge = s.cursors[frame]
                const length = memory.listLength(targets, owner)

                if (edge == length) {
                    s.marks = s.marks.splice(owner, 1, [finished])[0]
                    s.completed += 1
                    s.nodes = s.nodes.splice(frame, 1, [])[0]
                    s.cursors = s.cursors.splice(frame, 1, [])[0]

                    if (ranked && frame != 0) {
                        const parent = s.nodes[frame - 1]
                        const height = s.heights[owner]

                        if (height >= s.heights[parent]) {
                            s.heights = s.heights.splice(parent, 1, [height + 1])[0]
                        }
                    }
                } else {
                    const target = memory.readListIndex(targets, owner, edge)
                    const mark = s.marks[target]
                    const revisit = mark == finished
                    const check_depth = ranked || !revisit
                    const depth = s.nodes.length

                    if (mark == visiting) {
                        s.status = Status.CyclicPackageDependencies
                        s.owner = target
                    } else if (check_depth && depth >= in.limit) {
                        s.status = Status.PackageDependencyDepthExceeded
                        s.owner = target
                    } else if (revisit) {
                        s.cursors = s.cursors.splice(frame, 1, [edge + 1])[0]

                        if (ranked) {
                            const height = s.heights[target]
                            const rank = s.heights[owner]

                            if (depth + integers.widenByte(height) >= in.limit) {
                                s.status = Status.PackageDependencyDepthExceeded
                                s.owner = target
                            } else if (height >= rank) {
                                s.heights =
                                    s.heights.splice(owner, 1, [height + 1])[0]
                            }
                        }
                    } else {
                        s.cursors = s.cursors.splice(frame, 1, [edge + 1])[0]
                        s.marks = s.marks.splice(target, 1, [visiting])[0]
                        s.nodes = s.nodes.push(target)[0]
                        s.cursors = s.cursors.push(0)[0]
                    }
                }
            }
        },
        return: s => s.pick([
            "status",
            "owner",
            "completed"
        ])
    })
}
