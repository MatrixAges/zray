<Module>
    <Type from="model" as="Index" />

    <Args in={Index.Package} out={Index.Status} />

    <Call fn="../metadata/name" in={$in.name} />

    <If on={!$ctx.name}>
        <Return value={Index.Status.InvalidPackageName} />
    </If>

    <If on={$in.length == 0}>
        <Return value={Index.Status.PackageHasNoVersions} />
    </If>

    <Call
        fn="find"
        in={{
            name: $in.name,
            names: $in.names,
            count: $in.row
        }}
    />

    <If on={$ctx.find != null}>
        <Return value={Index.Status.DuplicatePackage} />
    </If>

    <Call
        fn="releases"
        in={$in.omit([
            "name",
            "names"
        ])}
    />

    <Return value={$ctx.releases} />
</Module>
