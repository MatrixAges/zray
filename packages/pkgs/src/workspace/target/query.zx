import os from "std:os"
import strings from "std:string"
import lexical from "lexical_path"

import { Key } from "./model"

import type { Output as Specifier } from "../specifier"
import type { Query } from "./model"

export type Input = {
    owner: string,
    root?: string,
    spec: Specifier
}

export type Output = Query

export default function (in: Input): Output {
    const { spec, owner, root } = in

    const path = spec.path

    if (path != null) {
        if (root == null) {
            return {
                kind: Key.RelativePath,
                value: path,
                owner,
                range: null
            }
        }

        const base = root ?? ""

        const resolved = lexical.resolvePathParts([
            base,
            owner,
            path
        ])

        const portable = match os.platform() {
            "win32" => strings.replaceAll(resolved, "\\", "/"),
            _ => resolved
        }

        return {
            kind: Key.HostPath,
            value: portable,
            owner: base,
            range: null
        }
    }

    return {
        kind: Key.Name,
        value: spec.name ?? "",
        owner,
        range: spec.range
    }
}
