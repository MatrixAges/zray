import lexical from "lexical_path"
import memory from "memory"

import { Kind } from "../specifier"
import { Key } from "./model"

import type { Output as Specifier } from "../specifier"
import type { Query } from "./model"

export type Request = {
    owner: string,
    name: string,
    requirement: string
}

export type Input = Request & {
    root?: string,
    spec: Specifier
}

export type Output = Query

export default function (in: Input): Output {
    const { requirement, spec, name, owner, root } = in

    if (spec.kind == Kind.Path) {
        const path =
            memory.borrowTextRange(
                requirement,
                spec.body,
                requirement.length - spec.body
            )

        if (root == null) {
            return {
                kind: Key.RelativePath,
                value: path,
                owner,
                range: null
            }
        }

        const base = root ?? ""

        return {
            kind: Key.HostPath,
            value: lexical.resolvePortablePath(base, owner, path),
            owner: base,
            range: null
        }
    }

    const value = match spec.kind {
        Kind.Alias =>
            memory.borrowTextRange(requirement, spec.body, spec.range - spec.body - 1),
        _ => name
    }

    const range: string? = match {
        spec.constrained =>
            memory.borrowTextRange(
                requirement,
                spec.range,
                requirement.length - spec.range
            ),
        _ => null
    }

    return {
        kind: Key.Name,
        value,
        owner,
        range
    }
}
