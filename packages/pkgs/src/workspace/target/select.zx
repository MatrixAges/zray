import validPath from "../path/valid"
import { Kind } from "../path/valid"
import locate from "./locate"
import { Key, Status } from "./model"
import version from "./version"

import type { Input, Result as Output } from "./model"

export default function (in: Input): Output {
    const checked_path = in.kind == Key.CheckedRelativePath

    if (checked_path && !validPath({
        owner: in.owner,
        path: in.value,
        kind: Kind.Dependency
    })) {
        return {
            status: Status.InvalidLockWorkspacePath,
            row: 0
        }
    }

    const position = locate({
        ...in.omit([
            "versions",
            "range",
            "limit"
        ]),
        kind: checked_path ? Key.RelativePath : in.kind
    })

    if (position == null) {
        return {
            status: Status.Missing,
            row: 0
        }
    }

    const row = position ?? 0
    const range = in.range

    if (range == null) {
        return {
            status: Status.Found,
            row
        }
    }

    return {
        status: version({
            versions: in.versions,
            row,
            range: range ?? "",
            limit: in.limit
        }),
        row
    }
}
