<Module>
    <Type from="model" as="Target" />

    <Args in={Target.Input} out={Target.Result} />

    <Call
        fn="locate"
        in={$in.omit([
            "versions",
            "range",
            "limit"
        ])}
    />

    <If on={$ctx.locate == null}>
        <Return
            value={{
                status: Target.Status.Missing,
                row: 0
            }}
        />
    </If>

    <If on={$in.range != null}>
        <Call
            fn="version"
            in={{
                versions: $in.versions,
                row: $ctx.locate ?? 0,
                range: $in.range ?? "",
                limit: $in.limit
            }}
        />

        <Return
            value={{
                status: $ctx.version,
                row: $ctx.locate ?? 0
            }}
        />
    </If>

    <Return
        value={{
            status: Target.Status.Found,
            row: $ctx.locate ?? 0
        }}
    />
</Module>
