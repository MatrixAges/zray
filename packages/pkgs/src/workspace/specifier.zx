import bytes from "std:bytes"
import encoding from "std:encoding"
import { ascii_asterisk, ascii_at } from "core/ascii/const"

import { ascii_caret, ascii_tilde } from "../version/const"
import { current_prefix, parent_prefix, scheme } from "./const"

export enum Kind {
    External,
    Invalid,
    Path,
    Name,
    Alias
}

export type Input = {
    name: string,
    requirement: string
}

export type Output = {
    kind: Kind,
    path?: string,
    name?: string,
    range?: string
}

export default function (in: Input): Output {
    const { name, requirement } = in

    const text = bytes.fromText(requirement)
    const body = bytes.fromText(scheme).length

    if (!bytes.startsWithText(text, 0, scheme)) {
        return {
            kind: Kind.External
        }
    }

    const local = bytes.startsWithText(text, body, current_prefix) ||
        bytes.startsWithText(text, body, parent_prefix)

    if (local) {
        return {
            kind: Kind.Path,
            path: encoding.sliceBytes(requirement, body, requirement.length)
        }
    }

    const separator = bytes.lastIndexOfScalar(text, ascii_at)
    const at = separator ?? requirement.length
    const range = separator == null ? body : at + 1

    const kind = match {
        at == body && separator != null => Kind.Invalid,
        separator != null => Kind.Alias,
        _ => Kind.Name
    }

    const constrained = match requirement.length - range {
        0 => false,
        1 => match text[range] {
            ascii_asterisk => false,
            ascii_caret => false,
            ascii_tilde => false,
            _ => true
        },
        _ => true
    }

    return {
        kind,
        name: match kind {
            Kind.Alias => encoding.sliceBytes(requirement, body, at),
            Kind.Name => name,
            _ => null
        },
        range: match {
            constrained => encoding.sliceBytes(requirement, range, requirement.length),
            _ => null
        }
    }
}
