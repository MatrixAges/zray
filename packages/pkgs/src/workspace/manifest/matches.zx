import entries from "./entries"
import header from "./header"

import type { Pair as Input } from "./model"

export type Output = bool

export default function (in: Input): Output {
    const validated = header(in)

    if (!validated.valid) {
        return false
    }

    return entries({
        ...in.omit([
            "archive",
            "has_workspace"
        ]),
        ...validated.omit(["valid"])
    })
}
