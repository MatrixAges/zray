<Module>
    <Type from="model" as="Manifest" />

    <Args in={Manifest.Pair} out={bool} />

    <Call fn="header" in={$in} />

    <If on={!$ctx.header.valid}>
        <Return value={false} />
    </If>

    <Call
        fn="entries"
        in={{
            ...$in.omit([
                "archive",
                "has_workspace"
            ]),
            ...$ctx.header.omit(["valid"])
        }}
    />

    <Return value={$ctx.entries} />
</Module>
