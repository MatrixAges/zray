import bytes from "std:bytes"
import { bucket_ratio, capacity_growth } from "core/bytes/index/const"
import memory from "memory"

import { scheme } from "../const"

import type { ListColumn } from "memory"

export type Input = {
    production: ListColumn,
    development: ListColumn,
    count: u64
}

export type Output = {
    row: u64,
    edge: u64,
    development: bool,
    total: u64,
    capacity: u64,
    found: bool
}

export default function (in: Input): Output {
    return loop({
        row: 0,
        edge: 0,
        development: false,
        total: 0,
        capacity: 0,
        found: false
    }, {
        while: s => s.row < in.count && !s.found,
        next: s => {
            const column = s.development ? in.development : in.production
            const length = memory.listLength(column, s.row)

            if (s.edge == length) {
                s.total += length

                if (s.development) {
                    const degree = length + memory.listLength(in.production, s.row)

                    if (degree > 1 && degree * bucket_ratio > s.capacity) {
                        s.capacity = loop(1, {
                            while: n => n < degree * bucket_ratio,
                            next: n => {
                                n = n * capacity_growth
                            }
                        })
                    }

                    s.row += 1
                }

                s.development = !s.development
                s.edge = 0
            } else {
                const item = memory.readListText(column, s.row, s.edge)
                const local = bytes.startsWithText(bytes.fromText(item), 0, scheme)

                if (local) {
                    s.edge += 1
                } else {
                    s.found = true
                }
            }
        }
    })
}
