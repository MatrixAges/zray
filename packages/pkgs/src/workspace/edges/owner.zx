import memory from "memory"

import insertName from "./insert_name"
import { Status } from "./model"
import resolve from "./target"
import zeroBuckets from "./zero_buckets"

import type { Edge, Members, OwnerResult } from "./model"

export type Input = Members & {
    row: u64
}

export type Output = OwnerResult

export default function (in: Input): Output {
    const { manifests, row } = in
    const { production_names, development_names } = manifests

    const production = memory.listLength(production_names, row)
    const length = production + memory.listLength(development_names, row)
    const owner = memory.readTextColumn(in.paths, row)
    const empty_buckets: u64[] = []
    const empty_edges: Edge[] = []

    const initial_buckets = match {
        length > 1 => zeroBuckets(length),
        _ => empty_buckets
    }

    return loop({
        edge: 0,
        status: Status.Valid,
        buckets: initial_buckets,
        edges: empty_edges
    }, {
        while: s => s.edge < length && s.status == Status.Valid,
        next: s => {
            const edge = s.edge
            const development = edge >= production
            const index = development ? edge - production : edge
            const names = development ? development_names : production_names
            const requirements = match development {
                true => manifests.development_requirements,
                _ => manifests.production_requirements
            }
            const name = memory.readListText(names, row, index)

            const inserted = match {
                length > 1 => insertName({
                    keys: s.edges,
                    buckets: s.buckets,
                    name,
                    edge
                }),
                _ => {
                    duplicate: false,
                    buckets: s.buckets
                }
            }

            s.buckets = inserted.buckets

            if (inserted.duplicate) {
                s.status = Status.Duplicate
            } else {
                const target = resolve({
                    ...in.omit(["row"]),
                    name,
                    owner,
                    requirement: memory.readListText(requirements, row, index)
                })

                s.status = target.status
                if (target.status == Status.Valid) {
                    s.edges = s.edges.push({
                        name,
                        target: target.row,
                        development
                    })[0]
                    s.edge += 1
                }
            }
        },
        return: s => s.pick([
            "edge",
            "status",
            "edges"
        ])
    })
}
