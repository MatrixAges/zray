import type { Table } from "core/bytes/index/column"
import type { TextColumn, WriteColumn } from "memory"
import type { Input as Graph } from "../../graph/model"
import type { Manifests } from "../manifest/model"

export enum Status {
    Valid,
    Duplicate,
    InvalidSpecifier,
    Missing,
    InvalidRange,
    InvalidVersion,
    Overflow,
    LockVersionMismatch,
    CyclicPackageDependencies,
    PackageDependencyDepthExceeded
}

export type Members = {
    manifests: Manifests,
    paths: TextColumn,
    root: string,
    count: u64,
    limit: u64
}

export type Columns = {
    names: WriteColumn,
    targets: WriteColumn,
    development: WriteColumn
}

export type Build = Members & {
    output: Columns,
    index: Table
}

export type Input = Build & {
    graph: Graph
}

export type Result = {
    owner: u64,
    edge: u64,
    status: Status
}
