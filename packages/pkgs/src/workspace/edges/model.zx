import type { TextColumn } from "memory"
import type { Manifests } from "../manifest/model"

export enum Status {
    Valid,
    Duplicate,
    InvalidSpecifier,
    Missing,
    InvalidRange,
    InvalidVersion,
    Overflow,
    LockVersionMismatch,
    CyclicPackageDependencies,
    PackageDependencyDepthExceeded
}

export type Members = {
    manifests: Manifests,
    paths: TextColumn,
    root: string,
    count: u64,
    limit: u64
}

export type Edge = {
    name: string,
    target: u64,
    development: bool
}

export type Input = Members & {
    depth_limit: u64
}

export type OwnerResult = {
    edge: u64,
    status: Status,
    edges: Edge[]
}

export type Built = {
    owner: u64,
    edge: u64,
    status: Status,
    edges: Edge[],
    offsets: u64[]
}

export type Result = {
    owner: u64,
    edge: u64,
    status: Status,
    edges: Edge[]
}
