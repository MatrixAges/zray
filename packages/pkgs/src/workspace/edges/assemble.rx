<Module>
    <Type from="model" as="Edges" />
    <Type from="../../graph/model" as="Graph" />

    <Args in={Edges.Input} out={Edges.Result} />

    <Call fn="build" in={$in} />

    <If on={$ctx.build.status != Edges.Status.Valid}>
        <Return
            value={{
                ...$ctx.build.pick([
                    "owner",
                    "edge",
                    "status"
                ]),
                edges: []
            }}
        />
    </If>

    <Call fn="targets" in={$ctx.build.edges} />

    <Call
        fn="../../graph/walk_flat"
        in={{
            edges: $ctx.targets,
            offsets: $ctx.build.offsets,
            count: $in.count
        }}
    />

    <Switch on={$ctx.walk_flat.status}>
        <Case value={Graph.Status.CyclicPackageDependencies}>
            <Return
                value={{
                    status: Edges.Status.CyclicPackageDependencies,
                    owner: $ctx.walk_flat.owner,
                    edge: 0,
                    edges: []
                }}
            />
        </Case>

        <Case value={Graph.Status.PackageDependencyDepthExceeded}>
            <Return
                value={{
                    status: Edges.Status.PackageDependencyDepthExceeded,
                    owner: $ctx.walk_flat.owner,
                    edge: 0,
                    edges: []
                }}
            />
        </Case>

        <Default>
            <Return
                value={{
                    ...$ctx.build.pick([
                        "owner",
                        "edge",
                        "status"
                    ]),
                    edges: $ctx.build.edges
                }}
            />
        </Default>
    </Switch>
</Module>
