<Module>
    <Type from="model" as="Edges" />
    <Type from="../../graph/model" as="Graph" />

    <Args in={Edges.Input} out={Edges.Result} />

    <Call fn="build" in={$in.omit(["graph"])} />

    <If on={$ctx.build.status != Edges.Status.Valid}>
        <Return value={$ctx.build} />
    </If>

    <Call module="../../graph/check" in={$in.graph} />

    <Switch on={$ctx.check.status}>
        <Case value={Graph.Status.CyclicPackageDependencies}>
            <Return
                value={{
                    status: Edges.Status.CyclicPackageDependencies,
                    owner: $ctx.check.owner,
                    edge: 0
                }}
            />
        </Case>

        <Case value={Graph.Status.PackageDependencyDepthExceeded}>
            <Return
                value={{
                    status: Edges.Status.PackageDependencyDepthExceeded,
                    owner: $ctx.check.owner,
                    edge: 0
                }}
            />
        </Case>

        <Default>
            <Return value={$ctx.build} />
        </Default>
    </Switch>
</Module>
