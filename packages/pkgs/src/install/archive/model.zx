import type { TextColumn } from "memory"

export enum Action {
    Existing,
    Local,
    Remote,
    PackageArchiveIdentityMismatch,
    InvalidLockPackageCount
}

export type Identity = {
    name: string,
    version: string
}

export type CacheUpdate = {
    buckets: u32[],
    indexed: u64
}

export type Input = Identity & {
    names: TextColumn,
    versions: TextColumn,
    digests: TextColumn,
    digest: string,
    archive: string,
    first: u64,
    count: u64,
    maximum: u64
}

export type Result = {
    action: Action,
    row: u64
}
