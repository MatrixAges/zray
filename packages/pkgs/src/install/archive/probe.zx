import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { Table } from "./model"

export type Input = Table & {
    digest: string,
    capacity: u64
}

export type Output = {
    slot: u64,
    entry: u64
}

export default function (in: Input): Output {
    const { digests, buckets, digest, capacity } = in

    if (capacity == 0) {
        return {
            slot: 0,
            entry: 0
        }
    }

    const key = bytes.fromText(digest)
    const mask = capacity - 1

    return loop({
        slot: integers.andBits(bytes.hash(key), mask),
        entry: 0,
        done: false
    }, {
        while: s => !s.done,
        next: s => {
            const entry = memory.readU32(buckets, s.slot)
            const matches = match entry {
                0 => true,
                _ => bytes.equals(
                    bytes.fromText(
                        memory.readTextColumn(
                            digests,
                            integers.widen(entry) - 1
                        )
                    ),
                    key
                )
            }

            if (matches) {
                s.done = true
                s.entry = integers.widen(entry)
            } else {
                s.slot = integers.andBits(s.slot + 1, mask)
            }
        },
        return: s => s.omit(["done"])
    })
}
