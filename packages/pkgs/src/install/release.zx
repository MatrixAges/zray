import { Status as Registry } from "../registry/model"
import { Status } from "./model"

import type { Selection } from "../registry/model"
import type { Result } from "./model"

export type Input = Selection & Result.Pick("cursor", "rows") & {
    name: string
}

export type Output = Result

export default function (in: Input): Output {
    const status = match in.status {
        Registry.Valid => in.found ? Status.Archive : Status.PackageVersionNotFound,
        Registry.InvalidRange => Status.InvalidRange,
        Registry.Overflow => Status.Overflow,
        _ => Status.InvalidVersion
    }

    const pending = status == Status.Archive

    return {
        ...in.omit([
            "status",
            "found",
            "cursor",
            "name"
        ]),
        status,
        cursor: pending ? in.cursor - 1 : in.cursor,
        pending_name: pending ? in.name : null
    }
}
