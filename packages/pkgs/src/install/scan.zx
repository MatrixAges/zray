import memory from "memory"

import { Kind } from "../workspace/specifier"
import parse from "../workspace/specifier"
import local from "./local"
import { Status } from "./model"

import type { Row, Scan } from "./model"

export type Input = Scan

export type Output = {
    cursor: u64,
    status: Status,
    name: string,
    range: string,
    rows: Row[]
}

export default function (in: Input): Output {
    const { production, development, remaining } = in

    const empty: Row[] = []

    const count = production.count + (in.owner == null ? 0 : development.count)

    return loop({
        cursor: in.cursor,
        status: Status.Done,
        name: "",
        range: "",
        rows: empty
    }, {
        while: s => s.cursor < count && s.status == Status.Done,
        next: s => {
            const edge = s.cursor
            if (edge == remaining) {
                s.status = Status.TooManyLockDependencies
            } else {
                const dev = edge >= production.count
                const entries = dev ? development : production
                const row = dev ? edge - production.count : edge
                const name = memory.readTextColumn(entries.names, row)
                const range = memory.readTextColumn(entries.requirements, row)
                const spec = parse({
                    name,
                    requirement: range
                })

                if (spec.kind == Kind.External) {
                    s.rows = s.rows.push({
                        name,
                        requirement: range,
                        target: 0,
                        development: dev
                    })[0]
                    s.status = Status.Archive
                    s.name = name
                    s.range = range
                } else {
                    const result = local({
                        ...in.pick([
                            "owner",
                            "members",
                            "limit"
                        ]),
                        spec
                    })
                    s.status = result.status
                    if (result.status == Status.Done) {
                        s.rows = s.rows.push({
                            name,
                            requirement: range,
                            target: result.row,
                            development: dev
                        })[0]
                    }
                }

                s.cursor += 1
            }
        }
    })
}
