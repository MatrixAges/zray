import { Kind } from "../workspace/specifier"
import { Status as Selected } from "../workspace/target/model"
import query from "../workspace/target/query"
import select from "../workspace/target/select"
import { Status } from "./model"

import type { Output as Specifier } from "../workspace/specifier"
import type { Scan } from "./model"

export type Input =
    Scan.Pick("owner", "members", "limit") & {
        spec: Specifier
    }

export type Output = {
    status: Status,
    row: u64
}

export default function (in: Input): Output {
    if (in.owner == null || in.spec.kind == Kind.Invalid) {
        return {
            status: Status.InvalidLockWorkspaceTarget,
            row: 0
        }
    }

    const owner = in.owner ?? ""

    const target = query({
        spec: in.spec,
        owner
    })

    const selected = select({
        ...in.members,
        ...target,
        limit: in.limit
    })

    const status = match selected.status {
        Selected.Found => Status.Done,
        Selected.Missing => Status.InvalidLockWorkspaceTarget,
        Selected.InvalidVersion => Status.InvalidVersion,
        Selected.InvalidRange => Status.InvalidRange,
        Selected.Overflow => Status.Overflow,
        Selected.InvalidLockWorkspacePath => Status.InvalidLockWorkspacePath,
        _ => Status.LockVersionMismatch
    }

    return {
        status,
        row: selected.row
    }
}
