import type { TextColumn } from "memory"
import type { Catalog } from "../registry/model"
import type { Rows } from "../workspace/target/model"

export enum Status {
    Done,
    Archive,
    InvalidLockWorkspaceTarget,
    InvalidLockWorkspacePath,
    LockVersionMismatch,
    InvalidRange,
    InvalidVersion,
    Overflow,
    TooManyLockDependencies,
    PackageVersionNotFound
}

export type Entries = {
    names: TextColumn,
    requirements: TextColumn,
    count: u64
}

export type Row = {
    name: string,
    requirement: string,
    target: u64,
    development: bool
}

export type Scan = {
    production: Entries,
    development: Entries,
    owner?: string,
    members: Rows,
    cursor: u64,
    remaining: u64,
    limit: u64
}

export type Input = Scan & {
    catalog: Catalog
}

export type Result = {
    status: Status,
    cursor: u64,
    package: u64,
    release: u64,
    rows: Row[]
}
