import bytes from "std:bytes"

import { alternative } from "./const"
import clause from "./range/clause"

import type { Request as Input } from "./model"

export type Output = bool?

export default function (in: Input): Output {
    const text = bytes.fromText(in.text)
    const width = bytes.fromText(alternative).length

    return loop({
        start: 0,
        done: false,
        valid: true,
        matched: false
    }, {
        while: s => s.valid && !s.done,
        next: s => {
            const end = bytes.indexOfText(text, s.start, alternative) ?? text.length
            const accepted = clause({
                ...in,
                start: s.start,
                end
            })

            s.valid = accepted != null
            s.matched = s.matched || (accepted ?? false)
            s.done = end == text.length
            s.start = end + width
        },
        return: s => s.valid ? s.matched : null
    })
}
