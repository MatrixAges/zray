<Module>
    <Type from="../model" as="Version" />

    <Args in={Version.Clause} out={bool?} />

    <Call
        fn="layout"
        in={$in.pick([
            "text",
            "start",
            "end"
        ])}
    />

    <If on={$ctx.layout.first.start == $ctx.layout.first.end}>
        <Return value={null} />
    </If>

    <If on={$ctx.layout.hyphen}>
        <Call
            fn="hyphen"
            in={{
                ...$in,
                ...$ctx.layout.omit(["hyphen"])
            }}
        />

        <Return value={$ctx.hyphen} />
    </If>

    <Call
        fn="intersection"
        in={{
            ...$in,
            first: $ctx.layout.first
        }}
    />

    <Return value={$ctx.intersection} />
</Module>
