import {
    ascii_asterisk,
    ascii_dot,
    ascii_lower_x,
    ascii_minus,
    ascii_plus
} from "core/ascii/const"

import { ascii_upper_x, major_part, patch_part } from "../const"
import { ParseStatus } from "../model"
import decimal from "./decimal"
import suffix from "./suffix"

import type { Partial as Output } from "../model"
import type { Input as Digits } from "./decimal"

export type Input = Digits.Omit("separators") & {
    release: bool
}

export default function (in: Input): Output {
    const { text, start, end, limit } = in

    return loop({
        i: start,
        major: 0,
        minor: 0,
        patch: 0,
        parts: 0,
        count: 0,
        pre_start: 0,
        pre_end: 0,
        status: ParseStatus.Valid,
        done: false
    }, {
        while: s => s.status == ParseStatus.Valid && !s.done,
        next: s => {
            const first = s.i
            const stop = loop(first, {
                while: i => {
                    const byte = i < end ? text[i] : ascii_dot

                    return match byte {
                        ascii_dot => false,
                        ascii_minus => false,
                        ascii_plus => false,
                        _ => true
                    }
                },
                next: i => {
                    i += 1
                }
            })
            const byte = first < stop ? text[first] : ascii_dot
            const marker = match byte {
                ascii_asterisk => true,
                ascii_lower_x => true,
                ascii_upper_x => true,
                _ => false
            }
            const wildcard = stop - first == 1 && marker

            const missing = first == stop || (in.release && wildcard)

            if (s.count >= patch_part || missing) {
                s.status = ParseStatus.InvalidVersion
            } else if (!wildcard) {
                const value = decimal({
                    text,
                    start: first,
                    end: stop,
                    limit,
                    separators: in.release
                })

                s.status = s.parts == s.count ? value.status : ParseStatus.InvalidVersion

                if (s.count == 0) {
                    s.major = value.value
                } else if (s.count == major_part) {
                    s.minor = value.value
                } else {
                    s.patch = value.value
                }

                s.parts += 1
            }

            s.count += 1
            s.i = stop + 1
            s.done = stop == end || text[stop] != ascii_dot

            const has_suffix = stop < end && s.done

            const complete = in.release || has_suffix
            const needs_part = complete && s.done && s.parts != patch_part

            if (s.status == ParseStatus.Valid && needs_part) {
                s.status = ParseStatus.InvalidVersion
            }

            if (s.status == ParseStatus.Valid && has_suffix) {
                const pre = text[stop] == ascii_minus
                const build = loop(stop + 1, {
                    while: i => pre && i < end && text[i] != ascii_plus,
                    next: i => {
                        i += 1
                    }
                })

                if (pre) {
                    s.pre_start = stop + 1
                    s.pre_end = build
                    s.status = suffix({
                        text,
                        start: s.pre_start,
                        end: build,
                        limit,
                        prerelease: true
                    })
                }

                const has_build = !pre || build < end

                if (s.status == ParseStatus.Valid && has_build) {
                    const build_start = pre ? build + 1 : stop + 1
                    s.status = suffix({
                        text,
                        start: build_start,
                        end,
                        limit,
                        prerelease: false
                    })
                }
            }
        },
        return: s => s.omit([
            "i",
            "done",
            "count"
        ])
    })
}
