import { ascii_dot, ascii_minus, ascii_plus } from "core/ascii/const"

import { major_part, patch_part } from "../const"
import { ParseStatus } from "../model"
import component from "./component"
import suffix from "./suffix"

import type { Partial as Output } from "../model"
import type { Input as Digits } from "./component"

export type Input = Digits.Omit("separators") & {
    release: bool
}

export default function (in: Input): Output {
    const { text, start, end, limit } = in

    return loop({
        i: start,
        major: 0,
        minor: 0,
        patch: 0,
        parts: 0,
        count: 0,
        pre_start: 0,
        pre_end: 0,
        status: ParseStatus.Valid,
        done: false
    }, {
        while: s => s.status == ParseStatus.Valid && !s.done,
        next: s => {
            const first = s.i
            const value = component({
                text,
                start: first,
                end,
                limit,
                separators: in.release
            })
            const stop = value.stop

            if (s.count >= patch_part || value.status != ParseStatus.Valid) {
                s.status = match {
                    s.count >= patch_part => ParseStatus.InvalidVersion,
                    s.parts != s.count => ParseStatus.InvalidVersion,
                    _ => value.status
                }
            } else if (!value.wildcard) {
                s.status = s.parts == s.count ? value.status : ParseStatus.InvalidVersion

                if (s.count == 0) {
                    s.major = value.value
                } else if (s.count == major_part) {
                    s.minor = value.value
                } else {
                    s.patch = value.value
                }

                s.parts += 1
            }

            s.count += 1
            s.i = stop + 1
            s.done = stop == end || text[stop] != ascii_dot

            const has_suffix = stop < end && s.done

            const complete = in.release || has_suffix
            const needs_part = complete && s.done && s.parts != patch_part

            if (s.status == ParseStatus.Valid && needs_part) {
                s.status = ParseStatus.InvalidVersion
            }

            if (s.status == ParseStatus.Valid && has_suffix) {
                const pre = text[stop] == ascii_minus
                const build = loop(stop + 1, {
                    while: i => pre && i < end && text[i] != ascii_plus,
                    next: i => {
                        i += 1
                    }
                })

                if (pre) {
                    s.pre_start = stop + 1
                    s.pre_end = build
                    s.status = suffix({
                        text,
                        start: s.pre_start,
                        end: build,
                        limit,
                        prerelease: true
                    })
                }

                const has_build = !pre || build < end

                if (s.status == ParseStatus.Valid && has_build) {
                    const build_start = pre ? build + 1 : stop + 1
                    s.status = suffix({
                        text,
                        start: build_start,
                        end,
                        limit,
                        prerelease: false
                    })
                }
            }
        },
        return: s => s.omit([
            "i",
            "done",
            "count"
        ])
    })
}
