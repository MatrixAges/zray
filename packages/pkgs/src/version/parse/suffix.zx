import { ascii_dot, ascii_minus } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import decimal from "./decimal"

import type { Input as Digits } from "./decimal"

export type Input = Digits & {
    prerelease: bool
}

export type Output = bool

export default function (in: Input): Output {
    const { text, start, end, limit, prerelease } = in

    return loop({
        i: start,
        first: start,
        numeric: true,
        valid: true
    }, {
        while: s => s.valid && s.i <= end,
        next: s => {
            if (s.i == end || text[s.i] == ascii_dot) {
                s.valid = s.i != s.first

                const numeric_pre = prerelease && s.numeric

                if (s.valid && numeric_pre) {
                    s.valid = decimal({
                        text,
                        start: s.first,
                        end: s.i,
                        limit
                    }) != null
                }

                s.first = s.i + 1
                s.numeric = true
            } else {
                const byte = text[s.i]
                const digit = byte >= ascii_digit_first && byte <= ascii_digit_last
                const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
                const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
                const letter = lower || upper

                s.valid = digit || letter || byte == ascii_minus
                s.numeric = s.numeric && digit
            }

            s.i += 1
        },
        return: s => s.valid
    })
}
