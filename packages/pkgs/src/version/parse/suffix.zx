import { ascii_dot, ascii_minus } from "core/ascii/const"
import {
    ascii_digit_first,
    ascii_digit_last,
    ascii_lower_first,
    ascii_lower_last,
    ascii_upper_first,
    ascii_upper_last
} from "core/const"

import { ParseStatus } from "../model"
import component from "./component"

import type { Input as Digits } from "./component"

export type Input = Digits.Omit("separators") & {
    prerelease: bool
}

export type Output = ParseStatus

export default function (in: Input): Output {
    const { text, start, end, limit, prerelease } = in

    return loop({
        i: start,
        first: start,
        numeric: true,
        status: ParseStatus.Valid
    }, {
        while: s => s.status == ParseStatus.Valid && s.i <= end,
        next: s => {
            if (s.i == end || text[s.i] == ascii_dot) {
                const numeric_pre = prerelease && s.numeric

                if (s.i == s.first) {
                    s.status = ParseStatus.InvalidVersion
                } else if (numeric_pre) {
                    s.status = component({
                        text,
                        start: s.first,
                        end: s.i,
                        limit,
                        separators: false
                    }).status
                }

                s.first = s.i + 1
                s.numeric = true
            } else {
                const byte = text[s.i]
                const digit = byte >= ascii_digit_first && byte <= ascii_digit_last
                const lower = byte >= ascii_lower_first && byte <= ascii_lower_last
                const upper = byte >= ascii_upper_first && byte <= ascii_upper_last
                const letter = lower || upper

                const valid = digit || letter || byte == ascii_minus
                s.status = valid ? ParseStatus.Valid : ParseStatus.InvalidVersion
                s.numeric = s.numeric && digit
            }

            s.i += 1
        },
        return: s => s.status
    })
}
