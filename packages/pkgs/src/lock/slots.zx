export type Input = u64

export type Output = u32[]

export default function (in: Input): Output {
    const initial: u32[] = []

    return loop({
        index: 0,
        items: initial
    }, {
        while: s => s.index < in,
        next: s => {
            s.items = s.items.push(0)[0]
            s.index += 1
        },
        return: s => s.items
    })
}
