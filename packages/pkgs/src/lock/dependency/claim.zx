import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { ListColumn } from "memory"

export type Input = {
    names: ListColumn,
    name: string,
    row: u64,
    edge: u64,
    slots: u32[],
    mask: u64
}

export type Output = {
    slots: u32[],
    inserted: bool
}

export default function (in: Input): Output {
    const { names, name, row, edge, mask } = in

    const hash = bytes.hash(bytes.fromText(name))

    return loop({
        slot: integers.andBits(hash, mask),
        slots: in.slots,
        done: false,
        inserted: false
    }, {
        while: s => !s.done,
        next: s => {
            const entry = s.slots[s.slot]
            if (entry == 0) {
                s.slots = s.slots.with(s.slot, integers.narrow(edge + 1))
                s.inserted = true
                s.done = true
            } else {
                const previous = integers.widen(entry) - 1
                s.done = memory.readListText(names, row, previous) == name
                s.slot = integers.andBits(s.slot + 1, mask)
            }
        },
        return: s => s.pick([
            "slots",
            "inserted"
        ])
    })
}
