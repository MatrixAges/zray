import memory from "memory"

import { workspace_root } from "../../graph/const"
import { Status as Archive } from "../../metadata/archive"
import validateArchive from "../../metadata/validate"
import { Kind } from "../../workspace/path/valid"
import validPath from "../../workspace/path/valid"
import { Status } from "../model"
import claim from "./claim"

import type { Packages } from "../model"

export type Input = {
    packages: Packages,
    row: u64,
    slots: u32[],
    capacity: u64
}

export type Output = {
    slots: u32[],
    status: Status
}

export default function (in: Input): Output {
    const { packages, row, capacity } = in
    const { paths, names, archives, digests, versions, flags } = packages

    const local = memory.readU8(flags, row) == workspace_root

    if (local) {
        const valid = validPath({
            owner: "",
            path: memory.readTextColumn(paths, row),
            kind: Kind.Stored
        })

        if (!valid) {
            return {
                slots: in.slots,
                status: Status.InvalidLockWorkspacePath
            }
        }
    } else {
        const archive = validateArchive({
            archive: memory.readTextColumn(archives, row),
            digest: memory.readTextColumn(digests, row),
            lowercase: true
        })

        if (archive == Archive.InvalidArchiveSource) {
            return {
                slots: in.slots,
                status: Status.InvalidArchiveSource
            }
        }

        if (archive == Archive.InvalidArchiveDigest) {
            return {
                slots: in.slots,
                status: Status.InvalidArchiveDigest
            }
        }
    }

    const unique = claim({
        slots: in.slots,
        row,
        versions,
        flags,
        capacity,
        keys: local ? paths : digests,
        compound: false,
        offset: 0
    })

    if (!unique.inserted) {
        const status = match {
            local => Status.DuplicateLockWorkspacePath,
            _ => Status.DuplicateLockArchive
        }

        return {
            slots: unique.slots,
            status
        }
    }

    const named = claim({
        slots: unique.slots,
        row,
        versions,
        flags,
        capacity,
        keys: names,
        compound: !local,
        offset: capacity
    })

    if (!named.inserted) {
        const status = match {
            local => Status.DuplicateLockWorkspaceName,
            _ => Status.DuplicateLockPackage
        }

        return {
            slots: named.slots,
            status
        }
    }

    return {
        slots: named.slots,
        status: Status.Valid
    }
}
