import bytes from "std:bytes"
import integers from "std:integer"
import memory from "memory"

import type { TextColumn, U8Buffer } from "memory"

export type Input = {
    keys: TextColumn,
    versions: TextColumn,
    flags: U8Buffer,
    slots: u32[],
    row: u64,
    capacity: u64,
    offset: u64,
    compound: bool
}

export type Output = {
    slots: u32[],
    inserted: bool
}

export default function (in: Input): Output {
    const { keys, versions, flags, row, capacity, offset, compound } = in

    const kind = memory.readU8(flags, row)
    const key = memory.readTextColumn(keys, row)
    const hash = bytes.hash(bytes.fromText(key))

    const version = match {
        compound => memory.readTextColumn(versions, row),
        _ => ""
    }

    const seed = match {
        compound => bytes.hashSeeded(hash, bytes.fromText(version)),
        _ => hash
    }

    const mask = capacity - 1

    return loop({
        slot: integers.andBits(seed, mask),
        slots: in.slots,
        inserted: false,
        done: false
    }, {
        while: s => !s.done,
        next: s => {
            const bucket = offset + s.slot
            const entry = s.slots[bucket]

            if (entry == 0) {
                s.slots = s.slots.with(bucket, integers.narrow(row + 1))
                s.inserted = true
                s.done = true
            } else {
                const previous = integers.widen(entry) - 1
                if (memory.readU8(flags, previous) == kind) {
                    if (memory.readTextColumn(keys, previous) == key) {
                        s.done =
                            !compound ||
                            memory.readTextColumn(versions, previous) == version
                    }
                }

                s.slot = integers.andBits(s.slot + 1, mask)
            }
        },
        return: s => s.pick([
            "slots",
            "inserted"
        ])
    })
}
